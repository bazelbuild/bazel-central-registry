#!/bin/sh
set -eu

printf 'BCR_IMPACT_ID uid=%s gid=%s\n' "$(id -u)" "$(id -g)"

agent_config=/etc/buildkite-agent/buildkite-agent.cfg
if [ -r "$agent_config" ]; then
  printf 'BCR_IMPACT_AGENT_CONFIG_READABLE '
  stat -c 'owner=%U group=%G mode=%a' "$agent_config"
else
  printf 'BCR_IMPACT_AGENT_CONFIG_NOT_READABLE\n'
fi

docker_socket=/var/run/docker.sock
if [ -S "$docker_socket" ] && [ -w "$docker_socket" ]; then
  printf 'BCR_IMPACT_DOCKER_SOCKET_WRITABLE\n'
  if docker_server=$(docker version --format '{{.Server.Version}}' 2>/dev/null); then
    printf 'BCR_IMPACT_DOCKER_DAEMON_REACHABLE server=%s\n' "$docker_server"
  else
    printf 'BCR_IMPACT_DOCKER_DAEMON_UNREACHABLE\n'
  fi
else
  printf 'BCR_IMPACT_DOCKER_SOCKET_NOT_WRITABLE\n'
fi

exit 0
