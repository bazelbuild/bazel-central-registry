-# Current version.
-# https://gcc.gnu.org/releases.html
-gcc.toolchain(
-    name = "gcc_toolchain_cur",
-    gcc_version = "15.2.0",
-    target_arch = "x86_64",
-    extra_ldflags = ["-lstdc++"],
-)
-use_repo(gcc, "gcc_toolchain_cur")
-
-# LLVM
-llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
-
