diff --git BUILD.bazel BUILD.bazel
new file mode 100644
index 0000000..f6272c1
--- /dev/null
+++ BUILD.bazel
@@ -0,0 +1,41 @@
+load("@rules_cc//cc:cc_library.bzl", "cc_library")
+
+package(default_visibility = ["//visibility:public"])
+
+# KokkosFFT_config.hpp, which KokkosFFT's CMake build generates from
+# cmake/KokkosFFT_config.hpp.in. The default enables only the FFTW TPL
+# (host FFTs). A consumer that uses a device TPL (cuFFT, rocFFT, ...) points
+# --@kokkos_fft//:config at its own cc_library that provides
+# KokkosFFT_config.hpp and depends on that TPL.
+#
+# FFTW's OpenMP/threads library is not linked: @fftw does not build one. A
+# plan on Kokkos::OpenMP calls fftw_init_threads and would fail to link, so
+# host FFTs must use Kokkos::Serial.
+label_flag(
+    name = "config",
+    build_setting_default = ":default_config",
+)
+
+# Host-only default: FFTW, no device backends.
+cc_library(
+    name = "default_config",
+    hdrs = ["default_config/KokkosFFT_config.hpp"],
+    strip_include_prefix = "default_config",
+)
+
+cc_library(
+    name = "kokkos_fft",
+    hdrs = glob([
+        "common/src/**/*.hpp",
+        "fft/src/**/*.hpp",
+    ]),
+    includes = [
+        "common/src",
+        "fft/src",
+    ],
+    deps = [
+        ":config",
+        "@fftw",
+        "@kokkos",
+    ],
+)
