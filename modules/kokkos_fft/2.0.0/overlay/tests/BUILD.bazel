load("@rules_cc//cc:cc_test.bzl", "cc_test")

# CPU-only smoke test: no GPU, CUDA toolkit or cuFFT is needed. It runs
# KokkosFFT's FFTW backend on Kokkos::Serial with the module's default
# configuration (@kokkos_fft//:default_config, --@kokkos//:device=none), and
# is skipped, not failed, when a Kokkos device backend is selected.
#
# Kokkos 5 headers require C++20, and the OpenMP backend headers require
# -fopenmp in every translation unit that includes them. Bazel copts do not
# propagate from @kokkos//:kokkos, so consumers set both themselves.
cc_test(
    name = "kokkos_fft_smoke",
    srcs = ["kokkos_fft_smoke.cpp"],
    copts = ["-std=c++20"] + select({
        "@kokkos//:openmp": ["-fopenmp"],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        "@kokkos//:cuda": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [
        "@kokkos",
        "@kokkos_fft",
    ],
)
