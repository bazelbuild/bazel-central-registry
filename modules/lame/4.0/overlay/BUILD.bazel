load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "lame",
    srcs = [
        "include/config.h",
        "libmp3lame/VbrTag.c",
        "libmp3lame/bitstream.c",
        "libmp3lame/encoder.c",
        "libmp3lame/fft.c",
        "libmp3lame/gain_analysis.c",
        "libmp3lame/id3tag.c",
        "libmp3lame/lame.c",
        "libmp3lame/mpglib_interface.c",
        "libmp3lame/newmdct.c",
        "libmp3lame/presets.c",
        "libmp3lame/psymodel.c",
        "libmp3lame/quantize.c",
        "libmp3lame/quantize_pvt.c",
        "libmp3lame/reservoir.c",
        "libmp3lame/set_get.c",
        "libmp3lame/tables.c",
        "libmp3lame/takehiro.c",
        "libmp3lame/util.c",
        "libmp3lame/vbrquantize.c",
        "libmp3lame/version.c",
    ] + glob([
        "libmp3lame/*.h",
        "libmp3lame/vector/*.h",
        "mpglib/*.h",
    ]),
    hdrs = ["include/lame.h"],
    include_prefix = "lame",
    includes = ["include"],
    linkopts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-lm"],
    }),
    local_defines = ["HAVE_CONFIG_H"],
    strip_include_prefix = "include",
)

# Match frontend/Makefile.am, using the library's configuration without optional
# MP3 decoding, libsndfile, iconv, or termcap dependencies.
cc_binary(
    name = "lame_bin",
    srcs = [
        "frontend/brhist.c",
        "frontend/console.c",
        "frontend/get_audio.c",
        "frontend/lame_main.c",
        "frontend/lametime.c",
        "frontend/main.c",
        "frontend/parse.c",
        "frontend/timestatus.c",
        "include/config.h",
    ] + glob([
        "frontend/*.h",
        "libmp3lame/*.h",
    ]),
    includes = ["libmp3lame"],
    local_defines = ["HAVE_CONFIG_H"],
    deps = [":lame"],
)

cc_test(
    name = "upstream_wav_test",
    srcs = ["tests/upstream_wav_test.c"],
    args = [
        "$(location testcase.wav)",
        "$(location testcase.mp3)",
    ],
    data = [
        "testcase.mp3",
        "testcase.wav",
    ],
    deps = [":lame"],
)

cc_test(
    name = "lame_version_test",
    srcs = ["tests/cli_test.c"],
    args = [
        "$(location :lame_bin)",
        "--version",
    ],
    data = [":lame_bin"],
    env = {"LAMEOPT": ""},
)

cc_test(
    name = "lame_help_test",
    srcs = ["tests/cli_test.c"],
    args = [
        "$(location :lame_bin)",
        "--help",
    ],
    data = [":lame_bin"],
    env = {"LAMEOPT": ""},
)

cc_test(
    name = "lame_encode_test",
    srcs = ["tests/cli_test.c"],
    args = [
        "$(location :lame_bin)",
        "encode",
        "$(location testcase.wav)",
        "$(location testcase.mp3)",
    ],
    data = [
        "testcase.mp3",
        "testcase.wav",
        ":lame_bin",
    ],
    env = {"LAMEOPT": ""},
)
