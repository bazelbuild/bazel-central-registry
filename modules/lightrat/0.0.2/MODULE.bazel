"""lightrat module"""

module(
    name = "lightrat",
    version = "0.0.2",
)

#################################################################################
# Available dependencies from the Bazel registry (https://registry.bazel.build/)
#################################################################################

# rules_cc for building C++ libraries with Bazel
bazel_dep(name = "rules_cc", version = "0.2.28")

# Utility rules for Bazel
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# Bazel rules for detecting the platform
bazel_dep(name = "platforms", version = "1.1.0")

# Arbitrary precision arithmetic library for C/C++
bazel_dep(name = "gmp", version = "6.3.0.bcr.4")

# rules_python for building python targets
bazel_dep(name = "rules_python", version = "2.4.6")

# nanobind for binding C++ and Python
bazel_dep(name = "nanobind_bazel", version = "3.1.0.bcr.1")
git_override(
    module_name = "nanobind_bazel",
    commit = "9c2ab145917301a2dc89d56b1acaaa40c94c24f3",
    remote = "https://github.com/TendTo/nanobind-bazel.git",
)

# Bazel rules for packaging the project
bazel_dep(name = "rules_pkg", version = "1.3.0")

# Google C++ Style Guide
bazel_dep(name = "cpplint", version = "2.0.2", dev_dependency = True)

# C++ test suite by Google
bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True)

# C++ benchmarking library by Google
bazel_dep(name = "google_benchmark", version = "1.10.0", dev_dependency = True)

# Doxygen documentation generator
bazel_dep(name = "rules_doxygen", version = "2.7.0", dev_dependency = True)

# MIT | rules for dealing with target dependencies
bazel_dep(name = "depend_on_what_you_use", version = "1.2.0", dev_dependency = True)

#################################################################################
# Load module extensions
#################################################################################
doxygen_extension = use_extension("@rules_doxygen//:extensions.bzl", "doxygen_extension", dev_dependency = True)
use_repo(doxygen_extension, "doxygen")

PYTHON_VERSIONS = [
    "3.10",
    "3.11",
    "3.12",
    "3.13",
    "3.14",
    "3.15",
]

python = use_extension("@rules_python//python/extensions:python.bzl", "python")

[
    python.toolchain(python_version = v)
    for v in PYTHON_VERSIONS
]

use_repo(
    python,
    "python_3_10",
    "python_3_11",
    "python_3_12",
    "python_3_13",
    "python_3_14",
    "python_3_15",
    "python_versions",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")

[
    pip.parse(
        hub_name = "lightrat_pypi",
        python_version = v,
        requirements_lock = "//tools:requirements.txt",
    )
    for v in PYTHON_VERSIONS
]

use_repo(pip, "pypi")
