# ---------------------------------------------------------------------------
# Headers
# ---------------------------------------------------------------------------

# `-I$(top_srcdir)/include` (conf/Makefile.common:37).  The whole tree is
# published: the utilities include the headers of every platform (the mkimage
# target tables, grub-file's loaders, the dl_helper variants ...).
cc_library(
    name = "headers",
    hdrs = glob(["include/**/*.h"]),
    includes = ["include"],
    visibility = ["//visibility:public"],
)

# The per-directory `-I`s the Makefile fragments add.  Each is `-I` rather
# than `includes` so that posix_wrap and libgcrypt_wrap, which shadow C
# library headers, come ahead of every system directory.
[
    cc_library(
        name = name,
        hdrs = glob(
            [dir + "/**/*.h"],
            # posix_wrap/sys/ and friends hold headers only.
            allow_empty = False,
        ),
        strip_include_prefix = dir,
        visibility = ["//visibility:public"],
    )
    for name, dir in {
        # CPPFLAGS_GCRY (conf/Makefile.common:88).
        "gcrypt_hdrs": "include/grub/gcrypt",
        # CPPFLAGS_DEFAULT (conf/Makefile.common:39).
        "gcrypt_src_hdrs": "grub-core/lib/libgcrypt-grub/src",
        # CPPFLAGS_GCRY again.
        "gcrypt_wrap_hdrs": "grub-core/lib/libgcrypt_wrap",
        # grubkern (Makefile.util.def:6).
        "json_hdrs": "grub-core/lib/json",
        # grubmods (Makefile.util.def:62).
        "minilzo_hdrs": "grub-core/lib/minilzo",
        # CPPFLAGS_POSIX (conf/Makefile.common:85).
        "posix_wrap_hdrs": "grub-core/lib/posix_wrap",
        "xzembed_hdrs": "grub-core/lib/xzembed",
        "zstd_hdrs": "grub-core/lib/zstd",
    }.items()
]

