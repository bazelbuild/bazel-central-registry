# The version for the shell script templates, where autoconf_package_info's
# substitutions would arrive as quoted C literals.
_VERSION = "2.14"

# --with-bootdir and --with-grubdir (configure.ac:293 and :313).
string_flag(
    name = "bootdir",
    build_setting_default = "boot",
    visibility = ["//visibility:public"],
)

string_flag(
    name = "grubdir",
    build_setting_default = "grub",
    visibility = ["//visibility:public"],
)

# The install layout.  configure bakes the directories into the programs
# (GRUB_LIBDIR and friends, configure.ac:2503) and into the scripts
# (@bindir@ ...); defaults are autoconf's for `--prefix=/usr/local`.
# grub-install looks for the platform modules under `$libdir/grub/`.
[
    string_flag(
        name = name,
        build_setting_default = default,
        visibility = ["//visibility:public"],
    )
    for name, default in {
        "bindir": "/usr/local/bin",
        "datadir": "/usr/local/share",
        "datarootdir": "/usr/local/share",
        "exec_prefix": "/usr/local",
        "libdir": "/usr/local/lib",
        "localedir": "/usr/local/share/locale",
        "prefix": "/usr/local",
        "sbindir": "/usr/local/sbin",
        "sysconfdir": "/usr/local/etc",
    }.items()
]

# The @VAR@ substitutions every script and completion template shares.  The
# `grub_*` names are the program-name transforms (configure.ac:62); with no
# --program-prefix they are the names themselves.
SCRIPT_SETTINGS = {
    ":bindir": "@bindir@",
    ":bootdir": "@bootdirname@",
    ":datadir": "@datadir@",
    ":datarootdir": "@datarootdir@",
    ":exec_prefix": "@exec_prefix@",
    ":grubdir": "@grubdirname@",
    ":libdir": "@libdir@",
    ":localedir": "@localedir@",
    ":prefix": "@prefix@",
    ":sbindir": "@sbindir@",
    ":sysconfdir": "@sysconfdir@",
}

SCRIPT_SUBSTITUTIONS = {
    "@PACKAGE@": "grub",
    "@PACKAGE_NAME@": "GRUB",
    "@PACKAGE_VERSION@": _VERSION,
    "@grub_bios_setup@": "grub-bios-setup",
    "@grub_editenv@": "grub-editenv",
    "@grub_file@": "grub-file",
    "@grub_install@": "grub-install",
    "@grub_mkconfig@": "grub-mkconfig",
    "@grub_mkfont@": "grub-mkfont",
    "@grub_mkimage@": "grub-mkimage",
    "@grub_mklayout@": "grub-mklayout",
    "@grub_mkpasswd_pbkdf2@": "grub-mkpasswd-pbkdf2",
    "@grub_mkrelpath@": "grub-mkrelpath",
    "@grub_mkrescue@": "grub-mkrescue",
    "@grub_probe@": "grub-probe",
    "@grub_reboot@": "grub-reboot",
    "@grub_script_check@": "grub-script-check",
    "@grub_set_default@": "grub-set-default",
    "@grub_sparc64_setup@": "grub-sparc64-setup",
} | select({
    "@platforms//os:macos": {"@host_os@": "darwin"},
    "//conditions:default": {"@host_os@": "linux-gnu"},
})

# The source tree: //tests compiles upstream's check_PROGRAMS from it, and the
# //platform data names its files for whatever builds the boot-time image.
exports_files(
    ["config.h.in"] + glob([
        "grub-core/**",
        "include/**",
        "util/*.c",
    ]),
    visibility = ["//visibility:public"],
)

# Every header a kernel or module compile may include, and the sources that
# are `#include`d rather than compiled on their own there: the
# word-size templates, the per-CPU kern/ bodies, the gnulib and libgcrypt
# files compiled through an includer, and the handful of fs/ and disk/ files
# compiled several times over.
filegroup(
    name = "core_hdrs",
    srcs = glob([
        "grub-core/**/*.h",
        "include/**/*.h",
    ]),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "core_textual_srcs",
    srcs = glob([
        "grub-core/**/*XX.c",
        "grub-core/**/*xx.c",
        "grub-core/kern/*/cache.c",
        "grub-core/kern/*/dl.c",
        "grub-core/kern/*/dl_helper.c",
        "grub-core/lib/libgcrypt-grub/cipher/*.c",
        # startup.S and friends `#include` other .S files (realmode.S,
        # relocator_common.S, the cache and setjmp bodies).
        "grub-core/**/*.S",
    ]) + [
        "grub-core/commands/search.c",
        "grub-core/disk/mdraid_linux.c",
        "grub-core/efiemu/loadcore.c",
        "grub-core/efiemu/prepare.c",
        "grub-core/fs/bfs.c",
        "grub-core/fs/cpio_common.c",
        "grub-core/fs/fat.c",
        "grub-core/fs/minix.c",
        "grub-core/fs/ufs.c",
        "grub-core/kern/disk_common.c",
        "grub-core/lib/gnulib/fnmatch_loop.c",
        "grub-core/lib/gnulib/malloc/dynarray-skeleton.c",
        "grub-core/lib/gnulib/regcomp.c",
        "grub-core/lib/gnulib/regex_internal.c",
        "grub-core/lib/gnulib/regexec.c",
        "grub-core/loader/i386/bsd_pagetable.c",
        "grub-core/term/i386/pc/vga_text.c",
        "grub-core/video/sis315_init.c",
        "grub-core/video/sm712_init.c",
    ],
    visibility = ["//visibility:public"],
)

# ---------------------------------------------------------------------------
# Build-machine tools (grub-core/Makefile.am:30-44)
# ---------------------------------------------------------------------------

# build-grub-module-verifier, which genmod.sh runs over every module.
# grub-module-verifierXX.c is the word-size template the 32 and 64 files
# include, hence the library carrying it as a textual header.
cc_library(
    name = "build-grub-module-verifier_lib",
    srcs = [
        "grub-core/kern/emu/misc.c",
        "util/grub-module-verifier.c",
        "util/grub-module-verifier32.c",
        "util/grub-module-verifier64.c",
        "util/misc.c",
    ],
    copts = ["-w"],
    local_defines = [
        "GRUB_BUILD=1",
        "GRUB_UTIL=1",
        "GRUB_FILE=__FILE__",
        "GRUB_BUILD_PROGRAM_NAME=\\\"build-grub-module-verifier\\\"",
    ],
    textual_hdrs = ["util/grub-module-verifierXX.c"],
    deps = [
        ":config_headers",
        ":include_includes",
    ],
)

cc_binary(
    name = "build-grub-module-verifier",
    visibility = ["//visibility:public"],
    deps = [":build-grub-module-verifier_lib"],
)

# gentrigtables, and the trigtables.c it writes for the trig module.
cc_binary(
    name = "gentrigtables",
    srcs = ["grub-core/gentrigtables.c"],
    copts = ["-w"],
    linkopts = ["-lm"],
    local_defines = ["GRUB_FILE=__FILE__"],
    deps = [":include_includes"],
)

genrule(
    name = "trigtables",
    outs = ["gen/trigtables.c"],
    cmd = "$(execpath :gentrigtables) > $@",
    tools = [":gentrigtables"],
    visibility = ["//visibility:public"],
)

# ---------------------------------------------------------------------------
# Scripts, etc/grub.d and the bash completions (Makefile.util.def, config.status
# --file substitution of the .in templates)
# ---------------------------------------------------------------------------

[
    configure_script(
        name = name,
        out = "bin/" + name if dir == "bin" else "sbin/" + name,
        settings = SCRIPT_SETTINGS,
        substitutions = SCRIPT_SUBSTITUTIONS,
        template = "util/{}.in".format(name),
        visibility = ["//visibility:public"],
    )
    for name, dir in {
        "grub-kbdcomp": "bin",
        "grub-mkconfig": "sbin",
        "grub-reboot": "sbin",
        "grub-set-default": "sbin",
    }.items()
]

# installdir = noinst in Makefile.util.def, but Makefile.util.am installs it
# as pkgdata: $(datadir)/grub/grub-mkconfig_lib, which is where grub-mkconfig
# and every grub.d script source it from.
configure_script(
    name = "grub-mkconfig_lib",
    out = "share/grub/grub-mkconfig_lib",
    is_executable = False,
    settings = SCRIPT_SETTINGS,
    substitutions = SCRIPT_SUBSTITUTIONS,
    template = "util/grub-mkconfig_lib.in",
    visibility = ["//visibility:public"],
)

# etc/grub.d (grubconf_SCRIPTS).  10_linux and 20_linux_xen are COND_HOST_LINUX,
# 10_xnu is COND_HOST_XNU; the hurd, kfreebsd, illumos, netbsd and windows
# ones are for hosts this module does not build on.
[
    configure_script(
        name = "grub.d/" + name,
        out = "etc/grub.d/" + name,
        settings = SCRIPT_SETTINGS,
        substitutions = SCRIPT_SUBSTITUTIONS,
        template = "util/grub.d/{}.in".format(name),
        visibility = ["//visibility:public"],
    )
    for name in [
        "00_header",
        "10_linux",
        "10_xnu",
        "20_linux_xen",
        "25_bli",
        "30_os-prober",
        "30_uefi-firmware",
        "40_custom",
        "41_custom",
    ]
]

filegroup(
    name = "grub.d",
    srcs = [
        "grub.d/00_header",
        "grub.d/25_bli",
        "grub.d/30_os-prober",
        "grub.d/30_uefi-firmware",
        "grub.d/40_custom",
        "grub.d/41_custom",
        "util/grub.d/README",
    ] + select({
        "@platforms//os:macos": ["grub.d/10_xnu"],
        "//conditions:default": [
            "grub.d/10_linux",
            "grub.d/20_linux_xen",
        ],
    }),
    visibility = ["//visibility:public"],
)

# util/bash-completion.d/Makefile.am.  grub-completion.bash.in becomes the
# completion named after the package; the rest after their program.
BASH_COMPLETIONS = {
    "grub": "grub-completion",
    "grub-bios-setup": "grub-bios-setup",
    "grub-editenv": "grub-editenv",
    "grub-install": "grub-install",
    "grub-mkconfig": "grub-mkconfig",
    "grub-mkfont": "grub-mkfont",
    "grub-mkimage": "grub-mkimage",
    "grub-mkpasswd-pbkdf2": "grub-mkpasswd-pbkdf2",
    "grub-mkrescue": "grub-mkrescue",
    "grub-probe": "grub-probe",
    "grub-reboot": "grub-reboot",
    "grub-script-check": "grub-script-check",
    "grub-set-default": "grub-set-default",
    "grub-sparc64-setup": "grub-sparc64-setup",
}

[
    configure_script(
        name = "bash-completion/" + name,
        out = "share/bash-completion/completions/" + name,
        is_executable = False,
        settings = SCRIPT_SETTINGS,
        substitutions = SCRIPT_SUBSTITUTIONS,
        template = "util/bash-completion.d/{}.bash.in".format(source),
    )
    for name, source in BASH_COMPLETIONS.items()
]

filegroup(
    name = "bash-completion",
    srcs = ["bash-completion/" + name for name in BASH_COMPLETIONS],
    visibility = ["//visibility:public"],
)

# The bin_PROGRAMS/bin_SCRIPTS and sbin_PROGRAMS/sbin_SCRIPTS sets, for
# consumers that stage an install tree; the optional programs are listed only
# when their option is on, since a filegroup is incompatible when any of its
# sources is.
filegroup(
    name = "bin",
    srcs = [
        "grub-editenv",
        "grub-file",
        "grub-fstest",
        "grub-glue-efi",
        "grub-kbdcomp",
        "grub-menulst2cfg",
        "grub-mkimage",
        "grub-mklayout",
        "grub-mknetdir",
        "grub-mkpasswd-pbkdf2",
        "grub-mkrelpath",
        "grub-mkrescue",
        "grub-mkstandalone",
        "grub-render-label",
        "grub-script-check",
        "grub-syslinux2cfg",
    ] + select({
        ":grub_mkfont_enabled": ["grub-mkfont"],
        "//conditions:default": [],
    }) + select({
        ":grub_mount_enabled": ["grub-mount"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sbin",
    srcs = [
        "grub-bios-setup",
        "grub-install",
        "grub-macbless",
        "grub-mkconfig",
        "grub-ofpathname",
        "grub-probe",
        "grub-reboot",
        "grub-set-default",
        "grub-sparc64-setup",
    ],
    visibility = ["//visibility:public"],
)

# The option config_settings //platform selects on: the generated
# `<option>_enabled` ones are private to the root package, and a
# config_setting cannot be replaced through this file, so these stand beside
# them under another name.
[
    config_setting(
        name = name + "_on",
        flag_values = {":" + name: "True"},
        visibility = ["//visibility:public"],
    )
    for name in [
        "boot_time",
        "cache_stats",
        "mm_debug",
    ]
]

# `-I$(builddir)` (conf/Makefile.common:33) for the two generated headers
# script/lexer.c and the parser include.
cc_library(
    name = "grub_script_hdrs",
    hdrs = [
        "grub_script.tab.h",
        "grub_script.yy.h",
    ],
    strip_include_prefix = "/",
    visibility = ["//visibility:public"],
)

# Replaces the generated target, adding `-ldl`: @libfuse's fuse.c dlopen()s its modules but the
# registry's libfuse carries no link flag for it, so on glibc before 2.34 (debian11) grub-mount
# fails to link dlopen/dlsym/dlclose.  `$(FUSE_LIBS)` is a pkg-config item, which no `link:`
# decision reaches; the flag belongs in libfuse's overlay and this goes once it is there.
cc_binary(
    name = "grub-mount",
    srcs = [
        "grub-core/disk/host.c",
        "grub-core/kern/emu/hostfs.c",
        "grub-core/osdep/init.c",
        "grub_fstest_init.c",
        "grub_script.tab.h",
        "grub_script.yy.h",
        "util/grub-mount.c",
    ],
    copts = NO_WARNINGS,
    includes = select({
        ":grub_mount_enabled": ["grub-core/lib/gnulib"],
        "//conditions:default": [],
    }),
    linkopts = select({
        "@platforms//os:linux": ["-ldl"],
        "//conditions:default": [],
    }),
    local_defines = [
        "HAVE_CONFIG_H",
        "GRUB_UTIL=1",
        "_FILE_OFFSET_BITS=64",
        "GRUB_FILE=__FILE__",
    ] + select({
        ":grub_mount_enabled": ["FUSE_USE_VERSION=32"],
        "//conditions:default": [],
    }),
    target_compatible_with = select({
        ":grub_mount_enabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":config_headers",
        ":grub-core_util_headers",
        ":grub_core_lib_libgcrypt_grub_src_includes",
        ":include_includes",
        ":linkopts",
        "@xz//:lzma",
    ] + select({
        ":grub_mount_enabled": [
            ":grub-core/lib/gnulib/gnu",
            ":grub-core/lib/gnulib/gnu_private_headers",
            ":grubgcry",
            ":grubgcry_private_headers",
            ":grubkern",
            ":grubkern_private_headers",
            ":grubmods",
            ":grubmods_private_headers",
            "@libfuse",
        ],
        "//conditions:default": [],
    }),
)
