# Makefile.am:38-46.  The release tarball does not ship the generated parser,
# so, as upstream, bison and flex run at build time.
bison(
    name = "grub_script_tab",
    srcs = ["grub-core/script/parser.y"],
    outs = [
        "gen/grub_script.tab.c",
        "gen/grub_script.tab.h",
    ],
    # `-Wnone` is `-w` for bison: the grammar's `%pure-parser` is a deprecation
    # note upstream's own build prints too.
    args = [
        "-Wnone",
        "-d",
        "-p",
        "grub_script_yy",
        "-o",
        "$(execpath gen/grub_script.tab.c)",
        "$(execpath grub-core/script/parser.y)",
    ],
    visibility = ["//visibility:public"],
)

flex(
    name = "grub_script_yy",
    srcs = ["grub-core/script/yylex.l"],
    outs = [
        "gen/grub_script.yy.c",
        "gen/grub_script.yy.h",
    ],
    args = [
        "-o",
        "$(execpath gen/grub_script.yy.c)",
        "--header-file=$(execpath gen/grub_script.yy.h)",
        "$(execpath grub-core/script/yylex.l)",
    ],
    visibility = ["//visibility:public"],
)

# `-I$(builddir)` (conf/Makefile.common:33) for the two generated headers
