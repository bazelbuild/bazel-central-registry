# The targets of configure.ac and the Makefile.am files, declared by the generated
# autoconf.bzl beside this file; this file is hand-written and kept as it is.  A target
# added below is the module's own; one named like a generated target replaces it at the
# next conversion.
autoconf_targets()

# Hand-written targets: what configure.ac and the Makefiles do not say in a form the converter reads.  The generated
# sources (bison, flex, geninit.sh), the install layout the scripts are
# rendered with, the scripts, etc/grub.d and the bash completions, the
# build-machine tools, and the source tree and names the //platform package
# builds the boot image from.

# Makefile.am:38-46.  The release tarball does not ship the generated parser,
# so, as upstream, bison and flex run at build time.
bison(
    name = "grub_script_tab",
    srcs = ["grub-core/script/parser.y"],
    outs = [
        "grub_script.tab.c",
        "grub_script.tab.h",
    ],
    # `-Wnone` is `-w` for bison: the grammar's `%pure-parser` is a deprecation
    # note upstream's own build prints too.
    args = [
        "-Wnone",
        "-d",
        "-p",
        "grub_script_yy",
        "-o",
        "$(execpath grub_script.tab.c)",
        "$(execpath grub-core/script/parser.y)",
    ],
    visibility = ["//visibility:public"],
)

flex(
    name = "grub_script_yy",
    srcs = ["grub-core/script/yylex.l"],
    outs = [
        "grub_script.yy.c",
        "grub_script.yy.h",
    ],
    args = [
        "-o",
        "$(execpath grub_script.yy.c)",
        "--header-file=$(execpath grub_script.yy.h)",
        "$(execpath grub-core/script/yylex.l)",
    ],
    visibility = ["//visibility:public"],
)

