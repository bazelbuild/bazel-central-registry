    "GNULIB_STRERROR",
]

# The check list follows `configure.ac` top to bottom; `gl_INIT` stays a
# dependency (GL_INIT_DEPS).  Probes that gnulib also makes are resolved once
# under those deps: AC_HEADER_MAJOR (configure.ac:439) by `sys_types_h`,
# `sys/param.h` and `limits.h` (:433) by `gnulib-common` and `limits-h`, and
# the program_invocation_name declarations (gl_INIT) by `getprogname`.
autoconf(
    name = "autoconf",
    checks = (
        # AC_SYS_LARGEFILE (configure.ac:380) and CPPFLAGS (:391).
        [
            checks.AC_DEFINE("_FILE_OFFSET_BITS", "64"),
        ] +
        # AC_CHECK_SIZEOF(void *), (long) (configure.ac:399) and (off_t)
        # (:414).  The first two double as AC_COMPUTE_INT(BUILD_SIZEOF_*)
        # (:2060): the build and host compilers are the same one here.
        [
            checks.AC_CHECK_SIZEOF(
                "void *",
                define = "SIZEOF_VOID_P",
                subst = "BUILD_SIZEOF_VOID_P",
            ),
            checks.AC_CHECK_SIZEOF(
                "long",
                define = "SIZEOF_LONG",
                subst = "BUILD_SIZEOF_LONG",
            ),
            checks.AC_CHECK_SIZEOF(
                "off_t",
                define = "SIZEOF_OFF_T",
                includes = ["#include <sys/types.h>"],
            ),
            # AC_C_BIGENDIAN([BUILD_WORDS_BIGENDIAN=1], [...=0]) (:2062).
            checks.AC_SUBST(
                "BUILD_WORDS_BIGENDIAN",
                condition = "WORDS_BIGENDIAN",
                if_false = 0,
                if_true = 1,
            ),
        ] +
        # configure.ac:432-433.
        macros.AC_CHECK_FUNCS([
            "posix_memalign",
            "memalign",
            "getextmntent",
            "atexit",
        ]) + macros.AC_CHECK_HEADERS([
            "sys/mount.h",
            "sys/mnttab.h",
        ]) +
        # configure.ac:443 and :447.
        macros.AC_CHECK_MEMBERS(
            [
                "struct statfs.f_fstypename",
                "struct statfs.f_mntfromname",
            ],
            includes = [
                # This comment prevents this list from being reordered
                "#include <sys/types.h>",
                "#include <sys/param.h>",
                "#include <sys/mount.h>",
            ],
        ) +
        # configure.ac:453: opendisk() and getrawpartition() in NetBSD's
        # -lutil.  Only the defines are modelled; LIBUTIL is a link option no
        # platform this module builds on needs.
        [
            checks.AC_CHECK_HEADER("util.h"),
            checks.AC_CHECK_LIB(
                "util",
                "opendisk",
                define = "HAVE_OPENDISK",
                requires = ["ac_cv_header_util_h"],
            ),
            checks.AC_CHECK_LIB(
                "util",
                "getrawpartition",
                define = "HAVE_GETRAWPARTITION",
                requires = ["ac_cv_header_util_h"],
            ),
            # AC_PROG_LEX (configure.ac:342): flex's yytext is a pointer.
            checks.AC_DEFINE("YYTEXT_POINTER", 1),
        ] +
        # Probes gl_INIT makes through m4 files the registry has no module
        # for: gt_TYPE_WCHAR_T (m4/wchar_t.m4), gl_MBSWIDTH's isascii and
        # mbswidth-declaration checks (m4/mbswidth.m4:14, the packaged module
        # is empty) and gl_FUNC_GETOPT_POSIX's <sys/cdefs.h> probe
        # (m4/getopt.m4:28).
        macros.AC_CHECK_TYPES(
            ["wchar_t"],
            includes = ["#include <stddef.h>"],
        ) + macros.AC_CHECK_FUNCS(["isascii"]) + macros.AC_CHECK_DECLS(
            ["mbswidth"],
            includes = ["#include <wchar.h>"],
        ) + macros.AC_CHECK_HEADERS(["sys/cdefs.h"]) +
        # AC_C_VARARRAYS (gl_INIT): define HAVE_C_VARARRAYS if the compiler
        # takes a variable-length array, __STDC_NO_VLA__ if it does not.  The
        # packaged `vararrays` module answers the second for every compiler.
        [
            checks.AC_TRY_COMPILE(
                name = "ac_cv_c_vararrays",
                code = """#include <stdlib.h>
int main (void) {
  static int x; char a[++x]; a[sizeof a - 1] = 0; return a[0];
}
""",
                define = "HAVE_C_VARARRAYS",
            ),
            checks.AC_DEFINE(
                "__STDC_NO_VLA__",
                1,
                requires = ["!ac_cv_c_vararrays"],
            ),
        ] +
        # gl_LANGINFO_H (m4/langinfo_h.m4:40-80) probes which nl_langinfo
        # items <langinfo.h> declares; the packaged module leaves these two
        # out and langinfo.in.h tests them in `#if`s.
        [
            check
            for item in [
                "T_FMT_AMPM",
                "YESEXPR",
            ]
            for check in [
                checks.AC_TRY_COMPILE(
                    name = "gl_cv_header_langinfo_{}".format(item.lower()),
                    code = "#include <langinfo.h>\nint main (void) { char* cs = nl_langinfo (" + item + "); return !cs; }\n",
                ),
                checks.AC_SUBST(
                    "HAVE_LANGINFO_{}".format(item),
                    condition = "gl_cv_header_langinfo_{}".format(item.lower()),
                    if_false = 0,
                    if_true = 1,
                ),
            ]
        ] +
        # --enable-device-mapper (configure.ac:2224) and --enable-liblzma
        # (:2267); see the flags above for how the guess is made.
        select({
            ":device_mapper": [checks.AC_DEFINE("HAVE_DEVICE_MAPPER", 1)],
            "//conditions:default": [],
        }) + select({
            ":liblzma": [checks.AC_DEFINE("USE_LIBLZMA", 1)],
            "//conditions:default": [],
        }) +
        # The config.h.in substitutions (configure.ac:1883, :1895, :1906,
        # :2485).  HAVE_FONT_SOURCE is 0: there is no unifont to build
        # unicode.pf2 from, which is also why --enable-grub-themes is not an
        # option here.
        select({
            ":mm_debug": [checks.AC_SUBST("MM_DEBUG", 1)],
            "//conditions:default": [checks.AC_SUBST("MM_DEBUG", 0)],
        }) + select({
            ":cache_stats": [checks.AC_SUBST("DISK_CACHE_STATS", 1)],
            "//conditions:default": [checks.AC_SUBST("DISK_CACHE_STATS", 0)],
        }) + select({
            ":boot_time": [checks.AC_SUBST("BOOT_TIME_STATS", 1)],
            "//conditions:default": [checks.AC_SUBST("BOOT_TIME_STATS", 0)],
        }) + [
            # gl_STDBOOL_H (m4/stdbool.m4:28): the packaged module probes the header
            # but leaves GL_GENERATE_STDBOOL_H undecided ("generate the
            # replacement unless the system header works").  The stdalign
            # module decides GL_GENERATE_STDALIGN_H itself since
            # rules_cc_autoconf 0.26.0.
            checks.M4_VARIABLE(
                "GL_GENERATE_STDBOOL_H",
                condition = "HAVE_STDBOOL_H",
                if_false = "true",
                if_true = "false",
            ),
            checks.AC_SUBST("HAVE_FONT_SOURCE", 0),
            # gl_INIT sets this for the gnulib header templates; the
            # toolchain defaults have no value for it.
            checks.AC_SUBST(
                "GUARD_PREFIX",
                value = "GL",
            ),
            # gl_MODULE_INDICATOR_INIT_VARIABLE([GNULIB_UNISTD_H_GETOPT])
            # under AM_COND_IF([GL_COND_OBJ_GETOPT]) (m4/gnulib-comp.m4).
            checks.AC_SUBST(
                "GNULIB_UNISTD_H_GETOPT",
                condition = "ac_cv_subst_REPLACE_GETOPT==1",
                if_false = 0,
                if_true = 1,
            ),
        ] + [
            checks.AC_SUBST(v, 1)
            for v in GNULIB_HEADER_INDICATORS
        ] + [
            checks.AC_DEFINE(v, 1)
            for v in GNULIB_TEST_INDICATORS + GNULIB_MODULE_DEFINES
        ]
    ),
    visibility = ["//visibility:public"],
    deps = [
        ":package",
        # AC_USE_SYSTEM_EXTENSIONS (configure.ac:45).
        "@rules_cc_autoconf//autoconf/macros/AC_USE_SYSTEM_EXTENSIONS",
        # AC_C_BIGENDIAN (configure.ac:398).
        "@rules_cc_autoconf//autoconf/macros/AC_C_BIGENDIAN",
    ] + GL_INIT_DEPS,
)

# AC_CONFIG_HEADERS([config-util.h]) (configure.ac:59).
autoconf_hdr(
    name = "config_util_h",
    out = "config/config-util.h",
    defaults = True,
    # m4/nl_langinfo.m4:43 sets NL_LANGINFO_MTSAFE to 0 on Solaris alone;
    # @rules_cc_autoconf//gnulib/m4/nl_langinfo also does on macOS, and the
    # `!NL_LANGINFO_MTSAFE` arm of nl_langinfo.c is Solaris-only code
    # (MAXSTRMSG).  The slot is filled here instead, so the module's answer
    # is dropped.  TODO: remove once the packaged module zeroes it for
    # Solaris only.
    substitutions = {
        "#undef NL_LANGINFO_MTSAFE": "#define NL_LANGINFO_MTSAFE 1",
    },
    template = "config-util.h.in",
    visibility = ["//visibility:public"],
    deps = [":autoconf"],
)

# AC_CONFIG_FILES([config.h]) (configure.ac:2545).  config.h.in is a
# config.status template rather than an autoheader one: a handful of @VAR@
# substitutions around three `#if` arms for the build tools, the utilities and
# the kernel.  The package names come from :package as quoted C strings, so the
# quotes the template puts around those placeholders are taken off here and
# autoconf_hdr fills them in with the probed and option-dependent ones.
# //platform does the same for the kernel arm of every firmware platform.
expand_template(
    name = "config_h_in",
    out = "config/config.h.in",
    substitutions = {
        "\"@PACKAGE@\"": "@PACKAGE@",
        "\"@PACKAGE_BUGREPORT@\"": "@PACKAGE_BUGREPORT@",
        "\"@PACKAGE_NAME@\"": "@PACKAGE_NAME@",
        "\"@PACKAGE_STRING@\"": "@PACKAGE_STRING@",
        "\"@PACKAGE_VERSION@\"": "@PACKAGE_VERSION@",
        "\"@VERSION@\"": "@VERSION@",
        # The kernel arm is not compiled by any utility, so what the other
        # substitutions take here is immaterial; they get what
        # --with-platform=none gave them.
        "@BSS_START_SYMBOL@": "",
        "@END_SYMBOL@": "",
        "@GRUB_PLATFORM@": "none",
        "@GRUB_STACK_PROTECTOR_INIT@": "",
        "@GRUB_TARGET_CPU@": "none",
        "@HAVE_ASM_USCORE@": "0",
    },
    template = "config.h.in",
    visibility = ["//visibility:public"],
)

autoconf_hdr(
    name = "config_h",
    out = "config/config.h",
    mode = "subst",
    template = ":config_h_in",
    deps = [":autoconf"],
)

# `-I$(top_builddir)` (conf/Makefile.common:35): where config.h and
# config-util.h live.  strip_include_prefix rather than `includes` so they are
# `-I` and come before any `-isystem` config.h a dependency might carry.
cc_library(
    name = "config",
    hdrs = [
        ":config_h",
        ":config_util_h",
    ],
    strip_include_prefix = "config",
    visibility = ["//visibility:public"],
)

# ---------------------------------------------------------------------------
# gnulib (grub-core/lib/gnulib, built as libgnu.a)
# ---------------------------------------------------------------------------

GL = "grub-core/lib/gnulib/"

GL_INLINES = {
    "/* The definition of _GL_ARG_NONNULL is copied here.  */": GL + "arg-nonnull.h",
    "/* The definition of _GL_WARN_ON_USE is copied here.  */": GL + "warn-on-use.h",
    "/* The definition of _Noreturn is copied here.  */": GL + "_Noreturn.h",
    "/* The definitions of _GL_FUNCDECL_RPL etc. are copied here.  */": GL + "c++defs.h",
}

# The substituted gnulib headers grub-core/lib/gnulib/Makefile.am always
# generates.  Output, template and target are derived from the stem the way
# the Makefile derives them (`sys/stat` -> `sys_stat.in.h`).  They are written
# under gnulib_hdrs/ rather than beside the templates: the tarball happens to
# ship a maintainer's generated copies of the same names next to the sources,
# and those must never be found.
GNULIB_GENERATED_HDRS = [
    "ctype",
    "dirent",
    "fcntl",
    "inttypes",
    "langinfo",
    "locale",
    "stdio",
    "stdlib",
    "string",
    "strings",
    "sys/stat",
    "sys/types",
    "time",
    "unistd",
    "unitypes",
    "uniwidth",
    "wchar",
    "wctype",
]

[
    autoconf_hdr(
        name = "gnulib_{}_h".format(stem.replace("/", "_")),
        out = "gnulib_hdrs/{}.h".format(stem),
        defaults = True,
        inlines = GL_INLINES,
        mode = "subst",
        template = GL + "{}.in.h".format(stem.replace("/", "_")),
        deps = [":autoconf"],
    )
    for stem in GNULIB_GENERATED_HDRS
]

cc_library(
    name = "gnulib_generated_hdrs",
    hdrs = [":gnulib_{}_h".format(stem.replace("/", "_")) for stem in GNULIB_GENERATED_HDRS],
    strip_include_prefix = "gnulib_hdrs",
)

# The headers generated only when `GL_GENERATE_*_H` says the system one is
# unusable.  Each is processed unconditionally and cc_gnulib_conditional_hdrs
# keeps the ones whose condition holds.
GNULIB_CONDITIONAL_HDRS = [
    "alloca",
    "errno",
    "float",
    "fnmatch",
    "getopt-cdefs",
    "getopt",
    "limits",
    "stdalign",
    "stdbool",
    "stddef",
    "stdint",
    "sysexits",
]

[
    autoconf_hdr(
        name = "gnulib_{}_h_processed".format(stem.replace("-", "_")),
        out = "_gnulib_cond/{}.h".format(stem),
        defaults = True,
        inlines = GL_INLINES,
        mode = "subst",
        template = GL + "{}.in.h".format(stem),
        deps = [":autoconf"],
    )
    for stem in GNULIB_CONDITIONAL_HDRS
]

cc_gnulib_conditional_hdrs(
    name = "gnulib_conditional_hdrs",
    hdrs = {
        # GL_GENERATE_*_H holds the shell words `true`/`false`, both
        # truthy, so it is compared rather than taken for a boolean.
        ":gnulib_{}_h_processed".format(stem.replace("-", "_")): "GL_GENERATE_{}_H==true".format(stem.replace("-", "_").upper())
        for stem in GNULIB_CONDITIONAL_HDRS
    },
    deps = [":autoconf"],
)

# The gnulib headers that are sources, not templates: everything but the
# generated names above (the tarball's stale copies of which are excluded
# along with the `.in.h` templates).  malloc/dynarray*.gl.h are generated by
# the Makefile too, but by a fixed `sed` over two shipped files with nothing
# configure-dependent in it, so the shipped output is used as is.
GNULIB_HDRS = glob(
    [GL + "**/*.h"],
    exclude = [GL + "**/*.in.h"] + [
        GL + "{}.h".format(stem)
        for stem in GNULIB_GENERATED_HDRS + GNULIB_CONDITIONAL_HDRS
    ],
)

# Conditions for the conditionally compiled gnulib sources, by source, from
# the shell tests `gl_INIT` gates them with (`gl_CONDITIONAL` in
# m4/gnulib-comp.m4, or the `if` around an `AC_LIBOBJ` for calloc, malloc,
# realloc, fnmatch, lc-charset-dispatch and mbtowc-lock).  Each variable is
# spelled as the cache name unique to the check that produced it
# (`ac_cv_subst_`/`ac_cv_define_`/`ac_cv_func_`) rather than a bare name,
# which is looked up across three namespaces and can be missing, ambiguous or
# valueless depending on the platform; `test $X = 1` is `X==1`.  The
# allocator entries compare with 0 rather than with 1 because
# REPLACE_REALLOC_FOR_REALLOC_POSIX is 2 on glibc (0 on macOS).
# memrchr is a bare name because it is an `AC_DEFINE` of a constant on Linux
# and an `AC_CHECK_FUNC` elsewhere.  GL_GENERATE_ERRNO_H holds the shell
# words `true`/`false`, both truthy, so it is compared.
#
# Not listed: float.c and itold.c (gated on AC_RUN_IFELSE probes that cannot
# run here, for compilers this module does not build with), the windows-*.c
# and stat-w32.c objects (mingw), nl_langinfo-lock.c (for the Solaris
# nl_langinfo only, NL_LANGINFO_MTSAFE being 1 everywhere else; see
# :config_util_h) and alloca.c (the packaged `alloca` module never sets
# ALLOCA; every supported compiler has the builtin).
GNULIB_CONDITIONAL_SRCS = {
    "btowc.c": "ac_cv_subst_HAVE_BTOWC==0 || ac_cv_subst_REPLACE_BTOWC==1",
    "calloc.c": "ac_cv_subst_REPLACE_CALLOC_FOR_CALLOC_GNU!=0 || ac_cv_subst_REPLACE_CALLOC_FOR_CALLOC_POSIX!=0",
    "chdir-long.c": "gl_cv_have_unlimited_file_name_length==no",
    "close.c": "ac_cv_subst_REPLACE_CLOSE==1",
    "dirfd.c": "(ac_cv_func_dirfd==0 && gl_cv_func_dirfd_macro==0) || ac_cv_subst_REPLACE_DIRFD==1",
    "dup2.c": "ac_cv_subst_REPLACE_DUP2==1",
    "error.c": "ac_cv_subst_HAVE_ERROR==0 || ac_cv_subst_REPLACE_ERROR==1 || ac_cv_subst_HAVE_ERROR_AT_LINE==0 || ac_cv_subst_REPLACE_ERROR_AT_LINE==1",
    "fchdir.c": "ac_cv_subst_HAVE_FCHDIR==0",
    "fcntl.c": "ac_cv_subst_HAVE_FCNTL==0 || ac_cv_subst_REPLACE_FCNTL==1",
    "fnmatch.c": "ac_cv_subst_HAVE_FNMATCH==0 || ac_cv_subst_REPLACE_FNMATCH==1",
    "free.c": "ac_cv_subst_REPLACE_FREE==1",
    "fstat.c": "ac_cv_subst_REPLACE_FSTAT==1",
    "getcwd-lgpl.c": "ac_cv_subst_REPLACE_GETCWD==1",
    "getdelim.c": "ac_cv_define_HAVE_GETDELIM==0 || ac_cv_subst_REPLACE_GETDELIM==1",
    "getdtablesize.c": "ac_cv_subst_HAVE_GETDTABLESIZE==0 || ac_cv_subst_REPLACE_GETDTABLESIZE==1",
    "getline.c": "ac_cv_subst_REPLACE_GETLINE==1",
    "getopt.c": "ac_cv_subst_REPLACE_GETOPT==1",
    "getopt1.c": "ac_cv_subst_REPLACE_GETOPT==1",
    "isblank.c": "ac_cv_subst_HAVE_ISBLANK==0",
    "lc-charset-dispatch.c": "(ac_cv_subst_HAVE_MBRTOWC==0 || ac_cv_subst_REPLACE_MBRTOWC==1) && ac_cv_subst_REPLACE_MBSTATE_T==1",
    "localeconv.c": "ac_cv_subst_REPLACE_LOCALECONV==1",
    "malloc.c": "ac_cv_subst_REPLACE_MALLOC_FOR_MALLOC_GNU!=0 || ac_cv_subst_REPLACE_MALLOC_FOR_MALLOC_POSIX!=0",
    "mbrtowc.c": "ac_cv_subst_HAVE_MBRTOWC==0 || ac_cv_subst_REPLACE_MBRTOWC==1",
    "mbsinit.c": "ac_cv_subst_HAVE_MBSINIT==0 || ac_cv_subst_REPLACE_MBSINIT==1",
    "mbsrtowcs-state.c": "ac_cv_subst_HAVE_MBSRTOWCS==0 || ac_cv_subst_REPLACE_MBSRTOWCS==1",
    "mbsrtowcs.c": "ac_cv_subst_HAVE_MBSRTOWCS==0 || ac_cv_subst_REPLACE_MBSRTOWCS==1",
    "mbtowc-lock.c": "(ac_cv_subst_HAVE_MBRTOWC==0 || ac_cv_subst_REPLACE_MBRTOWC==1) && ac_cv_subst_REPLACE_MBSTATE_T==1",
    "mbtowc.c": "ac_cv_subst_HAVE_MBTOWC==0 || ac_cv_subst_REPLACE_MBTOWC==1",
    "memchr.c": "ac_cv_subst_REPLACE_MEMCHR==1",
    "mempcpy.c": "ac_cv_subst_HAVE_MEMPCPY==0",
    "memrchr.c": "HAVE_MEMRCHR==0",
    "msvc-inval.c": "ac_cv_subst_HAVE_MSVC_INVALID_PARAMETER_HANDLER==1",
    "msvc-nothrow.c": "ac_cv_subst_HAVE_MSVC_INVALID_PARAMETER_HANDLER==1",
    "nl_langinfo.c": "ac_cv_subst_HAVE_NL_LANGINFO==0 || ac_cv_subst_REPLACE_NL_LANGINFO==1",
    "open.c": "ac_cv_subst_REPLACE_OPEN==1",
    "openat.c": "ac_cv_subst_HAVE_OPENAT==0 || ac_cv_subst_REPLACE_OPENAT==1",
    "pipe.c": "ac_cv_subst_HAVE_PIPE==0",
    "rawmemchr.c": "ac_cv_subst_HAVE_RAWMEMCHR==0",
    "realloc.c": "ac_cv_subst_REPLACE_REALLOC_FOR_REALLOC_GNU!=0 || ac_cv_subst_REPLACE_REALLOC_FOR_REALLOC_POSIX!=0",
    "reallocarray.c": "ac_cv_subst_HAVE_REALLOCARRAY==0 || ac_cv_subst_REPLACE_REALLOCARRAY==1",
    "regex.c": "ac_use_included_regex==yes",
    "setlocale-lock.c": "ac_cv_define_SETLOCALE_NULL_ALL_MTSAFE==0 || ac_cv_define_SETLOCALE_NULL_ONE_MTSAFE==0",
    "sleep.c": "ac_cv_subst_HAVE_SLEEP==0 || ac_cv_subst_REPLACE_SLEEP==1",
    "stat.c": "ac_cv_subst_REPLACE_STAT==1",
    "stdio-read.c": "ac_cv_subst_REPLACE_STDIO_READ_FUNCS==1",
    "stdio-write.c": "ac_cv_subst_REPLACE_STDIO_WRITE_FUNCS==1",
    "strcasecmp.c": "ac_cv_subst_HAVE_STRCASECMP==0",
    "strchrnul.c": "ac_cv_subst_HAVE_STRCHRNUL==0 || ac_cv_subst_REPLACE_STRCHRNUL==1",
    "strdup.c": "ac_cv_subst_REPLACE_STRDUP==1",
    "strerror-override.c": "GL_GENERATE_ERRNO_H==true || ac_cv_define_REPLACE_STRERROR_0==1",
    "strerror.c": "ac_cv_subst_REPLACE_STRERROR==1",
    "strncasecmp.c": "ac_cv_subst_HAVE_STRNCASECMP==0",
    "strndup.c": "ac_cv_func_strndup==0 || ac_cv_subst_REPLACE_STRNDUP==1",
    "strnlen.c": "ac_cv_subst_HAVE_DECL_STRNLEN==0 || ac_cv_subst_REPLACE_STRNLEN==1",
    "uniwidth/width.c": "ac_cv_subst_HAVE_LIBUNISTRING!=yes",
    "vsnprintf.c": "ac_cv_define_HAVE_VSNPRINTF==0 || ac_cv_subst_REPLACE_VSNPRINTF==1",
    "wcrtomb.c": "ac_cv_subst_HAVE_WCRTOMB==0 || ac_cv_subst_REPLACE_WCRTOMB==1",
    "wcwidth.c": "ac_cv_define_HAVE_WCWIDTH==0 || ac_cv_subst_REPLACE_WCWIDTH==1",
    "wmemchr.c": "ac_cv_subst_HAVE_WMEMCHR==0",
    "wmempcpy.c": "ac_cv_subst_HAVE_WMEMPCPY==0",
}

autoconf_srcs(
    name = "gnulib_conditional_srcs",
    srcs = {GL + src: condition for src, condition in GNULIB_CONDITIONAL_SRCS.items()},
    # The REPLACE_* and HAVE_* a `gl_<hdr>_H_DEFAULTS` leaves at their defaults
    # live in the toolchain defaults, not in any dep.
    defaults = True,
    deps = [":autoconf"],
)

# libgnu_a_SOURCES (grub-core/lib/gnulib/Makefile.am), the unconditional
# part, plus the vasnprintf family: gl_FUNC_VASNPRINTF AC_LIBOBJs those four
# whenever the C library has no vasnprintf(), which is every C library this
# module builds against.
GNULIB_SRCS = [GL + src for src in [
    "argp-ba.c",
    "argp-eexst.c",
    "argp-fmtstream.c",
    "argp-fs-xinl.c",
    "argp-help.c",
    "argp-parse.c",
    "argp-pin.c",
    "argp-pv.c",
    "argp-pvh.c",
    "argp-xinl.c",
    "base64.c",
    "basename-lgpl.c",
    "c-ctype.c",
    "cloexec.c",
