# ---------------------------------------------------------------------------
# Programs (Makefile.util.def).  Every one links the three libraries above
# and libgnu.a; the `$(LIBZFS) $(LIBNVPAIR) $(LIBGEOM)` upstream also lists
# are empty on every host this module builds for.
#
# Not built: grub-protect (COND_GRUB_PROTECT -- the registry has no libtasn1)
# and grub-macho2img (COND_APPLE_LINKER -- only with Apple's linker as the
# target toolchain, which no supported platform is).
# ---------------------------------------------------------------------------

# Upstream's names for the three archives.
[
    alias(
        name = "lib" + name,
        actual = ":" + name,
        visibility = ["//visibility:public"],
    )
    for name in [
        "grubgcry",
        "grubkern",
        "grubmods",
    ]
]

PROGRAM_DEPS = [
    ":config",
    ":gcrypt_src_hdrs",
    ":gnulib",
    ":grubgcry",
    ":grubkern",
    ":grubmods",
    ":headers",
]

# The source groups the programs share (Makefile.util.def): the argp front
# end of every command-line program, the image writer, what the installers
# add to it, grub-setup's two halves and the host disk and file system of the
# programs that read images from directories.
ARGP_SRCS = [
    "grub-core/kern/emu/argp_common.c",
    "grub-core/osdep/init.c",
]

MKIMAGE_SRCS = [
    "grub-core/osdep/config.c",
    "util/config.c",
    "util/grub-mkimage32.c",
    "util/grub-mkimage64.c",
    "util/mkimage.c",
    "util/resolve.c",
]

INSTALL_SRCS = MKIMAGE_SRCS + [
    "grub-core/lib/reed_solomon.c",
    "grub-core/osdep/blocklist.c",
    "grub-core/osdep/compress.c",
    "grub-core/osdep/ofpath.c",
    "grub-core/osdep/platform.c",
    "grub-core/osdep/platform_unix.c",
    "grub-core/osdep/random.c",
    "util/editenv.c",
    "util/grub-install-common.c",
    "util/setup_bios.c",
    "util/setup_sparc.c",
]

SETUP_SRCS = [
    "grub-core/lib/reed_solomon.c",
    "grub-core/osdep/blocklist.c",
    "util/grub-setup.c",
]

HOSTFS_SRCS = [
    "grub-core/disk/host.c",
    "grub-core/kern/emu/hostfs.c",
]

# `$(LIBLZMA)` (Makefile.util.def) goes to the programs that link
# util/mkimage.c, the one user of xz: grub-mkimage and the installers compress
# MIPS images with it.
LZMA_DEPS = select({
    ":liblzma": ["@xz//:lzma"],
    "//conditions:default": [],
})

# The programs with no option of their own.  util/grub-setup.c is built twice,
# once per GRUB_SETUP_FUNC; grub-mkrescue and grub-mkstandalone are
# COND_HAVE_EXEC (configure.ac:189): every host but Windows and AROS.
PROGRAMS = {
    "grub-bios-setup": ARGP_SRCS + SETUP_SRCS + ["util/setup_bios.c"],
    "grub-editenv": MKIMAGE_SRCS + [
        "grub-core/osdep/compress.c",
        "grub-core/osdep/init.c",
        "util/editenv.c",
        "util/grub-editenv.c",
        "util/grub-install-common.c",
    ],
    "grub-file": HOSTFS_SRCS + [
        "grub-core/commands/file.c",
        "grub-core/commands/file32.c",
        "grub-core/commands/file64.c",
        "grub-core/io/offset.c",
        "grub-core/kern/elf.c",
        "grub-core/loader/i386/xen_file.c",
        "grub-core/loader/i386/xen_file32.c",
        "grub-core/loader/i386/xen_file64.c",
        "grub-core/loader/lzss.c",
        "grub-core/loader/macho.c",
        "grub-core/loader/macho32.c",
        "grub-core/loader/macho64.c",
        "grub-core/osdep/init.c",
        "util/grub-file.c",
        "util/render-label.c",
    ],
    "grub-fstest": HOSTFS_SRCS + [
        "grub-core/osdep/init.c",
        "util/grub-fstest.c",
        ":grub_fstest_init_c",
    ],
    "grub-glue-efi": ARGP_SRCS + [
        "util/glue-efi.c",
        "util/grub-glue-efi.c",
    ],
    "grub-install": ARGP_SRCS + HOSTFS_SRCS + INSTALL_SRCS + [
        "util/grub-install.c",
        "util/probe.c",
        "util/render-label.c",
    ],
    "grub-macbless": ARGP_SRCS + ["util/grub-macbless.c"],
    "grub-menulst2cfg": [
        "grub-core/lib/i386/pc/vesa_modes_table.c",
        "grub-core/lib/legacy_parse.c",
        "grub-core/osdep/init.c",
        "util/grub-menulst2cfg.c",
    ],
    "grub-mkimage": ARGP_SRCS + MKIMAGE_SRCS + ["util/grub-mkimage.c"],
    "grub-mklayout": ARGP_SRCS + ["util/grub-mklayout.c"],
    "grub-mknetdir": ARGP_SRCS + INSTALL_SRCS + ["util/grub-mknetdir.c"],
    "grub-mkpasswd-pbkdf2": ARGP_SRCS + [
        "grub-core/osdep/random.c",
        "util/grub-mkpasswd-pbkdf2.c",
    ],
    "grub-mkrelpath": ARGP_SRCS + ["util/grub-mkrelpath.c"],
    "grub-mkrescue": ARGP_SRCS + HOSTFS_SRCS + INSTALL_SRCS + [
        "util/glue-efi.c",
        "util/grub-mkrescue.c",
        "util/render-label.c",
    ],
    "grub-mkstandalone": ARGP_SRCS + HOSTFS_SRCS + INSTALL_SRCS + [
        "util/glue-efi.c",
        "util/grub-mkstandalone.c",
        "util/render-label.c",
    ],
    "grub-ofpathname": [
        "grub-core/osdep/init.c",
        "grub-core/osdep/ofpath.c",
        "util/ieee1275/grub-ofpathname.c",
    ],
    "grub-probe": ARGP_SRCS + [
        "grub-core/osdep/ofpath.c",
        "util/grub-probe.c",
        "util/probe.c",
    ],
    "grub-render-label": ARGP_SRCS + HOSTFS_SRCS + [
        "util/grub-render-label.c",
        "util/render-label.c",
    ],
    "grub-script-check": ARGP_SRCS + ["util/grub-script-check.c"],
    "grub-sparc64-setup": ARGP_SRCS + SETUP_SRCS + [
        "grub-core/osdep/ofpath.c",
        "util/setup_sparc.c",
    ],
    "grub-syslinux2cfg": ARGP_SRCS + HOSTFS_SRCS + [
        "grub-core/lib/getline.c",
        "grub-core/lib/syslinux_parse.c",
        "util/grub-syslinux2cfg.c",
    ],
}

PROGRAM_DEFINES = {
    "grub-bios-setup": ["GRUB_SETUP_FUNC=grub_util_bios_setup"],
    "grub-sparc64-setup": ["GRUB_SETUP_FUNC=grub_util_sparc_setup"],
}

[
    cc_binary(
        name = name,
        srcs = srcs,
        copts = COPTS,
        local_defines = LOCAL_DEFINES + PROGRAM_DEFINES.get(name, []),
        toolchains = [":install_dirs"],
        visibility = ["//visibility:public"],
        deps = PROGRAM_DEPS + (LZMA_DEPS if "util/mkimage.c" in srcs else []),
    )
    for name, srcs in PROGRAMS.items()
]

# --enable-grub-mount (configure.ac:2199): fuse3, hence Linux only.
cc_binary(
    name = "grub-mount",
    srcs = HOSTFS_SRCS + [
        "grub-core/osdep/init.c",
        "util/grub-mount.c",
        ":grub_fstest_init_c",
    ],
    copts = COPTS,
    # fuse.c dlopen()s FUSE modules; glibc before 2.34 (debian11, ubuntu2004)
    # keeps the dl* functions in libdl, which @libfuse does not link itself.
    linkopts = ["-ldl"],
    local_defines = LOCAL_DEFINES + [
        "FUSE_USE_VERSION=32",
    ],
    # COND_GRUB_MOUNT (configure.ac): the program is not built, and so not
    # installed, when the option is off; here the target is incompatible, so
    # `//...` skips it and naming it says why.
    target_compatible_with = select({
        ":grub_mount": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    toolchains = [":install_dirs"],
    visibility = ["//visibility:public"],
    deps = PROGRAM_DEPS + [
        "@libfuse",
    ],
)

# --enable-grub-mkfont (configure.ac:2003).
cc_binary(
    name = "grub-mkfont",
    srcs = ARGP_SRCS + ["util/grub-mkfont.c"],
    copts = COPTS,
    local_defines = LOCAL_DEFINES + [
        "GRUB_MKFONT=1",
    ],
    # COND_GRUB_MKFONT (configure.ac): the program is not built, and so not
    # installed, when the option is off; here the target is incompatible, so
    # `//...` skips it and naming it says why.
    target_compatible_with = select({
        ":grub_mkfont": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    toolchains = [":install_dirs"],
    visibility = ["//visibility:public"],
    deps = PROGRAM_DEPS + [
        "@freetype",
    ],
)

# ---------------------------------------------------------------------------
# Scripts, etc/grub.d and the bash completions (Makefile.util.def, config.status
# --file substitution of the .in templates)
# ---------------------------------------------------------------------------

[
    configure_script(
        name = name,
        out = "bin/" + name if dir == "bin" else "sbin/" + name,
        settings = SCRIPT_SETTINGS,
        substitutions = SCRIPT_SUBSTITUTIONS,
        template = "util/{}.in".format(name),
        visibility = ["//visibility:public"],
    )
    for name, dir in {
        "grub-kbdcomp": "bin",
        "grub-mkconfig": "sbin",
        "grub-reboot": "sbin",
        "grub-set-default": "sbin",
    }.items()
]

# installdir = noinst in Makefile.util.def, but Makefile.util.am installs it
# as pkgdata: $(datadir)/grub/grub-mkconfig_lib, which is where grub-mkconfig
# and every grub.d script source it from.
configure_script(
    name = "grub-mkconfig_lib",
    out = "share/grub/grub-mkconfig_lib",
    is_executable = False,
    settings = SCRIPT_SETTINGS,
    substitutions = SCRIPT_SUBSTITUTIONS,
    template = "util/grub-mkconfig_lib.in",
    visibility = ["//visibility:public"],
)

# etc/grub.d (grubconf_SCRIPTS).  10_linux and 20_linux_xen are COND_HOST_LINUX,
# 10_xnu is COND_HOST_XNU; the hurd, kfreebsd, illumos, netbsd and windows
# ones are for hosts this module does not build on.
[
    configure_script(
        name = "grub.d/" + name,
        out = "etc/grub.d/" + name,
        settings = SCRIPT_SETTINGS,
        substitutions = SCRIPT_SUBSTITUTIONS,
        template = "util/grub.d/{}.in".format(name),
        visibility = ["//visibility:public"],
    )
    for name in [
        "00_header",
        "10_linux",
        "10_xnu",
        "20_linux_xen",
        "25_bli",
        "30_os-prober",
        "30_uefi-firmware",
        "40_custom",
        "41_custom",
    ]
]

filegroup(
    name = "grub.d",
    srcs = [
        "grub.d/00_header",
        "grub.d/25_bli",
        "grub.d/30_os-prober",
        "grub.d/30_uefi-firmware",
        "grub.d/40_custom",
        "grub.d/41_custom",
        "util/grub.d/README",
    ] + select({
        "@platforms//os:macos": ["grub.d/10_xnu"],
        "//conditions:default": [
            "grub.d/10_linux",
            "grub.d/20_linux_xen",
        ],
    }),
    visibility = ["//visibility:public"],
)

# util/bash-completion.d/Makefile.am.  grub-completion.bash.in becomes the
# completion named after the package; the rest after their program.
BASH_COMPLETIONS = {
    "grub": "grub-completion",
    "grub-bios-setup": "grub-bios-setup",
    "grub-editenv": "grub-editenv",
    "grub-install": "grub-install",
    "grub-mkconfig": "grub-mkconfig",
    "grub-mkfont": "grub-mkfont",
    "grub-mkimage": "grub-mkimage",
    "grub-mkpasswd-pbkdf2": "grub-mkpasswd-pbkdf2",
    "grub-mkrescue": "grub-mkrescue",
    "grub-probe": "grub-probe",
    "grub-reboot": "grub-reboot",
    "grub-script-check": "grub-script-check",
    "grub-set-default": "grub-set-default",
    "grub-sparc64-setup": "grub-sparc64-setup",
}

[
    configure_script(
        name = "bash-completion/" + name,
        out = "share/bash-completion/completions/" + name,
        is_executable = False,
        settings = SCRIPT_SETTINGS,
        substitutions = SCRIPT_SUBSTITUTIONS,
        template = "util/bash-completion.d/{}.bash.in".format(source),
    )
    for name, source in BASH_COMPLETIONS.items()
]

filegroup(
    name = "bash-completion",
    srcs = ["bash-completion/" + name for name in BASH_COMPLETIONS],
    visibility = ["//visibility:public"],
)

# The bin_PROGRAMS/bin_SCRIPTS and sbin_PROGRAMS/sbin_SCRIPTS sets, for
# consumers that stage an install tree; the optional programs are listed only
# when their option is on, since a filegroup is incompatible when any of its
# sources is.
filegroup(
    name = "bin",
    srcs = [
        "grub-editenv",
        "grub-file",
        "grub-fstest",
        "grub-glue-efi",
        "grub-kbdcomp",
        "grub-menulst2cfg",
        "grub-mkimage",
        "grub-mklayout",
        "grub-mknetdir",
        "grub-mkpasswd-pbkdf2",
        "grub-mkrelpath",
        "grub-mkrescue",
        "grub-mkstandalone",
        "grub-render-label",
        "grub-script-check",
        "grub-syslinux2cfg",
    ] + select({
        ":grub_mkfont": ["grub-mkfont"],
        "//conditions:default": [],
    }) + select({
        ":grub_mount": ["grub-mount"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "sbin",
    srcs = [
        "grub-bios-setup",
        "grub-install",
        "grub-macbless",
        "grub-mkconfig",
        "grub-ofpathname",
        "grub-probe",
        "grub-reboot",
        "grub-set-default",
        "grub-sparc64-setup",
    ],
    visibility = ["//visibility:public"],
)
