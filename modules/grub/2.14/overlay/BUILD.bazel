# AC_INIT([GRUB],[2.14],[bug-grub@gnu.org]) (configure.ac:37).  PACKAGE and
# VERSION follow the tarname and version as AM_INIT_AUTOMAKE makes them.  The
# version comes from MODULE.bazel so a `.bcr.N` bump has one place to edit;
# `strip_bcr_version` keeps that suffix out of `--version`.
autoconf_package_info(
    name = "package",
    package_name = "GRUB",
    aliases = {
        "PACKAGE": "PACKAGE_TARNAME",
        "VERSION": "PACKAGE_VERSION",
    },
    module_bazel = "MODULE.bazel",
    package_bugreport = "bug-grub@gnu.org",
    package_tarname = "grub",
    strip_bcr_version = True,
)

# The version for the shell script templates, where autoconf_package_info's
# substitutions would arrive as quoted C literals.
_VERSION = "2.14"

# ---------------------------------------------------------------------------
# configure options
# ---------------------------------------------------------------------------

# --with-bootdir and --with-grubdir (configure.ac:293 and :313).
string_flag(
    name = "bootdir",
    build_setting_default = "boot",
    visibility = ["//visibility:public"],
)

string_flag(
    name = "grubdir",
    build_setting_default = "grub",
    visibility = ["//visibility:public"],
)

# --enable-mm-debug, --enable-cache-stats, --enable-boot-time
# (configure.ac:1875, :1886, :1897).
bool_flag(
    name = "enable_mm_debug",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "enable_cache_stats",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "enable_boot_time",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "mm_debug",
    flag_values = {":enable_mm_debug": "True"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "cache_stats",
    flag_values = {":enable_cache_stats": "True"},
    visibility = ["//visibility:public"],
)

config_setting(
    name = "boot_time",
    flag_values = {":enable_boot_time": "True"},
    visibility = ["//visibility:public"],
)

# The four optional dependencies configure "guesses" (default=guessed) by
# probing the host.  Here the dependency is a registry module, so the guess is
# simply whether the module has it: grub-mkfont (freetype2, configure.ac:2003)
# and liblzma (xz, :2267) everywhere; grub-mount (fuse3, :2199) and
# device-mapper (lvm2, :2224) only on Linux, which is the only host where
# upstream's header probe can succeed.  grub-protect (libtasn1, :2345) and
# libzfs (:2295) stay off: the registry has neither library.
bool_flag(
    name = "enable_grub_mkfont",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "enable_liblzma",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "enable_grub_mount",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "enable_device_mapper",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "grub_mkfont",
    flag_values = {":enable_grub_mkfont": "True"},
)

config_setting(
    name = "liblzma",
    flag_values = {":enable_liblzma": "True"},
)

config_setting(
    name = "_enable_grub_mount",
    flag_values = {":enable_grub_mount": "True"},
)

config_setting(
    name = "_enable_device_mapper",
    flag_values = {":enable_device_mapper": "True"},
)

selects.config_setting_group(
    name = "grub_mount",
    match_all = [
        ":_enable_grub_mount",
        "@platforms//os:linux",
    ],
)

selects.config_setting_group(
    name = "device_mapper",
    match_all = [
        ":_enable_device_mapper",
        "@platforms//os:linux",
    ],
)

# The install layout.  configure bakes the directories into the programs
# (GRUB_LIBDIR and friends, configure.ac:2503) and into the scripts
# (@bindir@ ...); defaults are autoconf's for `--prefix=/usr/local`.
# grub-install looks for the platform modules under `$libdir/grub/`.
[
    string_flag(
        name = name,
        build_setting_default = default,
        visibility = ["//visibility:public"],
    )
    for name, default in {
        "bindir": "/usr/local/bin",
        "datadir": "/usr/local/share",
        "datarootdir": "/usr/local/share",
        "exec_prefix": "/usr/local",
        "libdir": "/usr/local/lib",
        "localedir": "/usr/local/share/locale",
        "prefix": "/usr/local",
        "sbindir": "/usr/local/sbin",
        "sysconfdir": "/usr/local/etc",
    }.items()
]

# AC_DEFINE_UNQUOTED(GRUB_BOOT_DIR_NAME ...) (configure.ac:310, :320, :2503).
# These reach the compiler as `-D`s rather than through config-util.h because a
# build setting's value is not known when the checks are declared.
INSTALL_DIRS = {
    ":bootdir": "GRUB_BOOT_DIR_NAME",
    ":datadir": "GRUB_DATADIR",
    ":grubdir": "GRUB_DIR_NAME",
    ":libdir": "GRUB_LIBDIR",
    ":localedir": "LOCALEDIR",
    ":sysconfdir": "GRUB_SYSCONFDIR",
}

install_dirs(
    name = "install_dirs",
    settings = INSTALL_DIRS,
)

INSTALL_DIR_DEFINES = ["{0}=\\\"$({0})\\\"".format(v) for v in INSTALL_DIRS.values()]

# The @VAR@ substitutions every script and completion template shares.  The
# `grub_*` names are the program-name transforms (configure.ac:62); with no
# --program-prefix they are the names themselves.
SCRIPT_SETTINGS = {
    ":bindir": "@bindir@",
    ":bootdir": "@bootdirname@",
    ":datadir": "@datadir@",
    ":datarootdir": "@datarootdir@",
    ":exec_prefix": "@exec_prefix@",
    ":grubdir": "@grubdirname@",
    ":libdir": "@libdir@",
    ":localedir": "@localedir@",
    ":prefix": "@prefix@",
    ":sbindir": "@sbindir@",
    ":sysconfdir": "@sysconfdir@",
}

SCRIPT_SUBSTITUTIONS = {
    "@PACKAGE@": "grub",
    "@PACKAGE_NAME@": "GRUB",
    "@PACKAGE_VERSION@": _VERSION,
    "@grub_bios_setup@": "grub-bios-setup",
    "@grub_editenv@": "grub-editenv",
    "@grub_file@": "grub-file",
    "@grub_install@": "grub-install",
    "@grub_mkconfig@": "grub-mkconfig",
    "@grub_mkfont@": "grub-mkfont",
    "@grub_mkimage@": "grub-mkimage",
    "@grub_mklayout@": "grub-mklayout",
    "@grub_mkpasswd_pbkdf2@": "grub-mkpasswd-pbkdf2",
    "@grub_mkrelpath@": "grub-mkrelpath",
    "@grub_mkrescue@": "grub-mkrescue",
    "@grub_probe@": "grub-probe",
    "@grub_reboot@": "grub-reboot",
    "@grub_script_check@": "grub-script-check",
    "@grub_set_default@": "grub-set-default",
    "@grub_sparc64_setup@": "grub-sparc64-setup",
} | select({
    "@platforms//os:macos": {"@host_os@": "darwin"},
    "//conditions:default": {"@host_os@": "linux-gnu"},
})

# ---------------------------------------------------------------------------
# Compiler flags
# ---------------------------------------------------------------------------

# HOST_CFLAGS (configure.ac:102, :513).  The warning sets and -Werror are
# upstream's own CI gate and are replaced by `-w`, as is usual for registry
# modules.
COPTS = [
    "-w",
    "-std=gnu99",
    "-fno-common",
]

# HOST_CPPFLAGS (configure.ac:106-107, :391) plus the `-DHAVE_CONFIG_H` automake
# adds.  CPPFLAGS_DEFAULT (conf/Makefile.common:32) defines GRUB_FILE to each
# source's path relative to the source tree, which only grub_dprintf() reads;
# __FILE__ is the same thing with Bazel's prefix on it.
LOCAL_DEFINES = [
    "HAVE_CONFIG_H",
    "GRUB_UTIL=1",
    "_FILE_OFFSET_BITS=64",
    "GRUB_FILE=__FILE__",
] + INSTALL_DIR_DEFINES

# gl_INIT (configure.ac:512).
#
# `gnulib-tool` copied ~190 `.m4` files into `m4/` and `m4/gnulib-comp.m4`
# invokes them from `gl_INIT`; the list below is those files for which
# `@rules_cc_autoconf//gnulib/m4/` ships an implementation, so it stands in for
# the generated `gl_INIT` body.  It cannot be made implicit through the
# autoconf toolchain: `cache_deps` only dedupes checker actions and the
# toolchain `defaults` carry only the `gl_*_H_DEFAULTS` substitutions, so
# without these config-util.h would lose the gnulib HAVE_* set and the
