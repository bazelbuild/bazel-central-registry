# uniwidth/width.c includes its tables by bare name from its own directory,
# which the conditionally compiled copy no longer sits in.
cc_library(
    name = "gnulib_uniwidth_hdrs",
    hdrs = glob([GL + "uniwidth/*.h"]),
    strip_include_prefix = GL + "uniwidth",
)

cc_library(
    name = "gnulib",
    srcs = GNULIB_SRCS + [":gnulib_conditional_srcs"],
    hdrs = GNULIB_HDRS,
    # regex.c and fnmatch.c include their bodies from their own directory,
    # which the conditionally compiled copies no longer sit in, and regexec.c
    # includes <malloc/dynarray-skeleton.c>.  Only Bazel 9 links the
    # textual_hdrs below into the strip_include_prefix tree, so the source
    # directory is searched as well, last, where the stale generated headers
    # the tarball ships beside the sources lose to the system ones.
    copts = COPTS + [
        "-idirafter",
        paths.join(
            package_relative_label(":BUILD.bazel").workspace_root,
            GL,
        ),
    ],
    implementation_deps = [":gnulib_uniwidth_hdrs"],
    # grub-core/lib/gnulib/Makefile.am compiles libgnu.a with only automake's
    # -DHAVE_CONFIG_H and the top-level CPPFLAGS (configure.ac:390), no
    # GRUB_UTIL: config.h then takes its `!defined (GRUB_MACHINE)` arm, which
    # is config-util.h all the same.
    # LIBMULTITHREAD: gl_THREADLIB (m4/threadlib.m4) sets it to -lpthread, and
    # the pthread calls in glthread/lock.c bind to it.  The packaged module
    # names no library and takes pthread to be in libc on every Linux, which
    # holds only from glibc 2.34; the earlier ones ship it separately, and
    # the later ones keep an empty libpthread so the option stays valid.
    linkopts = select({
        "@platforms//os:linux": ["-lpthread"],
        "//conditions:default": [],
    }),
    local_defines = [
        "HAVE_CONFIG_H",
        "_FILE_OFFSET_BITS=64",
    ],
    strip_include_prefix = GL,
    textual_hdrs = [GL + src for src in [
        "fnmatch_loop.c",
        "malloc/dynarray-skeleton.c",
        "regcomp.c",
        "regex_internal.c",
        "regexec.c",
    ]],
    visibility = ["//visibility:public"],
    deps = [
        ":config",
        ":gnulib_conditional_hdrs",
        ":gnulib_generated_hdrs",
    ],
)

