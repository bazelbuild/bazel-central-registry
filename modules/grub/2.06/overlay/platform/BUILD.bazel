"""The firmware platforms, as data and as compile targets.

One `<platform>.bzl` per platform gentpl.py knows (platforms.bzl indexes them,
common.bzl describes them).  For each, `grub_platform` declares the probed
TARGET_* flags, the kernel arm of config.h, the include trees and a
cc_library per kernel, module and boot image, so that a rule set building the
image shares the compiles and only links what comes out.
"""

load(":platform.bzl", "grub_platform")
load(":platforms.bzl", "PLATFORM_DATA")

package(default_visibility = ["//visibility:public"])

[
    grub_platform(
        name = name,
        data = data,
    )
    for name, data in PLATFORM_DATA.items()
]
