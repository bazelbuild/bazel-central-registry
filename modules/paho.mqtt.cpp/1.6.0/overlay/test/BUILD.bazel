load("@rules_cc//cc:defs.bzl", "cc_test")

cc_test(
    name = "tests",
    srcs = glob(
        [
            "unit/*.cpp",
            "unit/*.h",
        ],
        exclude = ["unit/test_async_client_v3.cpp"],  # Needs Cppunit
    ),
    # Client tests require a running MQTT broker.
    # Currently external public MQTT broker is unavailable.
    args = ["~[client]"],
    data = glob(["ssl/*"]),
    deps = [
        "@catch2",
        "@paho.mqtt.cpp",
    ],
)
