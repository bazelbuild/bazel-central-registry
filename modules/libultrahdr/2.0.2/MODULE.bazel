    patch_args = ["-p1"],
    patches = ["//:deps/heif_gainmap.patch"],
    strip_prefix = "libheif-1.21.2",
    urls = ["https://github.com/strukturag/libheif/releases/download/v1.21.2/libheif-1.21.2.tar.gz"],
)

http_archive(
    name = "ultrahdr_smpte",
    build_file = "//:smpte.BUILD.bazel",
    integrity = "sha256-waxXIwejjfEBlPRKKrD5kkCqc0KznN4EEFbO186X1UA=",
    patch_args = ["-p1"],
    patches = ["//:deps/smpte_cxx_bridge.patch"],
    strip_prefix = "libsmpte2094-50-0.1.4",
