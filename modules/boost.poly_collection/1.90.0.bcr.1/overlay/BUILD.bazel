load("@rules_cc//cc:cc_library.bzl", "cc_library")

# begin/end_no_sanitize.hpp are textual fragments rather than headers: no include
# guards, and they are included as a matched pair partway through another header
# to wrap a declaration in a diagnostic push/pop. They cannot compile standalone.
_TEXTUAL_HDRS = [
    "include/boost/poly_collection/detail/begin_no_sanitize.hpp",
    "include/boost/poly_collection/detail/end_no_sanitize.hpp",
]

cc_library(
    name = "boost.poly_collection",
    hdrs = glob(
        [
            "include/**/*.hpp",
        ],
        exclude = _TEXTUAL_HDRS,
    ),
    features = [
        "parse_headers",
    ],
    includes = ["include"],
    textual_hdrs = _TEXTUAL_HDRS,
    visibility = ["//visibility:public"],
    deps = [
        "@boost.assert",
        "@boost.config",
        "@boost.core",
        "@boost.detail",
        "@boost.iterator",
        "@boost.mp11",
        "@boost.mpl",
        "@boost.type_erasure",
        "@boost.type_traits",
    ],
)
