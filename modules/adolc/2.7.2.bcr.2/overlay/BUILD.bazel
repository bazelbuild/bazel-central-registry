load("@rules_foreign_cc//foreign_cc:defs.bzl", "configure_make")

filegroup(
    name = "adolc_sources",
    srcs = glob(
        ["**"],
        exclude = [
            "BUILD",
            "BUILD.bazel",
            "MODULE.bazel",
        ],
    ),
)

configure_make(
    name = "adolc",
    copts = [
        "-Wno-error=unused-variable",
        "-Wno-error=unused-but-set-variable",
        "-Wno-error=sign-compare",
    ],
    configure_options = [
        "--enable-sparse",
        "--libdir=$$BUILD_TMPDIR/$$INSTALL_PREFIX/lib",
    ],
    deps = ["@colpack//:colpack"],
    lib_source = ":adolc_sources",
    out_include_dir = "include",
    out_shared_libs = ["libadolc.so.2"],
    visibility = ["//visibility:public"],
)
