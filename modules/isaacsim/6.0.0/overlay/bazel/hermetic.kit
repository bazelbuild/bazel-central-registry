# Layered onto every run except //:precache with --merge-config.
[package]
title = "Hermetic run"
version = "0.1.0"

[settings.app.extensions]
# Every extension the app resolves is pinned in //bazel:exts_lock.json and
# offered out of the runfiles tree. Leaving the registry enabled would let a gap
# in the lock be papered over by a silent download: the run still works, but it
# is neither reproducible nor offline, and the gap goes unnoticed. With the
# registry off, a gap is a startup error instead.
registryEnabled = false

[settings.telemetry]
# The stock isaacsim.exp.base.kit turns anonymous usage telemetry on. A build
# action has no business phoning home.
enableAnonymousAppName = false
enableAnonymousData = false
