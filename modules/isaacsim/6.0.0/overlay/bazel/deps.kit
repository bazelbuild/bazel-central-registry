# Layered onto Isaac Sim's own app config with --merge-config.
#
# Extensions the shipped packages need but do not declare. Kit resolves only what
# is declared, so an undeclared dependency is simply missing at runtime: the
# extension starts and then fails to acquire an interface or import a name.
#
# Note these go in `app.exts.enabled` rather than a [dependencies] block --
# --merge-config merges settings, and a merged [dependencies] section does not
# take part in the app's dependency resolution.
[package]
title = "Isaac Sim missing dependencies"
version = "0.1.0"

[settings.app.exts.enabled]
# isaacsim.core.experimental.prims acquires
# isaacsim::core::experimental::prims::IPrimDataReader, whose carbonite plugin
# lives in a separate extension that prims' own [dependencies] omits. Without
# this, prims fails to start and isaacsim.core.experimental.actuators then fails
# with "cannot import name 'Articulation'".
"++" = ["isaacsim.core.experimental.primdata"]
