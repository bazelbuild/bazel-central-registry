# A Kit app that is only the kernel: no renderer, no UI, no prebuilt extensions.
#
# Used by //:extensions_test to check that Kit can discover and parse every
# isaacsim.* extension built from source. That needs no GPU and none of the
# closed extension closure, so it is the part of "does Isaac Sim start" that a
# machine without an RTX card -- a CI runner, say -- can still answer.
[package]
title = "Isaac Sim extension check"
version = "1.0.0"
keywords = ["app"]

[settings.app]
# Nothing may be pulled from a registry: the point is to test what was built.
extensions.registryEnabled = false
window.hideUi = true
