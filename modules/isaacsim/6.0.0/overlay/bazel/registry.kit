# Layered onto Isaac Sim's own app config with --merge-config, for re-pinning
# //bazel:exts_lock.json only -- see //bazel/README.md. No run target uses it,
# so nothing reaches a registry at run time.
#
# The stock isaacsim.exp.base.kit does not declare the Isaac Sim extension
# registry (only isaacsim.exp.base.python.kit does), and resolving the app needs
# it: the isaacsim.* extensions that cannot be built from source -- those with
# .ogn nodes, those with C++ sources, and the few absent from the source tree --
# are published there.
[package]
title = "Isaac Sim registry overlay"
version = "0.1.0"

[settings.exts."omni.kit.registry.nucleus".registries]
"++" = [
    { name = "isaacsim/prod/6.0", url = "https://ovextensionsprod.blob.core.windows.net/exts/isaacsim/prod/6.0/shared" },
]
