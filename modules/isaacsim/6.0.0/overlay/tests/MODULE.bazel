module(name = "isaacsim_test_module")

bazel_dep(name = "isaacsim")
local_path_override(
    module_name = "isaacsim",
    path = "..",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cuda", version = "0.3.0")
bazel_dep(name = "rules_python", version = "2.2.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

# Kit embeds CPython 3.12 and refuses to import a Python module built against
# any other minor version. @pybind11 follows whatever the root module made
# current, so the root module is where that has to be said.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.12")
python.toolchain(python_version = "3.12")

# Isaac Sim's native extensions compile against CUDA, and rules_cuda takes that
# configuration from the root module only -- so it has to be here rather than in
# @isaacsim. 12.8 is what Isaac Sim 6.0.0 is built against; the redistributables
# are downloaded, so no CUDA install and no driver is needed to build.
cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.redist_json(
    name = "cuda_redist",
    version = "12.8.0",
)
cuda.toolkit(name = "cuda")
use_repo(cuda, "cuda")
