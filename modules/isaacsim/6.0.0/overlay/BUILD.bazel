# --------------------------------------------------------------------------
# Running Isaac Sim.
# --------------------------------------------------------------------------

# The stock isaacsim.exp.base.kit app, from both extension folders: the 94
# isaacsim.* extensions built from source here, and the pinned prebuilts. The
# two sets do not overlap -- the lock holds only what cannot be built from
# source (27 isaacsim.* extensions) plus the omni.* closure underneath.
isaacsim_kit_binary(
    name = "isaacsim",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)

# Resolves the app's extension closure against the live registries, which is how
# //bazel:exts_lock.json is regenerated. Manual: it is the one target that
# deliberately reaches the network at run time.
isaacsim_kit_binary(
    name = "precache",
    kit_args = [
        "--no-window",
        "--ext-precache-mode",
    ],
    merge_configs = [
        "//bazel:deps.kit",
        "//bazel:registry.kit",
    ],
    prebuilts = False,
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)

# --------------------------------------------------------------------------
# Tests.
# --------------------------------------------------------------------------

# Kit itself, on the kernel alone, reading every extension built from source:
# they have to be discoverable and their manifests parseable. This is the part
# of "does Isaac Sim start" that needs neither a GPU nor the 8 GB of prebuilts,
# so it is what CI can answer.
isaacsim_kit_test(
    name = "extensions_test",
    size = "medium",
    app = "//bazel:kernel_only.kit",
    expect_output = "isaacsim.core.version",
    kit_args = [
        "--no-window",
        "--list-exts",
    ],
    merge_configs = [],
    prebuilts = False,
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)

# The real thing: the stock app, headless, asserting from inside Kit that the
# isaacsim.* extensions came up. Needs an RTX GPU and the full prebuilt closure,
# so it is `manual` -- shared CI cannot run it.
isaacsim_kit_test(
    name = "launch_test",
    size = "enormous",
    exec_script = "//bazel:launch_smoke.py",
    expect_output = "ISAACSIM_LAUNCH_OK",
    kit_args = ["--no-window"],
    reject_output = "[Error]",
    tags = [
        "manual",
        "requires-gpu",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)
