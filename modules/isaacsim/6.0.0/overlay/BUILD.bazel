CORE_NODES = "source/extensions/isaacsim.core.nodes"

# The one CUDA translation unit in the tree: the camera kernels this extension's
# nodes launch.
#
# Building this needs --features=external_include_paths, so that the CUDA
# headers reach nvcc as system includes. Without it they arrive as -I, and a
# host glibc new enough to declare the C23 rsqrt/cospi family conflicts with
# CUDA's own declarations of them. The flag cannot be set here: rules_cuda takes
# features from the configuration, not from the package or the target, so it is
# the consuming build that has to pass it -- see ../presubmit.yml, which does.
cuda_library(
    name = "core_nodes_cuda",
    srcs = glob(
        [CORE_NODES + "/cuda/**/*.cu"],
    ),
    deps = [":core_includes"],
)

isaacsim_ogn_cpp_headers(
    name = "ogn_core_nodes",
    config = OGN_CONFIG,
    extension_name = "isaacsim.core.nodes",
    module = "isaacsim/core/nodes",
    node_srcs = glob(
        [CORE_NODES + "/nodes/**"],
    ),
    ogn_files = glob(
        [CORE_NODES + "/nodes/*.ogn"],
    ),
    python = KIT_PYTHON,
    python_runtime = KIT_PYTHON_RUNTIME,
    toolchain = OGN_TOOLCHAIN,
)

isaacsim_cc_plugin(
    name = "isaacsim.core.nodes.plugin",
    srcs = glob(
        [
            CORE_NODES + "/plugins/**/*.cpp",
            CORE_NODES + "/nodes/**/*.cpp",
        ],
    ) + ["@isaacsim_kit_kernel//:kit/dev/ogn/__LinuxStaticLibWorkaround.cpp"],
    # premake turns these off for this extension rather than fixing the sources.
    copts = [
        "-Wno-error=narrowing",
        "-Wno-error=unused-but-set-variable",
        "-Wno-error=unused-variable",
    ],
    extension_name = "isaacsim.core.nodes",
    deps = [
        ":core_includes",
        ":core_nodes_cuda",
        ":iface_core_experimental_prims",
        ":iface_core_nodes",
        ":iface_core_simulation_manager",
        ":iface_robot_schema",
        ":ogn_core_nodes",
        ":usd_headers",
