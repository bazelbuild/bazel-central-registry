            "source/deprecated/isaacsim.core.utils/bindings/**/*.cpp",
            "source/deprecated/isaacsim.core.utils/include/**/*.h",
            "source/deprecated/isaacsim.core.utils/plugins/**/*.cpp",
        ],
    ),
    includes = ["source/deprecated/isaacsim.core.utils/include"],
    module_name = "_isaac_utils",
    deps = [
        ":core_includes",
        ":iface_core_simulation_manager",
        ":iface_kit_loop_isaac",
        ":usd_headers",
        "@isaacsim_kit_exts_omni_usd_core//:omni.usd",
    ] + USD_LIBS,
)

isaacsim_interface_headers(
