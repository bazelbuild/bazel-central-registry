"""Isaac Sim as a Bazel module.

  bazel run @isaacsim//:isaacsim                 # the stock app, GUI
  bazel run @isaacsim//:isaacsim -- --no-window  # headless
  bazel build @isaacsim//:extensions             # just the Apache-2.0 half

`//:extensions` is every isaacsim.* extension that can be built from this source
tree, laid out the way premake would, in one directory that Kit accepts as an
--ext-folder. Building it downloads nothing.

`//:isaacsim` additionally needs the closed Kit runtime underneath Isaac Sim --
the kernel plus the omni.* extension closure, ~8 GB, pinned in
//bazel:exts_lock.json -- and an RTX GPU to render on.
"""

load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")
load(
    "//bazel:cc.bzl",
    "isaacsim_cc_plugin",
    "isaacsim_cc_python_module",
    "isaacsim_interface_headers",
    "isaacsim_ogn_cpp_headers",
    "isaacsim_version_header",
)
load(
    "//bazel:defs.bzl",
    "KIT_PYTHON",
    "KIT_PYTHON_RUNTIME",
    "OGN_CONFIG",
    "OGN_TOOLCHAIN",
    "isaacsim_kit_binary",
    "isaacsim_kit_test",
    "isaacsim_source_extensions",
)

package(default_package_metadata = [":package_metadata"])

exports_files(
    ["LICENSE"],
    visibility = ["//visibility:private"],
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:Apache-2.0",
    text = "LICENSE",
    visibility = ["//visibility:public"],
)

# Isaac Sim's own app configurations, used as they ship rather than reimplemented.
exports_files(glob(
    ["source/apps/*.kit"],
))

filegroup(
    name = "app_configs",
    srcs = glob(
        ["source/apps/*.kit"],
    ),
)

# One target per source-built extension, named after the extension itself
# (@isaacsim//:isaacsim.core.version), plus :extensions holding all of them.
isaacsim_source_extensions()

# --------------------------------------------------------------------------
# The C++ half: carbonite plugins, built against the headers the Kit kernel
# package ships. See //bazel:cc.bzl.
# --------------------------------------------------------------------------

# Version stamps the plugins report. Isaac Sim's premake derives these from git;
# a source release has no git, so the VERSION file decides.
isaacsim_version_header(
    name = "version_header",
    version = "6.0.0",
)

# Header-only, and the base every native extension includes. Its conversion
# helpers are written against PhysX's math types, so the SDK headers come with
# it -- from source, not from the prebuilt NVIDIA also publishes.
cc_library(
    name = "core_includes",
    hdrs = glob(
        ["source/extensions/isaacsim.core.includes/include/**"],
    ),
    includes = ["source/extensions/isaacsim.core.includes/include"],
    deps = [
        "@cuda",
        "@cuda//:cuda_runtime_static",
        "@cuda//:nvcc_headers",
        "@isaacsim_omni_physics//:headers",
        # Headers only: Kit's own PhysX is already in the process.
        "@physx//:headers",
    ],
)

isaacsim_cc_plugin(
    name = "isaacsim.core.api.plugin",
    srcs = glob(["source/deprecated/isaacsim.core.api/plugins/**/*.cpp"]),
    extension_name = "isaacsim.core.api",
    deps = [
        ":core_includes",
        ":version_header",
    ],
)

# The USD libraries isaacsim.core.utils' premake5.lua names, and the ones they
# pull in. Linked against by name so the module records a dependency on what it
# actually calls.
USD_LIBS = [
    "@isaacsim_kit_exts_omni_usd_libs//:" + lib
    for lib in [
        "usd_arch",
        "usd_gf",
        "usd_pcp",
        "usd_python",
        "usd_sdf",
        "usd_tf",
        "usd_ts",
        "usd_usd",
        "usd_usdGeom",
        "usd_usdPhysics",
        "usd_usdUtils",
        "usd_vt",
    ]
]

# The USD headers the native extensions compile against: the same OpenUSD 25.11
# NVIDIA builds, from the registry. Only the headers -- what gets loaded at run
# time is the prebuilt build, and a second USD in the process would be fatal.
cc_library(
    name = "usd_headers",
    deps = [
        "@openusd//:headers",
        "@openusd//:pxr_headers",
    ],
)

# Interface headers other extensions compile against.
isaacsim_interface_headers(
    name = "iface_core_simulation_manager",
    extension_name = "isaacsim.core.simulation_manager",
)

isaacsim_cc_python_module(
    name = "isaacsim.core.utils.bindings",
    srcs = glob(
