load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE.md"])

# Single library, mirroring the CMake "meshoptimizer" target: every source in
# src/ compiled into one archive, with meshoptimizer.h at the include root so
# `#include "meshoptimizer.h"` works as it does with CMake/pkg-config.
cc_library(
    name = "meshoptimizer",
    srcs = glob(["src/*.cpp"]),
    hdrs = ["src/meshoptimizer.h"],
    strip_include_prefix = "src",
)

# `gltfpacker` without texture compression.
# https://github.com/zeux/meshoptimizer/blob/master/gltf/README.md#building
cc_binary(
    name = "gltfpack",
    srcs = [
        "extern/cgltf.h",
        "extern/fast_obj.h",
        "gltf/animation.cpp",
        "gltf/encodebasis.cpp",
        "gltf/encodewebp.cpp",
        "gltf/fileio.cpp",
        "gltf/gltfpack.cpp",
        "gltf/gltfpack.h",
        "gltf/image.cpp",
        "gltf/json.cpp",
        "gltf/material.cpp",
        "gltf/mesh.cpp",
        "gltf/node.cpp",
        "gltf/parsegltf.cpp",
        "gltf/parselib.cpp",
        "gltf/parseobj.cpp",
        "gltf/stream.cpp",
        "gltf/write.cpp",
    ],
    deps = [":meshoptimizer"],
)

alias(
    name = "gltfpacker",
    actual = ":gltfpack",
)
