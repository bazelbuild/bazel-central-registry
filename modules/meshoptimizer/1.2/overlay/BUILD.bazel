load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE.md"])

# Single library, mirroring the CMake "meshoptimizer" target: every source in
# src/ compiled into one archive, with meshoptimizer.h at the include root so
# `#include "meshoptimizer.h"` works as it does with CMake/pkg-config.
cc_library(
    name = "meshoptimizer",
    srcs = glob(["src/*.cpp"]),
    hdrs = ["src/meshoptimizer.h"],
    strip_include_prefix = "src",
)
