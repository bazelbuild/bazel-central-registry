load(":boost_test_suite.bzl", "boost_root_headers", "boost_test_suite")

boost_root_headers()

# The runnable tests upstream declares in test/Jamfile.v2. The remaining tests
# there are compile-fail checks, and the example targets are link-only.
_RUNNABLE = [
    "CustomReactionTest.cpp",
    "DeferralBug.cpp",
    "DeferralTest.cpp",
    "FifoSchedulerTest.cpp",
    "HistoryTest.cpp",
    "InStateReactionTest.cpp",
    "InvalidResultCopyTest.cpp",
    "StateCastTest.cpp",
    "StateIterationTest.cpp",
    "TerminationTest.cpp",
    "TransitionTest.cpp",
    "TriggeringEventTest.cpp",
    "TypeInfoTest.cpp",
    "UnconsumedResultTest.cpp",
]

[
    boost_test_suite(
        name = src.removesuffix(".cpp") + "_tests",
        srcs = [src],
    )
    for src in _RUNNABLE
]

# Upstream compiles TuTest into its own library to check that a state machine
# can be spread over several translation units.
boost_test_suite(
    name = "tu_tests",
    srcs = [
        "TuTestMain.cpp",
        "TuTest.cpp",
    ],
    variants = [
        "Normal",
        "Native",
    ],
)
