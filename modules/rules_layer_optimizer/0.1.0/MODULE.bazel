module(
    name = "rules_layer_optimizer",
    version = "0.1.0",
)

bazel_dep(name = "aspect_bazel_lib", version = "2.22.0")

# Minimum supported wheel-provider/virtualenv layout; see docs/compatibility.md.
bazel_dep(name = "aspect_rules_py", version = "2.0.0-alpha.4")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "gawk", version = "5.3.2.bcr.7")
bazel_dep(name = "rules_distroless", version = "0.9.4")

# aspect_rules_py alpha.4 requires the 1.9 exec_runtime toolchain field.
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "toml.bzl", version = "0.3.0")

bazel_lib_toolchains = use_extension("@aspect_bazel_lib//lib:extensions.bzl", "toolchains")
bazel_lib_toolchains.tar()
use_repo(bazel_lib_toolchains, "bsd_tar_toolchains")

inference = use_extension("//inference:extensions.bzl", "oci_image_inference")
use_repo(inference, "oci_image_inference_config")
