module(
    name = "latticebuild_js",
    version = "0.1.1",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "package_metadata", version = "0.0.13")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "rules_bound", version = "0.2.1")
bazel_dep(name = "yq.bzl", version = "0.4.0")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "26.8.2")

bound = use_extension("@rules_bound//bound:extensions.bzl", "bound")
bound.toolchain(version = "0.2.1")

yq = use_extension("@yq.bzl//yq:extensions.bzl", "yq")
use_repo(yq, "yq_darwin_amd64", "yq_darwin_arm64", "yq_linux_amd64", "yq_linux_arm64", "yq_linux_ppc64le", "yq_linux_riscv64", "yq_linux_s390x", "yq_toolchains", "yq_windows_amd64", "yq_windows_arm64")

register_toolchains("@yq_toolchains//:all")

bazel_dep(name = "rules_go", version = "0.63.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.51.3")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.1")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_latticebuild_graceproc", "org_golang_x_sys")

node_modules = use_repo_rule("//js:repositories.bzl", "node_modules")

node_modules(
    name = "pnpm",
    package_json = "//:package.json",
)

# Documentation tools are root-only development dependencies.
bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)
bazel_dep(name = "protobuf", version = "36.2", dev_dependency = True)

# Browser examples are root-only development dependencies.
bazel_dep(name = "latticebuild_playwright", version = "0.1.1", dev_dependency = True)

playwright = use_extension("@latticebuild_playwright//playwright:extensions.bzl", "playwright", dev_dependency = True)
playwright.browser(
    name = "chromium",
    manifest = "@pnpm//node_modules/playwright-core:browsers.json",
    sha256 = {
        "darwin_arm64": "d64771a096fffd48b49a65e481dda50ae43a7de55fb93acfa6aece26ec3b10db",
        "darwin_x86_64": "580b3ea6231df5cb9760e27a889dfde21f391adbd58429d72be4684f789e8682",
        "linux_arm64": "bf94336ee2e3edb1279da28a74a744958ba10741e5994351610bc19028482b0b",
        "linux_x86_64": "a24546e0e6c763bf864861ce50498f38783663e24cd2af2a16798c25dc3a9489",
        "windows_x86_64": "48e66b6d93271398c68564ac8ca081b862cb7b78851ec3eae376a9a8d1941a15",
    },
)
use_repo(playwright, browser_payload = "playwright")

git_override(
    module_name = "latticebuild_playwright",
    commit = "adaec25cde41a52ed1043e735519fbab4eaad574",
    remote = "https://github.com/latticebuild/rules_playwright.git",
)
