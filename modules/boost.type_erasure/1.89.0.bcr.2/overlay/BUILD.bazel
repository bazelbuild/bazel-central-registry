        "include/boost/type_erasure/detail/**/*.hpp",
    ]),
    visibility = ["//visibility:public"],
    deps = [
        "@boost.assert",
        "@boost.config",
        "@boost.core",
        "@boost.detail",
        "@boost.fusion",
        "@boost.iterator",
        "@boost.mp11",
        "@boost.mpl",
        "@boost.preprocessor",
        "@boost.smart_ptr",
        "@boost.thread",
        "@boost.throw_exception",
        "@boost.type_traits",
        "@boost.typeof",
        "@boost.utility",
        "@boost.vmd",
    ],
