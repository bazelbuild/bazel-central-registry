load(":autoconf.bzl", "autoconf_targets")

# The targets of configure.ac and the Makefile.am files, declared by the generated
# autoconf.bzl beside this file; this file is hand-written and kept as it is.  A target
# added below is the module's own; one named like a generated target replaces it at the
# next conversion.
autoconf_targets()

# Smoke test: tcpdump --help, which verifies the binary links and starts; the
# output is a build artifact so `bazel build //...` runs it on every platform.
genrule(
    name = "smoke_test",
    outs = ["smoke_test.txt"],
    cmd = "$(execpath :tcpdump) --help > $@ 2>&1",
    cmd_bat = "$(execpath :tcpdump) --help > $@ 2>&1",
    tools = [":tcpdump"],
)
