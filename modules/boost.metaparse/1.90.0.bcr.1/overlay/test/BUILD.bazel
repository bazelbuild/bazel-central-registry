load(":boost_test_suite.bzl", "boost_compile_test_suite", "boost_test_suite")

# Upstream runs these with Boost.Test, everything else is a `compile` target.
_RUNNABLE = [
    "define_error.cpp",
    "empty_string.cpp",
    "string.cpp",
    "string_value.cpp",
]

# Upstream `compile-fail` target: the string literal exceeds
# BOOST_METAPARSE_LIMIT_STRING_SIZE on purpose.
_COMPILE_FAIL = ["too_long_string.cpp"]

boost_test_suite(
    name = "upstream_tests",
    srcs = _RUNNABLE,
)

boost_compile_test_suite(
    name = "upstream_compile_tests",
    srcs = glob(["*.cpp"], exclude = _RUNNABLE + _COMPILE_FAIL),
)
