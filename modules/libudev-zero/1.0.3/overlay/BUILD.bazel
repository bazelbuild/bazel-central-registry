load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(default_visibility = ["//visibility:public"])

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:ISC"],
    license_text = "LICENSE",
)

exports_files(["LICENSE"])

# The upstream header is named udev.h but is installed as libudev.h.
copy_file(
    name = "generate_header",
    src = "udev.h",
    out = "libudev.h",
)

cc_library(
    name = "libudev-zero",
    srcs = [
        "udev.c",
        "udev.h",
        "udev_device.c",
        "udev_enumerate.c",
        "udev_list.c",
        "udev_list.h",
        "udev_monitor.c",
    ],
    hdrs = [":generate_header"],
    includes = ["."],
    linkopts = ["-pthread"],
    local_defines = ["_XOPEN_SOURCE=700"],
    target_compatible_with = ["@platforms//os:linux"],
)

alias(
    name = "libudev",
    actual = ":libudev-zero",
)
