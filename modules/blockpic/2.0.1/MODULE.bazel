module(
    name = "blockpic",
    # 0.0.0 in the tree: publish-to-bcr writes the release tag's version
    # into each registry entry.
    version = "2.0.1",
    bazel_compatibility = [">=8.0.0"],
)

bazel_dep(name = "rules_go", version = "0.61.1")
bazel_dep(name = "gazelle", version = "0.51.3")
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

# The book under //ai only; nothing a user of blockpic loads needs it.
bazel_dep(name = "bazel_ebook", version = "3.0.2", dev_dependency = True)
bazel_dep(name = "bazel_lib", version = "3.3.1")
bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "aspect_rules_js", version = "3.2.2")
bazel_dep(name = "rules_nodejs", version = "6.7.4")

# Synthesises the test design that //tests/openxc7 draws, from
# filmil's registry (.bazelrc).
bazel_dep(name = "rules_openxc7", version = "0.2.0", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)

# Builds the sample documents under //samples with a hermetic TeX tree,
# both from filmil's registry (.bazelrc).
bazel_dep(name = "rules_latex_host", version = "0.3.1", dev_dependency = True)
bazel_dep(name = "texlive_bundle", version = "1.1.1", dev_dependency = True)

register_toolchains("@texlive_bundle//:all", dev_dependency = True)

# Not a dev dependency: blockpic_diagram runs netlistsvg (//:netlistsvg) for
# every module that uses it. The repository name is blockpic's own, since
# npm_translate_lock names must be unique across the module graph; inside
# blockpic it is still @npm.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "blockpic_npm",
    pnpm_lock = "//:pnpm-lock.yaml",
    verify_node_modules_ignored = "//:.bazelignore",
)
use_repo(npm, npm = "blockpic_npm")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_bitfield_script")
