load("@rules_cc//cc:cc_test.bzl", "cc_test")
load(":boost_test_suite.bzl", "COPTS", "DEPS", "boost_test_suite")

# compile_tests_main.cpp calls into the other compile_*.cpp translation units,
# so upstream compiles them together.
_COMPILE_TESTS = glob(["compile_*.cpp"])

boost_test_suite(
    name = "upstream_tests",
    srcs = glob(["*.cpp"], exclude = _COMPILE_TESTS),
)

cc_test(
    name = "compile_tests",
    srcs = _COMPILE_TESTS + glob(["*.hpp"]),
    copts = COPTS,
    deps = DEPS,
)
