"""rules_go_mutesting: Bazel aspect for Go mutation testing with go-mutesting."""

module(
    name = "rules_go_mutesting",
    version = "0.1.0",
)

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.53.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_shell", version = "0.8.0")

# go-mutesting v2.8.2 requires Go >= 1.26.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.5")

# The mutation engine and the runner's deps enter the graph here, so consumers
# of this module get them transitively without declaring anything themselves.
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_jonbaldie_go_mutesting_v2",
    "in_gopkg_yaml_v3",
)
