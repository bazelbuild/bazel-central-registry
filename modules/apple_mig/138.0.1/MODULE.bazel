module(
    name = "apple_mig",
    version = "138.0.1",
    bazel_compatibility = [">=8.4.2"],
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_shell", version = "0.8.0")

# Root-only toolchains used to validate that migcom cross-compiles for every
# supported host architecture. Consumers do not inherit this dependency.
bazel_dep(name = "llvm", version = "0.8.21", dev_dependency = True)

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)
