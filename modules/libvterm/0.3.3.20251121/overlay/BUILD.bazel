load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_package_metadata = [":package_metadata"],
    default_visibility = ["//visibility:public"],
)

exports_files(["LICENSE"])

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:MIT",
    text = "LICENSE",
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
)

# neovim/libvterm at 934bc2fbf21800ac3458a499df8820ca5fb45fd3 (2025-11-21): libvterm
# 0.3.3 plus Neovim's changes (e.g. VTermScreenCallbacks::sb_pushline4). Unlike the
# v0.3.3 tag, this revision contains the generated src/encoding/*.inc files.
cc_library(
    name = "vterm",
    srcs = [
        "src/encoding.c",
        "src/encoding/DECdrawing.inc",
        "src/encoding/uk.inc",
        "src/fullwidth.inc",
        "src/keyboard.c",
        "src/mouse.c",
        "src/parser.c",
        "src/pen.c",
        "src/rect.h",
        "src/screen.c",
        "src/state.c",
        "src/unicode.c",
        "src/utf8.h",
        "src/vterm.c",
        "src/vterm_internal.h",
    ],
    hdrs = [
        "include/vterm.h",
        "include/vterm_keycodes.h",
    ],
    includes = ["include"],
)

alias(
    name = "libvterm",
    actual = ":vterm",
)
