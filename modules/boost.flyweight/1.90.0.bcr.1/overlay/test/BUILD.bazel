load(":boost_test_suite.bzl", "boost_test_suite")

boost_test_suite(
    name = "upstream_tests",
    # The pairs upstream declares in test/Jamfile.v2.
    tests = {
        "assoc_cont_factory": [
            "test_assoc_cont_factory.cpp",
            "test_assoc_cont_fact_main.cpp",
        ],
        "basic": [
            "test_basic.cpp",
            "test_basic_main.cpp",
        ],
        "concurrent_factory": [
            "test_concurrent_factory.cpp",
            "test_concurrent_factory_main.cpp",
        ],
        "custom_factory": [
            "test_custom_factory.cpp",
            "test_custom_factory_main.cpp",
        ],
        "init": [
            "test_init.cpp",
            "test_init_main.cpp",
        ],
        # Upstream links the dll source as a shared library to check that the
        # holder is shared across modules; linking it in keeps the same check.
        "intermod_holder": [
            "test_intermod_holder.cpp",
            "test_intermod_holder_main.cpp",
            "intermod_holder_dll.cpp",
        ],
        "multictor": [
            "test_multictor.cpp",
            "test_multictor_main.cpp",
        ],
        "no_locking": [
            "test_no_locking.cpp",
            "test_no_locking_main.cpp",
        ],
        "no_tracking": [
            "test_no_tracking.cpp",
            "test_no_tracking_main.cpp",
        ],
        "serialization": [
            "test_serialization.cpp",
            "test_serialization_main.cpp",
        ],
        "set_factory": [
            "test_set_factory.cpp",
            "test_set_factory_main.cpp",
        ],
    },
    # Boost.Unordered's concurrent_node_set uses the C++17 parallel algorithms,
    # which libstdc++ implements on top of oneTBB.
    extra_deps = {"concurrent_factory": ["@onetbb//:tbb"]},
    local_defines = {
        "intermod_holder": ["BOOST_FLYWEIGHT_TEST_INTERMOD_HOLDER_DLL_SOURCE=1"],
    },
)
