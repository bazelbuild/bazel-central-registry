"""DO NOT MODIFY: bc bc_version's targets, generated by rules_cc_autoconf from
configure.ac and the Makefile.am files with the choices in decisions.bzl. To
regenerate, from a clone of rules_cc_autoconf:

    bazel run //tools/convert -- convert --bcr-entry ../bazel-central-registry/modules/bc/1.08.2

@generated. BUILD.bazel beside this file is hand-written: it loads this file
and calls configure(), and a rule it declares with a generated target's name
replaces that target here.

https://periareon.github.io/rules_cc_autoconf/convert.html
"""

load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@bison//:bison.bzl", "bison")
load("@flex//:flex.bzl", "flex")
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc_autoconf//autoconf:autoconf.bzl", "autoconf")
load("@rules_cc_autoconf//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
load("@rules_cc_autoconf//autoconf:autoconf_package_info.bzl", "autoconf_package_info")
load("@rules_cc_autoconf//autoconf:checks.bzl", "checks", "macros", "utils")

visibility("private")

SYSTEM_EXTENSIONS = [
    "_ALL_SOURCE",
    "_COSMO_SOURCE",
    "_DARWIN_C_SOURCE",
    "_GNU_SOURCE",
    "_HPUX_ALT_XOPEN_SOCKET_API",
    "_NETBSD_SOURCE",
    "_OPENBSD_SOURCE",
    "_POSIX_PTHREAD_SEMANTICS",
    "_TANDEM_SOURCE",
    "__EXTENSIONS__",
    "__STDC_WANT_MATH_SPEC_FUNCS__",
]

BOOL_OPTIONS = {
    "dc_bang_shell": True,
    "readline": False,
}

NO_WARNINGS = select({
    "@rules_cc//cc/compiler:clang-cl": ["/w"],
    "@rules_cc//cc/compiler:msvc-cl": ["/w"],
    "//conditions:default": ["-w"],
})

COPTS = NO_WARNINGS + ["-funsigned-char"]

BC_SRCS = [
    "lib/getopt.c",
    "lib/getopt1.c",
    "lib/number.c",
    "lib/vfprintf.c",
]

# buildifier: disable=unnamed-macro
def configure():
    """The targets configure.ac and the Makefile.am files describe, in the package that calls this.

    Left out, since BUILD.bazel declares them: lib/bc_private_headers.
    """

    native.exports_files([
        "COPYING",
        "COPYING.LIB",
    ])

    license(
        name = "license_COPYING",
        kind = "@package_metadata//licenses/spdx:GPL-3.0-or-later",
        text = "COPYING",
        visibility = ["//:__subpackages__"],
    )

    license(
        name = "license_COPYING_LIB",
        kind = "@package_metadata//licenses/spdx:LGPL-3.0-or-later",
        text = "COPYING.LIB",
        visibility = ["//:__subpackages__"],
    )

    package_metadata(
        name = "package_metadata",
        attributes = [
            ":license_COPYING",
            ":license_COPYING_LIB",
        ],
        purl = purl.bazel(
            native.module_name(),
            native.module_version(),
        ),
        visibility = ["//:__subpackages__"],
    )

    autoconf_package_info(
        name = "package",
        package_name = "bc",
        aliases = {
            "PACKAGE": "PACKAGE_TARNAME",
            "VERSION": "PACKAGE_VERSION",
        },
        module_bazel = "//:MODULE.bazel",
        strip_bcr_version = True,
        visibility = ["//:__subpackages__"],
    )

    for name, default in BOOL_OPTIONS.items():
        bool_flag(
            name = name,
            build_setting_default = default,
            visibility = ["//visibility:public"],
        )

    for name in BOOL_OPTIONS:
        native.config_setting(
            name = name + "_enabled",
            flag_values = {":" + name: "True"},
            visibility = ["//:__subpackages__"],
        )

    autoconf(
        name = "autoconf_readline",
        cc_deps = select({
            ":readline_enabled": ["@readline"],
            "//conditions:default": [],
        }),
        checks = select({
            ":readline_enabled": [
                checks.AC_CHECK_LIB("readline", "readline"),
                checks.AC_CHECK_HEADER(
                    "readline/readline.h",
                    requires = ["ac_cv_lib_readline_readline"],
                ),
            ],
            "//conditions:default": [],
        }),
        visibility = ["//:__subpackages__"],
        deps = [
            "@rules_cc_autoconf//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
            "@rules_cc_autoconf//autoconf/macros/AC_CONFIG_AUX_DIR_DEFAULT",
            "@rules_cc_autoconf//autoconf/macros/AC_TYPE_SIZE_T",
            "@rules_cc_autoconf//autoconf/macros/AC_USE_SYSTEM_EXTENSIONS",
        ],
    )

    autoconf(
        name = "autoconf",
        checks = [
            checks.AC_DEFINE("DC_VERSION", "\"1.5.2\""),
            checks.AC_DEFINE(
                "BC_COPYRIGHT",
                "\"Copyright 1991-1994, 1997, 1998, 2000, 2004, 2006, 2008, 2012-2018, 2024 Free Software Foundation, Inc.\"",
            ),
            checks.AC_DEFINE(
                "DC_COPYRIGHT",
                "\"Copyright 1994, 1997, 1998, 2000, 2001, 2003-2006, 2008, 2010, 2012-2018, 2022, 2024 Free Software Foundation, Inc.\"",
            ),
        ] + macros.AC_CHECK_HEADERS(
            [
                "stdarg.h",
                "stddef.h",
                "errno.h",
                "getopt.h",
                "limits.h",
                "lib.h",
            ],
        ) + [
            checks.AC_CHECK_TYPE(
                "ptrdiff_t",
                compile_defines = SYSTEM_EXTENSIONS,
            ),
            checks.AC_DEFINE(
                "ptrdiff_t",
                "size_t",
                requires = ["!ac_cv_type_ptrdiff_t"],
            ),
            checks.AC_TRY_COMPILE(
                name = "ax_cv___attribute__",
                code = utils.AC_LANG_PROGRAM(
                    [
                        "#include <stdlib.h>",
                        "	  static void foo(void) __attribute__ ((unused));",
                        "	  static void",
                        "	  foo(void) {",
                        "	      exit(1);",
                        "	  }",
                    ],
                    [],
                ),
                compile_defines = SYSTEM_EXTENSIONS,
            ),
            checks.AC_DEFINE(
                "HAVE___ATTRIBUTE__",
                1,
                requires = ["ax_cv___attribute__"],
            ),
        ] + macros.AC_CHECK_FUNCS(
            [
                "vprintf",
                "isgraph",
                "setvbuf",
                "fstat",
                "getopt_long",
                "strtol",
            ],
        ) + [
            checks.AC_SUBST("BC_VERSION", "1.08.2"),
            checks.AC_SUBST("DC_VERSION", "1.5.2"),
        ] + select({
            ":dc_bang_shell_enabled": [
                checks.AC_DEFINE("ENABLE_DC_BANG_SHELL", 1),
            ],
            "//conditions:default": [],
        }) + select({
            ":readline_enabled": [
                checks.AC_CHECK_LIB("ncurses", "tparm"),
                checks.AC_DEFINE(
                    "READLINE",
                    1,
                    requires = ["ac_cv_header_readline_readline_h"],
                ),
            ],
            "//conditions:default": [],
        }),
        visibility = ["//:__subpackages__"],
        deps = [
            ":autoconf_readline",
            ":package",
            "@rules_cc_autoconf//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
            "@rules_cc_autoconf//autoconf/macros/AC_CONFIG_AUX_DIR_DEFAULT",
            "@rules_cc_autoconf//autoconf/macros/AC_TYPE_SIZE_T",
            "@rules_cc_autoconf//autoconf/macros/AC_USE_SYSTEM_EXTENSIONS",
        ],
    )

    autoconf_hdr(
        name = "config",
        out = "config.h",
        template = "config.h.in",
        visibility = ["//:__subpackages__"],
        deps = [":autoconf"],
    )

    cc_library(
        name = "config_headers",
        hdrs = [":config"] + native.glob(
            ["*.h"],
            allow_empty = True,
        ),
        copts = COPTS,
        include_prefix = ".",
        strip_include_prefix = "/",
        visibility = ["//:__subpackages__"],
    )

    autoconf_hdr(
        name = "doc_texi_ver_incl",
        out = "doc/texi-ver.incl",
        mode = "subst",
        template = "doc/texi-ver.incl.in",
        visibility = ["//:__subpackages__"],
        deps = [":autoconf"],
    )

    cc_library(
        name = "lib/bc",
        srcs = BC_SRCS,
        copts = COPTS,
        implementation_deps = [":lib/bc_private_headers"],
        local_defines = ["HAVE_CONFIG_H"],
        visibility = ["//:__subpackages__"],
    )

    cc_library(
        name = "bc/headers",
        hdrs = native.glob(
            ["bc/**/*.h"],
            allow_empty = True,
        ),
        copts = COPTS,
        include_prefix = ".",
        includes = ["bc"],
        strip_include_prefix = "/",
        visibility = ["//:__subpackages__"],
        deps = [":config_headers"],
    )

    bison(
        name = "bc/bison/bc",
        srcs = ["bc/bc.y"],
        outs = [
            "bc/bison/bc.c",
            "bc/bison/bc.h",
        ],
        args = [
            "-o",
            "$(execpath bc/bison/bc.c)",
            "--defines=$(execpath bc/bison/bc.h)",
            "-Wnone",
            "$(execpath bc/bc.y)",
        ],
        visibility = ["//:__subpackages__"],
    )

    flex(
        name = "bc/flex/scan",
        srcs = ["bc/scan.l"],
        outs = [
            "bc/flex/scan.c",
            "bc/flex/scan.h",
        ],
        args = [
            "-o",
            "$(execpath bc/flex/scan.c)",
            "--header-file=$(execpath bc/flex/scan.h)",
            "--nowarn",
            "$(execpath bc/scan.l)",
        ],
        visibility = ["//:__subpackages__"],
    )

    cc_library(
        name = "h_includes",
        hdrs = native.glob(
            ["h/**/*.h"],
            allow_empty = True,
        ),
        copts = COPTS,
        include_prefix = ".",
        includes = ["h"],
        strip_include_prefix = "/",
        visibility = ["//:__subpackages__"],
    )

    cc_binary(
        name = "bc/bc",
        srcs = [
            "bc/bison/bc.c",
            "bc/bison/bc.h",
            "bc/execute.c",
            "bc/flex/scan.c",
            "bc/flex/scan.h",
            "bc/global.c",
            "bc/load.c",
            "bc/main.c",
            "bc/storage.c",
            "bc/util.c",
            "bc/warranty.c",
        ],
        copts = COPTS,
        includes = [
            "bc/bison",
            "bc/flex",
        ],
        local_defines = ["HAVE_CONFIG_H"],
        visibility = ["//visibility:public"],
        deps = [
            ":bc/headers",
            ":h_includes",
            ":lib/bc",
            ":lib/bc_private_headers",
        ] + select({
            ":readline_enabled": ["@readline"],
            "//conditions:default": [],
        }),
    )

    native.alias(
        name = "bc",
        actual = ":bc/bc",
        visibility = ["//visibility:public"],
    )

    cc_library(
        name = "dc/headers",
        hdrs = native.glob(
            ["dc/**/*.h"],
            allow_empty = True,
        ),
        copts = COPTS,
        include_prefix = ".",
        includes = ["dc"],
        strip_include_prefix = "/",
        visibility = ["//:__subpackages__"],
        deps = [":config_headers"],
    )

    cc_binary(
        name = "dc/dc",
        srcs = [
            "dc/array.c",
            "dc/dc.c",
            "dc/eval.c",
            "dc/input.c",
            "dc/misc.c",
            "dc/numeric.c",
            "dc/stack.c",
            "dc/string.c",
        ],
        copts = COPTS,
        local_defines = ["HAVE_CONFIG_H"],
        visibility = ["//visibility:public"],
        deps = [
            ":dc/headers",
            ":lib/bc",
            ":lib/bc_private_headers",
        ] + select({
            ":readline_enabled": ["@readline"],
            "//conditions:default": [],
        }),
    )

    native.alias(
        name = "dc",
        actual = ":dc/dc",
        visibility = ["//visibility:public"],
    )
