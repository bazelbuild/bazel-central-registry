load("@rules_cc//cc:cc_library.bzl", "cc_library")
load(":autoconf.bzl", "configure")

# The targets of configure.ac and the Makefile.am files, declared by the generated
# autoconf.bzl beside this file; this file is hand-written and kept as it is.  A target
# added below is the module's own; one named like a generated target replaces it at the
# next conversion.
configure()

# The math library's self-check, run by //tests.
exports_files(
    ["Test/checklib.b"],
    visibility = ["//tests:__pkg__"],
)

# lib/Makefile.am compiles with `-I$(srcdir)/../h`, where number.h and getopt.h
# live; lib/ itself has no headers.  The generated target globs lib/**/*.h
# (empty, which Bazel rejects) and misses h/, so it is replaced here until the
# converter reads a library's AM_CPPFLAGS as it does a program's.
cc_library(
    name = "lib/bc_private_headers",
    visibility = ["//visibility:private"],
    deps = [
        ":config_headers",
        ":h_includes",
    ],
)
