load("@rules_cc//cc:cc_test.bzl", "cc_test")

# The interpreters as a consumer runs them, plus upstream's Test/checklib.b
# self-check of the -l math library.  A C++ program rather than a shell script,
# so the test needs no shell toolchain and nothing depends on an execute bit
# surviving the overlay download.
cc_test(
    name = "bc_smoke_test",
    size = "small",
    srcs = ["bc_smoke_test.cc"],
    copts = ["-std=c++17"],
    data = [
        "//:Test/checklib.b",
        "//:bc",
        "//:dc",
    ],
    env = {
        "BC_RLOCATIONPATH": "$(rlocationpath //:bc)",
        "CHECKLIB_RLOCATIONPATH": "$(rlocationpath //:Test/checklib.b)",
        "DC_RLOCATIONPATH": "$(rlocationpath //:dc)",
    },
    deps = ["@rules_cc//cc/runfiles"],
)
