"""BUILD file for reflect-cpp."""

load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "reflect-cpp",
    srcs = glob([
        "src/rfl/Generic.cpp",
        "src/rfl/env/**",
        "src/rfl/generic/**",
        "src/rfl/internal/**",
        "src/rfl/json/**",
        "src/rfl/capnproto/**",
        "src/rfl/parsing/**",
        "src/rfl/yaml/**",
    ]),
    hdrs = glob(
        [
            "include/rfl.hpp",
            "include/rfl/*.hpp",
            "include/rfl/atomic/**",
            "include/rfl/env/**",
            "include/rfl/generic/**",
            "include/rfl/internal/**",
            "include/rfl/io/**",
            "include/rfl/json/**",
            "include/rfl/capnproto/**",
            "include/rfl/parsing/**",
            "include/rfl/thirdparty/**",
            "include/rfl/yaml/**",
        ],
        exclude = [
            "include/rfl/avro.hpp",
            "include/rfl/boost_serialization.hpp",
            "include/rfl/bson.hpp",
            "include/rfl/cbor.hpp",
            "include/rfl/cereal.hpp",
            "include/rfl/csv.hpp",
            "include/rfl/flexbuf.hpp",
            "include/rfl/msgpack.hpp",
            "include/rfl/parquet.hpp",
            "include/rfl/toml.hpp",
            "include/rfl/ubjson.hpp",
            "include/rfl/xml.hpp",
            "include/rfl/yas.hpp",
        ],
    ),
    copts = ["--std=c++20"],
    defines = [
        "REFLECT_CPP_C_ARRAYS_OR_INHERITANCE",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "@capnp-cpp//src/capnp",
        "@capnp-cpp//src/capnp:capnpc",
        "@yaml-cpp",
        "@yyjson",
    ],
)
