+#ifdef MLX_METAL_EMBEDDED_METALLIB
+extern "C" const unsigned char mlx_embedded_metallib[];
+extern "C" const size_t mlx_embedded_metallib_size;
+
+// Load mlx.metallib from bytes linked into the binary.
+std::pair<MTL::Library*, NS::Error*> load_embedded_library(
+    MTL::Device* device) {
+  auto data = dispatch_data_create(
+      mlx_embedded_metallib,
+      mlx_embedded_metallib_size,
+      nullptr,
+      DISPATCH_DATA_DESTRUCTOR_DEFAULT);
+  NS::Error* error = nullptr;
+  auto lib = device->newLibrary(data, &error);
+  dispatch_release(data);
+  return std::make_pair(lib, error);
+}
+#endif
