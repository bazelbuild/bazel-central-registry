package(default_package_metadata = [":package_metadata"])

exports_files(
    ["LICENSE"],
    visibility = ["//visibility:private"],
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:MIT",
    text = "LICENSE",
    visibility = ["//visibility:public"],
)

# Upstream tests, used by the BCR test module.
exports_files(
    glob(["tests/*.cpp"]),
    visibility = ["//visibility:public"],
)

MLX_VERSION = "0.32.2"

