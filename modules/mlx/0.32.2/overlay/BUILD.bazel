config_setting(
    name = "macos",
    constraint_values = ["@platforms//os:macos"],
)

config_setting(
    name = "macos_arm64",
    constraint_values = [
        "@platforms//cpu:arm64",
        "@platforms//os:macos",
    ],
)

# Minimum macOS version the Metal kernels are compiled for. The fence kernel
# (used for MLX_METAL_FAST_SYNCH) needs Metal 3.2 and is only built for >= 15.0.
string_flag(
    name = "metal_macos_version_min",
    build_setting_default = "14.0",
    values = [
        "14.0",
        "15.0",
        "26.0",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "metal_macos_14",
    flag_values = {":metal_macos_version_min": "14.0"},
)

filegroup(
    name = "metal_kernel_headers",
    srcs = glob(["mlx/backend/metal/kernels/**/*.h"]),
)

metal_library(
    name = "mlx_metallib",
    srcs = ["mlx/backend/metal/kernels/{}.metal".format(k) for k in _METAL_KERNELS] + select({
        ":metal_macos_14": [],
        "//conditions:default": ["mlx/backend/metal/kernels/fence.metal"],
    }),
    out = "mlx.metallib",
    hdrs = [":metal_kernel_headers"],
    macos_version_min = ":metal_macos_version_min",
    target_compatible_with = ["@platforms//os:macos"],
)

[
    metal_jit_source(
        name = "metal_jit_" + src.replace("/", "_"),
        src = "mlx/backend/metal/kernels/{}.h".format(src),
        out = "mlx/backend/metal/jit/{}.cpp".format(src.split("/")[-1]),
        hdrs = [":metal_kernel_headers"],
        macos_version_min = ":metal_macos_version_min",
        script = "mlx/backend/metal/make_compiled_preamble.sh",
        target_compatible_with = ["@platforms//os:macos"],
    )
    for src in _METAL_JIT_SOURCES
]

genrule(
    name = "mlx_metallib_embed",
    srcs = [":mlx_metallib"],
    outs = ["mlx_metallib_embed.c"],
    cmd = """
{
  echo '#include <stddef.h>'
  echo 'const unsigned char mlx_embedded_metallib[] = {'
  od -An -v -tx1 $< | sed -e 's/  */ /g' -e 's/^ //' -e '/^$$/d' -e 's/\\([0-9a-f][0-9a-f]\\)/0x\\1,/g'
  echo '};'
  echo 'const size_t mlx_embedded_metallib_size = sizeof(mlx_embedded_metallib);'
} > $@
""",
    target_compatible_with = ["@platforms//os:macos"],
)

# The preamble is only preprocessed, so on macOS use the Xcode clang directly
# (the Bazel cc wrapper needs Xcode env vars that genrules do not get).
_CPU_PREAMBLE_CMD = """
SRCDIR=$$(dirname $(location mlx/backend/cpu/compiled_preamble.h))/../../..
bash $(location mlx/backend/cpu/make_compiled_preamble.sh) $@ {cc} $$SRCDIR {clang} {arch} "{flags}"
grep -q 'struct Abs' $@ || {{ echo "Failed to preprocess the CPU compiled preamble" >&2; exit 1; }}
"""

genrule(
    name = "cpu_compiled_preamble",
    srcs = [
        "mlx/backend/cpu/compiled_preamble.h",
        "mlx/backend/cpu/make_compiled_preamble.sh",
    ] + glob(
        [
            "mlx/types/*.h",
            "mlx/backend/cpu/*.h",
            "mlx/backend/cpu/simd/*.h",
        ],
        exclude = ["mlx/backend/cpu/compiled_preamble.h"],
    ),
    outs = ["mlx/backend/cpu/compiled_preamble.cpp"],
    cmd = select({
        ":macos_arm64": _CPU_PREAMBLE_CMD.format(
            arch = "arm64",
            cc = "/usr/bin/clang",
            clang = "TRUE",
            flags = "",
        ),
        ":macos": _CPU_PREAMBLE_CMD.format(
            arch = "x86_64",
            cc = "/usr/bin/clang",
            clang = "TRUE",
            flags = "",
        ),
        "//conditions:default": _CPU_PREAMBLE_CMD.format(
            arch = "$(TARGET_CPU)",
            cc = "$(CC)",
            clang = "FALSE",
            flags = "-x c++",
        ),
    }),
    toolchains = ["@rules_cc//cc:current_cc_toolchain"],
)

cc_library(
    name = "version",
    srcs = ["mlx/version.cpp"],
    hdrs = [
        "mlx/api.h",
        "mlx/version.h",
    ],
    defines = ["MLX_STATIC"],
    local_defines = ['MLX_VERSION=\\"{}\\"'.format(MLX_VERSION)],
)

