load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
    license_text = "LICENSE.md",
)

exports_files(["LICENSE.md"])

# Markdown parser (SAX-like callbacks). Upstream installs md4c.h at the root
# of the include dir, so consumers use <md4c.h>. strip_include_prefix exposes
# only this header, not the whole src/ directory.
cc_library(
    name = "md4c",
    srcs = ["src/md4c.c"],
    hdrs = ["src/md4c.h"],
    strip_include_prefix = "src",
)

# Markdown -> HTML renderer, <md4c-html.h>. entity.h is private: it is only
# included (with quotes, from the same directory) by the sources here.
cc_library(
    name = "md4c-html",
    srcs = [
        "src/entity.c",
        "src/entity.h",
        "src/md4c-html.c",
    ],
    hdrs = ["src/md4c-html.h"],
    strip_include_prefix = "src",
    deps = [":md4c"],
)
