load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_shared_library.bzl", "cc_shared_library")

cc_library(
    name = "linux-pam",
    srcs = ["config.h"] + glob([
        "libpam/*.c",
        "libpam/*.h",
        "libpam/include/*.h",
        "libpam_internal/*.c",
        "libpam_internal/include/*.h",
    ]),
    hdrs = glob(["libpam/include/security/*.h"]),
    includes = [
        "libpam/include",
        "libpam_internal/include",
    ],
    linkopts = ["-ldl"],
    local_defines = [
        "LIBPAM_COMPILE",
        "_GNU_SOURCE",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = ["@audit-userspace"],
)

cc_shared_library(
    name = "libpam",
    additional_linker_inputs = ["libpam/libpam.map"],
    shared_lib_name = "libpam.so.0",
    target_compatible_with = ["@platforms//os:linux"],
    user_link_flags = [
        "-Wl,-soname,libpam.so.0",
        "-Wl,--version-script=$(location libpam/libpam.map)",
    ],
    visibility = ["//visibility:public"],
    deps = [":linux-pam"],
)
