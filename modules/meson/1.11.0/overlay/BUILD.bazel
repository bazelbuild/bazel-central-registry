load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")

MESONBUILD_PY_SRCS = glob(["mesonbuild/**/*.py"])

# The non-Python files the mesonbuild package loads at runtime. Shared by
# `:mesonbuild` and `:runtime` so the file set is only defined once.
filegroup(
    name = "mesonbuild_data",
    srcs = glob([
        "mesonbuild/**/*.cmake",
        "mesonbuild/**/*.ps1",
        "mesonbuild/**/*.txt",
    ]),
    visibility = ["//visibility:private"],
)

# The complete meson runtime tree, for consumers that invoke `meson.py` directly
# instead of going through the `:meson` binary.
filegroup(
    name = "runtime",
    srcs = MESONBUILD_PY_SRCS + [":mesonbuild_data"],
    visibility = ["//visibility:public"],
)

exports_files(
    [
        "COPYING",
        "meson.py",
    ],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "meson",
    srcs = ["meson.py"],
    python_version = "PY3",
    visibility = ["//visibility:public"],
    deps = [":mesonbuild"],
)

py_library(
    name = "mesonbuild",
    srcs = MESONBUILD_PY_SRCS,
    data = [":mesonbuild_data"],
    srcs_version = "PY3",
    visibility = ["//visibility:private"],
)

alias(
    name = "meson_lib",
    actual = ":mesonbuild",
    visibility = ["//visibility:private"],
)
