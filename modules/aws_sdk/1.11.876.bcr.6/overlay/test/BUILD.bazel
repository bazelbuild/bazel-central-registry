load("@platforms_contrib//cpu/x86_64:x86_64.bzl", "x86_64_level_constraints")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Compile every dispatch tier even when a presubmit host cannot execute it.
[
    platform(
        name = name,
        constraint_values = [
            "@platforms//os:linux",
            "@platforms//cpu:x86_64",
        ] + x86_64_level_constraints(level) + [
            "@platforms_contrib//cpu/x86_64/feature:{}_available".format(feature)
            for feature in features
        ],
    )
    for name, level, features in [
        ("x86_64_v1", "v1", []),
        (
            "x86_64_v2",
            "v2",
            ["pclmul"],
        ),
        (
            "x86_64_v3",
            "v3",
            ["pclmul"],
        ),
        ("x86_64_v3_no_pclmul", "v3", []),
        (
            "x86_64_v4",
            "v4",
            [
                "pclmul",
                "vpclmulqdq",
            ],
        ),
        (
            "x86_64_v4_no_vpclmul",
            "v4",
            ["pclmul"],
        ),
    ]
]

cc_test(
    name = "checksums_test",
    size = "small",
    srcs = ["checksums_test.c"],
    linkopts = [
        "-Wl,--wrap=aws_checksums_crc32c_sw",
        "-Wl,--wrap=aws_checksums_crc64nvme_sw",
    ],
    linkstatic = True,
    local_defines = select({
        "@platforms_contrib//cpu/x86_64:at_least_v2": ["TEST_X86_V2"],
        "//conditions:default": [],
    }) + select({
        "@platforms_contrib//cpu/x86_64:at_least_v3": ["TEST_X86_V3"],
        "//conditions:default": [],
    }) + select({
        "@platforms_contrib//cpu/x86_64:at_least_v4": ["TEST_X86_V4"],
        "//conditions:default": [],
    }) + select({
        "@platforms_contrib//cpu/x86_64/feature:pclmul": ["TEST_PCLMUL"],
        "//conditions:default": [],
    }) + select({
        "@platforms_contrib//cpu/x86_64/feature:vpclmulqdq": ["TEST_VPCLMUL"],
        "//conditions:default": [],
    }),
    deps = [
        "@aws_sdk//:aws-c-common",
        "@aws_sdk//:aws-checksums",
    ],
)

config_setting(
    name = "memory_management",
    flag_values = {"@aws_sdk//:memory_management": "true"},
)

# presubmit.yml builds the test with this value.
config_setting(
    name = "user_agent_customization",
    flag_values = {"@aws_sdk//:user_agent_customization": "bcr-presubmit/1.0"},
)

cc_test(
    name = "components_test",
    size = "small",
    srcs = ["components_test.cc"],
    # Keeps client construction from querying EC2 instance metadata.
    env = {"AWS_EC2_METADATA_DISABLED": "true"},
    local_defines = select({
        ":memory_management": ["EXPECT_MEMORY_MANAGEMENT"],
        "//conditions:default": [],
    }) + select({
        ":user_agent_customization": ['EXPECT_USER_AGENT_TOKEN=\\"bcr-presubmit/1.0\\"'],
        "//conditions:default": [],
    }),
    deps = [
        "@aws_sdk//:access_management",
        "@aws_sdk//:cognito_identity",
        "@aws_sdk//:core",
        "@aws_sdk//:iam",
        "@aws_sdk//:monitoring",
        "@aws_sdk//:polly",
        "@aws_sdk//:queues",
        "@aws_sdk//:s3",
        "@aws_sdk//:s3_crt",
        "@aws_sdk//:s3_encryption",
        "@aws_sdk//:s3_transfer",
        "@aws_sdk//:sqs",
        "@aws_sdk//:text_to_speech",
        "@aws_sdk//:transfer",
    ],
)
