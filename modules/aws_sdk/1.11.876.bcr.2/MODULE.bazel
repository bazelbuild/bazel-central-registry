# BCR requires an archive-backed source; it has no overlay-only source type.
# source.json therefore uses the official AWS SDK archive but strips it to
# crt/aws-crt-cpp, which is an empty Git submodule directory in that archive.
# The primary @aws_sdk repository contains only the BCR overlays. The extension
# below fetches the same SDK archive and materializes only the required sources.
module(
    name = "aws_sdk",
    version = "1.11.876.bcr.2",
    bazel_compatibility = [">=7.2.1"],
    compatibility_level = 1,
)

bazel_dep(name = "bazel_lib", version = "3.2.2")
bazel_dep(name = "boringssl", version = "0.20251110.0")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "curl", version = "8.11.0.bcr.5")
bazel_dep(name = "openssl", version = "3.3.1.bcr.1")
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "opentelemetry-cpp", version = "1.24.0.bcr.1")

# opentelemetry-proto's older rules_go dependency is incompatible with Bazel 9.
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "google_benchmark", version = "1.9.5")

# The repository rule uses tar.bzl's prebuilt bsdtar so include patterns work
# consistently on every supported host platform.
bazel_dep(name = "tar.bzl", version = "0.10.4")

tar_toolchains = use_extension("@tar.bzl//tar:extensions.bzl", "toolchains")
use_repo(
    tar_toolchains,
    "bsd_tar_toolchains_darwin_amd64",
    "bsd_tar_toolchains_darwin_arm64",
    "bsd_tar_toolchains_linux_amd64",
    "bsd_tar_toolchains_linux_arm64",
    "bsd_tar_toolchains_windows_amd64",
    "bsd_tar_toolchains_windows_arm64",
)

aws_sdk_deps = use_extension("//:extensions.bzl", "aws_sdk_deps")
use_repo(aws_sdk_deps, "aws_sdk_bundled")
