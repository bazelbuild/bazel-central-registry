load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "shine",
    srcs = [
        "src/lib/bitstream.c",
        "src/lib/huffman.c",
        "src/lib/l3bitstream.c",
        "src/lib/l3loop.c",
        "src/lib/l3mdct.c",
        "src/lib/l3subband.c",
        "src/lib/layer3.c",
        "src/lib/reservoir.c",
        "src/lib/tables.c",
    ] + glob(["src/lib/*.h"]),
    hdrs = ["src/lib/layer3.h"],
    include_prefix = "shine",
    linkopts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-lm"],
    }),
    strip_include_prefix = "src/lib",
)

cc_test(
    name = "rounds_test",
    srcs = ["tests/rounds_test.c"],
    deps = [":shine"],
)
