load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE"])

# tinyexr.cc is the single translation unit that defines TINYEXR_IMPLEMENTATION;
# consumers include tinyexr.h without it.
#
# Upstream's CMakeLists.txt defaults to TINYEXR_USE_MINIZ=ON and vendors miniz in
# deps/miniz; the @miniz module is used instead of that copy.
cc_library(
    name = "tinyexr",
    srcs = ["tinyexr.cc"],
    hdrs = [
        "exr_reader.hh",
        "streamreader.hh",
        "tinyexr.h",
    ],
    includes = ["."],
    deps = ["@miniz"],
)
