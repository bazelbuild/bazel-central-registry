load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(
    default_package_metadata = [":package_metadata"],
)

exports_files([
    "LICENSE",
])

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:MIT",
    text = "LICENSE",
    visibility = ["//visibility:public"],
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

# tinyexr.cc is the single translation unit that defines TINYEXR_IMPLEMENTATION;
# consumers include tinyexr.h without it.
#
# Upstream's CMakeLists.txt defaults to TINYEXR_USE_MINIZ=ON and vendors miniz in
# deps/miniz; the @miniz module is used instead of that copy.
cc_library(
    name = "tinyexr",
    srcs = ["tinyexr.cc"],
    hdrs = [
        "exr_reader.hh",
        "streamreader.hh",
        "tinyexr.h",
    ],
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = ["@miniz"],
)
