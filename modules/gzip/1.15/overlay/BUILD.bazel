# Makefile.am lines 56-57 and 89-102: bin_SCRIPTS, each a `.in` template
# with @GREP@ and @VERSION@ filled in.  The `/bin/sh` -> $(SHELL) and
# `'gzip'` -> $(GZIP_TRANSFORMED) edits are identities here: no
# --program-transform-name, and every platform this builds on has /bin/sh.
# zless and zmore are generated regardless of whether a pager is installed
# on the build machine (configure's AC_CHECK_PROG([LESS]) / ([MORE])); they
# look for it at run time anyway.
#
# The scripts exec `gzip`, `zdiff` and `zgrep` by bare name, so like the
# installed copies they need this package's programs on PATH.
#
# Makefile.am line 96 substitutes the bare $(VERSION), but the VERSION result
# here is the quoted C literal, `"1.15"`.  Each template mentions @VERSION@
# exactly once, inside its `version=` string; wrapping the placeholder in the
# quote character that string uses turns the literal's own quotes into shell
# string concatenation (`"gunzip (gzip) ""1.15""..."`, `'zgrep (gzip) '"1.15"'...'`),
# so the shell sees the same text a `make`-built script has.
SCRIPTS = {
    "gunzip": '"',
    "gzexe": "'",
    "zcat": '"',
    "zcmp": '"',
    "zdiff": '"',
    "zegrep": None,
    "zfgrep": None,
    "zforce": '"',
    "zgrep": "'",
    "zless": '"',
    "zmore": '"',
    "znew": '"',
}

[
    autoconf_hdr(
        name = "{}_script".format(script),
        out = "_scripts/{}".format(script),
        mode = "subst",
        substitutions = {"@VERSION@": quote + "@VERSION@" + quote} if quote else {},
        template = "{}.in".format(script),
        deps = [":autoconf"],
    )
    for script, quote in SCRIPTS.items()
]

[
    copy_file(
        name = script,
        src = ":{}_script".format(script),
        out = "bin/{}".format(script),
        is_executable = True,
        visibility = ["//visibility:public"],
    )
    for script in SCRIPTS
]

# Everything `make check` finds on PATH in the build tree, in
# tests/Makefile.am's `built_programs` order; the test runner stages them.
filegroup(
    name = "programs",
    srcs = [":gzip"] + [":{}".format(script) for script in SCRIPTS],
    visibility = ["//tests:__pkg__"],
)

# Skipped macros (no Bazel equivalent needed):
#
# configure.ac:
#   AC_ARG_ENABLE([gcc-warnings]) (lines 99-117, 127-206) - the port silences
#     every warning via COPTS instead, so the -W flag battery, `lint` and
#     GNULIB_PORTCHECK have no effect.
#   AC_CHECK_PROG([LESS]) / ([MORE]) (lines 64-67) - only select which pager
#     wrappers get installed; both are generated here.
#   AC_CHECK_TOOL([NM]), gzip_cv_underline, ASCPPPOST/ASCPPFLAGS and the
#     match.S assembler probe (lines 68, 217-252) - lib/match.c only carries
#     i386 and m68k assembly, so on every platform this module builds for
#     the probe fails, ASMV stays undefined and the C longest_match is used,
#     exactly as a native configure run concludes.
#   AC_PROG_LN_S, AC_PROG_SHELL, program_transform_name (lines 69-70,
#     254-263) - installation details.
#   gl_EARLY / gl_INIT (lines 72, 74) - expanded by GNULIB_M4_DEPS and the
#     module indicators above.
#   AC_CONFIG_FILES / AC_OUTPUT (lines 258-259) - the Makefile.in ->
#     Makefile expansion has no analogue here.
#
# lib/gnulib.mk:
#   The crc-sliceby8.h rule (lines 282-296) regenerates the table with a
#     native `crc-generate-table`; the tarball ships the result and it is
#     used as is.
