        defaults = True,
        inlines = GL_INLINES,
        mode = "subst",
        template = template,
        deps = [":autoconf"],
    )
    for hdr, template in LIBGZIP_GNULIB_GENERATED_HDRS.items()
]

# The wrapper headers generated only when the matching `GL_GENERATE_*_H` says
# the system header is missing or unusable.  Each is processed
# unconditionally into `_gnulib_cond/` -- not `lib/`, so they cannot collide
# with the unconditional headers above -- and `cc_gnulib_conditional_hdrs`
# picks the ones whose condition holds.
GNULIB_COND_HDR_STEMS = [
    "alloca",
    "assert",
    "byteswap",
    "endian",
    "errno",
    "getopt-cdefs",
    "getopt",
    "limits",
    "stdbit",
    "stdckdint",
    "stdcountof",
    "stddef",
