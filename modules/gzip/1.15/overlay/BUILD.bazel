        # rules_cc_autoconf stdio_h defaults were cut from; gzip does not
        # request the module.
        checks.AC_SUBST("GNULIB_VAPRINTF", 0),
        # gl_FUNC_ERROR derives COMPILE_ERROR_C, which rules_cc_autoconf's
        # error module does not surface (TODO: it should, and then this
        # check can go).  glibc supplies both entry points unreplaced;
        # everywhere else gnulib's lib/error.c has to be compiled in.
        checks.AC_SUBST(
            "COMPILE_ERROR_C",
            condition = "HAVE_ERROR==1 && HAVE_ERROR_AT_LINE==1 && REPLACE_ERROR==0 && REPLACE_ERROR_AT_LINE==0",
            if_false = "1",
            if_true = "0",
        ),
    ] + macros.AC_CHECK_HEADERS([
        # configure.ac line 254.
        "sys/sdt.h",
    ]) + macros.AC_CHECK_FUNCS([
        # configure.ac line 255.  openat and opendir are left to the gnulib
        # modules of the same name, which define HAVE_* themselves.
        "chown",
        "fchmod",
        "fchown",
        "fdopendir",
        "unlinkat",
        # gl_INIT.
        "vasprintf",
    ]) + [
        checks.AC_SUBST(name, 1)
        for name in GNULIB_MODULE_INDICATOR_SUBSTS
    ] + [
        checks.AC_DEFINE(name, 1)
        for name in GNULIB_MODULE_INDICATOR_DEFINES
    ],
    deps = [
        ":m4_crc",
        ":m4_dfltcc",
        ":m4_endian_h",
        ":m4_largefile",
        ":m4_stdint_bitsizeof_wchar_t",
        ":m4_vararrays",
        ":package",
        # configure.ac line 256.
        "@rules_cc_autoconf//autoconf/macros/AC_TYPE_OFF_T",
    ] + GNULIB_M4_DEPS,
)

# configure.ac line 27: AC_CONFIG_HEADERS([lib/config.h:lib/config.hin]).
autoconf_hdr(
    name = "config",
    out = "lib/config.h",
    # AC_C_RESTRICT.  `@rules_cc_autoconf//autoconf/macros/AC_C_RESTRICT`
    # models the pre-2.70 chain -- bare `restrict` first, "no define needed"
    # -- whereas the Autoconf 2.72 that generated gzip's configure tries
    # `__restrict__` first and defines the macro to it on GCC and Clang.
    # Several gnulib modules pull the macro in, so a competing `restrict`
    # define would be rejected as a duplicate; patch the rendered line
    # instead.  The newlines pin the match to the whole template line.
    #
    # TODO: drop once `@rules_cc_autoconf//autoconf/macros/AC_C_RESTRICT`
    # follows the 2.72 order.
    substitutions = {
        "\n#undef restrict\n": "\n#define restrict __restrict__\n",
    },
    template = "lib/config.hin",
    # `tests/help-version` checks `gzip --version` against the VERSION the
    # binary was built with, which the test runner reads from here.
    visibility = ["//tests:__pkg__"],
    deps = [":autoconf"],
)

# Snippet files gnulib's `make` splices into each generated header.
GL_INLINES = {
    "/* The definition of _GL_ARG_NONNULL is copied here.  */": "lib/arg-nonnull.h",
    "/* The definition of _GL_WARN_ON_USE is copied here.  */": "lib/warn-on-use.h",
    "/* The definition of _Noreturn is copied here.  */": "lib/_Noreturn.h",
    "/* The definitions of _GL_FUNCDECL_RPL etc. are copied here.  */": "lib/c++defs.h",
}

