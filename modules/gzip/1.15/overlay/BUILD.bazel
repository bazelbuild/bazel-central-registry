]

# assert.h is the one wrapper gnulib assembles from two files: assert.in.h,
# then verify.h with its `verify`/`assume` half cut out and its identifiers
# renamed (lib/gnulib.mk lines 157-169).  The appended half is what supplies
# a `_Static_assert` that takes one argument on compilers predating C23.
autoconf_hdr(
    name = "lib_assert_h_static_assert_half",
    out = "_gnulib_cond/verify-static_assert.h",
    mode = "subst",
    substitutions = {
        # sed -e '/@assert.h omit start@/,/@assert.h omit end@/d', done by
        # fencing the region off instead of deleting it.
        "/* @assert.h omit end@  */": "#endif /* @assert.h omit end@ */",
        "/* @assert.h omit start@  */": "#if 0 /* @assert.h omit start@ */",
        # sed -e 's|_gl_verify|_gl_static_assert|g'
        #     -e 's|_GL_VERIFY|_GL_STATIC_ASSERT|g'
        "_GL_VERIFY": "_GL_STATIC_ASSERT",
        "_gl_verify": "_gl_static_assert",
    },
    template = "lib/verify.h",
    deps = [":autoconf"],
)

# Snippets spliced into one particular wrapper, on top of GL_INLINES.
GNULIB_COND_HDR_INLINES = {
    "assert": {
        "/* The definition of static_assert is copied here.  */": ":lib_assert_h_static_assert_half",
    },
}

[
    autoconf_hdr(
        name = "lib_{}_h_processed".format(stem.replace("-", "_")),
        out = "_gnulib_cond/{}.h".format(stem),
        defaults = True,
        inlines = GL_INLINES | GNULIB_COND_HDR_INLINES.get(stem, {}),
        mode = "subst",
        template = "lib/{}.in.h".format(stem),
        deps = [":autoconf"],
    )
    for stem in GNULIB_COND_HDR_STEMS
]

# Two headers whose rules_cc_autoconf port does not publish a
# `GL_GENERATE_*_H` get the shell test from their m4 file instead:
# m4/stdbit_h.m4 lines 15-25 (the replacement is wanted when there is no
# <stdbit.h> or when the system one predates C2y's stdc_rotate_left_uc; the
# stdc_memreverse8u.c source below shares the test) and m4/stdcountof_h.m4
# line 48.
STDBIT_H_CONDITION = "ac_cv_subst_HAVE_STDBIT_H==0 || ac_cv_define_HAVE_DECL_STDC_ROTATE_LEFT_UC==0"

GNULIB_COND_HDR_CONDITIONS = {
    "stdbit": STDBIT_H_CONDITION,
    "stdcountof": "!(ac_cv_subst_HAVE_STDCOUNTOF_H==1 && ac_cv_subst_CXX_HAVE_STDCOUNTOF_H==1)",
}

cc_gnulib_conditional_hdrs(
    name = "lib/gzip_gnulib_conditional_hdrs",
    hdrs = {
        ":lib_{}_h_processed".format(stem.replace("-", "_")): GNULIB_COND_HDR_CONDITIONS.get(
            stem,
            "GL_GENERATE_{}_H".format(stem.upper().replace("-", "_")),
        )
        for stem in GNULIB_COND_HDR_STEMS
    },
    deps = [":autoconf"],
)

cc_library(
    name = "lib/gzip_private_headers",
    hdrs = [":config"] + glob(
        ["lib/**/*.h"],
        # The templates are inputs of the autoconf_hdr targets, not headers.
        exclude = ["lib/**/*.in.h"],
    ) + LIBGZIP_GNULIB_GENERATED_HDRS.keys(),
    includes = ["lib"],
    deps = [":lib/gzip_gnulib_conditional_hdrs"],
)

