# Only what `make install` ships is public: bin_PROGRAMS, bin_SCRIPTS and the
# configure options next to them.
package(default_visibility = ["//visibility:private"])

# configure.ac line 22: AC_INIT([gzip], <git-version-gen>, [bug-gzip@gnu.org]).
# `PACKAGE`/`VERSION` get the same values as `PACKAGE_TARNAME`/
# `PACKAGE_VERSION`.  The version comes from MODULE.bazel rather than a
# literal so a `.bcr.N` bump has one place to edit; `strip_bcr_version` is
# what keeps that suffix out of `gzip --version`.
package_info(
    name = "package",
    package_name = "gzip",
    aliases = {
        "PACKAGE": "PACKAGE_TARNAME",
        "VERSION": "PACKAGE_VERSION",
    },
    module_bazel = "MODULE.bazel",
    package_bugreport = "bug-gzip@gnu.org",
    package_tarname = "gzip",
    strip_bcr_version = True,
)

# --enable-dfltcc (configure.ac lines 118-125).  Uses the DEFLATE
# CONVERSION CALL instruction on IBM Z (s390x) for compression and
# decompression; dfltcc.c only compiles for that CPU.
bool_flag(
    name = "dfltcc",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "dfltcc_enabled",
    flag_values = {":dfltcc": "True"},
)

# --enable-largefile (gnulib's largefile module, AC_SYS_LARGEFILE).  Off makes
# 32-bit hosts use a 32-bit off_t, which caps gzip at 2GiB files; on is
# upstream's default.
bool_flag(
    name = "largefile",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "largefile_enabled",
    flag_values = {":largefile": "True"},
)

autoconf(
    name = "m4_dfltcc",
    checks = select({
        # configure.ac line 214: AC_DEFINE([IBM_Z_DFLTCC], , ...) -- an empty
        # value; every consumer tests it with #ifdef.
        ":dfltcc_enabled": [
            checks.AC_DEFINE("IBM_Z_DFLTCC", 1),
        ],
        "//conditions:default": [],
    }),
)

# AC_SYS_LARGEFILE, as expanded by gnulib's largefile module.
autoconf(
    name = "m4_largefile",
    deps = select({
        ":largefile_enabled": ["@rules_cc_autoconf//autoconf/macros/AC_SYS_LARGEFILE"],
        "//conditions:default": [],
    }),
)

# gl_ENDIAN_H (m4/endian_h.m4), ported whole instead of taking
# `@rules_cc_autoconf//gnulib/m4/endian_h`.  That target never decides
# GL_GENERATE_ENDIAN_H, which lib/gnulib.mk line 407 keys both the endian.h
# wrapper and endian.c on, and on macOS it answers HAVE_SYS_ENDIAN_H=1 from
# the deployment target rather than a probe, although no macOS SDK ships
# <sys/endian.h>: the generated wrapper then does `# include <sys/endian.h>`
# and lib/crc.c fails to compile.  The names it emits cannot be overridden
# beside it, so the whole macro moves.  glibc's <endian.h> has the byte-order
# macros but does not pull in <stdint.h>, so upstream generates the wrapper
# there too ("just missing stdint").
#
# TODO: drop once `@rules_cc_autoconf//gnulib/m4/endian_h` probes
# <sys/endian.h> everywhere and models the two probes and
# GL_GENERATE_ENDIAN_H.
ENDIAN_H_BYTE_ORDER_PROBE = """\
/* Big endian to host.  */
int value16_1 = be16toh (0.0);
int value32_1 = be32toh (0.0);
int value64_1 = be64toh (0.0);
/* Host to big endian.  */
int value16_2 = htobe16 (0.0);
int value32_2 = htobe32 (0.0);
int value64_2 = htobe64 (0.0);
/* Little endian to host.  */
int value16_3 = le16toh (0.0);
int value32_3 = le32toh (0.0);
int value64_3 = le64toh (0.0);
/* Host to little endian.  */
int value16_4 = htole16 (0.0);
int value32_4 = htole32 (0.0);
int value64_4 = htole64 (0.0);
/* Make sure the variables get used.  */
return !(value16_1 + value32_1 + value64_1
         + value16_2 + value32_2 + value64_2
         + value16_3 + value32_3 + value64_3
         + value16_4 + value32_4 + value64_4);
"""

autoconf(
    name = "m4_endian_h",
    checks = [
        # Line 13: AC_CHECK_HEADERS_ONCE([endian.h]); lines 15-16, 132.
        checks.AC_CHECK_HEADER(
            "endian.h",
            name = "ac_cv_header_endian_h",
            define = "HAVE_ENDIAN_H",
        ),
        checks.AC_SUBST(
            "HAVE_ENDIAN_H",
            condition = "ac_cv_header_endian_h",
            if_false = 0,
            if_true = 1,
        ),
        # Lines 17-29.
        checks.AC_TRY_COMPILE(
            name = "gl_cv_header_endian_h_stdint_types",
            code = utils.AC_LANG_PROGRAM(
                ["#include <endian.h>"],
                "uint16_t t1 = 0; uint32_t t2 = 0; uint64_t t3 = 0; return !(t1 + t2 + t3);",
            ),
            requires = ["ac_cv_header_endian_h"],
        ),
        # Lines 30-58.
        checks.AC_TRY_LINK(
            name = "gl_cv_header_working_endian_h",
            code = utils.AC_LANG_PROGRAM(
                ["#include <endian.h>"],
                ENDIAN_H_BYTE_ORDER_PROBE,
            ),
            requires = ["ac_cv_header_endian_h"],
        ),
    ] + select({
        # Line 60: AC_CHECK_HEADERS_ONCE([sys/endian.h]); lines 61, 95, 133.
        # The two <sys/endian.h> probes that follow (lines 62-94) feed nothing
        # ("We don't use the result of this test for now").
        #
        # Not probed on macOS: no Apple SDK ships <sys/endian.h> (the
        # byte-order macros live in <machine/endian.h>), yet on the BCR
        # x86_64 macOS runner the compile probe reports it present while
        # the real, sandboxed compile of the generated wrapper cannot find
        # it -- most likely a stray copy under /usr/local/include, which
        # Apple clang searches by default on Intel Macs and Bazel's sandbox
        # hides.  A probe that disagrees with the compiler it is probing for
        # is worth less than the platform fact.
        "@platforms//os:macos": [
            checks.AC_SUBST("HAVE_SYS_ENDIAN_H", 0),
        ],
        "//conditions:default": [
            checks.AC_CHECK_HEADER(
                "sys/endian.h",
                name = "ac_cv_header_sys_endian_h",
                define = "HAVE_SYS_ENDIAN_H",
            ),
            checks.AC_SUBST(
                "HAVE_SYS_ENDIAN_H",
                condition = "ac_cv_header_sys_endian_h",
                if_false = 0,
                if_true = 1,
            ),
        ],
    }) + [
        # Lines 97-102.
        checks.M4_VARIABLE(
            "GL_GENERATE_ENDIAN_H",
            condition = "ac_cv_header_endian_h && gl_cv_header_working_endian_h && gl_cv_header_endian_h_stdint_types",
            if_false = "true",
            if_true = "false",
        ),
        # Lines 104-112 (`test $GL_GENERATE_ENDIAN_H` is true for both
        # "true" and "false", so only the working-header probe decides).
        checks.AC_SUBST(
            "ENDIAN_H_JUST_MISSING_STDINT",
            condition = "gl_cv_header_working_endian_h",
            if_false = 0,
            if_true = 1,
        ),
        # Line 14: gl_CHECK_NEXT_HEADERS([endian.h]).
    ] + gl_macros.GL_CHECK_NEXT_HEADERS(["endian.h"]),
    deps = [
        "@rules_cc_autoconf//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
        # Line 12: AC_REQUIRE([gl_BIGENDIAN]).
        "@rules_cc_autoconf//gnulib/m4/gnulib-common:gl_BIGENDIAN",
        "@rules_cc_autoconf//gnulib/m4/include_next",
    ],
)

# AC_C_VARARRAYS (gl_INIT).  Ported here instead of taking
# `@rules_cc_autoconf//gnulib/m4/vararrays`, which defines __STDC_NO_VLA__
# on every non-macOS platform without probing; GCC and Clang do support
# variable-length arrays, and a real configure run leaves the macro undefined.
#
# TODO: drop once `@rules_cc_autoconf//gnulib/m4/vararrays` probes.
autoconf(
    name = "m4_vararrays",
    checks = [
        checks.AC_TRY_COMPILE(
            name = "ac_cv_c_vararrays",
            code = """\
#ifdef __STDC_NO_VLA__
syntax error;
#endif
int main (void)
{
  static int x;
  char a[++x];
  a[sizeof a - 1] = 0;
  return a[0];
}
""",
        ),
        checks.AC_DEFINE(
            "HAVE_C_VARARRAYS",
            requires = ["ac_cv_c_vararrays"],
        ),
        checks.AC_DEFINE(
            "__STDC_NO_VLA__",
            requires = ["!ac_cv_c_vararrays"],
        ),
    ],
)

# gl_STDINT_BITSIZEOF([wchar_t]) (m4/stdint.m4).  rules_cc_autoconf leaves
# BITSIZEOF_WCHAR_T to its uchar_h module, which gzip's gnulib copy avoids
# (`--avoid=uchar-h`, lib/gnulib.mk line 50), so the stdint.h wrapper would
# otherwise keep a literal @BITSIZEOF_WCHAR_T@ in its wchar_t limits.
#
# TODO: drop once `@rules_cc_autoconf//gnulib/m4/stdint` computes it.
autoconf(
    name = "m4_stdint_bitsizeof_wchar_t",
    checks = [
        checks.AC_COMPUTE_INT(
            "BITSIZEOF_WCHAR_T",
            "(int) (sizeof (wchar_t) * CHAR_BIT)",
            includes = [
                "#include <limits.h>",
                "#include <stddef.h>",
            ],
            subst = True,
        ),
    ],
)

# gl_CRC_SLICE_BY_8 (m4/crc.m4 lines 15-25): on unless the maintainer calls
# gl_DISABLE_CRC_SLICE_BY_8, which gzip does not.  The rules_cc_autoconf crc
# target carries no checks.
autoconf(
    name = "m4_crc",
    checks = [checks.AC_DEFINE("GL_CRC_SLICE_BY_8", 1)],
)

