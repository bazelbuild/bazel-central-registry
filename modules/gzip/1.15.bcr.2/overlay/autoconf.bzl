    "GL_COND_OBJ_STAT": "REPLACE_STAT!=0",
    "GL_COND_OBJ_STDIO_CONSOLESAFE": "USES_MSVCRT==1",
    "GL_COND_OBJ_STDIO_READ": "REPLACE_STDIO_READ_FUNCS!=0",
    "GL_COND_OBJ_STDIO_WRITE": "REPLACE_STDIO_WRITE_FUNCS!=0",
    "GL_COND_OBJ_STPCPY": "ac_cv_subst_HAVE_STPCPY==0 || REPLACE_STPCPY!=0",
    "GL_COND_OBJ_STRERROR": "REPLACE_STRERROR!=0",
    "GL_COND_OBJ_STRERROR_OVERRIDE": "GL_GENERATE_ERRNO_H==true || REPLACE_STRERROR_0!=0",
    "GL_COND_OBJ_TIME": "REPLACE_TIME!=0",
    "GL_COND_OBJ_UTIME": "ac_cv_subst_HAVE_UTIME==0 || REPLACE_UTIME!=0",
    "GL_CRC_X86_64_PCLMUL": "gl_cv_crc_pclmul",
    "GL_GENERATE_BYTESWAP_H": "GL_GENERATE_BYTESWAP_H==true",
    "GL_GENERATE_ENDIAN_H": "GL_GENERATE_ENDIAN_H==true",
    "GL_GENERATE_STDBIT_H": "GL_GENERATE_STDBIT_H==true",
}

