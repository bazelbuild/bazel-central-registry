# buildifier: disable=unnamed-macro
def autoconf_targets():
    """The targets configure.ac and the Makefile.am files describe, in the package that calls this."""

    native.exports_files(["COPYING"])

    license(
        name = "license_COPYING",
        kind = "@package_metadata//licenses/spdx:GPL-3.0-or-later",
        text = "COPYING",
        visibility = ["//:__subpackages__"],
    )

    package_metadata(
        name = "package_metadata",
        attributes = [":license_COPYING"],
        purl = purl.bazel(
            native.module_name(),
            native.module_version(),
        ),
        visibility = ["//:__subpackages__"],
    )

    autoconf_package_info(
        name = "package",
        package_name = "gzip",
        aliases = {
            "PACKAGE": "PACKAGE_TARNAME",
            "VERSION": "PACKAGE_VERSION",
        },
        module_bazel = "//:MODULE.bazel",
        package_bugreport = "bug-gzip@gnu.org",
        strip_bcr_version = True,
        visibility = ["//:__subpackages__"],
    )

    for name, default in BOOL_OPTIONS.items():
        bool_flag(
            name = name,
            build_setting_default = default,
            visibility = ["//visibility:public"],
        )

    for name in BOOL_OPTIONS:
        native.config_setting(
            name = name + "_enabled",
            flag_values = {":" + name: "True"},
            visibility = ["//:__subpackages__"],
        )

    autoconf(
        name = "autoconf",
        checks = [
            checks.AC_DEFINE("_QUOTEARG_AVOID_UCHAR_H", 1),
            checks.AC_SUBST("LESS", "less"),
            checks.AC_SUBST("MORE", "more"),
            checks.AC_SUBST("NM", "nm"),
            checks.M4_VARIABLE("ac_cv_path_shell", "/bin/sh"),
            checks.AC_SUBST(
                "GNULIB_UNISTD_H_GETOPT",
                1,
                requires = ["REPLACE_GETOPT!=0"],
            ),
        ] + macros.AC_CHECK_DECLS(
            [
                "memeq",
                "streq",
            ],
            compile_defines = SYSTEM_EXTENSIONS,
        ) + [
            checks.AC_DEFINE("GNULIB_STDIO_SINGLE_THREAD", 1),
            checks.AC_DEFINE("USE_UNLOCKED_IO", "GNULIB_STDIO_SINGLE_THREAD"),
            checks.AC_TRY_COMPILE(
                name = "ac_cv_c_vararrays",
                code = utils.AC_LANG_PROGRAM(
                    [
                        "#ifdef __STDC_NO_VLA__",
                        "#error no variable-length arrays",
                        "#endif",
                    ],
                    [
                        "int n = 1;",
                        "char a[n];",
                        "a[0] = 0;",
                        "return a[0];",
                    ],
                ),
                compile_defines = SYSTEM_EXTENSIONS,
                define = "HAVE_C_VARARRAYS",
            ),
            checks.AC_DEFINE("GNULIB_NO_VLA", 1),
            checks.AC_DEFINE("GNULIB_SIGPROCMASK_SINGLE_THREAD", 1),
            checks.M4_VARIABLE("gzip_cv_underline", "no"),
        ] + macros.AC_CHECK_HEADERS(
            ["sys/sdt.h"],
        ) + macros.AC_CHECK_FUNCS(
            [
                "fchmod",
                "openat",
                "unlinkat",
            ],
        ) + [
            checks.AC_CHECK_FUNC("opendir"),
            checks.AC_SUBST("ASCPPPOST", "sed '/^ *\\\\#/d; s,//.*,,; s/% /%/g; s/\\\\. /./g'"),
            checks.AC_SUBST(
                "ASCPPFLAGS",
                condition = "gzip_cv_underline==no",
                if_false = "",
                if_true = "-DNO_UNDERLINE",
            ),
            checks.AC_SUBST("GZIP_TRANSFORMED", "gzip"),
            checks.AC_SUBST("ZDIFF_TRANSFORMED", "zdiff"),
            checks.AC_SUBST("ZGREP_TRANSFORMED", "zgrep"),
            checks.AC_SUBST("SHELL", "/bin/sh"),
        ] + [
            checks.AC_SUBST(name, 1)
            for name in GNULIB_MODULE_INDICATOR_SUBSTS
        ] + [
            checks.AC_DEFINE(name, 1)
            for name in GNULIB_MODULE_INDICATOR_DEFINES
        ] + [
            checks.AC_DEFINE(name, value)
            for name, value in GNULIB_MODULE_INDICATOR_TEST_DEFINES.items()
        ] + [
            checks.AC_SUBST("GUARD_PREFIX", "GL"),
        ] + select({
            ":dfltcc_enabled": [
                checks.AC_DEFINE("IBM_Z_DFLTCC"),
            ],
            "//conditions:default": [],
        }) + select({
            ":gcc_warnings_enabled": [
                checks.AC_DEFINE("lint", 1),
                checks.AC_DEFINE("GNULIB_PORTCHECK", 1),
            ],
            "//conditions:default": [],
        }) + select({
            "@rules_cc//cc/compiler:clang-cl": [
                checks.AC_SUBST("USES_MSVCRT", 1),
            ],
            "@rules_cc//cc/compiler:msvc-cl": [
                checks.AC_SUBST("USES_MSVCRT", 1),
            ],
            "//conditions:default": [
                checks.AC_SUBST("USES_MSVCRT", 0),
            ],
        }),
        default_deps = GNULIB_M4_DEFAULT_DEPS,
        visibility = ["//:__subpackages__"],
        deps = [
            ":package",
            "@rules_cc_autoconf//autoconf/macros/AC_CANONICAL_BUILD",
            "@rules_cc_autoconf//autoconf/macros/AC_CANONICAL_HOST",
            "@rules_cc_autoconf//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
            "@rules_cc_autoconf//autoconf/macros/AC_CONFIG_AUX_DIR_DEFAULT",
            "@rules_cc_autoconf//autoconf/macros/AC_C_INLINE",
            "@rules_cc_autoconf//autoconf/macros/AC_FUNC_ALLOCA",
            "@rules_cc_autoconf//autoconf/macros/AC_FUNC_STRERROR_R",
            "@rules_cc_autoconf//autoconf/macros/AC_HEADER_STAT",
            "@rules_cc_autoconf//autoconf/macros/AC_SYS_LARGEFILE",
            "@rules_cc_autoconf//autoconf/macros/AC_SYS_YEAR2038",
            "@rules_cc_autoconf//autoconf/macros/AC_TYPE_MODE_T",
            "@rules_cc_autoconf//autoconf/macros/AC_TYPE_OFF_T",
            "@rules_cc_autoconf//autoconf/macros/AC_TYPE_PID_T",
            "@rules_cc_autoconf//autoconf/macros/AC_TYPE_SIZE_T",
            "@rules_cc_autoconf//autoconf/macros/AC_TYPE_UID_T",
            "@rules_cc_autoconf//autoconf/macros/AC_USE_SYSTEM_EXTENSIONS",
        ] + GNULIB_M4_DEPS,
    )

    autoconf_hdr(
        name = "config",
        out = "lib/config.h",
        template = "lib/config.hin",
        visibility = ["//:__subpackages__"],
        deps = [":autoconf"],
    )

    cc_library(
        name = "config_headers",
        hdrs = [":config"] + native.glob(
            [
                "*.h",
                "lib/*.h",
            ],
            allow_empty = True,
        ),
        include_prefix = ".",
        includes = ["lib"],
        strip_include_prefix = "/",
        visibility = ["//:__subpackages__"],
    )

    for hdr, template in GZIP_GENERATED_HDRS.items():
        autoconf_hdr(
            name = hdr.replace("_gnulib_gen/", "").replace("/", "_").replace(".", "_"),
            out = hdr,
            inlines = GL_INLINES,
            mode = "subst",
            template = template,
            deps = [":autoconf"],
        )

    autoconf_hdr(
        name = "lib_assert_h_verify",
        out = "_gnulib_cond/assert-verify.h",
        mode = "subst",
        substitutions = {
            "/* @assert.h omit end@  */": "#endif /* @assert.h omit end@  */",
            "/* @assert.h omit start@  */": "#if 0 /* @assert.h omit start@  */",
            "_GL_VERIFY": "_GL_STATIC_ASSERT",
            "_gl_verify": "_gl_static_assert",
        },
        template = "lib/verify.h",
        visibility = ["//:__subpackages__"],
        deps = [":autoconf"],
    )

    for stem in GNULIB_COND_HDR_STEMS:
        autoconf_hdr(
            name = "lib_{}_h_processed".format(stem.replace("-", "_")),
            out = "_gnulib_cond/" + stem + ".h",
            inlines = GL_INLINES | GNULIB_COND_HDR_INLINES.get(stem, {}),
            mode = "subst",
            template = "lib/{}.in.h".format(stem),
            deps = [":autoconf"],
        )

    cc_gnulib_conditional_hdrs(
        name = "lib/gzip_gnulib_conditional_hdrs",
        hdrs = {
            ":lib_{}_h_processed".format(stem.replace("-", "_")): "GL_GENERATE_{}_H".format(stem.upper().replace("-", "_"))
            for stem in GNULIB_COND_HDR_STEMS
        },
        strip_include_prefix = "_gnulib_cond",
        visibility = ["//:__subpackages__"],
        deps = [":autoconf"],
    )

    cc_library(
        name = "lib/gzip_gnulib_generated_hdrs",
        hdrs = GZIP_GENERATED_HDRS.keys(),
        strip_include_prefix = "lib/_gnulib_gen",
        visibility = ["//:__subpackages__"],
    )

    cc_library(
        name = "lib/gzip_private_headers",
        hdrs = native.glob(
            ["lib/**/*.h"],
            # The templates are inputs of the autoconf_hdr targets, not headers.
            exclude = ["lib/**/*.in.h"],
        ),
        include_prefix = ".",
        includes = ["lib"],
        strip_include_prefix = "/",
        visibility = ["//:__subpackages__"],
        deps = [
            ":config_headers",
            ":lib/gzip_gnulib_conditional_hdrs",
            ":lib/gzip_gnulib_generated_hdrs",
        ],
    )

    autoconf_srcs(
        name = "lib/gzip_gnulib_conditional_srcs",
        srcs = {
            src: SRC_CONDITIONS[name]
            for src, name in {
                "lib/byteswap.c": "GL_GENERATE_BYTESWAP_H",
                "lib/calloc.c": "GL_COND_OBJ_CALLOC",
                "lib/close.c": "GL_COND_OBJ_CLOSE",
                "lib/closedir.c": "GL_COND_OBJ_CLOSEDIR",
                "lib/crc-x86_64-pclmul.c": "GL_CRC_X86_64_PCLMUL",
                "lib/dirfd.c": "GL_COND_OBJ_DIRFD",
                "lib/dup2.c": "GL_COND_OBJ_DUP2",
                "lib/endian.c": "GL_GENERATE_ENDIAN_H",
                "lib/error.c": "GL_COND_OBJ_ERROR",
                "lib/fclose.c": "GL_COND_OBJ_FCLOSE",
                "lib/fcntl.c": "GL_COND_OBJ_FCNTL",
                "lib/fdatasync.c": "GL_COND_OBJ_FDATASYNC",
                "lib/fflush.c": "GL_COND_OBJ_FFLUSH",
                "lib/fopen.c": "GL_COND_OBJ_FOPEN",
                "lib/fpurge.c": "GL_COND_OBJ_FPURGE",
                "lib/free.c": "GL_COND_OBJ_FREE",
                "lib/fseek.c": "GL_COND_OBJ_FSEEK",
                "lib/fseeko.c": "GL_COND_OBJ_FSEEKO",
                "lib/fseterr.c": "GL_COND_OBJ_FSETERR",
                "lib/fstat.c": "GL_COND_OBJ_FSTAT",
                "lib/fsync.c": "GL_COND_OBJ_FSYNC",
                "lib/ftell.c": "GL_COND_OBJ_FTELL",
                "lib/ftello.c": "GL_COND_OBJ_FTELLO",
                "lib/getdtablesize.c": "GL_COND_OBJ_GETDTABLESIZE",
                "lib/getopt.c": "GL_COND_OBJ_GETOPT",
                "lib/getopt1.c": "GL_COND_OBJ_GETOPT",
                "lib/getprogname.c": "GL_COND_OBJ_GETPROGNAME",
                "lib/gettimeofday.c": "GL_COND_OBJ_GETTIMEOFDAY",
                "lib/lseek.c": "GL_COND_OBJ_LSEEK",
                "lib/lstat.c": "GL_COND_OBJ_LSTAT",
                "lib/malloc.c": "GL_COND_OBJ_MALLOC",
                "lib/msvc-inval.c": "GL_COND_OBJ_MSVC_INVAL",
                "lib/msvc-nothrow.c": "GL_COND_OBJ_MSVC_NOTHROW",
                "lib/open.c": "GL_COND_OBJ_OPEN",
                "lib/opendir.c": "GL_COND_OBJ_OPENDIR",
                "lib/pthread_sigmask.c": "GL_COND_OBJ_PTHREAD_SIGMASK",
                "lib/qsort.c": "GL_COND_OBJ_QSORT",
                "lib/qsort_r.c": "GL_COND_OBJ_QSORT_R",
                "lib/raise.c": "GL_COND_OBJ_RAISE",
                "lib/readdir.c": "GL_COND_OBJ_READDIR",
                "lib/readlink.c": "GL_COND_OBJ_READLINK",
                "lib/realloc.c": "GL_COND_OBJ_REALLOC_POSIX",
                "lib/reallocarray.c": "GL_COND_OBJ_REALLOCARRAY",
                "lib/sigaction.c": "GL_COND_OBJ_SIGACTION",
                "lib/sigprocmask.c": "GL_COND_OBJ_SIGPROCMASK",
                "lib/stat.c": "GL_COND_OBJ_STAT",
                "lib/stdc_memreverse8u.c": "GL_GENERATE_STDBIT_H",
                "lib/stdio-consolesafe.c": "GL_COND_OBJ_STDIO_CONSOLESAFE",
                "lib/stdio-read.c": "GL_COND_OBJ_STDIO_READ",
                "lib/stdio-write.c": "GL_COND_OBJ_STDIO_WRITE",
                "lib/stpcpy.c": "GL_COND_OBJ_STPCPY",
                "lib/strerror-override.c": "GL_COND_OBJ_STRERROR_OVERRIDE",
                "lib/strerror.c": "GL_COND_OBJ_STRERROR",
                "lib/time.c": "GL_COND_OBJ_TIME",
                "lib/utime.c": "GL_COND_OBJ_UTIME",
            }.items()
        },
        visibility = ["//:__subpackages__"],
        wrap = "include",
        deps = [":autoconf"],
    )

    cc_library(
        name = "lib/gzip",
        srcs = GZIP_SRCS + [":lib/gzip_gnulib_conditional_srcs"] + GZIP_PLATFORM_SRCS,
        copts = NO_WARNINGS,
        implementation_deps = [":lib/gzip_private_headers"],
        local_defines = ["HAVE_CONFIG_H"],
        visibility = ["//:__subpackages__"],
        deps = [":lib/gzip_gnulib_conditional_srcs"],
    )

    write_file(
        name = "version_c_in",
        out = "version.c.in",
        content = [
            "#include <config.h>",
            "#include \"version.h\"",
            "char const *Version = @PACKAGE_VERSION@;",
            "",
        ],
        newline = "unix",
        visibility = ["//:__subpackages__"],
    )

    autoconf_hdr(
        name = "version_c",
        out = "version.c",
        mode = "subst",
        template = "version.c.in",
        visibility = ["//:__subpackages__"],
        deps = [":autoconf"],
    )

    write_file(
        name = "version_h",
        out = "version.h",
        content = [
            "extern char const *Version;",
            "",
        ],
        newline = "unix",
        visibility = ["//:__subpackages__"],
    )

    cc_library(
        name = "ver",
        srcs = [
            "version.c",
            "version.h",
        ],
        copts = NO_WARNINGS,
        implementation_deps = [
            ":config_headers",
            ":lib/gzip",
            ":lib/gzip_private_headers",
        ],
        local_defines = ["HAVE_CONFIG_H"],
        visibility = ["//:__subpackages__"],
    )

    autoconf_linkopts(
        name = "linkopts",
        vars = [
            "CLOCK_TIME_LIB",
            "FDATASYNC_LIB",
        ],
        visibility = ["//:__subpackages__"],
        deps = [":autoconf"],
    )

    cc_binary(
        name = "gzip",
        srcs = [
            "bits.c",
            "deflate.c",
            "gzip.c",
            "inflate.c",
            "trees.c",
            "unlzh.c",
            "unlzw.c",
            "unpack.c",
            "unzip.c",
            "util.c",
            "version.c",
            "version.h",
            "zip.c",
        ] + select({
            ":dfltcc_enabled": ["dfltcc.c"],
            "//conditions:default": [],
        }),
        copts = NO_WARNINGS,
        local_defines = ["HAVE_CONFIG_H"],
        visibility = ["//visibility:public"],
        deps = [
            ":config_headers",
            ":lib/gzip",
            ":lib/gzip_private_headers",
            ":linkopts",
            ":ver",
        ],
    )
