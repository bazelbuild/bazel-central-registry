load("@rules_cc//cc:defs.bzl", "cc_library")

load("@rules_license//rules:license.bzl", "license")

license(
    name = "license",
    package_name = "coal",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
    license_text = "LICENSE",
)

cc_library(
    name = "coal",
    srcs = glob([
        "src/**/*.cpp",
        "src/**/*.h",
    ]),
    hdrs = glob([
        "include/**/*.h",
        "include/**/*.hh",
        "include/**/*.hxx",
        "include/**/*.hpp",
    ]),
    copts = [
        "-Isrc",
    ],
    defines = [
        "COAL_STATIC",
        "COAL_HAS_OCTOMAP",
        "COAL_HAVE_OCTOMAP",
        "COAL_HAS_QHULL",
        "OCTOMAP_MAJOR_VERSION=1",
        "OCTOMAP_MINOR_VERSION=10",
        "OCTOMAP_PATCH_VERSION=0",
    ],
    includes = [
        "include",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@assimp",
        "@boost.filesystem",
        "@boost.math",
        "@boost.serialization",
        "@eigen",
        "@octomap",
        "@qhull//:libqhullcpp",
    ],
)
