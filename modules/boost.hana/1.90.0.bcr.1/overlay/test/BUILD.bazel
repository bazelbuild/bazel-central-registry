load("@rules_cc//cc:cc_test.bzl", "cc_test")
load(":boost_test_suite.bzl", "boost_test_suite", "boost_test_support")

boost_test_support()

# Upstream builds these two translation units into a single test.
_MULTI_TU = glob(["issues/github_75/*.cpp"])

boost_test_suite(
    name = "upstream_tests",
    srcs = glob(["**/*.cpp"], exclude = _MULTI_TU),
    hdrs = glob([
        "basic_tuple/auto/*.hpp",
        "concept/constant/*.hpp",
        "concept/struct/*.hpp",
        "ext/boost/fusion/deque/auto/*.hpp",
        "ext/boost/fusion/list/auto/*.hpp",
        "ext/boost/fusion/tuple/auto/*.hpp",
        "ext/boost/fusion/vector/auto/*.hpp",
        "ext/boost/tuple/auto/*.hpp",
        "ext/std/tuple/auto/*.hpp",
        "identity/*.hpp",
        "numeric/*.hpp",
        "tuple/auto/*.hpp",
    ]),
)

cc_test(
    name = "issues_github_75",
    srcs = _MULTI_TU,
    deps = ["@boost.hana"],
)
