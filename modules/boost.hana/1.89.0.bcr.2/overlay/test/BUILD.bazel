load("@rules_cc//cc:cc_test.bzl", "cc_test")
load(":boost_test_suite.bzl", "boost_test_suite", "boost_test_support")

boost_test_support()

# Upstream builds these two translation units into a single test.
_MULTI_TU = glob(["issues/github_75/*.cpp"])

boost_test_suite(
    name = "upstream_tests",
    srcs = glob(["**/*.cpp"], exclude = _MULTI_TU),
)

cc_test(
    name = "issues_github_75",
    srcs = _MULTI_TU,
    deps = [
        ":test_headers",
        ":test_support",
        "@boost.hana",
    ],
)
