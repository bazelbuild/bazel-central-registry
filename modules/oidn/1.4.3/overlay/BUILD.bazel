load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//:build_defs.bzl", "oidn_ispc_cc_library", "oidn_weights_cc_library")

package(
    default_package_metadata = [":package_metadata"],
)

exports_files([
    "LICENSE.txt",
])

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:Apache-2.0",
    text = "LICENSE.txt",
    visibility = ["//visibility:public"],
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

config_setting(
    name = "osx_arm64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:osx",
    ],
)

# On Apple silicon OIDN uses BNNS (Accelerate) instead of oneDNN.
# Only OIDN_DNNL is used by the ISPC sources. rules_ispc passes all defines as a
# single argument, so the ISPC libraries must get exactly one define.
BACKEND_DEFINES = select({
    ":osx_arm64": ["OIDN_BNNS"],
    "//conditions:default": ["OIDN_DNNL"],
})

# OIDN_STATIC_LIB has to be propagated to dependents, otherwise oidn.h declares
# the API as dllimport on Windows.
DEFINES = [
    "OIDN_FILTER_RT",
    "OIDN_FILTER_RTLIGHTMAP",
    "OIDN_STATIC_LIB",
] + BACKEND_DEFINES

expand_template(
    name = "config_h",
    out = "include/OpenImageDenoise/config.h",
    substitutions = {
        "#cmakedefine OIDN_API_NAMESPACE": "",
        "#cmakedefine OIDN_STATIC_LIB": "",
        "@OIDN_VERSION_MAJOR@": "1",
        "@OIDN_VERSION_MINOR@": "4",
        "@OIDN_VERSION_NOTE@": "",
        "@OIDN_VERSION_NUMBER@": "10403",
        "@OIDN_VERSION_PATCH@": "3",
    },
    template = "include/OpenImageDenoise/config.h.in",
)

oidn_ispc_cc_library(
    name = "color_ispc",
    srcs = [
        "core/color.ispc",
        "core/color.isph",
        "core/image.isph",
        "core/math.isph",
        "core/vec.isph",
    ],
    out = "color_ispc.h",
    defines = BACKEND_DEFINES,
    ispc_main_source_file = "core/color.ispc",
)

oidn_ispc_cc_library(
    name = "input_reorder_ispc",
    srcs = [
        "core/color.isph",
        "core/image.isph",
        "core/input_reorder.ispc",
        "core/math.isph",
        "core/reorder.isph",
        "core/tensor.isph",
        "core/vec.isph",
    ],
    out = "input_reorder_ispc.h",
    defines = BACKEND_DEFINES,
    ispc_main_source_file = "core/input_reorder.ispc",
)

oidn_ispc_cc_library(
    name = "output_copy_ispc",
    srcs = [
        "core/color.isph",
        "core/image.isph",
        "core/math.isph",
        "core/output_copy.ispc",
        "core/vec.isph",
    ],
    out = "output_copy_ispc.h",
    defines = BACKEND_DEFINES,
    ispc_main_source_file = "core/output_copy.ispc",
)

oidn_ispc_cc_library(
    name = "output_reorder_ispc",
    srcs = [
        "core/color.isph",
        "core/image.isph",
        "core/math.isph",
        "core/output_reorder.ispc",
        "core/reorder.isph",
        "core/tensor.isph",
        "core/vec.isph",
    ],
    out = "output_reorder_ispc.h",
    defines = BACKEND_DEFINES,
    ispc_main_source_file = "core/output_reorder.ispc",
)

oidn_ispc_cc_library(
    name = "upsample_ispc",
    srcs = [
        "core/color.isph",
        "core/image.isph",
        "core/math.isph",
        "core/tensor.isph",
        "core/upsample.ispc",
        "core/vec.isph",
    ],
    out = "upsample_ispc.h",
    defines = BACKEND_DEFINES,
    ispc_main_source_file = "core/upsample.ispc",
)

cc_binary(
    name = "blob_to_cpp",
    srcs = ["blob_to_cpp.cpp"],
)

oidn_weights_cc_library(
    name = "oidn_weights",
    weights = [
        "rt_alb",
        "rt_hdr",
        "rt_hdr_alb",
        "rt_hdr_alb_nrm",
        "rt_hdr_calb_cnrm",
        "rt_ldr",
        "rt_ldr_alb",
        "rt_ldr_alb_nrm",
        "rt_ldr_calb_cnrm",
        "rt_nrm",
        "rtlightmap_dir",
        "rtlightmap_hdr",
    ],
)

cc_library(
    name = "common",
    srcs = [
        "common/platform.cpp",
        "common/tasking.cpp",
        "common/thread.cpp",
    ],
    hdrs = [
        "common/barrier.h",
        "common/exception.h",
        "common/math.h",
        "common/platform.h",
        "common/ref.h",
        "common/tasking.h",
        "common/thread.h",
        "common/timer.h",
        "include/OpenImageDenoise/config.h",
        "include/OpenImageDenoise/oidn.h",
        "include/OpenImageDenoise/oidn.hpp",
    ],
    defines = DEFINES,
    # oidn.h includes the generated "config.h" relative to itself.
    includes = ["include/OpenImageDenoise"],
    deps = ["@onetbb//:tbb"] + select({
        ":osx_arm64": [],
        "//conditions:default": ["@onednn"],
    }),
)

cc_library(
    name = "OpenImageDenoise",
    srcs = [
        "core/api.cpp",
        "core/buffer.h",
        "core/color.cpp",
        "core/color.h",
        "core/common.h",
        "core/conv.h",
        "core/cpu_buffer.h",
        "core/cpu_device.cpp",
        "core/cpu_device.h",
        "core/data.h",
        "core/device.cpp",
        "core/device.h",
        "core/filter.cpp",
        "core/filter.h",
        "core/image.h",
        "core/input_reorder.cpp",
        "core/input_reorder.h",
        "core/network.cpp",
        "core/network.h",
        "core/node.h",
        "core/output_copy.cpp",
        "core/output_copy.h",
        "core/output_reorder.cpp",
        "core/output_reorder.h",
        "core/pool.h",
        "core/progress.h",
        "core/reorder.h",
        "core/scratch.cpp",
        "core/scratch.h",
        "core/tensor.h",
        "core/tza.cpp",
        "core/tza.h",
        "core/unet.cpp",
        "core/unet.h",
        "core/upsample.cpp",
        "core/upsample.h",
        "core/vec.h",
    ],
    hdrs = [
        "include/OpenImageDenoise/config.h",
        "include/OpenImageDenoise/oidn.h",
        "include/OpenImageDenoise/oidn.hpp",
    ],
    includes = ["include"],
    linkopts = select({
        ":osx_arm64": ["-framework Accelerate"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":color_ispc",
        ":common",
        ":input_reorder_ispc",
        ":oidn_weights",
        ":output_copy_ispc",
        ":output_reorder_ispc",
        ":upsample_ispc",
    ],
)

alias(
    name = "oidn",
    actual = ":OpenImageDenoise",
    visibility = ["//visibility:public"],
)

cc_test(
    name = "oidn_test",
    size = "large",
    srcs = [
        "apps/catch.hpp",
        "apps/oidnTest.cpp",
        "apps/utils/image_io.cpp",
        "apps/utils/image_io.h",
    ],
    # Skip [multi_filter], which denoises several 3001x3001 images and takes
    # minutes in unoptimized builds because the threadpool runtime of the onednn
    # module executes the convolutions single-threaded.
    args = ["~[multi_filter]"],
    deps = [
        ":OpenImageDenoise",
        ":common",
    ],
)
