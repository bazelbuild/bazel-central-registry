module(
    name = "oidn",
    version = "1.4.3",
    bazel_compatibility = [">=7.2.1"],
    compatibility_level = 1,
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "onednn", version = "2.7.3")
bazel_dep(name = "onetbb", version = "2023.1.0")
bazel_dep(name = "package_metadata", version = "0.0.15")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.28")
bazel_dep(name = "rules_ispc", version = "0.0.6")

# rules_ispc registers its ISPC toolchains only as a dev dependency, so oidn
# has to register them to be buildable as a dependency of other modules.
register_toolchains("@rules_ispc//tools:all")
