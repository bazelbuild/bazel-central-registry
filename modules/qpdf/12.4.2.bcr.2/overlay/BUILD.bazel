load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")

# native: qpdf's built-in crypto. openssl: the openssl module, built from source. openssl_system: the platform's
# libcrypto, linked dynamically.
string_flag(
    name = "crypto",
    build_setting_default = "native",
    values = [
        "native",
        "openssl",
        "openssl_system",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "crypto_native",
    flag_values = {":crypto": "native"},
    visibility = ["//libqpdf:__pkg__"],
)

config_setting(
    name = "crypto_openssl",
    flag_values = {":crypto": "openssl"},
    visibility = ["//libqpdf:__pkg__"],
)

config_setting(
    name = "crypto_openssl_system",
    flag_values = {":crypto": "openssl_system"},
    visibility = ["//libqpdf:__pkg__"],
)

# Set only when the target libc has malloc_info(3), as glibc does and musl doesn't; no platform constraint says which.
bool_flag(
    name = "malloc_info",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "malloc_info_enabled",
    flag_values = {":malloc_info": "True"},
    visibility = ["//libqpdf:__pkg__"],
)

# More specific than @platforms//os:windows, so in a select with both, the bare windows key means mingw.
config_setting(
    name = "windows_msvc",
    constraint_values = ["@platforms//os:windows"],
    flag_values = {"@rules_cc//cc/compiler:compiler": "msvc-cl"},
    visibility = [
        "//libqpdf:__pkg__",
        "//qpdf:__pkg__",
    ],
)

config_setting(
    name = "windows_clang_cl",
    constraint_values = ["@platforms//os:windows"],
    flag_values = {"@rules_cc//cc/compiler:compiler": "clang-cl"},
    visibility = [
        "//libqpdf:__pkg__",
        "//qpdf:__pkg__",
    ],
)

alias(
    name = "qpdf",
    actual = "//libqpdf:qpdf",
    visibility = ["//visibility:public"],
)

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:Apache-2.0",
    text = "LICENSE.txt",
    visibility = ["//visibility:public"],
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)
