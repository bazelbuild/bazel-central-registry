cc_library(
    name = "qpdf",
    # libqpdf_SOURCES in libqpdf/CMakeLists.txt.
    srcs = [
        "BitStream.cc",
        "BitWriter.cc",
        "Buffer.cc",
        "BufferInputSource.cc",
        "ClosedFileInputSource.cc",
        "ContentNormalizer.cc",
        "CryptoRandomDataProvider.cc",
        "FileInputSource.cc",
        "InputSource.cc",
        "InsecureRandomDataProvider.cc",
        "JSON.cc",
        "JSONHandler.cc",
        "MD5.cc",
        "NNTree.cc",
        "OffsetInputSource.cc",
        "PDFVersion.cc",
        "Pipeline.cc",
        "Pl_AES_PDF.cc",
        "Pl_ASCII85Decoder.cc",
        "Pl_ASCIIHexDecoder.cc",
        "Pl_Base64.cc",
        "Pl_Buffer.cc",
        "Pl_Concatenate.cc",
        "Pl_Count.cc",
        "Pl_DCT.cc",
        "Pl_Discard.cc",
        "Pl_Flate.cc",
        "Pl_Function.cc",
        "Pl_LZWDecoder.cc",
        "Pl_OStream.cc",
        "Pl_PNGFilter.cc",
        "Pl_QPDFTokenizer.cc",
        "Pl_RC4.cc",
        "Pl_RunLength.cc",
        "Pl_SHA2.cc",
        "Pl_StdioFile.cc",
        "Pl_String.cc",
        "Pl_TIFFPredictor.cc",
        "QPDF.cc",
        "QPDFAcroFormDocumentHelper.cc",
        "QPDFAnnotationObjectHelper.cc",
        "QPDFArgParser.cc",
        "QPDFCryptoProvider.cc",
        "QPDFDocumentHelper.cc",
        "QPDFEFStreamObjectHelper.cc",
        "QPDFEmbeddedFileDocumentHelper.cc",
        "QPDFExc.cc",
        "QPDFFileSpecObjectHelper.cc",
        "QPDFFormFieldObjectHelper.cc",
        "QPDFJob.cc",
        "QPDFJob_argv.cc",
        "QPDFJob_config.cc",
        "QPDFJob_json.cc",
        "QPDFLogger.cc",
        "QPDFMatrix.cc",
        "QPDFObject.cc",
        "QPDFObjectHandle.cc",
        "QPDFObjectHelper.cc",
        "QPDFOutlineDocumentHelper.cc",
        "QPDFOutlineObjectHelper.cc",
        "QPDFPageLabelDocumentHelper.cc",
        "QPDFPageObjectHelper.cc",
        "QPDFParser.cc",
        "QPDFStreamFilter.cc",
        "QPDFSystemError.cc",
        "QPDFTokenizer.cc",
        "QPDFUsage.cc",
        "QPDFWriter.cc",
        "QPDF_Array.cc",
        "QPDF_Dictionary.cc",
        "QPDF_Stream.cc",
        "QPDF_String.cc",
        "QPDF_encryption.cc",
        "QPDF_json.cc",
        "QPDF_linearization.cc",
        "QPDF_objects.cc",
        "QPDF_pages.cc",
        "QTC.cc",
        "QUtil.cc",
        "RC4.cc",
        "ResourceFinder.cc",
        "SF_FlateLzwDecode.cc",
        "SecureRandomDataProvider.cc",
        "global.cc",
        "qpdf-c.cc",
        "qpdfjob-c.cc",
        "qpdflogger-c.cc",
    ] + select(
        # Compiled into this library, as upstream does: the provider and libqpdf reference each other, so a separate
        # provider library can't link.
        {
            "//:crypto_native": [
                "AES_PDF_native.cc",
                "QPDFCrypto_native.cc",
                "RC4_native.cc",
                "SHA2_native.cc",
                ":md5_native_srcs",
                ":rijndael_srcs",
                ":sphlib_srcs",
            ],
            "//:crypto_openssl": ["QPDFCrypto_openssl.cc"],
            "//:crypto_openssl_system": ["QPDFCrypto_openssl.cc"],
        },
        no_match_error = "unhandled //:crypto value",
    ),
    # CMAKE_C/CXX_VISIBILITY_PRESET hidden; QPDF_DLL keeps the public API exported.
    copts = select({
        "@rules_cc//cc/compiler:msvc-cl": [],
        "@rules_cc//cc/compiler:clang-cl": [],
        "//conditions:default": ["-fvisibility=hidden"],
    }),
    # Not copts: sha2.c and sha2big.c are C.
    cxxopts = select({
        "@rules_cc//cc/compiler:msvc-cl": ["/std:c++20"],
        "@rules_cc//cc/compiler:clang-cl": ["/std:c++20"],
        "//conditions:default": ["-std=c++20"],
    }),
    implementation_deps = [":internal_headers"],
    # SecureRandomDataProvider.cc's CryptGenRandom is in advapi32. link.exe ignores -l.
    linkopts = select({
        "//:windows_msvc": ["advapi32.lib"],
        "//:windows_clang_cl": ["advapi32.lib"],
        "@platforms//os:windows": ["-ladvapi32"],
        "//conditions:default": [],
    }),
    local_defines = ["QPDF_DISABLE_QTC=1"],  # ENABLE_QTC is off by default
    # sha2.c and sha2big.c #include md_helper.c; it isn't a translation unit.
    textual_hdrs = select({
        "//:crypto_native": [":sphlib_textual_hdrs"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//include:headers",
        "@libjpeg_turbo//:jpeg",  # the public Pl_DCT.hh includes jpeglib.h
        "@zlib",
    ] + select(
        {
            "//:crypto_native": [],
            "//:crypto_openssl": ["@openssl//:crypto"],
            "//:crypto_openssl_system": [":crypto_system"],
        },
        no_match_error = "unhandled //:crypto value",
    ),
)
