load("@rules_cc//cc:defs.bzl", "cc_test")

cc_test(
    name = "smoke_test",
    size = "small",
    srcs = ["smoke_test.cc"],
    # qpdf is built to C++20 (CMAKE_CXX_STANDARD 20); compile this consumer at
    # the same standard.
    cxxopts = select({
        "@rules_cc//cc/compiler:msvc-cl": ["/std:c++20"],
        "@rules_cc//cc/compiler:clang-cl": ["/std:c++20"],
        "//conditions:default": ["-std=c++20"],
    }),
    deps = ["@qpdf"],
)
