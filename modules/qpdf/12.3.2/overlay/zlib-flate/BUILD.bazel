load("@rules_cc//cc:defs.bzl", "cc_binary")

# Shipped CLI filter tool (zlib-flate/CMakeLists.txt): links plain libqpdf,
# public API only; upstream gives it no wmain treatment.
cc_binary(
    name = "zlib-flate",
    srcs = ["zlib-flate.cc"],
    cxxopts = select({
        "@rules_cc//cc/compiler:msvc-cl": ["/std:c++20"],
        "@rules_cc//cc/compiler:clang-cl": ["/std:c++20"],
        "//conditions:default": ["-std=c++20"],
    }),
    visibility = ["//visibility:public"],
    deps = ["//libqpdf:qpdf"],
)
