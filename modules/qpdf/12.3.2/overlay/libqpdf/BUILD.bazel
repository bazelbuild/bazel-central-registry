load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rules_cc//cc:defs.bzl", "cc_library")

# Dynamic link against the platform-provided libcrypto: the toolchain/platform
# must supply the openssl headers, and -lcrypto resolves the platform's shared
# libcrypto at the consumer link. Carrying no header dependency is deliberate:
# the from-source openssl headers/archive here would let the hermetic libcrypto
# satisfy qpdf's crypto symbols ahead of -lcrypto, silently degenerating this
# arm into the from-source one. A toolchain without system openssl headers
# therefore cannot build this arm.
cc_library(
    name = "crypto_system",
    # GNU -l spelling kept: the openssl_system arm presumes a GNU-driver
    # toolchain whose linker search path can resolve the system libcrypto.
    linkopts = ["-lcrypto"],
)

# ---------------------------------------------------------------------------
# Generated config header (qpdf/qpdf-config.h)
# ---------------------------------------------------------------------------
#
# qpdf's CMake build runs configure_file() on qpdf/qpdf-config.h.in, turning a
# table of configure-time probe results into #define / #undef lines. In a
# hermetic build the pinned platform + toolchain *is* the static model of the
# target, so each probe answer is known at analysis time and the template is
# expanded by substituting each #cmakedefine line with exactly what
# configure_file() would emit: `#define FOO 1` when the probe succeeds,
# `/* #undef FOO */` when it fails.
#
# The keys are the exact template lines, and drift on a version bump is
# asymmetric: a NEW #cmakedefine line passes through unexpanded and fails loud
# at compile (#cmakedefine is not a valid preprocessor directive); a REMOVED or
# renamed line leaves a dead substitution key that is silently ignored.

# CHOICES pinned to upstream's normal-build defaults — deliberate decisions, not
# omissions. Each is a security-policy or external-dependency default that the
# overlay does not expose:
#   AVOID_WINDOWS_HANDLE  — keep the standard Windows secure-random path.
#   USE_INSECURE_RANDOM   — never substitute the insecure PRNG for OS entropy.
#   SKIP_OS_SECURE_RANDOM — keep the OS secure-random provider.
#   ZOPFLI                — the zopfli recompressor would add an external zopfli
#                           dependency; qpdf builds fine without it.
_CONFIG_POLICY_DEFAULTS = {
    "#cmakedefine AVOID_WINDOWS_HANDLE 1": "/* #undef AVOID_WINDOWS_HANDLE */",
    "#cmakedefine SKIP_OS_SECURE_RANDOM 1": "/* #undef SKIP_OS_SECURE_RANDOM */",
    "#cmakedefine USE_INSECURE_RANDOM 1": "/* #undef USE_INSECURE_RANDOM */",
    "#cmakedefine ZOPFLI 1": "/* #undef ZOPFLI */",
}

# USE_CRYPTO_GNUTLS is undef unconditionally: the flag offers no gnutls arm, so
# the gnutls provider is never compiled and its macro never set.
_CONFIG_NO_GNUTLS = {
    "#cmakedefine USE_CRYPTO_GNUTLS 1": "/* #undef USE_CRYPTO_GNUTLS */",
}

# DEAD FACTS — undef unconditionally:
#   _FILE_OFFSET_BITS — upstream sets it only when off_t is 32-bit *without*
#                       macros (LFS_WITH_MACROS AND NOT LFS_WITHOUT_MACROS,
#                       libqpdf/CMakeLists.txt LFS probes). Every supported
#                       target has a native 64-bit off_t, so the faithful
#                       expansion leaves it unset.
#   SIZEOF_SIZE_T     — probed (check_type_size) but read by zero sources.
#   HAVE_INTTYPES_H   — probed (check_include_file) but read by zero sources.
#   HAVE_STDINT_H     — present in the template but upstream has no probe for it
#                       at all, so configure_file() always leaves it undefined.
_CONFIG_DEAD_FACTS = {
    "#cmakedefine HAVE_INTTYPES_H 1": "/* #undef HAVE_INTTYPES_H */",
    "#cmakedefine HAVE_STDINT_H 1": "/* #undef HAVE_STDINT_H */",
    "#cmakedefine SIZEOF_SIZE_T ${SIZEOF_SIZE_T}": "/* #undef SIZEOF_SIZE_T */",
    "#cmakedefine _FILE_OFFSET_BITS ${_FILE_OFFSET_BITS}": "/* #undef _FILE_OFFSET_BITS */",
}

# HAVE_TM_GMTOFF is undef everywhere: upstream's struct-tm probe stores its
# result in the variable HAVE_EXTERN_TM_GMTOFF (libqpdf/CMakeLists.txt), a name
# the template's `#cmakedefine HAVE_TM_GMTOFF` never references — so no qpdf
# build ever defines it and QUtil's local-time path always falls through to the
# `timezone` global. Defining it here would deviate from every upstream binary.
_CONFIG_NO_TM_GMTOFF = {
    "#cmakedefine HAVE_TM_GMTOFF 1": "/* #undef HAVE_TM_GMTOFF */",
}

# CHOICE exposed via the crypto flag. USE_CRYPTO_NATIVE / USE_CRYPTO_OPENSSL is
# the compiled provider; DEFAULT_CRYPTO is the provider QPDFCryptoProvider
# returns by default. The system arm compiles the same openssl provider, so it
# reports "openssl" too. The define must track the flag because the common
# QPDFCryptoProvider.cc registers providers under #ifdef on these macros.
_CONFIG_CRYPTO = select(
    {
        "//:crypto_native": {
            "#cmakedefine DEFAULT_CRYPTO \"${DEFAULT_CRYPTO}\"": "#define DEFAULT_CRYPTO \"native\"",
            "#cmakedefine USE_CRYPTO_NATIVE 1": "#define USE_CRYPTO_NATIVE 1",
            "#cmakedefine USE_CRYPTO_OPENSSL 1": "/* #undef USE_CRYPTO_OPENSSL */",
        },
        "//:crypto_openssl": {
            "#cmakedefine DEFAULT_CRYPTO \"${DEFAULT_CRYPTO}\"": "#define DEFAULT_CRYPTO \"openssl\"",
            "#cmakedefine USE_CRYPTO_NATIVE 1": "/* #undef USE_CRYPTO_NATIVE */",
            "#cmakedefine USE_CRYPTO_OPENSSL 1": "#define USE_CRYPTO_OPENSSL 1",
        },
        "//:crypto_openssl_system": {
            "#cmakedefine DEFAULT_CRYPTO \"${DEFAULT_CRYPTO}\"": "#define DEFAULT_CRYPTO \"openssl\"",
            "#cmakedefine USE_CRYPTO_NATIVE 1": "/* #undef USE_CRYPTO_NATIVE */",
            "#cmakedefine USE_CRYPTO_OPENSSL 1": "#define USE_CRYPTO_OPENSSL 1",
        },
    },
    no_match_error = "unhandled //:crypto value",
)

# PLATFORM FACTS — keyed on the libc/ABI axis (the thing that actually decides
# whether a symbol is present), not an OS proxy.

# localtime_r (QUtil.cc, `#ifdef HAVE_LOCALTIME_R`) and random/srandom
# (InsecureRandomDataProvider.cc, `#ifdef HAVE_RANDOM`) are POSIX functions
# present on the POSIX libcs and absent from the Windows CRT.
_CONFIG_POSIX_LOCALTIME_R = {
    "#cmakedefine HAVE_LOCALTIME_R 1": "#define HAVE_LOCALTIME_R 1",
}

_CONFIG_UCRT_LOCALTIME_R = {
    "#cmakedefine HAVE_LOCALTIME_R 1": "/* #undef HAVE_LOCALTIME_R */",
}

_CONFIG_POSIX_RANDOM = {
    "#cmakedefine HAVE_RANDOM 1": "#define HAVE_RANDOM 1",
}

_CONFIG_UCRT_RANDOM = {
    "#cmakedefine HAVE_RANDOM 1": "/* #undef HAVE_RANDOM */",
}

# extern long timezone (QUtil.cc, `#elif HAVE_EXTERN_LONG_TIMEZONE`): the global
# is visible under each POSIX libc's default feature macros. On Windows the
# consumer sits in the `#else` of `_WIN32` (Windows uses GetLocalTime), so the
# macro is never read there — record its absence.
_CONFIG_POSIX_TIMEZONE = {
    "#cmakedefine HAVE_EXTERN_LONG_TIMEZONE 1": "#define HAVE_EXTERN_LONG_TIMEZONE 1",
}

_CONFIG_UCRT_TIMEZONE = {
    "#cmakedefine HAVE_EXTERN_LONG_TIMEZONE 1": "/* #undef HAVE_EXTERN_LONG_TIMEZONE */",
}

# open_memstream (QUtil.cc, `#if defined(HAVE_MALLOC_INFO) && defined(HAVE_OPEN_MEMSTREAM)`)
# is a POSIX.1-2008 function present on the POSIX libcs and absent from the
# Windows CRT.
_CONFIG_POSIX_OPEN_MEMSTREAM = {
    "#cmakedefine HAVE_OPEN_MEMSTREAM 1": "#define HAVE_OPEN_MEMSTREAM 1",
}

_CONFIG_UCRT_OPEN_MEMSTREAM = {
    "#cmakedefine HAVE_OPEN_MEMSTREAM 1": "/* #undef HAVE_OPEN_MEMSTREAM */",
}

# malloc_info(3) (QUtil.cc, backs the optional malloc-info dump) is a glibc
# extension; asserting it where absent is a compile break, so it is opt-in via
# the //:malloc_info flag.
_CONFIG_GLIBC_MALLOC_INFO = {
    "#cmakedefine HAVE_MALLOC_INFO 1": "#define HAVE_MALLOC_INFO 1",
}

_CONFIG_NO_MALLOC_INFO = {
    "#cmakedefine HAVE_MALLOC_INFO 1": "/* #undef HAVE_MALLOC_INFO */",
}

# fseeko / fseeko64 (QUtil::seek/tell prefer `#if HAVE_FSEEKO`, then
# `#elif HAVE_FSEEKO64`). These reproduce what upstream's
# check_symbol_exists("fseeko"/"fseeko64", "stdio.h") answers per libc:
#   POSIX libcs: fseeko is declared and off_t is natively 64-bit on every
#     supported target; HAVE_FSEEKO64 stays undef — a redundant alternative the
#     fseeko branch preempts.
#   Windows CRT (mingw-w64): <stdio.h> declares BOTH unconditionally, so a
#     faithful reproduction defines both. The fseeko branch wins with mingw's
#     32-bit `_off_t` (_FILE_OFFSET_BITS is unset — dead fact above), so QUtil's
#     QIntC narrowing range-errors at runtime on offsets > 2 GB. This matches
#     the upstream binary for this header set rather than the 64-bit fseeko64
#     path a hand-pick would prefer.
#   MSVC UCRT (msvc-cl, and clang-cl, which defines _MSC_VER): <stdio.h>
#     declares NEITHER symbol, so defining either is a link break. Both stay
#     undef and QUtil::seek/tell fall through to their explicit _MSC_VER
#     _fseeki64/_ftelli64 branch.
_CONFIG_POSIX_FSEEKO = {
    "#cmakedefine HAVE_FSEEKO 1": "#define HAVE_FSEEKO 1",
    "#cmakedefine HAVE_FSEEKO64 1": "/* #undef HAVE_FSEEKO64 */",
}

_CONFIG_UCRT_FSEEKO = {
    "#cmakedefine HAVE_FSEEKO 1": "#define HAVE_FSEEKO 1",
    "#cmakedefine HAVE_FSEEKO64 1": "#define HAVE_FSEEKO64 1",
}

_CONFIG_MSVC_FSEEKO = {
    "#cmakedefine HAVE_FSEEKO 1": "/* #undef HAVE_FSEEKO */",
    "#cmakedefine HAVE_FSEEKO64 1": "/* #undef HAVE_FSEEKO64 */",
}

# POSIX bundle — the inverted encoding of the libc-capability statement: assert
# the POSIX facts (localtime_r, random, the timezone global, open_memstream,
# fseeko) on //conditions:default and carve out the one known exception, the
# Windows CRT, where QUtil takes its _WIN32 branches and fseeko64 exists. This
# covers every POSIX libc, including future ones, without a hand-maintained list;
# on an exotic non-POSIX target the wrong case is a loud build break (undeclared
# localtime_r / random), never a silent one.
_CONFIG_LIBC = select({
    "@platforms//os:windows": _CONFIG_UCRT_LOCALTIME_R | _CONFIG_UCRT_RANDOM | _CONFIG_UCRT_TIMEZONE |
                              _CONFIG_UCRT_OPEN_MEMSTREAM,
    "//conditions:default": _CONFIG_POSIX_LOCALTIME_R | _CONFIG_POSIX_RANDOM | _CONFIG_POSIX_TIMEZONE |
                            _CONFIG_POSIX_OPEN_MEMSTREAM,
}) | select({
    "//:malloc_info_enabled": _CONFIG_GLIBC_MALLOC_INFO,
    "//conditions:default": _CONFIG_NO_MALLOC_INFO,
}) | select({
    "//:windows_msvc": _CONFIG_MSVC_FSEEKO,
    "//:windows_clang_cl": _CONFIG_MSVC_FSEEKO,
    "@platforms//os:windows": _CONFIG_UCRT_FSEEKO,
    "//conditions:default": _CONFIG_POSIX_FSEEKO,
})

expand_template(
    name = "qpdf-config",
    out = "qpdf/qpdf-config.h",
    substitutions =
        _CONFIG_POLICY_DEFAULTS |
        _CONFIG_NO_GNUTLS |
        _CONFIG_DEAD_FACTS |
        _CONFIG_NO_TM_GMTOFF |
        _CONFIG_CRYPTO |
        _CONFIG_LIBC,
    template = "qpdf/qpdf-config.h.in",
)

