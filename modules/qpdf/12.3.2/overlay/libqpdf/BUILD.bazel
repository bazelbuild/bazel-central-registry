# ---------------------------------------------------------------------------
# libqpdf
# ---------------------------------------------------------------------------
#
# srcs mirror libqpdf_SOURCES (libqpdf/CMakeLists.txt) exactly. Target named
# for its archive: -lqpdf -> libqpdf.a.
cc_library(
    name = "qpdf",
    srcs = [
        "BitStream.cc",
        "BitWriter.cc",
        "Buffer.cc",
        "BufferInputSource.cc",
        "ClosedFileInputSource.cc",
        "ContentNormalizer.cc",
        "CryptoRandomDataProvider.cc",
        "FileInputSource.cc",
        "InputSource.cc",
        "InsecureRandomDataProvider.cc",
        "JSON.cc",
        "JSONHandler.cc",
        "MD5.cc",
        "NNTree.cc",
        "OffsetInputSource.cc",
        "PDFVersion.cc",
        "Pipeline.cc",
        "Pl_AES_PDF.cc",
        "Pl_ASCII85Decoder.cc",
        "Pl_ASCIIHexDecoder.cc",
        "Pl_Base64.cc",
        "Pl_Buffer.cc",
        "Pl_Concatenate.cc",
        "Pl_Count.cc",
        "Pl_DCT.cc",
        "Pl_Discard.cc",
        "Pl_Flate.cc",
        "Pl_Function.cc",
        "Pl_LZWDecoder.cc",
        "Pl_OStream.cc",
        "Pl_PNGFilter.cc",
        "Pl_QPDFTokenizer.cc",
        "Pl_RC4.cc",
        "Pl_RunLength.cc",
        "Pl_SHA2.cc",
        "Pl_StdioFile.cc",
        "Pl_String.cc",
        "Pl_TIFFPredictor.cc",
        "QPDF.cc",
        "QPDFAcroFormDocumentHelper.cc",
        "QPDFAnnotationObjectHelper.cc",
        "QPDFArgParser.cc",
        "QPDFCryptoProvider.cc",
        "QPDFDocumentHelper.cc",
        "QPDFEFStreamObjectHelper.cc",
        "QPDFEmbeddedFileDocumentHelper.cc",
        "QPDFExc.cc",
        "QPDFFileSpecObjectHelper.cc",
        "QPDFFormFieldObjectHelper.cc",
        "QPDFJob.cc",
        "QPDFJob_argv.cc",
        "QPDFJob_config.cc",
        "QPDFJob_json.cc",
        "QPDFLogger.cc",
        "QPDFMatrix.cc",
        "QPDFObject.cc",
        "QPDFObjectHandle.cc",
        "QPDFObjectHelper.cc",
        "QPDFOutlineDocumentHelper.cc",
        "QPDFOutlineObjectHelper.cc",
        "QPDFPageLabelDocumentHelper.cc",
        "QPDFPageObjectHelper.cc",
        "QPDFParser.cc",
        "QPDFStreamFilter.cc",
        "QPDFSystemError.cc",
        "QPDFTokenizer.cc",
        "QPDFUsage.cc",
        "QPDFWriter.cc",
        "QPDF_Array.cc",
        "QPDF_Dictionary.cc",
        "QPDF_Stream.cc",
        "QPDF_String.cc",
        "QPDF_encryption.cc",
        "QPDF_json.cc",
        "QPDF_linearization.cc",
        "QPDF_objects.cc",
        "QPDF_pages.cc",
        "QTC.cc",
        "QUtil.cc",
        "RC4.cc",
        "ResourceFinder.cc",
        "SF_FlateLzwDecode.cc",
        "SecureRandomDataProvider.cc",
        "global.cc",
        "qpdf-c.cc",
        "qpdfjob-c.cc",
        "qpdflogger-c.cc",
    ] + select(
        # The flag selects the crypto provider's sources into :qpdf, exactly as
        # upstream appends them to libqpdf_SOURCES (libqpdf/CMakeLists.txt). A
        # separate provider cc_library cannot work: the reference graph is
        # circular across any split — QPDFCrypto_native.cc calls
        # SecureRandomDataProvider (a libqpdf unit) while libqpdf's
        # QPDFCryptoProvider.cc constructs the provider — so a two-archive link
        # fails on ordering and a two-.so link fails on hidden visibility. One
        # compiled library is upstream's model and the only linkable one.
        {
            # qpdf's built-in provider plus the bundled SPH SHA-2 units.
            "//:crypto_native": [
                "AES_PDF_native.cc",
                "MD5_native.cc",
                "QPDFCrypto_native.cc",
                "RC4_native.cc",
                "SHA2_native.cc",
                "rijndael.cc",
                "sha2.c",
                "sha2big.c",
            ],
            # The libcrypto-backed provider, shared by the hermetic and system
            # openssl arms — only the link differs.
            "//:crypto_openssl": ["QPDFCrypto_openssl.cc"],
            "//:crypto_openssl_system": ["QPDFCrypto_openssl.cc"],
        },
        no_match_error = "unhandled //:crypto value",
    ),
    # CMAKE_C/CXX_VISIBILITY_PRESET hidden (top CMakeLists.txt): the static build
    # never defines libqpdf_EXPORTS, so DLL.h's QPDF_DLL is inert and hidden
    # visibility keeps internal symbols out of the eventual link's surface. The
    # MSVC-driver arms get [] because -fvisibility is a GNU-driver flag with no
    # MSVC equivalent — MSVC symbols are already hidden unless
    # __declspec-exported.
    copts = select({
        "@rules_cc//cc/compiler:msvc-cl": [],
        "@rules_cc//cc/compiler:clang-cl": [],
        "//conditions:default": ["-fvisibility=hidden"],
    }),
    # cxxopts not copts: the C++ units want -std=c++20 (CMAKE_CXX_STANDARD 20,
    # CMAKE_CXX_EXTENSIONS OFF), but the native provider's sha2.c/sha2big.c are
    # C and a C compile rejects a C++ -std flag.
    cxxopts = select({
        "@rules_cc//cc/compiler:msvc-cl": ["/std:c++20"],
        "@rules_cc//cc/compiler:clang-cl": ["/std:c++20"],
        "//conditions:default": ["-std=c++20"],
    }),
    implementation_deps = [":internal_headers"],
    # SecureRandomDataProvider.cc uses wincrypt CryptGenRandom, which lives in
    # advapi32 (top CMakeLists.txt appends Advapi32 to CMAKE_REQUIRED_LIBRARIES
    # under WIN32). An archive doesn't link; this propagates to the consumer link.
    # The MSVC-driver arms use the advapi32.lib spelling because link.exe
    # ignores -l (LNK4044).
    linkopts = select({
        "//:windows_msvc": ["advapi32.lib"],
        "//:windows_clang_cl": ["advapi32.lib"],
        "@platforms//os:windows": ["-ladvapi32"],
        "//conditions:default": [],
    }),
    # QPDF_DISABLE_QTC=1: the normal-build default (top CMakeLists.txt adds it
    # unless ENABLE_QTC, which is OFF) — compiles out the QTC::TC test-coverage
    # calls. Every other macro travels in the generated qpdf-config.h, not here.
    local_defines = ["QPDF_DISABLE_QTC=1"],
    # sha2.c / sha2big.c `#include "sph/md_helper.c"` after defining its
    # round-function macros; it is not a standalone translation unit, so it must
    # be a textual header, not a compiled src.
    textual_hdrs = select({
        "//:crypto_native": ["sph/md_helper.c"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    # zlib and libjpeg_turbo are non-droppable dep edges (header + link), not
    # -lz/-ljpeg linkopts: Pl_Flate.cc includes <zlib.h> and Pl_DCT.cc includes
    # <jpeglib.h>, both unconditionally compiled, and QPDF_Stream.cc's runtime
    # filter dispatch takes &SF_DCTDecode::factory so the linker can never strip
    # the DCT path. They stay in deps, not implementation_deps, because the
    # public Pl_DCT.hh includes jpeglib.h. The crypto arm must supply the link
    # requirement of the crypto source group selected into srcs.
    deps = [
        "//include:headers",
        "@libjpeg_turbo//:jpeg",
        "@zlib",
    ] + select(
        {
            "//:crypto_native": [],
            "//:crypto_openssl": ["@openssl//:crypto"],
            "//:crypto_openssl_system": [":crypto_system"],
        },
        no_match_error = "unhandled //:crypto value",
    ),
)
