load("@rules_cc//cc:defs.bzl", "cc_test")

# In-archive smoke test: examples/pdf-create.cc writes a self-contained PDF from
# scratch to its single filename argument, exercising the writer + Flate +
# crypto-provider paths end to end; it exits non-zero on any failure, so a pass
# proves the archive can synthesize and serialize a PDF.
cc_test(
    name = "pdf_create_test",
    srcs = ["pdf-create.cc"],
    args = ["pdf_create_out.pdf"],
    cxxopts = select({
        "@rules_cc//cc/compiler:msvc-cl": ["/std:c++20"],
        "@rules_cc//cc/compiler:clang-cl": ["/std:c++20"],
        "//conditions:default": ["-std=c++20"],
    }),
    visibility = ["//:__pkg__"],
    deps = ["//libqpdf:qpdf"],
)
