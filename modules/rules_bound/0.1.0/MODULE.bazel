"""Bazel rules for bound: turn an executable and its runfiles into one file."""

module(
    name = "rules_bound",
    version = "0.1.0",
    compatibility_level = 1,
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")

# The bound toolchains: released binaries for every supported platform, or
# the root module's choice (see bound/extensions.bzl).
bound = use_extension("//bound:extensions.bzl", "bound")
use_repo(bound, "bound_toolchains")

register_toolchains("@bound_toolchains//:all")
