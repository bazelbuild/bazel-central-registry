"""Exercises @rules_nasm//tests against this version of nasm."""

module(
    name = "nasm_test_module",
    version = "0.0.0",
)

# rules_nasm depends on an older nasm, so the version under test has to be
# forced. The override is by path rather than by version so that this file
# needs no edit when it is copied to the next nasm release: `..` is whichever
# version's overlay it happens to be sitting in. The version below is
# therefore ignored -- `local_path_override` supersedes it.
bazel_dep(name = "nasm", version = "0.0.0")
bazel_dep(name = "rules_nasm", version = "0.5.0")

local_path_override(
    module_name = "nasm",
    path = "..",
)

register_toolchains("@rules_nasm//nasm/toolchain")
