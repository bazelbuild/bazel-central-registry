module(
    name = "rules_vivado",
    version = "0.5.0",
    bazel_compatibility = [">=7.0.0"],
)

bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_verilog", version = "1.4.3")
bazel_dep(name = "rules_vhdl", version = "0.4.1")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_tcl", version = "0.12.1")

# Dev dependencies used by root-workspace packages (docs, bzl_version, tests).
bazel_dep(name = "rules_venv", version = "0.23.0", dev_dependency = True)
bazel_dep(name = "rules_rust", version = "0.73.0", dev_dependency = True)
bazel_dep(name = "rules_rust_mdbook", version = "0.73.0", dev_dependency = True)
bazel_dep(name = "stardoc", version = "0.8.0", dev_dependency = True, repo_name = "io_bazel_stardoc")

# mdbook-mermaid for `//docs` (see `//docs:extensions.bzl`).
mermaid = use_extension("//docs:extensions.bzl", "mermaid", dev_dependency = True)
use_repo(mermaid, "mdbook_mermaid")

register_toolchains(
    "//tests/toolchains:vivado_toolchain_2025_1",
    "//tests/toolchains:vivado_toolchain_2024_2",
    dev_dependency = True,
)

# 2025.1 first — it's the default the ruleset targets in local
# development containers. Switch versions per-target via
# `--platforms=//tests/toolchains:vivado_X_Y_platform` or a
# `cfg = transition(...)` wrapper rule.
register_execution_platforms(
    "//tests/toolchains:vivado_2025_1_platform",
    "//tests/toolchains:vivado_2024_2_platform",
    dev_dependency = True,
)
