load("@rules_cc//cc:cc_library.bzl", "cc_library")

# The private headers are expanded by their includer through BOOST_PP_ITERATE.
_TEXTUAL_HDRS = glob(["include/boost/parameter/aux_/**/*.hpp"])

cc_library(
    name = "boost.parameter_python",
    hdrs = glob(["include/**/*.hpp"], exclude = _TEXTUAL_HDRS),
    features = ["parse_headers"],
    includes = ["include"],
    textual_hdrs = _TEXTUAL_HDRS,
    visibility = ["//visibility:public"],
    deps = [
        "@boost.mpl",
        "@boost.parameter",
        "@boost.preprocessor",
        "@boost.python",
    ],
)
