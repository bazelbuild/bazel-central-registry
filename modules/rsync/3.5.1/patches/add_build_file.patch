diff --git a/rounding.bzl b/rounding.bzl
new file mode 100644
--- /dev/null
+++ b/rounding.bzl
@@ -0,0 +1,119 @@
+"""Generates rsync's "rounding.h" header file.
+
+The rsync program describes each file in a transfer with a "struct file_struct" value. The file's
+optional fields, such as its owner or its access time, occupy four-byte slots in front of that
+value. The program rounds the number of slots up so that the 64-bit values among them stay aligned.
+"EXTRA_ROUNDING" is one less than the multiple to which it rounds. The project's own Makefile finds
+the value by attempting to compile the "rounding.c" file with each candidate value and keeping the
+first that compiles successfully. The "rounding_header" rule runs that same test with the C compiler
+and flags of the toolchain that Bazel chose for the platform on which this rsync will run.
+"""
+
+load("@rules_cc//cc:action_names.bzl", "ACTION_NAMES")
+load(
+    "@rules_cc//cc:find_cc_toolchain.bzl",
+    "CC_TOOLCHAIN_ATTRS",
+    "find_cc_toolchain",
+    "use_cc_toolchain",
+)
+load("@rules_cc//cc/common:cc_common.bzl", "cc_common")
+load("@rules_cc//cc/common:cc_info.bzl", "CcInfo")
+
+def _rounding_header_impl(ctx):
+    cc_toolchain = find_cc_toolchain(ctx)
+    feature_configuration = cc_common.configure_features(
+        ctx = ctx,
+        cc_toolchain = cc_toolchain,
+        requested_features = ctx.features,
+        unsupported_features = ctx.disabled_features,
+    )
+    compilation_context = cc_common.merge_cc_infos(
+        cc_infos = [dep[CcInfo] for dep in ctx.attr.deps],
+    ).compilation_context
+    variables = cc_common.create_compile_variables(
+        cc_toolchain = cc_toolchain,
+        feature_configuration = feature_configuration,
+        source_file = ctx.file.src.path,
+        # Only whether the source file compiles matters, not the object file it would produce.
+        output_file = "/dev/null",
+        user_compile_flags = ctx.fragments.cpp.copts + ctx.fragments.cpp.conlyopts,
+        include_directories = compilation_context.includes,
+        # Bazel writes a generated header file such as "proto.h" into the output directory, not
+        # beside the source files that include it.
+        quote_include_directories = depset(
+            [
+                header.dirname
+                for header in ctx.files.hdrs
+                if not header.is_source
+            ],
+            transitive = [compilation_context.quote_includes],
+        ),
+        system_include_directories = compilation_context.system_includes,
+        framework_include_directories = compilation_context.framework_includes,
+        preprocessor_defines = compilation_context.defines,
+    )
+    compiler = cc_common.get_tool_for_action(
+        feature_configuration = feature_configuration,
+        action_name = ACTION_NAMES.c_compile,
+    )
+    command_line = cc_common.get_memory_inefficient_command_line(
+        feature_configuration = feature_configuration,
+        action_name = ACTION_NAMES.c_compile,
+        variables = variables,
+    )
+    ctx.actions.run(
+        outputs = [ctx.outputs.out],
+        inputs = depset(
+            [ctx.file._test_program, ctx.file.src] + ctx.files.hdrs,
+            transitive = [cc_toolchain.all_files, compilation_context.headers],
+        ),
+        executable = "/bin/sh",
+        arguments = [ctx.file._test_program.path, ctx.outputs.out.path, compiler] + command_line,
+        mnemonic = "RsyncRounding",
+        env = cc_common.get_environment_variables(
+            feature_configuration = feature_configuration,
+            action_name = ACTION_NAMES.c_compile,
+            variables = variables,
+        ),
+        execution_requirements = {
+            requirement: ""
+            for requirement in cc_common.get_execution_requirements(
+                feature_configuration = feature_configuration,
+                action_name = ACTION_NAMES.c_compile,
+            )
+        },
+    )
+
+rounding_header = rule(
+    implementation = _rounding_header_impl,
+    doc = "Writes a header file that defines the \"EXTRA_ROUNDING\" macro with the smallest " +
+          "candidate value for which the \"src\" file compiles successfully.",
+    attrs = {
+        "deps": attr.label_list(
+            providers = [CcInfo],
+            doc = "The C libraries whose header files \"rsync.h\" includes.",
+        ),
+        "hdrs": attr.label_list(
+            allow_files = [".h"],
+            doc = "The header files that the \"src\" file includes directly or through other " +
+                  "header files. The generated ones among them also supply the include search " +
+                  "path for the output directory.",
+        ),
+        "out": attr.output(
+            mandatory = True,
+            doc = "The header file to write.",
+        ),
+        "src": attr.label(
+            allow_single_file = [".c"],
+            mandatory = True,
+            doc = "The C source file, which compiles only when the \"EXTRA_ROUNDING\" macro has " +
+                  "a value that leaves its test struct free of padding.",
+        ),
+        "_test_program": attr.label(
+            default = ":rounding_test.sh",
+            allow_single_file = True,
+        ),
+    } | CC_TOOLCHAIN_ATTRS,
+    fragments = ["cpp"],
+    toolchains = use_cc_toolchain(),
+)
diff --git a/rounding_test.sh b/rounding_test.sh
new file mode 100644
--- /dev/null
+++ b/rounding_test.sh
@@ -0,0 +1,23 @@
+#!/bin/sh
+# Writes the header file named by the first argument, defining the "EXTRA_ROUNDING" macro with the
+# first candidate value for which the compilation succeeds. The remaining arguments are the compiler
+# command without that macro's definition; the program adds the definition for each candidate value
+# in turn. The candidate values are the ones that rsync's own Makefile tries.
+
+set -eu
+
+out="$1"
+shift
+logs=''
+for r in 0 1 3; do
+  if log="$("$@" "-DEXTRA_ROUNDING=${r}" 2>&1)"; then
+    echo "#define EXTRA_ROUNDING ${r}" >"${out}"
+    exit 0
+  fi
+  logs="${logs}
+--- EXTRA_ROUNDING=${r} ---
+${log}"
+done
+printf '%s\n' "${logs}" >&2
+printf 'Failed to create %s.\n' "${out}" >&2
+exit 1
