"""rules_cc_autoconf"""

module(
    name = "rules_cc_autoconf",
    version = "0.26.0",
)

bazel_dep(name = "rules_cc", version = "0.2.4")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_features", version = "1.47.1")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.1")

bazel_dep(name = "m4", version = "1.4.21.bcr.5", dev_dependency = True)

# The BCR overlay compiles gnulib's fseeko.c/ftello.c only when REPLACE_*;
# upstream gnulib also compiles them when HAVE_* is 0, which is the MSVC case.
# Without this the m4 binary fails to link on Windows.
single_version_override(
    module_name = "m4",
    patch_strip = 1,
    patches = ["//autoconf/tests/gnu:m4_fseeko.patch"],
)

bazel_dep(name = "rules_perl", version = "1.2.0", dev_dependency = True)
bazel_dep(name = "rules_rust_mdbook", version = "0.74.0", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)
bazel_dep(name = "rules_venv", version = "0.33.0", dev_dependency = True)
bazel_dep(name = "stardoc", version = "0.8.0", dev_dependency = True)

# Temporary compatibility patches for actions used by the development tools.
single_version_override(
    module_name = "protobuf",
    patch_strip = 1,
    patches = ["//tools/patches:protobuf-auto-exec-groups.patch"],
    version = "33.4",
)

register_toolchains(
    "//gnulib/toolchain",
)

register_toolchains(
    "//autoconf/tests/gnu:autotools_toolchain",
    dev_dependency = True,
)

gnulib = use_extension("//gnulib/tests:deps.bzl", "gnulib", dev_dependency = True)
use_repo(
    gnulib,
    "gnulib",
)

autotools = use_extension("//autoconf/tests/gnu:deps.bzl", "autotools", dev_dependency = True)
use_repo(
    autotools,
    "autoconf",
    "automake",
)

# Host compiler/SDK identity, so toolchain upgrades invalidate cached
# conformance results (`local_config_cc` alone does not change with the SDK).
host_cc_fingerprint = use_repo_rule("//autoconf/tests/gnu:host_fingerprint.bzl", "host_cc_fingerprint")

host_cc_fingerprint(
    name = "host_cc_fingerprint",
    dev_dependency = True,
)
