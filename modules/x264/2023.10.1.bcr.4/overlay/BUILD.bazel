autoconf(
    name = "config_checks",
    checks = [
        # Compile checks mirroring configure cc_check/cpp_check calls
        # configure defines HAVE_MALLOC_H per host OS rather than by probing for
        # the header, because what common/base.c actually needs from it is
        # memalign. MSVC ships malloc.h but spells the function
        # _aligned_malloc, so probe for the function.
        checks.AC_TRY_LINK(
            name = "ac_cv_func_memalign",
            code = "void *p = memalign(16, 16); free(p);",
            includes = [
                "#include <malloc.h>",
                "#include <stdlib.h>",
            ],
        ),
        checks.AC_DEFINE(
            "HAVE_MALLOC_H",
            condition = "ac_cv_func_memalign",
            if_false = "0",
            if_true = "1",
        ),
        checks.AC_TRY_LINK(
            name = "ac_cv_func_log2f",
            code = "volatile float x = 2; return (int)log2f(x);",
            includes = ["#include <math.h>"],
        ),
        checks.AC_DEFINE(
            "HAVE_LOG2F",
            condition = "ac_cv_func_log2f",
            if_false = "0",
            if_true = "1",
        ),
        checks.AC_TRY_LINK(
            name = "ac_cv_func_strtok_r",
            code = "strtok_r(0, 0, 0);",
            includes = ["#include <string.h>"],
        ),
        checks.AC_DEFINE(
            "HAVE_STRTOK_R",
            condition = "ac_cv_func_strtok_r",
            if_false = "0",
            if_true = "1",
        ),
        checks.AC_TRY_LINK(
            name = "ac_cv_func_clock_gettime",
            code = "clock_gettime(CLOCK_MONOTONIC, 0);",
            includes = ["#include <time.h>"],
        ),
        checks.AC_DEFINE(
            "HAVE_CLOCK_GETTIME",
            condition = "ac_cv_func_clock_gettime",
            if_false = "0",
            if_true = "1",
        ),
        checks.AC_TRY_COMPILE(
            name = "ac_cv_have_mmap",
            code = "int x = MAP_PRIVATE; (void)x;",
            includes = [
                "#include <sys/mman.h>",
                "#include <unistd.h>",
            ],
        ),
        checks.AC_DEFINE(
            "HAVE_MMAP",
            condition = "ac_cv_have_mmap",
            if_false = "0",
            if_true = "1",
        ),
        checks.AC_TRY_COMPILE(
            name = "ac_cv_have_vectorext",
            code = "uint32_t test_vec __attribute__ ((vector_size (16))) = {0,1,2,3}; (void)test_vec;",
            includes = ["#include <stdint.h>"],
        ),
        checks.AC_DEFINE(
            "HAVE_VECTOREXT",
            condition = "ac_cv_have_vectorext",
            if_false = "0",
            if_true = "1",
        ),
        checks.AC_TRY_LINK(
            name = "ac_cv_func_fseeko",
            code = "fseeko(stdin,0,0);",
            includes = ["#include <stdio.h>"],
        ),
        checks.AC_DEFINE(
            "fseek",
            condition = "ac_cv_func_fseeko",
            if_false = None,
            if_true = "fseeko",
        ),
        checks.AC_DEFINE(
            "ftell",
            condition = "ac_cv_func_fseeko",
            if_false = None,
            if_true = "ftello",
        ),

        # Configuration constants
        checks.AC_DEFINE("HAVE_THREAD", "1"),
        checks.AC_DEFINE("HAVE_AVS", "1"),
        checks.AC_DEFINE("HAVE_BITDEPTH8", "1"),
        checks.AC_DEFINE("HAVE_BITDEPTH10", "1"),
        checks.AC_DEFINE("HAVE_GPL", "1"),
        checks.AC_DEFINE("HAVE_INTERLACED", "1"),
        checks.AC_DEFINE("HAVE_OPENCL", "0"),

        # Unsupported/disabled features
        checks.AC_DEFINE("HAVE_ALTIVEC", "0"),
        checks.AC_DEFINE("HAVE_ALTIVEC_H", "0"),
        checks.AC_DEFINE("HAVE_ARMV6", "0"),
        checks.AC_DEFINE("HAVE_ARMV6T2", "0"),
        checks.AC_DEFINE("HAVE_BEOSTHREAD", "0"),
        checks.AC_DEFINE("HAVE_SWSCALE", "0"),
        checks.AC_DEFINE("HAVE_LAVF", "0"),
        checks.AC_DEFINE("HAVE_FFMS", "0"),
        checks.AC_DEFINE("HAVE_GPAC", "0"),
        checks.AC_DEFINE("HAVE_CPU_COUNT", "0"),
        checks.AC_DEFINE("HAVE_THP", "0"),
        checks.AC_DEFINE("HAVE_LSMASH", "0"),
        checks.AC_DEFINE("HAVE_AS_FUNC", "0"),
        checks.AC_DEFINE("HAVE_INTEL_DISPATCHER", "0"),
        checks.AC_DEFINE("HAVE_MSA", "0"),
        checks.AC_DEFINE("HAVE_WINRT", "0"),
        checks.AC_DEFINE("HAVE_VSX", "0"),
        checks.AC_DEFINE("HAVE_ARM_INLINE_ASM", "0"),
    ] + select({
        "@platforms//cpu:aarch64": [
            checks.AC_DEFINE("HAVE_AARCH64", "1"),
            checks.AC_DEFINE("ARCH_AARCH64", "1"),
            checks.AC_DEFINE("HAVE_NEON", "1"),
            checks.AC_DEFINE("HAVE_MMX", "0"),
        ],
        "@platforms//cpu:x86_64": [
            checks.AC_DEFINE("ARCH_X86_64", "1"),
            checks.AC_DEFINE("HAVE_AARCH64", "0"),
            checks.AC_DEFINE("HAVE_NEON", "0"),
            checks.AC_DEFINE("HAVE_MMX", "1"),
        ],
        "//conditions:default": [
            checks.AC_DEFINE("HAVE_AARCH64", "0"),
            checks.AC_DEFINE("HAVE_NEON", "0"),
            checks.AC_DEFINE("HAVE_MMX", "0"),
        ],
    }) + select({
        # common/x86/util.h is GNU inline assembly, which cl.exe cannot parse.
        ":gnu_like_x86_64": [checks.AC_DEFINE("HAVE_X86_INLINE_ASM", "1")],
        "//conditions:default": [checks.AC_DEFINE("HAVE_X86_INLINE_ASM", "0")],
    }) + select({
        # configure only raises the stack alignment above the ABI default when
        # it can also make the compiler guarantee it, which it attempts solely
        # for GNU compilers on x86 (-mpreferred-stack-boundary=6 /
        # -mstack-alignment=64, applied in COPTS below). Everything else --
        # cl.exe and every aarch64 target -- keeps 16.
        ":gnu_like_x86_64": [checks.AC_DEFINE("STACK_ALIGNMENT", "64")],
        "//conditions:default": [checks.AC_DEFINE("STACK_ALIGNMENT", "16")],
    }) + select({
        "@platforms//os:linux": [
            checks.AC_DEFINE("SYS_LINUX", "1"),
            checks.AC_DEFINE("HAVE_POSIXTHREAD", "1"),
            checks.AC_DEFINE("HAVE_WIN32THREAD", "0"),
        ],
        "@platforms//os:macos": [
            checks.AC_DEFINE("SYS_MACOSX", "1"),
            checks.AC_DEFINE("HAVE_POSIXTHREAD", "1"),
            checks.AC_DEFINE("HAVE_WIN32THREAD", "0"),
        ],
        # pthreads are not part of the platform, so use the native threading
        # backend.
        "@platforms//os:windows": [
            checks.AC_DEFINE("SYS_WINDOWS", "1"),
            checks.AC_DEFINE("HAVE_POSIXTHREAD", "0"),
            checks.AC_DEFINE("HAVE_WIN32THREAD", "1"),
        ],
        "//conditions:default": [
            checks.AC_DEFINE("HAVE_POSIXTHREAD", "1"),
            checks.AC_DEFINE("HAVE_WIN32THREAD", "0"),
        ],
    }),
)

autoconf_hdr(
    name = "config_h",
    out = "config.h",
    template = ":config_h_in",
    deps = [":config_checks"],
)

# config.h is a build-internal header -- upstream's install-lib-dev ships only
# x264.h and x264_config.h, and distclean deletes config.h. Keeping it behind
# implementation_deps means it never reaches a consumer's include path, where
# such a generic name would collide with the consumer's own config.h.
cc_library(
    name = "config",
    hdrs = [":config.h"],
    includes = ["."],
)

# Upstream's SRCS also lists encoder/api.c; it is compiled into :x264 itself
# instead. api.c is the only bit-depth-independent object that calls into the
# per-bit-depth ones, so keeping it here would make :objs both a dependency and
# a dependent of :objs_8/:objs_10, which no single link order can satisfy.
SRCS = [
    "common/osdep.c",
    "common/base.c",
    "common/cpu.c",
    "common/tables.c",
] + select({
    "@platforms//os:windows": ["common/win32thread.c"],
    "//conditions:default": [],
})

# Upstream's Arm OBJASM entries that carry no bit depth. aarch64 has none.
SRCASM_ARM = select({
    "@platforms//cpu:armv7": ["common/arm/cpu-a.S"],
    "//conditions:default": [],
})

SRCS_X = [
    "common/mc.c",
    "common/predict.c",
    "common/pixel.c",
    "common/macroblock.c",
    "common/frame.c",
    "common/dct.c",
    "common/cabac.c",
    "common/common.c",
    "common/rectangle.c",
    "common/set.c",
    "common/quant.c",
    "common/deblock.c",
    "common/vlc.c",
    "common/mvpred.c",
    "common/bitstream.c",
    "encoder/analyse.c",
    "encoder/me.c",
    "encoder/ratecontrol.c",
    "encoder/set.c",
    "encoder/macroblock.c",
    "encoder/cabac.c",
    "encoder/cavlc.c",
    "encoder/encoder.c",
    "encoder/lookahead.c",

    # HAVE_THREAD 1
    "common/threadpool.c",
] + select({
    "@platforms//cpu:aarch64": [
        "common/aarch64/asm-offsets.c",
        "common/aarch64/mc-c.c",
        "common/aarch64/predict-c.c",
    ],
    "@platforms//cpu:armv7": [
        "common/arm/mc-c.c",
        "common/arm/predict-c.c",
    ],
    "@platforms//cpu:x86_64": [
        "common/x86/mc-c.c",
        "common/x86/predict-c.c",
    ],
    "//conditions:default": [],
})

# Upstream's SRCASM_X for the Arm targets. These are assembled once per bit
# depth like the x86 ones, but with ASOPTS rather than COPTS, so they are kept
# out of SRCS_X and given libraries of their own below.
SRCASM_ARM_X = select({
    "@platforms//cpu:aarch64": [
        "common/aarch64/bitstream-a.S",
        "common/aarch64/cabac-a.S",
        "common/aarch64/dct-a.S",
        "common/aarch64/deblock-a.S",
        "common/aarch64/mc-a.S",
        "common/aarch64/pixel-a.S",
        "common/aarch64/predict-a.S",
        "common/aarch64/quant-a.S",
    ],
    "@platforms//cpu:armv7": [
        "common/arm/bitstream-a.S",
        "common/arm/dct-a.S",
        "common/arm/deblock-a.S",
        "common/arm/mc-a.S",
        "common/arm/pixel-a.S",
        "common/arm/predict-a.S",
        "common/arm/quant-a.S",
    ],
    "//conditions:default": [],
})

# x86_32 support not implemented
SRCASM_X = select({
    "@platforms//cpu:x86_64": [
        "common/x86/dct-64.asm",
        "common/x86/trellis-64.asm",
        "common/x86/bitstream-a.asm",
        "common/x86/const-a.asm",
        "common/x86/cabac-a.asm",
        "common/x86/dct-a.asm",
        "common/x86/deblock-a.asm",
        "common/x86/mc-a.asm",
        "common/x86/mc-a2.asm",
        "common/x86/pixel-a.asm",
        "common/x86/predict-a.asm",
        "common/x86/quant-a.asm",
    ],
    "//conditions:default": [],
})

SRCASM = select({
    "@platforms//cpu:x86_64": ["common/x86/cpu-a.asm"],
    "//conditions:default": [],
})

SRCASM_8 = select({
    "@platforms//cpu:x86_64": ["common/x86/sad-a.asm"],
    "//conditions:default": [],
})

SRCASM_10 = select({
    "@platforms//cpu:x86_64": ["common/x86/sad16-a.asm"],
    "//conditions:default": [],
})

# configure's ASFLAGS, which are never the same thing as CFLAGS. On x86 that is
# obvious because AS is nasm; on the Arm targets configure sets AS=$(CC) but
# still assembles with ASFLAGS, so the .S files there need these too and cannot
# simply ride along in a C target's COPTS. -DPREFIX is what makes asm.S emit the
# Mach-O leading underscore, and -DPIC selects the movrel implementation apple's
# ld can relocate.
ASOPTS = [
    "-w",
    "-DPIC",
] + select({
    "@platforms//cpu:x86_64": ["-DARCH_X86_64=1"],
    "//conditions:default": [],
}) + select({
    ":gnu_like_x86_64": ["-DSTACK_ALIGNMENT=64"],
    "//conditions:default": ["-DSTACK_ALIGNMENT=16"],
}) + select({
    "@platforms//os:macos": ["-DPREFIX"],
    "//conditions:default": [],
})

selects.config_setting_group(
    name = "msvc_like",
    match_any = [
        "@rules_cc//cc/compiler:clang-cl",
        "@rules_cc//cc/compiler:msvc-cl",
    ],
)

selects.config_setting_group(
    name = "gnu_like",
    match_any = [
        "@rules_cc//cc/compiler:clang",
        "@rules_cc//cc/compiler:gcc",
    ],
)

selects.config_setting_group(
    name = "gnu_like_x86_64",
    match_all = [
        ":gnu_like",
        "@platforms//cpu:x86_64",
    ],
)

selects.config_setting_group(
    name = "clang_x86_64",
    match_all = [
        "@rules_cc//cc/compiler:clang",
        "@platforms//cpu:x86_64",
    ],
)

selects.config_setting_group(
    name = "gcc_x86_64",
    match_all = [
        "@rules_cc//cc/compiler:gcc",
        "@platforms//cpu:x86_64",
    ],
)

# configure never puts ARCH_*, SYS_*, STACK_ALIGNMENT or PREFIX in CFLAGS: the
# first two are written into config.h and the last two are assembler-only.
# -DX264_API_EXPORTS is added to CFLAGSSO, which only applies to shared builds.
COPTS = select({
    # /Oy and the vectorizer switch have no cl.exe equivalent worth setting on
    # x86-64, and symbol visibility is governed by the .def-less DLL model.
    ":msvc_like": [
        "/O2",
        "/fp:fast",
    ],
    "//conditions:default": [
        "-O3",
        "-ffast-math",
        "-fomit-frame-pointer",
        "-fno-tree-vectorize",
        "-fvisibility=hidden",
    ],
}) + select({
    ":gnu_like_x86_64": ["-m64"],
    "//conditions:default": [],
}) + select({
    ":clang_x86_64": ["-mstack-alignment=64"],
    ":gcc_x86_64": ["-mpreferred-stack-boundary=6"],
    "//conditions:default": [],
})

ASMHDRS = [
    "common/x86/x86inc.asm",
    "common/x86/x86util.asm",
]

nasm_library(
    name = "x86_asm_all",
    srcs = SRCASM,
    hdrs = ASMHDRS,
    copts = ASOPTS,
    includes = ["common/x86"],
    tags = ["manual"],
)

nasm_library(
    name = "x86_asm_8",
    srcs = SRCASM_X + SRCASM_8,
    hdrs = ASMHDRS,
    copts = ASOPTS + [
        "-DBIT_DEPTH=8",
        "-Dprivate_prefix=x264_8",
    ],
    includes = ["common/x86"],
    tags = ["manual"],
)

nasm_library(
    name = "x86_asm_10",
    srcs = SRCASM_X + SRCASM_10,
    hdrs = ASMHDRS,
    copts = ASOPTS + [
        "-DBIT_DEPTH=10",
        "-Dprivate_prefix=x264_10",
    ],
    includes = ["common/x86"],
    tags = ["manual"],
)

# checkasm assembly defines bit-depth-independent symbols (x264_checkasm_call,
# x264_stack_pagealign, etc.) so it must not use -Dprivate_prefix.
nasm_library(
    name = "checkasm_asm",
    srcs = ["tools/checkasm-a.asm"],
    hdrs = [
        "common/x86/x86inc.asm",
        "common/x86/x86util.asm",
    ],
    copts = ASOPTS,
    includes = ["common/x86"],
    tags = ["manual"],
)

# Everything upstream's install-lib-dev does not install. These are inputs to
# the compile only: pulling them in through implementation_deps keeps generic
# names like common/common.h out of a consumer's include path.
cc_library(
    name = "internal_hdrs",
    hdrs = [
        "x264.h",
        ":x264_config.h",
    ] + glob([
        "common/*.h",
        "common/aarch64/*.h",
        "common/x86/*.h",
        "encoder/*.h",
    ]),
    includes = ["."],
    textual_hdrs = [
        "encoder/cabac.c",
        "encoder/cavlc.c",
        "encoder/rdo.c",
        "encoder/slicetype.c",
    ] + select({
        "@platforms//cpu:aarch64": ["common/aarch64/asm.S"],
        "@platforms//cpu:armv7": ["common/arm/asm.S"],
        "//conditions:default": [],
    }),
)

_INTERNAL_DEPS = [
    ":config",
    ":internal_hdrs",
]

_PTHREAD_LINKOPTS = select({
    "@platforms//os:linux": ["-lpthread"],
    "//conditions:default": [],
})

# The Arm counterparts of the x86_asm_* nasm libraries. configure assembles
# these with the C compiler, so they are cc_library rather than nasm_library,
# but they still take ASOPTS: dropping them into the C targets would compile
# them without -DPREFIX and, on Darwin, emit every symbol without the leading
# underscore the C code references.
cc_library(
    name = "arm_asm",
    srcs = SRCASM_ARM,
    copts = ASOPTS,
    implementation_deps = _INTERNAL_DEPS,
    linkstatic = 1,
)

cc_library(
    name = "arm_asm_8",
    srcs = SRCASM_ARM_X,
    copts = ASOPTS + [
        "-DHIGH_BIT_DEPTH=0",
        "-DBIT_DEPTH=8",
    ],
    implementation_deps = _INTERNAL_DEPS,
    linkstatic = 1,
)

cc_library(
    name = "arm_asm_10",
    srcs = SRCASM_ARM_X,
    copts = ASOPTS + [
        "-DHIGH_BIT_DEPTH=1",
        "-DBIT_DEPTH=10",
    ],
    implementation_deps = _INTERNAL_DEPS,
    linkstatic = 1,
)

# Upstream's OBJS: compiled once, without a bit depth.
cc_library(
    name = "objs",
    srcs = SRCS + select({
        "@platforms//cpu:x86_64": [":x86_asm_all"],
        "//conditions:default": [],
    }),
    copts = COPTS,
    implementation_deps = _INTERNAL_DEPS,
    linkopts = _PTHREAD_LINKOPTS,
    linkstatic = 1,
    visibility = ["//visibility:public"],
    deps = [":arm_asm"],
)

# Upstream's $(SRCS_X:%.c=%-8.o), plus the 8-bit assembly.
cc_library(
    name = "objs_8",
    srcs = SRCS_X + select({
        "@platforms//cpu:x86_64": [":x86_asm_8"],
        "//conditions:default": [],
    }),
    copts = COPTS + [
        "-DHIGH_BIT_DEPTH=0",
        "-DBIT_DEPTH=8",
    ],
    implementation_deps = _INTERNAL_DEPS,
    linkopts = _PTHREAD_LINKOPTS,
    linkstatic = 1,
    visibility = ["//visibility:public"],
    deps = [
        ":arm_asm_8",
        ":objs",
    ],
)

# Upstream's $(SRCS_X:%.c=%-10.o), plus the 10-bit assembly.
cc_library(
    name = "objs_10",
    srcs = SRCS_X + select({
        "@platforms//cpu:x86_64": [":x86_asm_10"],
        "//conditions:default": [],
    }),
    copts = COPTS + [
        "-DHIGH_BIT_DEPTH=1",
        "-DBIT_DEPTH=10",
    ],
    implementation_deps = _INTERNAL_DEPS,
    linkopts = _PTHREAD_LINKOPTS,
    linkstatic = 1,
    visibility = ["//visibility:public"],
    deps = [
        ":arm_asm_10",
        ":objs",
    ],
)

# Upstream's libx264.a. install-lib-dev ships x264.h and x264_config.h, so those
# are the only headers this exports.
cc_library(
    name = "x264",
    srcs = ["encoder/api.c"],
    hdrs = [
        "x264.h",
        ":x264_config.h",
    ],
    copts = COPTS,
    implementation_deps = _INTERNAL_DEPS,
    includes = ["."],
    linkopts = _PTHREAD_LINKOPTS,
    linkstatic = 1,
    visibility = ["//visibility:public"],
    deps = [
        ":objs",
        ":objs_10",
        ":objs_8",
    ],
)

cc_library(
    name = "x264_isystem",
    includes = ["."],
    visibility = ["//visibility:public"],
    deps = [":x264"],
)

# The checkasm assembly must be compiled without BIT_DEPTH so the exported
# symbols (x264_checkasm_call, x264_checkasm_stack_clobber) match the
# hardcoded names in checkasm.c rather than getting a bit-depth prefix.
cc_library(
    name = "checkasm_aarch64_lib",
    srcs = ["tools/checkasm-aarch64.S"],
    copts = ASOPTS,
    implementation_deps = _INTERNAL_DEPS,
    tags = ["manual"],
)

# tools/checkasm.c builds its call_a/call_c wrappers out of GNU statement
# expressions, which cl.exe cannot parse; upstream builds checkasm with a GNU
# compiler on Windows too.
_CHECKASM_COMPATIBLE_WITH = select({
    ":msvc_like": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

# Assembly verification test (checkasm8/checkasm10 in native build)
# Runs on x86_64 and aarch64; verifies SIMD/asm matches C reference
cc_test(
    name = "checkasm8",
    srcs = ["tools/checkasm.c"] + select({
        "@platforms//cpu:x86_64": [":checkasm_asm"],
        "//conditions:default": [],
    }),
    copts = COPTS + [
        "-DHIGH_BIT_DEPTH=0",
        "-DBIT_DEPTH=8",
    ],
    includes = ["."],
    linkopts = select({
        "@platforms//os:linux": ["-lpthread"],
        "//conditions:default": [],
    }),
    target_compatible_with = _CHECKASM_COMPATIBLE_WITH,
    deps = _INTERNAL_DEPS + [":x264"] + select({
        "@platforms//cpu:aarch64": [":checkasm_aarch64_lib"],
        "//conditions:default": [],
    }),
)

cc_test(
    name = "checkasm10",
    srcs = ["tools/checkasm.c"] + select({
        "@platforms//cpu:x86_64": [":checkasm_asm"],
        "//conditions:default": [],
    }),
    copts = COPTS + [
        "-DHIGH_BIT_DEPTH=1",
        "-DBIT_DEPTH=10",
    ],
    includes = ["."],
    linkopts = select({
        "@platforms//os:linux": ["-lpthread"],
        "//conditions:default": [],
    }),
    target_compatible_with = _CHECKASM_COMPATIBLE_WITH,
    deps = _INTERNAL_DEPS + [":x264"] + select({
        "@platforms//cpu:aarch64": [":checkasm_aarch64_lib"],
        "//conditions:default": [],
    }),
)

# checkasm only compares the primitives against their C references, and it
# cannot be built with MSVC. This one runs a few frames through the public
# encoder API, which is what exercises the per-platform pieces: the threading
# backend and the bitstream writer.
cc_test(
    name = "encode_smoke_test",
    size = "small",
    srcs = ["test/encode_smoke_test.c"],
    deps = [":x264"],
)
