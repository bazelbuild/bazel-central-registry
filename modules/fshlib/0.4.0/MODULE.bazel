module(
    name = "fshlib",
    version = "0.4.0",
    bazel_compatibility = [">=7.0.0"],
)

bazel_dep(name = "rules_shell", version = "0.8.0")


bazel_dep(name = "protobuf", version = "34.1")

# Bazel 9 removed the top-level CcInfo symbol, which rules_go < 0.62 still
# references. protobuf pulls in rules_go 0.51 transitively, so pin a version
# that is Bazel 9 clean.
bazel_dep(name = "rules_go", version = "0.63.0")

# Same problem via a different path: protobuf pulls rules_android 0.6.4
# transitively (through rules_jvm_external and rules_kotlin), and 0.6.4 still
# references the bare CcInfo symbol. This surfaces wherever ANDROID_HOME is set
# -- e.g. GitHub Actions runners -- because the androidsdk repository then
# materialises and rules_android gets compiled.
bazel_dep(name = "rules_android", version = "0.7.3")
