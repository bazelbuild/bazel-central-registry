load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

filegroup(
    name = "all",
    srcs = glob(["**"]),
)

cc_library(
    name = "cutlass",
    srcs = [],
    hdrs = glob([
        "include/**/*.h",
        "include/**/*.hpp",
        "include/**/*.inl",
    ]),
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)

# CUTLASS ships reusable kernel headers under examples/ (e.g. example 41, fused
# multi-head attention) that downstream projects include directly -- ONNX
# Runtime's CUDA memory-efficient attention kernels are one such consumer.
# Upstream CMake exposes them by adding ${cutlass_SOURCE_DIR}/examples to the
# include path; the :cutlass target above only covers include/.
cc_library(
    name = "cutlass_examples",
    hdrs = glob([
        "examples/**/*.h",
        "examples/**/*.hpp",
        "examples/**/*.cuh",
    ]),
    strip_include_prefix = "examples",
    visibility = ["//visibility:public"],
)

# The cutlass/util/... headers live under tools/util/include rather than
# include/, so they are also not covered by the :cutlass target. Upstream CMake
# exposes them by adding ${cutlass_SOURCE_DIR}/tools/util/include to the
# include path.
cc_library(
    name = "cutlass_tools_util",
    hdrs = glob([
        "tools/util/include/**/*.h",
        "tools/util/include/**/*.hpp",
    ]),
    strip_include_prefix = "tools/util/include",
    visibility = ["//visibility:public"],
)
