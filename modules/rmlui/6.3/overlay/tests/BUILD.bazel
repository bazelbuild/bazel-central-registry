load("@rules_cc//cc:cc_test.bzl", "cc_test")

# The SVG part of the test runs when RmlUi is built with --@rmlui//:svg_plugin=True.
_LOCAL_DEFINES = select({
    "@rmlui//:svg_plugin_enabled": ["TEST_SVG_PLUGIN"],
    "//conditions:default": [],
})

cc_test(
    name = "rmlui_test",
    srcs = ["rmlui_test.cpp"],
    local_defines = _LOCAL_DEFINES,
    deps = ["@rmlui"],
)

cc_test(
    name = "rmlui_shared_test",
    srcs = ["rmlui_test.cpp"],
    local_defines = _LOCAL_DEFINES,
    deps = ["@rmlui//:rmlui_shared"],
)
