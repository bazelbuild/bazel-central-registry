load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rules_cc//cc:defs.bzl", "cc_library")

expand_template(
    name = "config_h",
    out = "config.h",
    substitutions = {},
    template = "config.h.in",
)

cc_library(
    name = "config",
    hdrs = [":config.h"],
    visibility = ["//visibility:public"],
    deps = ["@rules_autoconf//:config"],
)

alias(
    name = "cairo",
    actual = "//src:cairo",
    visibility = ["//visibility:public"],
)
