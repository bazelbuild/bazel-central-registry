Skip -lpthread for platform-based Android builds; bionic has no libpthread.
"//:android" only matches gflags' legacy --crosstool_top config_setting.

--- bazel/gflags.bzl
+++ bazel/gflags.bzl
@@ -92,6 +92,7 @@
     if threads:
         linkopts += select({
             "//:android": [],
+            "@platforms//os:android": [],
             "@platforms//os:qnx": [],
             "//:x64_windows": [],
             "//conditions:default": ["-lpthread"],
