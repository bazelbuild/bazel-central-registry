"""
A C++17 port of the JavaScript pixelmatch library, providing a small pixel-level image comparison library.

To use, add the following to your MODULE.bazel file:
```
bazel_dep(name = "pixelmatch-cpp17", version = "2.0.0")
```
"""

module(
    name = "pixelmatch-cpp17",
    version = "2.0.0",
    compatibility_level = 1,
)

#
# Build dependencies
#
bazel_dep(name = "platforms", version = "0.0.11")
bazel_dep(name = "rules_cc", version = "0.2.25")

#
# Test dependencies
#
bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True)

#
# Fuzzing dependencies
#
bazel_dep(name = "rules_fuzzing", version = "0.8.0", dev_dependency = True)
