# BoringSSL's crypto target exports openssl/x509.h, not openssl/ssl.h, and jwt.h uses X509_* rather than SSL_*.
# With JWT_DISABLE_PICOJSON, upstream skips the picojson defaults that declare jwt::create, jwt::decode, and
# jwt::verify. Include traits/defaults.h there instead; the overlay points it at nlohmann-json.
diff --git a/include/jwt-cpp/jwt.h b/include/jwt-cpp/jwt.h
--- a/include/jwt-cpp/jwt.h
+++ b/include/jwt-cpp/jwt.h
@@ -19,7 +19,7 @@
 #include <openssl/hmac.h>
 #include <openssl/pem.h>
 #include <openssl/rsa.h>
-#include <openssl/ssl.h>
+#include <openssl/x509.h>
 
 #include <algorithm>
 #include <chrono>
@@ -4261,6 +4261,8 @@ std::ostream& operator<<(std::ostream& os, const jwt::basic_claim<json_traits>&
 
 #ifndef JWT_DISABLE_PICOJSON
 #include "traits/kazuho-picojson/defaults.h"
+#else
+#include "traits/defaults.h"
 #endif
 
 #endif
