"""rules_dart's Gazelle plugin, a module of its own so that rules_dart
brings no Go dependency. Released with rules_dart, at the same version, from
the same source archive; REPO.bazel keeps it out of rules_dart's packages.

    bazel_dep(name = "rules_dart_gazelle_plugin", version = "...")

    gazelle_binary(
        name = "gazelle_bin",
        languages = ["@rules_dart_gazelle_plugin//dart"],
    )
"""

# The version is left unset for the reason given in rules_dart's MODULE.bazel:
# publish-to-bcr patches it in.
module(
    name = "rules_dart_gazelle_plugin",
    bazel_compatibility = [">=9.0.0"],
    version = "0.9.1",
)

bazel_dep(name = "gazelle", version = "0.54.0", repo_name = "bazel_gazelle")
bazel_dep(name = "package_metadata", version = "0.0.15")
bazel_dep(name = "rules_go", version = "0.64.2", repo_name = "io_bazel_rules_go")

# build.yaml is read with a YAML parser, to carry builder options into the
# codegen targets' `config` exactly as build_runner would read them.
go_deps = use_extension("@bazel_gazelle//:extensions.bzl", "go_deps")
go_deps.module(
    path = "go.yaml.in/yaml/v3",
    sum = "h1:zcDfvjXEqTQmpjniUBLc91xYJMB2c4QOFxEF/LCEckM=",
    version = "v3.0.6",
)
use_repo(go_deps, "in_yaml_go_yaml_v3")
