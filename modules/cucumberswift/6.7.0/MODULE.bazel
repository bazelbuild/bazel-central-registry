# No version here: the Bazel Central Registry entry for each release sets it.
module(
    name = "cucumberswift",
    # REPO.bazel's ignore_directories, and rules_swift, need Bazel 8.
    bazel_compatibility = [">=8.0.0"],
    version = "6.7.0",
)

bazel_dep(name = "apple_support", version = "2.9.1")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_swift", version = "4.1.2")
# At least the version Package.swift starts from (CI checks this).
bazel_dep(name = "cucumberswift_expressions", version = "1.4.2")
