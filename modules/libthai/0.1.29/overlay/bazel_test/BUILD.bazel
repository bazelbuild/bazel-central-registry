load("@rules_cc//cc:cc_test.bzl", "cc_test")

[cc_test(
    name = "test_" + name,
    size = "small",
    srcs = ["@libthai//:tests/test_" + name + ".c"],
    linkstatic = True,
    deps = ["@libthai"],
) for name in [
    "thctype",
    "thcell",
    "thinp",
    "thrend",
    "thstr",
    "thwchar",
]]

cc_test(
    name = "dictionary_runfiles",
    size = "small",
    srcs = ["dictionary_runfiles.cc"],
    args = ["$(rlocationpath @libthai//:dictionary)"],
    data = ["@libthai//:dictionary"],
    env = {"LIBTHAI_DICTDIR": "/nonexistent"},
    linkstatic = True,
    deps = [
        "@libdatrie",
        "@libthai",
        "@rules_cc//cc/runfiles",
    ],
)

cc_test(
    name = "dictionary_default",
    size = "small",
    srcs = ["dictionary_default.c"],
    linkstatic = True,
    deps = ["@libthai//:thai"],
)

cc_test(
    name = "dictionary_default_dynamic",
    size = "small",
    srcs = ["dictionary_default.c"],
    linkstatic = False,
    deps = ["@libthai//:thai"],
)
