"""rules_tcl"""

module(
    name = "rules_tcl",
    version = "0.7.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_batch", version = "0.0.1")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_venv", version = "0.23.0")
bazel_dep(name = "rules_req_compile", version = "1.1.3")
bazel_dep(name = "tcl_lang", version = "9.0.2.bcr.1")

tcllib_ext = use_extension("//tcl:extensions.bzl", "tcllib")
use_repo(tcllib_ext, "tcllib")

requirements = use_extension("@rules_req_compile//extensions:python.bzl", "requirements")
requirements.parse(
    name = "tcl_pip_deps",
    requirements_locks = {
        "//tools/requirements:requirements_linux_aarch64.txt": "//tools/requirements:linux_aarch64",
        "//tools/requirements:requirements_linux_x86_64.txt": "//tools/requirements:linux_x86_64",
        "//tools/requirements:requirements_macos_aarch64.txt": "//tools/requirements:macos_aarch64",
        "//tools/requirements:requirements_windows_x86_64.txt": "//tools/requirements:windows_x86_64",
    },
)
use_repo(requirements, "tcl_pip_deps")

register_toolchains(
    "//tcl/toolchain",
)

nagelfar = use_extension("//tcl/nagelfar:extensions.bzl", "nagelfar")
use_repo(nagelfar, "nagelfar")

register_toolchains(
    "//tcl/nagelfar/toolchain",
)

tclint_ext = use_extension("//tcl/tclint:extensions.bzl", "tclint")
tclint_ext.toolchain()
use_repo(tclint_ext, "tclint_toolchains")

register_toolchains(
    "@tclint_toolchains//:all",
)

bazel_dep(name = "stardoc", version = "0.8.0", dev_dependency = True)
bazel_dep(name = "rules_rust_mdbook", version = "0.73.0", dev_dependency = True)

register_toolchains(
    "//tools/toolchains:black_toolchain",
    "//tools/toolchains:isort_toolchain",
    "//tools/toolchains:mypy_toolchain",
    "//tools/toolchains:pylint_toolchain",
    dev_dependency = True,
)
