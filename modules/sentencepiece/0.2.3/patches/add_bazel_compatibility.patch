Adds the bazel_compatibility constraint the Bazel Central Registry requires
for modules that ship overlay files (here: the bcr_tests test module).

--- a/MODULE.bazel
+++ b/MODULE.bazel
@@ -1,6 +1,7 @@
 module(
     name = "sentencepiece",
     version = "0.2.3",
+    bazel_compatibility = [">=8.0.0"],
 )
 
 bazel_dep(name = "platforms", version = "1.1.0")
