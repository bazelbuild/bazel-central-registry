"""Builds libsepol (SELinux policy library) from the upstream release tarball."""

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["src/libsepol.map.in"])

# Quote-includes reachable from cil_lexer.l. The generated .c is not a sibling of
# cil/src, so copy this fixed 3.5 set beside it instead of publishing cil/src.
_CIL_LEXER_HDRS = [
    "cil_flavor.h",
    "cil_internal.h",
    "cil_lexer.h",
    "cil_list.h",
    "cil_log.h",
    "cil_mem.h",
    "cil_symtab.h",
    "cil_tree.h",
]

genrule(
    name = "cil_lexer_src",
    srcs = ["cil/src/cil_lexer.l"] + ["cil/src/" + hdr for hdr in _CIL_LEXER_HDRS],
    outs = ["cil_lexer.c"] + _CIL_LEXER_HDRS,
    cmd = "M4=$(M4) $(FLEX) --outfile=$(execpath cil_lexer.c) $(execpath cil/src/cil_lexer.l) && cp " + " ".join(["$(execpath cil/src/%s)" % hdr for hdr in _CIL_LEXER_HDRS]) + " $(RULEDIR)/",
    toolchains = [
        "@rules_flex//flex:current_flex_toolchain",
        "@rules_m4//m4:current_m4_toolchain",
    ],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "libsepol",
    srcs = glob([
        "src/*.c",
        "src/*.h",
        "cil/src/*.c",
        "cil/src/*.h",
    ]) + [":cil_lexer_src"],
    hdrs = glob([
        "include/sepol/**/*.h",
        "cil/include/cil/*.h",
    ]),
    additional_compiler_inputs = ["sepol_compat.h"],
    copts = [
        "-include",
        "$(execpath sepol_compat.h)",
    ],
    includes = [
        "cil/include",
        "include",
        "include/sepol",
    ],
    local_defines = ["_GNU_SOURCE"],
)
