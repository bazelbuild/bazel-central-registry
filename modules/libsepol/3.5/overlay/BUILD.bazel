"""Builds libsepol (SELinux policy library) from the upstream release tarball."""

load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["src/libsepol.map.in"])

genrule(
    name = "cil_lexer_src",
    srcs = ["cil/src/cil_lexer.l"],
    outs = ["cil_lexer.c"],
    cmd = "M4=$(M4) $(FLEX) --outfile=$@ $<",
    toolchains = [
        "@rules_flex//flex:current_flex_toolchain",
        "@rules_m4//m4:current_m4_toolchain",
    ],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "libsepol",
    srcs = glob([
        "src/*.c",
        "src/*.h",
        "cil/src/*.c",
        "cil/src/*.h",
    ]) + [":cil_lexer_src"],
    hdrs = glob([
        "include/sepol/**/*.h",
        "cil/include/cil/*.h",
    ]),
    additional_compiler_inputs = ["sepol_compat.h"],
    copts = [
        "-include",
        "$(execpath sepol_compat.h)",
    ],
    includes = [
        "cil/include",
        "cil/src",
        "include",
        "include/sepol",
    ],
    local_defines = ["_GNU_SOURCE"],
)
