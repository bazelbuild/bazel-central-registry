pc/popen.c: call the C runtime's _popen and _pclose by their own names.

gawk's MinGW port wraps the runtime's popen/pclose in os_popen/os_pclose:
pc/popen.h renames the pair to the wrappers for the rest of the program, and
pc/popen.c undefines those macros to reach the runtime's functions. Current
mingw-w64 headers no longer declare popen and pclose as functions; stdio.h
spells them as macros for _popen and _pclose, so popen.c's #undef removes
the only spelling it had and the calls become undeclared functions (an error
under clang). _popen and _pclose are the runtime's real names on every
MinGW and MSVC runtime, so the wrappers call those.

--- pc/popen.c
+++ pc/popen.c
@@ -233,7 +233,7 @@
     strncpy(curmode, mode, 3); curmode[3] = '\0';
 
 #if defined(__MINGW32__)
-    current = popen(command, mode);
+    current = _popen(command, mode);
     cur = fileno(current);
     strcpy(pipes[cur].pmode, curmode);
     return(current);
@@ -279,7 +279,7 @@
     int fd, rval;
 
 #if defined(__MINGW32__)
-    rval = pclose(current);
+    rval = _pclose(current);
     *pipes[cur].pmode = '\0';
     return rval;
 #endif
