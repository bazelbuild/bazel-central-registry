load(":autoconf.bzl", "autoconf_targets")

# The targets of configure.ac and the Makefile.am files, declared by the generated
# autoconf.bzl beside this file; this file is hand-written and kept as it is.  A target
# added below is the module's own; one named like a generated target replaces it at the
# next conversion.
autoconf_targets()

# The dynamic extensions gawk loads at run time (the `*_shared` targets are the
# shared libraries; the plain names are their static libraries), for gawk_tool.
filegroup(
    name = "all_builtin_extensions",
    srcs = [
        ":filefuncs_shared",
        ":fnmatch_shared",
        ":fork_shared",
        ":inplace_shared",
        ":intdiv_shared",
        ":ordchr_shared",
        ":readdir_shared",
        ":readfile_shared",
        ":revoutput_shared",
        ":revtwoway_shared",
        ":rwarray_shared",
        ":time_shared",
    ],
    visibility = ["//visibility:public"],
)

# The sub-configure asks for MPFR on its own, which the converter renders as a second `mpfr`
# flag; replace it with the root's so one --@gawk//:mpfr drives the interpreter and the
# extensions alike.
alias(
    name = "mpfr",
    actual = "//:mpfr",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "mpfr_enabled",
    flag_values = {"//:mpfr": "True"},
    visibility = ["//:__subpackages__"],
)
