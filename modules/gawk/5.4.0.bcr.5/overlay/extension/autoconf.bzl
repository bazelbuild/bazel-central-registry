                        [
                            "mpfr_t p;",
                            "mpz_t z;",
                            "mpfr_init(p);",
                            "mpz_init(z);",
                            "mpfr_printf(\"%Rf%Zd\", p, z);",
                            "mpfr_clear(p);",
                            "mpz_clear(z);",
                        ],
                    ),
                ),
            ],
            "//conditions:default": [],
        }),
        visibility = ["//:__subpackages__"],
        deps = [
            "@rules_cc_autoconf//autoconf/macros/AC_CANONICAL_BUILD",
            "@rules_cc_autoconf//autoconf/macros/AC_CANONICAL_HOST",
            "@rules_cc_autoconf//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
            "@rules_cc_autoconf//autoconf/macros/AC_CONFIG_AUX_DIR_DEFAULT",
            "@rules_cc_autoconf//autoconf/macros/AC_C_INLINE",
            "@rules_cc_autoconf//autoconf/macros/AC_SYS_LARGEFILE",
            "@rules_cc_autoconf//autoconf/macros/AC_USE_SYSTEM_EXTENSIONS",
