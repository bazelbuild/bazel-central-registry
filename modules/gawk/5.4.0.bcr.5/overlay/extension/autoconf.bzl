    autoconf(
        name = "gnulib/m4/iconv/AM_ICONV_LINK",
        checks = [

            # First try without libiconv, then with libiconv
            checks.AC_TRY_LINK(
                name = "_am_cv_func_iconv",
                code = utils.AC_LANG_PROGRAM(
                    [
                        "#include <iconv.h>",
                        "#include <stdlib.h>",
                    ],
