                subst = True,  # Also create substitution variable for gnulib generated <iconv.h>
            ),
        ],
        default_deps = [":gnulib/m4/iconv_h/defaults"],
        visibility = ["//:__subpackages__"],
        deps = [
            ":gnulib/m4/iconv/AM_ICONV_LINK",
