load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files([
    "LICENSE",
    "examples/arrays.safetensors",
])

cc_library(
    name = "mlx-c",
    srcs = glob(
        ["mlx/c/*.cpp"],
        exclude = ["mlx/c/object.cpp"],
    ) + glob(["mlx/c/private/*.h"]),
    hdrs = glob(["mlx/c/*.h"]),
    cxxopts = ["-std=c++20"],
    deps = ["@mlx"],
)

alias(
    name = "mlxc",
    actual = ":mlx-c",
)

[
    cc_binary(
        name = example,
        srcs = ["examples/{}.c".format(example)],
        deps = [":mlx-c"],
    )
    for example in [
        "example",
        "example-closure",
        "example-export",
        "example-float64",
        "example-grad",
        "example-graph",
        "example-metal-kernel",
        "example-ops",
        "example-stream-tls",
        "example-thread-stream",
    ]
]

cc_binary(
    name = "example-gguf",
    srcs = ["examples/example-gguf.c"],
    deps = [":mlx-c"],
)

cc_binary(
    name = "example-safe-tensors",
    srcs = ["examples/example-safe-tensors.c"],
    data = ["examples/arrays.safetensors"],
    deps = [":mlx-c"],
)
