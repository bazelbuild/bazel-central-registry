load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Run the upstream examples as smoke tests.
[
    sh_test(
        name = example + "_test",
        size = "small",
        srcs = ["run_example.sh"],
        args = ["$(rootpath @mlx-c//:{})".format(example)],
        data = ["@mlx-c//:" + example],
    )
    for example in [
        "example",
        "example-float64",
        "example-gguf",
        "example-graph",
        "example-ops",
        "example-stream-tls",
        "example-thread-stream",
    ]
]

# These examples use the GPU stream unconditionally.
[
    sh_test(
        name = example + "_test",
        size = "small",
        srcs = ["run_example.sh"],
        args = ["$(rootpath @mlx-c//:{})".format(example)],
        data = ["@mlx-c//:" + example],
        target_compatible_with = [
            "@platforms//os:macos",
            "@platforms//cpu:aarch64",
        ],
    )
    for example in [
        "example-closure",
        "example-export",
        "example-grad",
        "example-metal-kernel",
    ]
]

sh_test(
    name = "example-safe-tensors_test",
    size = "small",
    srcs = ["run_example.sh"],
    args = [
        "$(rootpath @mlx-c//:example-safe-tensors)",
        "$(rootpath @mlx-c//:examples/arrays.safetensors)",
    ],
    data = [
        "@mlx-c//:example-safe-tensors",
        "@mlx-c//:examples/arrays.safetensors",
    ],
)
