module(
    name = "hdlf_rules_netlist",
    version = "0.0.1",
    bazel_compatibility = [">=8.0.0"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")

# This module's helpers (the launcher, the stub and checker of swap_test)
# and its development tools are Go, built from source. They are pure Go,
# so a user of the module needs no C++ toolchain for them; rules_go brings
# its own Go SDK.
bazel_dep(name = "rules_go", version = "0.64.2")

# skidl_netlist's netlist feeds hdlf_rules_kicad's kicad_pcb(netlist = ...),
# and netlist_parity_test reads hdlf_rules_kicad's boards; KiCad runs only
# through hdlf_rules_kicad's toolchain. It comes from the filmil registry
# (.bazelrc); a published release names it by version, with no override.
bazel_dep(name = "hdlf_rules_kicad", version = "0.0.1")

# The KiCad symbol libraries SKiDL reads (KICAD9_SYMBOL_DIR): the same
# pinned libraries hdlf_rules_kicad's rules use.
kicad = use_extension("@hdlf_rules_kicad//kicad:extensions.bzl", "kicad")
use_repo(kicad, "kicad_libs")

# SKiDL runs on rules_python's hermetic CPython, with wheels locked with
# their hashes in requirements_lock.txt (`bazel run
# //tools:requirements.update` writes it from requirements.in). pip.parse
# takes binary wheels only, so a missing wheel fails the fetch instead of
# compiling on the host. SKiDL, kinet2pcb and hierplace have no wheels on
# PyPI; theirs are built once and mirrored (tools/mirror, issue #9).
bazel_dep(name = "rules_python", version = "2.4.6")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    # Registers the 3.12 interpreter. Not the default: that is the root
    # module's choice. The SKiDL runner picks 3.12 by its python_version.
    is_default = False,
    python_version = "3.12",
)

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    download_only = True,
    hub_name = "netlist_pip",
    python_version = "3.12",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "netlist_pip")

# The helpers toolchain, which every rule that runs a tool needs.
register_toolchains(
    "//netlist/toolchains:helpers",
    # The SKiDL runner and its stub twin (issue #9).
    "//netlist/toolchains:skidl",
    "//netlist/toolchains:skidl_stub",
    # Last, so they are picked only off Linux x86_64 (spec P1).
    "//netlist/toolchains:unsupported",
    "//netlist/toolchains:skidl_unsupported",
)

# The demonstration tools of the swap test template
# (netlist/private/swapdemo) and of determinism_test's own tests
# (netlist/private/detdemo).
register_toolchains(
    "//netlist/private/swapdemo:all",
    "//netlist/private/detdemo:all",
    dev_dependency = True,
)

# stardoc renders through Java and protobuf. Protobuf 34.1 and later bring a
# prebuilt protoc (enabled in .bazelrc), so the documentation build compiles
# no C++ and needs no C++ toolchain. Dev only: it raises the version stardoc
# would otherwise pick.
bazel_dep(name = "protobuf", version = "36.2", dev_dependency = True)

# Bazel's Java launcher (used by stardoc) asks for a C++ toolchain even when
# nothing compiles C++, and .bazelrc turns off host toolchain detection. zig's
# toolchain is one self-contained binary, so it reads nothing from the host.
# Dev only: a user of the module brings its own C++ toolchain if it needs one.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0", dev_dependency = True)

zig_toolchains = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
    dev_dependency = True,
)
use_repo(zig_toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain:linux_amd64_gnu.2.31",
    dev_dependency = True,
)

bazel_dep(name = "bazel_lib", version = "3.7.2", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "10.1.0", dev_dependency = True)
bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)
