module(
    name = "gavel_tools",
    version = "0.4.1",
    bazel_compatibility = [">=9.0.0"],
    compatibility_level = 1,
)

# The published module flips this to True (.github/ci/release_prep.sh, archive
# only, never in git): releases ship prebuilt gavel-lint binaries, so the Go
# toolchain bits used to build them stay out of consumers' module graph.
IS_RELEASE = True

# The core imposes no language ruleset on consumers: each language lives in its
# own module (modules/<lang>) that depends on this one plus only its own ruleset
# and linter binaries. rules_go is here only to build gavel-lint from source and to
# run this repo's Go tests, so a release (IS_RELEASE) leaves it out of the graph.
bazel_dep(name = "rules_go", version = "0.60.0", dev_dependency = IS_RELEASE)
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "gazelle", version = "0.50.0", dev_dependency = IS_RELEASE)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = IS_RELEASE)
go_sdk.download(version = "1.25.13")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = IS_RELEASE)
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_stretchr_testify",
    "in_gopkg_yaml_v3",
)

# gavel-lint, the one helper binary every aspect runs, behind a gavel-owned
# toolchain type: prebuilt per platform when IS_RELEASE, built from source otherwise.
gavel_lint = use_extension("//lint/toolchain:extensions.bzl", "gavel_lint")
gavel_lint.configure(prebuilt = IS_RELEASE)
use_repo(gavel_lint, "gavel_lint_toolchains")

register_toolchains("@gavel_lint_toolchains//:all")

# The language modules are dev dependencies only so catalog_test can read their
# aspects and MODULE.bazel files (the module graph is cyclic by design: each
# depends back on us). Consumers add the ones for the languages they lint.
bazel_dep(name = "gavel_tools_go", version = "0.4.1", dev_dependency = True)
bazel_dep(name = "gavel_tools_java", version = "0.4.1", dev_dependency = True)
bazel_dep(name = "gavel_tools_python", version = "0.4.1", dev_dependency = True)
bazel_dep(name = "gavel_tools_typescript", version = "0.4.1", dev_dependency = True)
bazel_dep(name = "gavel_tools_web", version = "0.4.1", dev_dependency = True)
bazel_dep(name = "gavel_tools_rust", version = "0.4.1", dev_dependency = True)
bazel_dep(name = "gavel_tools_rust_rs", version = "0.4.1", dev_dependency = True)

local_path_override(
    module_name = "gavel_tools_go",
    path = "modules/go",
)

local_path_override(
    module_name = "gavel_tools_java",
    path = "modules/java",
)

local_path_override(
    module_name = "gavel_tools_python",
    path = "modules/python",
)

local_path_override(
    module_name = "gavel_tools_typescript",
    path = "modules/typescript",
)

local_path_override(
    module_name = "gavel_tools_web",
    path = "modules/web",
)

local_path_override(
    module_name = "gavel_tools_rust",
    path = "modules/rust",
)

local_path_override(
    module_name = "gavel_tools_rust_rs",
    path = "modules/rust_rs",
)
