# julia_depot: a Julia environment pinned to a committed Manifest.toml, as Bazel
# repositories and scripts. See README.md for the contract and the consumer interface.
#
# compatibility_level is declared, and starts at 1, because the consumer interface here
# is small and entirely explicit. A change to any of it breaks every consumer at once, so
# it is worth being able to say so in the module graph. Raise it when one of these
# changes incompatibly, not when behaviour is added:
#
#   - the `julia` extension's tag classes (dist, depot) and their attributes
#   - the rules and functions in julia/image.bzl, their attributes and JuliaImageEnvInfo,
#     and the names PORTABLE_X86_64_CPU_TARGET and PORTABLE_AARCH64_CPU_TARGET (their
#     values may gain CPU clones in any release, as Julia's official builds do)
#   - what a depot repository provides: its default target, :env, env.sh (which exports
#     JULIA_DEPOT_PATH and nothing else) and stamp.txt with its keys manifest_sha256,
#     julia_version, host_triplet and depot
#   - what a dist repository provides: its default target, :dist and bin/julia
#   - the arguments and RULES_JULIA_DEPOT_* variables of image_depot.sh and sysimage.sh,
#     and what a hook is given
#
# Internal, and free to change in any release: julia/dist.bzl and julia/depot.bzl (use the
# extension, which also checks repository names across the graph, rather than loading
# their rules with use_repo_rule), and the scripts instantiate.sh and image_layers.sh.
#
# Bazel 9 is the only version this is built and tested with.
module(
    name = "julia_depot",
    version = "0.1.0",
    bazel_compatibility = [">=9.0.0"],
    compatibility_level = 1,
)

# The CPU constraints the image rules read to pick a portable CPU target list for the target
# platform (x86_64 or aarch64).
bazel_dep(name = "platforms", version = "1.0.0")
