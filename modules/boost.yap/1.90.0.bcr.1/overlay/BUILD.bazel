load("@rules_cc//cc:cc_library.bzl", "cc_library")

# The private headers under detail/ are pulled in from the middle of the public
# ones and rely on declarations their includer provides first, so they are not
# self-contained.
_TEXTUAL_HDRS = glob(["include/boost/yap/detail/**/*.hpp"])

cc_library(
    name = "boost.yap",
    hdrs = glob(["include/**/*.hpp"], exclude = _TEXTUAL_HDRS),
    features = ["parse_headers"],
    includes = ["include"],
    textual_hdrs = _TEXTUAL_HDRS,
    visibility = ["//visibility:public"],
    deps = [
        "@boost.hana",
        "@boost.preprocessor",
        "@boost.type_index",
    ],
)
