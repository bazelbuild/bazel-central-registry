load(":autoconf.bzl", "autoconf_targets")

# The targets of configure.ac and the Makefile.am files, declared by the generated
# autoconf.bzl beside this file; this file is hand-written and kept as it is.  A target
# added below is the module's own; one named like a generated target replaces it at the
# next conversion.
autoconf_targets()

# The library's name under the previous hand-written overlay.
alias(
    name = "libpatch",
    actual = ":lib/patch",
    visibility = ["//visibility:public"],
)

# A smoke test that the binary links and starts on every presubmit platform
# (the module has no test targets; `--help` exits 0 and prints the usage).
genrule(
    name = "patch_help",
    testonly = True,
    outs = ["patch_help.txt"],
    cmd = "$(execpath :patch) --help > $@ 2>&1",
    cmd_bat = "$(execpath :patch) --help > $@ 2>&1",
    tools = [":patch"],
)
