                "lib/close.c": "GL_COND_OBJ_CLOSE",
                "lib/closedir.c": "GL_COND_OBJ_CLOSEDIR",
                "lib/dirfd.c": "GL_COND_OBJ_DIRFD",
                "lib/dup.c": "GL_COND_OBJ_DUP",
                "lib/dup2.c": "GL_COND_OBJ_DUP2",
                "lib/euidaccess.c": "GL_COND_OBJ_EUIDACCESS",
                "lib/faccessat.c": "GL_COND_OBJ_FACCESSAT",
                "lib/fchdir.c": "GL_COND_OBJ_FCHDIR",
                "lib/fchmodat.c": "GL_COND_OBJ_FCHMODAT",
                "lib/fchown-stub.c": "GL_COND_OBJ_FCHOWN_STUB",
                "lib/fchownat.c": "GL_COND_OBJ_FCHOWNAT",
                "lib/fcntl.c": "GL_COND_OBJ_FCNTL",
                "lib/fdopendir.c": "GL_COND_OBJ_FDOPENDIR",
                "lib/fpending.c": "GL_COND_OBJ_FPENDING",
                "lib/free.c": "GL_COND_OBJ_FREE",
                "lib/fseek.c": "GL_COND_OBJ_FSEEK",
                "lib/fseeko.c": "GL_COND_OBJ_FSEEKO",
                "lib/fstat.c": "GL_COND_OBJ_FSTAT",
                "lib/fstatat.c": "GL_COND_OBJ_FSTATAT",
