                "lib/getopt.c": "GL_COND_OBJ_GETOPT",
                "lib/getopt1.c": "GL_COND_OBJ_GETOPT",
                "lib/getprogname.c": "GL_COND_OBJ_GETPROGNAME",
                "lib/getrandom.c": "GL_COND_OBJ_GETRANDOM",
                "lib/gettimeofday.c": "GL_COND_OBJ_GETTIMEOFDAY",
                "lib/group-member.c": "GL_COND_OBJ_GROUP_MEMBER",
                "lib/lc-charset-dispatch.c": "GL_COND_OBJ_LC_CHARSET_DISPATCH",
                "lib/lchmod.c": "GL_COND_OBJ_LCHMOD",
                "lib/lchown.c": "GL_COND_OBJ_LCHOWN",
                "lib/lseek.c": "GL_COND_OBJ_LSEEK",
                "lib/lstat.c": "GL_COND_OBJ_LSTAT",
                "lib/malloc.c": "GL_COND_OBJ_MALLOC",
