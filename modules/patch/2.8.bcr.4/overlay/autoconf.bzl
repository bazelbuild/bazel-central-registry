def autoconf_targets():
    """The targets configure.ac and the Makefile.am files describe, in the package that calls this."""

    native.exports_files(["COPYING"])

    license(
        name = "license_COPYING",
        kind = "@package_metadata//licenses/spdx:GPL-3.0-or-later",
        text = "COPYING",
        visibility = ["//visibility:private"],
    )

    package_metadata(
        name = "package_metadata",
        attributes = [":license_COPYING"],
        purl = purl.bazel(
            native.module_name(),
            native.module_version(),
        ),
        visibility = ["//visibility:private"],
    )

    autoconf_package_info(
        name = "package",
        package_name = "GNU patch",
        aliases = {
            "PACKAGE": "PACKAGE_TARNAME",
            "VERSION": "PACKAGE_VERSION",
        },
        module_bazel = "//:MODULE.bazel",
        package_bugreport = "bug-patch@gnu.org",
        package_tarname = "patch",
        package_url = "https://www.gnu.org/software/patch/",
        strip_bcr_version = True,
        visibility = ["//visibility:private"],
    )

    bool_flag(
        name = "gcc_warnings",
        build_setting_default = False,
        visibility = ["//visibility:public"],
    )

    native.config_setting(
        name = "gcc_warnings_enabled",
        flag_values = {
            ":gcc_warnings": "True",
        },
        visibility = ["//visibility:private"],
    )

    autoconf(
        name = "autoconf_1",
        checks = [
            checks.AC_SUBST(
                "GNULIB_UNISTD_H_GETOPT",
                1,
                requires = ["REPLACE_GETOPT!=0"],
            ),
        ] + macros.AC_CHECK_HEADERS(
