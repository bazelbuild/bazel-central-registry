    cc_gnulib_conditional_hdrs(
        name = "lib/patch_gnulib_conditional_hdrs",
        hdrs = {
            ":lib_{}_h_processed".format(stem.replace("-", "_")): "GL_GENERATE_{}_H".format(stem.upper().replace("-", "_"))
            for stem in GNULIB_COND_HDR_STEMS
        },
        strip_include_prefix = "_gnulib_cond",
        visibility = ["//visibility:private"],
        deps = [":autoconf"],
    )

    cc_library(
        name = "lib/patch_gnulib_generated_hdrs",
        hdrs = PATCH_GENERATED_HDRS.keys(),
        strip_include_prefix = "lib/_gnulib_gen",
        visibility = ["//visibility:private"],
    )

    cc_library(
        name = "lib/patch_private_headers",
        hdrs = native.glob(
            ["lib/**/*.h"],
            # The templates are inputs of the autoconf_hdr targets, not headers.
            exclude = ["lib/**/*.in.h"],
        ),
        include_prefix = ".",
        includes = ["lib"],
        strip_include_prefix = "/",
        visibility = ["//visibility:private"],
        deps = [
            ":config_headers",
            ":lib/patch_gnulib_conditional_hdrs",
            ":lib/patch_gnulib_generated_hdrs",
        ],
    )

    autoconf_srcs(
        name = "lib/patch_gnulib_conditional_srcs",
        srcs = {
            src: SRC_CONDITIONS[name]
            for src, name in {
