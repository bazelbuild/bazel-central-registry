                    [
                        "int n = 1;",
                        "char a[n];",
                        "a[0] = 0;",
                        "return a[0];",
                    ],
                ),
                compile_defines = SYSTEM_EXTENSIONS,
                define = "HAVE_C_VARARRAYS",
            ),
            checks.AC_DEFINE("GNULIB_NO_VLA", 1),
        ] + macros.AC_CHECK_FUNCS(
            [
                "geteuid",
                "getuid",
                "sigaction",
                "sigfillset",
