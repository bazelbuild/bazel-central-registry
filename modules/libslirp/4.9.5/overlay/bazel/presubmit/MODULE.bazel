module(name = "libslirp_presubmit")

bazel_dep(name = "libslirp", version = "4.9.5")
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")

# Match the QEMU consumer's Windows x86-64 toolchain and response-file fix.
single_version_override(
    module_name = "hermetic_cc_toolchain",
    version = "4.3.0",
    patch_strip = 1,
    patches = ["//:zig-windows-params.patch"],
)

zig = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains")
use_repo(zig, "zig_sdk")
register_toolchains("@zig_sdk//toolchain:windows_amd64")

local_path_override(module_name = "libslirp", path = "../..")
