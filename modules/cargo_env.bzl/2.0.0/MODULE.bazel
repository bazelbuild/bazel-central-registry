module(name = "cargo_env.bzl",
    version = "2.0.0",
)

# keep-sorted start
bazel_dep(name = "bazel_lib", version = "3.8.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "package_metadata", version = "0.0.15")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_shell", version = "0.10.0")
# keep-sorted end

# keep-sorted start
bazel_dep(name = "aspect_gazelle_prebuilt", version = "0.0.29", dev_dependency = True)
bazel_dep(name = "bazelrc-preset.bzl", version = "1.10.0", dev_dependency = True)
# keep-sorted end

local_repository = use_repo_rule("@bazel_tools//tools/build_defs/repo:local.bzl", "local_repository")

local_repository(
    name = "cargo_env_test_headers",
    dev_dependency = True,
    path = "cargo_env/tests/external_headers",
)
