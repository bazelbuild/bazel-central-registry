# uchar.h: on macOS the `c32rtomb` port answers HAVE_C32RTOMB=1 from a
# deployment-target check, but libSystem has no c32rtomb at all, and
# lib/regex_internal.h:161 calls it as `__wcrtomb`.  With that answer the
# template would neither declare the function nor (see SRC_CONDITIONS) let
# lib/c32rtomb.c define it.  gnulib's own declaration is the same prototype as
# any libc's, so it is emitted unconditionally, which is what gnulib itself
# does wherever HAVE_C32RTOMB is 0.
LIB_HDR_SUBSTITUTIONS = {
    "uchar": {
        "#  if !@HAVE_C32RTOMB@": "#  if 1 /* !@HAVE_C32RTOMB@, see BUILD.bazel */",
    },
}

