# The three headers whose port does not publish a `GL_GENERATE_*_H` get the
# shell test from their m4 file instead: glob_h.m4:19 with the
# gl_REPLACE_GLOB_H arm of glob.m4:172, stdbit_h.m4:15-25 (the replacement is
# wanted when there is no <stdbit.h> or when the system one predates C2y's
# stdc_rotate_left_uc; the stdc_*.c sources below share the test) and
# stdcountof_h.m4:47.
STDBIT_H_CONDITION = "ac_cv_subst_HAVE_STDBIT_H==0 || ac_cv_define_HAVE_DECL_STDC_ROTATE_LEFT_UC==0"

GNULIB_HDR_CONDITIONS = {
    "glob": "!ac_cv_header_glob_h || !ac_cv_define_HAVE_GLOB || ac_cv_subst_REPLACE_GLOB==1",
    "stdbit": STDBIT_H_CONDITION,
    "stdcountof": "!(ac_cv_subst_HAVE_STDCOUNTOF_H==1 && ac_cv_subst_CXX_HAVE_STDCOUNTOF_H==1)",
}

cc_gnulib_conditional_hdrs(
    name = "gnulib_conditional_hdrs",
    hdrs = {
        ":lib_{}_h_processed".format(stem): GNULIB_HDR_CONDITIONS.get(
            stem,
            "GL_GENERATE_{}_H".format(stem.upper()),
