# Platform note.  Upstream builds on Windows only under mingw or cygwin
# (configure.ac:36-43), and the registry's Windows toolchains are MSVC-based,
# which gnulib's mingw branches do not compile under.  The sources gnulib
# compiles only there -- the winsock replacements (accept.c, socket.c, ...),
# windows-*.c, stat-w32.c, setlocale-fixes.c, stdio-consolesafe.c,
# msvc-inval.c, msvc-nothrow.c and os2-spawn.c -- are therefore not carried,
# and neither is the `netinet/in.h` template.  The presubmit matrix leaves
# Windows out for the same reason.
cc_library(
    name = "gnulib",
    srcs = GNULIB_SRCS + [
        ":gnulib_conditional_srcs",
    ],
    hdrs = glob(["lib/**/*.h"]) + LIB_GENERATED_TARGETS + GL_SED_HDR_TARGETS,
    copts = COPTS,
    includes = ["lib"],
    local_defines = LOCAL_DEFINES,
    textual_hdrs = GNULIB_TEXTUAL_HDRS,
    # Private, as upstream's noinst libgnu.la is; the unit tests link it the
    # way unit-tests/Makefile.am:45 does.
    visibility = ["//:__subpackages__"],
    deps = [
        # First, so that its directory precedes every dependency's: nghttp2
        # publishes a header named config.h of its own (see `:config_h`).
        ":config_h",
        ":gnulib_conditional_hdrs",
        ":gnulib_linkopts",
    ],
)

# The sources `#include <config.h>` by that bare name, and `@nghttp2` exposes a
# `config.h` of its own through `strip_include_prefix`.  Which one an angle
# include finds depends on directory order, and on how each directory is
# spelled: with the `external_include_paths` feature a dependency's `includes`
# become `-isystem` (searched after every `-I`), whereas `strip_include_prefix`
# directories stay `-I`.  Publishing ours the same way, from the first
# dependency in every chain, keeps it ahead in both spellings.
cc_library(
    name = "config_h",
    hdrs = [":config"],
    strip_include_prefix = "config",
    visibility = ["//:__subpackages__"],
)

# GNULIB_LIBS (configure.ac:1033): the link libraries gnulib's own probes
# settle on, shared by libwget, src, tests and unit-tests.  Resolved into
# linker flags at build time from the substitutions the gnulib modules
# publish; names no module in this port publishes (LIBSOCKET, LTLIBC32CONV,
# LTLIBUNISTRING, HARD_LOCALE_LIB) are ignored by the rule, and all four are
# empty on the platforms above anyway.
autoconf_linkopts(
    name = "gnulib_linkopts",
    vars = [
        "CLOCK_TIME_LIB",
        "GETADDRINFO_LIB",
        "GETHOSTNAME_LIB",
        "GETLOGIN_LIB",
        "GETRANDOM_LIB",
        "HARD_LOCALE_LIB",
        "HOSTENT_LIB",
        "INET_NTOP_LIB",
        "INET_PTON_LIB",
        "LIBMULTITHREAD",
        # The probed pthread library, see `wget2_cv_search_pthread_kill`.
        "LIBMULTITHREAD_POSIX",
        "LIBSOCKET",
        "LIBTHREAD",
        "LIB_CRYPTO",
        "LTLIBC32CONV",
        "LTLIBICONV",
        "LTLIBINTL",
        "LTLIBUNISTRING",
        "MBRTOWC_LIB",
        "NANOSLEEP_LIB",
        "POLL_LIB",
        "POSIX_SPAWN_LIB",
        "PTHREAD_SIGMASK_LIB",
        "SELECT_LIB",
        "SERVENT_LIB",
        "SETLOCALE_LIB",
        "SETLOCALE_NULL_LIB",
        "INTL_MACOSX_LIBS",
    ],
    deps = [":autoconf"],
)

# ALL_LIBS (configure.ac:1030): what the dlsym search added to LIBS.
autoconf_linkopts(
    name = "all_libs",
    vars = ["ALL_LIBS"],
    deps = [":autoconf"],
)

