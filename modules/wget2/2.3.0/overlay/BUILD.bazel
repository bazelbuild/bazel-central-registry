# Public visibility tracks what `make install` publishes: libwget with
# include/wget/{wget,wgetver}.h (include/wget/Makefile.am:1) and the wget2
# program.  `:gnulib` stays private, together with its include paths.
#
# `include/wget` is the one include directory a consumer receives, so that
# `#include <wget.h>` works the way it does against an installed copy.
cc_library(
    name = "libwget",
    srcs = LIBWGET_SRCS + glob(["libwget/*.h"]),
    hdrs = [
        "include/wget/wget.h",
        ":wgetver_h",
    ],
    copts = COPTS,
    # libwget_la_CPPFLAGS (libwget/Makefile.am:42).  CFLAG_VISIBILITY is left
    # out: HAVE_VISIBILITY still marks the API as default-visibility, and a
    # static library has nothing to hide.
    local_defines = LOCAL_DEFINES + ["BUILDING_LIBWGET"],
    strip_include_prefix = "include/wget",
    visibility = ["//visibility:public"],
    deps = [":gnulib"] + LIBWGET_OPTIONAL_DEPS,
)

# ---------------------------------------------------------------------------
# wget2 (src/Makefile.am)
# ---------------------------------------------------------------------------

# unit-tests/test.c and four of its siblings include "../libwget/private.h".
exports_files(
    ["libwget/private.h"],
    visibility = ["//unit-tests:__pkg__"],
)

# src/Makefile.am:1 and :4-8, shared by every object under src/.
SRC_LOCAL_DEFINES = LOCAL_DEFINES + [
    "MALLOC_RETURNS_NONNULL",
    "SYSCONFDIR=\\\"$(SYSCONFDIR)/\\\"",
    "LOCALEDIR=\\\"$(LOCALEDIR)\\\"",
    "WGET_PLUGIN_DIR=\\\"$(WGET_PLUGIN_DIR)\\\"",
]

# Everything unit-tests/Makefile.am:19 links into the unit tests as
# BASE_OBJS, i.e. the program minus main() and the crawler proper.  It is a
# library of its own only so that //unit-tests can reach it; src/gpgme.c is
# absent because gpgme is (see the flag notes at the top).
cc_library(
    name = "wget2_base",
    srcs = [
        "src/dl.c",
        "src/log.c",
        "src/options.c",
        "src/plugin.c",
        "src/stats_server.c",
        "src/stats_site.c",
        "src/testing.c",
        "src/utils.c",
        # src/stats_server.c reaches into the library's private headers.
        "libwget/http.h",
        "libwget/net.h",
    ],
    # `hdrs` rather than `srcs` so that the unit tests, which include a few of
    # these with `"../src/..."` paths, have them in their compile inputs.
    hdrs = glob(["src/*.h"]),
    copts = COPTS,
    # src/Makefile.am:5 (`-I$(srcdir)`): the src/ headers include one another
    # with angle brackets.
    includes = ["src"],
    local_defines = SRC_LOCAL_DEFINES,
    toolchains = [":install_dirs"],
    visibility = ["//:__subpackages__"],
    deps = [
        ":all_libs",
        ":gnulib",
        ":libwget",
    ],
)

cc_binary(
    name = "wget2",
    srcs = [
        "src/bar.c",
        "src/blacklist.c",
        "src/host.c",
        "src/job.c",
        "src/wget.c",
    ],
    copts = COPTS,
    local_defines = SRC_LOCAL_DEFINES,
    toolchains = [":install_dirs"],
    visibility = ["//visibility:public"],
    deps = [
        ":gnulib",
        ":libwget",
        ":wget2_base",
    ],
)

alias(
    name = "wget",
    actual = ":wget2",
    visibility = ["//visibility:public"],
)
