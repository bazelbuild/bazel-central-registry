load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc_autoconf//autoconf:autoconf.bzl", "autoconf")
load("@rules_cc_autoconf//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
load("@rules_cc_autoconf//autoconf:autoconf_linkopts.bzl", "autoconf_linkopts")
load("@rules_cc_autoconf//autoconf:autoconf_srcs.bzl", "autoconf_srcs")
load("@rules_cc_autoconf//autoconf:checks.bzl", "checks", "macros")
load("@rules_cc_autoconf//autoconf:package_info.bzl", "package_info")
load("@rules_cc_autoconf//gnulib:conditional_hdrs.bzl", "cc_gnulib_conditional_hdrs")
load(":install_dirs.bzl", "install_dirs")

# AC_INIT (configure.ac:27).
package_info(
    name = "package",
    package_name = "wget2",
    module_bazel = "MODULE.bazel",
    package_bugreport = "bug-wget@gnu.org",
    package_tarname = "wget2",
    package_url = "https://savannah.gnu.org/projects/wget",
    strip_bcr_version = True,
)

# ---------------------------------------------------------------------------
# Build settings
#
# Each `--with-*` / `--enable-*` from configure.ac whose dependency the
# registry can satisfy is a flag here, with upstream's default.  The rest are
# fixed at "not found", which is the branch configure takes when the library is
# absent, and are listed so the omission is deliberate rather than an oversight:
#
#   --with-ssl=gnutls|wolfssl   no gnutls or wolfssl module; see `:ssl`.
#   --with-libdane              needs gnutls-dane.
#   --with-libpsl, --with-libhsts, --with-gpgme, --with-lzip, --with-libidn2,
#   --with-libidn, --with-libpcre (PCRE1), --enable-libproxy
#                               no module in the registry.
#   nettle / libgcrypt          only reached without a TLS library's own
#                               hashing; gnulib's md5/sha* are used instead.
#   --enable-manylibs           splits libwget into ~20 convenience
#                               libraries for `make install`; a Bazel consumer
#                               depends on `:libwget` and the linker drops
#                               what is unused.
#   --enable-fuzzing, --enable-fsanitize-*, --enable-valgrind-tests,
#   --enable-manywarnings, --disable-doc
#                               developer/instrumentation switches with Bazel
#                               equivalents (`--features=asan`, ...).
#   --disable-nls               gettext is probed like upstream (gnulib
#                               `gettext`), and libintl is never linked, so
#                               ENABLE_NLS only lands where gettext() is in
#                               libc.
# ---------------------------------------------------------------------------

# --with-ssl (configure.ac:525).  Upstream's default is gnutls with openssl and
# wolfssl as fallbacks; only openssl exists in the registry, so it is the
# default here.  "none" builds without TLS (`libwget/ssl_none.c`).
#
# The missing gnutls is also why only unit-tests/ is wired up (see
# unit-tests/BUILD.bazel) and not tests/: upstream builds that directory only
# under WITH_MICROHTTPD *and* WITH_GNUTLS_IN_TESTSUITE (Makefile.am:33), and
# its harness calls gnutls directly for the HTTPS, HTTP/2 and OCSP servers
# (tests/libtest.c), while the registry's libmicrohttpd has no TLS either.
SSL_BACKENDS = [
    "openssl",
    "none",
]

string_flag(
    name = "ssl",
    build_setting_default = "openssl",
    values = SSL_BACKENDS,
    visibility = ["//visibility:public"],
)

[
    config_setting(
        name = "_ssl_" + backend,
        flag_values = {":ssl": backend},
    )
    for backend in SSL_BACKENDS
]

# --with-zlib (configure.ac:758), --with-bzip2 (:744), --with-lzma (:775),
# --with-brotlidec (:792), --with-zstd (:809), --with-libnghttp2 (:707),
# --with-libpcre2 (:883), --disable-xattr (:378), --enable-assert (:369),
# --without-plugin-support (:998).  Defaults are upstream's.
OPTIONAL_FEATURES = {
    "assert": False,
    "brotlidec": True,
    "bzip2": False,
    "libnghttp2": True,
    "libpcre2": True,
    "lzma": False,
    "plugin_support": True,
    "xattr": True,
    "zlib": True,
    "zstd": True,
}

[
    bool_flag(
        name = feature,
        build_setting_default = default,
        visibility = ["//visibility:public"],
    )
    for feature, default in OPTIONAL_FEATURES.items()
]

[
    config_setting(
        name = "_with_" + feature,
        flag_values = {":" + feature: "True"},
        visibility = ["//:__subpackages__"],
    )
    for feature in OPTIONAL_FEATURES
]

# --enable-xattr only ever probes on Linux, macOS and FreeBSD (configure.ac:384)
# and disables itself everywhere else.
selects.config_setting_group(
    name = "_xattr_fsetxattr",
    match_all = [
        ":_with_xattr",
        ":_os_linux_or_macos",
    ],
)

selects.config_setting_group(
    name = "_os_linux_or_macos",
    match_any = [
        "@platforms//os:linux",
        "@platforms//os:macos",
    ],
)

selects.config_setting_group(
    name = "_xattr_extattr",
    match_all = [
        ":_with_xattr",
        "@platforms//os:freebsd",
    ],
)

# The three install-layout paths compiled into the program (src/Makefile.am:1
# and :8).  Defaults are the autoconf defaults for `--prefix=/usr/local`.
string_flag(
    name = "sysconfdir",
    build_setting_default = "/usr/local/etc",
    visibility = ["//visibility:public"],
)

string_flag(
    name = "localedir",
    build_setting_default = "/usr/local/share/locale",
    visibility = ["//visibility:public"],
)

string_flag(
    name = "plugindir",
    build_setting_default = "/usr/local/lib/wget2/plugins",
    visibility = ["//visibility:public"],
)

install_dirs(
    name = "install_dirs",
    settings = {
        ":localedir": "LOCALEDIR",
        ":plugindir": "WGET_PLUGIN_DIR",
        ":sysconfdir": "SYSCONFDIR",
    },
)

# ---------------------------------------------------------------------------
# Compiler flags
# ---------------------------------------------------------------------------

# configure.ac:60 insists on a C11 compiler.  The warning sets configure builds
# (wget_MANYWARNINGS, WARN_CFLAGS, GNULIB_WARN_CFLAGS) are for upstream's own
# CI and are replaced by `-w`, as is usual for registry modules.  clang-cl takes
# the MSVC spellings, so it is named alongside msvc-cl.
_MSVC_COPTS = [
    "/w",
    "/std:c11",
]

_GNU_COPTS = [
    "-w",
    "-std=gnu11",
]

COPTS = select({
    "@rules_cc//cc/compiler:clang-cl": _MSVC_COPTS,
    "@rules_cc//cc/compiler:msvc-cl": _MSVC_COPTS,
    "//conditions:default": _GNU_COPTS,
})

LOCAL_DEFINES = [
    "HAVE_CONFIG_H",
] + select({
    # --enable-assert (configure.ac:373): NDEBUG unless assertions are wanted.
    ":_with_assert": [],
    "//conditions:default": ["NDEBUG"],
})

