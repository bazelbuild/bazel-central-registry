autoconf(
    name = "autoconf",
    # The check list below follows `configure.ac` top to bottom.  Everything
    # wget2 itself asks for is written out here rather than depended on, so
    # each entry can be read against the line of `configure.ac` it came from.
    # Only `gl_INIT` stays a dependency; see GL_INIT_DEPS for why.
    #
    # Where a probe is reached both from here and from `gl_INIT`, upstream runs
    # it once and the single result is shared.  The same holds here, and it has
    # to: a symbol may be defined only once per `autoconf` target.  So the
    # following are asked for by configure.ac but resolved under GL_INIT_DEPS:
    # AC_CANONICAL_HOST (:33) and AC_USE_SYSTEM_EXTENSIONS (:47) via
    # `extensions`; AC_SYS_LARGEFILE (:52) via `largefile`; AM_GNU_GETTEXT
    # (:414) via `gettext`; the `sys/mman.h` half of AC_FUNC_MMAP (:1048) via
    # `mmap-anon`.
    checks = (
        # AC_CHECK_SIZEOF(off_t) (configure.ac:53).  autoconf's default
        # includes bring in <sys/types.h>, which is where off_t lives.
        [
            checks.AC_CHECK_SIZEOF(
                "off_t",
                define = "SIZEOF_OFF_T",
                includes = ["#include <sys/types.h>"],
            ),
        ] +
        # LT_INIT (configure.ac:70).
        [
            checks.AC_CHECK_HEADER(
                "dlfcn.h",
                define = "HAVE_DLFCN_H",
            ),
            checks.AC_DEFINE(
                "LT_OBJDIR",
                value = '".libs/"',
            ),
        ] +
        # configure.ac:83-92, the values substituted into
        # include/wget/wgetver.h (:93) and libwget.pc.  LIBWGET_VERSION_NUMBER
        # is `printf '0x%02x%02x%02x' 2 3 0`.
        [
            checks.AC_SUBST("LIBWGET_SO_VERSION", "5:0:0"),
            checks.AC_SUBST("LIBWGET_VERSION", "2.3.0"),
            checks.AC_SUBST("LIBWGET_VERSION_MAJOR", "2"),
            checks.AC_SUBST("LIBWGET_VERSION_MINOR", "3"),
            checks.AC_SUBST("LIBWGET_VERSION_PATCH", "0"),
            checks.AC_SUBST("LIBWGET_VERSION_NUMBER", "0x020300"),
        ] +
        # AC_PROG_LEX (configure.ac:100) contributes nothing to config.h in
        # the `noyywrap` form; css_tokenizer.c is flex output the tarball
        # ships, so no lex toolchain is involved either.
        # --enable-xattr (configure.ac:378).  Linux and macOS probe fsetxattr,
        # FreeBSD extattr_set_fd, and ENABLE_XATTR follows the probe.
        select({
            ":_xattr_extattr": macros.AC_CHECK_FUNCS(["extattr_set_fd"]) + [
                checks.AC_DEFINE(
                    "ENABLE_XATTR",
                    requires = ["ac_cv_func_extattr_set_fd==1"],
                ),
            ],
            ":_xattr_fsetxattr": macros.AC_CHECK_FUNCS(["fsetxattr"]) + [
                checks.AC_DEFINE(
                    "ENABLE_XATTR",
                    requires = ["ac_cv_func_fsetxattr==1"],
                ),
            ],
            "//conditions:default": [],
        }) +
        # configure.ac:506 and :514.
        [
            checks.AC_TRY_LINK(
                code = "int main(void) { return __sync_fetch_and_add((int *)0, 0); }",
                define = "WITH_SYNC_FETCH_AND_ADD",
            ),
            checks.AC_TRY_LINK(
                code = "int main(void) { return __sync_fetch_and_add((long long *)0, 0); }",
                define = "WITH_SYNC_FETCH_AND_ADD_LONGLONG",
            ),
        ] +
        # --with-ssl=openssl (configure.ac:555).  Upstream probes the library
        # pkg-config found; an `autoconf` target can only probe the toolchain,
        # not `@openssl`, so the results are stated for the pinned module,
        # which has every header and function the branch looks for.
        # HAVE_SSL_NEW and HAVE_X509_STORE_ADD_LOOKUP (:577) are left out: that
        # AC_CHECK_FUNCS runs before OPENSSL_LIBS is added to LIBS, so upstream
        # never defines them either, and nothing reads them.
        select({
            ":_ssl_openssl": [
                checks.AC_DEFINE("WITH_OPENSSL"),
                checks.AC_DEFINE("HAVE_OPENSSL_SSL_H"),
                checks.AC_DEFINE("HAVE_OPENSSL_X509_VFY_H"),
                checks.AC_DEFINE("HAVE_OPENSSL_OCSP_H"),
                checks.AC_DEFINE("WITH_OCSP"),
                checks.AC_DEFINE("WITH_LIBCRYPTO"),
                # configure.ac:611.
                checks.AC_DEFINE("WITH_TLS"),
            ],
            "//conditions:default": [],
        }) +
        # --with-bzip2 (configure.ac:744) through --with-zstd (:809),
        # --with-libnghttp2 (:707) and --with-libpcre2 (:883).  Each is a
        # PKG_CHECK_MODULES/AC_SEARCH_LIBS pair whose only config.h output is
        # the WITH_* define; the library itself is a `deps` entry on `:libwget`.
        select({
            ":_with_bzip2": [checks.AC_DEFINE("WITH_BZIP2")],
            "//conditions:default": [],
        }) +
        select({
            ":_with_zlib": [checks.AC_DEFINE("WITH_ZLIB")],
            "//conditions:default": [],
        }) +
        select({
            ":_with_lzma": [checks.AC_DEFINE("WITH_LZMA")],
            "//conditions:default": [],
        }) +
        select({
            ":_with_brotlidec": [checks.AC_DEFINE("WITH_BROTLIDEC")],
            "//conditions:default": [],
        }) +
        select({
            ":_with_zstd": [checks.AC_DEFINE("WITH_ZSTD")],
            "//conditions:default": [],
        }) +
        select({
            ":_with_libnghttp2": [checks.AC_DEFINE("WITH_LIBNGHTTP2")],
            "//conditions:default": [],
        }) +
        select({
            ":_with_libpcre2": [checks.AC_DEFINE("WITH_LIBPCRE2")],
            "//conditions:default": [],
        }) +
        # Plugin support (configure.ac:987-1026).  On everything but Windows
        # the backend is libdl: AC_SEARCH_LIBS([dlsym], [dl ldl]) lands in LIBS,
        # which configure.ac:1030 publishes as ALL_LIBS, and plugin support is
        # withdrawn when dlsym is nowhere to be found.
        select({
            ":_with_plugin_support": [
                checks.AC_SEARCH_LIBS(
                    "dlsym",
                    [
                        "dl",
                        "ldl",
                    ],
                    subst = "ALL_LIBS",
                ),
                checks.AC_DEFINE(
                    "PLUGIN_SUPPORT",
                    requires = ["ac_cv_search_dlsym!=no"],
                ),
                checks.AC_DEFINE(
                    "PLUGIN_SUPPORT_LIBDL",
                    requires = ["ac_cv_search_dlsym!=no"],
                ),
            ],
            "//conditions:default": [],
        }) +
        # configure.ac:1043.  The idn headers are looked for even though no
        # IDN library is linked; libwget/encoding.c only acts on them together
        # with WITH_LIBIDN2/WITH_LIBIDN.
        macros.AC_CHECK_HEADERS([
            "crypt.h",
            "idna.h",
            "idn/idna.h",
            "idn2.h",
            "unicase.h",
            "netinet/tcp.h",
        ]) +
        # AC_FUNC_FORK (configure.ac:1047).  The "working" halves are
        # AC_RUN_IFELSE probes whose cross-compilation guess is "yes" wherever
        # the function exists, which is what a compile-only port can say too.
        macros.AC_CHECK_HEADERS([
            "vfork.h",
        ]) + macros.AC_CHECK_FUNCS([
            "fork",
            "vfork",
        ]) + [
            checks.AC_DEFINE(
                "HAVE_WORKING_FORK",
                requires = ["ac_cv_func_fork==1"],
            ),
            checks.AC_DEFINE(
                "HAVE_WORKING_VFORK",
                requires = ["ac_cv_func_vfork==1"],
            ),
            checks.AC_DEFINE(
                "vfork",
                requires = ["!ac_cv_func_vfork"],
                value = "fork",
            ),
        ] +
        # AC_FUNC_MMAP (configure.ac:1048).  Another AC_RUN_IFELSE; its
        # cross-compilation guess is "no", which would silently turn off the
        # mmap paths in libwget/css.c, xml.c and hashfile.c on every platform,
        # so the presence of the function is used instead.  The macro's
        # AC_CHECK_FUNCS([getpagesize]) is the only other config.h output it
        # has (its <sys/mman.h> probe is shared with gnulib's `mmap-anon`).
        macros.AC_CHECK_FUNCS([
            "getpagesize",
        ]) + [
            checks.AC_CHECK_FUNC(
                "mmap",
                name = "ac_cv_func_mmap",
            ),
            checks.AC_DEFINE(
                "HAVE_MMAP",
                requires = ["ac_cv_func_mmap==1"],
            ),
        ] +
        # configure.ac:1049.
        macros.AC_CHECK_FUNCS([
            "strlcpy",
            "getuid",
            "fmemopen",
            "pathconf",
        ]) +
        # AM_INIT_AUTOMAKE (configure.ac:30) mirrors AC_INIT's tarname and
        # version into config.h.
        [
            checks.AC_DEFINE(
                "PACKAGE",
                value = '"wget2"',
            ),
            checks.AC_DEFINE(
                "VERSION",
                value = '"2.3.0"',
            ),
            # gl_INIT sets this for the gnulib header templates; the toolchain
            # defaults have no value for it.
            checks.AC_SUBST(
                "GUARD_PREFIX",
                value = "GL",
            ),
            # gl_THREADLIB_BODY (m4/threadlib.m4): LIBMULTITHREAD is
            # `-lpthread` exactly when `pthread_kill` is not in libc (glibc
            # < 2.34, e.g. ubuntu2004), and empty on newer glibc and macOS.
            # The `threadlib` port publishes LIBMULTITHREAD as a constant ""
            # and its own probe asks for pthread_mutex_lock, which glibc
            # 2.31's libc forwards, so neither answers correctly there;
            # gnulib's `lock` module then fails to link once no other
            # dependency drags libpthread in (`--ssl=none`).
            checks.AC_SEARCH_LIBS(
                "pthread_kill",
                ["pthread"],
                name = "wget2_cv_search_pthread_kill",
                subst = "LIBMULTITHREAD_POSIX",
            ),
            # wget2's gnulib snapshot postdates the one behind the toolchain
            # defaults; this is the one `@VAR@` its templates use that the
            # defaults do not know.  The `vaprintf` module is not in
            # m4/gnulib-cache.m4, so the value is the gl_STDIO_H_DEFAULTS one.
            checks.AC_SUBST("GNULIB_VAPRINTF", 0),
            # gl_FUNC_C32RTOMB's link test (m4/c32rtomb.m4:96), run for real:
            # the `c32rtomb` port answers "present" on macOS from a deployment
            # target check, but macOS' libSystem has neither the declaration
            # nor the symbol (`Undefined symbols: _c32rtomb` from regex.o).
            # This decides whether lib/c32rtomb.c is compiled; see
            # SRC_CONDITIONS.
            checks.AC_TRY_LINK(
                name = "wget2_cv_func_c32rtomb",
                code = """\
#include <stdlib.h>
#include <uchar.h>
int main(void) { char buf[8]; return c32rtomb (buf, 0, NULL) == 0; }
""",
            ),
        ] +
        # gl_FUNC_MEMEQ (m4/memeq.m4:9) and gl_FUNC_STREQ (m4/streq.m4:9):
        # AC_CHECK_DECLS_ONCE plus the HAVE_DECL_* shell variable string.in.h
        # substitutes.  gl_FUNC_MBRTOC32_REGULAR (m4/mbrtoc32-regular.m4) is
        # empty; its module indicator is in the lists above.
        [
            checks.AC_CHECK_DECL(
                "memeq",
                define = "HAVE_DECL_MEMEQ",
                includes = ["#include <string.h>"],
                subst = True,
            ),
            checks.AC_CHECK_DECL(
                "streq",
                define = "HAVE_DECL_STREQ",
                includes = ["#include <string.h>"],
                subst = True,
            ),
        ] +
        # gl_INIT module indicators, see the lists above.
        [
            checks.AC_SUBST(
                "GNULIB_" + v,
                1,
            )
            for v in GNULIB_HEADER_MODULE_INDICATORS
        ] + [
            checks.AC_DEFINE(
                "GNULIB_TEST_" + v,
                "1",
            )
            for v in GNULIB_HEADER_MODULE_INDICATORS
        ] + [
            checks.AC_DEFINE(
                "GNULIB_" + v,
                "1",
            )
            for v in GNULIB_MODULE_INDICATORS
        ] + [
            checks.AC_DEFINE(
                "GNULIB_TEST_" + v,
                "1",
            )
            for v in GNULIB_TEST_MODULE_INDICATORS
        ]
    ),
    deps = [":package"] + GL_INIT_DEPS,
)

# AC_CONFIG_HEADERS([config.h]) (configure.ac:96).  Upstream writes it to the
# top build directory and adds that to the include path; rules_cc refuses an
# `includes` entry that resolves to the workspace root, so it gets a directory
# of its own.
autoconf_hdr(
    name = "config",
    out = "config/config.h",
    defaults = True,
    # The rules_cc_autoconf `nl_langinfo` port answers NL_LANGINFO_MTSAFE=0
    # on every platform but Linux; gnulib's m4/nl_langinfo.m4:46 answers 0
    # only on Solaris, and lib/nl_langinfo.c:157 takes a 0 to mean Solaris'
    # <langinfo.h> (MAXSTRMSG), which fails to compile on macOS.  None of the
    # platforms this module builds for is Solaris, so the entry is fixed at
    # gnulib's answer before the port's result is applied (a check with no
    # `#undef` left to fill is dropped).
    substitutions = {
        "#undef NL_LANGINFO_MTSAFE": "#define NL_LANGINFO_MTSAFE 1",
    },
    template = "config.h.in",
    deps = [":autoconf"],
)

