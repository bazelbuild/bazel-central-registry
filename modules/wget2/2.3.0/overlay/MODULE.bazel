# registry ships are listed; see the notes next to the flags for the rest.
bazel_dep(name = "brotli", version = "1.2.0.bcr.3")
bazel_dep(name = "bzip2", version = "1.0.8.bcr.4")
bazel_dep(name = "nghttp2", version = "1.65.0.bcr.1")
bazel_dep(name = "openssl", version = "3.5.8.bcr.0")
bazel_dep(name = "pcre2", version = "10.48")
bazel_dep(name = "xz", version = "5.4.5.bcr.9")
