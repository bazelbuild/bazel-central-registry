load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE"])

# Public C++ API headers of TensorRT (NvInfer.h, NvInferRuntime.h,
# NvOnnxParser.h, ...), as shipped in the TensorRT OSS repository.
#
# This target is header-only. The TensorRT runtime libraries (libnvinfer.so,
# libnvonnxparser.so, ...) are proprietary and are not part of this module;
# they must be provided by a TensorRT installation at link and/or run time.
cc_library(
    name = "tensorrt_headers",
    hdrs = glob(["include/**/*.h"]),
    strip_include_prefix = "include",
)
