module(
    name = "jdk_catalog",
    version = "0.1.2",
    bazel_compatibility = [">=9.3.0"],
    compatibility_level = 1,
)

# Reuse upstream rules_java's repository and toolchain implementations.
bazel_dep(name = "rules_java", version = "9.9.0")
bazel_dep(name = "platforms", version = "1.1.0")

jdks = use_extension("//jdk:extensions.bzl", "jdks")

# Keep platform names in sync with jdk/catalog.bzl and jdk/repositories.bzl.
[
    use_repo(jdks, "remotejdk" + version + "_" + platform)
    for version in [
        "25",
        "27",
    ]
    for platform in [
        "linux",
        "linux_aarch64",
        "linux_ppc64le",
        "linux_riscv64",
        "linux_s390x",
        "macos",
        "macos_aarch64",
        "win",
        "win_arm64",
    ]
]

# Root consumers also register this target to prefer these toolchains over
# rules_java's registrations and support restricted non-root registrations.
register_toolchains("//toolchains:all")
