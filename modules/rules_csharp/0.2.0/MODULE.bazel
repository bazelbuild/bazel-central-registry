module(
    name = "rules_csharp",
    version = "0.2.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "stardoc", version = "0.7.2")
bazel_dep(name = "apple_support", version = "2.5.2")
bazel_dep(name = "protobuf", version = "33.4")

apple_support = use_extension("@apple_support//crosstool:setup.bzl", "apple_cc_configure_extension")
use_repo(apple_support, "local_config_apple_cc_toolchains")
register_toolchains("@local_config_apple_cc_toolchains//:all")

csharp = use_extension("//csharp:extensions.bzl", "csharp")
use_repo(csharp, "dotnet_toolchains")

register_toolchains("@dotnet_toolchains//:all")

nuget = use_extension("//csharp:extensions.bzl", "nuget")
nuget.from_lock(
    packages_lock_json = "//tests/integration:packages.lock.json",
    directory_packages_props = "//tests/integration:Directory.Packages.props",
)
use_repo(nuget, "nuget")

