--- /dev/null
+++ examples/GreeterTest.cs
@@ -0,0 +1,17 @@
+using System;
+using RulesCsharp.Examples;
+
+public static class GreeterTest
+{
+    public static int Main()
+    {
+        string greeting = Greeter.Greet("BCR");
+        if (greeting != "Hello, BCR!")
+        {
+            Console.Error.WriteLine($"Assertion failed: {greeting}");
+            return 1;
+        }
+        Console.WriteLine($"Assertion passed: {greeting}");
+        return 0;
+    }
+}
