load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

# Upstream's `make check` program, verbatim: testcms_SOURCES from
# testbed/Makefile.am. The zoo tests are compiled in but default-off, matching
# upstream.
cc_binary(
    name = "testcms_bin",
    srcs = [
        "testcms2.c",
        "testcms2.h",
        "testplugin.c",
        "zoo_icc.c",
    ],
    deps = [
        "//:lcms2",
        "//:lcms2_internal_hdrs",
    ],
)

# new.icc is not corpus: a stray artifact of an upstream test run checked
# into the upstream tree (testbed/Makefile.am's EXTRA_DIST omits it); the
# suite regenerates it itself.
ICC_CORPUS = glob(
    ["*.icc"],
    exclude = ["new.icc"],
)

cc_test(
    name = "testcms",
    size = "small",
    srcs = ["run_testcms.cc"],
    args = ["$(rlocationpath :testcms_bin)"] + ["$(rlocationpath %s)" % f for f in ICC_CORPUS],
    data = [":testcms_bin"] + ICC_CORPUS,
    deps = ["@bazel_tools//tools/cpp/runfiles"],
)
