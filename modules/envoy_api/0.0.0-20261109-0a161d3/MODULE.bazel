####################################################################################
# setup: Languages
####################################################################################

bazel_lib = use_extension("@aspect_bazel_lib//lib:extensions.bzl", "toolchains")
bazel_lib.jq(version = "1.7")
bazel_lib.yq(version = "4.24.4")
use_repo(bazel_lib, "jq", "jq_toolchains", "yq", "yq_toolchains")

java_toolchains = use_extension("@rules_java//java:extensions.bzl", "toolchains")
use_repo(
    java_toolchains,
    "remotejdk25_linux",
    "remotejdk25_linux_aarch64",
    "remotejdk25_linux_ppc64le",
    "remotejdk25_linux_s390x",
    "remotejdk25_macos",
    "remotejdk25_macos_aarch64",
    "remotejdk25_win",
    "remotejdk25_win_arm64",
)

# envoy_api is an independent module, so it needs to register its own hermetic Java toolchains
# rather than relying on @envoy's dependency registrations. Register both the default and explicit
# Java 11 toolchain definitions because rules_java emits separate toolchains for
# --java_language_version="" and --java_language_version=11. The runtime toolchains below must
# point at concrete @remotejdk25_*//:jdk targets rather than the remotejdk_25 alias to avoid a
# self-cycle through Java runtime toolchain resolution.
register_toolchains(
    "//bazel:envoy_api_java_toolchain_default_definition",
    "//bazel:envoy_api_java_toolchain_definition",
    "//bazel:envoy_api_java_runtime_toolchain_linux",
    "//bazel:envoy_api_java_runtime_toolchain_linux_aarch64",
    "//bazel:envoy_api_java_runtime_toolchain_linux_ppc64le",
    "//bazel:envoy_api_java_runtime_toolchain_linux_s390x",
    "//bazel:envoy_api_java_runtime_toolchain_macos",
    "//bazel:envoy_api_java_runtime_toolchain_macos_aarch64",
    "//bazel:envoy_api_java_runtime_toolchain_win",
    "//bazel:envoy_api_java_runtime_toolchain_win_arm64",
    "//bazel:envoy_api_java_bootstrap_runtime_toolchain_linux",
    "//bazel:envoy_api_java_bootstrap_runtime_toolchain_linux_aarch64",
    "//bazel:envoy_api_java_bootstrap_runtime_toolchain_linux_ppc64le",
    "//bazel:envoy_api_java_bootstrap_runtime_toolchain_linux_s390x",
    "//bazel:envoy_api_java_bootstrap_runtime_toolchain_macos",
    "//bazel:envoy_api_java_bootstrap_runtime_toolchain_macos_aarch64",
    "//bazel:envoy_api_java_bootstrap_runtime_toolchain_win",
    "//bazel:envoy_api_java_bootstrap_runtime_toolchain_win_arm64",
)

# Go SDK and toolchain configuration
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.3")
use_repo(
    go_sdk,
    "go_toolchains",
)

