module(
    name = "bylaws",
    version = "0.1.0",
    compatibility_level = 1,
)

bazel_dep(name = "platforms", version = "1.0.0")

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

_BASE = "https://github.com/theblixguy/swift-bylaws/releases/download/v0.1.0"

http_archive(
    name = "bylaws_macos",
    urls = [_BASE + "/bylaws-macos.tar.gz"],
    sha256 = "2cca591208ebeab645dc50cc208b223104d68b43f4a85569084e229bfa38828e",
)

http_archive(
    name = "bylaws_linux",
    urls = [_BASE + "/bylaws-linux.tar.gz"],
    sha256 = "a455d561e000ddf17fc04439f0a405b6329c5557a00f520a1430b84e01f45f4f",
)
