module(
    name = "bylaws",
    version = "0.1.1",
    compatibility_level = 1,
)

bazel_dep(name = "platforms", version = "1.0.0")

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

_BASE = "https://github.com/theblixguy/swift-bylaws/releases/download/v0.1.1"

http_archive(
    name = "bylaws_macos",
    urls = [_BASE + "/bylaws-macos.tar.gz"],
    sha256 = "af39cc3e2b8fdc3b281acc0ed50933b36528996f177b548383d3714141f92f69",
)

http_archive(
    name = "bylaws_linux",
    urls = [_BASE + "/bylaws-linux.tar.gz"],
    sha256 = "871db943d6ccabcf424e20d71fbfd1f9aeed71f08d9c94a3c9405fc3e8ed2789",
)
