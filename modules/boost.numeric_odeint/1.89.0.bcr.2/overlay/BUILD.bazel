load("@rules_cc//cc:cc_library.bzl", "cc_library")

# The external backends bind odeint to third-party libraries (MPI, Eigen, GSL,
# Thrust, VexCL, ...) that are not in the registry.
_EXTERNAL_BACKENDS = glob(["include/boost/numeric/odeint/external/**"])

cc_library(
    name = "boost.numeric_odeint",
    hdrs = glob(["include/**/*.hpp"], exclude = _EXTERNAL_BACKENDS),
    # Most odeint headers reach for std::pair, size_t or std::abs without
    # including <utility>, <cstddef> or <cmath>, so they are only usable after
    # their includer has pulled those in and cannot take part in parse_headers.
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [
        "@boost.assert",
        "@boost.config",
        "@boost.core",
        "@boost.fusion",
        "@boost.iterator",
        "@boost.math",
        "@boost.mpl",
        "@boost.multi_array",
        "@boost.numeric_ublas",
        "@boost.preprocessor",
        "@boost.range",
        "@boost.static_assert",
        "@boost.throw_exception",
        "@boost.type_traits",
        "@boost.units",
        "@boost.utility",
    ],
)
