"""periareon/rules_kubectl"""

module(
    name = "rules_kubectl",
    version = "0.1.0",
    bazel_compatibility = [">=7.7.0"],
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_go", version = "0.65.0")

bazel_dep(name = "rules_shell", version = "0.6.1", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1", dev_dependency = True)
bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)
bazel_dep(name = "rules_rust_mdbook", version = "0.75.0", dev_dependency = True)

kubectl = use_extension("//kubectl:extensions.bzl", "kubectl")
kubectl.toolchain()
use_repo(
    kubectl,
    "kubectl",
    "kubectl_toolchains",
)

register_toolchains("@kubectl_toolchains//:all")

# A version without checked in checksums, so the fact persistence path is
# exercised by the tests.
kubectl_dev = use_extension("//kubectl:extensions.bzl", "kubectl", dev_dependency = True)
kubectl_dev.toolchain(
    name = "kubectl_pinned",
    version = "1.36.5",
)
use_repo(
    kubectl_dev,
    "kubectl_pinned",
)
