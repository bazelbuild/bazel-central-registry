# USearch C++ vector search, header-only: <usearch/index_dense.hpp>.
#
# Built with upstream's CMake defaults minus the compiler probes: no OpenMP
# thread pool, no NumKong SIMD metrics, and the portable software f16/bf16
# conversions on every compiler (USEARCH_CAN_COMPILE_*=0) rather than native
# _Float16/__bf16, so the configuration is identical on every target.
#
# Consumers see only include/usearch/*.hpp, as <usearch/...>: the headers are
# exposed through strip_include_prefix rather than `includes`, so neither the
# repository root nor include/usearch itself is on a consumer's include path.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Apache-2.0"],
    license_text = "LICENSE",
)

exports_files(["LICENSE"])

cc_library(
    name = "usearch",
    hdrs = glob(["include/usearch/*.hpp"]),
    defines = [
        "USEARCH_USE_OPENMP=0",
        "USEARCH_USE_NUMKONG=0",
        "USEARCH_CAN_COMPILE_FP16=0",
        "USEARCH_CAN_COMPILE_FLOAT16=0",
        "USEARCH_CAN_COMPILE_BF16=0",
        "USEARCH_CAN_COMPILE_BFLOAT16=0",
    ],
    strip_include_prefix = "include",
)
