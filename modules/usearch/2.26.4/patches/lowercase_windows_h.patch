index.hpp: include <windows.h> in lower case.

MinGW ships windows.h; <Windows.h> only resolves on case-insensitive file
systems, so cross-compiling for Windows from Linux or macOS fails. The
lower-case spelling works with MSVC and MinGW alike.

diff --git a/include/usearch/index.hpp b/include/usearch/index.hpp
--- a/include/usearch/index.hpp
+++ b/include/usearch/index.hpp
@@ -75,7 +75,7 @@
 #ifndef NOMINMAX
 #define NOMINMAX
 #endif
-#include <Windows.h>
+#include <windows.h>
 #include <sys/stat.h> // `fstat` for file size
 #undef NOMINMAX
 #undef _USE_MATH_DEFINES
