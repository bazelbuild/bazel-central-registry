index.hpp: include <exception> and <type_traits> explicitly.

index.hpp uses std::is_pod and std::uncaught_exceptions but relies on other
standard headers to pull in <type_traits> and <exception> transitively. Recent
libc++ releases (as shipped by the hermetic LLVM toolchain) no longer do, so
the header fails to compile there.

diff --git a/include/usearch/index.hpp b/include/usearch/index.hpp
--- a/include/usearch/index.hpp
+++ b/include/usearch/index.hpp
@@ -94,11 +94,13 @@
 #include <climits>   // `CHAR_BIT`
 #include <cmath>     // `std::sqrt`
 #include <cstring>   // `std::memset`
+#include <exception> // `std::uncaught_exceptions`
 #include <iterator>  // `std::reverse_iterator`
 #include <mutex>     // `std::unique_lock` - replacement candidate
 #include <random>    // `std::default_random_engine` - replacement candidate
 #include <stdexcept> // `std::runtime_exception`
 #include <thread>    // `std::thread`
+#include <type_traits> // `std::is_pod`
 #include <utility>   // `std::pair`

 // Helper macros for concatenation and stringification
