load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "utils_cpp",
    hdrs = ["utils.h"],
    deps = [
        "@clarabel//:clarabel_cpp",
        "@eigen",
    ],
)

[
    cc_test(
        name = "cpp_{}_test".format(name),
        srcs = ["{}.cpp".format(name)],
        deps = [
            ":utils_cpp",
            "@clarabel//:clarabel_cpp",
            "@eigen",
        ],
    )
    for name in [
        "example_qp",
        "example_lp",
        "example_socp",
        "example_expcone",
        "example_powcone",
        "example_genpowcone",
        "example_callback",
        "example_callback_with_state",
        "example_print_stream",
    ]
]
