load("@rules_cc//cc:defs.bzl", "cc_test")

# C-API verification test
cc_test(
    name = "clarabel_c_smoke_test",
    srcs = ["c_smoke_test.c"],
    deps = [
        "@clarabel//:clarabel_c",
    ],
)

# C++ test suite (all conic tests including SDP)
cc_test(
    name = "clarabel_cpp_tests",
    srcs = glob(
        ["*.cpp"],
        allow_empty = True,
    ),
    deps = [
        "@clarabel",
        "@eigen",
        "@googletest//:gtest_main",
    ],
)

