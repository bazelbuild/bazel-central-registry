load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

cc_library(
    name = "utils_c",
    srcs = ["utils.c"],
    hdrs = ["utils.h"],
    deps = ["@clarabel//:clarabel_c"],
)

[
    cc_test(
        name = "{}_test".format(name),
        srcs = ["{}.c".format(name)],
        deps = [
            ":utils_c",
            "@clarabel//:clarabel_c",
        ],
    )
    for name in [
        "example_qp",
        "example_qp_f32",
        "example_qp_f64",
        "example_lp",
        "example_socp",
        "example_expcone",
        "example_powcone",
        "example_genpowcone",
        "example_callback",
        "example_callback_with_state",
        "example_print_stream",
    ]
]
