module(
    name = "rules_img",
    version = "0.3.19",
)

bazel_dep(name = "bazel_features", version = "1.47.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "hermetic_launcher", version = "0.0.10")
bazel_dep(name = "package_metadata", version = "0.0.10")
bazel_dep(name = "rules_runfiles_group", version = "0.1.0")

# Pure-Starlark sha256, used to derive collision-free basenames for the
# sign_setting config files shipped into deploy binary runfiles.
bazel_dep(name = "sha256.bzl", version = "0.0.1")

prebuilt_img_tool = use_extension("@rules_img//img/private/prebuilt:prebuilt.bzl", "prebuilt_img_tool")
prebuilt_img_tool.collection(
    name = "img_toolchain",
)
prebuilt_img_tool.from_file(
    collection = "img_toolchain",
    file = "@rules_img//:prebuilt_lockfile.json",
)
use_repo(
    prebuilt_img_tool,
    "img_toolchain",
)

# register a prebuilt toolchain of the img tool.
register_toolchains(
    "@img_toolchain//:all",
)
