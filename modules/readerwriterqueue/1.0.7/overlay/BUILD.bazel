""" Builds readerwriterqueue.
"""

load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
)

exports_files(["LICENSE.md"])

license(
    name = "license",
    package_name = "readerwriterqueue",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-2-Clause",
        "@rules_license//licenses/spdx:Zlib",
    ],
    license_text = "LICENSE.md",
    package_url = "https://github.com/cameron314/readerwriterqueue",
)

cc_library(
    name = "readerwriterqueue",
    hdrs = [
        "atomicops.h",
        "readerwritercircularbuffer.h",
        "readerwriterqueue.h",
    ],
    include_prefix = "moodycamel",
    visibility = ["//visibility:public"],
)
