"""The headers shared by every binutils directory (`-I$(INCDIR)`)."""

load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//:__subpackages__"])

# Upstream builds with -W -Wall; this module silences compiler warnings.
COPTS = select({
    "@rules_cc//cc/compiler:clang-cl": ["/w"],
    "@rules_cc//cc/compiler:msvc-cl": ["/w"],
    "//conditions:default": ["-w"],
})

# Everything upstream reaches through `-I$(srcdir)/../include`: the plain
# headers, the `.def` tables (dwarf2.def, gcc-c-fe.def, ...) that are
# #included textually, and the subdirectories named with their prefix
# (`elf/common.h`, `opcode/i386.h`, `coff/internal.h`, `aout/ar.h`, ...).
#
# Only the installable subset is public: bfd.h's own includes (ansidecl.h,
# symcat.h, diagnostics.h, bfdlink.h, plugin-api.h) plus the libctf,
# libsframe and libopcodes API headers, which is what `make install` puts in
# $(includedir).  The rest is private to the module.
cc_library(
    name = "include",
    hdrs = glob(
        [
            "*.h",
            "*.def",
            "aout/*.h",
            "aout/*.def",
            "cgen/*.h",
            "coff/*.h",
            "elf/*.h",
            "elf/*.def",
            "gdb/*.h",
            "gdb/*.def",
            "mach-o/*.h",
            "opcode/*.h",
            "som/*.h",
            "vms/*.h",
        ],
        # The simulator and GCC front-end interfaces are for other trees.
        exclude = [
            "gcc-*.h",
            "gcc-*.def",
            "collectorAPI.h",
            "libcollector.h",
            "libfcollector.h",
        ],
    ),
    copts = COPTS,
    includes = ["."],
)

cc_library(
    name = "installed",
    hdrs = [
        "ansidecl.h",
        "bfdlink.h",
        "ctf.h",
        "ctf-api.h",
        "diagnostics.h",
        "dis-asm.h",
        "plugin-api.h",
        "sframe.h",
        "sframe-api.h",
        "symcat.h",
    ],
    copts = COPTS,
    includes = ["."],
)
