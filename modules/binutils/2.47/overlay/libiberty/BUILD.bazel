"""libiberty - the GNU support library every binutils program links (libiberty/Makefile.in)."""

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc_autoconf//autoconf:autoconf.bzl", "autoconf")
load("@rules_cc_autoconf//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
load("@rules_cc_autoconf//autoconf:autoconf_srcs.bzl", "autoconf_srcs")
load("@rules_cc_autoconf//autoconf:checks.bzl", "checks", "macros")
load("//:platforms.bzl", "platform_setting")
load("//:targets.bzl", "PLATFORMS")

package(default_visibility = ["//:__subpackages__"])

# AM_BINUTILS_WARNINGS turns -Werror on for this development snapshot;
# building a release-grade library with a fixed warning set that another
# compiler may not share is not useful here, so warnings are off.
COPTS = select({
    "@rules_cc//cc/compiler:clang-cl": ["/w"],
    "@rules_cc//cc/compiler:msvc-cl": ["/w"],
    "//conditions:default": ["-w"],
}) + select({
    # GCC_CET_HOST_FLAGS (config/cet.m4): `-fcf-protection` for the host
    # libraries on Linux/x86 whenever the compiler and assembler accept it,
    # which every toolchain able to build this release does.
    ":_linux_x86": ["-fcf-protection"],
    "//conditions:default": [],
})

# cet.m4's `i[34567]86-*-linux* | x86_64-*-linux*`, over the platform table.
selects.config_setting_group(
    name = "_linux_x86",
    match_any = [
        platform_setting(key)
        for key, data in PLATFORMS.items()
        if "-linux" in data["triple"] and data["triple"].split("-")[0] in ("i686", "x86_64")
    ],
)

