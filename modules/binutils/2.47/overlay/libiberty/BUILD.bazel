# known in advance and the probes are skipped (`setobjs=yes`).  These are
# the AC_LIBOBJs of that arm; every other name in REPLACE_FUNCS gets HAVE_*.
MINGW_LIBOBJS = [
    "asprintf",
    "basename",
    "bcmp",
    "bcopy",
    "bzero",
