"""Build-time helpers of the module; nothing here is installed."""

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

package(default_visibility = ["//:__subpackages__"])

# <filesystem> needs C++17; clang-cl takes the MSVC spelling.
COPTS = select({
    "@rules_cc//cc/compiler:clang-cl": [
        "/std:c++17",
        "/w",
    ],
    "@rules_cc//cc/compiler:msvc-cl": [
        "/std:c++17",
        "/w",
    ],
    "//conditions:default": [
        "-std=c++17",
        "-w",
    ],
})

# Runs a program with a working directory, extra PATH entries and stdin or
# stdout redirected to files, so that actions which would otherwise need
# `run_shell` for `cd`, PATH and `<`/`>` can be plain `ctx.actions.run`.
cc_binary(
    name = "process_wrapper",
    srcs = ["process_wrapper.cc"],
    copts = COPTS,
)
