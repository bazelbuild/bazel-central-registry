load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

exports_files(["LICENSE"])

bool_flag(
    name = "profiling",
    build_setting_default = True,
)

config_setting(
    name = "daqp_profiling",
    flag_values = {":profiling": "true"},
)

bool_flag(
    name = "soft_weights",
    build_setting_default = True,
)

config_setting(
    name = "daqp_no_soft_weights",
    flag_values = {":soft_weights": "false"},
)

bool_flag(
    name = "single_precision",
    build_setting_default = False,
)

config_setting(
    name = "daqp_single_precision",
    flag_values = {":single_precision": "true"},
)

bool_flag(
    name = "faster_math",
    build_setting_default = True,
)

config_setting(
    name = "daqp_faster_math_windows",
    constraint_values = ["@platforms//os:windows"],
    flag_values = {":faster_math": "true"},
)

config_setting(
    name = "daqp_faster_math_enabled",
    flag_values = {":faster_math": "true"},
)

cc_library(
    name = "daqp",
    srcs = glob(["src/*.c"]) + ["codegen/codegen.c"],
    hdrs = glob(["include/*.h"]) + ["codegen/codegen.h"],
    copts = select({
        ":daqp_faster_math_windows": [],
        ":daqp_faster_math_enabled": [
            "-fassociative-math",
            "-fno-signed-zeros",
            "-fno-trapping-math",
        ],
        "//conditions:default": [],
    }),
    defines = select({
        ":daqp_profiling": ["PROFILING"],
        "//conditions:default": [],
    }) + select({
        ":daqp_no_soft_weights": ["DAQP_NO_SOFT_WEIGHTS"],
        "//conditions:default": [],
    }) + select({
        ":daqp_single_precision": ["DAQP_SINGLE_PRECISION"],
        "//conditions:default": [],
    }),
    includes = [
        "codegen",
        "include",
    ],
    linkopts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-lm"],
    }),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "daqp_eigen",
    srcs = ["interfaces/daqp-eigen/daqp.cpp"],
    hdrs = ["interfaces/daqp-eigen/daqp.hpp"],
    includes = ["interfaces/daqp-eigen"],
    visibility = ["//visibility:public"],
    deps = [
        ":daqp",
        "@eigen",
    ],
)

[
    cc_test(
        name = test_src.removeprefix("interfaces/daqp-eigen/tests/").removesuffix(".cpp"),
        size = "small",
        srcs = [test_src],
        # Needed for M_PI on MSVC (used by 15_degenerate_lp_skip).
        local_defines = ["_USE_MATH_DEFINES"],
        deps = [":daqp_eigen"],
    )
    for test_src in glob(["interfaces/daqp-eigen/tests/*.cpp"])
]
