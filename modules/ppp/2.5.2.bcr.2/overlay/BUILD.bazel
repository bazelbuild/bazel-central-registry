load("@bazel_skylib//lib:selects.bzl", "selects")
load(":autoconf.bzl", "autoconf_targets")

# The targets of configure.ac and the Makefile.am files, declared by the generated
# autoconf.bzl beside this file; this file is hand-written and kept as it is.  A target
# added below is the module's own; one named like a generated target replaces it at the
# next conversion.
autoconf_targets()

# configure ties two options to --enable-microsoft-extensions ("Disable Microsoft
# extensions will remove CHAP, MPPE and PEAP support"): PEAP and MS-LANMAN only
# build when that option is on too.  decisions.bzl selects on these groups.
selects.config_setting_group(
    name = "peap_with_microsoft_extensions",
    match_all = [
        ":microsoft_extensions_enabled",
        ":peap_enabled",
    ],
    visibility = ["//:__subpackages__"],
)

selects.config_setting_group(
    name = "mslanman_with_microsoft_extensions",
    match_all = [
        ":microsoft_extensions_enabled",
        ":mslanman_enabled",
    ],
    visibility = ["//:__subpackages__"],
)
