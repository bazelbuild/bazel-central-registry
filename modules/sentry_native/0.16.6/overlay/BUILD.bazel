        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//bazel:breakpad_core_services_compat"],
)

# Crashpad's libc and SDK wrappers depend on #include_next, so their roots must
# precede the toolchain's system headers. Virtual include trees from ordinary
# header-only cc_library targets provide that ordering on Bazel 8 and 9.
# Bazel normalizes the reserved physical external/crashpad prefix away when the
# repository is consumed as a module, so the helper selects the corresponding
# root- or external-repository prefix.
cc_library(
    name = "_crashpad_compat_linux_shadow_headers",
    hdrs = CRASHPAD_COMPAT_LINUX_SHADOW_HDRS,
    strip_include_prefix = crashpad_compat_strip_prefix("linux"),
    target_compatible_with = crashpad_supported_platforms() + select({
        "@platforms//os:linux": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
)

