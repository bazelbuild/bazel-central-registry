genrule(
    name = "_sentry_embedded_info",
    outs = ["_sentry_embedded_info.cpp"],
    cmd = """
set -eu
sdk_version='$(SENTRY_SDK_VERSION_VALUE)'
version_base="$${sdk_version%%[-+]*}"
platform='$(SENTRY_BUILD_PLATFORM_NAME_VALUE)'
if [ -z "$$platform" ]; then
  platform='""" + select({
        "@platforms//os:linux": "Linux",
        "@platforms//os:macos": "Darwin",
        "//conditions:default": "",
    }) + """'
fi
build_id='$(SENTRY_BUILD_ID_VALUE)'
if [ -z "$$build_id" ]; then
  case "$$sdk_version" in
    "$$version_base"+*) build_id="$${sdk_version#*+}" ;;
    *) build_id='unstamped' ;;
  esac
fi
build_variant='$(SENTRY_BUILD_VARIANT_VALUE)'
printf '%s\n' \\
  '#include "sentry.h"' \\
  '' \\
  'extern "C" SENTRY_API const char sentry_library_info[];' \\
  > "$@"
printf 'extern "C" SENTRY_API const char sentry_library_info[] = "SENTRY_VERSION:%s;PLATFORM:%s;BUILD:%s;VARIANT:%s;CONFIG:%s;END";\n' \\
  "$$version_base" "$$platform" "$$build_id" "$$build_variant" '$(COMPILATION_MODE)' \\
  >> "$@"
""",
    toolchains = [
        "//config:build_id",
        "//config:build_platform_name",
        "//config:build_variant",
        "//config:sdk_version",
    ],
    visibility = ["//visibility:private"],
)

