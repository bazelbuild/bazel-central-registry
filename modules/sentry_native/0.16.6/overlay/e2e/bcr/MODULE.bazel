module(name = "sentry_native_consumer")

bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "sentry_native", version = "0.16.6")

bazel_dep(name = "llvm", version = "0.8.21", dev_dependency = True)

local_path_override(
    module_name = "sentry_native",
    path = "../..",
)

osx = use_extension("@llvm//extensions:osx.bzl", "osx", dev_dependency = True)
osx.frameworks(names = [
    "ATS",
    "AppKit",
    "ApplicationServices",
    "CFNetwork",
    "ColorSync",
    "CoreData",
    "CoreFoundation",
    "CoreGraphics",
    "CoreImage",
    "CoreServices",
    "CoreText",
    "CoreVideo",
    "DiskArbitration",
    "Foundation",
    "FontServices",
    "HIServices",
    "IOKit",
    "IOSurface",
    "ImageIO",
    "Kernel",
    "Metal",
    "OSLog",
    "OpenGL",
    "PrintCore",
    "QD",
    "QuartzCore",
    "Security",
    "SpeechSynthesis",
    "Symbols",
    "SystemConfiguration",
    "UniformTypeIdentifiers",
])
osx.libraries(names = ["libbsm"])

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)
