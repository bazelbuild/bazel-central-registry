load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_binary(
    name = "smoke",
    srcs = ["smoke.c"],
    deps = ["@sentry_native//:sentry"],
)

cc_test(
    name = "crashpad_smoke_test",
    size = "small",
    srcs = ["smoke.c"],
    args = ["$(location @sentry_native//:crashpad_handler)"],
    data = ["@sentry_native//:crashpad_handler"],
    target_compatible_with = select({
        "@sentry_native//config:backend_crashpad_or_auto_stacktrace_disabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["@sentry_native//:sentry"],
)

cc_test(
    name = "shared_crashpad_smoke_test",
    size = "small",
    srcs = ["smoke.c"],
    args = ["$(location @sentry_native//:crashpad_handler)"],
    data = ["@sentry_native//:crashpad_handler"],
    target_compatible_with = select({
        "@sentry_native//config:backend_crashpad_or_auto_stacktrace_disabled": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["@sentry_native//:sentry_shared_library"],
)

cc_binary(
    name = "shared_smoke",
    srcs = ["smoke.c"],
    deps = ["@sentry_native//:sentry_shared_library"],
)
