load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "migcom_parser",
    srcs = [
        "migcom/lexxer.c",
        "migcom/parser.c",
    ],
    hdrs = ["migcom/parser.h"],
    strip_include_prefix = "migcom",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["@apple_mig//:__pkg__"],
    deps = ["@apple_mig//:migcom_headers"] + select({
        "@platforms//os:linux": ["@apple_mig//:migcom_non_apple_headers"],
        "//conditions:default": [],
    }),
)

exports_files([
    "BUILD.apple_mig.bazel",
    "regenerate_migcom_parser.sh",
])
