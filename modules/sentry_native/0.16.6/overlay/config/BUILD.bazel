load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "int_flag", "string_flag")

package(default_visibility = ["//visibility:public"])

string_flag(
    name = "backend",
    build_setting_default = "auto",
    values = [
        "auto",
        "breakpad",
        "crashpad",
        "custom",
        "inproc",
        "native",
        "none",
    ],
)

string_flag(
    name = "transport",
    build_setting_default = "auto",
    values = [
        "auto",
        "curl",
        "custom",
        "none",
        "pshttp",
        "winhttp",
    ],
)

string_flag(
    name = "screenshot",
    build_setting_default = "auto",
    values = [
        "auto",
        "custom",
        "none",
        "windows",
    ],
)

string_flag(
    name = "link_curl",
    build_setting_default = "auto",
    values = [
        "auto",
        "off",
        "on",
    ],
)

bool_flag(
    name = "transport_compression",
    build_setting_default = False,
)

bool_flag(
    name = "crashpad_stacktrace",
    build_setting_default = False,
)

bool_flag(
    name = "integration_platform",
    build_setting_default = False,
)

bool_flag(
    name = "integration_qt",
    build_setting_default = False,
)

bool_flag(
    name = "embed_info",
    build_setting_default = False,
)

string_flag(
    name = "sdk_name",
    build_setting_default = "sentry.native",
    make_variable = "SENTRY_SDK_NAME_VALUE",
)

string_flag(
    name = "sdk_version",
    build_setting_default = "0.16.6",
    make_variable = "SENTRY_SDK_VERSION_VALUE",
)

int_flag(
    name = "handler_stack_size",
    build_setting_default = 64,
    make_variable = "SENTRY_HANDLER_STACK_SIZE_VALUE",
)

int_flag(
    name = "batcher_buffer_count",
    build_setting_default = 3,
    make_variable = "SENTRY_BATCHER_BUFFER_COUNT_VALUE",
)

string_flag(
    name = "build_platform_name",
    build_setting_default = "",
    make_variable = "SENTRY_BUILD_PLATFORM_NAME_VALUE",
)

string_flag(
    name = "build_variant",
    build_setting_default = "",
    make_variable = "SENTRY_BUILD_VARIANT_VALUE",
)

string_flag(
    name = "build_id",
    build_setting_default = "",
    make_variable = "SENTRY_BUILD_ID_VALUE",
)

string_flag(
    name = "link_pthread",
    build_setting_default = "auto",
    values = [
        "auto",
        "off",
        "on",
    ],
)

label_flag(
    name = "breakpad_client",
    build_setting_default = "//:breakpad_client",
)

label_flag(
    name = "libunwind",
    build_setting_default = "//vendor/libunwind:unwind",
)

label_flag(
    name = "libunwind_remote",
    build_setting_default = "//vendor/libunwind:unwind_remote",
)

label_flag(
    name = "custom_backend",
    build_setting_default = "//bazel:missing_custom_extension",
)

label_flag(
    name = "custom_screenshot",
    build_setting_default = "//bazel:missing_custom_extension",
)

label_flag(
    name = "custom_transport",
    build_setting_default = "//bazel:missing_custom_extension",
)

label_flag(
    name = "platform_integration",
    build_setting_default = "//bazel:missing_custom_extension",
)

label_flag(
    name = "qt_core",
    build_setting_default = "//bazel:missing_custom_extension",
)

[
    config_setting(
        name = "backend_{}".format(value),
        flag_values = {":backend": value},
    )
    for value in [
        "auto",
        "breakpad",
        "crashpad",
        "custom",
        "inproc",
        "native",
        "none",
    ]
]

[
    config_setting(
        name = "link_curl_{}".format(value),
        flag_values = {":link_curl": value},
    )
    for value in [
        "auto",
        "off",
        "on",
    ]
]

[
    config_setting(
        name = "link_pthread_{}".format(value),
        flag_values = {":link_pthread": value},
    )
    for value in [
        "auto",
        "off",
        "on",
    ]
]

selects.config_setting_group(
    name = "transport_curl_enabled",
    match_any = [
        ":transport_auto",
        ":transport_curl",
    ],
)

selects.config_setting_group(
    name = "link_curl_auto_or_on",
    match_any = [
        ":link_curl_auto",
        ":link_curl_on",
    ],
)

selects.config_setting_group(
    name = "link_curl_auto_or_off",
    match_any = [
        ":link_curl_auto",
        ":link_curl_off",
    ],
)

selects.config_setting_group(
    name = "sentry_curl_linked",
    match_all = [
        ":transport_curl_enabled",
        ":link_curl_auto_or_on",
    ],
)

selects.config_setting_group(
    name = "sentry_curl_runtime_loaded",
    match_all = [
        ":transport_curl_enabled",
        ":link_curl_off",
    ],
)

selects.config_setting_group(
    name = "sentry_crash_curl_linked",
    match_all = [
        ":transport_curl_enabled",
        ":link_curl_on",
    ],
)

selects.config_setting_group(
    name = "sentry_crash_curl_runtime_loaded",
    match_all = [
        ":transport_curl_enabled",
        ":link_curl_auto_or_off",
    ],
)

config_setting(
    name = "transport_compression_enabled",
    flag_values = {":transport_compression": "true"},
)

config_setting(
    name = "crashpad_stacktrace_disabled",
    flag_values = {":crashpad_stacktrace": "false"},
)

config_setting(
    name = "crashpad_stacktrace_enabled",
    flag_values = {":crashpad_stacktrace": "true"},
)

selects.config_setting_group(
    name = "backend_crashpad_or_auto",
    match_any = [
        ":backend_auto",
        ":backend_crashpad",
    ],
)

selects.config_setting_group(
    name = "backend_crashpad_or_auto_stacktrace_disabled",
    match_all = [
        ":backend_crashpad_or_auto",
        ":crashpad_stacktrace_disabled",
    ],
)

config_setting(
    name = "integration_platform_enabled",
    flag_values = {":integration_platform": "true"},
)

config_setting(
    name = "integration_qt_enabled",
    flag_values = {":integration_qt": "true"},
)

config_setting(
    name = "embed_info_enabled",
    flag_values = {":embed_info": "true"},
)

selects.config_setting_group(
    name = "macos_supported",
    match_any = [
        ":macos_aarch64",
        ":macos_x86_64",
    ],
)

selects.config_setting_group(
    name = "macos_embed_info_enabled",
    match_all = [
        ":embed_info_enabled",
        ":macos_supported",
    ],
)

selects.config_setting_group(
    name = "backend_breakpad_macos",
    match_all = [
        ":backend_breakpad",
        ":macos_supported",
    ],
)

selects.config_setting_group(
    name = "backend_native_macos",
    match_all = [
        ":backend_native",
        ":macos_supported",
    ],
)

config_setting(
    name = "linux_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "linux_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
)

config_setting(
    name = "macos_x86_64",
    constraint_values = [
        "@platforms//cpu:x86_64",
        "@platforms//os:macos",
    ],
)

config_setting(
    name = "macos_aarch64",
    constraint_values = [
        "@platforms//cpu:aarch64",
        "@platforms//os:macos",
    ],
)

[
    config_setting(
        name = "transport_{}".format(value),
        flag_values = {":transport": value},
    )
    for value in [
        "auto",
        "curl",
        "custom",
        "none",
        "pshttp",
        "winhttp",
    ]
]

[
    config_setting(
        name = "screenshot_{}".format(value),
        flag_values = {":screenshot": value},
    )
    for value in [
        "auto",
        "custom",
        "none",
        "windows",
    ]
]
