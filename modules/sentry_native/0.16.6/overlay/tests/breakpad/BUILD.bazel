load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:private"])

_SUPPORTED_PLATFORMS = select({
    "//config:linux_aarch64": [],
    "//config:linux_x86_64": [],
    "//config:macos_aarch64": [],
    "//config:macos_x86_64": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_library(
    name = "crash_artifact_fixture",
    srcs = ["crash_artifact_fixture.c"],
    hdrs = ["crash_artifact_fixture.h"],
    target_compatible_with = _SUPPORTED_PLATFORMS,
    deps = ["//:sentry"],
)

cc_library(
    name = "shared_crash_artifact_fixture",
    srcs = ["crash_artifact_fixture.c"],
    hdrs = ["crash_artifact_fixture.h"],
    target_compatible_with = _SUPPORTED_PLATFORMS,
    deps = ["//:sentry_shared_library"],
)

cc_test(
    name = "crash_artifact_test",
    size = "small",
    srcs = ["crash_artifact_test.c"],
    target_compatible_with = _SUPPORTED_PLATFORMS + select({
        "//config:backend_breakpad": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//config:transport_none": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":crash_artifact_fixture"],
)

cc_test(
    name = "shared_crash_artifact_test",
    size = "small",
    srcs = ["crash_artifact_test.c"],
    target_compatible_with = _SUPPORTED_PLATFORMS + select({
        "//config:backend_breakpad": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//config:transport_none": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":shared_crash_artifact_fixture"],
)
