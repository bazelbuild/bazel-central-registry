load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:private"])

_SUPPORTED_PLATFORMS = select({
    "//config:linux_aarch64": [],
    "//config:linux_x86_64": [],
    "//config:macos_aarch64": [],
    "//config:macos_x86_64": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

_CRASHPAD_CONFIGURATION = select({
    "//config:backend_crashpad_or_auto_stacktrace_disabled": [],
    "//conditions:default": ["@platforms//:incompatible"],
}) + select({
    "//config:transport_auto": [],
    "//config:transport_none": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_test(
    name = "crash_artifact_test",
    size = "medium",
    srcs = ["crash_artifact_test.c"],
    args = ["$(location //:crashpad_handler)"],
    data = ["//:crashpad_handler"],
    target_compatible_with = _SUPPORTED_PLATFORMS + _CRASHPAD_CONFIGURATION,
    deps = [
        "//:sentry",
        "@zlib",
    ],
)

cc_test(
    name = "shared_crash_artifact_test",
    size = "medium",
    srcs = ["crash_artifact_test.c"],
    args = ["$(location //:crashpad_handler)"],
    data = ["//:crashpad_handler"],
    target_compatible_with = _SUPPORTED_PLATFORMS + _CRASHPAD_CONFIGURATION,
    deps = [
        "//:sentry_shared_library",
        "@zlib",
    ],
)

cc_test(
    name = "invalid_handler_test",
    size = "small",
    srcs = ["invalid_handler_test.c"],
    target_compatible_with = _SUPPORTED_PLATFORMS + _CRASHPAD_CONFIGURATION,
    deps = ["//:sentry"],
)
