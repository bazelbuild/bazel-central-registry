load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(default_visibility = ["//visibility:private"])

cc_test(
    name = "crash_artifact_test",
    size = "medium",
    srcs = ["crash_artifact_test.c"],
    args = ["$(location //:sentry_crash)"],
    data = ["//:sentry_crash"],
    target_compatible_with = select({
        "//config:linux_aarch64": [],
        "//config:linux_x86_64": [],
        "//config:macos_aarch64": [],
        "//config:macos_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//config:backend_native": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//config:transport_none": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//:sentry"],
)

cc_test(
    name = "shared_crash_artifact_test",
    size = "medium",
    srcs = ["crash_artifact_test.c"],
    args = ["$(location //:sentry_crash)"],
    data = ["//:sentry_crash"],
    target_compatible_with = select({
        "//config:linux_aarch64": [],
        "//config:linux_x86_64": [],
        "//config:macos_aarch64": [],
        "//config:macos_x86_64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//config:backend_native": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//config:transport_none": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = ["//:sentry_shared_library"],
)
