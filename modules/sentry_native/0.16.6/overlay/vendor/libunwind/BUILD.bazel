# BCR overlay for the libunwind implementation vendored by sentry-native.
# Source groups and configuration follow this directory's CMakeLists.txt. The
# generated public common header is materialized directly from libunwind's
# checked-in CMake template instead of copying its implementation into overlay.

load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

