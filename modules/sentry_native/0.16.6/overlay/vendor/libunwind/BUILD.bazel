expand_template(
    name = "libunwind_common_header",
    out = "bazel_include/libunwind-common.h",
    substitutions = {},
    template = "cmake/libunwind-common.h.cmake.in",
)

_HDRS = glob([
    "bazel_include/*.h",
    "include/**/*.h",
    "src/**/*.h",
]) + [":libunwind_common_header"]

_TEXTUAL_HDRS = glob(["src/**/G*.c"]) + ["src/elfxx.c"]

_ARCHITECTURE_DEFINES = select({
    "//config:linux_aarch64": ["UNW_TARGET_AARCH64=1"],
    "//config:linux_x86_64": ["UNW_TARGET_X86_64=1"],
    "//conditions:default": [],
})

_ARCHITECTURE_INCLUDES = select({
    "//config:linux_aarch64": ["include/tdep-aarch64"],
    "//config:linux_x86_64": ["include/tdep-x86_64"],
    "//conditions:default": [],
})

_ARCHITECTURE_SRCS = select({
    "//config:linux_aarch64": _AARCH64_SRCS,
    "//config:linux_x86_64": _X86_64_SRCS,
    "//conditions:default": [],
})

_SUPPORTED_LINUX_PLATFORMS = select({
    "//config:linux_aarch64": [],
    "//config:linux_x86_64": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

cc_library(
    name = "unwind",
    srcs = _COMMON_SRCS + _LOCAL_SRCS + _DWARF_SRCS + _ARCHITECTURE_SRCS,
    hdrs = _HDRS,
    copts = [
        "-std=gnu99",
        "-w",
    ],
    includes = [
        "bazel_include",
        "include",
        "src",
    ] + _ARCHITECTURE_INCLUDES,
    linkopts = [
        "-ldl",
        "-lpthread",
    ],
    local_defines = [
        "HAVE_CONFIG_H",
        "_GNU_SOURCE",
    ] + _ARCHITECTURE_DEFINES,
    target_compatible_with = _SUPPORTED_LINUX_PLATFORMS,
    textual_hdrs = _TEXTUAL_HDRS,
    visibility = ["//:__pkg__"],
)

# Exact superset built by upstream when LIBUNWIND_BUILD_REMOTE is enabled for
# the native crash daemon: local unwind, generic _U<arch>, and ptrace _UPT.
cc_library(
    name = "unwind_remote",
    srcs = _COMMON_SRCS + _LOCAL_SRCS + _DWARF_SRCS + _GENERIC_MI_SRCS + _GENERIC_DWARF_SRCS + _PTRACE_SRCS + _ARCHITECTURE_SRCS + select({
        "//config:linux_aarch64": _AARCH64_GENERIC_SRCS,
        "//config:linux_x86_64": _X86_64_GENERIC_SRCS,
        "//conditions:default": [],
    }),
    hdrs = _HDRS,
    copts = [
        "-std=gnu99",
        "-w",
    ],
    includes = [
        "bazel_include",
        "include",
        "src",
    ] + _ARCHITECTURE_INCLUDES,
    linkopts = [
        "-ldl",
        "-lpthread",
    ],
    local_defines = [
        "HAVE_CONFIG_H",
        "_GNU_SOURCE",
    ] + _ARCHITECTURE_DEFINES,
    target_compatible_with = _SUPPORTED_LINUX_PLATFORMS,
    textual_hdrs = _TEXTUAL_HDRS,
    visibility = ["//:__pkg__"],
)
