module(
    name = "sentry_native",
    version = "0.16.6",
    bazel_compatibility = [">=8.4.2"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "curl", version = "8.21.0.bcr.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_python", version = "1.8.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "zlib", version = "1.3.2")

# Chromium uses this cross-platform port of Apple's open-source Mach Interface
# Generator when generating Crashpad's macOS interfaces on Linux hosts. The
# generated lexer and parser sources are supplied by this repository so normal
# builds do not require ambient flex or bison executables.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "apple_mig",
    build_file = "//bazel/apple_mig:BUILD.apple_mig.bazel",
    canonical_id = "apple-mig-bootstrap_cmds-138-f337e600741638896fb6056ce87c6479f74b89a3",
    sha256 = "aba7ae76ecfc18e895f6f40c39d2b0bdd330aa535bb8bf9703d08b13772be6d0",
    strip_prefix = "bootstrap_cmds-f337e600741638896fb6056ce87c6479f74b89a3",
    urls = ["https://github.com/markmentovai/bootstrap_cmds/archive/f337e600741638896fb6056ce87c6479f74b89a3.tar.gz"],
)

# Root-only compiler and cross-platform test toolchains. Production BUILD and
# .bzl files must remain usable when this repository is a non-root dependency
# and this module is therefore absent.
bazel_dep(name = "llvm", version = "0.8.21", dev_dependency = True)

# Crashpad's Mini Chromium layer reaches these frameworks through AppKit and
# ApplicationServices umbrella headers. A development-only tag extends LLVM's
# own hermetic SDK repository without importing that repository into this
# module's published dependency graph.
osx = use_extension("@llvm//extensions:osx.bzl", "osx", dev_dependency = True)
osx.frameworks(names = [
    "ATS",
    "AppKit",
    "ApplicationServices",
    "CFNetwork",
    "ColorSync",
    "CoreData",
    "CoreFoundation",
    "CoreGraphics",
    "CoreImage",
    "CoreServices",
    "CoreText",
    "CoreVideo",
    "DiskArbitration",
    "Foundation",
    "FontServices",
    "HIServices",
    "IOKit",
    "IOSurface",
    "ImageIO",
    "Kernel",
    "Metal",
    "OSLog",
    "OpenGL",
    "PrintCore",
    "QD",
    "QuartzCore",
    "Security",
    "SpeechSynthesis",
    "Symbols",
    "SystemConfiguration",
    "UniformTypeIdentifiers",
])
osx.libraries(names = ["libbsm"])

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)
