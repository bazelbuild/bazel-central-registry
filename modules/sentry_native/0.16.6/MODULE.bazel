module(
    name = "sentry_native",
    version = "0.16.6",
    bazel_compatibility = [">=8.4.2"],
)

bazel_dep(name = "apple_mig", version = "138.0.1")
bazel_dep(name = "apple_support", version = "2.8.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "curl", version = "8.21.0.bcr.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_python", version = "1.8.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "zlib", version = "1.3.2")

# Root-only compiler and cross-platform test toolchains. Production BUILD and
# .bzl files must remain usable when this repository is a non-root dependency
# and this module is therefore absent.
bazel_dep(name = "llvm", version = "0.8.21", dev_dependency = True)

# Crashpad's Mini Chromium layer reaches these frameworks through AppKit and
# ApplicationServices umbrella headers. A development-only tag extends LLVM's
# own hermetic SDK repository without importing that repository into this
# module's published dependency graph.
osx = use_extension("@llvm//extensions:osx.bzl", "osx", dev_dependency = True)
osx.frameworks(names = [
    "ATS",
    "AppKit",
    "ApplicationServices",
    "CFNetwork",
    "ColorSync",
    "CoreData",
    "CoreFoundation",
    "CoreGraphics",
    "CoreImage",
    "CoreServices",
    "CoreText",
    "CoreVideo",
    "DiskArbitration",
    "Foundation",
    "FontServices",
    "HIServices",
    "IOKit",
    "IOSurface",
    "ImageIO",
    "Kernel",
    "Metal",
    "OSLog",
    "OpenGL",
    "PrintCore",
    "QD",
    "QuartzCore",
    "Security",
    "SpeechSynthesis",
    "Symbols",
    "SystemConfiguration",
    "UniformTypeIdentifiers",
])
osx.libraries(names = ["libbsm"])

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)
