            "src/ui_ui_sub.c",
            "src/urandom.c",
        ],
        hdrs = ["src/mpc.h"],
        copts = NO_WARNINGS,
        implementation_deps = [
            ":config_headers",
            ":linkopts",
            ":src/mpc_private_headers",
        ],
        include_prefix = ".",
        includes = ["src"],
        linkstatic = True,
        local_defines = ["HAVE_CONFIG_H"],
        strip_include_prefix = "/",
        visibility = ["//visibility:public"],
        deps = [
            "@gmp",
            "@mpfr",
