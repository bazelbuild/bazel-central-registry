visibility("private")

GNULIB_M4_DEPS = ["@rules_cc_autoconf//gnulib/m4/valgrind-tests"]

NO_WARNINGS = select({
    "@rules_cc//cc/compiler:clang-cl": ["/w"],
    "@rules_cc//cc/compiler:msvc-cl": ["/w"],
    "//conditions:default": ["-w"],
})

# buildifier: disable=unnamed-macro
def autoconf_targets():
    """The targets configure.ac and the Makefile.am files describe, in the package that calls this."""

    native.exports_files(["COPYING.LESSER"])

    license(
        name = "license_COPYING_LESSER",
        kind = "@package_metadata//licenses/spdx:LGPL-3.0-or-later",
        text = "COPYING.LESSER",
        visibility = ["//:__subpackages__"],
    )

    package_metadata(
        name = "package_metadata",
        attributes = [":license_COPYING_LESSER"],
        purl = purl.bazel(
            native.module_name(),
            native.module_version(),
        ),
        visibility = ["//:__subpackages__"],
    )

    autoconf_package_info(
        name = "package",
        package_name = "mpc",
        aliases = {
            "PACKAGE": "PACKAGE_TARNAME",
            "VERSION": "PACKAGE_VERSION",
        },
        module_bazel = "//:MODULE.bazel",
        package_bugreport = "mpc-discuss@inria.fr",
        strip_bcr_version = True,
        visibility = ["//:__subpackages__"],
    )

    bool_flag(
        name = "logging",
        build_setting_default = False,
        visibility = ["//visibility:public"],
    )

    native.config_setting(
        name = "logging_enabled",
        flag_values = {
            ":logging": "True",
        },
        visibility = ["//:__subpackages__"],
    )

    autoconf(
        name = "autoconf_gmp",
        cc_deps = ["@gmp"],
        checks = [
            checks.AC_CHECK_LIB("gmp", "__gmpz_init"),
        ],
        visibility = ["//:__subpackages__"],
        deps = [
            "@rules_cc_autoconf//autoconf/macros/AC_CANONICAL_BUILD",
            "@rules_cc_autoconf//autoconf/macros/AC_CANONICAL_HOST",
            "@rules_cc_autoconf//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
            "@rules_cc_autoconf//autoconf/macros/AC_CONFIG_AUX_DIR_DEFAULT",
            "@rules_cc_autoconf//autoconf/macros/AC_TYPE_SIZE_T",
        ],
    )

    autoconf(
        name = "autoconf",
        checks = [
            checks.M4_VARIABLE("lt_cv_ld_reload_flag", "-r"),
            checks.AC_SUBST("FILECMD", "file"),
            checks.AC_SUBST("OBJDUMP", "objdump"),
            checks.AC_SUBST("DLLTOOL", "dlltool"),
            checks.AC_SUBST("STRIP", "strip"),
            checks.AC_SUBST("RANLIB", "ranlib"),
            checks.AC_SUBST("MANIFEST_TOOL", "mt"),
        ] + macros.AC_CHECK_HEADERS(
            ["dlfcn.h"],
            includes = ["AC_INCLUDES_DEFAULT"],
        ) + macros.AC_CHECK_HEADERS(
            ["sys/time.h"],
        ) + [
            checks.AC_CHECK_HEADER("complex.h"),
        ] + macros.AC_CHECK_FUNCS(
            [
                "gettimeofday",
                "localeconv",
                "setlocale",
                "getrusage",
                "dup",
                "dup2",
            ],
        ) + [
            checks.AC_DEFINE(
                "MPC_NO_STREAM_REDIRECTION",
                1,
                requires = ["!ac_cv_func_dup"],
            ),
            checks.AC_SUBST("REQUIRES_GMP_VERSION", "5.0.0"),
            checks.AC_SUBST("REQUIRES_MPFR_VERSION", "4.1.0"),
            checks.AC_SUBST("GREP", "grep"),
            checks.AC_SEARCH_LIBS(
                "creal",
                ["m"],
                requires = ["ac_cv_header_complex_h"],
                subst = "ac_cv_search_creal_LIBS",
            ),
            checks.AC_TRY_LINK(
                name = "autoconf_probe_mpc_54",
                code = """\

               #include <complex.h>
int
main (void)
{

#ifdef _MSC_VER
   _Dcomplex x = 1.0 + 2.0 * I; return (creal (x) + cimag (x));
#else
   complex double x = 1.0 + 2.0 * I; return (creal (x) + cimag (x));
#endif


  ;
  return 0;
}

""",
                requires = ["ac_cv_header_complex_h"],
            ),
            checks.AC_SUBST(
                "MPC_HAVE_COMPLEX_H",
                condition = "autoconf_probe_mpc_54",
                if_false = 0,
                if_true = 1,
                requires = ["ac_cv_header_complex_h"],
            ),
        ] + select({
            "@platforms//os:macos": [
                checks.AC_SUBST("DSYMUTIL", "dsymutil"),
                checks.AC_SUBST("NMEDIT", "nmedit"),
                checks.AC_SUBST("LIPO", "lipo"),
                checks.AC_SUBST("OTOOL", "otool"),
                checks.AC_SUBST("OTOOL64", "otool64"),
            ],
            "//conditions:default": [],
        }) + select({
            ":logging_enabled": macros.AC_CHECK_HEADERS(
                ["dlfcn.h"],
            ) + [
                checks.AC_CHECK_LIB("dl", "dlsym"),
            ],
            "//conditions:default": [],
        }),
        visibility = ["//:__subpackages__"],
        deps = [
            ":autoconf_gmp",
            ":package",
            "@rules_cc_autoconf//autoconf/macros/AC_CANONICAL_BUILD",
            "@rules_cc_autoconf//autoconf/macros/AC_CANONICAL_HOST",
            "@rules_cc_autoconf//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
            "@rules_cc_autoconf//autoconf/macros/AC_CONFIG_AUX_DIR_DEFAULT",
            "@rules_cc_autoconf//autoconf/macros/AC_TYPE_SIZE_T",
        ] + GNULIB_M4_DEPS,
    )

    autoconf_hdr(
        name = "config",
        out = "config.h",
        template = "config.h.in",
        visibility = ["//:__subpackages__"],
        deps = [":autoconf"],
    )

    cc_library(
        name = "config_headers",
        hdrs = [
            ":config",
            ":src_mpc_h",
            ":src_mpc_impl_h",
        ] + native.glob(
            [
                "*.h",
                "src/*.h",
            ],
            allow_empty = True,
        ),
        include_prefix = ".",
        includes = ["src"],
        strip_include_prefix = "/",
        visibility = ["//:__subpackages__"],
    )

    autoconf_hdr(
        name = "src_mpc_h",
        out = "src/mpc.h",
        mode = "subst",
        template = "src/mpc.h.in",
        visibility = ["//:__subpackages__"],
        deps = [":autoconf"],
    )

    autoconf_hdr(
        name = "src_mpc_impl_h",
        out = "src/mpc-impl.h",
        mode = "subst",
        template = "src/mpc-impl.h.in",
        visibility = ["//:__subpackages__"],
        deps = [":autoconf"],
    )

    autoconf_hdr(
        name = "mpc_pc",
        out = "mpc.pc",
        mode = "subst",
        template = "mpc.pc.in",
        visibility = ["//:__subpackages__"],
        deps = [":autoconf"],
    )

    autoconf_linkopts(
        name = "linkopts",
        vars = ["ac_cv_search_creal_LIBS"],
        visibility = ["//:__subpackages__"],
        deps = [":autoconf"],
    )

    cc_library(
        name = "src/mpc_private_headers",
        hdrs = native.glob(
            ["src/**/*.h"],
            allow_empty = True,
            exclude = [
                "src/mpc.h",
            ],
        ),
        include_prefix = ".",
        includes = ["src"],
        strip_include_prefix = "/",
        visibility = ["//:__subpackages__"],
    )

    cc_library(
        name = "src/mpc",
        srcs = [
            "src/abs.c",
            "src/acos.c",
            "src/acosh.c",
            "src/add.c",
