load("@rules_cc//cc:cc_test.bzl", "cc_test")

# The upstream tests that run as a single MPI process. @mpich comes without a
# process manager, so the multi-process tests cannot be launched here.
[cc_test(
    name = test,
    srcs = [
        test + ".cpp",
        "gps_position.hpp",
        "mpi_test_utils.hpp",
    ],
    deps = [
        "@boost.iterator",
        "@boost.lexical_cast",
        "@boost.mpi",
        "@boost.serialization",
        "@boost.test//:hdrs",
    ],
) for test in [
    "all_gather_test",
    "all_reduce_test",
    "all_to_all_test",
    "cartesian_topology_init_test",
    "gather_test",
    "is_mpi_op_test",
    "mt_init_test",
    "mt_level_test",
    "sendrecv_test",
    "version_test",
    "wait_all_on_null",
    "wait_any_test",
]]
