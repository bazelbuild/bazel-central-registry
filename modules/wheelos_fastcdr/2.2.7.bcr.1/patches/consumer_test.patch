+++ test_module/binary_string_test.cc
@@ -0,0 +1,31 @@
+// Copyright 2026 WheelOS. All Rights Reserved.
+// SPDX-License-Identifier: Apache-2.0
+
+#include <iostream>
+#include <string>
+#include <vector>
+
+#include "fastcdr/Cdr.h"
+#include "fastcdr/FastBuffer.h"
+
+int main() {
+  char bytes[256]{};
+  eprosima::fastcdr::FastBuffer buffer(bytes, sizeof(bytes));
+  eprosima::fastcdr::Cdr writer(buffer);
+  const std::vector<std::string> expected = {
+      "", "plain", std::string("a\0b", 3), std::string("\0\0", 2),
+      std::string("end\0", 4)};
+  for (const auto& value : expected) {
+    writer << value;
+  }
+  eprosima::fastcdr::Cdr reader(buffer);
+  for (const auto& value : expected) {
+    std::string actual;
+    reader >> actual;
+    if (actual != value) {
+      std::cerr << "FastCDR binary string round trip changed data\n";
+      return 1;
+    }
+  }
+  return 0;
+}
