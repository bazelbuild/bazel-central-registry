module(
    name = "rules_wine",
    version = "0.1.3",
    bazel_compatibility = [">=8.5.0"],
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "bazel_lib", version = "3.0.0")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "nlohmann_json", version = "3.12.0.bcr.2")

# Windows forwarding needs the quoted-argument and UTF-8 fixes in 0.0.17.
bazel_dep(name = "hermetic_launcher", version = "0.0.17")
bazel_dep(name = "package_metadata", version = "0.0.6")

# hermetic_launcher ships native Windows ARM64 binaries without registrations.
launcher_dependencies = use_extension("@hermetic_launcher//launcher/private:extensions.bzl", "non_module_dependencies")
use_repo(launcher_dependencies, "finalize_stub_aarch64_windows", "runfiles_stub_aarch64_windows")

register_toolchains("//wine/private/launcher:all")

bazel_dep(name = "buildifier_prebuilt", version = "8.2.1", dev_dependency = True)
bazel_dep(name = "bazel_skylib", version = "1.9.2", dev_dependency = True)
bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.9.2", dev_dependency = True)
bazel_dep(name = "gazelle", version = "0.54.0", dev_dependency = True)
bazel_dep(name = "llvm", version = "0.8.26", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)

wine = use_extension("//wine/extension:wine.bzl", "wine", dev_dependency = True)
use_repo(wine, "wine_toolchains", "wine_tools_toolchains")

register_toolchains(
    "@wine_toolchains//:all",
    "@wine_tools_toolchains//:all",
    dev_dependency = True,
)
