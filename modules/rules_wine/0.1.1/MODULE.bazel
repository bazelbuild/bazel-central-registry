module(
    name = "rules_wine",
    version = "0.1.1",
    bazel_compatibility = [">=8.5.0"],
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.18")
bazel_dep(name = "hermetic_launcher", version = "0.0.16")
bazel_dep(name = "package_metadata", version = "0.0.6")

bazel_dep(name = "buildifier_prebuilt", version = "8.2.1", dev_dependency = True)
bazel_dep(name = "llvm", version = "0.8.26", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)

wine = use_extension("//wine/extension:wine.bzl", "wine", dev_dependency = True)
use_repo(wine, "wine_toolchains")

register_toolchains(
    "@wine_toolchains//:all",
    dev_dependency = True,
)
