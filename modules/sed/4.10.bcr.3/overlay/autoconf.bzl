def autoconf_targets():
    """The targets configure.ac and the Makefile.am files describe, in the package that calls this."""

    native.exports_files(["COPYING"])

    license(
        name = "license_COPYING",
        kind = "@package_metadata//licenses/spdx:GPL-3.0-or-later",
        text = "COPYING",
        visibility = ["//visibility:private"],
    )

    package_metadata(
        name = "package_metadata",
        attributes = [":license_COPYING"],
        purl = purl.bazel(
            native.module_name(),
            native.module_version(),
        ),
        visibility = ["//visibility:private"],
    )

    autoconf_package_info(
        name = "package",
        package_name = "GNU sed",
        aliases = {
            "PACKAGE": "PACKAGE_TARNAME",
            "VERSION": "PACKAGE_VERSION",
        },
        module_bazel = "//:MODULE.bazel",
        package_bugreport = "bug-sed@gnu.org",
        package_tarname = "sed",
        package_url = "https://www.gnu.org/software/sed/",
        strip_bcr_version = True,
        visibility = ["//visibility:private"],
    )

    for name, default in BOOL_OPTIONS.items():
        bool_flag(
            name = name,
            build_setting_default = default,
            visibility = ["//visibility:public"],
        )

    for name in BOOL_OPTIONS:
        native.config_setting(
            name = name + "_enabled",
            flag_values = {":" + name: "True"},
            visibility = ["//visibility:private"],
        )

    autoconf(
        name = "gl_CHECK_FUNCS_ANDROID_duplocale",
        checks = gl_macros.GL_CHECK_FUNCS_ANDROID(
            ["duplocale"],
            includes = ["#include <locale.h>"],
        ),
        visibility = ["//visibility:private"],
    )

    autoconf(
        name = "autoconf",
        checks = [
            checks.AC_SUBST(
                "GNULIB_UNISTD_H_GETOPT",
                1,
                requires = ["REPLACE_GETOPT!=0"],
            ),
        ] + macros.AC_CHECK_DECLS(
            [
                "memeq",
                "streq",
            ],
            compile_defines = SYSTEM_EXTENSIONS,
        ) + [
            checks.AC_DEFINE("GNULIB_STDIO_SINGLE_THREAD", 1),
            checks.AC_DEFINE("USE_UNLOCKED_IO", "GNULIB_STDIO_SINGLE_THREAD"),
            checks.AC_TRY_COMPILE(
                name = "ac_cv_c_vararrays",
                code = utils.AC_LANG_PROGRAM(
                    [
                        "#ifdef __STDC_NO_VLA__",
                        "#error no variable-length arrays",
                        "#endif",
                    ],
                    [
                        "int n = 1;",
                        "char a[n];",
                        "a[0] = 0;",
                        "return a[0];",
