                "sys/wait.h",
                "semaphore.h",
                "sys/single_threaded.h",
            ],
        ) + [
            checks.AC_DEFINE("GNULIB_NO_VLA", 1),
        ] + macros.AC_CHECK_HEADERS(
            [
                "errno.h",
                "mcheck.h",
            ],
            includes = ["AC_INCLUDES_DEFAULT"],
        ) + [
            checks.AC_CHECK_HEADER(
                "wctype.h",
                includes = ["AC_INCLUDES_DEFAULT"],
            ),
        ] + [
            checks.AC_SUBST(name, value)
            for name, value in GNULIB_MODULE_INDICATOR_TEST_SUBSTS.items()
        ] + [
            checks.AC_SUBST(name, 1)
            for name in GNULIB_MODULE_INDICATOR_SUBSTS
        ] + [
            checks.AC_DEFINE(name, 1)
            for name in GNULIB_MODULE_INDICATOR_DEFINES
        ] + [
            checks.AC_DEFINE(name, value)
            for name, value in GNULIB_MODULE_INDICATOR_TEST_DEFINES.items()
