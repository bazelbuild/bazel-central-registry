    package_version = "4.10",
)

# --enable-threads (line 23)
bool_flag(
    name = "enable_threads",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "threads_enabled",
    flag_values = {":enable_threads": "True"},
)

# --enable-i18n (line 122)
bool_flag(
    name = "enable_i18n",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "enable_i18n_setting",
    flag_values = {":enable_i18n": "True"},
)

COPTS = select({
    # Sed requires C11+ for `static_assert` via <assert.h> in several gnulib
    # sources (localeinfo.c etc.).
    "@rules_cc//cc/compiler:msvc-cl": [
        "/w",
        "/std:c11",
    ],
    "//conditions:default": [
        "-w",
        "-std=gnu11",
    ],
})

LOCAL_DEFINES = [
    "HAVE_CONFIG_H",
    # Seven gnulib lib/*.c files use bare C11 `static_assert` without
    # `#include <assert.h>`; surface the keyword mapping directly so config.h
    # doesn't need to gate on HAVE_C_STATIC_ASSERT (autoconf detects support
    # so the gate stays at 1 and config.h's define doesn't fire).
    "static_assert=_Static_assert",
] + select({
    # sed/compile.c calls C23 `unreachable()` directly; gnulib's stddef.h
    # polyfill is gated on HAVE_C_UNREACHABLE which rules_cc_autoconf's
    # macOS probe sets to 1 (probe uses C23, sed compiles at gnu11), so the
    # polyfill never fires.  Map onto the compiler builtin instead.
    "@rules_cc//cc/compiler:msvc-cl": [
        "unreachable()=__assume(0)",
        # lib/setlocale_null.c hardcodes a __declspec(dllimport) extern for
        # gl_get_setlocale_null_lock, but the static-link build of
        # setlocale-lock.c has no matching dllexport.  AVOID_ANY_THREADS
        # collapses the locking branch before that extern is seen.
        "AVOID_ANY_THREADS=1",
    ],
    "//conditions:default": [
        "unreachable=__builtin_unreachable",
    ],
})

# year2038: guarantees 64-bit time_t.  Mingw needs an opt-in macro; everywhere
# else modern time_t is the default.
autoconf(
    name = "m4_year2038",
    checks = select({
        "@platforms//os:windows": [
            checks.AC_DEFINE("__MINGW_USE_VC2005_COMPAT", 1),
        ],
        "//conditions:default": [],
    }),
)

# Upstream's gl_CHECK_FUNC_C32RTOMB probes c32rtomb at the autoconf toolchain's
# own compile flags rather than the consumer's; on macOS, libSystem's <uchar.h>
# hides the c32rtomb prototype unless a feature-test macro is set that
# -std=gnu11 doesn't activate, so the probe says "available" but sed's TU
# can't see the decl.  We sidestep the probe and pin HAVE_C32RTOMB from
# platform knowledge: Linux glibc has it; macOS at gnu11 doesn't expose the
# decl; MSVC has no <uchar.h> at all.  Other substs/cache vars come from the
# toolchain defaults + mbrtoc32's transitive :gl_C32RTOMB_SANITYCHECK dep.
autoconf(
    name = "m4_c32rtomb",
    checks = select({
        "@platforms//os:linux": [
            checks.AC_SUBST("HAVE_C32RTOMB", 1),
        ],
        "//conditions:default": [
            checks.AC_SUBST("HAVE_C32RTOMB", 0),
        ],
    }),
)

