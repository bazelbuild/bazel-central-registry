                 # GNULIB_VAPRINTF default recovered from gl_STDIO_H_REQUIRE_DEFAULTS.
                 checks.AC_SUBST("GNULIB_VAPRINTF", "0"),
                 # NEED_ACL_ENTRIES derived from vendored M4 macro gl_FUNC_ACL.
                 checks.AC_CHECK_FUNC(
                     "acl_entries",
                     define = "HAVE_ACL_ENTRIES",
                 ),
                 checks.AC_SUBST(
                     "NEED_ACL_ENTRIES",
                     condition = "ac_cv_func_acl_get_file && !ac_cv_func_acl_entries",
                     if_false = "0",
                     if_true = "1",
                 ),
                 # LIB_ACL from gl_FUNC_ACL is not provided by rules_cc_autoconf's gnulib port.
                 checks.AC_SEARCH_LIBS(
                     "acl_get_file",
                     ["acl"],
                     subst = "LIB_ACL_ACL_GET_FILE",
                 ),
                 checks.AC_SEARCH_LIBS(
                     "acl_trivial",
                     ["sec"],
                     subst = "LIB_ACL_ACL_TRIVIAL",
                 ),
                 # LIB_SELINUX from gl_LIBSELINUX is not provided by rules_cc_autoconf's gnulib port.
                 checks.AC_SEARCH_LIBS(
                     "getfilecon_raw",
                     [
                         "android-selinux",
                         "selinux",
                     ],
                     subst = "LIB_SELINUX",
                 ),
                 checks.AC_DEFINE(
                     "PACKAGE",
                     value = '"GNU sed"',
                 ),
                 checks.AC_DEFINE(
                     "VERSION",
                     value = '"4.10"',
                 ),
                 checks.AC_SUBST("USES_MSVCRT", "0"),
             ] + select({
                 ":with_selinux_setting": [
                     checks.AC_SUBST(
                         "with_selinux",
                         value = "1",
                     ),
                 ],
                 "//conditions:default": [
                     checks.AC_SUBST(
                         "with_selinux",
                         value = "0",
                     ),
                 ],
             }) +
             [
                 checks.AC_SUBST(
                     name,
                     value = value,
                 )
