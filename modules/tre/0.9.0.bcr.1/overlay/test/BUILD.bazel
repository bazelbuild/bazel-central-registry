load("@rules_cc//cc:cc_test.bzl", "cc_test")

# No test here does file I/O: the BCR matrix includes Windows, where a materialized
# runfiles tree is not guaranteed.

cc_test(
    name = "public_surface_test",
    size = "small",
    srcs = ["public_surface_test.c"],
    deps = ["@tre"],
)

cc_test(
    name = "posix_dropin_test",
    size = "small",
    srcs = ["posix_dropin_test.c"],
    deps = ["@tre//:posix"],
)

cc_test(
    name = "posix_isolation_test",
    size = "small",
    srcs = ["posix_isolation_test.c"],
    # The MSVC CRT ships no <regex.h> at all, so there is no platform header
    # for this test to land on and nothing to isolate :posix from.
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = ["@tre"],
)

cc_test(
    name = "newline_characterization_test",
    size = "small",
    srcs = ["newline_characterization_test.c"],
    deps = ["@tre"],
)
