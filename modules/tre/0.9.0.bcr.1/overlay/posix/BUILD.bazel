load("@rules_cc//cc:cc_library.bzl", "cc_library")

# A drop-in POSIX regex: real, unprefixed regcomp/regexec/regerror/regfree symbols, and a bare
# regex.h so a consumer writes #include <regex.h>.
cc_library(
    name = "posix",
    srcs = ["posix.c"],
    hdrs = ["regex.h"],
    strip_include_prefix = ".",
    visibility = ["//:__pkg__"],
    deps = ["//lib:tre"],
)
