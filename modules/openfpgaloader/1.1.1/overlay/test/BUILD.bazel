load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Cross-platform smoke tests: exercise the built binary end-to-end via
# googletest. Upstream ships no unit tests of its own, so this is what
# "compiles into something that remotely works" looks like without real
# hardware attached.
#
# The two targets are split so the libusb-exercising USB scan test can carry
# the `no-sandbox` tag on its own — libusb_init() fails inside Bazel's default
# sandbox because /dev/bus/usb and NETLINK sockets aren't reachable from
# there.

cc_test(
    name = "smoke_test",
    srcs = [
        "openfpga_test_util.hpp",
        "smoke_test.cc",
    ],
    data = ["@openfpgaloader//:openFPGALoader"],
    env = {
        "OPENFPGALOADER_RLOCATIONPATH": "$(rlocationpath @openfpgaloader//:openFPGALoader)",
    },
    deps = [
        "@googletest//:gtest_main",
        "@rules_cc//cc/runfiles",
    ],
)

cc_test(
    name = "usb_scan_test",
    srcs = [
        "openfpga_test_util.hpp",
        "usb_scan_test.cc",
    ],
    data = ["@openfpgaloader//:openFPGALoader"],
    env = {
        "OPENFPGALOADER_RLOCATIONPATH": "$(rlocationpath @openfpgaloader//:openFPGALoader)",
    },
    tags = ["no-sandbox"],
    deps = [
        "@googletest//:gtest_main",
        "@rules_cc//cc/runfiles",
    ],
)
