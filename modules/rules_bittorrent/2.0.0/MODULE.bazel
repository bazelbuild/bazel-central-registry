module(
    name = "rules_bittorrent",
    version = "2.0.0",
    compatibility_level = 0,
)

#bazel_dep(name = "bazel_skylib", version = "1.9.0", dev_dependency = True)
bazel_dep(name = "bazel_lib", version = "3.3.1", dev_dependency = True)
bazel_dep(name = "bazel_skylib_gazelle_plugin", version = "1.9.0", dev_dependency = True)
bazel_dep(name = "gazelle", version = "0.51.3", dev_dependency = True)

# Renders repo.bzl into docs/repo.md. Only the module itself generates the
# documentation, so this stays a dev dependency.
bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)
#bazel_dep(name = "rules_pkg", version = "1.2.0", dev_dependency = True)

bazel_dep(name = "rules_multitool", version = "1.11.1")

multitool = use_extension("@rules_multitool//multitool:extension.bzl", "multitool")
multitool.hub(
    # We must choose an alternate hub name to allow other modules to have their
    # own hubs.
    hub_name = "rules_bittorrent_multitool",
    lockfile = "//:multitool.lock.json",
)
use_repo(multitool, "multitool", "rules_bittorrent_multitool")

# repo.bzl runs rain from inside a repository rule, where toolchain resolution
# is not available. It reaches the per-platform binary repos directly, through
# these apparent names. Keep this list in sync with multitool.lock.json and
# with _TOOL_REPOS in repo.bzl.
use_repo(
    multitool,
    rain_linux_x86_64 = "rules_bittorrent_multitool.rain.linux_x86_64",
    rain_macos_arm64 = "rules_bittorrent_multitool.rain.macos_arm64",
    rain_macos_x86_64 = "rules_bittorrent_multitool.rain.macos_x86_64",
)
