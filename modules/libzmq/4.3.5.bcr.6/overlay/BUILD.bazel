""" Builds libzmq.
"""

load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
)

exports_files(["LICENSE"])

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MPL-2.0"],
    license_text = "LICENSE",
)

cc_library(
    name = "libzmq",
    srcs = glob(
        [
            "src/*.cpp",
            "src/*.hpp",
            "src/*.h",
        ],
        exclude = [
            "src/gssapi_*.cpp",
            "src/tipc_*.cpp",
            "src/vmci*.cpp",
            "src/ws_*.cpp",
            "src/wss_*.cpp",
        ],
    ),
    hdrs = glob(["include/*.h"]),
    copts = select({
        "@platforms//os:windows": [
            "/EHsc",
        ],
        "//conditions:default": [
            "-Wno-error=missing-braces",
            "-Wno-unused-variable",
        ],
    }),
    defines = select({
        "@platforms//os:windows": [
            "ZMQ_STATIC",
            "FD_SETSIZE=1024",
            "_CRT_SECURE_NO_WARNINGS",
            "_WINSOCK_DEPRECATED_NO_WARNINGS",
        ],
        "//conditions:default": [],
    }),
    includes = [
        "include",
        "src",
    ],
    linkopts = select({
        "@platforms//os:windows": [
            "ws2_32.lib",
            "rpcrt4.lib",
            "iphlpapi.lib",
        ],
        "@platforms//os:macos": [
            "-lpthread",
        ],
        "//conditions:default": [
            "-lpthread",
            "-lrt",
        ],
    }),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "libzmq_headers_only",
    hdrs = glob(["include/*.h"]),
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)
