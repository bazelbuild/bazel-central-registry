load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_package_metadata = [":package_metadata"],
    default_visibility = ["//visibility:public"],
)

exports_files(["LICENSE"])

# Sources of upstream's unit tests, built and run by the test module (tests/).
exports_files([
    "catch.hpp",
    "test.cxx",
    "test/multiple_inclusion_1.cxx",
    "test/multiple_inclusion_2.cxx",
    "test/windows_h.cxx",
])

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:MIT",
    text = "LICENSE",
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
)

# Header-only, like CMake's taywee::args: #include <args.hxx>.
cc_library(
    name = "args",
    hdrs = ["args.hxx"],
    includes = ["."],
)

alias(
    name = "taywee_args",
    actual = ":args",
)
