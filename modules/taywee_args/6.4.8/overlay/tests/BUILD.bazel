    name = "argstest_multiple_inclusion",
    srcs = [
        "@taywee_args//:test/multiple_inclusion_1.cxx",
        "@taywee_args//:test/multiple_inclusion_2.cxx",
    ],
    deps = ["@taywee_args//:args"],
)

