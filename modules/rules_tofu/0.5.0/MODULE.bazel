"""rules_tofu: Bazel rules for OpenTofu.

Downstream usage (see https://registry.bazel.build/modules/rules_tofu or the
GitHub releases page for the latest version):

    bazel_dep(name = "rules_tofu", version = "X.Y.Z")
    tofu = use_extension("@rules_tofu//toolchain:extensions.bzl", "tofu")
    # tofu.version(version = "1.12.0")  # optional override
    use_repo(tofu, "tofu_toolchains")
"""

# version is deliberately unset so the release tag is the single source of
# truth. publish-to-bcr patches the release version into the BCR entry's
# MODULE.bazel, and leaving the default here avoids issues when the module is
# consumed via non-registry overrides; see
# https://github.com/bazel-contrib/rules_go/issues/4380 and the note in
# bazel-contrib/rules-template's MODULE.bazel.
#
# Keep comments out of the module() call below: publish-to-bcr inserts
# version before the first ")" after "module(", so a parenthesis in a
# comment inside the call breaks MODULE.bazel (as happened in 0.1.1).
#
# Bazel 8.5.0 is the floor because it introduced extension facts, which
# tf_providers uses to record registry digests in MODULE.bazel.lock.
module(
    name = "rules_tofu",
    bazel_compatibility = [">=8.5.0"],
    version = "0.5.0",
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_go", version = "0.60.0")
bazel_dep(name = "gazelle", version = "0.40.0")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.26.3")

# The host Go SDK, which compiles the tools that
# tf_providers.from_lock and tf_modules.module run (see tf/private/host_tools.bzl).
use_repo(go_sdk, "go_host_compatible_sdk_label")

host_tools = use_repo_rule("//tf/private:host_tools.bzl", "host_tools")

host_tools(name = "rules_tofu_host_tools")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(
    go_deps,
    "com_github_hashicorp_hcl_v2",
    "com_github_opentofu_registry_address_v2",
)

tofu = use_extension("//toolchain:extensions.bzl", "tofu")
use_repo(tofu, "tofu_toolchains")

register_toolchains("@tofu_toolchains//:all")

# Import the @tf_providers hub outside the dev-only usage below. Libraries
# generated by tf_modules name their providers through @tf_providers, and a
# repository generated by an extension sees only repos visible to the module
# defining that extension.
tf_providers_hub = use_extension("//tf/providers:extensions.bzl", "tf_providers")
use_repo(tf_providers_hub, "tf_providers")

# Provider plugins, downloaded once per workspace and symlinked into plugin
# trees so `tofu init` runs offline. BUILD files name every provider through
# the hub, e.g. @tf_providers//hashicorp/aws. aws and google pin sha256
# directly; posthog takes its digests from the OpenTofu registry and records
# them in MODULE.bazel.lock.
#
# These declarations exist only for examples/aws, examples/gcp and
# examples/posthog, so the usage is marked dev_dependency. That keeps the
# example pins out of the published module, where they would affect downstream
# tf_providers version resolution.
#
# Every platform in sha256 is downloaded on every host. aws and google are
# ~170 MB per platform, so they pin only the platforms CI and maintainers build
# on; README.md shows the full map.
tf_providers = use_extension("//tf/providers:extensions.bzl", "tf_providers", dev_dependency = True)
tf_providers.provider(
    sha256 = {
        "linux_amd64": "49ecd456fb8fee5562725c36bd5992b6982704100ead0164d26c6cbb11b07653",
        "darwin_arm64": "b05796c799ab11b12f2510a06343d30fd61fdad09835ec24ac1741970a3d8f48",
    },
    source = "hashicorp/aws",
    version = "6.45.0",
)
tf_providers.provider(
    sha256 = {
        "linux_amd64": "84cba090b3d9eee432a5121e4484ef592976fc4918cb10eb0182dea00cecd8c1",
        "darwin_arm64": "46722e5509ba24cad6ab85cb5dae6f06e97e416660b68b8ff4cbce682f597d59",
    },
    source = "hashicorp/google",
    version = "7.32.0",
)
tf_providers.provider(
    source = "PostHog/posthog",
    version = "1.0.24",
)

# examples/lock takes its providers from a .terraform.lock.hcl instead, which
# Renovate and Dependabot can update. `@tf_providers//:pin` regenerates it.
tf_providers.from_lock(lock_file = "//examples/lock:.terraform.lock.hcl")

# Real modules for the examples under examples/modules:
# - label calls cloudposse/label/null from the OpenTofu registry;
# - stack calls a submodule of cloudposse/stack-config/yaml, which in turn
#   calls cloudposse/label/null and requires providers that the examples' lock
#   pins (//examples/lock);
# - git calls Cloud Posse's label module straight from GitHub, by tag.
tf_modules = use_extension("//tf/modules:extensions.bzl", "tf_modules", dev_dependency = True)
tf_modules.module(
    source = "cloudposse/label/null",
    version = "0.25.0",
)
tf_modules.module(
    source = "cloudposse/stack-config/yaml",
    version = "2.0.1",
)
tf_modules.module(
    name = "null_label",
    source = "git::https://github.com/cloudposse/terraform-null-label.git?ref=0.25.0",
)
use_repo(tf_modules, "tf_modules")

# unittest/asserts for the Starlark tests under //toolchain/tests,
# //tf/providers/tests and //tf/modules/tests. Dev-only, which is why those
# tests are subpackages: //toolchain:BUILD.bazel, //tf/providers:BUILD.bazel
# and //tf/modules:BUILD.bazel are loaded by downstream modules and must not
# reference a dev-only repo.
bazel_dep(name = "bazel_skylib", version = "1.9.2", dev_dependency = True)

# Bazel-in-Bazel integration tests under //tests/integration.
bazel_dep(name = "rules_bazel_integration_test", version = "0.37.1", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.6.1", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.2", dev_dependency = True)

# The Bazel those tests run inside themselves is the version of the Bazel
# running them: the pinned one, or USE_BAZEL_VERSION's. The .bzl file is not
# in a release (`tests` is left out); a module that depends on rules_tofu
# never loads it, since the one use of the rule is a dev dependency.
running_bazel = use_repo_rule("//tests/integration:running_bazel.bzl", "running_bazel")

running_bazel(
    name = "running_bazel",
    dev_dependency = True,
)

bazel_binaries = use_extension(
    "@rules_bazel_integration_test//:extensions.bzl",
    "bazel_binaries",
    dev_dependency = True,
)
bazel_binaries.download(version_file = "@running_bazel//:version")
use_repo(bazel_binaries, "bazel_binaries", "bazel_binaries_bazelisk", "build_bazel_bazel_version")

# cosign, for `bazel run //tools:update_versions` to verify an OpenTofu
# release's SHA256SUMS signature before pinning its digests. Digests are from
# cosign_checksums.txt on the sigstore/cosign release.
http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

[
    http_file(
        name = "cosign_" + platform,
        dev_dependency = True,
        executable = True,
        sha256 = sha256,
        urls = ["https://github.com/sigstore/cosign/releases/download/v3.1.4/cosign-" + platform.replace("_", "-")],
    )
    for platform, sha256 in [
        ("linux_amd64", "424e2c97d0b45fd7a6b608a87f090f35633f4c23ece5f092d48bba11aaf4bbfa"),
        ("linux_arm64", "ade83b7aac62e131cacfe96d958948b2150cc9efec46a570a2649b8e27dedad2"),
        ("darwin_amd64", "9d1e4abe2b6be279ed0d2ff706fde1ccd738747c834e3e6d44039c238867334f"),
        ("darwin_arm64", "9f9b8cd557cf2e5b3df3373a00baa005a86b02391e3e06dd0ce37b3a1533d3a4"),
    ]
]
