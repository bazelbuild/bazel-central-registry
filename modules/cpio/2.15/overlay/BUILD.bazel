autoconf(
    name = "autoconf",
    # The check list below follows `configure.ac` top to bottom.  Everything
    # cpio itself asks for -- its own `am/*.m4` and `m4/*.m4` macros, and the
    # Autoconf builtins it names -- is written out here rather than depended on,
    # so each entry can be read against the line of `configure.ac` it came from.
    # Only `gl_INIT` stays a dependency; see GL_INIT_DEPS for why.
    #
    # Where a probe is reached both from here and from `gl_INIT`, upstream runs
    # it once -- these are all AC_CHECK_*_ONCE, AC_REQUIRE or shared
    # `ac_cv_*` cache variables -- and the single result is shared.  The same
    # holds here, and it has to: a symbol may be defined only once per
    # `autoconf` target.  So the following are asked for by cpio but resolved
    # under GL_INIT_DEPS: AC_HEADER_MAJOR (configure.ac:40),
    # AC_REQUIRE([AC_STRUCT_ST_BLOCKS]) (m4/system.m4:19), `fchown` and `chown`
    # (gnulib `chown`), `lstat` (`lstat`), `sys/param.h` (`gnulib-common`),
    # `getopt.h` (`getopt`), `utime.h` (`utime_h`), and the `strdup`
    # declaration (`strdup`).
    checks = (
        # AC_SYS_LARGEFILE (configure.ac:39).
        [
            checks.AC_DEFINE("_FILE_OFFSET_BITS", "64"),
        ] +
        # AC_TYPE_UID_T (configure.ac:42) and AC_CHECK_TYPE(gid_t, int)
        # (configure.ac:43).
        [
            checks.AC_CHECK_TYPE("uid_t"),
            checks.AC_DEFINE(
                "uid_t",
                "int",
                requires = ["!ac_cv_type_uid_t"],
            ),
            checks.AC_CHECK_TYPE("gid_t"),
            checks.AC_DEFINE(
                "gid_t",
                "int",
                requires = ["!ac_cv_type_gid_t"],
            ),
        ] +
        # AC_HEADER_DIRENT (configure.ac:45).
        HEADER_DIRENT_CHECKS +
        # AX_COMPILE_CHECK_RETTYPE (configure.ac:46 and :54).
        RETTYPE_CHECKS +
        # configure.ac:62.
        macros.AC_CHECK_FUNCS([
            "fchmod",
        ]) +
        # configure.ac:64.  `pipe`, `fork`, `getuid` and `geteuid` are repeated
        # by CPIO_SYSDEP below; the union is spelled out here and CPIO_SYSDEP
        # contributes the rest.
        macros.AC_CHECK_FUNCS([
            "setmode",
            "getpwuid",
            "getpwnam",
            "getgrgid",
            "getgrnam",
            "pipe",
            "fork",
            "getuid",
            "geteuid",
        ]) +
        # cpio_PAXUTILS -> PU_RMT (m4/rmt.m4:6).
        [
            checks.AC_SEARCH_LIBS(
                "setsockopt",
                [
                    "socket",
                    "nsl",
                ],
                subst = "LIB_SETSOCKOPT",
            ),
        ] + macros.AC_CHECK_HEADERS([
            "sys/mtio.h",
        ]) + [
            # MTIO_CHECK_FIELD (m4/rmt.m4:40).  Upstream greps <sys/mtio.h> for
            # the string "mt_model" and picks `mt_model` (DG/UX) over `mt_type`.
            # Probing for the member is the same question asked precisely, and
            # it also yields `mt_type` when the header is absent, which is the
            # upstream fallback.
            checks.AC_CHECK_MEMBER(
                "struct mtget.mt_model",
                includes = ["sys/mtio.h"],
                requires = ["HAVE_SYS_MTIO_H"],
            ),
            checks.AC_DEFINE(
                "MTIO_CHECK_FIELD",
                condition = "ac_cv_member_struct_mtget_mt_model",
                if_false = "mt_type",
                if_true = "mt_model",
            ),
        ] +
        # cpio_PAXUTILS -> PU_RTAPELIB (m4/rtapelib.m4:2).
        macros.AC_CHECK_HEADERS([
            "net/errno.h",
            "sys/inet.h",
            "netdb.h",
        ]) +
        # cpio_PAXUTILS -> PU_SYSTEM (m4/system.m4:9).  `string.h`, `fcntl.h`,
        # `sys/wait.h`, `sys/io/trioctl.h`, `locale.h`, `pwd.h` and `grp.h` are
        # repeated by configure.ac:82; see the note on configure.ac:64.
        # `sys/param.h` is still probed, by `gnulib-common` under GL_INIT_DEPS,
        # so the `#if HAVE_SYS_PARAM_H` guard just below stays meaningful.
        macros.AC_CHECK_HEADERS([
            "string.h",
            "memory.h",
            "fcntl.h",
            "sys/time.h",
            "sys/wait.h",
            "sys/gentape.h",
            "sys/tape.h",
            "sys/device.h",
            "sys/tprintf.h",
            "sgtty.h",
            "sys/io/trioctl.h",
            "locale.h",
            "pwd.h",
            "grp.h",
        ]) + [
            # m4/system.m4:13.  <sys/buf.h> needs <sys/param.h> first on the
            # BSDs that still ship it.
            checks.AC_CHECK_HEADER(
                "sys/buf.h",
                define = "HAVE_SYS_BUF_H",
                includes = [
                    # This comment prevents this list from being reordered
                    "#if HAVE_SYS_PARAM_H",
                    "#include <sys/param.h>",
                    "#endif",
                ],
            ),
        ] + macros.AC_CHECK_MEMBERS(
            ["struct stat.st_blksize"],
            includes = [
                # This comment prevents this list from being reordered
                "#include <sys/types.h>",
                "#include <sys/stat.h>",
            ],
        ) + macros.AC_CHECK_FUNCS([
            "mkfifo",
            "setlocale",
        ]) + [
            checks.AC_SEARCH_LIBS(
                "gethostbyname",
                ["nsl"],
            ),
        ] +
        # CPIO_SYSDEP (am/sysdep.m4:3), minus the names configure.ac:64 already
        # asked for and `chown`.
        macros.AC_CHECK_FUNCS([
            "getgid",
            "setuid",
            "setgid",
            "mknod",
            "symlink",
            "link",
        ]) +
        # CPIO_PACKED_STRUCTS (am/pack.m4:6).  Only the `__attribute__((packed))`
        # arm is translated: the `#pragma pack` fallbacks are guarded by
        # AC_RUN_IFELSE, and every compiler that can build this module accepts
        # the attribute, so the fallbacks are unreachable here.  If the attribute
        # were ever missing, `src/cpiohdr.h:20` would leave ATTRIB_PACKED empty
        # and the old binary/HPUX formats would misparse, which is why upstream
        # errors out rather than continuing.
        [
            checks.AC_TRY_COMPILE(
                code = """\
int main(void) {
    struct { int i __attribute__((packed)); } s;
    return 0;
}
""",
                define = "HAVE_ATTRIB_PACKED",
                language = "c",
            ),
        ] +
        # CPIO_DEFAULT_QUOTING_STYLE(escape) (configure.ac:75).
        select({
            ":_quoting_style_" + style.replace("-", "_"): [
                checks.AC_DEFINE(
                    "DEFAULT_QUOTING_STYLE",
                    value = style.replace("-", "_") + "_quoting_style",
                ),
            ]
            for style in QUOTING_STYLES
        }) +
        # configure.ac:82.
        macros.AC_CHECK_HEADERS([
            "unistd.h",
            "stdlib.h",
            "utmp.h",
            "libintl.h",
            "process.h",
            "sys/ioctl.h",
        ]) +
        # configure.ac:84.  `strdup` is left to gnulib's `strdup` module, which
        # asks for the same `ac_cv_have_decl_strdup`.  HAVE_STRING_H is replayed
        # the way confdefs.h would: m4/system.m4:9 probed <string.h> above, so
        # by the time the real configure reaches this the `#ifdef` is taken.
        macros.AC_CHECK_DECLS(
            [
                "errno",
                "getpwnam",
                "getgrnam",
                "getgrgid",
                "strerror",
                "getenv",
                "atoi",
                "exit",
            ],
            compile_defines = ["HAVE_STRING_H"],
            includes = [
                # This comment prevents this list from being reordered
                "#include <stdio.h>",
                "#include <stdlib.h>",
                "#include <errno.h>",
                "#ifdef HAVE_STRING_H",
                "# include <string.h>",
                "#else",
                "# include <strings.h>",
                "#endif",
                "#include <pwd.h>",
                "#include <grp.h>",
            ],
        ) +
        # AM_INIT_AUTOMAKE (configure.ac:24) mirrors AC_INIT's tarname and
        # version into config.h.  PACKAGE is the tarname, not PACKAGE_NAME:
        # `lib/system.h` hands it to bindtextdomain().
        [
            checks.AC_DEFINE(
                "PACKAGE",
                value = '"cpio"',
            ),
            checks.AC_DEFINE(
                "VERSION",
                value = '"2.15"',
            ),
            # AC_C_PROTOTYPES (configure.ac:37).  Both spellings are
            # unconditional: every compiler this module can be built with
            # accepts prototypes.
            checks.AC_DEFINE("PROTOTYPES", "1"),
            checks.AC_DEFINE("__PROTOTYPES", "1"),
            # gl_INIT (configure.ac:68) sets this for the gnulib header
            # templates; the toolchain defaults have no value for it.
            checks.AC_SUBST(
                "GUARD_PREFIX",
                value = "GL",
            ),
            # gl_NSTRFTIME (m4/nstrftime.m4:20).  This is what renames the one
            # function `gnu/nstrftime.c` defines; without it that file compiles
            # a definition of plain `strftime` into the library, which both
            # collides with libc and leaves `gnu/parse-datetime.c` with an
            # undefined reference.  The packaged gnulib `nstrftime` module
            # carries the struct-tm probes but not this define.
            checks.AC_DEFINE(
                "my_strftime",
                value = "nstrftime",
            ),
        ] +
        # gl_INIT (configure.ac:68) again: the toolchain defaults publish 0 for
        # every GNULIB_* module indicator, which turns the corresponding
        # declarations off in the generated gnulib headers.  These are the
        # modules `m4/gnulib-comp.m4` lists, so they are turned back on.
        [
            checks.AC_SUBST(v, 1)
            for v in GNULIB_MODULE_INDICATORS
        ] + [
            checks.AC_DEFINE(v, "1")
            for v in GNULIB_MODULE_INDICATORS
        ]
    ),
    deps = [":package"] + GL_INIT_DEPS,
)

