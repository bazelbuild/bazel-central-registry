        "gnu/unistr/u32-strlen.c": "LIBUNISTRING_COMPILE_UNISTR_U32_STRLEN",
        "gnu/unsetenv.c": "GL_COND_OBJ_UNSETENV",
        "gnu/utime.c": "GL_COND_OBJ_UTIME",
        "gnu/utimensat.c": "GL_COND_OBJ_UTIMENSAT",
        "gnu/vsnprintf.c": "GL_COND_OBJ_VSNPRINTF",
        "gnu/wctype.c": "GL_COND_OBJ_WCTYPE",
        "gnu/wmemchr.c": "GL_COND_OBJ_WMEMCHR",
        "gnu/wmempcpy.c": "GL_COND_OBJ_WMEMPCPY",
        "gnu/write.c": "GL_COND_OBJ_WRITE",
    }.items()},
    defaults = True,
    naming = "per_target",
    deps = [":autoconf"],
)

# The stat/fstat modules AC_LIBOBJ stat-w32 only inside a
# `case $host_os in mingw* | windows*` (m4/gnulib-comp.m4:602 and :962).  A
# probe cannot answer "is the host Windows", so that half is a select() on the
# target platform and the REPLACE_STAT/REPLACE_FSTAT half stays a condition.
autoconf_srcs(
    name = "gnulib_windows_conditional_srcs",
    srcs = {"gnu/stat-w32.c": SRC_CONDITIONS["GL_COND_OBJ_STAT_W32"]},
    defaults = True,
    naming = "per_target",
    deps = [":autoconf"],
)

cc_library(
    name = "gnulib",
    srcs = GNULIB_SRCS + [
        # AC_PROG_YACC (configure.ac:35) only matters when regenerating the
        # parser.  The release tarball ships bison's output next to the
        # grammar, which is what `make` uses when bison is absent, so building
        # it keeps the module free of a bison toolchain.
        "gnu/parse-datetime.c",
        ":gnulib_conditional_srcs",
    ] + select({
        "@platforms//os:windows": [":gnulib_windows_conditional_srcs"],
        "//conditions:default": [],
    }),
    hdrs = ["config.h"] + glob(["gnu/**/*.h"]) +
           LIB_GENERATED_TARGETS + [
        ":configmake_h",
    ],
    copts = COPTS,
    includes = [
        ".",
        "gnu",
        "gnu/unicase",
        "gnu/unictype",
        "gnu/unistr",
    ],
    local_defines = LOCAL_DEFINES,
    textual_hdrs = GNULIB_TEXTUAL_HDRS,
    deps = [":gnulib_conditional_hdrs"],
)

# GNU standard directory variables (from the gnulib `configmake` module).
#
# Upstream's `gnu/Makefile.am` writes all 28 of these from the `--prefix`
# directory variables, but only `LOCALEDIR` is ever read: `src/main.c:780`,
# `src/mt.c:319` and `rmt/rmt.c` hand it to bindtextdomain(), and nothing else
# in `src/`, `lib/`, `rmt/` or `gnu/` names any of the others.  Writing only
# what is referenced keeps this from being a second, hand-transcribed copy of
# the install layout that no compiler ever validates -- the earlier full list
# had already drifted, spelling the five `PKG*`/`DOCDIR` paths with the package
# name where autoconf uses the tarname.
write_file(
    name = "configmake_h",
    out = "gnu/configmake.h",
    content = [
        "/* DO NOT EDIT! GENERATED AUTOMATICALLY! */",
        "#define LOCALEDIR \"/usr/local/share/locale\"",
    ],
)

# BUILT_SOURCES generated headers (from Makefile.am)
#
# --with-rmt=FILE / DEFAULT_RMT_DIR (m4/rmt.m4:50 and :59).  The default is
# upstream's `$(libexecdir)/rmt` with the default `--prefix`.  This is the
# compiled-in path to the `rmt` helper `lib/rtapelib.c` execs for remote
# archives, and cpio has no runtime flag that overrides it.
string_flag(
    name = "default_rmt_command",
    build_setting_default = "/usr/local/libexec/rmt",
    visibility = ["//visibility:public"],
)

rmt_command_h(
    name = "rmt_command_h",
    out = "lib/rmt-command.h",
    command = ":default_rmt_command",
)

# Resolve AC_SEARCH_LIBS results into linker flags at build time.
# Variables are supplied by translated checks and gnulib modules.
autoconf_linkopts(
    name = "linkopts",
    vars = [
        "LIB_SETSOCKOPT",
    ],
    deps = [":autoconf"],
)

# Build targets (from Makefile.am)
#
# Public visibility tracks what `make install` publishes, and nothing more:
# `cpio` and `mt` from `bin_PROGRAMS` (src/Makefile.am:21, `mt` only under
# --enable-mt) and `rmt` from `rmt_PROGRAMS` (rmt/Makefile.am:21).  Both
# libraries are `noinst_LIBRARIES` (lib/Makefile.am:19, gnu/Makefile.am:101) and
# every header is `noinst_HEADERS`, so `:pax` and `:gnulib` stay private -- they
# are also the two targets carrying `includes`, which a public edge would push
# onto consumers along with the whole gnulib header set.

cc_library(
    name = "pax",
    srcs = [
        "lib/paxerror.c",
        "lib/paxexit.c",
        "lib/paxexit-status.c",
        "lib/paxlib.h",
        "lib/paxnames.c",
        "lib/rtapelib.c",
        "lib/sysdep.c",
        "lib/sysdep.h",
        "lib/system.h",
    ],
    hdrs = glob(["lib/*.h"]) + [":rmt_command_h"],
    copts = COPTS,
    includes = [
        "gnu",
        "lib",
    ],
    local_defines = LOCAL_DEFINES,
    deps = [
        ":gnulib",
    ],
)

cc_binary(
    name = "rmt",
    srcs = [
        "rmt/rmt.c",
    ] + glob([
        "gnu/*.h",
        "lib/*.h",
    ]),
    copts = COPTS,
    # `rmt/` holds only rmt.c, and `paxlib/` is a paxutils directory that cpio
    # does not vendor -- neither contributes an include path.
    includes = [
        "gnu",
        "lib",
    ],
    local_defines = LOCAL_DEFINES,
    visibility = ["//visibility:public"],
    deps = [
        ":gnulib",
        ":linkopts",
    ],
)

cc_binary(
    name = "cpio",
    srcs = [
        "src/copyin.c",
        "src/copyout.c",
        "src/copypass.c",
        "src/defer.c",
        "src/dstring.c",
        "src/fatal.c",
        "src/filemode.c",
        "src/global.c",
        "src/idcache.c",
        "src/main.c",
        "src/makepath.c",
        "src/tar.c",
        "src/userspec.c",
        "src/util.c",
    ] + glob([
        "gnu/*.h",
        "lib/*.h",
        "src/*.h",
    ]),
    copts = COPTS,
    includes = [
        "gnu",
        "lib",
        "src",
    ],
    local_defines = LOCAL_DEFINES,
    visibility = ["//visibility:public"],
    deps = [
        ":gnulib",
        ":pax",
    ],
)

cc_binary(
    name = "mt",
    srcs = [
        "src/mt.c",
    ] + glob([
        "gnu/*.h",
        "lib/*.h",
        "src/*.h",
    ]),
    copts = COPTS,
    includes = [
        "gnu",
        "lib",
        "src",
    ],
    local_defines = LOCAL_DEFINES,
    target_compatible_with = select({
        ":enable_mt_setting": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":gnulib",
        ":pax",
    ],
)

# `check_PROGRAMS` (tests/Makefile.am:83), so it is never installed -- it is
# visible only to //tests, which drives the suite that runs it.  Built here
# rather than in //tests because it wants the same private `:gnulib` and `lib/`
# header set the installed programs do; upstream links it against libgnu.a
# alone, not paxlib.
cc_binary(
    name = "genfile",
    testonly = True,
    srcs = [
        "//tests:argcv.c",
        "//tests:argcv.h",
        "//tests:genfile.c",
    ] + glob([
        "gnu/*.h",
        "lib/*.h",
    ]),
    copts = COPTS,
    includes = [
        "gnu",
        "lib",
        "tests",
    ],
    local_defines = LOCAL_DEFINES + [
        # tests/Makefile.am:89 passes its own LOCALEDIR rather than taking
        # gnulib's, though both resolve to $(datadir)/locale.
        'LOCALEDIR=\\"/usr/local/share/locale\\"',
    ],
    visibility = ["//:__subpackages__"],
    deps = [":gnulib"],
)
