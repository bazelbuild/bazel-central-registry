# Conditions for the conditionally compiled sources, transcribed from the shell
# tests upstream gates them with: `gl_CONDITIONAL` in m4/gnulib-comp.m4, or, for
# the keys upstream has no conditional for, the `if` around its `AC_LIBOBJ`.
#
# Those tests read the shell variable a gnulib module leaves behind, so `HAVE_X`
# upstream means the `AC_SUBST` of that name and never the config.h define.
# Each is written as the cache variable unique to the check that produced it
# (`ac_cv_subst_`/`ac_cv_define_`/`ac_cv_func_`), because a bare name is looked
# up across all three namespaces and can be missing, ambiguous or -- for an
# `AC_DEFINE` with `requires` -- valueless, each only on the platform that trips
# it.  `test $X = 1` is likewise `X==1` and not a bare mention of X.
SRC_CONDITIONS = {
    "GL_COND_OBJ_BTOWC": "ac_cv_subst_HAVE_BTOWC==0 || ac_cv_subst_REPLACE_BTOWC==1",
    # Truthiness rather than `= 1`, because stdlib.in.h drops the same variable
    # into a C `#if` and REPLACE_REALLOC_FOR_REALLOC_POSIX is 2 here.
    "GL_COND_OBJ_CALLOC": "ac_cv_subst_REPLACE_CALLOC_FOR_CALLOC_GNU || ac_cv_subst_REPLACE_CALLOC_FOR_CALLOC_POSIX",
    "GL_COND_OBJ_CHDIR_LONG": "gl_cv_have_unlimited_file_name_length==no",
    "GL_COND_OBJ_CHOWN": "ac_cv_subst_HAVE_CHOWN==0 || ac_cv_subst_REPLACE_CHOWN==1",
    "GL_COND_OBJ_CLOSE": "ac_cv_subst_REPLACE_CLOSE==1",
    "GL_COND_OBJ_CLOSEDIR": "ac_cv_subst_HAVE_CLOSEDIR==0 || ac_cv_subst_REPLACE_CLOSEDIR==1",
    "GL_COND_OBJ_DIRFD": "ac_cv_func_dirfd==0 || ac_cv_subst_REPLACE_DIRFD==1",
    "GL_COND_OBJ_DUP": "ac_cv_subst_REPLACE_DUP==1",
