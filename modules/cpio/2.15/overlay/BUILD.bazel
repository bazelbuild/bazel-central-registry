load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc_autoconf//autoconf:autoconf.bzl", "autoconf")
load("@rules_cc_autoconf//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
load("@rules_cc_autoconf//autoconf:autoconf_linkopts.bzl", "autoconf_linkopts")
load("@rules_cc_autoconf//autoconf:autoconf_srcs.bzl", "autoconf_srcs")
load("@rules_cc_autoconf//autoconf:checks.bzl", "checks", "macros")
load("@rules_cc_autoconf//autoconf:package_info.bzl", "package_info")
load("@rules_cc_autoconf//gnulib:conditional_hdrs.bzl", "cc_gnulib_conditional_hdrs")
load(":rmt_command.bzl", "rmt_command_h")

package_info(
    name = "package",
    package_name = "GNU cpio",
    package_bugreport = "bug-cpio@gnu.org",
    # AC_INIT (configure.ac:18) leaves TARNAME empty, so autoconf derives it
    # from the package name by lowercasing and squashing runs of anything but
    # [A-Za-z0-9_] -- "GNU cpio" becomes "cpio".
    package_tarname = "cpio",
    package_url = "http://www.gnu.org/software/cpio",
    package_version = "2.15",
)

# CPIO_DEFAULT_QUOTING_STYLE (am/quoting.m4:21).  The m4 `QUOTING_STYLES` list
# is the set of accepted names; configure turns the chosen one into the
# matching `quotearg` enumerator by mapping "-" to "_" and appending
# "_quoting_style".  The `values` list makes the "Invalid quoting style"
# AC_MSG_ERROR a load-time error instead.
QUOTING_STYLES = [
    "literal",
    "shell",
    "shell-always",
    "c",
    "escape",
    "locale",
    "clocale",
]

string_flag(
    name = "default_quoting_style",
    build_setting_default = "escape",
    values = QUOTING_STYLES,
    visibility = ["//visibility:public"],
)

[
    config_setting(
        name = "_quoting_style_" + style.replace("-", "_"),
        flag_values = {":default_quoting_style": style},
    )
    for style in QUOTING_STYLES
]

# Several gnulib sources use C11 `static_assert` via <assert.h> (uchar.h, the
# c32* wrappers, ...), which the default C dialect of older compilers does not
# enable.  clang-cl takes the MSVC spellings, not the GNU ones, so it has to be
# named alongside msvc-cl; mingw-gcc is a GCC driver and falls through to the
# default.
_MSVC_COPTS = [
    "/w",
    "/std:c11",
]

_GNU_COPTS = [
    "-w",
    "-std=gnu11",
]

COPTS = select({
    "@rules_cc//cc/compiler:clang-cl": _MSVC_COPTS,
    "@rules_cc//cc/compiler:msvc-cl": _MSVC_COPTS,
    "//conditions:default": _GNU_COPTS,
})

LOCAL_DEFINES = [
    "HAVE_CONFIG_H",
    # gnulib's uchar.h (and a handful of lib/*.c files) spell bare C11
    # `static_assert` without including <assert.h>; surface the keyword mapping
    # directly so those translation units do not depend on the header having
    # been pulled in first.
    "static_assert=_Static_assert",
]

# --enable-mt (line 77)
bool_flag(
    name = "enable_mt",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "enable_mt_setting",
    flag_values = {":enable_mt": "True"},
)

# AC_HEADER_DIRENT (configure.ac:45).  Only the four HAVE_* results reach
# config.h; the `-ldir`/`-lx` search the macro also performs targets SCO Xenix
# and has no bearing on the platforms above.
HEADER_DIRENT_CHECKS = macros.AC_CHECK_HEADERS(["dirent.h"]) + macros.AC_CHECK_HEADERS(
    [
        "sys/ndir.h",
        "sys/dir.h",
        "ndir.h",
    ],
    requires = ["!ac_cv_header_dirent_h"],
)

# AX_COMPILE_CHECK_RETTYPE (am/ax_compile_check_rettype.m4:61), applied to
# major() and minor() by configure.ac:46 and :54.  The macro walks
# char/short/int/long/"long long" and keeps the first whose width matches the
# function's return type, then defines RETTYPE_<FUNC> to it.  The result only
# sizes two fields of the in-memory `struct cpio_file_stat` (src/cpiohdr.h:121),
# not anything on the wire.  Both functions return a type of at least `int`
# rank on every platform with <sys/sysmacros.h> or <sys/mkdev.h>, so the
# char/short candidates are unreachable and the probe reduces to int-or-wider.
#
# `compile_defines` replays MAJOR_IN_SYSMACROS into the probe the way confdefs.h
# does for the real configure, so the prologue picks the same header
# configure.ac:47 would.  That symbol is not defined here: AC_HEADER_MAJOR
# (configure.ac:40) is also AC_REQUIREd by gl_SYS_TYPES_H, so upstream it
# expands once and its result is shared, which is why it comes from
# `gl_INIT` below.  That expansion has no MAJOR_IN_MKDEV counterpart, so the
# `#ifdef` below is inert and kept only to match the upstream probe text.
RETTYPE_PROLOGUE = """\
#include <sys/types.h>
#ifdef MAJOR_IN_MKDEV
# include <sys/mkdev.h>
#endif
#ifdef MAJOR_IN_SYSMACROS
# include <sys/sysmacros.h>
#endif
"""

RETTYPE_CHECKS = [
    check
    for func in [
        "major",
        "minor",
    ]
    for check in [
        checks.AC_TRY_COMPILE(
            name = "cpio_cv_rettype_{}_int".format(func),
            code = RETTYPE_PROLOGUE + """\
int main (void) {{
    switch (0) case 0: case (sizeof ({func} (0)) == sizeof (int)):;
    return 0;
}}
""".format(func = func),
            compile_defines = ["MAJOR_IN_SYSMACROS"],
        ),
        checks.AC_DEFINE(
            "RETTYPE_{}".format(func.upper()),
            condition = "cpio_cv_rettype_{}_int".format(func),
            if_false = "long",
            if_true = "int",
        ),
    ]
]

# gl_INIT (configure.ac:68).
#
# This is the one part of `configure.ac` that stays a dependency edge instead of
# being written out here.  `gnulib-tool` copied 220 `.m4` files into `m4/` and
# `m4/gnulib-comp.m4` invokes all of them from `gl_INIT`; the list below is
# exactly those files for which `@rules_cc_autoconf//gnulib/m4/` ships an
# implementation, so it stands in for the generated `gl_INIT` body rather than
# for any choice made here.
#
# It cannot be made implicit through the autoconf toolchain.  The default
# `@rules_cc_autoconf//gnulib/toolchain` already lists every one of these under
# `cache_deps`, but `cache_deps` only feeds the content cache used to skip
# duplicate checker actions -- results never reach a consumer's
# `CcAutoconfInfo`.  The toolchain's `defaults` do reach consumers, but only
# through `autoconf_hdr(defaults = True)`, and they carry only the
# `gl_*_H_DEFAULTS` substitutions.  Without these deps `config.h` loses the ~210
# `gl_INIT` defines (HAVE_ALLOCA_H, HAVE_BTOWC, the HAVE_DECL_* set, ...) and
# `cc_gnulib_conditional_hdrs` has no `GL_GENERATE_*_H` to switch on.
#
# What the toolchain cache does buy is that cpio's own checks above -- which
# repeat probes gnulib also makes, such as `lstat` or `sys/time.h` -- are
# content-key hits against these modules and cost no extra actions, so spelling
# them out explicitly is free.
GL_INIT_DEPS = [
    "@rules_cc_autoconf//gnulib/m4/00gnulib",
    "@rules_cc_autoconf//gnulib/m4/__inline",
    "@rules_cc_autoconf//gnulib/m4/absolute-header",
    "@rules_cc_autoconf//gnulib/m4/alloca",
