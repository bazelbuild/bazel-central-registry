module(
    name = "nginx",
    version = "1.31.8",
    bazel_compatibility = [">=8.0.0"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "libgd", version = "2.3.3.bcr.1")
bazel_dep(name = "libxcrypt", version = "4.4.36.bcr.1")
bazel_dep(name = "libxml2", version = "2.15.3")
bazel_dep(name = "openssl", version = "4.0.3.bcr.1")
bazel_dep(name = "pcre2", version = "10.49")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_perl", version = "2.1.0")
bazel_dep(name = "rules_cc", version = "0.2.28")

# libxcrypt 4.4.36.bcr.1 uses a retired Debian BusyBox URL in rules_coreutils beta.6.
bazel_dep(name = "rules_coreutils", version = "1.0.2", repo_name = None)
bazel_dep(name = "with_cfg.bzl", version = "1.1.0")
bazel_dep(name = "zlib", version = "1.3.2.bcr.3")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# libxslt 1.1.45 supports the libxml2 2.15 API. Configure for the target Linux libc.
http_archive(
    name = "nginx_libxslt",
    build_file = "//:dynamic/libxslt.BUILD.bazel",
    integrity = "sha256-ms/mhBnE0GpFxVAyGzISdi2S9BRlBiyk6hnmMu5dIW4=",
    strip_prefix = "libxslt-1.1.45",
    urls = [
        "https://archive.ubuntu.com/ubuntu/pool/main/libx/libxslt/libxslt_1.1.45.orig.tar.xz",
        "https://download.gnome.org/sources/libxslt/1.1/libxslt-1.1.45.tar.xz",
    ],
)

# Ubuntu's nginx GeoIP modules read legacy .dat files.
http_archive(
    name = "nginx_geoip",
    build_file = "//:dynamic/geoip.BUILD.bazel",
    integrity = "sha256-mbEZ+OIelPHf1tSfvu0ppw3xVEiW52zUVvJeOXsH1HY=",
    strip_prefix = "geoip-api-c-1.6.12",
    urls = ["https://github.com/maxmind/geoip-api-c/archive/refs/tags/v1.6.12.tar.gz"],
)

perl_for_nginx = use_repo_rule("//perl:repositories.bzl", "perl_for_nginx")

perl_for_nginx(
    name = "nginx_perl_aarch64",
    cpu = "aarch64",
)

perl_for_nginx(
    name = "nginx_perl_x86_64",
    cpu = "x86_64",
)

bazel_dep(name = "llvm", version = "0.8.27", dev_dependency = True)

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)

http_archive(
    name = "nginx_tests",
    build_file = "//tests:nginx-tests.BUILD.bazel",
    dev_dependency = True,
    integrity = "sha256-Dxgrnr7KhgImWnZhTEzccLNhYBs3b/oYCvakBlVWPCM=",
    strip_prefix = "nginx-tests-47e78403ba756629adc3a8421bab700f344b7e3b",
    urls = ["https://github.com/nginx/nginx-tests/archive/47e78403ba756629adc3a8421bab700f344b7e3b.tar.gz"],
)
