load("@rules_perl//perl:perl_test.bzl", "perl_test")

exports_files(["nginx-tests.BUILD.bazel"])

_UPSTREAM_TESTS = [
    "@nginx_tests//:" + name + ".t"
    for name in [
        "addition",
        "auth_request",
        "config_dump",
        "geoip",
        "gzip",
        "h2_request_body",
        "image_filter_finalize",
        "mail_imap",
        "perl",
        "rewrite",
        "secure_link",
        "stream_geoip",
        "stream_proxy",
        "stream_ssl_preread_protocol",
        "sub_filter",
        "xslt",
    ]
]

perl_test(
    name = "upstream",
    size = "medium",
    srcs = ["run_tests.pl"],
    args = [
        "$(rootpath //:nginx)",
        "$(rootpath @nginx_tests//:lib/Test/Nginx.pm)",
        "$(rootpath //:perl_nginx_pm)",
        "$(rootpath //:perl_strict_pm)",
        "$(rootpath //:perl_config_pm)",
        "$(rootpath @openssl//:openssl)",
        "$(rootpath :tls.t)",
    ] + ["$(rootpath %s)" % test for test in _UPSTREAM_TESTS],
    data = [
        "tls.t",
        "//:dynamic_modules",
        "//:nginx",
        "//:perl_config_pm",
        "//:perl_nginx_pm",
        "//:perl_runtime",
        "//:perl_strict_pm",
        "@nginx_tests//:lib/Test/Nginx.pm",
        "@nginx_tests//:test_libraries",
        "@openssl",
    ] + _UPSTREAM_TESTS,
)
