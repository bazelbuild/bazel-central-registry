load("@rules_perl//perl:perl_test.bzl", "perl_test")

_TEST_FILES = [
    "//:nginx",
    "@nginx_tests//:lib/Test/Nginx.pm",
    "//:perl_nginx_pm",
    "//:perl_strict_pm",
    "@openssl//:openssl",
    ":tls.t",
] + [
    "@nginx_tests//:" + name + ".t"
    for name in [
        "addition",
        "auth_request",
        "config_dump",
        "geoip",
        "gzip",
        "h2_request_body",
        "image_filter_finalize",
        "mail_imap",
        "perl",
        "rewrite",
        "secure_link",
        "stream_geoip",
        "stream_proxy",
        "stream_ssl_preread_protocol",
        "sub_filter",
        "xslt",
    ]
]

perl_test(
    name = "upstream",
    size = "medium",
    srcs = ["run_tests.pl"],
    args = ["$(rootpath %s)" % file for file in _TEST_FILES],
    data = _TEST_FILES + [
        "//:dynamic_modules",
        "//:perl_runtime",
        "@nginx_tests//:test_libraries",
    ],
)
