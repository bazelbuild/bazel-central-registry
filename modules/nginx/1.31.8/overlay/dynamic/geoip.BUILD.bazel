"""The legacy GeoIP database reader used by Ubuntu's nginx GeoIP modules."""

load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "geoip",
    srcs = [
        "libGeoIP/GeoIP.c",
        "libGeoIP/GeoIPCity.c",
        "libGeoIP/GeoIP_deprecated.c",
        "libGeoIP/GeoIP_internal.h",
        "libGeoIP/regionName.c",
        "libGeoIP/timeZone.c",
    ],
    hdrs = [
        "libGeoIP/GeoIP.h",
        "libGeoIP/GeoIPCity.h",
    ],
    includes = ["libGeoIP"],
    local_defines = [
        'GEOIPDATADIR=\\"/usr/share/GeoIP\\"',
        "GETHOSTBYNAME_R_RETURNS_INT",
        "HAVE_GETHOSTBYNAME_R",
        "HAVE_GETTIMEOFDAY",
        "HAVE_PREAD",
        "HAVE_STDINT_H",
        'PACKAGE_VERSION=\\"1.6.12\\"',
        "_GNU_SOURCE",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)
