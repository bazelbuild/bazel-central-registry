def nginx_sources():
    """Returns the Linux and HTTP sources compiled into the server library."""
    return ["src/event/modules/ngx_epoll_module.c"] + native.glob(
        [
            "src/core/*.c",
            "src/event/*.c",
            "src/event/quic/*.c",
            "src/http/*.c",
            "src/http/modules/*.c",
            "src/http/v2/*.c",
            "src/http/v3/*.c",
            "src/os/unix/*.c",
        ],
        exclude = [
            # cc_binary compiles main().
            "src/core/nginx.c",
            # Ubuntu builds GeoIP, image filter, and XSLT as dynamic modules.
            "src/http/modules/ngx_http_geoip_module.c",
            "src/http/modules/ngx_http_image_filter_module.c",
            "src/http/modules/ngx_http_xslt_filter_module.c",
            # Ubuntu leaves degradation, JSON, control API, and file AIO disabled.
            "src/http/modules/ngx_http_degradation_module.c",
            "src/http/modules/ngx_http_json_module.c",
            "src/os/unix/ngx_control.c",
            "src/os/unix/ngx_file_aio_read.c",
            "src/os/unix/ngx_linux_aio_read.c",
            "src/os/unix/ngx_darwin_*.c",
            "src/os/unix/ngx_freebsd_*.c",
            "src/os/unix/ngx_solaris_*.c",
        ],
    )
