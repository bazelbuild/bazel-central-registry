load("@rules_cc//cc:cc_test.bzl", "cc_test")

# tests/Makefile.am:210-234, check-local, over EXTRA_DIST's .testfile entries (:5-203).
[cc_test(
    name = test,
    size = "small",
    srcs = ["test.c"],
    args = [
        "-e",
        "$(rootpath %s.testfile)" % test,
        "$(rootpath %s.result)" % test,
    ],
    data = [
        "%s.result" % test,
        "%s.testfile" % test,
        "//magic:database",
    ],
    env = {"MAGIC": "$(rootpath //magic:database)"},
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = ["//:libmagic"],
) for test in [
    "android-vdex-1",
