# tests/multiple.flags is k.
cc_test(
    name = "multiple",
    size = "small",
    srcs = ["test.c"],
    args = [
        "-ek",
        "$(rootpath multiple.testfile)",
        "$(rootpath multiple.result)",
    ],
    data = [
        "multiple.result",
        "multiple.testfile",
        "multiple-A.magic",
        "multiple-B.magic",
    ],
    env = {"MAGIC": "$(rootpath multiple-A.magic):$(rootpath multiple-B.magic)"},
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = ["//:libmagic"],
)

[cc_test(
    name = test,
    size = "small",
    srcs = ["test.c"],
    args = [
        "-e",
        "$(rootpath %s.testfile)" % test,
        "$(rootpath %s.result)" % test,
    ],
    data = [
        "%s.magic" % test,
        "%s.result" % test,
        "%s.testfile" % test,
    ],
    env = {"MAGIC": "$(rootpath %s.magic)" % test},
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = ["//:libmagic"],
) for test in [
    "regex-eol",
