"""TypeScript lint aspects (ESLint, archtest) for consumers that lint TypeScript.

Imposes nothing beyond aspect_rules_js (minimum version; the consumer's own
wins). ESLint and its plugins come from the npm lockfile gavel owns here; no Node
toolchain is registered for consumers.
"""

module(
    name = "gavel_tools_typescript",
    version = "0.4.1",
    bazel_compatibility = [">=9.0.0"],
    compatibility_level = 1,
)

# Overrides only take effect when this is the root module (dev / CI here); for
# consumers they are ignored and the registry version of gavel_tools is used.
bazel_dep(name = "gavel_tools", version = "0.4.1")
local_path_override(
    module_name = "gavel_tools",
    path = "../..",
)

bazel_dep(name = "aspect_rules_js", version = "3.0.3")

# Dev only: lets this module build and test on its own. Consumers bring Node.
bazel_dep(name = "rules_nodejs", version = "6.7.4", dev_dependency = True)

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node", dev_dependency = True)
node.toolchain(node_version = "22.16.0")

# The gavel-owned ESLint (and SARIF formatter) lock: the linter version is gavel's.
npm = use_extension("@aspect_rules_js//npm:extensions.bzl", "npm")
npm.npm_translate_lock(
    name = "gavel_eslint",
    pnpm_lock = "//lint/lang/typescript/eslint:pnpm-lock.yaml",
)
use_repo(npm, "gavel_eslint")
