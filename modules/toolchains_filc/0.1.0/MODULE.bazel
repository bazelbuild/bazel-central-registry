module(
    name = "toolchains_filc",
    version = "0.1.0",
    bazel_compatibility = [">=9.0.0"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "llvm", version = "0.8.26")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.25")

# Import the distributions for ordinary targets in this module. The consuming
# root still supplies the explicit prebuilt version and registers filc_toolchains.
filc = use_extension("//extensions:filc.bzl", "filc")
use_repo(
    filc,
    "filc_exec_aarch64",
    "filc_exec_x86_64",
    "filc_glibc_target_aarch64",
    "filc_glibc_target_x86_64",
    "filc_target_aarch64",
    "filc_target_x86_64",
    "filc_toolchains",
)

# Configure this checkout when it is the root module. Downstream consumers do
# not inherit this development tag and must still choose their version explicitly.
filc_development = use_extension("//extensions:filc.bzl", "filc", dev_dependency = True)
filc_development.prebuilt(version = "0.687")

# Share the kernel header repositories provided by the selected LLVM module.
kernel_headers = use_extension("@llvm//kernel/extension:kernel_headers.bzl", "kernel_headers")
use_repo(kernel_headers, "kernel_headers")

bazel_dep(name = "buildifier_prebuilt", version = "8.2.1", dev_dependency = True)
