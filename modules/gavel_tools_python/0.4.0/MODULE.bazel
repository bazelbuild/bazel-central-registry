"""Python lint aspects (ruff, bandit, pycompile, archtest) for consumers that lint Python.

Imposes nothing beyond rules_python (minimum version; the consumer's own wins)
and this module's linter binaries: no Python toolchain is registered here.
"""

module(
    name = "gavel_tools_python",
    version = "0.4.0",
    compatibility_level = 1,
)

# Overrides only take effect when this is the root module (dev / CI here); for
# consumers they are ignored and the registry version of gavel_tools is used.
bazel_dep(name = "gavel_tools", version = "0.4.0")
local_path_override(
    module_name = "gavel_tools",
    path = "../..",
)

bazel_dep(name = "rules_python", version = "1.7.0")

# Linter binary repos, owned here so the aspect labels (@ruff, @bandit) resolve
# within this module.
ruff_binary = use_repo_rule("//lint/lang/python/ruff:repositories.bzl", "ruff_binary")

ruff_binary(
    name = "ruff",
    version = "0.15.12",
)

bandit_binary = use_repo_rule("//lint/lang/python/bandit:repositories.bzl", "bandit_binary")

bandit_binary(
    name = "bandit",
    version = "1.9.4",
)
