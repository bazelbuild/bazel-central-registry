package(default_visibility = ["//:__subpackages__"])

filegroup(
    name = "testdata",
    srcs = glob(
        [
            "testdata/**/*.gif",
            "testdata/**/*.icc",
            "testdata/**/*.jpg",
            "testdata/**/*.jxl",
            "testdata/**/*.pam",
            "testdata/**/*.pfm",
            "testdata/**/*.pgm",
            "testdata/**/*.png",
            "testdata/**/*.pnm",
            "testdata/**/*.ppm",
            "testdata/**/*.y4m",
            "testdata/position_encoding/*.txt",
        ],
        allow_empty = True,
    ),
)

alias(
    name = "jxl",
    actual = "//lib:jpegxl",
    visibility = ["//visibility:public"],
)

alias(
    name = "libjxl",
    actual = ":jxl",
    visibility = ["//visibility:public"],
)

alias(
    name = "jxl_threads",
    actual = "//lib:jpegxl_threads",
    visibility = ["//visibility:public"],
)
