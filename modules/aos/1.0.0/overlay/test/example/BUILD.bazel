load("@aos//aos:config.bzl", "aos_config")
load("@aos//aos/flatbuffers:generate.bzl", "static_flatbuffer")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Uses AOS the way a dependent does: its flatbuffer and config rules from
# outside the @aos repository, and an event loop built on them.
static_flatbuffer(
    name = "counter_fbs",
    srcs = ["counter.fbs"],
)

aos_config(
    name = "counter_config",
    src = "counter_config_source.json",
    flatbuffers = [
        ":counter_fbs",
        "@aos//aos/events:event_loop_fbs",
        "@aos//aos/logging:dynamic_log_command_fbs",
        "@aos//aos/logging:log_message_fbs",
    ],
)

cc_test(
    name = "event_loop_test",
    srcs = ["event_loop_test.cc"],
    data = [":counter_config"],
    deps = [
        ":counter_fbs",
        "@aos//aos:configuration",
        "@aos//aos:flatbuffers",
        "@aos//aos/events:simulated_event_loop",
        # AOS's gtest main, which initializes AOS before the tests run.
        "@aos//aos/testing:googletest",
        "@rules_cc//cc/runfiles",
    ],
)
