module(name = "aos_bcr_test")

bazel_dep(name = "aos")
local_path_override(
    module_name = "aos",
    path = "..",
)

bazel_dep(name = "rules_cc", version = "0.2.18")

# protobuf's crate extension has no lockfile, which rules_rust 0.71 (from AOS)
# rejects in a non-root module, so `bazel mod deps` fails without this. AOS
# applies the same patch; it is fixed in protobuf 37.
single_version_override(
    module_name = "protobuf",
    patch_strip = 1,
    patches = ["//:protobuf_crate_dev_dependency.patch"],
    version = "35.1",
)
