# Our flatbuffers carries 22 patches, several of which change behaviour rather
# than adding to it -- force_defaults defaults to true, FLATBUFFERS_ASSERT
# becomes ABSL_DCHECK, the verifier's max_tables triples. It must never
# resolve as anyone's `flatbuffers` module, so it is not a module at all: a
# module extension fetches it, patched, as a repo private to AOS. No registry
# entry is needed, and a dependent's own `flatbuffers` is untouched.
# Consumers that want the same bits reach them through this extension; see
# aos/extension.bzl.
dependencies = use_extension("//aos:extension.bzl", "dependencies")
use_repo(dependencies, "aos_flatbuffers", "com_github_foxglove_schemas")

