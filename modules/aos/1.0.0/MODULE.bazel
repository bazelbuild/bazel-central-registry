# AOS's hermetic python runtime is built on the amd64_debian_sysroot, which is a
# dev_dependency and therefore does not exist for modules that depend on AOS.
# The toolchain is otherwise an exact match for a typical consumer host
# (linux + x86_64, canonical @rules_python//python:toolchain_type), so exporting
# it would hijack a consumer's python toolchain and point it at a repository
# that isn't there.  dev_dependency registrations still apply when AOS is the
# root module, so AOS's own builds are unchanged.
register_toolchains(
    "//tools/python:python_bzlmod_toolchain",
    dev_dependency = True,
)

