# flatbuffers' ts/ package links its own pnpm workspace. The repo comes from
# our extension (aos/extension.bzl), so its BUILD files resolve
# @flatbuffers_npm through AOS's mapping -- declare it here. The repo is named
# aos_flatbuffers_npm because the npm extension's namespace is shared across
# the whole module graph, and BCR flatbuffers declares its own flatbuffers_npm
# there: a consumer with plain BCR flatbuffers anywhere in its graph would
# otherwise fail with "A repo named flatbuffers_npm is already generated by
# this module extension". The use_repo alias maps it back to the
# @flatbuffers_npm apparent name upstream's ts/BUILD.bazel loads from.
npm.npm_translate_lock(
    name = "aos_flatbuffers_npm",
    npmrc = "@aos_flatbuffers//:.npmrc",
    pnpm_lock = "@aos_flatbuffers//ts:pnpm-lock.yaml",
    verify_node_modules_ignored = "@aos_flatbuffers//:.bazelignore",
)
use_repo(npm, flatbuffers_npm = "aos_flatbuffers_npm")

