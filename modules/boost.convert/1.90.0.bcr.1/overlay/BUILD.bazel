load("@rules_cc//cc:cc_library.bzl", "cc_library")

# The converter headers are not self-contained: boost/convert/parameters.hpp
# spells uint8_t without including <cstdint> and boost/convert/lexical_cast.hpp
# uses boost::optional without including it, so every header that pulls them in
# only compiles after its includer has provided them.
_TEXTUAL_HDRS = glob(["include/boost/convert/**/*.hpp"])

cc_library(
    name = "boost.convert",
    hdrs = glob(["include/**/*.hpp"], exclude = _TEXTUAL_HDRS),
    features = ["parse_headers"],
    includes = ["include"],
    textual_hdrs = _TEXTUAL_HDRS,
    visibility = ["//visibility:public"],
    deps = [
        "@boost.config",
        "@boost.core",
        "@boost.function_types",
        "@boost.lexical_cast",
        "@boost.math",
        "@boost.mpl",
        "@boost.optional",
        "@boost.parameter",
        "@boost.range",
        "@boost.spirit",
        "@boost.type_traits",
    ],
)
