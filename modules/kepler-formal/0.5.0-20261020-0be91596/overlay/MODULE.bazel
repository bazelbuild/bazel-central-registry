"""kepler-formal: formal equivalence checking on naja netlists.

Every dependency is a plain bazel_dep from the Bazel Central Registry,
except cadical, vendored below until its BCR pull request merges. See
docs/bcr-roadmap.md.
"""

module(
    name = "kepler-formal",
    # Keep in sync with KEPLER_VERSION in src/bin/KeplerVersion.h.in.
    version = "0.5.0-20261020-0be91596",
    bazel_compatibility = [">=8.0.0"],
)

bazel_dep(name = "glucose", version = "4.2.1-20251230-674dbba")
bazel_dep(name = "kissat", version = "4.0.4")
bazel_dep(name = "naja", version = "0.7.26-20261014-3da8811d")
bazel_dep(name = "onetbb", version = "2023.1.0")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.25")
bazel_dep(name = "rules_python", version = "1.9.0")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "spdlog", version = "1.17.0")
bazel_dep(name = "yaml-cpp", version = "0.9.0.bcr.1")

bazel_dep(name = "googletest", version = "1.18.0.bcr.1", dev_dependency = True)

# TODO(bazelbuild/bazel-central-registry#10883): replace with
# bazel_dep(name = "cadical", version = "3.0.0") once it merges, and
# delete bazel/cadical.BUILD.bazel. Same archive and BUILD file.
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "cadical",
    build_file = "//bazel:cadical.BUILD.bazel",
    integrity = "sha256-KCsclCL96GMctyG4ZFCulN9OjeBUXBemmjAaqkv5L88=",
    strip_prefix = "cadical-rel-3.0.0",
    urls = ["https://github.com/arminbiere/cadical/archive/refs/tags/rel-3.0.0.tar.gz"],
)

# Hermetic zero-sysroot LLVM toolchain (hermetic-llvm): statically linked
# clang 22, libc++ linked statically by default, glibc 2.28 floor. No host
# compiler, headers or /usr/lib involved. Scoped to Linux for now; macOS
# keeps the host Xcode toolchain.
#
# The toolchain is *registered* as a dev_dependency so it applies only when
# kepler-formal is the root module (its own builds and CI). register_toolchains
# from a dependency is global: a module that depends on kepler-formal would
# otherwise inherit this toolchain and have its own C++ toolchain selection
# silently replaced. A consumer that wants the same toolchain registers it
# itself, as .github/consumer-test does. The extension usage itself stays
# non-dev: its extension_metadata reports non-dev root deps, which Bazel
# rejects if the only usage is dev.
bazel_dep(name = "llvm", version = "0.8.24")

llvm_toolchains = use_extension("@llvm//extensions:toolchain.bzl", "toolchain")
llvm_toolchains.exec(
    arch = "x86_64",
    os = "linux",
)
llvm_toolchains.target(
    arch = "x86_64",
    os = "linux",
)
use_repo(llvm_toolchains, "llvm_toolchains")

register_toolchains(
    "@llvm_toolchains//:all",
    dev_dependency = True,
)
