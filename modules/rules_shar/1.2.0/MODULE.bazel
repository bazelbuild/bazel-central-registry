module(
    name = "rules_shar",
    version = "1.2.0",
    bazel_compatibility = [">=8.0.0"],
)

bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_pkg", version = "1.2.0")


# Even though we don't use this directly, it will upgrade
# any dep protobuf use to prebuilt protoc. This makes
# compilatio times way shorter than they othewise would be.
bazel_dep(name = "protobuf", version = "34.1")
# Without this, protobuf above fails.
bazel_dep(name = "rules_cc", version = "0.2.18")
# Without this, 9.x bazel builds fail on github actions.
bazel_dep(name = "rules_android", version = "0.7.2")

