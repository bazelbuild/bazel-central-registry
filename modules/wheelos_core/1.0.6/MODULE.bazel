module(
    name = "wheelos_core",
    version = "1.0.6",
    compatibility_level = 1,
)

bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "rules_cc", version = "0.0.9")
bazel_dep(name = "rules_cuda", version = "0.3.0")
bazel_dep(name = "rules_pkg", version = "0.10.1")
bazel_dep(name = "rules_proto", version = "6.0.2")
bazel_dep(name = "pybind11_bazel", version = "2.13.6")
bazel_dep(name = "rules_python", version = "0.34.0")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.10",
)

bazel_dep(name = "platforms", version = "0.0.10")
bazel_dep(name = "abseil-cpp", version = "20240116.2", repo_name = "com_google_absl")
bazel_dep(name = "gflags", version = "2.2.2", repo_name = "com_github_gflags_gflags")
bazel_dep(name = "glog", version = "0.7.1", repo_name = "com_github_google_glog")
bazel_dep(name = "googletest", version = "1.14.0.bcr.1", repo_name = "com_google_googletest")
bazel_dep(name = "protobuf", version = "29.0.bcr.1", repo_name = "com_google_protobuf")
bazel_dep(name = "flatbuffers", version = "24.3.25")
bazel_dep(name = "zlib", version = "1.3.1.bcr.1")
bazel_dep(name = "ncurses", version = "6.4.20221231.bcr.4")
bazel_dep(name = "libuuid", version = "2.39.3.bcr.1")
bazel_dep(name = "wheelos_fastcdr", version = "2.2.7.bcr.1", repo_name = "fastcdr")
bazel_dep(name = "wheelos_fastdds", version = "2.14.6.bcr.5", repo_name = "fastdds")
bazel_dep(name = "iceoryx", version = "2.95.4")
bazel_dep(name = "liburing", version = "2.14.bcr.1")
bazel_dep(name = "yaml-cpp", version = "0.9.0")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
cuda.toolkit(
    name = "cuda",
    toolkit_path = "/usr/local/cuda",
)
use_repo(cuda, "cuda")
