load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(
    default_package_metadata = [":package_metadata"],
    default_visibility = ["//visibility:public"],
)

exports_files([
    "README.md",
    "VERSION.txt",
    "webgpu/src/LICENSE",
    "webgpu_cpp/LICENSE",
])

# Dawn / webgpu-native headers and C++ bindings.
license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:BSD-3-Clause",
    text = "webgpu_cpp/LICENSE",
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
)

# Emscripten-derived sources are "MIT OR NCSA"; dual licensing is not modelled
# by @package_metadata yet, so MIT (as used in the SPDX headers) is declared.
license(
    name = "license_emscripten",
    kind = "@package_metadata//licenses/spdx:MIT",
    text = "webgpu/src/LICENSE",
)

package_metadata(
    name = "package_metadata_emscripten",
    attributes = [":license_emscripten"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
)

# <webgpu/webgpu.h> (Dawn flavour, includes the Emscripten/Dawn extensions).
cc_library(
    name = "webgpu_headers",
    hdrs = ["webgpu/include/webgpu/webgpu.h"],
    strip_include_prefix = "webgpu/include",
)

# Dawn-style C++ bindings: <webgpu/webgpu_cpp.h>.
cc_library(
    name = "webgpu_cpp",
    hdrs = glob(["webgpu_cpp/include/**/*.h"]),
    strip_include_prefix = "webgpu_cpp/include",
    deps = [":webgpu_headers"],
)

# Order matters: library_webgpu.js depends on the generated tables.
_JS_LIBRARIES = [
    "webgpu/src/library_webgpu_enum_tables.js",
    "webgpu/src/library_webgpu_generated_struct_info.js",
    "webgpu/src/library_webgpu_generated_sig_info.js",
    "webgpu/src/library_webgpu.js",
]

filegroup(
    name = "js_libraries",
    srcs = _JS_LIBRARIES,
    package_metadata = [":package_metadata_emscripten"],
)

filegroup(
    name = "closure_externs",
    srcs = ["webgpu/src/webgpu-externs.js"],
    package_metadata = [":package_metadata_emscripten"],
)

# Bazel-native equivalent of `emcc --use-port=emdawnwebgpu`: compiles webgpu.cpp
# and passes the JS bindings via --js-library. Do not combine with --use-port.
cc_library(
    name = "emdawnwebgpu",
    srcs = ["webgpu/src/webgpu.cpp"],
    additional_linker_inputs = _JS_LIBRARIES,
    copts = [
        "-std=c++20",
        "-fno-exceptions",
    ],
    linkopts = [
        opt
        for js in _JS_LIBRARIES
        for opt in [
            "--js-library",
            "$(execpath {})".format(js),
        ]
    ],
    package_metadata = [":package_metadata_emscripten"],
    target_compatible_with = ["@platforms//os:emscripten"],
    deps = [
        ":webgpu_cpp",
        ":webgpu_headers",
    ],
)
