load("@emsdk//emscripten_toolchain:wasm_rules.bzl", "wasm_cc_binary")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_test")

cc_test(
    name = "webgpu_headers_test",
    srcs = ["webgpu_headers_test.cc"],
    deps = ["@emdawnwebgpu//:webgpu_cpp"],
)

cc_binary(
    name = "webgpu_smoke",
    srcs = ["webgpu_smoke.cc"],
    tags = ["manual"],
    deps = ["@emdawnwebgpu"],
)

wasm_cc_binary(
    name = "webgpu_smoke_wasm",
    cc_target = ":webgpu_smoke",
    outputs = [
        "webgpu_smoke.js",
        "webgpu_smoke.wasm",
    ],
)
