load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Run explicitly in Clang jobs. Both this consumer and ngspice must initialize
# OpenMP without loading separate copies of LLVM's runtime into one process.
cc_test(
    name = "consumer",
    size = "small",
    srcs = ["consumer.cc"],
    args = ["$(rootpath //:.spiceinit)"],
    copts = [
        "-std=c++17",
        "-Xclang=-fopenmp",
    ],
    data = ["//:.spiceinit"],
    env = {
        "OMP_DYNAMIC": "FALSE",
        "OMP_THREAD_LIMIT": "2",
    },
    tags = ["manual"],
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        "@ngspice",
        "@openmp",
    ],
)
