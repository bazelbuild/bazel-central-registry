load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Run explicitly in the Linux GCC jobs: this consumer uses its own OpenMP
# runtime, so ngspice must not replace GCC's omp.h with LLVM's incompatible one.
cc_test(
    name = "consumer",
    size = "small",
    srcs = ["consumer.cc"],
    copts = ["-fopenmp"],
    env = {
        "OMP_DYNAMIC": "FALSE",
        "OMP_THREAD_LIMIT": "2",
    },
    linkopts = ["-fopenmp"],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:linux"],
    deps = ["@ngspice"],
)
