/* Native Bazel configuration for ngspice 47. No host probes are executed. */
#ifndef NGSPICE_BAZEL_CONFIG_H
#define NGSPICE_BAZEL_CONFIG_H

#ifndef _GNU_SOURCE
#define _GNU_SOURCE 1
#endif

#if !defined(__GNUC__) && !defined(__clang__)
#error "ngspice supports GCC and Clang toolchains"
#endif
#ifndef __has_include
#error "ngspice requires a compiler with __has_include support"
#endif
#if !defined(__linux__) && !(defined(__APPLE__) && defined(__MACH__))
#error "ngspice supports Linux and macOS targets"
#endif
#ifdef __cplusplus
#if __cplusplus < 201103L
#error "ngspice requires C++11 or newer"
#endif
#else
#if !defined(__STDC_VERSION__) || __STDC_VERSION__ < 201112L
#error "ngspice requires C11 or newer"
#endif
#endif

/* Required C/POSIX headers also identify the target libc. Feature-test
 * macros must be set before these includes, including in upstream files
 * that include a system header before config.h. */
#include <limits.h>
#include <math.h>
#include <sys/types.h>
#include <unistd.h>

#if !defined(_POSIX_VERSION) || _POSIX_VERSION < 200112L
#error "ngspice requires a POSIX.1-2001 or newer libc"
#endif
#if !defined(_POSIX_THREADS) || _POSIX_THREADS < 0
#error "ngspice requires POSIX threads"
#endif
#if INT_MAX < 2147483647
#error "ngspice requires an int type of at least 32 bits"
#endif
#if defined(__GLIBC__) && defined(__GLIBC_PREREQ)
#if !__GLIBC_PREREQ(2, 17)
#error "ngspice requires glibc 2.17 or newer (clock_gettime in libc)"
#endif
#endif

/* C99 provides isnan/isinf macros in C; C++11 provides their overloads.
 * Require them instead of selecting upstream's legacy replacements. */
#ifndef __cplusplus
#if !defined(isinf) || !defined(isnan)
#error "ngspice requires the C99 isinf and isnan macros"
#endif
#endif
#define HAVE_DECL_ISINF 1
#define HAVE_DECL_ISNAN 1

#define PACKAGE "ngspice"
#define PACKAGE_NAME "ngspice"
#define PACKAGE_TARNAME "ngspice"
#define PACKAGE_STRING "ngspice 47"
#define PACKAGE_VERSION "47"
#define VERSION "47"
#define PACKAGE_BUGREPORT "https://ngspice.sourceforge.io/bugrep.html"
#define PACKAGE_URL "https://ngspice.sourceforge.io/"
/* The release archive's configure timestamp, not the machine's clock. */
#define NGSPICEBUILDDATE "2026-08-10"
/* The launcher and embedding application supply runtime paths explicitly. */
#define NGSPICEBINDIR "bin"
#define NGSPICEDATADIR "share/ngspice"
#define NGSPICELIBDIR "lib/ngspice"

#define KLU 1
#define RFSPICE 1
#define NOINTHELP 1
#define X_DISPLAY_MISSING 1
/* Release-generated Flex 2.6.4/Bison 3.8.2 sources need no parser tools. */
#define YYTEXT_POINTER 1
@XSPICE@
/* Upstream uses wall-clock timing for OpenMP, CPU timing otherwise. */
@OPENMP@

/* C11 and POSIX.1-2001 functions/headers required by the selected sources.
 * Their actual uses are compiled and linked by the normal native targets. */
#define STDC_HEADERS 1
#define HAVE_ACCESS 1
#define HAVE_ACOSH 1
#define HAVE_ARPA_INET_H 1
#define HAVE_ASINH 1
#define HAVE_ATANH 1
#define HAVE_CTYPE_H 1
#define HAVE_DIRENT_H 1
#define HAVE_DIRNAME 1
#define HAVE_DLFCN_H 1
#define HAVE_DUP2 1
#define HAVE_ENDPWENT 1
#define HAVE_ERFC 1
#define HAVE_FCNTL_H 1
#define HAVE_FLOAT_H 1
#define HAVE_FORK 1
#define HAVE_GETCWD 1
#define HAVE_GETHOSTBYNAME 1
#define HAVE_GETRLIMIT 1
#define HAVE_GETTIMEOFDAY 1
#define HAVE_INTTYPES_H 1
#define HAVE_ISATTY 1
#define HAVE_LIBM 1
#define HAVE_LIBPTHREAD 1
#define HAVE_LIMITS_H 1
#define HAVE_LOCALTIME 1
#define HAVE_LOGB 1
#define HAVE_MEMMOVE 1
#define HAVE_MEMSET 1
#define HAVE_MODF 1
#define HAVE_NETDB_H 1
#define HAVE_NETINET_IN_H 1
#define HAVE_POPEN 1
#define HAVE_PWD_H 1
#define HAVE_QSORT 1
#define HAVE_SCALBN 1
#define HAVE_SELECT 1
#define HAVE_SIGSETJMP 1
#define HAVE_SNPRINTF 1
#define HAVE_SOCKET 1
#define HAVE_STDBOOL_H 1
#define HAVE_STDDEF_H 1
#define HAVE_STDINT_H 1
#define HAVE_STDIO_H 1
#define HAVE_STDLIB_H 1
#define HAVE_STRCHR 1
#define HAVE_STRDUP 1
#define HAVE_STRERROR 1
#define HAVE_STRINGS_H 1
#define HAVE_STRING_H 1
#define HAVE_STRNCASECMP 1
#define HAVE_STRRCHR 1
#define HAVE_STRSTR 1
#define HAVE_STRTOL 1
#define HAVE_SYS_FILE_H 1
#define HAVE_SYS_IOCTL_H 1
#define HAVE_SYS_PARAM_H 1
#define HAVE_SYS_SELECT_H 1
#define HAVE_SYS_SOCKET_H 1
#define HAVE_SYS_STAT_H 1
#define HAVE_SYS_TIME_H 1
#define HAVE_SYS_TYPES_H 1
#define HAVE_SYS_WAIT_H 1
#define HAVE_TCGETATTR 1
#define HAVE_TCSETATTR 1
#define HAVE_TERMIOS_H 1
#define HAVE_TIME 1
#define HAVE_TSEARCH 1
#define HAVE_UNISTD_H 1
#define HAVE_UTIMES 1
#define HAVE_VPRINTF 1
#define HAVE__BOOL 1
#define SELECT_TYPE_ARG1 int
#define SELECT_TYPE_ARG234 (fd_set *)
#define SELECT_TYPE_ARG5 (struct timeval *)

#if defined(__linux__)
#define OS_COMPILED 6
/* This selects a Linux runtime API, not an execution-host file probe. */
#define HAVE__PROC_MEMINFO 1
#define HAVE_CLOCK_GETTIME 1
#else
#define OS_COMPILED 7
/* clock_gettime was introduced in macOS 10.12. Older deployment targets
 * retain upstream's gettimeofday fallback even with a newer SDK. */
#if defined(__ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__) && \
    __ENVIRONMENT_MAC_OS_X_VERSION_MIN_REQUIRED__ >= 101200
#define HAVE_CLOCK_GETTIME 1
#endif
#endif

/* Optional SDK headers are detected from the selected compiler's include
 * search path. Header presence does not enable an optional library. */
#if __has_include(<getopt.h>)
#define HAVE_GETOPT_H 1
/* The supported Linux and macOS libc implementations provide getopt_long
 * in getopt.h. If the header is absent, use ngspice's BSD implementation. */
#define HAVE_GETOPT_LONG 1
#endif
#if __has_include(<ieeefp.h>)
#define HAVE_IEEEFP_H 1
#endif
#if __has_include(<malloc.h>)
#define HAVE_MALLOC_H 1
#endif
#if __has_include(<sys/io.h>)
#define HAVE_SYS_IO_H 1
#endif
#if __has_include(<sys/sysctl.h>)
#define HAVE_SYS_SYSCTL_H 1
#endif
#if __has_include(<sys/timeb.h>)
#define HAVE_SYS_TIMEB_H 1
#endif
#if __has_include(<values.h>)
#define HAVE_VALUES_H 1
#endif

/* These are libc extensions, not POSIX guarantees. Other libcs use the
 * upstream scalb fallback; tdestroy is used only by a diagnostic command. */
#if defined(__GLIBC__)
#define HAVE_TDESTROY 1
#define HAVE_SCALB 1
#elif defined(__APPLE__) && defined(__MACH__)
#define HAVE_SCALB 1
#endif

/* Leave HAVE_FINITE and libc-specific signal-handler typedefs undefined:
 * C99 classification and the standard void (*)(int) signal type suffice.
 * SHARED_MODULE is supplied privately by API targets. CIDER, OSDI, Tcl,
 * X11, readline/editline, termcap, FFTW, GC, and audio remain disabled. */
#endif /* NGSPICE_BAZEL_CONFIG_H */
