# Bazel build of AsmJit (CMakeLists.txt) as a static library (ASMJIT_STATIC)
# with its x86 and AArch64 backends.
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(default_applicable_licenses = [":license"])

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Zlib"],
    license_text = "LICENSE.md",
)

exports_files(["LICENSE.md"])

cc_library(
    name = "asmjit",
    srcs = glob(["src/asmjit/**/*.cpp"]),
    hdrs = glob(["src/asmjit/**/*.h"]),
    # AsmJit requires C++17 (target_compile_features(... cxx_std_17)).
    copts = select({
        "@rules_cc//cc/compiler:clang-cl": ["/std:c++17"],
        "@rules_cc//cc/compiler:msvc-cl": ["/std:c++17"],
        "//conditions:default": ["-std=c++17"],
    }),
    defines = ["ASMJIT_STATIC"],
    includes = ["src"],
    linkopts = select({
        "@platforms//os:linux": [
            "-lpthread",
            "-lrt",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)
