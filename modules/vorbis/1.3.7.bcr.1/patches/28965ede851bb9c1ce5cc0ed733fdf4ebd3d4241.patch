From 28965ede851bb9c1ce5cc0ed733fdf4ebd3d4241 Mon Sep 17 00:00:00 2001
From: Chun-Min Chang <chun.m.chang@gmail.com>
Date: Wed, 13 May 2026 17:16:41 -0700
Subject: [PATCH] Replace alloca with _ogg_malloc in vorbis_book_init_decode

vorbis_book_init_decode() uses two alloca() calls sized by the number
of used codebook entries (n), which is attacker-controlled via the
Vorbis setup header:

    codep     = alloca(sizeof(*codep) * n)     /* 8*n on 64-bit */
    sortindex = alloca(n * sizeof(*sortindex))  /* 4*n            */

The existing ov_ilog(dim)+ov_ilog(entries)>24 check in
vorbis_staticbook_unpack() bounds dim*entries but not entries alone.
When dim is small (e.g. dim=0 where ov_ilog(0)=0, or dim=1..8), the
check allows millions of entries through, producing alloca sizes that
exceed the thread stack and jump past the guard page (stack-clash).

Replace both alloca() calls with _ogg_malloc() and route allocation
failure through the existing err_out path. The scratch pointers
(codes, codep, sortindex) are hoisted to the top of the function and
initialized to NULL so the err_out block can free them unconditionally
(set to NULL again after each early free so double-free is impossible).

The performance difference is negligible: this runs once per codebook
at init time, not in the decode hot path.
---
 lib/sharedbook.c | 22 ++++++++++++++++------
 1 file changed, 16 insertions(+), 6 deletions(-)

diff --git a/lib/sharedbook.c b/lib/sharedbook.c
index 7a98b479..f3dfdeb9 100644
--- a/lib/sharedbook.c
+++ b/lib/sharedbook.c
@@ -326,7 +326,9 @@ static int sort32a(const void *a,const void *b){
 /* decode codebook arrangement is more heavily optimized than encode */
 int vorbis_book_init_decode(codebook *c,const static_codebook *s){
   int i,j,n=0,tabn;
-  int *sortindex;
+  int *sortindex=NULL;
+  ogg_uint32_t *codes=NULL;
+  ogg_uint32_t **codep=NULL;
 
   memset(c,0,sizeof(*c));
 
@@ -351,11 +353,12 @@ int vorbis_book_init_decode(codebook *c,const static_codebook *s){
     by sorted bitreversed codeword to allow treeless decode. */
 
     /* perform sort */
-    ogg_uint32_t *codes=_make_words(s->lengthlist,s->entries,c->used_entries);
-    ogg_uint32_t **codep=alloca(sizeof(*codep)*n);
-
+    codes=_make_words(s->lengthlist,s->entries,c->used_entries);
     if(codes==NULL)goto err_out;
 
+    codep=_ogg_malloc(sizeof(*codep)*n);
+    if(codep==NULL)goto err_out;
+
     for(i=0;i<n;i++){
       codes[i]=bitreverse(codes[i]);
       codep[i]=codes+i;
@@ -363,17 +366,20 @@ int vorbis_book_init_decode(codebook *c,const static_codebook *s){
 
     qsort(codep,n,sizeof(*codep),sort32a);
 
-    sortindex=alloca(n*sizeof(*sortindex));
+    sortindex=_ogg_malloc(n*sizeof(*sortindex));
+    if(sortindex==NULL)goto err_out;
+
     c->codelist=_ogg_malloc(n*sizeof(*c->codelist));
     /* the index is a reverse index */
     for(i=0;i<n;i++){
       int position=codep[i]-codes;
       sortindex[position]=i;
     }
+    _ogg_free(codep); codep=NULL;
 
     for(i=0;i<n;i++)
       c->codelist[sortindex[i]]=codes[i];
-    _ogg_free(codes);
+    _ogg_free(codes); codes=NULL;
 
     c->valuelist=_book_unquantize(s,n,sortindex);
     c->dec_index=_ogg_malloc(n*sizeof(*c->dec_index));
@@ -390,6 +396,7 @@ int vorbis_book_init_decode(codebook *c,const static_codebook *s){
         if(s->lengthlist[i]>c->dec_maxlength)
           c->dec_maxlength=s->lengthlist[i];
       }
+    _ogg_free(sortindex); sortindex=NULL;
 
     if(n==1 && c->dec_maxlength==1){
       /* special case the 'single entry codebook' with a single bit
@@ -447,6 +454,9 @@ int vorbis_book_init_decode(codebook *c,const static_codebook *s){
 
   return(0);
  err_out:
+  _ogg_free(sortindex);
+  _ogg_free(codep);
+  _ogg_free(codes);
   vorbis_book_clear(c);
   return(-1);
 }
