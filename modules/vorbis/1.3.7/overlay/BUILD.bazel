load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

_PRIVATE_HEADERS = glob(["lib/**/*.h"])

_MATH_LINKOPTS = select({
    "@platforms//os:windows": [],
    "//conditions:default": ["-lm"],
})

cc_library(
    name = "headers",
    hdrs = glob(["include/vorbis/*.h"]),
    includes = ["include"],
    deps = ["@ogg"],
)

cc_library(
    name = "vorbis",
    srcs = [
        "lib/analysis.c",
        "lib/bitrate.c",
        "lib/block.c",
        "lib/codebook.c",
        "lib/envelope.c",
        "lib/floor0.c",
        "lib/floor1.c",
        "lib/info.c",
        "lib/lookup.c",
        "lib/lpc.c",
        "lib/lsp.c",
        "lib/mapping0.c",
        "lib/mdct.c",
        "lib/psy.c",
        "lib/registry.c",
        "lib/res0.c",
        "lib/sharedbook.c",
        "lib/smallft.c",
        "lib/synthesis.c",
        "lib/window.c",
    ] + _PRIVATE_HEADERS,
    includes = ["lib"],
    linkopts = _MATH_LINKOPTS,
    deps = [":headers"],
)

cc_library(
    name = "vorbisenc",
    srcs = ["lib/vorbisenc.c"] + _PRIVATE_HEADERS,
    deps = [":vorbis"],
)

cc_library(
    name = "vorbisfile",
    srcs = ["lib/vorbisfile.c"],
    deps = [":vorbis"],
)

cc_test(
    name = "codec_roundtrip_test",
    srcs = [
        "test/test.c",
        "test/util.c",
        "test/util.h",
        "test/write_read.c",
        "test/write_read.h",
    ],
    deps = [
        ":vorbisenc",
        ":vorbisfile",
    ],
)

cc_test(
    name = "sharedbook_test",
    srcs = ["lib/sharedbook.c"] + _PRIVATE_HEADERS,
    defines = ["_V_SELFTEST"],
    linkopts = _MATH_LINKOPTS,
    deps = [":headers"],
)
