/* The -D flags unix/configure writes to its `flags` file, as a header the
   build passes with -include so every compile sees them first, the way the
   Makefile's CF variable does.  Each line is one flag configure can add,
   in its order; configure.bzl beside the BUILD file asks the questions. */
#undef NO_PROTO
#undef NO_CONST
#undef NO_TIME_T
#undef NO_SIZE_T
#undef NO_OFF_T
#undef LARGE_FILE_SUPPORT
#undef UNICODE_SUPPORT
#undef UNICODE_WCHAR
#undef UTF8_MAYBE_NATIVE
#undef NO_SETLOCALE
#undef NO_FCHMOD
#undef NO_FCHOWN
#undef NO_LCHOWN
#undef NO_NL_LANGINFO
#undef NO_LCHMOD
#undef ZMEM
#undef NO_ERRNO
#undef NO_DIR
#undef HAVE_DIRENT_H
#undef HAVE_SYS_NDIR_H
#undef HAVE_NDIR_H
#undef HAVE_SYS_DIR_H
#undef NO_STDLIB_H
#undef NO_STDDEF_H
#undef NO_UNISTD_H
#undef NO_FCNTL_H
#undef NO_STRING_H
#undef NO_LANGINFO_H
#undef HAVE_TERMIOS_H
#undef HAVE_TERMIO_H
#undef HAVE_SGTTY_H
#undef HAVE_MBSTRING_H
#undef HAVE_MBCTYPE_H
#undef _MBCS
#undef NO_MBCS
#undef MBSCHR
#undef MBSRCHR
#undef NO_VALLOC
