# The module is named filmil_upspin_drive: it belongs to filmil/upspin, a
# spin-off of Upspin, and the upspin names belong to the original project.
module(
    name = "filmil_upspin_drive",
    version = "46.1.3",
    bazel_compatibility = [">=8.0.0"],
)

bazel_dep(name = "rules_go", version = "0.61.1")
bazel_dep(name = "gazelle", version = "0.51.3")
# A released filmil_upspin from the custom registry (.bazelrc), so that the
# version named here is the code that is built. Keep it in step with the
# replace line in go.mod and with bazel_dep(name = "filmil_upspin") in
# integration/MODULE.bazel. repo_name keeps the labels @upspin//....
bazel_dep(name = "filmil_upspin", version = "46.5.3", repo_name = "upspin")

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)

# The Go version comes from go.mod, the one place that names it.
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# upspin.io comes from the upspin Bazel module above (@upspin), not from
# go_deps. A go_deps.gazelle_override for it would make this module unusable
# as a dependency: gazelle forbids that tag in a non-root module.
use_repo(
    go_deps,
    "org_golang_google_api",
    "org_golang_x_oauth2",
)

bazel_dep(name = "rules_oci", version = "2.3.0", dev_dependency = True)
bazel_dep(name = "rules_pkg", version = "1.2.0", dev_dependency = True)
bazel_dep(name = "platforms", version = "1.1.0", dev_dependency = True)
bazel_dep(name = "bazel_lib", version = "3.3.1", dev_dependency = True)

oci = use_extension("@rules_oci//oci:extensions.bzl", "oci", dev_dependency = True)
oci.pull(
    name = "distroless_base",
    digest = "sha256:d75cdd72874d4790092fcb1b058493ecf6bb5bf2b2b897045b00ff01d91843f2",
    image = "gcr.io/distroless/static-debian12",
    platforms = [
        "linux/amd64",
        "linux/arm/v7",
        "linux/arm64/v8",
        "linux/ppc64le",
        "linux/s390x",
    ],
)
use_repo(oci, "distroless_base", "distroless_base_linux_amd64", "distroless_base_linux_arm64_v8", "distroless_base_linux_arm_v7", "distroless_base_linux_ppc64le", "distroless_base_linux_s390x")
