"""Tests for the device-mapper library this module builds."""

load("@rules_cc//cc:cc_test.bzl", "cc_test")

# dmsetup itself cannot be exercised here: every subcommand, `version`
# included, opens /dev/mapper/control first.  The library's version string is
# the one thing reachable without the kernel driver, and it pins DM_LIB_VERSION
# to VERSION_DM.
cc_test(
    name = "version_test",
    size = "small",
    srcs = ["version_test.c"],
    deps = ["//:devmapper"],
)
