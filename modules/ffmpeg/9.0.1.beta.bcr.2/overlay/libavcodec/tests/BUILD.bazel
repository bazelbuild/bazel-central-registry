load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//:component_flags.bzl", "cc_variant_test")

_FFMPEG_TEST_COPTS = [
    "-D_ISOC11_SOURCE",
    "-D_FILE_OFFSET_BITS=64",
    "-D_LARGEFILE_SOURCE",
] + select({
    "@rules_cc//cc/compiler:clang-cl": ["/std:c17"],
    "@rules_cc//cc/compiler:msvc-cl": ["/std:c17"],
    "//conditions:default": [
        "-std=c17",
        "-Wno-error=implicit-function-declaration",
    ],
}) + select({
    "@platforms//os:macos": ["-D_DARWIN_C_SOURCE"],
    "//conditions:default": [],
})

# Public-API tests — representative of external consumption.
[
    cc_variant_test(
        name = src + "_test",
        srcs = [src + ".c"],
        copts = _FFMPEG_TEST_COPTS,
        deps = [
            "//:avcodec",
        ],
    )
    for src in [
        "avpacket",
        "codec_desc",
    ]
]

# Bazel versions less than 9 do not have `cc_test.additional_compiler_inputs`
cc_library(
    name = "bitstream_template_access",
    testonly = True,
    includes = ["."],
    textual_hdrs = ["bitstream_template.c"],
)

# Internal tests — exercise internals via private headers.
[
    cc_variant_test(
        name = src + "_test",
        srcs = [src + ".c"],
        copts = ["-DHAVE_AV_CONFIG_H"] + _FFMPEG_TEST_COPTS,
        deps = [
            ":bitstream_template_access",
            "//:avcodec",
            "//:avcodec_test_hdrs",
        ],
    )
    for src in [
        "bitstream_be",
        "bitstream_le",
    ]
]
