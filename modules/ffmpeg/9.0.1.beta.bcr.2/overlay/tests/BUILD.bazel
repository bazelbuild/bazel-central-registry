load("//:component_flags.bzl", "BUILD_VARIANTS", "cc_variant_test", "component_config_copts", "variant_prefix")

[
    genrule(
        name = variant_prefix(v) + tool + "_version",
        outs = [(v.replace("-", "_") + "_" if v else "") + tool + "_version.txt"],
        cmd = "$(execpath //:{}{}) -version > $@".format(
            variant_prefix(v),
            tool,
        ),
        tools = ["//:{}{}".format(
            variant_prefix(v),
            tool,
        )],
    )
    for v in BUILD_VARIANTS
    for tool in [
        "ffmpeg",
        "ffprobe",
    ]
]

_EXTERNAL_CODECS = [
    "libcodec2_decoder",
    "libcodec2_encoder",
    "libdav1d_decoder",
    "libgsm_decoder",
    "libgsm_encoder",
    "libgsm_ms_decoder",
    "libgsm_ms_encoder",
    "libjxl_anim_decoder",
    "libjxl_anim_encoder",
    "libjxl_decoder",
    "libjxl_encoder",
    "libmp3lame_encoder",
    "libopenjpeg_encoder",
    "librav1e_encoder",
    "libshine_encoder",
    "libspeex_decoder",
    "libspeex_encoder",
    "libtwolame_encoder",
    "libvorbis_decoder",
    "libvorbis_encoder",
    "libxvid_encoder",
]

cc_variant_test(
    name = "external_codecs_test",
    size = "small",
    srcs = ["external_codecs_test.c"],
    copts = select({
        "@rules_cc//cc/compiler:clang-cl": ["/std:c17"],
        "@rules_cc//cc/compiler:msvc-cl": ["/std:c17"],
        "//conditions:default": ["-std=c17"],
    }) + component_config_copts(_EXTERNAL_CODECS + [
        "libx264_encoder",
        "libx264rgb_encoder",
        "libx265_encoder",
        "gplv3",
        "lgplv3",
    ]),
    env = {
        "OPJ_NUM_THREADS": "1",
        "RAYON_NUM_THREADS": "1",
    },
    deps = [
        "//:avcodec",
        "//:avformat",
        "//:avutil",
    ],
)
