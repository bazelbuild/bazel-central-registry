    # cross_compiling: mpfr_cv_have_subnorm_dbl="cannot test, assume no"
    "probe:mpfr_cv_have_subnorm_dbl": "yes",

    # ---- probe: mpfr_cv_have_subnorm_flt
    # why:   AC_RUN_IFELSE sets mpfr_cv_have_subnorm_flt at run time; its cross-compiling branch guesses the same value on every platform
    # acinclude.m4:274-302:
    # ```m4
    #     AC_RUN_IFELSE([AC_LANG_SOURCE([[
    #   #include <float.h>
    #   #ifdef MPFR_HAVE_FESETROUND
    #   #include <fenv.h>
    #   #endif
    #   static double get_max (void);
    #   int main (void) {
    #     double x = 0.5;
    #     double y;
    #     int i;
    #     for (i = 1; i <= 11; i++)
    #       x *= x;
    #     if (x != 0)
    #       return 1;
    #   #ifdef MPFR_HAVE_FESETROUND
    #     /* Useful test for the G4 PowerPC */
    #     fesetround(FE_TOWARDZERO);
    #     x = y = get_max ();
    #     x *= 2.0;
    #     if (x != y)
    #       return 1;
    #   #endif
    #     return 0;
    #   }
    #   static double get_max (void) { static volatile double d = DBL_MAX; return d; }
    #     ]])],
    #        [mpfr_cv_gcc_floatconv_bug="no"],
    #        [mpfr_cv_gcc_floatconv_bug="yes, use -ffloat-store"],
    #        [mpfr_cv_gcc_floatconv_bug="cannot test, use -ffloat-store"])
    # ```
    # program:
    # ```c
    #   #include <stdio.h>
    #   int main (void) {
    #     volatile float x = 1.17549435082229e-38, y;
    #     y = x / 2.0f;
    #     fprintf (stderr, "%e\n", (double) y);
    #     return 2.0f * y != x;
    #   }
    # ```
    # action_if_true: mpfr_cv_have_subnorm_flt="yes"
    # action_if_false: mpfr_cv_have_subnorm_flt="no"
    # cross_compiling: mpfr_cv_have_subnorm_flt="cannot test, assume no"
    "probe:mpfr_cv_have_subnorm_flt": "yes",

    # ---- probe: mpfr_cv_intmax_within_limb
    # why:   configure.ac: AC_CACHE_CHECK([for intmax_t to fit in mp_limb_t], [mpfr_cv_intmax_within_limb], []): the cache value comes from shell around the probe, not from one probe
    # acinclude.m4:1065-1084:
    # ```m4
    #   AC_CACHE_CHECK([for intmax_t to fit in mp_limb_t], mpfr_cv_intmax_within_limb, [
    #   saved_CPPFLAGS="$CPPFLAGS"
    #   CPPFLAGS="$CPPFLAGS -I$srcdir/src -DMPFR_NEED_INTMAX_H"
    #   dnl AC_LINK_IFELSE is safer than AC_COMPILE_IFELSE, as it will detect
    #   dnl undefined function-like macros (which otherwise may be regarded
    #   dnl as valid function calls with AC_COMPILE_IFELSE since prototypes
    #   dnl are not required by the C standard).
    #   AC_LINK_IFELSE([AC_LANG_PROGRAM([[
    #   #include "gmp.h"
    #   /* Make sure that a static assertion is used (not MPFR_ASSERTN). */
    #   #undef MPFR_USE_STATIC_ASSERT
    #   #define MPFR_USE_STATIC_ASSERT 1
    #   #include "mpfr-sassert.h"
    #   #include "mpfr-intmax.h"
    #   ]], [[
    #     MPFR_STAT_STATIC_ASSERT ((mp_limb_t) -1 >= (uintmax_t) -1);
    #     return 0;
    #   ]])], [mpfr_cv_intmax_within_limb="yes"],
    #         [mpfr_cv_intmax_within_limb="no"])
    #   ])
    # ```
    "probe:mpfr_cv_intmax_within_limb": select({"@platforms//cpu:x86_32": "no", "//conditions:default": "yes"}),

    # ---- probe: mpfr_cv_long_within_limb
    # why:   configure.ac: AC_CACHE_CHECK([for long to fit in mp_limb_t], [mpfr_cv_long_within_limb], []): the cache value comes from shell around the probe, not from one probe
    # acinclude.m4:1033-1051:
    # ```m4
    #   AC_CACHE_CHECK([for long to fit in mp_limb_t], mpfr_cv_long_within_limb, [
    #   saved_CPPFLAGS="$CPPFLAGS"
    #   CPPFLAGS="$CPPFLAGS -I$srcdir/src"
    #   dnl AC_LINK_IFELSE is safer than AC_COMPILE_IFELSE, as it will detect
    #   dnl undefined function-like macros (which otherwise may be regarded
    #   dnl as valid function calls with AC_COMPILE_IFELSE since prototypes
    #   dnl are not required by the C standard).
    #   AC_LINK_IFELSE([AC_LANG_PROGRAM([[
    #   #include "gmp.h"
    #   /* Make sure that a static assertion is used (not MPFR_ASSERTN). */
    #   #undef MPFR_USE_STATIC_ASSERT
    #   #define MPFR_USE_STATIC_ASSERT 1
    #   #include "mpfr-sassert.h"
    #   ]], [[
    #     MPFR_STAT_STATIC_ASSERT ((mp_limb_t) -1 >= (unsigned long) -1);
    #     return 0;
    #   ]])], [mpfr_cv_long_within_limb="yes"],
    #         [mpfr_cv_long_within_limb="no"])
    #   ])
    # ```
    "probe:mpfr_cv_long_within_limb": "yes",

    # ---- probe: mpfr_cv_nanisnan
    # why:   AC_RUN_IFELSE sets mpfr_cv_nanisnan at run time; its cross-compiling branch guesses the same value on every platform
    # acinclude.m4:274-302:
    # ```m4
    #     AC_RUN_IFELSE([AC_LANG_SOURCE([[
    #   #include <float.h>
    #   #ifdef MPFR_HAVE_FESETROUND
    #   #include <fenv.h>
    #   #endif
    #   static double get_max (void);
    #   int main (void) {
    #     double x = 0.5;
    #     double y;
    #     int i;
    #     for (i = 1; i <= 11; i++)
    #       x *= x;
    #     if (x != 0)
    #       return 1;
    #   #ifdef MPFR_HAVE_FESETROUND
    #     /* Useful test for the G4 PowerPC */
    #     fesetround(FE_TOWARDZERO);
    #     x = y = get_max ();
    #     x *= 2.0;
    #     if (x != y)
    #       return 1;
    #   #endif
    #     return 0;
    #   }
    #   static double get_max (void) { static volatile double d = DBL_MAX; return d; }
    #     ]])],
    #        [mpfr_cv_gcc_floatconv_bug="no"],
    #        [mpfr_cv_gcc_floatconv_bug="yes, use -ffloat-store"],
    #        [mpfr_cv_gcc_floatconv_bug="cannot test, use -ffloat-store"])
    # ```
    # program:
    # ```c
    #   #include <stdio.h>
    #   #include <math.h>
    #   #ifndef NAN
    #   # define NAN (0.0/0.0)
    #   #endif
    #   int main (void) {
    #     double d;
    #     d = NAN;
    #     return d != d;
    #   }
