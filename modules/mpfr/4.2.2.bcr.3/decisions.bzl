    # action_if_true: mpfr_cv_nanisnan="yes"
    # action_if_false: mpfr_cv_nanisnan="no"
    # cross_compiling: mpfr_cv_nanisnan="cannot test, assume no"
    "probe:mpfr_cv_nanisnan": decision.IGNORE,

    # ---- variable: DATAFILES
    # why:   DATAFILES: the assignments cannot be expressed as one check
    # configure.ac:~888:
    # ```sh
    #   DATAFILES=`echo \`$SED -n \
    # ```
    # assignments:
    #   DATAFILES=$(echo \`$SED -n \
    #       's/^ *data_check *("\(data\/[^"]*\)".*/tests\/\1/p' \
    #       $srcdir/tests/*.c\`)  when test -n $dev_version
    "variable:DATAFILES": decision.IGNORE,

