load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_cc//cc:defs.bzl", "cc_library")

bool_flag(
    name = "use_mbedtls",
    build_setting_default = False,
)

config_setting(
    name = "use_mbedtls_setting",
    flag_values = {":use_mbedtls": "true"},
    visibility = ["//:__subpackages__"],
)

cc_library(
    name = "config",
    visibility = ["//:__subpackages__"],
    defines = select({
        "//:use_mbedtls_setting": [
            "HAVE_LIBMBEDCRYPTO",
            "HAVE_MBEDTLS_AES_H",
            "HAVE_MBEDTLS_MD_H",
            "HAVE_MBEDTLS_PKCS5_H",
            "HAVE_MBEDTLS_VERSION_H",
            # Digest providers, as CMake's CHECK_CRYPTO sets them when mbed TLS is found.
            # Without these, mtree's md5/sha* keywords and xar's checksums are silently
            # unavailable even though libmbedcrypto is linked in.
            "ARCHIVE_CRYPTO_MD5_MBEDTLS",
            "ARCHIVE_CRYPTO_RMD160_MBEDTLS",
            "ARCHIVE_CRYPTO_SHA1_MBEDTLS",
            "ARCHIVE_CRYPTO_SHA256_MBEDTLS",
            "ARCHIVE_CRYPTO_SHA384_MBEDTLS",
            "ARCHIVE_CRYPTO_SHA512_MBEDTLS",
        ],
        "//conditions:default": [],
    }),
    hdrs = select({
        "@platforms//os:windows": ["libarchive_bazel_windows_config.h"],
        "//conditions:default": ["libarchive_bazel_generic_config.h"],
    }),
)
