"""Go lint aspects (golangci-lint, archtest) for consumers that lint Go.

Imposes nothing beyond rules_go (minimum version; the consumer's own wins) and
this module's golangci-lint binary: no Go SDK is registered here.
"""

module(
    name = "gavel_tools_go",
    version = "0.4.0",
    compatibility_level = 1,
)

# Overrides only take effect when this is the root module (dev / CI here); for
# consumers they are ignored and the registry version of gavel_tools is used.
bazel_dep(name = "gavel_tools", version = "0.4.0")
local_path_override(
    module_name = "gavel_tools",
    path = "../..",
)

bazel_dep(name = "rules_go", version = "0.60.0")

# Linter binary repo, owned here so the aspect label (@golangci_lint) resolves
# within this module.
golangci_lint_binary = use_repo_rule("//lint/lang/go/golangci_lint:repositories.bzl", "golangci_lint_binary")

golangci_lint_binary(
    name = "golangci_lint",
    version = "2.11.4",
)
