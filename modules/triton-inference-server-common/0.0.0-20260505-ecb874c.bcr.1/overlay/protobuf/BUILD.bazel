load("@grpc//bazel:cc_grpc_library.bzl", "cc_grpc_library")
load("@grpc//bazel:python_rules.bzl", "py_grpc_library")
load("@protobuf//bazel:cc_proto_library.bzl", "cc_proto_library")
load("@protobuf//bazel:proto_library.bzl", "proto_library")
load("@protobuf//bazel:py_proto_library.bzl", "py_proto_library")

package(default_visibility = ["//visibility:public"])

# Triton's health.proto is a copy of gRPC's own grpc.health.v1 protocol (the
# messages are identical; gRPC's Health service also has Watch). Loading both
# copies, e.g. as shared libraries, aborts at startup on the duplicate
# grpc.health.v1 symbols. So Triton's copy is not built: the targets below
# depend on gRPC's instead, and users who included Triton's generated files
# get gRPC's, at src/proto/grpc/health/v1/health{.pb.h,_pb2}. Python Health
# service stubs are no longer included in common_py_pb2_grpc: py_grpc_library
# cannot generate them for a proto in another repository, and gRPC's own Python
# health targets (grpcio-health-checking) are built from yet another copy.
proto_library(
    name = "common_proto",
    srcs = [
        "grpc_service.proto",
        "model_config.proto",
    ],
    import_prefix = "triton_common/",
    deps = ["@grpc//src/proto/grpc/health/v1:health_proto"],
)

cc_proto_library(
    name = "common_cc_proto",
    deps = [":common_proto"],
)

cc_grpc_library(
    name = "common_cc_grpc",
    srcs = [":common_proto"],
    grpc_only = True,
    deps = [
        ":common_cc_proto",
        "@grpc//src/proto/grpc/health/v1:health_cc_grpc",
    ],
)

py_proto_library(
    name = "common_py_pb2",
    deps = [":common_proto"],
)

py_grpc_library(
    name = "common_py_pb2_grpc",
    srcs = [":common_proto"],
    deps = [":common_py_pb2"],
)
