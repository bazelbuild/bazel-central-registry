load("@rules_cc//cc:defs.bzl", "cc_library")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//licenses/rules:license_kind.bzl", "license_kind")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")

package(
    default_package_metadata = [":package_metadata"],
)

exports_files([
    "LICENSE_A2",
    "LICENSE_A2LLVM",
    "LICENSE_CC0",
])

license_kind(
    name = "license_kind",
    full_name = "Creative Commons Zero v1.0 Universal or Apache License 2.0 or Apache License 2.0 with LLVM Exception",
    identifier = "CC0-1.0 OR Apache-2.0 OR Apache-2.0 WITH LLVM-exception",
)

license(
    name = "license",
    kind = ":license_kind",
    text = "LICENSE_CC0",
    visibility = ["//visibility:public"],
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "blake3",
    deps = ["//c:blake3"],
    includes = ["c"],
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "tbb",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "tbb_enabled",
    flag_values = {":tbb": "true"},
    visibility = ["//:__subpackages__"],
)

platform(
    name = "internal_ci_only_do_not_use_windows_arm64",
    constraint_values = [
        "@@platforms//os:windows",
        "@@platforms//cpu:arm64",
    ],
)
