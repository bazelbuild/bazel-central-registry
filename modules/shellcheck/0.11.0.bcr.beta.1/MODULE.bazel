"""https://www.shellcheck.net/"""

module(
    name = "shellcheck",
    version = "0.11.0.bcr.beta.1",
    bazel_compatibility = [">=7.2.1"],
    compatibility_level = 1,
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_haskell", version = "1.0")

rules_haskell_dependencies = use_extension(
    "@rules_haskell//extensions:rules_haskell_dependencies.bzl",
    "rules_haskell_dependencies",
)
use_repo(rules_haskell_dependencies, "Cabal")

haskell_toolchains = use_extension(
    "@rules_haskell//extensions:haskell_toolchains.bzl",
    "haskell_toolchains",
    dev_dependency = True,
)
haskell_toolchains.bindists(version = "9.4.8")
use_repo(haskell_toolchains, "all_bindist_toolchains")

register_toolchains(
    "@all_bindist_toolchains//:all",
    dev_dependency = True,
)

stack_snapshot = use_extension(
    "@rules_haskell//extensions:stack_snapshot.bzl",
    "stack_snapshot",
)
stack_snapshot.snapshot(local_snapshot = "//:stack_snapshot.yaml")

[
    stack_snapshot.package(name = pkg)
    for pkg in [
        "Diff",
        "HUnit",
        "QuickCheck",
        "aeson",
        "array",
        "base",
        "bifunctors",
        "bytestring",
        "call-stack",
        "containers",
        "deepseq",
        "directory",
        "fgl",
        "filepath",
        "generic-deriving",
        "mtl",
        "parsec",
        "quickcheck-io",
        "regex-tdfa",
        "transformers",
        "transformers-compat",
    ]
]

[
    stack_snapshot.package(
        name = pkg,
        setup_deps = ["@Cabal//:Cabal"],
    )
    for pkg in [
        "HUnit",
        "bifunctors",
        "call-stack",
        "generic-deriving",
        "quickcheck-io",
        "transformers-compat",
    ]
]

use_repo(stack_snapshot, "stackage")
