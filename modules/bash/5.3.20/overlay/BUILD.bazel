load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:repo_root.bzl", "REPO_ROOT")

package(default_visibility = ["//visibility:private"])

licenses(["restricted"])  # GPL v3

exports_files(["COPYING"])

# Bash doesn't run on Windows without a POSIX emulation layer such as Cygwin or
# MSYS2.
_COMPATIBLE_WITH = select({
    "@platforms//os:linux": [],
    "@platforms//os:macos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# Bash's own headers have to take precedence over system headers of the same
# name (e.g. builtins/getopt.h) also for the builtins generated from .def files,
# which don't reside next to these headers.
_IQUOTE_COPTS = [
    flag
    for dir in [
        "",
        "/builtins",
        "/include",
        "/lib",
    ]
    for flag in [
        "-iquote",
        REPO_ROOT + dir,
        "-iquote",
        "$(GENDIR)/" + REPO_ROOT + dir,
    ]
]

# Matches the defaults of the upstream Makefile, except that the warnings
# enabled by modern compilers are silenced.
_COPTS = [
    "-DHAVE_CONFIG_H",
    "-DSHELL",
    "-w",
] + _IQUOTE_COPTS

# The equivalent of `./configure --without-bash-malloc --disable-nls`. The
# config.h files were generated by configure on Debian 10 (glibc 2.28) and
# macOS and are suitable for later versions of these OSes.
copy_file(
    name = "config_h",
    src = select({
        "@platforms//os:macos": "//bazel:config_macos.h",
        "//conditions:default": "//bazel:config_linux.h",
    }),
    out = "config.h",
)

# The upstream Makefile only uses this file if the compiler doesn't provide
# <stdckdint.h>. Using it unconditionally avoids having to detect that.
copy_file(
    name = "stdckdint_h",
    src = "include/stdckdint.in.h",
    out = "stdckdint.h",
)

# The headers needed by the build tools, which don't use config.h.
cc_library(
    name = "build_headers",
    hdrs = glob([
        "*.h",
        "include/*.h",
        "builtins/*.h",
    ]),
    includes = [
        ".",
        "builtins",
        "include",
    ],
)

cc_library(
    name = "headers",
    hdrs = [
        ":config_h",
        ":stdckdint_h",
    ] + glob([
        "lib/glob/*.h",
        "lib/readline/*.h",
        "lib/tilde/*.h",
    ]),
    includes = ["lib"],
    textual_hdrs = [
        "lib/glob/glob_loop.c",
        "lib/glob/gm_loop.c",
        "lib/glob/sm_loop.c",
        "lib/readline/emacs_keymap.c",
        "lib/readline/vi_keymap.c",
        "lib/sh/fmtulong.c",
    ],
    deps = [":build_headers"],
)

# Build tools that run during the build. As when cross-compiling with the
# upstream Makefile, they use buildconf.h instead of config.h.
cc_binary(
    name = "mkbuiltins",
    srcs = ["builtins/mkbuiltins.c"],
    copts = [
        "-DCROSS_COMPILING",
        "-w",
    ],
    deps = [":build_headers"],
)

cc_binary(
    name = "mksyntax",
    srcs = ["mksyntax.c"],
    copts = [
        "-DCROSS_COMPILING",
        "-w",
    ],
    deps = [":build_headers"],
)

genrule(
    name = "syntax_c",
    outs = ["syntax.c"],
    cmd = "$(execpath :mksyntax) -o $@",
    tools = [":mksyntax"],
)

# In the order of DEFSRC in builtins/Makefile.in.
_BUILTIN_DEFS = [
    "alias",
    "bind",
    "break",
    "builtin",
    "caller",
    "cd",
    "colon",
    "command",
    "declare",
    "echo",
    "enable",
    "eval",
    "getopts",
    "exec",
    "exit",
    "fc",
    "fg_bg",
    "hash",
    "help",
    "history",
    "jobs",
    "kill",
    "let",
    "read",
    "return",
    "set",
    "setattr",
    "shift",
    "source",
    "suspend",
    "test",
    "times",
    "trap",
    "type",
    "ulimit",
    "umask",
    "wait",
    "reserved",
    "pushd",
    "shopt",
    "printf",
    "complete",
    "mapfile",
]

# reserved.def only contains help texts.
_BUILTIN_SRCS = ["builtins/%s.c" % name for name in _BUILTIN_DEFS if name != "reserved"]

genrule(
    name = "builtins_c",
    srcs = ["builtins/%s.def" % name for name in _BUILTIN_DEFS],
    outs = _BUILTIN_SRCS + [
        "builtins/builtext.h",
        "builtins/builtins.c",
    ],
    cmd = """
MKBUILTINS="$$PWD/$(execpath :mkbuiltins)"
DEFS=""
for def in $(SRCS); do
  DEFS="$$DEFS $$PWD/$$def"
done
cd $(RULEDIR)/builtins
# The -D argument determines the file names in #line directives.
"$$MKBUILTINS" -externfile builtext.h -includefile builtext.h \
  -structfile builtins.c -noproduction -D builtins $$DEFS
for def in $$DEFS; do
  case "$$def" in
    */reserved.def) ;;
    *) "$$MKBUILTINS" -D builtins "$$def" ;;
  esac
done
""",
    tools = [":mkbuiltins"],
)

cc_library(
    name = "builtins",
    srcs = _BUILTIN_SRCS + [
        "builtins/bashgetopt.c",
        "builtins/builtext.h",
        "builtins/builtins.c",
        "builtins/common.c",
        "builtins/evalfile.c",
        "builtins/evalstring.c",
        "builtins/getopt.c",
    ],
    copts = _COPTS,
    target_compatible_with = _COMPATIBLE_WITH,
    deps = [":headers"],
)

cc_library(
    name = "glob",
    srcs = [
        "lib/glob/glob.c",
        "lib/glob/gmisc.c",
        "lib/glob/smatch.c",
        "lib/glob/strmatch.c",
        "lib/glob/xmbsrtowcs.c",
    ],
    copts = _COPTS,
    target_compatible_with = _COMPATIBLE_WITH,
    deps = [":headers"],
)

cc_library(
    name = "sh",
    srcs = [
        "lib/sh/%s.c" % name
        for name in [
            "anonfile",
            "casemod",
            "clktck",
            "clock",
            "compat",
            "eaccess",
            "fmtullong",
            "fmtulong",
            "fmtumax",
            "fnxform",
            "fpurge",
            "getenv",
            "gettimeofday",
            "input_avail",
            "itos",
            "mailstat",
            "makepath",
            "mbscasecmp",
            "mbschr",
            "mbscmp",
            "mbsncmp",
            "netconn",
            "netopen",
            "oslib",
            "pathcanon",
            "pathphys",
            "random",
            "setlinebuf",
            "shmatch",
            "shmbchar",
            "shquote",
            "shtty",
            "snprintf",
            "spell",
            "stringlist",
            "stringvec",
            "strnlen",
            "strscpy",
            "strtrans",
            "strvis",
            "timers",
            "timeval",
            "tmpfile",
            "uconvert",
            "ufuncs",
            "unicode",
            "utf8",
            "wcsdup",
            "wcsnwidth",
            "winsize",
            "zcatfd",
            "zgetline",
            "zmapfd",
            "zread",
            "zwrite",
        ]
    ] + select({
        # Replacements for functions that configure didn't find (LIBOBJS).
        "@platforms//os:macos": [
            "lib/sh/mktime.c",
            "lib/sh/reallocarray.c",
        ],
        "//conditions:default": ["lib/sh/strlcpy.c"],
    }),
    copts = _COPTS,
    target_compatible_with = _COMPATIBLE_WITH,
    deps = [":headers"],
)

cc_library(
    name = "tilde",
    srcs = ["lib/tilde/tilde.c"],
    copts = _COPTS,
    target_compatible_with = _COMPATIBLE_WITH,
    deps = [":headers"],
)

# The termcap library bundled with bash, which configure uses if it doesn't
# find one on the system. It reads terminal capabilities from $TERMCAP or
# /etc/termcap.
cc_library(
    name = "termcap",
    srcs = [
        "lib/termcap/ltcap.h",
        "lib/termcap/termcap.c",
        "lib/termcap/tparam.c",
    ],
    copts = _COPTS,
    target_compatible_with = _COMPATIBLE_WITH,
    deps = [":headers"],
)

# Readline and history as built by lib/readline/Makefile.in, except for
# tilde.c, which is identical to lib/tilde/tilde.c, and shell.c, whose
# functions are also defined by bash itself. The upstream build only avoids
# duplicate symbols because the linker doesn't need the archive member.
cc_library(
    name = "readline",
    srcs = [
        "lib/readline/%s.c" % name
        for name in [
            "bind",
            "callback",
            "colors",
            "compat",
            "complete",
            "display",
            "funmap",
            "histexpand",
            "histfile",
            "histsearch",
            "history",
            "input",
            "isearch",
            "keymaps",
            "kill",
            "macro",
            "mbutil",
            "misc",
            "nls",
            "parens",
            "parse-colors",
            "readline",
            "rltty",
            "savestring",
            "search",
            "signals",
            "terminal",
            "text",
            "undo",
            "util",
            "vi_mode",
            "xfree",
            "xmalloc",
        ]
    ],
    copts = _COPTS + [
        "-DREADLINE_LIBRARY",
        # On macOS, both readline and the bundled termcap library define PC,
        # but only readline defines BC and UP.
        "-fcommon",
    ],
    target_compatible_with = _COMPATIBLE_WITH,
    deps = [
        ":headers",
        ":termcap",
        ":tilde",
    ],
)

cc_binary(
    name = "bash",
    srcs = [
        "alias.c",
        "array.c",
        "arrayfunc.c",
        "assoc.c",
        "bashhist.c",
        "bashline.c",
        "bracecomp.c",
        "braces.c",
        "copy_cmd.c",
        "dispose_cmd.c",
        "error.c",
        "eval.c",
        "execute_cmd.c",
        "expr.c",
        "findcmd.c",
        "flags.c",
        "general.c",
        "hashcmd.c",
        "hashlib.c",
        "input.c",
        "jobs.c",
        "list.c",
        "locale.c",
        "mailcheck.c",
        "make_cmd.c",
        "pathexp.c",
        "pcomplete.c",
        "pcomplib.c",
        "print_cmd.c",
        "redir.c",
        "shell.c",
        "sig.c",
        "stringlib.c",
        "subst.c",
        "support/signames.c",
        "test.c",
        "trap.c",
        "unwind_prot.c",
        "variables.c",
        "version.c",
        "xmalloc.c",
        "y.tab.c",
        ":syntax_c",
    ],
    copts = _COPTS + [
        '-DPROGRAM=\\"bash\\"',
        '-DPACKAGE=\\"bash\\"',
        '-DLOCALEDIR=\\"/usr/local/share/locale\\"',
    ],
    linkopts = select({
        "@platforms//os:macos": ["-liconv"],
        "//conditions:default": ["-ldl"],
    }),
    target_compatible_with = _COMPATIBLE_WITH,
    visibility = ["//visibility:public"],
    deps = [
        ":builtins",
        ":glob",
        ":headers",
        ":readline",
        ":sh",
        ":tilde",
    ],
)
