module(name = "bash_test")

bazel_dep(name = "bash")
local_path_override(
    module_name = "bash",
    path = "..",
)

bazel_dep(name = "llvm", version = "0.8.24")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_shell", version = "0.8.0")

# Build with a hermetic LLVM toolchain to cover cross-compilation.
register_toolchains("@llvm//toolchain:all")

# Use the macOS SDK of the host, so macOS can only be targeted on macOS.
osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.from_host()
