# configure.ac's AC_REPLACE_FUNCS fallbacks in lib/sh, compiled where libc lacks the function
# (macOS has no reallocarray, glibc before 2.38 no strlcpy) and linked from the shell's own
# objects; the converter leaves them out of lib/sh (its condition reads CFLAGS, see the
# rules_cc_autoconf bug reports).  strnlen.c is in lib/sh already, behind HAVE_STRNLEN;
# vprint.c (a _doprnt system without vprintf) does not arise where the entry builds.
REPLACED_FUNCTIONS = [
    "dprintf",
    "getcwd",
    "memset",
    "reallocarray",
    "rename",
    "strcasecmp",
    "strcasestr",
    "strdup",
    "strerror",
    "strftime",
    "strlcpy",
    "strpbrk",
    "strstr",
    "strtod",
    "strtol",
    "strtoll",
    "strtoul",
    "strtoull",
    "strtoumax",
]

autoconf_srcs(
    name = "lib/sh/replacements",
    srcs = {"lib/sh/{}.c".format(f): "!ac_cv_func_{}".format(f) for f in REPLACED_FUNCTIONS},
    visibility = ["//visibility:private"],
    wrap = "include",
    deps = [":autoconf"],
)

# What the Makefile's SYSTEM_FLAGS pass for $HOSTTYPE, $OSTYPE, $MACHTYPE and $VENDOR.  The
# values are C string literals, so their quotes are escaped against the define tokenizer, as
# the generated PROGRAM define's are; conftypes.h expands CONF_MACHTYPE where it is used,
# after the other three exist, which lets it be their concatenation.
CONF_DEFINES = select({
    "@platforms//cpu:aarch64": ["CONF_HOSTTYPE=\"\\\"aarch64\\\"\""],
    "@platforms//cpu:x86_64": ["CONF_HOSTTYPE=\"\\\"x86_64\\\"\""],
    "//conditions:default": ["CONF_HOSTTYPE=\"\\\"unknown\\\"\""],
}) + select({
    "@platforms//os:macos": [
        "CONF_OSTYPE=\"\\\"darwin\\\"\"",
        "CONF_VENDOR=\"\\\"apple\\\"\"",
        "MACOSX",
    ],
    "//conditions:default": [
        "CONF_OSTYPE=\"\\\"linux-gnu\\\"\"",
        "CONF_VENDOR=\"\\\"pc\\\"\"",
    ],
}) + ["CONF_MACHTYPE=CONF_HOSTTYPE\\\"-\\\"CONF_VENDOR\\\"-\\\"CONF_OSTYPE"]

# jobs.c or nojobs.c comes through the generated autoconf_srcs target: its wrapper source in
# `srcs`, the file it includes through `deps`, as the generated libraries consume theirs.
cc_binary(
    name = "bash",
    srcs = SHELL_SRCS + [
        ":bash_conditional_srcs",
        ":lib/sh/replacements",
        ":syntax_c",
    ],
    copts = NO_WARNINGS,
    linkopts = select({
        # lib/sh/fnxform.c converts file names through iconv, libSystem's own on macOS.
        "@platforms//os:macos": ["-liconv"],
        "//conditions:default": [],
    }),
    # SHELL is configure's LOCAL_DEFS, on every compile of the tree; PACKAGE and LOCALEDIR are
    # the Makefile's LOCALE_DEFS for locale.c's bindtextdomain, at the install prefix configure
    # assumes.
    local_defines = [
        "HAVE_CONFIG_H",
        "SHELL",
        "PROGRAM=\"\\\"bash\\\"\"",
        "PACKAGE=\"\\\"bash\\\"\"",
        "LOCALEDIR=\"\\\"/usr/local/share/locale\\\"\"",
    ] + CONF_DEFINES,
    visibility = ["//visibility:public"],
    # In the Makefile's link order (-lbuiltins -lglob -lsh -lreadline -lhistory -ltilde): the
    # bundled readline's shell.c defines sh_single_quote and friends too, and the archive
    # order is what keeps lib/sh's copies the ones linked.
    deps = [
        # do not sort
        ":bash_conditional_srcs",
        ":lib/sh/replacements",
        ":builtins/builtins",
        ":lib/glob/glob",
        ":lib/sh/sh",
        ":lib/readline/readline",
        ":lib/readline/history",
        ":lib/tilde/tilde",
        ":builtins/builtins_private_headers",
        ":config_headers",
        ":include_includes",
        ":lib/glob/glob_private_headers",
        ":lib/tilde/tilde_private_headers",
        ":lib_includes",
        ":linkopts",
        ":top_srcdir_headers",
    ] + select({
        ":readline_enabled": ["@ncurses"],
        "//conditions:default": [],
    }),
)

# The helpers upstream's test suite expects on PATH (tests/run-all puts the
# build directory there): echo variants that show their arguments exactly, a
# printenv that does not reorder, and the case converter coproc.tests pipes
# through.  Test-only, from support/.
[
    cc_binary(
        name = tool,
        testonly = True,
        srcs = ["support/{}.c".format(tool)],
        copts = NO_WARNINGS,
        visibility = ["//tests:__pkg__"],
    )
    for tool in [
        "printenv",
        "recho",
        "xcase",
        "zecho",
    ]
]
