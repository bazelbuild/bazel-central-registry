]

# One mkbuiltins run writes builtext.h (the declarations), builtins.c (the table) and each
# .def's $PRODUCES file into the working directory, so the rule runs it from the output
# directory with absolute inputs.
genrule(
    name = "builtins_sources",
    srcs = ["builtins/{}.def".format(d) for d in BUILTIN_DEFS],
    outs = [
        "builtins/builtext.h",
        "builtins/builtins.c",
    ] + ["builtins/{}.c".format(d) for d in BUILTIN_DEFS if d != "reserved"],
    cmd = "root=$$PWD && defs=$$(for d in $(SRCS); do echo $$root/$$d; done) && " +
          "mkdir -p $(RULEDIR)/builtins && cd $(RULEDIR)/builtins && " +
          "$$root/$(execpath :mkbuiltins) -externfile builtext.h -includefile builtext.h " +
          "-structfile builtins.c -D $$root/builtins $$defs",
    cmd_bat = "set root=%CD% && mkdir $(RULEDIR)\\builtins & cd /d $(RULEDIR)\\builtins && " +
              "%root%\\$(execpath :mkbuiltins) -externfile builtext.h -includefile builtext.h " +
              "-structfile builtins.c -D %root%\\builtins $(SRCS)",
    tools = [":mkbuiltins"],
)

genrule(
    name = "syntax_c",
    outs = ["syntax.c"],
    cmd = "$(execpath :mksyntax) -o $@",
    cmd_bat = "$(execpath :mksyntax) -o $@",
    tools = [":mksyntax"],
)

# The signal-name table of the build host.  Upstream generates it on the build host as well
# (cross builds take a shipped cache file); the names agree across the platforms the entry
# builds for.
genrule(
    name = "signames_h",
    outs = ["signames.h"],
    cmd = "$(execpath :mksignames) $@",
    cmd_bat = "$(execpath :mksignames) $@",
    tools = [":mksignames"],
)

