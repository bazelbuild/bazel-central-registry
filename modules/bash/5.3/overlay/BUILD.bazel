load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc_autoconf//autoconf:autoconf_srcs.bzl", "autoconf_srcs")
load(":autoconf.bzl", "NO_WARNINGS", "configure")

# The targets of configure.ac and the Makefile.in files, declared by the generated
# autoconf.bzl beside this file; this file is hand-written and kept as it is.  A target
# added below is the module's own; one named like a generated target replaces it at the
# next conversion.
configure()

# tests/heredoc5.sub reads the parser source back through a here-document.
exports_files(["y.tab.c"])

# -- The headers the Makefiles write ------------------------------------------------------
#
# Upstream's top-level Makefile creates pathnames.h (a sed over pathnames.h.in), version.h
# (support/mkversion.sh), signames.h (the mksignames tool) and, when <stdckdint.h> is missing,
# a copy of include/stdckdint.in.h; builtins/Makefile creates pipesize.h by running psize.aux.
# They join config.h and buildconf.h in `config_headers`, which every library already depends
# on, replacing the generated target of that name.

# The debugger's start file at the install prefix configure assumes (${datadir}/bashdb).
expand_template(
    name = "pathnames_h",
    out = "pathnames.h",
    substitutions = {"@DEBUGGER_START_FILE@": "/usr/local/share/bashdb/bashdb-main.inc"},
    template = "pathnames.h.in",
)

# What mkversion.sh writes for a first build of 5.3: the release version and status, the
# compatibility level 53 (`shopt -s compat53`), and the SCCS string `bash --version` prints.
# PATCHLEVEL comes from patchlevel.h.  A tarball bump edits the three version lines.
write_file(
    name = "version_h",
    out = "version.h",
    content = [
        "/* Version control for the shell, as support/mkversion.sh writes it. */",
        "#define DISTVERSION \"5.3\"",
        "#define BUILDVERSION 1",
        "#define RELSTATUS \"release\"",
        "#define DEFAULT_COMPAT_LEVEL 53",
        "#define SCCSVERSION \"@(#)Bash version 5.3.0(1) release GNU\"",
        "",
    ],
    # tests/heredoc5.sub reads it back from ${BUILD_DIR}.
    visibility = ["//tests:__pkg__"],
)

# builtins/psize.sh measures the pipe buffer by writing until a pipe blocks; `ulimit -p` only
# reports the figure.  Linux and macOS both give 64 KiB.
write_file(
    name = "pipesize_h",
    out = "builtins/pipesize.h",
    content = [
        "/* pipesize.h: what builtins/psize.sh measures on Linux and macOS. */",
        "#define PIPESIZE 65536",
        "",
    ],
)

# xmalloc.c, braces.c and lib/sh include <stdckdint.h>; configure copies gnulib's version in
# when the compiler has none (gcc before 14, clang before 16).  Served from the config
# headers' directory it is found first either way, and gnulib's is complete.
copy_file(
    name = "stdckdint_h",
    src = "include/stdckdint.in.h",
    out = "stdckdint.h",
)

cc_library(
    name = "config_headers",
    hdrs = [
        ":buildconf_h",
        ":config",
        ":pathnames_h",
        ":signames_h",
        ":stdckdint_h",
        ":version_h",
    ] + glob(
        ["*.h"],
        allow_empty = True,
    ),
    include_prefix = ".",
    strip_include_prefix = "/",
    visibility = ["//:__subpackages__"],
)

# -- The build-time tools -----------------------------------------------------------------
#
# mkbuiltins, mksyntax and mksignames run on the build host.  The first two select
# <buildconf.h> instead of <config.h> under CROSS_COMPILING, upstream's conservative set of
# POSIX answers; mksignames includes <config.h> unconditionally and gets the same answers under
# that name.  Neither needs the probed config.h, which keeps the probes out of the exec
# configuration.

BUILDCONF = [
    "/* buildconf.h for the build-time tools: upstream's conservative POSIX answers. */",
    "#define BUILDCONF_H_ 1",
    "#define HAVE_LOCALE_H 1",
    "#define HAVE_UNISTD_H 1",
    "#define HAVE_STRING_H 1",
    "#define HAVE_STDLIB_H 1",
    "#define HAVE_RENAME 1",
    "#define PROCESS_SUBSTITUTION 1",
    "#define EXTENDED_GLOB 1",
    "",
]

[
    write_file(
        name = "buildtool_" + header.replace(".", "_"),
        out = "buildtool/" + header,
        content = BUILDCONF,
    )
    for header in [
        "buildconf.h",
        "config.h",
    ]
]

cc_library(
    name = "buildtool_config",
    hdrs = [
        ":buildtool_buildconf_h",
        ":buildtool_config_h",
    ],
    strip_include_prefix = "buildtool",
)

cc_binary(
    name = "mkbuiltins",
    srcs = ["builtins/mkbuiltins.c"],
    copts = NO_WARNINGS,
    local_defines = ["CROSS_COMPILING"],
    deps = [
        ":buildtool_config",
        ":include_includes",
        ":top_srcdir_headers",
    ],
)

cc_binary(
    name = "mksyntax",
    srcs = [
        "mksyntax.c",
        "syntax.h",
    ],
    copts = NO_WARNINGS,
    local_defines = ["CROSS_COMPILING"],
    deps = [
        ":buildtool_config",
        ":include_includes",
    ],
)

cc_binary(
    name = "mksignames",
    srcs = [
        "support/mksignames.c",
        "support/signames.c",
    ],
    copts = NO_WARNINGS,
    local_defines = ["BUILDTOOL"],
    deps = [
        ":buildtool_config",
        ":include_includes",
    ],
)

# The builtins, in the order builtins/Makefile.in lists them (the order of the table in
# builtins.c).  reserved.def documents the reserved words for `help` and produces no C file.
BUILTIN_DEFS = [
    "alias",
    "bind",
    "break",
    "builtin",
    "caller",
    "cd",
    "colon",
    "command",
    "declare",
    "echo",
    "enable",
    "eval",
    "getopts",
    "exec",
    "exit",
    "fc",
    "fg_bg",
    "hash",
    "help",
    "history",
    "jobs",
    "kill",
    "let",
    "read",
    "return",
    "set",
    "setattr",
    "shift",
    "source",
    "suspend",
    "test",
    "times",
    "trap",
    "type",
    "ulimit",
    "umask",
    "wait",
    "reserved",
    "pushd",
    "shopt",
    "printf",
    "complete",
