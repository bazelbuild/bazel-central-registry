# Description:
#   OpenQMC is a quasi-Monte Carlo sampling library for rendering and
#   graphics applications.
#   https://openqmc.org/

load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

package(
    default_package_metadata = [":package_metadata"],
)

exports_files([
    "LICENSE",
])

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:Apache-2.0",
    text = "LICENSE",
    visibility = ["//visibility:public"],
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "openqmc",
    srcs = ["src/bntables.cpp"],
    hdrs = [
        "include/oqmc/arch.h",
        "include/oqmc/bntables.h",
        "include/oqmc/data/lattice/keys.txt",
        "include/oqmc/data/lattice/ranks.txt",
        "include/oqmc/data/pmj/keys.txt",
        "include/oqmc/data/pmj/ranks.txt",
        "include/oqmc/data/sobol/keys.txt",
        "include/oqmc/data/sobol/ranks.txt",
        "include/oqmc/encode.h",
        "include/oqmc/float.h",
        "include/oqmc/gpu.h",
        "include/oqmc/lattice.h",
        "include/oqmc/latticebn.h",
        "include/oqmc/lookup.h",
        "include/oqmc/oqmc.h",
        "include/oqmc/owen.h",
        "include/oqmc/pcg.h",
        "include/oqmc/permute.h",
        "include/oqmc/pmj.h",
        "include/oqmc/pmjbn.h",
        "include/oqmc/range.h",
        "include/oqmc/rank1.h",
        "include/oqmc/reverse.h",
        "include/oqmc/rotate.h",
        "include/oqmc/sampler.h",
        "include/oqmc/sobol.h",
        "include/oqmc/sobolbn.h",
        "include/oqmc/state.h",
        "include/oqmc/stochastic.h",
        "include/oqmc/unused.h",
    ],
    includes = ["include"],
    visibility = ["//visibility:public"],
)

cc_test(
    name = "bntables_test",
    srcs = ["src/tests/bntables.cpp"],
    deps = [
        ":openqmc",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "encode_test",
    srcs = ["src/tests/encode.cpp"],
    deps = [
        ":openqmc",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "float_test",
    srcs = ["src/tests/float.cpp"],
    deps = [
        ":openqmc",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "permute_test",
    srcs = ["src/tests/permute.cpp"],
    deps = [
        ":openqmc",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "reverse_test",
    srcs = ["src/tests/reverse.cpp"],
    deps = [
        ":openqmc",
        "@googletest//:gtest_main",
    ],
)

cc_test(
    name = "sampler_test",
    srcs = ["src/tests/sampler.cpp"],
    deps = [
        ":openqmc",
        "@googletest//:gtest_main",
    ],
)
