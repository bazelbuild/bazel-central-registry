load("@rules_cc//cc:cc_library.bzl", "cc_library")

# numeric/detail/function_n.hpp is a preprocessor fragment expanded by its
# includer, and the statistics headers below use std algorithms without
# including <algorithm>, so none of them are self-contained.
_TEXTUAL_HDRS = [
    "include/boost/accumulators/numeric/detail/function_n.hpp",
    "include/boost/accumulators/statistics/density.hpp",
    "include/boost/accumulators/statistics/extended_p_square.hpp",
    "include/boost/accumulators/statistics/extended_p_square_quantile.hpp",
    "include/boost/accumulators/statistics/p_square_cumul_dist.hpp",
    "include/boost/accumulators/statistics/p_square_quantile.hpp",
    "include/boost/accumulators/statistics/weighted_density.hpp",
    "include/boost/accumulators/statistics/weighted_extended_p_square.hpp",
    "include/boost/accumulators/statistics/weighted_p_square_cumul_dist.hpp",
    "include/boost/accumulators/statistics/weighted_p_square_quantile.hpp",
]

cc_library(
    name = "boost.accumulators",
    hdrs = glob(["include/**/*.hpp"], exclude = _TEXTUAL_HDRS),
    features = ["parse_headers"],
    includes = ["include"],
    textual_hdrs = _TEXTUAL_HDRS,
    visibility = ["//visibility:public"],
    deps = [
        "@boost.array",
        "@boost.assert",
        "@boost.circular_buffer",
        "@boost.concept_check",
        "@boost.config",
        "@boost.core",
        "@boost.fusion",
        "@boost.iterator",
        "@boost.mpl",
        "@boost.numeric_conversion",
        "@boost.numeric_ublas",
        "@boost.parameter",
        "@boost.preprocessor",
        "@boost.range",
        "@boost.serialization",
        "@boost.static_assert",
        "@boost.throw_exception",
        "@boost.tuple",
        "@boost.type_traits",
        "@boost.typeof",
    ],
)
