load(":boost_test_suite.bzl", "boost_test_suite")

# Not referenced by test/Jamfile.v2.
_NOT_BUILT_UPSTREAM = [
    "p_square_quantile_extended.cpp",
    "value.cpp",
]

# Upstream disables this one on libc++.
_LIBCPP_INCOMPATIBLE = ["valarray.cpp"]

boost_test_suite(
    name = "upstream_tests",
    srcs = glob(
        ["*.cpp"],
        exclude = _NOT_BUILT_UPSTREAM + _LIBCPP_INCOMPATIBLE,
    ),
)

boost_test_suite(
    name = "upstream_tests_without_libcpp",
    srcs = _LIBCPP_INCOMPATIBLE,
    target_compatible_with = select({
        "@platforms//os:macos": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
