load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@rules_cc//cc:defs.bzl", "cc_library")

# The module is the hegeldev/hegel monorepo: the C++ frontend lives in
# frontends/cpp and the engine's C ABI header in libhegel/include (see
# //libhegel). The targets keep the labels a frontend-rooted module would
# have: //:hegel and //:throw_site, plus //:hegel-cpp so that the module's
# shorthand label @hegel-cpp names the library.

# Equivalent of the CMake HEGEL_THROW_SITE option. Failure reports name the
# source position of the throw that failed a test case, which requires the
# C++ runtime to be a shared library. Build with --//:throw_site=false for a
# toolchain that links the C++ runtime statically; reports then name the
# exception type without the throw site.
bool_flag(
    name = "throw_site",
    build_setting_default = True,
    # Public so consumers can reference the flag in transitions and
    # config_settings, not only on the command line.
    visibility = ["//visibility:public"],
)

config_setting(
    name = "throw_site_disabled",
    flag_values = {":throw_site": "false"},
    visibility = ["//visibility:public"],
)

# Private headers in frontends/cpp/src, included with angle brackets
# (<engine.h>). A repository-relative include path (rather than a -I copt,
# which is execroot-relative) so the library also builds when this
# repository is consumed as an external module. implementation_deps keeps
# the path out of consumers' include search paths.
cc_library(
    name = "private_hdrs",
    hdrs = glob(["frontends/cpp/src/*.h"]),
    strip_include_prefix = "frontends/cpp/src",
    visibility = ["//visibility:private"],
)

# The Hegel C++ library. Equivalent to the CMake `hegel` target: reflection
# is on (reflect-cpp, C++20) and libhegel resolves the hegel_* symbols.
cc_library(
    name = "hegel",
    srcs = glob(["frontends/cpp/src/*.cpp"]),
    hdrs = glob(["frontends/cpp/include/hegel/**/*.h"]),
    defines = ["HEGEL_HAS_REFLECTION=1"],
    implementation_deps = [":private_hdrs"],
    includes = ["frontends/cpp/include"],
    linkopts = [
        # dlsym/dladdr for throw-site capture (frontends/cpp/src/hegel.cpp).
        "-ldl",
        # spawn()/Worker run test bodies on std::thread.
        "-lpthread",
    ],
    # Private define: no public header reads the macro.
    local_defines = select({
        ":throw_site_disabled": ["HEGEL_HAS_THROW_SITE=0"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "//libhegel",
        "@reflect-cpp//:core",
    ],
)

# The BCR convention: a target named after the module, so @hegel-cpp works
# as a dependency label.
alias(
    name = "hegel-cpp",
    actual = ":hegel",
    visibility = ["//visibility:public"],
)
