# Bazel build for Hegel for C++, shipped as a registry overlay because the
# upstream release includes only a CMake build. The module is the
# hegeldev/hegel monorepo at the frontend's release tag; the build mirrors
# the CMake `hegel` library in frontends/cpp: reflection on (reflect-cpp,
# C++20) and the prebuilt libhegel engine. Keep dependency versions in sync
# with frontends/cpp/CMakeLists.txt and libhegel/Cargo.toml.

module(
    name = "hegel-cpp",
    version = "0.17.1",
    # Registry overlays require Bazel 7.2.1 or newer.
    bazel_compatibility = [">=7.2.1"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.22")

# The reflect-cpp release frontends/cpp/CMakeLists.txt fetches (v0.22.0).
# hegel uses only reflection, so it depends on the module's :core target and
# not on any serialization format.
bazel_dep(name = "reflect-cpp", version = "0.22.0.bcr.1")

# libhegel (Hegel's native engine): a prebuilt shared library downloaded from
# the monorepo's libhegel GitHub release and verified against its published
# SHA-256. The version and hash pins live in libhegel/libhegel.bzl.
libhegel = use_extension("//libhegel:libhegel.bzl", "libhegel")
use_repo(
    libhegel,
    "libhegel-darwin-arm64",
    "libhegel-linux-amd64",
    "libhegel-linux-arm64",
)
