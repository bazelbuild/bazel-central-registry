load("@rav1e_crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_rust//cargo:defs.bzl", "cargo_build_script", "cargo_toml_env_vars")
load("@rules_rust//rust:defs.bzl", "rust_library", "rust_static_library", "rust_test")

package(default_visibility = ["//visibility:public"])

_FEATURES = [
    "capi",
    "threading",
]

cargo_toml_env_vars(
    name = "cargo_metadata_env",
    src = "Cargo.toml",
)

cargo_build_script(
    name = "rav1e_build_script",
    srcs = ["build.rs"],
    aliases = aliases(build = True),
    build_script_env = {"CARGO_ENCODED_RUSTFLAGS": ""},
    build_script_env_files = [":cargo_metadata_env"],
    crate_features = _FEATURES,
    data = [
        "Cargo.lock",
        "Cargo.toml",
    ],
    edition = "2021",
    pkg_name = "rav1e",
    version = "0.8.1",
    deps = all_crate_deps(build = True),
)

rust_library(
    name = "rav1e_rust",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(
        normal = True,
        proc_macro = True,
    ),
    crate_features = _FEATURES,
    crate_name = "rav1e",
    crate_root = "src/lib.rs",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = "0.8.1",
    deps = all_crate_deps(normal = True) + [":rav1e_build_script"],
)

rust_static_library(
    name = "rav1e_static",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(
        normal = True,
        proc_macro = True,
    ),
    crate_features = _FEATURES,
    crate_name = "rav1e",
    crate_root = "src/lib.rs",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro = True),
    version = "0.8.1",
    deps = all_crate_deps(normal = True) + [":rav1e_build_script"],
)

cc_library(
    name = "rav1e",
    hdrs = ["include/rav1e.h"],
    includes = ["include"],
    linkstatic = True,
    deps = [":rav1e_static"],
)

rust_test(
    name = "upstream_api_test",
    args = ["api::test::zero_frames"],
    crate = ":rav1e_rust",
    edition = "2021",
    proc_macro_deps = all_crate_deps(proc_macro_dev = True) + ["@rav1e_crates//:interpolate_name"],
    deps = all_crate_deps(normal_dev = True) + [
        "@rav1e_crates//:rand",
        "@rav1e_crates//:rand_chacha",
    ],
)

cc_test(
    name = "c_api_encode_test",
    srcs = ["tests/c_api_encode_test.c"],
    deps = [":rav1e"],
)
