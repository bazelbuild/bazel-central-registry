load("@bazel_skylib//rules:run_binary.bzl", "run_binary")
load("@rav1e_crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@rules_rs//rs:cargo_build_script.bzl", "cargo_build_script")
load("@rules_rs//rs:rust_library.bzl", "rust_library")
load("@rules_rs//rs:rust_static_library.bzl", "rust_static_library")
load("@rules_rs//rs:rust_test.bzl", "rust_test")

package(default_visibility = ["//visibility:public"])

_FEATURES = [
    "capi",
    "threading",
]

run_binary(
    name = "generate_c_api",
    srcs = [
        "Cargo.toml",
        "cbindgen.toml",
        "@rav1e_crates//:v_frame_lib_rs",
        "@rav1e_crates//:v_frame_sources",
    ] + glob(["src/**/*.rs"]),
    outs = [
        "cargo_metadata.env",
        "include/rav1e.h",
    ],
    args = [
        "$(location Cargo.toml)",
        "$(location cbindgen.toml)",
        "$(location src/lib.rs)",
        "$(location @rav1e_crates//:v_frame_lib_rs)",
        "$(location include/rav1e.h)",
        "$(location cargo_metadata.env)",
    ],
    tool = "//tools/cbindgen:generate",
)

cargo_build_script(
    name = "rav1e_build_script",
    srcs = ["build.rs"],
    aliases = aliases(),
    build_script_env = {"CARGO_ENCODED_RUSTFLAGS": ""},
    build_script_env_files = [":cargo_metadata.env"],
    crate_features = _FEATURES,
    data = [
        "Cargo.lock",
        "Cargo.toml",
    ],
    edition = "2021",
    pkg_name = "rav1e",
    version = "0.8.1",
    deps = all_crate_deps(build = True),
)

rust_library(
    name = "rav1e_rust",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = _FEATURES,
    crate_name = "rav1e",
    crate_root = "src/lib.rs",
    edition = "2021",
    version = "0.8.1",
    deps = all_crate_deps(normal = True) + [":rav1e_build_script"],
)

rust_static_library(
    name = "rav1e_static",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = _FEATURES,
    crate_name = "rav1e",
    crate_root = "src/lib.rs",
    edition = "2021",
    version = "0.8.1",
    deps = all_crate_deps(normal = True) + [":rav1e_build_script"],
)

cc_library(
    name = "rav1e",
    hdrs = ["include/rav1e.h"],
    includes = ["include"],
    linkstatic = True,
    deps = [":rav1e_static"],
)

rust_test(
    name = "upstream_api_test",
    aliases = aliases(),
    args = ["api::test::zero_frames"],
    crate = ":rav1e_rust",
    edition = "2021",
    deps = all_crate_deps(normal_dev = True),
)

cc_test(
    name = "c_api_encode_test",
    srcs = ["tests/c_api_encode_test.c"],
    deps = [":rav1e"],
)

cc_test(
    name = "c_api_header_cpp_test",
    srcs = ["tests/c_api_header_cpp_test.cc"],
    deps = [":rav1e"],
)
