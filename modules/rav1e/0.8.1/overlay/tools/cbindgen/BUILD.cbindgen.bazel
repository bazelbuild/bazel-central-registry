load("@rav1e_cbindgen_crates//:defs.bzl", "aliases", "all_crate_deps")
load("@rules_rs//rs:rust_library.bzl", "rust_library")

exports_files([
    "Cargo.lock",
    "Cargo.toml",
])

rust_library(
    name = "cbindgen",
    srcs = glob(["src/**/*.rs"]),
    aliases = aliases(),
    crate_features = ["clap"],
    crate_root = "src/lib.rs",
    edition = "2018",
    version = "0.29.0",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)
