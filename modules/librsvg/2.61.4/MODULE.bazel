module(
    name = "librsvg",
    version = "2.61.4",
    bazel_compatibility = [">=8.0.0"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "cairo", version = "1.18.4.bcr.2")
bazel_dep(name = "fontconfig", version = "2.16.0")
bazel_dep(name = "freetype", version = "2.14.1.bcr.1")
bazel_dep(name = "gdk-pixbuf", version = "2.44.4.bcr.1")
bazel_dep(name = "glib", version = "2.82.2.bcr.11")
bazel_dep(name = "harfbuzz", version = "14.1.0")
bazel_dep(name = "libxml2", version = "2.15.1.bcr.1")
bazel_dep(name = "pango", version = "1.56.3")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_rs", version = "0.0.109")

rules_rust = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust, "rules_rust")

toolchains = use_extension("@rules_rs//rs/toolchains:module_extension.bzl", "toolchains")
use_repo(toolchains, "default_rust_toolchains")

register_toolchains("@default_rust_toolchains//...")

crate = use_extension("@rules_rs//rs:extensions.bzl", "crate")
crate.from_cargo(
    name = "librsvg_crates",
    cargo_lock = "//:Cargo.lock",
    cargo_toml = "//:Cargo.toml",
    platform_triples = [
        "x86_64-unknown-linux-gnu",
        "aarch64-unknown-linux-gnu",
    ],
)
crate.annotation(
    crate = "cairo-sys-rs",
    gen_build_script = "off",
    repositories = ["librsvg_crates"],
    deps = [
        "@cairo",
        "@cairo//:cairo-gobject",
    ],
)
crate.annotation(
    crate = "gdk-pixbuf-sys",
    gen_build_script = "off",
    repositories = ["librsvg_crates"],
    deps = ["@gdk-pixbuf"],
)
crate.annotation(
    crate = "gio-sys",
    gen_build_script = "off",
    repositories = ["librsvg_crates"],
    deps = ["@glib//gio"],
)
crate.annotation(
    crate = "glib-sys",
    gen_build_script = "off",
    repositories = ["librsvg_crates"],
    deps = ["@glib//glib"],
)
crate.annotation(
    crate = "gobject-sys",
    gen_build_script = "off",
    repositories = ["librsvg_crates"],
    deps = ["@glib//gobject"],
)
crate.annotation(
    crate = "pango-sys",
    gen_build_script = "off",
    repositories = ["librsvg_crates"],
    deps = ["@pango"],
)
crate.annotation(
    crate = "pangocairo-sys",
    gen_build_script = "off",
    repositories = ["librsvg_crates"],
    deps = ["@pango//:pangocairo"],
)
crate.annotation(
    crate = "yeslogic-fontconfig-sys",
    gen_build_script = "off",
    repositories = ["librsvg_crates"],
    deps = ["@fontconfig"],
)
crate.annotation(
    crate = "librsvg-c",
    crate_features = ["pixbuf"],
    repositories = ["librsvg_crates"],
)
use_repo(crate, "librsvg_crates")
