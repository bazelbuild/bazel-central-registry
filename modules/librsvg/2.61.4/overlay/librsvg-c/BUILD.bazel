load("@librsvg_crates//:defs.bzl", "all_crate_deps")
load("@rules_rs//rs:rust_static_library.bzl", "rust_static_library")

rust_static_library(
    name = "librsvg-c",
    srcs = glob(["src/**/*.rs"]),
    compile_data = ["//:rust_version"],
    crate_features = ["pixbuf"],
    crate_name = "librsvg_c",
    crate_root = "src/lib.rs",
    edition = "2021",
    rustc_env = {"RSVG_VERSION": "$(execpath //:rust_version)"},
    target_compatible_with = ["@platforms//os:linux"],
    version = "2.61.4",
    visibility = ["//visibility:public"],
    deps = all_crate_deps(normal = True),
)
