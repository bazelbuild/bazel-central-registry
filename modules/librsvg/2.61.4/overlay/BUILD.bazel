load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_rs//rs:rust_static_library.bzl", "rust_static_library")

exports_files([
    "bazel/librsvg_bazel_deps.patch",
    "bazel/librsvg_bazel_version.patch",
    "meson.build",
    "gdk-pixbuf-loader/io-svg.c",
])

expand_template(
    name = "version",
    out = "include/librsvg/rsvg-version.h",
    substitutions = {
        "@LIBRSVG_MAJOR_VERSION@": "2",
        "@LIBRSVG_MINOR_VERSION@": "61",
        "@LIBRSVG_MICRO_VERSION@": "4",
        "@PACKAGE_VERSION@": "2.61.4",
    },
    template = "include/librsvg/rsvg-version.h.in",
)

expand_template(
    name = "features",
    out = "include/librsvg/rsvg-features.h",
    substitutions = {"@LIBRSVG_HAVE_PIXBUF@": "1"},
    template = "include/librsvg/rsvg-features.h.in",
)

cc_library(
    name = "headers",
    hdrs = glob(["include/librsvg/*.h"]) + [
        ":features",
        ":version",
    ],
    includes = ["include"],
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [
        "@cairo",
        "@gdk-pixbuf//gdk-pixbuf:headers",
        "@glib//gio",
        "@glib//gobject",
    ],
)

# Rust consumers should depend on librsvg-c through Cargo and use :headers and
# :pixbuf_loader separately, so that the Rust renderer is only linked once.
rust_static_library(
    name = "rsvg",
    srcs = ["bazel/lib.rs"],
    crate_name = "rsvg_2",
    edition = "2021",
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = ["@librsvg_crates//:librsvg-c"],
)

cc_library(
    name = "librsvg",
    visibility = ["//visibility:public"],
    deps = [
        ":headers",
        ":rsvg",
    ],
)

# The adapter calls the renderer's C API; it deliberately does not pull the
# renderer into a Rust application's CcInfo a second time.
cc_library(
    name = "pixbuf_loader",
    srcs = ["gdk-pixbuf-loader/io-svg.c"],
    local_defines = ["GDK_PIXBUF_ENABLE_BACKEND"],
    visibility = ["//visibility:public"],
    deps = [
        ":headers",
        "@gdk-pixbuf//gdk-pixbuf:headers",
    ],
)
