load("@rules_cc//cc:cc_library.bzl", "cc_library")

# basic_reduce.hpp relies on declarations from its includer, and the .ipp file
# is the implementation that distributed_property_map.hpp pastes in.
_TEXTUAL_HDRS = [
    "include/boost/property_map/parallel/basic_reduce.hpp",
] + glob(["include/**/*.ipp"])

cc_library(
    name = "boost.property_map_parallel",
    hdrs = glob(
        ["include/**/*.hpp"],
        exclude = _TEXTUAL_HDRS,
    ),
    features = ["parse_headers"],
    includes = ["include"],
    target_compatible_with = ["@platforms//os:linux"],
    textual_hdrs = _TEXTUAL_HDRS,
    visibility = ["//visibility:public"],
    deps = [
        "@boost.assert",
        "@boost.concept_check",
        "@boost.config",
        "@boost.function",
        "@boost.mpi",
        "@boost.mpl",
        "@boost.multi_index",
        "@boost.optional",
        "@boost.property_map",
        "@boost.serialization",
        "@boost.smart_ptr",
        "@boost.type_traits",
    ],
)
