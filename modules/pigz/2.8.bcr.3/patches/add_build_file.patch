--- /dev/null	2023-06-26 14:23:42
+++ BUILD.bazel	2023-06-26 14:23:36
@@ -0,0 +1,35 @@
+load("@rules_cc//cc:defs.bzl", "cc_binary")
+
+# Toolchains may enable -Wall and define NDEBUG, leaving assertion-only
+# variables unused even though pigz no longer enables -Wall or -Wextra.
+_COPTS = [
+    "-O3",
+    "-Wno-unknown-pragmas",
+    "-Wcast-qual",
+    "-Wno-unused-variable",
+    "-Wno-unused-but-set-variable",
+]
+
+cc_binary(
+    name = "pigz",
+    srcs = [
+        "pigz.c",
+        "try.c",
+        "try.h",
+        "yarn.c",
+        "yarn.h",
+    ],
+    copts = _COPTS,
+    linkopts = [
+        "-lm",
+        "-lpthread",
+    ],
+    visibility = ["//visibility:public"],
+    deps = ["@zopfli", "@zlib"],
+)
+
+alias(
+    name = "bin",
+    actual = ":pigz",
+    visibility = ["//visibility:public"],
+)
