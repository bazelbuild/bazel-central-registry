expand_template(
    name = "expat_config_h",
    out = "lib/expat_config.h",
    substitutions = select({
        "@platforms//os:linux": POSIX_COMMON_SUBS | {
            "#cmakedefine HAVE_GETRANDOM": "#define HAVE_GETRANDOM 1",
            "#cmakedefine HAVE_SYSCALL_GETRANDOM": "#define HAVE_SYSCALL_GETRANDOM 1",
            "#cmakedefine HAVE_GETENTROPY": "#define HAVE_GETENTROPY 1",
        },
        "@platforms//os:macos": POSIX_COMMON_SUBS | {
            "#cmakedefine HAVE_GETRANDOM": "",  # not available on macos
            "#cmakedefine HAVE_SYSCALL_GETRANDOM": "",  # not available on macos
            "#cmakedefine HAVE_GETENTROPY": "#define HAVE_GETENTROPY 1",
            "#cmakedefine HAVE_ARC4RANDOM_BUF": "#define HAVE_ARC4RANDOM_BUF 1",
        },
        "@platforms//os:windows": WINDOWS_SUBS,
    }),
    template = "expat_config.h.cmake",
)

cc_library(
    name = "expat",
    srcs = [
        "lib/xmlparse.c",
        "lib/xmlrole.c",
        "lib/xmltok.c",
    ] + select({
        "@platforms//os:windows": ["lib/random_rand_s.c"],
        "@platforms//os:macos": [
            "lib/random_getentropy.c",
            "lib/random_arc4random_buf.c",
        ],
        "//conditions:default": [
            "lib/random_getrandom.c",
            "lib/random_getentropy.c",
            "lib/random_dev_urandom.c",
        ],
    }),
    hdrs = [
        ":expat_config_h",
        "expat_config.h",
    ] + glob([
        # Some expat c files include other c files.
        "lib/*.c",
        "lib/*.h",
    ]),
    defines = select({
        "@platforms//os:windows": ["XML_STATIC"],
        "//conditions:default": [],
    }),
    includes = ["lib"],
)

alias(
    name = "libexpat",
    actual = ":expat",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "expat_test_lib",
    testonly = True,
    srcs = [
        "tests/chardata.c",
        "tests/chardata.h",
        "tests/common.c",
        "tests/common.h",
        "tests/dummy.c",
        "tests/dummy.h",
        "tests/handlers.c",
        "tests/handlers.h",
        "tests/memcheck.c",
        "tests/memcheck.h",
        "tests/minicheck.c",
        "tests/minicheck.h",
        "tests/structdata.c",
        "tests/structdata.h",
    ],
    deps = [
        ":expat",
    ],
)

# Must be run with --copt=-DXML_TESTING because files in the expat target look
# for this macro.
cc_test(
    name = "expat_tests",
    srcs = ["tests/runtests.c"] + glob([
        "tests/*_tests.c",
        "tests/*_tests.h",
    ]),
    args = ["--verbose"],
    deps = [":expat_test_lib"],
)
