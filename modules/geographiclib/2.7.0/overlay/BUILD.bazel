load(
    "@cmake_configure_file//:cmake_configure_file.bzl",
    "cmake_configure_file",
)
load("@rules_cc//cc:cc_library.bzl", "cc_library")

cmake_configure_file(
    name = "config_header",
    src = "include/GeographicLib/Config.h.in",
    out = "include/GeographicLib/Config.h",
    cmakelists = [
        "CMakeLists.txt",
    ],
    defines = select({
        "@platforms//os:windows": ["GEOGRAPHICLIB_DATA=C:/ProgramData/GeographicLib"],
        "//conditions:default": ["GEOGRAPHICLIB_DATA=/usr/local/share/GeographicLib"],
    }) + [
        "GEOGRAPHICLIB_LIB_TYPE_VAL=0",
    ],
    undefines = ["GEOGRAPHICLIB_HAVE_LONG_DOUBLE"],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "geographiclib",
    srcs = glob([
        "src/*.cpp",
        "src/*.hh",
    ]),
    hdrs = glob([
        "include/GeographicLib/**/*.hpp",
    ]) + [
        ":config_header",
    ],
    # GeographicLib 2.7 requires C++17, including its new triaxial sources.
    copts = select({
        "@platforms//os:windows": ["/std:c++17"],
        "//conditions:default": ["-std=c++17"],
    }),
    includes = [
        "include",
    ],
    visibility = ["//visibility:public"],
)
