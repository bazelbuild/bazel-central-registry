"""web_project: one macro that generates the build graph of a frontend app.

A separate module (not part of gavel_tools_typescript) because it needs esbuild
and bazel-lib, which a consumer that only lints TypeScript must not pull. It does
not depend on gavel_tools: the per-tool binaries come from the consumer's lockfile.
"""

module(
    name = "gavel_tools_web",
    version = "0.4.0",
    compatibility_level = 1,
)

bazel_dep(name = "aspect_bazel_lib", version = "2.22.5")
bazel_dep(name = "aspect_rules_esbuild", version = "0.25.1")
bazel_dep(name = "aspect_rules_js", version = "3.0.3")
