load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Upstream's libshaderc tests (libshaderc/CMakeLists.txt).
cc_test(
    name = "shaderc_c_smoke_test",
    srcs = ["@shaderc//:libshaderc/src/shaderc_c_smoke_test.c"],
    deps = ["@shaderc"],
)

cc_test(
    name = "shaderc_test",
    srcs = [
        "@shaderc//:libshaderc/src/common_shaders_for_test.h",
        "@shaderc//:libshaderc/src/shaderc_test.cc",
    ],
    deps = [
        "@googletest//:gtest_main",
        "@shaderc",
        "@spirv_headers//:spirv_cpp_headers",
    ],
)

cc_test(
    name = "shaderc_cpp_test",
    srcs = [
        "@shaderc//:libshaderc/src/common_shaders_for_test.h",
        "@shaderc//:libshaderc/src/shaderc_cpp_test.cc",
    ],
    deps = [
        "@googletest//:gtest_main",
        "@shaderc",
        "@spirv_headers//:spirv_cpp_headers",
        "@spirv_tools",
    ],
)

# glslc compiles a vertex shader, spirv-val validates the result.
genrule(
    name = "triangle_spv",
    srcs = ["triangle.vert"],
    outs = ["triangle.spv"],
    cmd = "$(execpath @shaderc//:glslc) -o $@ $< && $(execpath @spirv_tools//:spirv-val) --target-env vulkan1.0 $@",
    tools = [
        "@shaderc//:glslc",
        "@spirv_tools//:spirv-val",
    ],
)
