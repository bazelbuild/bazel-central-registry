load("@rules_cc//cc:cc_library.bzl", "cc_library")

# The detail headers rely on declarations their includer provides first, so
# they are not self-contained.
_TEXTUAL_HDRS = glob(["include/boost/decimal/detail/**/*.hpp"])

cc_library(
    name = "boost.decimal",
    hdrs = glob(
        ["include/**/*.hpp"],
        exclude = _TEXTUAL_HDRS,
    ),
    features = ["parse_headers"],
    includes = ["include"],
    textual_hdrs = _TEXTUAL_HDRS,
    visibility = ["//visibility:public"],
)
