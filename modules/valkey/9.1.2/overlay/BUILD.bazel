load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

cc_library(
    name = "fast_float",
    hdrs = ["deps/fast_float/ffc.h"],
    includes = ["deps/fast_float"],
)

cc_library(
    name = "fpconv",
    srcs = ["deps/fpconv/fpconv_dtoa.c"],
    hdrs = [
        "deps/fpconv/fpconv_dtoa.h",
        "deps/fpconv/fpconv_powers.h",
    ],
    conlyopts = ["-std=gnu11"],
    includes = ["deps/fpconv"],
)

cc_library(
    name = "hdr_histogram",
    srcs = ["deps/hdr_histogram/hdr_histogram.c"],
    hdrs = glob(["deps/hdr_histogram/*.h"]),
    conlyopts = ["-std=gnu11"],
    includes = ["deps/hdr_histogram"],
    local_defines = ['HDR_MALLOC_INCLUDE=\\"hdr_redis_malloc.h\\"'],
)

cc_library(
    name = "lua",
    srcs = glob(
        ["deps/lua/src/*.c"],
        exclude = ["deps/lua/src/luac.c"],
    ),
    hdrs = ["src/solarisfixes.h"] + glob(["deps/lua/src/*.h"]),
    conlyopts = ["-std=gnu11"],
    includes = ["deps/lua/src"],
    local_defines = [
        "ENABLE_CJSON_GLOBAL",
        "LUA_USE_MKSTEMP",
    ],
)

# Match the upstream static Lua module build and retain its registration.
cc_library(
    name = "lua_engine",
    srcs = [
        "src/modules/lua/debug_lua.c",
        "src/modules/lua/engine_lua.c",
        "src/modules/lua/function_lua.c",
        "src/modules/lua/list.c",
        "src/modules/lua/script_lua.c",
    ],
    hdrs = [
        "src/fmacros.h",
        "src/monotonic.h",
        "src/rand.h",
        "src/sha1.h",
        "src/valkeymodule.h",
    ] + glob(["src/modules/lua/*.h"]),
    conlyopts = ["-std=c99"],
    local_defines = [
        "_GNU_SOURCE",
        "STATIC_LUA=1",
    ],
    deps = [
        ":fpconv",
        ":lua",
    ],
    alwayslink = True,
)

# Match the bundled libvalkey CMake build: use the server's sds and dict.
cc_library(
    name = "libvalkey",
    srcs = [
        "deps/libvalkey/src/adlist.c",
        "deps/libvalkey/src/alloc.c",
        "deps/libvalkey/src/async.c",
        "deps/libvalkey/src/cluster.c",
        "deps/libvalkey/src/command.c",
        "deps/libvalkey/src/conn.c",
        "deps/libvalkey/src/crc16.c",
        "deps/libvalkey/src/net.c",
        "deps/libvalkey/src/read.c",
        "deps/libvalkey/src/sockcompat.c",
        "deps/libvalkey/src/valkey.c",
        "deps/libvalkey/src/vkutil.c",
    ],
    hdrs = [
        "src/dict.h",
        "src/mt19937-64.h",
        "src/sds.h",
    ] + glob([
        "deps/libvalkey/include/valkey/*.h",
        "deps/libvalkey/src/*.h",
    ]),
    conlyopts = ["-std=c99"],
    includes = [
        "deps/libvalkey/include",
        "deps/libvalkey/include/valkey",
        "src",
    ],
)

# Upstream's release script reads Git, the clock, and the host name. Pin this
# build identity so identical source and toolchains agree.
write_file(
    name = "release_header",
    out = "release.h",
    content = [
        '#define REDIS_GIT_SHA1 "00000000"',
        '#define REDIS_GIT_DIRTY "0"',
        '#define REDIS_BUILD_ID "0"',
        '#include "version.h"',
        "#define REDIS_BUILD_ID_RAW SERVER_NAME VALKEY_VERSION REDIS_BUILD_ID REDIS_GIT_DIRTY REDIS_GIT_SHA1",
    ],
)

