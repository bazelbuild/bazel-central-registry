""" Bazel module definition for rules_freecad """

module(
    name = "rules_freecad",
    version = "0.3.0",
)

bazel_dep(
    name = "rules_python",
    version = "2.3.3",
)
bazel_dep(
    name = "platforms",
    version = "1.1.0",
)

rules_python_config = use_extension(
    "@rules_python//python/extensions:config.bzl",
    "config",
)
# Disable implicit __init__.py creation
rules_python_config.explicit_init_py(default = True)
python = use_extension(
    "@rules_python//python/extensions:python.bzl",
    "python",
)
python.toolchain(
    is_default = False,
    python_version = "3.11",
)
use_repo(python, "python_3_11", "python_versions", "pythons_hub")

pip = use_extension(
    "@rules_python//python/extensions:pip.bzl",
    "pip",
)
pip.parse(
    hub_name = "rules_freecad_pypi",
    python_version = "3.11",
    requirements_lock = "//:requirements.txt",  # Or requirements.txt if you want Bazel to generate the lock file
)
use_repo(pip, "rules_freecad_pypi")

http_file = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_file",
)

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

http_file(
    name = "freecad_linux_x86_64",
    downloaded_file_path = "freecad.AppImage",
    executable = True,
    sha256 = "3a853eb69ee595f779f2255dbf80a765926981d8ff68903cefee4dfb03a8f5ef",
    url = "https://github.com/FreeCAD/FreeCAD/releases/download/1.1.3/FreeCAD_1.1.3-Linux-x86_64-py311.AppImage",
)

http_file(
    name = "freecad_macos_arm64",
    downloaded_file_path = "freecad.dmg",
    sha256 = "f5c0ece7cd7c932466d6effadc0fc6e179b0538a9d9a6a77a6769eae3af2667c",
    url = "https://github.com/FreeCAD/FreeCAD/releases/download/1.1.3/FreeCAD_1.1.3-macOS-arm64-py311.dmg",
)

http_archive(
    name = "7zip_linux_x86_64",
    build_file = "//third_party:BUILD.7zz.bazel",
    sha256 = "dc99eff5008f1ab79bd7084c68513701547a808a89502bf4133683535ab3c695",
    url = "https://github.com/ip7z/7zip/releases/download/26.03/7z2603-linux-x64.tar.xz",
)

http_archive(
    name = "7zip_macos",
    build_file = "//third_party:BUILD.7zz.bazel",
    sha256 = "5ca87677072c59f5602e5c49baa27d4694bacd2259b4e507f0094249d4281480",
    url = "https://github.com/ip7z/7zip/releases/download/26.03/7z2603-mac.tar.xz",
)

custom_python_extension = use_extension(
    "//tools:extensions.bzl",
    "custom_python_extension",
)
use_repo(custom_python_extension, "python_interpreter_linux_x86_64", "python_interpreter_macos_arm64")

register_toolchains(
    "@python_interpreter_linux_x86_64//:freecad_toolchain",
    "@python_interpreter_macos_arm64//:freecad_toolchain",
)

