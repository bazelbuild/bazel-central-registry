load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "schema_tests",
    srcs = ["validate.go"],
    importpath = "github.com/openconfig/ygot/ytypes/schema_tests",
    visibility = ["//visibility:public"],
)

alias(
    name = "go_default_library",
    actual = ":schema_tests",
    visibility = ["//visibility:public"],
)

go_test(
    name = "schema_tests_test",
    srcs = [
        "diff_benchmark_test.go",
        "get_test.go",
        "leafref_benchmark_test.go",
        "posix_regex_benchmark_test.go",
        "race_test.go",
        "set_test.go",
        "validate_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":schema_tests"],
    deps = [
        "//exampleoc",
        "//exampleoc/opstateoc",
        "//exampleoc/wrapperunionoc",
        "//testutil",
        "//uexampleoc",
        "//util",
        "//ygot",
        "//ytypes",
        "@com_github_google_go_cmp//cmp",
        "@com_github_google_go_cmp//cmp/cmpopts",
        "@com_github_openconfig_gnmi//errdiff",
        "@com_github_openconfig_gnmi//proto/gnmi",
        "@com_github_openconfig_goyang//pkg/yang",
        "@org_golang_google_protobuf//proto",
    ],
)
