load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "gogen",
    srcs = [
        "codegen.go",
        "goelements.go",
        "goenums.go",
        "gogen.go",
        "helpers.go",
        "ordered_list.go",
        "unordered_list.go",
    ],
    importpath = "github.com/openconfig/ygot/gogen",
    visibility = ["//visibility:public"],
    deps = [
        "//genutil",
        "//internal/igenutil",
        "//util",
        "//ygen",
        "//ygot",
        "//ytypes",
        "@com_github_openconfig_gnmi//errlist",
        "@com_github_openconfig_gnmi//proto/gnmi",
        "@com_github_openconfig_goyang//pkg/yang",
    ],
)

alias(
    name = "go_default_library",
    actual = ":gogen",
    visibility = ["//visibility:public"],
)

go_test(
    name = "gogen_test",
    srcs = [
        "codegen_test.go",
        "genir_test.go",
        "goelements_test.go",
        "goenums_test.go",
        "gogen_test.go",
        "helpers_test.go",
        "unordered_list_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":gogen"],
    deps = [
        "//genutil",
        "//internal/igenutil",
        "//testutil",
        "//ygen",
        "//ygot",
        "@com_github_google_go_cmp//cmp",
        "@com_github_google_go_cmp//cmp/cmpopts",
        "@com_github_kylelemons_godebug//pretty",
        "@com_github_openconfig_gnmi//errdiff",
        "@com_github_openconfig_gnmi//proto/gnmi",
        "@com_github_openconfig_goyang//pkg/yang",
        "@org_golang_google_protobuf//testing/protocmp",
    ],
)
