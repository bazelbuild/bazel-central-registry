load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "yangschema",
    srcs = ["yangschema.go"],
    importpath = "github.com/openconfig/ygot/yangschema",
    visibility = ["//visibility:public"],
    deps = [
        "//util",
        "@com_github_openconfig_gnmi//ctree",
        "@com_github_openconfig_goyang//pkg/yang",
    ],
)

alias(
    name = "go_default_library",
    actual = ":yangschema",
    visibility = ["//visibility:public"],
)

go_test(
    name = "yangschema_test",
    srcs = ["yangschema_test.go"],
    embed = [":yangschema"],
    deps = [
        "@com_github_google_go_cmp//cmp",
        "@com_github_kylelemons_godebug//pretty",
        "@com_github_openconfig_goyang//pkg/yang",
    ],
)
