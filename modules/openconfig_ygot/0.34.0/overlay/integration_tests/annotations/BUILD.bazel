load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "annotations",
    srcs = ["annotations.go"],
    importpath = "github.com/openconfig/ygot/integration_tests/annotations",
    visibility = ["//visibility:public"],
)

alias(
    name = "go_default_library",
    actual = ":annotations",
