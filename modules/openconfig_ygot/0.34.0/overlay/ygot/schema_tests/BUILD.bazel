load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "schema_tests",
    srcs = ["schema.go"],
    importpath = "github.com/openconfig/ygot/ygot/schema_tests",
    visibility = ["//visibility:public"],
)

alias(
    name = "go_default_library",
    actual = ":schema_tests",
    visibility = ["//visibility:public"],
)

go_test(
    name = "schema_tests_test",
    srcs = [
        "merge_test.go",
        "schema_benchmark_test.go",
        "schema_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":schema_tests"],
    deps = [
        "//exampleoc",
        "//exampleoc/opstateoc",
        "//exampleoc/wrapperunionoc",
        "//integration_tests/schemaops/ctestschema",
        "//integration_tests/schemaops/utestschema",
        "//internal/ytestutil",
        "//testutil",
        "//uexampleoc",
        "//ygot",
        "@com_github_google_go_cmp//cmp",
        "@com_github_kylelemons_godebug//pretty",
        "@com_github_openconfig_gnmi//errdiff",
        "@com_github_openconfig_gnmi//proto/gnmi",
        "@com_github_openconfig_gnmi//value",
        "@org_golang_google_protobuf//encoding/prototext",
    ],
)
