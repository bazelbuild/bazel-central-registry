load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ygot",
    srcs = [
        "diff.go",
        "gostruct.go",
        "helpers.go",
        "path_types.go",
        "pathstrings.go",
        "render.go",
        "schema.go",
        "struct_validation_map.go",
        "types.go",
    ],
    importpath = "github.com/openconfig/ygot/ygot",
    visibility = ["//visibility:public"],
    deps = [
        "//internal/yreflect",
        "//util",
        "@com_github_kylelemons_godebug//pretty",
        "@com_github_openconfig_gnmi//errlist",
        "@com_github_openconfig_gnmi//proto/gnmi",
        "@com_github_openconfig_gnmi//value",
        "@com_github_openconfig_goyang//pkg/yang",
        "@org_golang_google_protobuf//encoding/prototext",
        "@org_golang_google_protobuf//proto",
        "@org_golang_x_exp//slices",
    ],
)

alias(
    name = "go_default_library",
    actual = ":ygot",
    visibility = ["//visibility:public"],
)

go_test(
    name = "ygot_test",
    srcs = [
        "diff_exported_test.go",
        "diff_test.go",
        "gostruct_exported_test.go",
        "gostruct_test.go",
        "helpers_test.go",
        "path_types_test.go",
        "pathstrings_test.go",
        "render_exported_test.go",
        "render_test.go",
        "schema_test.go",
        "struct_validation_map_exported_test.go",
        "struct_validation_map_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":ygot"],
    deps = [
        "//integration_tests/schemaops/ctestschema",
        "//integration_tests/schemaops/utestschema",
        "//internal/ytestutil",
        "//testutil",
        "//util",
        "//ytypes",
        "@com_github_google_go_cmp//cmp",
        "@com_github_google_go_cmp//cmp/cmpopts",
        "@com_github_kylelemons_godebug//pretty",
        "@com_github_openconfig_gnmi//errdiff",
        "@com_github_openconfig_gnmi//proto/gnmi",
        "@com_github_openconfig_goyang//pkg/yang",
        "@org_golang_google_protobuf//encoding/prototext",
        "@org_golang_google_protobuf//proto",
        "@org_golang_google_protobuf//testing/protocmp",
    ],
)
