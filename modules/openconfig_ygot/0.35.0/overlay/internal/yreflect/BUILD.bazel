load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "yreflect",
    srcs = ["reflect_orderedmap.go"],
    importpath = "github.com/openconfig/ygot/internal/yreflect",
    visibility = ["//:__subpackages__"],
)

alias(
    name = "go_default_library",
    actual = ":yreflect",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "yreflect_test",
    srcs = ["reflect_orderedmap_test.go"],
    deps = [
        ":yreflect",
        "//integration_tests/schemaops/ctestschema",
        "//ygot",
        "@com_github_google_go_cmp//cmp",
        "@com_github_openconfig_gnmi//errdiff",
    ],
)
