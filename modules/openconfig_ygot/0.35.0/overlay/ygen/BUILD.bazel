load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "ygen",
    srcs = [
        "codegen.go",
        "directory.go",
        "enumgen.go",
        "genir.go",
        "genstate.go",
        "helpers.go",
        "ir.go",
        "schemaparse.go",
    ],
    importpath = "github.com/openconfig/ygot/ygen",
    visibility = ["//visibility:public"],
    deps = [
        "//genutil",
        "//internal/igenutil",
        "//util",
        "//yangschema",
        "//ygot",
        "@com_github_golang_glog//:glog",
        "@com_github_openconfig_gnmi//proto/gnmi",
        "@com_github_openconfig_goyang//pkg/yang",
    ],
)

alias(
    name = "go_default_library",
    actual = ":ygen",
    visibility = ["//visibility:public"],
)

go_test(
    name = "ygen_test",
    srcs = [
        "codegen_test.go",
        "directory_test.go",
        "enumgen_test.go",
        "genstate_test.go",
        "helpers_test.go",
        "schemaparse_test.go",
    ],
    embed = [":ygen"],
    deps = [
        "//genutil",
        "//internal/igenutil",
        "//testutil",
        "//yangschema",
        "//ygot",
        "@com_github_google_go_cmp//cmp",
        "@com_github_google_go_cmp//cmp/cmpopts",
        "@com_github_kylelemons_godebug//pretty",
        "@com_github_openconfig_gnmi//errdiff",
        "@com_github_openconfig_goyang//pkg/yang",
    ],
)
