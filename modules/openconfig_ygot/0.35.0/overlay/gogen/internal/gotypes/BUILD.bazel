load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "gotypes",
    srcs = ["ordered_map.go"],
    importpath = "github.com/openconfig/ygot/gogen/internal/gotypes",
    visibility = ["//gogen:__subpackages__"],
)

alias(
    name = "go_default_library",
    actual = ":gotypes",
    visibility = ["//gogen:__subpackages__"],
)

go_test(
    name = "gotypes_test",
    srcs = ["ordered_map_test.go"],
    embed = [":gotypes"],
    deps = [
        "//ygot",
        "@com_github_google_go_cmp//cmp",
    ],
)
