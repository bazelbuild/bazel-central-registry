load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "proto_generator_lib",
    srcs = ["protogenerator.go"],
    importpath = "github.com/openconfig/ygot/proto_generator",
    visibility = ["//visibility:private"],
    deps = [
        "//genutil",
        "//protogen",
        "//ygen",
        "@com_github_golang_glog//:glog",
        "@com_github_openconfig_goyang//pkg/yang",
    ],
)

go_binary(
    name = "proto_generator",
    embed = [":proto_generator_lib"],
    visibility = ["//visibility:public"],
)
