load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "protogen",
    srcs = [
        "codegen.go",
        "helpers.go",
        "protoelements.go",
        "protogen.go",
    ],
    importpath = "github.com/openconfig/ygot/protogen",
    visibility = ["//visibility:public"],
    deps = [
        "//genutil",
        "//internal/igenutil",
        "//util",
        "//ygen",
        "@com_github_openconfig_goyang//pkg/yang",
    ],
)

alias(
    name = "go_default_library",
    actual = ":protogen",
    visibility = ["//visibility:public"],
)

go_test(
    name = "protogen_test",
    srcs = [
        "codegen_test.go",
        "genir_test.go",
        "protoelements_test.go",
        "protogen_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":protogen"],
    deps = [
        "//genutil",
        "//internal/igenutil",
        "//testutil",
        "//ygen",
        "//ygot",
        "@com_github_google_go_cmp//cmp",
        "@com_github_google_go_cmp//cmp/cmpopts",
        "@com_github_openconfig_gnmi//errdiff",
        "@com_github_openconfig_gnmi//proto/gnmi",
        "@com_github_openconfig_goyang//pkg/yang",
        "@org_golang_google_protobuf//testing/protocmp",
    ],
)
