load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "gnmiparse",
    srcs = [
        "notifs.go",
        "setrequest.go",
    ],
    importpath = "github.com/openconfig/ygot/gnmidiff/gnmiparse",
    visibility = ["//visibility:public"],
    deps = [
        "@com_github_openconfig_gnmi//proto/gnmi",
        "@org_golang_google_protobuf//encoding/prototext",
    ],
)

alias(
    name = "go_default_library",
    actual = ":gnmiparse",
    visibility = ["//visibility:public"],
)

go_test(
    name = "gnmiparse_test",
    srcs = [
        "notifs_test.go",
        "setrequest_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":gnmiparse"],
    deps = ["@com_github_google_go_cmp//cmp"],
)
