load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "gnmidiff",
    srcs = [
        "diff.go",
        "intent.go",
        "json.go",
        "prefix.go",
        "set_to_get.go",
        "setrequest.go",
    ],
    importpath = "github.com/openconfig/ygot/gnmidiff",
    visibility = ["//visibility:public"],
    deps = [
        "//util",
        "//ygot",
        "//ytypes",
        "@com_github_openconfig_gnmi//proto/gnmi",
    ],
)

alias(
    name = "go_default_library",
    actual = ":gnmidiff",
    visibility = ["//visibility:public"],
)

go_test(
    name = "gnmidiff_test",
    srcs = [
        "intent_test.go",
        "json_test.go",
        "prefix_bench_test.go",
        "prefix_test.go",
        "set_to_get_test.go",
        "setrequest_test.go",
    ],
    embed = [":gnmidiff"],
    deps = [
        "//exampleoc",
        "//ygot",
        "//ytypes",
        "@com_github_google_go_cmp//cmp",
        "@com_github_google_go_cmp//cmp/cmpopts",
        "@com_github_openconfig_gnmi//proto/gnmi",
    ],
)
