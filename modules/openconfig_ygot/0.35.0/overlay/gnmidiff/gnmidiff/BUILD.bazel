load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library")

go_library(
    name = "gnmidiff_lib",
    srcs = ["main.go"],
    importpath = "github.com/openconfig/ygot/gnmidiff/gnmidiff",
    visibility = ["//visibility:private"],
    deps = ["//gnmidiff/cmd"],
