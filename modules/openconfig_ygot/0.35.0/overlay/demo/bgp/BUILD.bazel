load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "bgp_lib",
    srcs = ["main.go"],
    importpath = "github.com/openconfig/ygot/demo/bgp",
    visibility = ["//visibility:private"],
    deps = [
        "//exampleoc",
        "//ygot",
        "@com_github_golang_glog//:glog",
    ],
)

go_binary(
    name = "bgp",
    embed = [":bgp_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "bgp_test",
    srcs = ["main_test.go"],
    data = glob(["testdata/**"]),
    embed = [":bgp_lib"],
    deps = [
        "//testutil",
        "@com_github_kylelemons_godebug//pretty",
    ],
)
