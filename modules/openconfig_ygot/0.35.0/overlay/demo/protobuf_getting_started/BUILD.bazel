load("@io_bazel_rules_go//go:def.bzl", "go_binary", "go_library", "go_test")

go_library(
    name = "protobuf_getting_started_lib",
    srcs = ["demo.go"],
    importpath = "github.com/openconfig/ygot/demo/protobuf_getting_started",
    visibility = ["//visibility:private"],
    deps = [
        "//demo/protobuf_getting_started/ribproto/openconfig",
        "//demo/protobuf_getting_started/ribproto/openconfig/enums",
        "//demo/protobuf_getting_started/ribproto/openconfig/openconfig_rib_bgp",
        "//proto/ywrapper",
        "@com_github_golang_glog//:glog",
        "@com_github_golang_protobuf//proto",
    ],
)

go_binary(
    name = "protobuf_getting_started",
    embed = [":protobuf_getting_started_lib"],
    visibility = ["//visibility:public"],
)

go_test(
    name = "protobuf_getting_started_test",
    srcs = ["demo_test.go"],
    data = glob(["testdata/**"]),
    embed = [":protobuf_getting_started_lib"],
    deps = [
        "//demo/protobuf_getting_started/ribproto/openconfig",
        "//demo/protobuf_getting_started/ribproto/openconfig/enums",
        "@com_github_google_go_cmp//cmp",
        "@org_golang_google_protobuf//encoding/prototext",
        "@org_golang_google_protobuf//testing/protocmp",
    ],
)
