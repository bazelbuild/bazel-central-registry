common --enable_bzlmod
build --compilation_mode=opt
build --noremote_upload_local_results
build --remote_cache_compression
build --build_metadata=REPO_URL=https://github.com/formatjs/hermes.git
test --test_output=errors

build:bb-workflow --build_metadata=ROLE=BB_WORKFLOW
build:bb-workflow --build_metadata=VISIBILITY=PUBLIC
build:bb-workflow --config=rbe
build:bb-workflow --remote_download_minimal

build:rbe --config=rbe-platform
build:rbe --config=rbe-transport

# Both workspace roots select their own dev-only LLVM toolchain.
build:linux --platforms=@llvm//platforms:linux_x86_64_gnu.2.28
build:linux --host_platform=@llvm//platforms:linux_x86_64_gnu.2.28
build:linux --extra_execution_platforms=@llvm//platforms:linux_x86_64_gnu.2.28
build:linux --repo_env=BAZEL_DO_NOT_DETECT_CPP_TOOLCHAIN=1
build:linux --incompatible_strict_action_env

build:rbe-platform --config=linux
build:rbe-platform --remote_default_exec_properties=OSFamily=Linux
build:rbe-platform --remote_default_exec_properties=Arch=amd64
build:rbe-platform --remote_default_exec_properties=container-image=docker://gcr.io/flame-public/rbe-ubuntu22-04:latest
build:rbe-platform --remote_default_exec_properties=network=off

# BuildBuddy Workflows injects authentication through its runner bazelrc.
build:rbe-transport --bes_backend=grpcs://formatjs.buildbuddy.io
build:rbe-transport --bes_results_url=https://formatjs.buildbuddy.io/invocation/
build:rbe-transport --remote_cache=grpcs://formatjs.buildbuddy.io
build:rbe-transport --remote_executor=grpcs://formatjs.buildbuddy.io
build:rbe-transport --jobs=50
build:rbe-transport --remote_timeout=10m

try-import %workspace%/.bazelrc.user
