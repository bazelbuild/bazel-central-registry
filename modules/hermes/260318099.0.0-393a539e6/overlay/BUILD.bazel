"""Native rules for the pinned Hermes source tree.

Source lists and library boundaries follow upstream target declarations.
No upstream build system runs during Bazel analysis or execution.
"""

load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_python//python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:private"])

filegroup(
    name = "version_metadata",
    srcs = ["npm/hermes-compiler/package.json"],
    visibility = ["@hermes//tests/version:__pkg__"],
)

# CMakeLists.txt: desktop Hades, Unicode Lite, and no JIT/debugger/Intl.
HERMES_DEFINES = [
    "HERMESVM_ALLOW_CONCURRENT_GC",
    "HERMESVM_ALLOW_INLINE_ASM",
    "HERMESVM_ALLOW_JIT=0",
    "HERMESVM_GC_HADES",
    "HERMESVM_INDIRECT_THREADING",
    "HERMESVM_LOG_HEAP_SEGMENT_SIZE=22",
    "HERMES_CHECK_NATIVE_STACK",
    "HERMES_ENABLE_CORE_EXTENSIONS=0",
    "HERMES_ENABLE_CONTRIB_EXTENSIONS=0",
    "HERMES_ENABLE_UNICODE_REGEXP_PROPERTY_ESCAPES",
    "HERMES_LLVM",
    "HERMES_PLATFORM_UNICODE=HERMES_PLATFORM_UNICODE_LITE",
    "HERMES_USE_BOOST_CONTEXT=0",
    'HERMES_RELEASE_VERSION=\\"1.0.0\\"',
    "_GNU_SOURCE",
]

# Upstream permits signed overflow and aliases VM storage across C/C++ types.
HERMES_C_OPTIONS = [
    "-fno-strict-aliasing",
    "-fno-strict-overflow",
]

HERMES_CXX_OPTIONS = HERMES_C_OPTIONS + ["-std=c++17"]

HERMES_INTERNAL_OPTIONS = HERMES_CXX_OPTIONS + [
    "-fno-exceptions",
    "-fno-rtti",
]

config_setting(
    name = "darwin_target",
    constraint_values = ["@platforms//os:macos"],
)

config_setting(
    name = "linux_target",
    constraint_values = ["@platforms//os:linux"],
)

config_setting(
    name = "aarch64_target",
    constraint_values = ["@platforms//cpu:aarch64"],
)

config_setting(
    name = "x86_64_target",
    constraint_values = ["@platforms//cpu:x86_64"],
)

DESKTOP_TARGET = select({
    ":darwin_target": [],
    ":linux_target": [],
    "//conditions:default": ["@platforms//:incompatible"],
}) + select({
    ":aarch64_target": [],
    ":x86_64_target": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

CONFIGURE_TARGET = select({
    ":darwin_target": " --platform=macos",
    "//conditions:default": " --platform=linux",
}) + select({
    ":aarch64_target": " --arch=arm64",
    "//conditions:default": " --arch=x86_64",
})

# Expand source templates for the target ABI, including cross-compilation.
[genrule(
    name = "configure_" + name,
    srcs = [template],
    outs = ["build/include/" + output],
    cmd = "$(execpath @hermes//hermes/configure:configure)" + CONFIGURE_TARGET + " --template=$< --output=$@",
    tools = ["@hermes//hermes/configure"],
) for name, template, output in [
    ("llvm", "external/llvh/include/llvh/Config/llvm-config.h.cmake", "llvh/Config/llvm-config.h"),
    ("llvh", "external/llvh/include/llvh/Config/config.h.cmake", "llvh/Config/config.h"),
    ("vm", "lib/config/libhermesvm-config.h.in", "libhermesvm-config.h"),
]]

cc_library(
    name = "headers",
    hdrs = glob([
        "API/hermes/**/*.h",
        "API/jsi/jsi/*.h",
        "public/**/*.h",
    ]),
    includes = [
        "API",
        "API/jsi",
        "public",
    ],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "build_configuration",
    hdrs = glob(
        [
            "include/**/*.h",
            "include/**/*.def",
            "include/**/*.inc",
            "lib/**/*.h",
            "lib/**/*.def",
            "lib/**/*.inc",
            "external/llvh/**/*.h",
            "external/llvh/**/*.def",
            "external/llvh/**/*.inc",
            "external/dtoa/*.h",
            "external/dtoa/*.inc",
            "external/zip/**/*.h",
            "external/fast_float/**/*.h",
            "external/dragonbox/**/*.h",
        ],
        allow_empty = True,
    ) + [
        ":configure_llvh",
        ":configure_llvm",
        ":configure_vm",
    ],
    defines = HERMES_DEFINES,
    includes = [
        "build/include",
        "external",
        "external/dragonbox",
        "external/fast_float",
        "external/llvh/gen/include",
        "external/llvh/include",
        "include",
    ],
    visibility = ["@hermes//tests/upstream:__pkg__"],
    deps = [":headers"],
)

# external/dtoa/CMakeLists.txt keeps its C-only definitions off C++ callers.
cc_library(
    name = "dtoa_decimal",
    srcs = [
        "external/dtoa/dtoa.c",
        "external/dtoa/g_fmt.c",
