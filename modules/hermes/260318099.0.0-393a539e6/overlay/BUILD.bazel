    name = "embed_bytes",
    srcs = ["lib/InternalJavaScript/xxd.py"],
    legacy_create_init = 0,
    main = "lib/InternalJavaScript/xxd.py",
)

# lib/TypedLib/CMakeLists.txt specifies this concatenation order.
genrule(
    name = "typed_library_source",
    srcs = [
        "lib/TypedLib/00-prelude.js",
        "lib/TypedLib/01-array.js",
        "lib/TypedLib/02-string.js",
        "lib/TypedLib/03-map.js",
        "lib/TypedLib/04-set.js",
        "lib/TypedLib/05-number.js",
        "lib/TypedLib/05-symbol.js",
        "lib/TypedLib/06-object.js",
    ],
    outs = ["build/TypedLib.js"],
    cmd = "cat $(SRCS) > $@",
)

[genrule(
    name = name,
    srcs = [source],
    outs = ["build/include/" + output],
    cmd = "$(execpath :embed_bytes) $< > $@",
    tools = [":embed_bytes"],
) for name, source, output in [
    ("typed_library_include", ":typed_library_source", "TypedLib.inc"),
    ("typed_language_include", "doc/TypedLanguage.md", "TypedLanguage.inc"),
]]

# lib/InternalJavaScript/CMakeLists.txt orders JavaScript by filename prefix.
genrule(
    name = "internal_javascript_source",
    srcs = glob(["lib/InternalJavaScript/*.js"]),
    outs = ["build/InternalBytecode.js"],
    cmd = "cat $(SRCS) > $@",
)

genrule(
    name = "internal_javascript_bytecode",
    srcs = [":internal_javascript_source"],
    outs = ["build/InternalBytecode.hbc"],
    cmd = "$(execpath :hermesc) -O -Wno-undefined-variable -g0 -emit-binary -out=$@ $<",
    tools = [":hermesc"],
)

genrule(
    name = "internal_javascript_include",
    srcs = [":internal_javascript_bytecode"],
    outs = ["build/include/InternalBytecode.inc"],
    cmd = "$(execpath :embed_bytes) $< > $@",
    tools = [":embed_bytes"],
)

cc_library(
    name = "hermesInternalBytecode",
    srcs = ["lib/InternalJavaScript/InternalBytecode.cpp"],
    hdrs = [":internal_javascript_include"],
    copts = HERMES_INTERNAL_OPTIONS,
    deps = [":build_configuration"],
)

