# https://bazel.build/external/overview#bzlmod

module(
    name = "thinkit",
    version = "0.1.1",
    bazel_compatibility = [">=7.4.1"],
)

bazel_dep(name = "abseil-cpp", version = "20260107.1", repo_name = "com_google_absl")

# Not used directly. Pinned above grpc's default (0.20241024.0), which fails to
# compile on newer glibc/gcc (-Werror=discarded-qualifiers in OPENSSL_memchr).
bazel_dep(name = "boringssl", version = "0.20250114.0")
bazel_dep(name = "gutil", version = "20260309.0.bcr.1", repo_name = "com_google_gutil")
bazel_dep(name = "grpc", version = "1.81.1", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", repo_name = "com_google_googletest")
bazel_dep(name = "protobuf", version = "33.5", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "googleapis", version = "0.0.0-20260223-edfe7983", repo_name = "com_google_googleapis")
bazel_dep(name = "rules_go", version = "0.60.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "openconfig_gnmi", version = "0.14.1", repo_name = "com_github_gnmi")
bazel_dep(name = "openconfig_gnoi", version = "0.6.2", repo_name = "com_github_gnoi")
bazel_dep(name = "p4runtime", version = "1.5.0.bcr.1")

bazel_dep(
    name = "buildifier_prebuilt",
    version = "8.5.1.3",
    dev_dependency = True,
)
bazel_dep(
    name = "google_benchmark",
    version = "1.9.5",
    dev_dependency = True,
    repo_name = "com_google_benchmark",
)

single_version_override(
    module_name = "openconfig_gnoi",
    patch_strip = 1,
    patches = [
        "//:bazel/patches/gnoi-001-generate-mocks.patch",
    ],
)

non_module_deps = use_extension("//:thinkit_deps.bzl", "non_module_deps")
use_repo(non_module_deps, "com_github_otg_models")