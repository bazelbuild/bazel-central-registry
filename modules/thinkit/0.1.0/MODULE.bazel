# https://bazel.build/external/overview#bzlmod

module(
    name = "thinkit",
    version = "0.1.0",
    bazel_compatibility = [">=7.4.1"],
)

bazel_dep(name = "abseil-cpp", version = "20260107.1", repo_name = "com_google_absl")
bazel_dep(name = "gutil", version = "20260309.0.bcr.1", repo_name = "com_google_gutil")
bazel_dep(name = "grpc", version = "1.83.0", repo_name = "com_github_grpc_grpc")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", repo_name = "com_google_googletest")
bazel_dep(name = "protobuf", version = "33.5", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_proto", version = "7.1.0")
bazel_dep(name = "googleapis", version = "0.0.0-20251003-2193a2bf", repo_name = "com_google_googleapis")
bazel_dep(name = "rules_go", version = "0.59.0", repo_name = "io_bazel_rules_go")

bazel_dep(
    name = "buildifier_prebuilt",
    version = "8.5.1.3",
    dev_dependency = True,
)
bazel_dep(
    name = "google_benchmark",
    version = "1.9.5",
    dev_dependency = True,
    repo_name = "com_google_benchmark",
)

# Direct non-BCR repository dependencies via use_repo_rule
http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# gNMI
http_archive(
    name = "com_github_gnmi",
    patch_args = ["-p1"],
    patches = [
        "//:bazel/patches/gnmi-001-fix_virtual_proto_import.patch",
    ],
    sha256 = "2231e1cc398a523fa840810fa6fdb8960639f7b91b57bb8f12ed8681e0142a67",
    strip_prefix = "gnmi-0.10.0",
    url = "https://github.com/openconfig/gnmi/archive/refs/tags/v0.10.0.zip",
)

# gNOI
http_archive(
    name = "com_github_gnoi",
    patch_args = ["-p1"],
    patches = [
        "//:bazel/patches/gnoi-001-generate-mocks.patch",
    ],
    sha256 = "991ff13a0b28f2cdc2ccb123261e7554d9bcd95c00a127411939a3a8c8a9cc62",
    strip_prefix = "gnoi-1ece8ed91a0d5d283219a99eb4dc6c7eadb8f287",
    url = "https://github.com/openconfig/gnoi/archive/1ece8ed91a0d5d283219a99eb4dc6c7eadb8f287.zip",
)

# OTG Models
http_archive(
    name = "com_github_otg_models",
    build_file = "//:bazel/BUILD.otg-models.bazel",
    sha256 = "1a63e769f1d7f42c79bc1115babf54acbc44761849a77ac28f47a74567f10090",
    strip_prefix = "models-0.12.5",
    url = "https://github.com/open-traffic-generator/models/archive/refs/tags/v0.12.5.zip",
)

# P4Runtime
http_archive(
    name = "com_github_p4lang_p4runtime",
    sha256 = "e2f401c01c708b6f7c6a8f67fd2cf2982e8e7daa525de3ddd18446eb3a807299",
    strip_prefix = "p4runtime-b9375ada8acffc3f1fbdb71c20b33bc58ed5b75f/proto",
