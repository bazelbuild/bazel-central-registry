load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_package_metadata = [":package_metadata"],
    default_visibility = ["//visibility:public"],
)

exports_files(["LICENSE.txt"])

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:MIT",
    text = "LICENSE.txt",
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
)

# Header-only, like CMake's GPUOpen::VulkanMemoryAllocator. Exactly one translation
# unit of the consumer defines VMA_IMPLEMENTATION before including <vk_mem_alloc.h>.
# How VMA fetches Vulkan functions is chosen by the consumer as well, e.g.
#   VMA_STATIC_VULKAN_FUNCTIONS=1: call the Vulkan prototypes (link the Vulkan loader),
#   VMA_STATIC_VULKAN_FUNCTIONS=0 + VMA_DYNAMIC_VULKAN_FUNCTIONS=1: resolve them through
#   VmaVulkanFunctions::vkGetInstanceProcAddr/vkGetDeviceProcAddr (e.g. from volk).
cc_library(
    name = "vulkan_memory_allocator",
    hdrs = ["include/vk_mem_alloc.h"],
    includes = ["include"],
    deps = ["@vulkan_headers"],
)
