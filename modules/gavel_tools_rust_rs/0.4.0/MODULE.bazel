"""Clippy submission aspect for consumers building Rust with rules_rs.

Separate module so gavel_tools never depends on rules_rs (and so consumers using
plain rules_rust never fetch it). It imposes no toolchains: bzlmod resolves
rules_rs to the consumer's own version (this is only the minimum), and the
`rules_rust` repo bound below is the one rules_rs's module extension provides,
i.e. the same one the consumer's rules_rs targets are compiled with.
"""

module(
    name = "gavel_tools_rust_rs",
    version = "0.4.0",
    compatibility_level = 1,
)

# Overrides only take effect when this is the root module (dev / CI here); for
# consumers it is ignored and the registry version of gavel_tools is used.
bazel_dep(name = "gavel_tools", version = "0.4.0")
local_path_override(
    module_name = "gavel_tools",
    path = "../..",
)

bazel_dep(name = "rules_rs", version = "0.2.4")

# Evaluated once per module graph: this is the SAME @rules_rust repo the
# consumer's rules_rs targets use, so the upstream aspect below matches them.
rules_rust_ext = use_extension("@rules_rs//rs:rules_rust.bzl", "rules_rust")
use_repo(rules_rust_ext, "rules_rust")
