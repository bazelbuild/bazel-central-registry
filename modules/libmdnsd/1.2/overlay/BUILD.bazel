load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
)

exports_files(["LICENSE"])

license(
    name = "license",
    package_name = "mdnsd",
    license_kinds = ["@rules_license//licenses/spdx:BSD-3-Clause"],
    license_text = "LICENSE",
    package_url = "https://troglobit.com/projects/mdnsd",
)

cc_library(
    name = "libmdnsd",
    hdrs = [
        "libmdnsd/mdnsd.h",
        "libmdnsd/1035.h",
        "libmdnsd/sdtxt.h",
        "libmdnsd/xht.h",
        "libmdnsd/inet.h",
    ],
    srcs = [
        "libmdnsd/mdnsd.c",
        "libmdnsd/log.c",
        "libmdnsd/1035.c",
        "libmdnsd/sdtxt.c",
        "libmdnsd/xht.c",
        "libmdnsd/inet.c",
    ],
    deps = [
        "@rules_autoconf//:config",
    ],
    strip_include_prefix = "libmdnsd",
    copts = [
            "-std=gnu99",
            "-W",
            "-Wall",
            "-Wextra",
    ],
    local_defines = [
        "_GNU_SOURCE",
        "_BSD_SOURCE",
        "_DEFAULT_SOURCE",
    ],
    visibility = ["//visibility:public"],
)
