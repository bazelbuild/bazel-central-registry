# HTML Tidy library (libtidy), static, <tidy.h> / <tidybuffio.h>.
#
# Configured like upstream's default CMake build of the library: all
# localizations, no console application, no runtime configuration files.
#
# Consumers only see the four public headers that upstream installs directly
# into the include directory (<tidy.h>, <tidybuffio.h>, <tidyenum.h>,
# <tidyplatform.h>). The private headers in src/ (config.h, message.h,
# streamio.h, version.h, ...) live in a private library consumed through
# implementation_deps, so they never reach a consumer's include path.

load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:HTMLTIDY"],
    license_text = "README/LICENSE.md",
)

exports_files(["README/LICENSE.md"])

_SRCS = [
    "access.c",
    "alloc.c",
    "attrdict.c",
    "attrs.c",
    "buffio.c",
    "charsets.c",
    "clean.c",
    "config.c",
    "entities.c",
    "fileio.c",
    "gdoc.c",
    "istack.c",
    "language.c",
    "lexer.c",
    "mappedio.c",
    "message.c",
    "messageobj.c",
    "parser.c",
    "pprint.c",
    "sprtf.c",
    "streamio.c",
    "tagask.c",
    "tags.c",
    "tidylib.c",
    "tmbstr.c",
    "utf8.c",
]

# Private headers. The sources include their sibling headers in src/ with
# quotes, so no include path is needed.
cc_library(
    name = "tidy_private_hdrs",
    hdrs = glob(["src/*.h"]),
    visibility = ["//visibility:private"],
)

cc_library(
    name = "tidy",
    srcs = ["src/" + f for f in _SRCS],
    hdrs = [
        "include/tidy.h",
        "include/tidybuffio.h",
        "include/tidyenum.h",
        "include/tidyplatform.h",
    ],
    implementation_deps = [":tidy_private_hdrs"],
    local_defines = [
        'LIBTIDY_VERSION=\\"5.8.0\\"',
        'RELEASE_DATE=\\"2021/07/10\\"',
        "SUPPORT_LOCALIZATIONS=1",
        "SUPPORT_CONSOLE_APP=0",
        "HAVE_CONFIG_H",
        "_REENTRANT",
    ] + select({
        "@platforms//os:windows": [
            "NOMINMAX",
            "_USE_MATH_DEFINES",
            "_CRT_SECURE_NO_WARNINGS",
        ],
        "//conditions:default": [],
    }),
    strip_include_prefix = "include",
    visibility = ["//visibility:public"],
)
