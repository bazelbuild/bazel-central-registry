load(":boost_test_suite.bzl", "boost_test_suite")

# boost::rational<safe<int>> triggers MSVC's "recursive alias declaration"
# error in boost/safe_numerics/safe_base_operations.hpp, see
# https://github.com/boostorg/safe_numerics/issues/135
_MSVC_INCOMPATIBLE = ["test_rational.cpp"]

boost_test_suite(
    name = "upstream_tests",
    srcs = glob(
        ["test_*.cpp"],
        exclude = [
            "test_*_constexpr.cpp",
            "test_concept_integer.cpp",
            "test_concept_numeric.cpp",
            "test_constexpr.cpp",
            "test_performance.cpp",
            "test_stream_overload.cpp",
            "test_trap.cpp",
            "test_z.cpp",
        ] + _MSVC_INCOMPATIBLE,
    ),
)

boost_test_suite(
    name = "upstream_tests_without_msvc",
    srcs = _MSVC_INCOMPATIBLE,
    target_compatible_with = select({
        "@platforms//os:windows": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
)
