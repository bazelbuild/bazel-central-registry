load("@rules_cc//cc:cc_library.bzl", "cc_library")

_TEXTUAL_HDRS = glob(["include/boost/safe_numerics/concept/*.hpp"]) + [
    "include/boost/safe_numerics/checked_default.hpp",
    "include/boost/safe_numerics/checked_float.hpp",
    "include/boost/safe_numerics/native.hpp",
    "include/boost/safe_numerics/range_value.hpp",
]

cc_library(
    name = "boost.safe_numerics",
    hdrs = glob(["include/**/*.hpp"], exclude = _TEXTUAL_HDRS),
    features = ["parse_headers"],
    includes = ["include"],
    textual_hdrs = _TEXTUAL_HDRS,
    visibility = ["//visibility:public"],
    deps = [
        "@boost.concept_check",
        "@boost.config",
        "@boost.core",
        "@boost.integer",
        "@boost.logic",
        "@boost.mp11",
    ],
)
