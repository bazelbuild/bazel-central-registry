bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "googleapis")
bazel_dep(name = "googleapis-cc", version = "1.0.0")
bazel_dep(name = "googleapis-go", version = "1.0.0")
bazel_dep(name = "googleapis-java", version = "1.0.0")
bazel_dep(name = "googleapis-python", version = "1.0.0")
bazel_dep(name = "googleapis-grpc-cc", version = "1.0.0")
bazel_dep(name = "googleapis-grpc-java", version = "1.0.0")

# Use test dependencies compatible with Bazel 9.
bazel_dep(name = "grpc", version = "1.84.0")
bazel_dep(name = "grpc-java", version = "1.78.0.bcr.1")
bazel_dep(name = "rules_jvm_external", version = "6.9")

# Resolve the combined Java dependencies instead of using protobuf's lock file.
maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    name = "maven",
    known_contributing_modules = [
        "grpc-java",
        "protobuf",
    ],
)

local_path_override(
    module_name = "googleapis",
    path = "../..",
)
