module(
    name = "bazel_paq",
    version = "2.0.0",
    compatibility_level = 1,
)

# test dependencies
bazel_dep(name = "bazel_skylib", version = "1.8.2", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.6.1", dev_dependency = True)

# use the extension defined in extensions.bzl to fetch the paq binary
paq_ext = use_extension("//:extensions.bzl", "paq_extension")
use_repo(paq_ext, "paq")

# Exercise both generated executable layouts, regardless of the test host OS.
paq_layout = use_repo_rule("//tests:paq_platform_fixtures.bzl", "paq_layout_repository")
paq_layout(name = "paq_windows_fixture", binary = "paq.exe", dev_dependency = True)
paq_layout(name = "paq_unix_fixture", binary = "paq", dev_dependency = True)
