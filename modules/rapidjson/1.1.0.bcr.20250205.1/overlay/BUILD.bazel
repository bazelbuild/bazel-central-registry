load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//licenses/rules:license_kind.bzl", "license_kind")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(
    default_package_metadata = [":package_metadata"],
)

# Note: RapidJSON is MIT licensed, but the library headers also include
# msinttypes (include/rapidjson/msinttypes/), which is BSD-3-Clause. The
# JSON licensed bin/jsonchecker/ is only used by tests. See license.txt.
license_kind(
    name = "license_kind",
    full_name = "MIT License and BSD 3-Clause \"New\" or \"Revised\" License",
    identifier = "MIT AND BSD-3-Clause",
)

license(
    name = "license",
    kind = ":license_kind",
    text = "license.txt",
    visibility = ["//visibility:public"],
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

exports_files(["license.txt"])

licenses(["notice"])  # MIT

filegroup(
    name = "bin",
    srcs = glob(["bin/**"]),
    visibility = ["//:__subpackages__"],
)

cc_library(
    name = "rapidjson",
    srcs = glob(["include/rapidjson/internal/*.h"]),
    hdrs = glob(
        include = [
            "include/rapidjson/**/*.h",
        ],
        exclude = [
            "include/rapidjson/internal/*.h",
        ],
    ),
    includes = ["include"],
    visibility = ["//visibility:public"],
)
