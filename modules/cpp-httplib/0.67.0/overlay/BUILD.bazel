load("@rules_cc//cc:defs.bzl", "cc_library")

cc_library(
    name = "httplib",
    hdrs = ["httplib.h"],
    # Consumers see these, so the header compiles the same way for every includer.
    defines = [
        "CPPHTTPLIB_OPENSSL_SUPPORT",
        "CPPHTTPLIB_ZLIB_SUPPORT",
    ],
    features = [
        "parse_headers",
    ],
    includes = ["."],
    # On macOS, the header loads system root certificates through the Keychain.
    linkopts = select({
        "@platforms//os:macos": [
            "-framework CFNetwork",
            "-framework CoreFoundation",
            "-framework Security",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "@boringssl//:ssl",
        "@zlib",
    ],
)

alias(
    name = "cpp-httplib",
    actual = ":httplib",
    visibility = ["//visibility:public"],
)
