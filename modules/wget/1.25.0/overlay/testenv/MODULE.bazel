"""Test module for GNU Wget: upstream's testenv/ suite.

Kept separate from `@wget` so that its only extra dependency, a Python
toolchain, is not inherited by consumers of the program.
"""

bazel_dep(name = "wget")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_python", version = "1.5.1")

local_path_override(
    module_name = "wget",
    path = "..",
)
