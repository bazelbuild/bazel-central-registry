]

[
    autoconf_hdr(
        name = "lib_{}_h".format(stem.replace("/", "_")),
        out = "lib/{}.h".format(stem),
        defaults = True,
        inlines = GL_INLINES,
        mode = "subst",
        template = "lib/{}.in.h".format(stem.replace("/", "_")),
        deps = [":autoconf"],
    )
    for stem in LIB_GENERATED_HDRS
]

LIB_GENERATED_TARGETS = [
    ":lib_{}_h".format(stem.replace("/", "_"))
    for stem in LIB_GENERATED_HDRS
]

# gnulib headers that are generated only when the corresponding
# `GL_GENERATE_*_H` says the system header is unusable.  Each is processed
# unconditionally and `cc_gnulib_conditional_hdrs` picks the ones whose
# condition is true.  `netinet/in.h` is the one such header not carried: its
# condition only ever holds on mingw, which this module does not build for
# (see the platform note at the gnulib library below), and the rule places
# conditional headers by basename only.
GNULIB_CONDITIONAL_HDRS = [
    "alloca",
    "assert",
    "byteswap",
    "errno",
    "float",
    "fnmatch",
    "getopt-cdefs",
    "getopt",
    "limits",
    "stdckdint",
    "stddef",
    "stdint",
]

[
    autoconf_hdr(
        name = "lib_{}_h_processed".format(stem.replace("-", "_")),
        out = "_gnulib_cond/{}.h".format(stem),
        defaults = True,
        inlines = GL_INLINES,
        mode = "subst",
        template = "lib/{}.in.h".format(stem),
        deps = [":autoconf"],
    )
    for stem in GNULIB_CONDITIONAL_HDRS
]

# `iconv.h` is left out: m4/iconv_h.m4:64 only ever sets GL_GENERATE_ICONV_H
# from gl_REPLACE_ICONV_H, which the `iconv_open` module calls and wget's
# module set (AM_ICONV via `iconv` alone) does not include.
cc_gnulib_conditional_hdrs(
    name = "gnulib_conditional_hdrs",
    hdrs = {
        ":lib_{}_h_processed".format(stem.replace("-", "_")): "GL_GENERATE_{}_H".format(stem.replace("-", "_").upper())
        for stem in GNULIB_CONDITIONAL_HDRS
    },
    deps = [":autoconf"],
)

# The glibc-derived headers lib/gnulib.mk rewrites with `sed` (lines 1482,
# 1490 and 1515).  Each edit is a literal replacement, so the same
# `substitutions` reproduce them; the one `/libc_hidden_proto/d` line deletion
# becomes a comment instead.  unicase/special-casing.h (lib/gnulib.mk:4408)
# is the template with its lookup declaration replaced by the one gperf wrote
# into special-casing-table.h minus `register`; for the shipped table that is
# the same text, so the template is copied as is.
GL_SED_HDRS = {
    "lib/malloc/dynarray-skeleton.gl.h": {
        "substitutions": {
            "<malloc/dynarray.h>": "<malloc/dynarray.gl.h>",
            "__attribute_maybe_unused__": "_GL_ATTRIBUTE_MAYBE_UNUSED",
            "__attribute_nonnull__": "_GL_ATTRIBUTE_NONNULL",
            "__attribute_warn_unused_result__": "_GL_ATTRIBUTE_NODISCARD",
            "__glibc_likely": "_GL_LIKELY",
            "__glibc_unlikely": "_GL_UNLIKELY",
        },
        "template": "lib/malloc/dynarray-skeleton.c",
    },
    "lib/malloc/dynarray.gl.h": {
        "substitutions": {
            "libc_hidden_proto": "// libc_hidden_proto",
        },
        "template": "lib/malloc/dynarray.h",
    },
    "lib/malloc/scratch_buffer.gl.h": {
        "substitutions": {
            "libc_hidden_proto": "// libc_hidden_proto",
            "__always_inline": "inline _GL_ATTRIBUTE_ALWAYS_INLINE",
            "__glibc_likely": "_GL_LIKELY",
            "__glibc_unlikely": "_GL_UNLIKELY",
        },
        "template": "lib/malloc/scratch_buffer.h",
    },
    "lib/unicase/special-casing.h": {
        "substitutions": {},
        "template": "lib/unicase/special-casing.in.h",
    },
}

[
    autoconf_hdr(
        name = out.replace("/", "_").replace(".", "_").replace("-", "_"),
        out = out,
        mode = "subst",
        substitutions = spec["substitutions"],
        template = spec["template"],
        deps = [":autoconf"],
    )
    for out, spec in GL_SED_HDRS.items()
]

GL_SED_HDR_TARGETS = [
    ":" + out.replace("/", "_").replace(".", "_").replace("-", "_")
    for out in GL_SED_HDRS
]

# Conditions for the conditionally compiled sources, transcribed from the shell
# tests upstream gates them with: `gl_CONDITIONAL` in m4/gnulib-comp.m4, or,
# for the keys upstream has no conditional for, the `if` around its
# `AC_LIBOBJ`.
#
# Those tests read the shell variable a gnulib module leaves behind, so `HAVE_X`
# upstream means the `AC_SUBST` of that name and never the config.h define.
# Each is written as the cache variable unique to the check that produced it
# (`ac_cv_subst_`/`ac_cv_define_`/`ac_cv_func_`), because a bare name is looked
# up across all three namespaces and can be missing, ambiguous or -- for an
# `AC_DEFINE` with `requires` -- valueless, each only on the platform that trips
# it.  `test $X = 1` is likewise `X==1` and not a bare mention of X, except
# where the same variable is also dropped into a C `#if` by a header template
# and may legitimately hold 2 (REPLACE_*_FOR_*).
#
# One more rule: where a port fills a substitution from a probe rather than
# an `AC_SUBST` (an `AC_CHECK_FUNC(..., subst = True)` for most `HAVE_<func>`,
# `AC_DEFINE(..., subst = True)` for HAVE_CLOSEDIR, HAVE_FSTATAT and macOS'
# REPLACE_POSIX_SPAWN), there is no `ac_cv_subst_<NAME>` of its own and that
# spelling resolves to the toolchain *default* instead -- the header then
# renames a function to `rpl_*` while the source that defines it is left
# out, which is a link failure on the platform where they differ.  Those
# are spelled with the probe's own cache name (`ac_cv_func_<func>`,
# `ac_cv_define_<NAME>`).
