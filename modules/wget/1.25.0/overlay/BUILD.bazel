autoconf(
    name = "autoconf",
    # The check list below follows `configure.ac` top to bottom.  Everything
    # wget itself asks for is written out here rather than depended on, so
    # each entry can be read against the line of `configure.ac` it came from.
    # Only `gl_INIT` stays a dependency; see GL_INIT_DEPS for why.
    #
    # Where a probe is reached both from here and from `gl_INIT`, upstream runs
    # it once and the single result is shared.  The same holds here, and it has
    # to: a symbol may be defined only once per `autoconf` target.  So the
    # following are asked for by configure.ac but resolved under GL_INIT_DEPS:
    # AC_USE_SYSTEM_EXTENSIONS (:56) and AC_CANONICAL_HOST (:62) via
    # `extensions`; AC_C_INLINE (:296) via `inline`; AC_SYS_LARGEFILE (:302)
    # via `largefile`; AC_HEADER_STDBOOL (:308) via `c-bool`; the
    # `unistd.h`, `sys/time.h`, `sys/ioctl.h`, `sys/select.h`, `stdint.h`,
    # `inttypes.h` and `wchar.h` probes of :309-311 via the matching `*_h`
    # modules; AC_TYPE_SIZE_T/AC_TYPE_PID_T (:325) via `sys_types_h`;
    # `sig_atomic_t` (:328) via `sig_atomic_t`; AM_ICONV (:336) via `iconv`;
    # AM_GNU_GETTEXT (:263) via `gettext`; AC_FUNC_FSEEKO (:345) via `fseeko`;
    # WGET_STRUCT_SOCKADDR_STORAGE (:716) via `sys_socket_h`; and of the
    # function lists at :346-348 `timegm`, `vsnprintf`, `vasprintf`,
    # `strtoll`, `ftello`, `memrchr`, `wcwidth`, `mbtowc`, `symlink`, `utime`
    # and `strptime` via the modules of the same names.
    checks = (
        # AC_DEFINE_UNQUOTED([OS_TYPE], "$host_os") (configure.ac:63).  Only
        # printed by `--version`; the canonical suffix is approximated.
        select({
            "@platforms//os:freebsd": [checks.AC_DEFINE("OS_TYPE", '"freebsd"')],
            "@platforms//os:linux": [checks.AC_DEFINE("OS_TYPE", '"linux-gnu"')],
            "@platforms//os:macos": [checks.AC_DEFINE("OS_TYPE", '"darwin"')],
            "@platforms//os:windows": [checks.AC_DEFINE("OS_TYPE", '"mingw32"')],
            "//conditions:default": [checks.AC_DEFINE("OS_TYPE", '"unknown"')],
        }) +
        # --enable-opie (:166), --enable-digest (:178), --enable-debug (:198).
        select({
            ":_with_opie": [checks.AC_DEFINE("ENABLE_OPIE")],
            "//conditions:default": [],
        }) +
        select({
            ":_with_digest": [checks.AC_DEFINE("ENABLE_DIGEST")],
            "//conditions:default": [],
        }) +
        select({
            ":_with_debug": [checks.AC_DEFINE("ENABLE_DEBUG")],
            "//conditions:default": [],
        }) +
        # AC_CHECK_SIZEOF(off_t) (:303) and AC_CHECK_SIZEOF([long]) (:320).
        [
            checks.AC_CHECK_SIZEOF(
                "off_t",
                define = "SIZEOF_OFF_T",
                includes = ["#include <sys/types.h>"],
            ),
            checks.AC_CHECK_SIZEOF(
                "long",
                define = "SIZEOF_LONG",
            ),
        ] +
        # configure.ac:310-311, the two headers no gnulib module probes
        # (`termios.h` is `termios_h`'s).
        macros.AC_CHECK_HEADERS([
            "pwd.h",
            "dlfcn.h",
        ]) +
        # configure.ac:313.
        macros.AC_CHECK_DECLS(
            ["h_errno"],
            includes = ["#include <netdb.h>"],
        ) +
        # configure.ac:327.  autoconf's default includes bring in <stdint.h>
        # and <inttypes.h>, which is where these live.
        macros.AC_CHECK_TYPES(
            [
                "uint32_t",
                "uintptr_t",
                "intptr_t",
                "int64_t",
            ],
            includes = [
                "#include <inttypes.h>",
                "#include <stdint.h>",
            ],
        ) +
        # AC_FUNC_MMAP (configure.ac:344).  An AC_RUN_IFELSE whose
        # cross-compilation guess is "no", which would silently turn off the
        # mmap path in src/utils.c on every platform, so the presence of the
        # function is used instead.  The macro's AC_CHECK_FUNCS([getpagesize])
        # is its only other config.h output (its <sys/mman.h> probe is shared
        # with gnulib's `mmap-anon`).
        macros.AC_CHECK_FUNCS([
            "getpagesize",
        ]) + [
            checks.AC_CHECK_FUNC(
                "mmap",
                name = "ac_cv_func_mmap",
            ),
            checks.AC_DEFINE(
                "HAVE_MMAP",
                requires = ["ac_cv_func_mmap==1"],
            ),
        ] +
        # configure.ac:346-348, minus the names gnulib already probes (see the
        # note above).  sigsetjmp is a macro on glibc, so AC_CHECK_FUNCS says
        # "no" there just as upstream does.
        macros.AC_CHECK_FUNCS([
            "drand48",
            "pathconf",
            "usleep",
            "sigblock",
            "sigsetjmp",
            "sleep",
            "strlcpy",
            "random",
            "fmemopen",
        ]) +
        # configure.ac:354-355.
        [
            checks.AC_DEFINE("HAVE_STRDUP"),
            checks.AC_DEFINE("HAVE_ISATTY"),
        ] +
        # --with-zlib (configure.ac:510) and --enable-pcre2 (:854): a
        # PKG_CHECK_MODULES/AC_CHECK_LIB pair whose config.h output is the one
        # define; the library itself is a `deps` entry on `:wget`.
        select({
            ":_with_zlib": [checks.AC_DEFINE("HAVE_LIBZ")],
            "//conditions:default": [],
        }) +
        select({
            ":_with_pcre2": [checks.AC_DEFINE("HAVE_LIBPCRE2")],
            "//conditions:default": [],
        }) +
        # --with-ssl=openssl (configure.ac:521).  Upstream probes the library
        # pkg-config found; an `autoconf` target can only probe the toolchain,
        # not `@openssl`, so the result is stated for the pinned module.
        # HAVE_RAND_EGD (:529) stays undefined: OpenSSL dropped RAND_egd in
        # 1.1.0.
        select({
            ":_ssl_openssl": [checks.AC_DEFINE("HAVE_LIBSSL")],
            "//conditions:default": [],
        }) +
        # --enable-ntlm=auto (configure.ac:629): on with OpenSSL, see `:_ntlm`.
        select({
            ":_ntlm": [checks.AC_DEFINE("ENABLE_NTLM")],
            "//conditions:default": [],
        }) +
        # --enable-ipv6 (configure.ac:703-722): PROTO_INET6 (m4/wget.m4), a
        # preprocessor check for PF_INET6/AF_INET6; TYPE_STRUCT_SOCKADDR_IN6,
        # whose AC_CHECK_TYPES gnulib's `netinet_in_h` has already run (the
        # shared `ac_cv_type_struct_sockaddr_in6` is used below);
        # MEMBER_SIN6_SCOPE_ID.  ENABLE_IPV6 needs the first two.
        select({
            ":_with_ipv6": [
                checks.AC_TRY_COMPILE(
                    name = "wget_cv_proto_inet6",
                    code = """\
#include <sys/types.h>
#include <sys/socket.h>
#include <netinet/in.h>
#ifndef PF_INET6
#error Missing PF_INET6
#endif
#ifndef AF_INET6
#error Missing AF_INET6
#endif
int main(void) { return 0; }
""",
                ),
                checks.AC_CHECK_MEMBER(
                    "struct sockaddr_in6.sin6_scope_id",
                    compile_defines = SOCKET_COMPILE_DEFINES,
                    define = "HAVE_SOCKADDR_IN6_SCOPE_ID",
                    includes = SOCKADDR_IN6_INCLUDES,
                    requires = ["ac_cv_type_struct_sockaddr_in6==1"],
                ),
                checks.AC_DEFINE(
                    "ENABLE_IPV6",
                    requires = [
                        "wget_cv_proto_inet6==1",
                        "ac_cv_type_struct_sockaddr_in6==1",
                    ],
                ),
            ],
            "//conditions:default": [],
        }) +
        # --with-libuuid (configure.ac:833): the default arm finds
        # <uuid/uuid.h> plus -luuid, i.e. `uuid_mode=1`.  The BSD
        # uuid_create() arm (`uuid_mode=2`) is not carried; src/warc.c falls
        # back to its own generator where neither define is set.
        select({
            ":_with_libuuid": [checks.AC_DEFINE("HAVE_LIBUUID")],
            "//conditions:default": [],
        }) +
        # --with-cares (configure.ac:896).
        select({
            ":_with_cares": [checks.AC_DEFINE("HAVE_LIBCARES")],
            "//conditions:default": [],
        }) +
        # --enable-xattr (configure.ac:975).  Linux and macOS probe fsetxattr,
        # FreeBSD extattr_set_fd, and ENABLE_XATTR follows the probe.
        select({
            ":_xattr_extattr": macros.AC_CHECK_FUNCS(["extattr_set_fd"]) + [
                checks.AC_DEFINE(
                    "ENABLE_XATTR",
                    requires = ["ac_cv_func_extattr_set_fd==1"],
                ),
            ],
            ":_xattr_fsetxattr": macros.AC_CHECK_FUNCS(["fsetxattr"]) + [
                checks.AC_DEFINE(
                    "ENABLE_XATTR",
                    requires = ["ac_cv_func_fsetxattr==1"],
                ),
            ],
            "//conditions:default": [],
        }) +
        # gl_THREADLIB_BODY (m4/threadlib.m4): LIBMULTITHREAD is `-lpthread`
        # exactly when `pthread_kill` is not in libc (glibc < 2.34, e.g.
        # ubuntu2004), and empty on newer glibc and macOS.  The `threadlib`
        # port publishes LIBMULTITHREAD as a constant "" and its own probe asks
        # for pthread_mutex_lock, which glibc 2.31's libc forwards, so neither
        # answers correctly there; gnulib's `lock` module then fails to link
        # once no other dependency drags libpthread in (`--ssl=no`).
        [
            checks.AC_SEARCH_LIBS(
                "pthread_kill",
                ["pthread"],
                name = "wget_cv_search_pthread_kill",
                subst = "LIBMULTITHREAD_POSIX",
            ),
        ] +
        # gl_FUNC_MKTIME (m4/mktime.m4:318-336), the part the `mktime` port
        # leaves out: lib/mktime.c reads the DST flag through glibc's
        # `__daylight`, and the m4 defines that name to whatever spelling the
        # C library has.  glibc exports `__daylight` itself; macOS and the
        # BSDs only have POSIX `daylight`.  Windows' `_daylight` and the
        # last-resort `1` are not carried, Windows not being a target.
        [
            checks.AC_TRY_LINK(
                name = "wget_cv_var___daylight",
                code = "#include <time.h>\nint main(void) { return __daylight; }",
            ),
            checks.AC_DEFINE(
                "__daylight",
                requires = ["!wget_cv_var___daylight"],
                value = "daylight",
            ),
        ] +
        # AM_INIT_AUTOMAKE (configure.ac:54) mirrors AC_INIT's tarname and
        # version into config.h.
        [
            checks.AC_DEFINE(
                "PACKAGE",
                value = '"wget"',
            ),
            checks.AC_DEFINE(
                "VERSION",
                value = '"1.25.0"',
            ),
            # gl_INIT sets this for the gnulib header templates; the toolchain
            # defaults have no value for it.
            checks.AC_SUBST(
                "GUARD_PREFIX",
                value = "GL",
            ),
        ] +
        # wget's gnulib snapshot predates the one behind the toolchain
        # defaults, and its templates use a few `@VAR@`s the defaults no longer
        # know.  langinfo.in.h: the two probes of m4/langinfo_h.m4:45 and :77
        # that the `langinfo_h` port dropped.  errno.in.h: the EMULTIHOP,
        # ENOLINK and EOVERFLOW fallbacks of m4/errno_h.m4, which only matter
        # when errno.h is generated, i.e. never on the platforms this module
        # builds for (every one of them defines all three), so they take the
        # "not hidden" values.
        [
            checks.AC_TRY_COMPILE(
                name = "gl_cv_header_langinfo_t_fmt_ampm",
                code = "#include <langinfo.h>\nint a = T_FMT_AMPM;\nint main(void) { return 0; }",
                subst = "HAVE_LANGINFO_T_FMT_AMPM",
            ),
            checks.AC_TRY_COMPILE(
                name = "gl_cv_header_langinfo_yesexpr",
                code = "#include <langinfo.h>\nint a = YESEXPR;\nint main(void) { return 0; }",
                subst = "HAVE_LANGINFO_YESEXPR",
            ),
        ] + [
            checks.AC_SUBST(var, "0")
            for var in [
                "EMULTIHOP_HIDDEN",
                "EMULTIHOP_VALUE",
                "ENOLINK_HIDDEN",
                "ENOLINK_VALUE",
                "EOVERFLOW_HIDDEN",
                "EOVERFLOW_VALUE",
            ]
        ] +
        # gl_INIT module indicators, see the lists above.
        [
            checks.AC_SUBST(
                "GNULIB_" + v,
                1,
            )
            for v in GNULIB_HEADER_MODULE_INDICATORS
        ] + [
            checks.AC_DEFINE(
                "GNULIB_TEST_" + v,
                "1",
            )
            for v in GNULIB_HEADER_MODULE_INDICATORS
        ] + [
            checks.AC_DEFINE(
                "GNULIB_" + v,
                "1",
            )
            for v in GNULIB_MODULE_INDICATORS
        ] + [
            checks.AC_DEFINE(
                "GNULIB_TEST_" + v,
                "1",
            )
            for v in GNULIB_TEST_MODULE_INDICATORS
        ]
    ),
    deps = [":package"] + GL_INIT_DEPS,
)

# AC_CONFIG_HEADERS([src/config.h]) (configure.ac:1014).  Upstream writes it
# next to the sources; keeping it out of `src/` means the two libraries below
# can take it through one include directory without exposing `src/`.
autoconf_hdr(
    name = "config",
    out = "config/config.h",
    defaults = True,
    # The rules_cc_autoconf `nl_langinfo` port answers NL_LANGINFO_MTSAFE=0
    # on every platform but Linux; gnulib's m4/nl_langinfo.m4:46 answers 0
    # only on Solaris, and lib/nl_langinfo.c:157 takes a 0 to mean Solaris'
    # <langinfo.h> (MAXSTRMSG), which fails to compile on macOS.  None of the
    # platforms this module builds for is Solaris, so the entry is fixed at
    # gnulib's answer before the port's result is applied (a check with no
    # `#undef` left to fill is dropped).
    substitutions = {
        "#undef NL_LANGINFO_MTSAFE": "#define NL_LANGINFO_MTSAFE 1",
    },
    template = "src/config.h.in",
    deps = [":autoconf"],
)

# ---------------------------------------------------------------------------
# gnulib (lib/)
# ---------------------------------------------------------------------------

# The `-e '/definition of X/r file'` edits lib/gnulib.mk applies to every
# substituted header.
GL_INLINES = {
    "/* The definition of _GL_ARG_NONNULL is copied here.  */": "lib/arg-nonnull.h",
    "/* The definition of _GL_WARN_ON_USE is copied here.  */": "lib/warn-on-use.h",
    "/* The definition of _Noreturn is copied here.  */": "lib/_Noreturn.h",
    "/* The definition of static_assert is copied here.  */": "lib/verify.h",
    "/* The definitions of _GL_FUNCDECL_RPL etc. are copied here.  */": "lib/c++defs.h",
}

# Unconditional gnulib substituted headers (BUILT_SOURCES in lib/gnulib.mk).
# Output, template and target name are all derived from the stem: the
# template flattens `/` to `_` (`sys/stat` -> `sys_stat.in.h`) and the header
# is installed at the nested path.
