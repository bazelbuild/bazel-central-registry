    }.items()},
    defaults = True,
    naming = "per_target",
    deps = [":autoconf"],
)

# Platform note.  Upstream builds on Windows only under mingw (configure.ac:359
# and src/mswindows.c), and the registry's Windows toolchains are MSVC-based,
# which gnulib's mingw branches do not compile under.  The sources gnulib
# compiles only there -- the winsock replacements (accept.c, socket.c, ...),
# windows-*.c, stat-w32.c and os2-spawn.c -- are therefore not carried, and
# neither are src/mswindows.c or the `netinet/in.h` template.  The presubmit
# matrix leaves Windows out for the same reason.
cc_library(
    name = "gnulib",
    srcs = GNULIB_SRCS + [
        ":gnulib_conditional_srcs",
    ],
    hdrs = glob(["lib/**/*.h"]) + LIB_GENERATED_TARGETS + GL_SED_HDR_TARGETS,
    copts = COPTS,
    includes = ["lib"],
    local_defines = LOCAL_DEFINES,
    textual_hdrs = GNULIB_TEXTUAL_HDRS,
    # Private, as upstream's noinst libgnu.a is; the tests link it the way
    # tests/Makefile.am:96 does.
    visibility = ["//:__subpackages__"],
    deps = [
        # First, so that its directory precedes every dependency's: nghttp2
        # publishes a header named config.h of its own (see `:config_h`).
        ":config_h",
        ":gnulib_conditional_hdrs",
        ":gnulib_linkopts",
    ],
)

# The sources `#include <config.h>` by that bare name, and `@nghttp2` exposes a
# `config.h` of its own through `strip_include_prefix`.  Which one an angle
# include finds depends on directory order, and on how each directory is
# spelled: with the `external_include_paths` feature a dependency's `includes`
# become `-isystem` (searched after every `-I`), whereas `strip_include_prefix`
# directories stay `-I`.  Publishing ours the same way, from the first
# dependency in every chain, keeps it ahead in both spellings.
cc_library(
    name = "config_h",
    hdrs = [":config"],
    strip_include_prefix = "config",
    visibility = ["//:__subpackages__"],
)

# LDADD (src/Makefile.am:81): the link libraries gnulib's own probes settle
# on.  Resolved into linker flags at build time from the substitutions the
# gnulib modules publish; names no module in this port publishes (LIBSOCKET,
# LIBC32CONV, HARD_LOCALE_LIB) are ignored by the rule, and all three are
# empty on the platforms above anyway.
autoconf_linkopts(
    name = "gnulib_linkopts",
    vars = [
        "CLOCK_TIME_LIB",
        "GETADDRINFO_LIB",
        "GETRANDOM_LIB",
        "HARD_LOCALE_LIB",
        "HOSTENT_LIB",
        "INET_NTOP_LIB",
        "LIBSOCKET",
        "LIBTHREAD",
        # The probed pthread library, see `wget_cv_search_pthread_kill`.
        "LIBMULTITHREAD_POSIX",
        "LIB_CRYPTO",
        "LIBC32CONV",
        "LIBICONV",
        "LIBINTL",
        "LIBUNISTRING",
        "MBRTOWC_LIB",
        "NANOSLEEP_LIB",
        "POSIX_SPAWN_LIB",
        "PTHREAD_SIGMASK_LIB",
        "SELECT_LIB",
        "SERVENT_LIB",
        "SETLOCALE_NULL_LIB",
    ],
    deps = [":autoconf"],
)

# ---------------------------------------------------------------------------
# wget (src/Makefile.am)
# ---------------------------------------------------------------------------

# version.c (src/Makefile.am:120).  Upstream writes the exact compiler and
# linker command lines into the two strings for `wget --version`; there is
# no equivalent of `$(COMPILE)` to quote here, so they name the build system.
write_file(
    name = "version_c",
    out = "src/version.c",
    content = [
        "/* version.c */",
        "/* Autogenerated by Makefile - DO NOT EDIT */",
        "",
        '#include "version.h"',
        'const char *version_string = "1.25.0";',
        'const char *compilation_string = "bazel";',
        'const char *link_string = "bazel";',
    ],
)

# wget_SOURCES (src/Makefile.am:39).  css_.c is flex output that the tarball
# ships already wrapped (src/Makefile.am:137), so no lex toolchain is
# involved; build_info.c likewise ships pre-generated from build_info.c.in
# and decides its feature list from config.h at compile time.
WGET_SRCS = [
    "src/build_info.c",
    "src/connect.c",
    "src/convert.c",
    "src/cookies.c",
    "src/css-url.c",
    "src/css_.c",
    "src/exits.c",
    "src/ftp-basic.c",
    "src/ftp-ls.c",
    "src/ftp.c",
    "src/hash.c",
    "src/host.c",
    "src/hsts.c",
    "src/html-parse.c",
    "src/html-url.c",
    "src/http.c",
    "src/init.c",
    "src/log.c",
    "src/main.c",
    "src/netrc.c",
    "src/progress.c",
    "src/ptimer.c",
    "src/recur.c",
    "src/res.c",
    "src/retr.c",
    "src/spider.c",
    "src/url.c",
    "src/utils.c",
    "src/warc.c",
    ":version_c",
] + select({
    # src/Makefile.am:59 (WITH_OPIE).
    ":_with_opie": ["src/ftp-opie.c"],
    "//conditions:default": [],
}) + select({
    # src/Makefile.am:67 (WITH_NTLM).
    ":_ntlm": ["src/http-ntlm.c"],
    "//conditions:default": [],
}) + select({
    # src/Makefile.am:71 (WITH_OPENSSL).
    ":_ssl_openssl": ["src/openssl.c"],
    "//conditions:default": [],
}) + select({
    # src/Makefile.am:55 (WITH_XATTR), which follows the fsetxattr /
    # extattr_set_fd probe rather than the flag alone.
    ":_xattr_probed": [":xattr_src"],
    "//conditions:default": [],
})

autoconf_srcs(
    name = "xattr_src",
    srcs = {"src/xattr.c": "ac_cv_define_ENABLE_XATTR"},
    naming = "per_target",
    # The condition only exists where the probe ran; keep `//...` from
    # analyzing this target anywhere else.
    target_compatible_with = select({
        ":_xattr_probed": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":autoconf"],
)

# The optional libraries.  `LIBS` in configure.ac accumulates them in probe
# order; the linker order does not matter to a static link.
WGET_OPTIONAL_DEPS = select({
    ":_ssl_openssl": [
        "@openssl//:ssl",
        "@openssl//:crypto",
    ],
    "//conditions:default": [],
}) + select({
    ":_with_zlib": ["@zlib//:zlib"],
    "//conditions:default": [],
}) + select({
    ":_with_pcre2": ["@pcre2//:pcre2"],
    "//conditions:default": [],
}) + select({
    ":_with_cares": ["@c-ares//:ares"],
    "//conditions:default": [],
}) + select({
    ":_with_libuuid": ["@libuuid//:uuid"],
    "//conditions:default": [],
})

# src/Makefile.am:35, shared by the program and its `-DTESTING` twin.
SRC_LOCAL_DEFINES = LOCAL_DEFINES + [
    "SYSTEM_WGETRC=\\\"$(SYSCONFDIR)/wgetrc\\\"",
    "LOCALEDIR=\\\"$(LOCALEDIR)\\\"",
]

# Public visibility tracks what `make install` publishes: the `wget` program
# (src/Makefile.am:38).  `:gnulib` stays private, together with its include
# paths.
cc_binary(
    name = "wget",
    srcs = WGET_SRCS + glob(["src/*.h"]),
    copts = COPTS,
    includes = ["src"],
    local_defines = SRC_LOCAL_DEFINES,
    toolchains = [":install_dirs"],
    visibility = ["//visibility:public"],
    deps = [":gnulib"] + WGET_OPTIONAL_DEPS,
)

# libunittest.a (src/Makefile.am:148): the same sources compiled with
# `-DTESTING`, which renames main() and exposes the static helpers the unit
# tests exercise.  Only //tests links it.
cc_library(
    name = "libunittest",
    testonly = True,
    # Under TESTING the sources include "../tests/unit-tests.h".
    srcs = WGET_SRCS + ["//tests:unit-tests.h"],
    hdrs = glob(["src/*.h"]),
    copts = COPTS,
    includes = ["src"],
    local_defines = SRC_LOCAL_DEFINES + ["TESTING"],
    toolchains = [":install_dirs"],
    visibility = ["//:__subpackages__"],
    deps = [":gnulib"] + WGET_OPTIONAL_DEPS,
)
