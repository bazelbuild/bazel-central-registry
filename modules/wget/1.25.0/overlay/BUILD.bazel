"""GNU Wget - https://www.gnu.org/software/wget/"""

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc_autoconf//autoconf:autoconf.bzl", "autoconf")
load("@rules_cc_autoconf//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
load("@rules_cc_autoconf//autoconf:autoconf_linkopts.bzl", "autoconf_linkopts")
load("@rules_cc_autoconf//autoconf:autoconf_srcs.bzl", "autoconf_srcs")
load("@rules_cc_autoconf//autoconf:checks.bzl", "checks", "macros")
load("@rules_cc_autoconf//autoconf:package_info.bzl", "package_info")
load("@rules_cc_autoconf//gnulib:conditional_hdrs.bzl", "cc_gnulib_conditional_hdrs")
load(":install_dirs.bzl", "install_dirs")

# AC_INIT (configure.ac:38).  The version comes from `.tarball-version`, and a
# plain (non-"GNU ") package name leaves PACKAGE_URL empty.
package_info(
    name = "package",
    package_name = "wget",
    package_bugreport = "bug-wget@gnu.org",
    package_tarname = "wget",
    package_url = "",
    package_version = "1.25.0",
)

# ---------------------------------------------------------------------------
# Build settings
#
# Each `--with-*` / `--enable-*` from configure.ac whose dependency the
# registry can satisfy is a flag here, with upstream's default.  The rest are
# fixed at "not found", which is the branch configure takes when the library is
# absent, and are listed so the omission is deliberate rather than an oversight:
#
#   --with-ssl=gnutls           no gnutls module; see `:ssl`.
#   --with-libpsl, --with-metalink (and its gpgme), --enable-libproxy,
#   --enable-pcre (PCRE1), nettle for NTLM without OpenSSL
#                               no module in the registry.
#   --enable-iri                needs libidn2 (configure.ac:795), which the
#                               registry lacks, so IRI/IDN support is off and
#                               src/iri.c is not compiled; `--iri` and
#                               `--local-encoding` are therefore unavailable.
#   --enable-fuzzing, --enable-fsanitize-*, --enable-valgrind-tests,
#   --enable-manywarnings       developer/instrumentation switches with Bazel
#                               equivalents (`--features=asan`, ...).
#   --disable-nls               gettext is probed like upstream (gnulib
#                               `gettext`), and libintl is never linked, so
#                               ENABLE_NLS only lands where gettext() is in
#                               libc.
# ---------------------------------------------------------------------------

# --with-ssl (configure.ac:78).  Upstream defaults to gnutls, which is not in
# the registry, so openssl is the default here; "no" matches upstream's
# spelling for a build without TLS.
SSL_BACKENDS = [
    "openssl",
    "no",
]

string_flag(
    name = "ssl",
    build_setting_default = "openssl",
    values = SSL_BACKENDS,
    visibility = ["//visibility:public"],
)

# Public so that the test module under testenv/ can select on them too.
[
    config_setting(
        name = "_ssl_" + backend,
        flag_values = {":ssl": backend},
        visibility = ["//visibility:public"],
    )
    for backend in SSL_BACKENDS
]

# --with-zlib (configure.ac:82), --with-cares (:90), --with-libuuid (:814),
# --enable-pcre2 (:851), --enable-opie (:166), --enable-digest (:178),
# --enable-ntlm (:190), --enable-debug (:198), --enable-assert (:233),
# --enable-ipv6 (:676), --enable-xattr (:975).  Defaults are upstream's;
# `libuuid` stands in for upstream's auto-detection of <uuid/uuid.h>, which
# finds util-linux's libuuid on the usual Linux hosts, and `ntlm` for
# `--enable-ntlm=auto`, which turns NTLM on whenever OpenSSL is in use.
OPTIONAL_FEATURES = {
    "assert": False,
    "cares": False,
    "debug": True,
    "digest": True,
    "ipv6": True,
    "libuuid": True,
    "ntlm": True,
    "opie": True,
    "pcre2": True,
    "xattr": True,
    "zlib": True,
}

[
    bool_flag(
        name = feature,
        build_setting_default = default,
        visibility = ["//visibility:public"],
    )
    for feature, default in OPTIONAL_FEATURES.items()
]

[
    config_setting(
        name = "_with_" + feature,
        flag_values = {":" + feature: "True"},
        visibility = ["//visibility:public"],
    )
    for feature in OPTIONAL_FEATURES
]

# NTLM needs OpenSSL's DES/MD4 (configure.ac:629); without it upstream would
# fall back to nettle, which the registry does not have.
selects.config_setting_group(
    name = "_ntlm",
    match_all = [
        ":_with_ntlm",
        ":_ssl_openssl",
    ],
)

# --enable-xattr only ever probes on Linux, macOS and FreeBSD (configure.ac:980)
# and disables itself everywhere else.
selects.config_setting_group(
    name = "_xattr_fsetxattr",
    match_all = [
        ":_with_xattr",
        ":_os_linux_or_macos",
    ],
)

selects.config_setting_group(
    name = "_os_linux_or_macos",
    match_any = [
        "@platforms//os:linux",
        "@platforms//os:macos",
    ],
)

selects.config_setting_group(
    name = "_xattr_extattr",
    match_all = [
        ":_with_xattr",
        "@platforms//os:freebsd",
    ],
)

selects.config_setting_group(
    name = "_xattr_probed",
    match_any = [
        ":_xattr_fsetxattr",
        ":_xattr_extattr",
    ],
)

# The two install-layout paths compiled into the program (src/Makefile.am:35).
# Defaults are the autoconf defaults for `--prefix=/usr/local`.
string_flag(
    name = "sysconfdir",
    build_setting_default = "/usr/local/etc",
    visibility = ["//visibility:public"],
)

string_flag(
    name = "localedir",
    build_setting_default = "/usr/local/share/locale",
    visibility = ["//visibility:public"],
)

install_dirs(
    name = "install_dirs",
    settings = {
        ":localedir": "LOCALEDIR",
        ":sysconfdir": "SYSCONFDIR",
    },
    visibility = ["//:__subpackages__"],
)

# ---------------------------------------------------------------------------
# Compiler flags
# ---------------------------------------------------------------------------

# configure.ac:282 adds `-O2 -Wall -Wextra` and wget_MANYWARNINGS adds more;
# those are for upstream's own CI and are replaced by `-w`, as is usual for
# registry modules.  Wget is C99 but its gnulib is C11.  clang-cl takes the
# MSVC spellings, so it is named alongside msvc-cl.
_MSVC_COPTS = [
    "/w",
    "/std:c11",
]

_GNU_COPTS = [
    "-w",
    "-std=gnu11",
]

COPTS = select({
    "@rules_cc//cc/compiler:clang-cl": _MSVC_COPTS,
    "@rules_cc//cc/compiler:msvc-cl": _MSVC_COPTS,
    "//conditions:default": _GNU_COPTS,
})

LOCAL_DEFINES = [
    "HAVE_CONFIG_H",
] + select({
    # --enable-assert (configure.ac:239): NDEBUG unless assertions are wanted.
    ":_with_assert": [],
    "//conditions:default": ["NDEBUG"],
})

