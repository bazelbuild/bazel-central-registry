load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_package_metadata = [":package_metadata"])

# GLM is dual-licensed under the Happy Bunny License or the MIT License; this
# declares the MIT License.
license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:MIT",
    text = "glm/copying.txt",
    visibility = ["//visibility:public"],
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

exports_files(["glm/copying.txt"])

cc_library(
    name = "glm",
    srcs = glob([
        "glm/glm/detail/*.hpp",
        "glm/glm/**/*.inl",
    ]),
    hdrs = glob([
        "glm/glm/*.hpp",
        "glm/glm/ext/*.hpp",
        "glm/glm/gtc/*.hpp",
        "glm/glm/gtx/*.hpp",
        "glm/glm/simd/*.h",
    ]),
    includes = ["glm"],
    visibility = ["//visibility:public"],
)
