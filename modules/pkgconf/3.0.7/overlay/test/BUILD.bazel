# Runs the pkgconf binary against a sample .pc file: version, modversion,
# flags, and a package that must not exist. Building this target is the test.
genrule(
    name = "smoke",
    srcs = ["sample.pc"],
    outs = ["smoke.txt"],
    cmd = """
set -e
pkgconf=$(execpath @pkgconf//:pkgconf)
export PKG_CONFIG_PATH=$$(dirname $(execpath sample.pc))
$$pkgconf --version > $@
$$pkgconf --modversion sample >> $@
$$pkgconf --cflags --libs sample >> $@
if $$pkgconf --exists no-such-package; then echo "--exists succeeded for a missing package" >&2; exit 1; fi
grep -q '^1\\.2\\.3$$' $@
grep -q -- '-I/opt/sample/include' $@
grep -q -- '-lsample' $@
""",
    tools = ["@pkgconf"],
)
