load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//licenses/rules:license_kind.bzl", "license_kind")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_package_metadata = [":package_metadata"])

license_kind(
    name = "license_kind",
    full_name = "Apache License 2.0 or MIT License",
    identifier = "Apache-2.0 OR MIT",
)

license(
    name = "license",
    kind = ":license_kind",
    text = "LICENSE",
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

# GCC/Clang -pthread defines _REENTRANT when compiling and links libpthread.
# copts cover this library; linkopts are what dependents inherit at link time.
cc_library(
    name = "simdjson",
    srcs = ["singleheader/simdjson.cpp"],
    hdrs = ["singleheader/simdjson.h"],
    copts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-pthread"],
    }),
    defines = ["SIMDJSON_THREADS_ENABLED=1"],
    includes = ["singleheader"],
    linkopts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-pthread"],
    }),
    visibility = ["//visibility:public"],
)
