"""rules_cocotb"""

module(
    name = "rules_cocotb",
    version = "0.6.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_verilog", version = "1.4.3")
bazel_dep(name = "rules_vhdl", version = "0.4.1")
bazel_dep(name = "verilator", version = "5.046.bcr.3")
bazel_dep(name = "rules_verilator", version = "1.1.1")
bazel_dep(name = "ghdl", version = "6.0.0.bcr.2")
bazel_dep(name = "iverilog", version = "13.0.bcr.1")
bazel_dep(name = "nvc", version = "1.21.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_python", version = "1.7.0")
bazel_dep(name = "rules_venv", version = "0.23.0")
bazel_dep(name = "rules_cc", version = "0.2.4")
bazel_dep(name = "rules_rust", version = "0.74.0")
bazel_dep(name = "rules_verible", version = "0.4.2")

bazel_dep(name = "rules_req_compile", version = "1.1.0", dev_dependency = True)
bazel_dep(name = "rules_rust_mdbook", version = "0.74.0", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.7.1", dev_dependency = True)
bazel_dep(name = "stardoc", version = "0.8.0", dev_dependency = True, repo_name = "io_bazel_stardoc")

# Module extension that materializes a synthetic external HDL repo used
# by `//tests/stubgen` to prove `cocotb_stubgen`'s aspect crosses Bazel
# module boundaries and handles HDL sources that only exist post-fetch.
ext_hdl = use_extension(
    "//tests/stubgen:ext_hdl_extension.bzl",
    "ext_hdl",
    dev_dependency = True,
)
use_repo(ext_hdl, "cocotb_stubgen_ext_hdl")

register_toolchains(
    "//cocotb/toolchain",
    dev_dependency = True,
)

# Third-party crates for `//tools/stubgen`, the Rust stub generator that
# `cocotb_toolchain.stubgen` defaults to. Not a dev dependency: a consumer
# using `cocotb_stubgen` resolves that default and so needs this repo. No
# `rust.toolchain()` call is needed -- `rules_rust` registers
# `@rust_toolchains//:all` from its own `MODULE.bazel`.
crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "cocotb_stubgen_crates",
    # Both lock files are checked in so the render is reproducible and no
    # build ever needs to repin. `cargo_lockfile` is not optional: without it
    # the generator is handed a `None` path on any non-repinning build.
    # Regenerate both with
    # `CARGO_BAZEL_REPIN=1 bazel build //tools/stubgen`.
    cargo_lockfile = "//tools/stubgen:Cargo.lock",
    lockfile = "//tools/stubgen:Cargo.Bazel.lock",
    manifests = ["//tools/stubgen:Cargo.toml"],
)
use_repo(crate, "cocotb_stubgen_crates")

requirements = use_extension("@rules_req_compile//extensions:python.bzl", "requirements", dev_dependency = True)
requirements.parse(
    name = "cocotb_pip_deps",
    requirements_locks = {
        "//tools/requirements:requirements_linux_x86_64.txt": "//tools/constraints:linux-x86_64",
        "//tools/requirements:requirements_macos_aarch64.txt": "//tools/constraints:macos-aarch64",
        "//tools/requirements:requirements_windows_x86_64.txt": "//tools/constraints:windows-x86_64",
    },
)
use_repo(requirements, "cocotb_pip_deps")

register_toolchains(
    "//tools/toolchains:black_toolchain",
    "//tools/toolchains:isort_toolchain",
    "//tools/toolchains:mypy_toolchain",
    "//tools/toolchains:pylint_toolchain",
    "//tools/toolchains:pytest_toolchain",
    dev_dependency = True,
)
