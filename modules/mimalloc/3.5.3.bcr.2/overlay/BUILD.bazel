# Windows builds that link the C runtime statically (/MT). The dynamic override
# only works with the C runtime DLL, so these override malloc/free statically,
# like other platforms do.
config_setting(
    name = "is_windows_clang_cl_static_crt",
    constraint_values = ["@platforms//os:windows"],
    flag_values = {"@rules_cc//cc/compiler:compiler": "clang-cl"},
    values = {"features": "static_link_msvcrt"},
)

config_setting(
    name = "is_windows_msvc_static_crt",
    constraint_values = ["@platforms//os:windows"],
    flag_values = {"@rules_cc//cc/compiler:compiler": "msvc-cl"},
    values = {"features": "static_link_msvcrt"},
)

# Override malloc/free with mimalloc either for an individual target:
#
#   cc_binary(
#       name = "my_binary",
#       ...
#       malloc = "@mimalloc",
#   )
#
#  or globally via a command-line flag:
#
#   --custom_malloc=@mimalloc
#
# DO NOT depend on this target directly.
alias(
    name = "mimalloc",
    actual = select({
        ":is_windows_clang_cl_static_crt": ":mimalloc-static",
        ":is_windows_msvc_static_crt": ":mimalloc-static",
        "@platforms//os:windows": ":mimalloc-dynamic",
        "//conditions:default": ":mimalloc-static",
    }),
    visibility = ["//visibility:public"],
)

# Additionally depend on this target to get access to the mimalloc.h API.
cc_library(
    name = "mimalloc-api",
    hdrs = ["include/mimalloc.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
)

# Additionally depend on this target to get access to the mimalloc-stats.h API.
cc_library(
    name = "mimalloc-stats",
    hdrs = ["include/mimalloc-stats.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [":mimalloc-api"],
)

# Additionally depend on this target to get access to the mimalloc-profile.h API.
cc_library(
    name = "mimalloc-profile",
    hdrs = ["include/mimalloc-profile.h"],
    includes = ["include"],
    visibility = ["//visibility:public"],
    deps = [":mimalloc-api"],
)

# TODO: Also expose overriding new/delete via an additional target.

cc_library(
    name = "mimalloc-static",
    implementation_deps = [":mimalloc-lib"],
    # Resolve malloc to mimalloc before the static C runtime's definition, like
    # LLVM_INTEGRATED_CRT_ALLOC does.
    linkopts = select({
        ":is_windows_clang_cl_static_crt": ["/INCLUDE:malloc"],
        ":is_windows_msvc_static_crt": ["/INCLUDE:malloc"],
        "//conditions:default": [],
    }),
    tags = ["__DONT_DEPEND_ON_DEF_PARSER__"],
)

cc_library(
    name = "mimalloc-dynamic",
    linkopts = select({
        ":is_windows_clang_mingw": [
            "-Wl,-u,mi_version",
        ],
        ":is_windows_clang_cl": [
            "/INCLUDE:mi_version",
        ],
        ":is_windows_msvc": [
            "/INCLUDE:mi_version",
        ],
        "//conditions:default": [],
    }),
    tags = ["__DONT_DEPEND_ON_DEF_PARSER__"],
    deps = [
        ":mimalloc-override-import",
    ],
)

cc_import(
    name = "mimalloc-override-import",
    interface_library = ":mimalloc-override-interface",
    shared_library = ":mimalloc-override",
    deps = select({
        ":windows_redirect": [":mimalloc-redirect"],
        "//conditions:default": [],
    }),
)

# Keep the static CRT's no-redirect dependency path independent of the flag.
cc_library(name = "mimalloc-no-redirect")

alias(
    name = "mimalloc-redirect-choice",
    actual = select({
        ":windows_redirect": ":mimalloc-redirect",
        "//conditions:default": ":mimalloc-no-redirect",
    }),
)

filegroup(
    name = "mimalloc-override-interface",
    srcs = [":mimalloc-override"],
    output_group = "interface_library",
)

cc_shared_library(
    name = "mimalloc-override",
    deps = [":mimalloc-lib"],
)

# TODO: Find a way to expose mimalloc as a regular dep for cases in which overriding malloc/free
# is not needed. This dep should be safe to use alongside --custom_malloc=@mimalloc, which is
# challenging: We can't just split this target into one that provides all mi_* functions and one
# that provides the overrides as the alias feature of gcc requires both to be in the same
# translation unit.
cc_library(
    name = "mimalloc-lib",
    srcs = [
        # keep sorted
        "include/mimalloc.h",
        "include/mimalloc/atomic.h",
        "include/mimalloc/bits.h",
        "include/mimalloc/internal.h",
        "include/mimalloc/prim.h",
        "include/mimalloc/prim-tls.h",
        "include/mimalloc/track.h",
        "include/mimalloc/types.h",
        "src/alloc.c",
        "src/alloc-aligned.c",
        "src/alloc-posix.c",
        "src/arena.c",
        "src/bitmap.c",
        "src/bitmap.h",
        "src/heap.c",
        "src/init.c",
        "src/libc.c",
        "src/options.c",
        "src/os.c",
        "src/page.c",
        "src/page-map.c",
        "src/prim/prim.c",
        "src/prim/prim-tls.c",
        "src/random.c",
        "src/sample-guarded.c",
        "src/sample-profile.c",
        "src/stats.c",
        "src/subproc.c",
        "src/theap.c",
        "src/threadlocal.c",
    ] + select({
        ":macos_zone": [
            "src/prim/osx/alloc-override-zone.c",
        ],
        "//conditions:default": [],
    }),
    includes = ["include"],
    linkopts = select({
        "@platforms//os:linux": [
            "-lpthread",
            "-lrt",
        ],
        ":is_windows_clang_mingw": [
            "-lpsapi",
            "-lshell32",
            "-luser32",
            "-ladvapi32",
            "-lbcrypt",
        ],
        ":is_windows_clang_cl": [
            "psapi.lib",
            "shell32.lib",
            "user32.lib",
            "advapi32.lib",
            "bcrypt.lib",
        ],
        ":is_windows_msvc": [
            "psapi.lib",
            "shell32.lib",
            "user32.lib",
            "advapi32.lib",
            "bcrypt.lib",
        ],
        "//conditions:default": [],
    }),
    linkstatic = True,
    local_defines = [
        "MI_MALLOC_OVERRIDE",
    ] + select({
        ":is_windows_clang_cl_static_crt": ["MI_STATIC_LIB"],
        ":is_windows_msvc_static_crt": ["MI_STATIC_LIB"],
        "@platforms//os:windows": [
            "MI_SHARED_LIB",
            "MI_SHARED_LIB_EXPORT",
        ],
        "@platforms//os:macos": [
            "MI_STATIC_LIB",
            "MI_OSX_INTERPOSE=1",
        ],
        "//conditions:default": [
            "MI_STATIC_LIB",
        ],
    }) + select({
        ":secure_on": ["MI_SECURE=4"],
        ":secure_full": ["MI_SECURE=5"],
        "//conditions:default": [],
    }) + select({
        ":debug_off": ["NDEBUG=1"],
        ":debug_on": ["MI_DEBUG=1"],
        ":debug_internal": ["MI_DEBUG=2"],
        ":debug_full": ["MI_DEBUG=3"],
        "//conditions:default": [],
    }) + select({
        ":guarded_off": ["MI_GUARDED=0"],
        ":guarded_on": ["MI_GUARDED=1"],
        ":guarded_full": ["MI_GUARDED=2"],
        ":guarded_auto_debug": ["MI_GUARDED=2"],
        "//conditions:default": [],
    }) + select({
        ":stats_off": ["MI_STATS=0"],
        ":stats_on": ["MI_STATS=1"],
        ":stats_full": ["MI_STATS=2"],
        ":stats_auto_debug": ["MI_STATS=2"],
        "//conditions:default": [],
    }) + select({
        ":profile_off": ["MI_PROFILE=0"],
        ":profile_on": ["MI_PROFILE=1"],
        ":profile_full": ["MI_PROFILE=2"],
        ":profile_auto_debug": ["MI_PROFILE=2"],
        "//conditions:default": [],
    }) + select({
        ":free_is_checked_on": ["MI_FREE_IS_CHECKED=1"],
        ":free_checked_auto_secure": ["MI_FREE_IS_CHECKED=1"],
        "//conditions:default": [],
    }) + select({
        ":padding_off": ["MI_PADDING=0"],
        ":padding_on": ["MI_PADDING=1"],
        "//conditions:default": [],
    }) + select({
        ":xmalloc_enabled": ["MI_XMALLOC=1"],
        "//conditions:default": [],
    }) + select({
        ":show_errors_enabled": ["MI_SHOW_ERRORS=1"],
        "//conditions:default": [],
    }) + select({
        ":skip_collect_on_exit_enabled": ["MI_SKIP_COLLECT_ON_EXIT=1"],
        "//conditions:default": [],
    }) + select({
        ":linux_thp_default": ["MI_DEFAULT_ALLOW_THP=2"],
        ":android_thp_default": ["MI_DEFAULT_ALLOW_THP=0"],
        ":linux_thp_off": ["MI_DEFAULT_ALLOW_THP=0"],
        ":android_thp_off": ["MI_DEFAULT_ALLOW_THP=0"],
        ":linux_thp_on": ["MI_DEFAULT_ALLOW_THP=1"],
        ":android_thp_on": ["MI_DEFAULT_ALLOW_THP=1"],
        ":linux_thp_full": ["MI_DEFAULT_ALLOW_THP=2"],
        ":android_thp_full": ["MI_DEFAULT_ALLOW_THP=2"],
        "//conditions:default": [],
    }) + select({
        ":macos_zone": ["MI_OSX_ZONE=1"],
        "//conditions:default": [],
    }) + select({
        ":windows_no_redirect": ["MI_WIN_NOREDIRECT=1"],
        "//conditions:default": [],
    }),
    tags = ["__DONT_DEPEND_ON_DEF_PARSER__"],
    textual_hdrs = [
        # keep sorted
        "src/alloc-override.c",
        "src/free.c",
        "src/page-queue.c",
        "src/prim/emscripten/prim.c",
        "src/prim/osx/prim.c",
        "src/prim/prim.c",
        "src/prim/unix/prim.c",
        "src/prim/wasi/prim.c",
        "src/prim/windows/etw.h",
        "src/prim/windows/prim.c",
    ],
    deps = [
        ":mimalloc-profile",
        ":mimalloc-stats",
    ] + select({
        ":is_windows_clang_cl_static_crt": [],
        ":is_windows_msvc_static_crt": [],
        "@platforms//os:windows": [":mimalloc-redirect-choice"],
        "//conditions:default": [],
    }),
    alwayslink = True,
)

cc_import(
    name = "mimalloc-redirect",
    interface_library = select({
        "@platforms//cpu:x86_64": "bin/mimalloc-redirect.lib",
        "@platforms//cpu:arm64": "bin/mimalloc-redirect-arm64.lib",
        "@platforms//cpu:x86_32": "bin/mimalloc-redirect32.lib",
    }),
    shared_library = select({
        "@platforms//cpu:x86_64": "bin/mimalloc-redirect.dll",
        "@platforms//cpu:arm64": "bin/mimalloc-redirect-arm64.dll",
        "@platforms//cpu:x86_32": "bin/mimalloc-redirect32.dll",
    }),
)
