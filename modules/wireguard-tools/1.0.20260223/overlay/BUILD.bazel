load("@rules_cc//cc:cc_binary.bzl", "cc_binary")

exports_files(["src/wg-quick/linux.bash"])

cc_binary(
    name = "wg",
    srcs = glob([
        "src/*.c",
        "src/*.h",
        "src/uapi/linux/linux/*.h",
    ]),
    copts = ["-std=gnu99"],
    includes = ["src/uapi/linux"],
    local_defines = [
        "_GNU_SOURCE",
        'RUNSTATEDIR=\\"/var/run\\"',
    ],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)
