load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE"])

# gguflib uses assert() to reject malformed tensor headers, so keep the asserts
# live even in optimized builds (matches the upstream MLX CMake setup).
_COPTS = select({
    "@rules_cc//cc/compiler:msvc-cl": [],
    "//conditions:default": ["-UNDEBUG"],
})

cc_library(
    name = "gguflib",
    srcs = [
        "fp16.c",
        "gguflib.c",
    ],
    hdrs = [
        "bf16.h",
        "fp16.h",
        "gguflib.h",
    ],
    copts = _COPTS,
    includes = ["."],
    linkopts = select({
        "@platforms//os:linux": ["-lm"],
        "//conditions:default": [],
    }),
)

cc_binary(
    name = "gguf-tools",
    srcs = [
        "gguf-tools.c",
        "sds.c",
        "sds.h",
        "sdsalloc.h",
    ],
    copts = _COPTS,
    deps = [":gguflib"],
)
