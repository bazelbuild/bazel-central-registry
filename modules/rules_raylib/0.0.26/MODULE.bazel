module(
    name = "rules_raylib",
    version = "0.0.26",
)

# What the module itself needs: rules_cc for the cc_import that wraps the
# prebuilt raylib, rules_shell for the installer and the test under
# //third_party/deps. raylib comes in through the `raylib` extension below,
# as a prebuilt static library.
bazel_dep(name = "rules_cc", version = "0.2.20")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "platforms", version = "1.1.0")

local = use_extension(":extensions.bzl", "raylib")
use_repo(local, "raylib_src")

# Nothing under //... uses the rest; the example programs in integration/
# do, and that module declares its own. A dependency marked dev_dependency
# does not reach a consumer, so a consumer resolves only what it uses.
bazel_dep(name = "googletest", version = "1.17.0.bcr.2", dev_dependency = True, repo_name = "gtest")
# This is a lie, this bazel dep is not hermetic.
bazel_dep(name = "glfw", version = "3.4.0.bcr.3", dev_dependency = True)
# This is a lie too.
bazel_dep(name = "glew", version = "2.3.1", dev_dependency = True)
bazel_dep(name = "glm", version = "1.0.3", dev_dependency = True)
bazel_dep(name = "bazel_skylib", version = "1.9.0", dev_dependency = True)
bazel_dep(name = "protobuf", version = "35.1", dev_dependency = True)

# The C++ toolchain this repository builds with. Which toolchain to use is
# the root module's decision: a consumer registers its own, as integration/
# does, and a registration here would reach every consumer whether it wanted
# one or not. dev_dependency keeps it here.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.1.0", dev_dependency = True)

toolchains = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
    dev_dependency = True,
)
use_repo(toolchains, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain/...",
    "@zig_sdk//libc_aware/toolchain/...",
    dev_dependency = True,
)
