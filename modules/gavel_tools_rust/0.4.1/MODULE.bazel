"""Clippy aspect for consumers building Rust with rules_rust.

Imposes nothing beyond rules_rust (minimum version; the consumer's own wins): the
Clippy logic is the ruleset-agnostic factory in gavel_tools, bound here to
rules_rust's upstream Clippy aspect. Consumers on rules_rs use gavel_tools_rust_rs.
"""

module(
    name = "gavel_tools_rust",
    version = "0.4.1",
    bazel_compatibility = [">=9.0.0"],
    compatibility_level = 1,
)

# Overrides only take effect when this is the root module (dev / CI here); for
# consumers they are ignored and the registry version of gavel_tools is used.
bazel_dep(name = "gavel_tools", version = "0.4.1")
local_path_override(
    module_name = "gavel_tools",
    path = "../..",
)

bazel_dep(name = "rules_rust", version = "0.70.0")
