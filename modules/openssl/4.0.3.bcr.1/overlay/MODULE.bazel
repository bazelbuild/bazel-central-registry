"""https://github.com/openssl/openssl"""

module(
    name = "openssl",
    version = "4.0.3.bcr.1",
    bazel_compatibility = [">=7.2.1"],
    compatibility_level = 3030100,
)

bazel_dep(name = "bazel_skylib", version = "1.7.1")
bazel_dep(name = "package_metadata", version = "0.0.13")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_perl", version = "2.0.0")

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

# Pre-generated headers, sources and assembly, used unless
# --@openssl//:use-pregenerated=False. Published as a release asset of
# https://github.com/raccoons-build/bazel-openssl-cc under the same tag.
http_archive(
    name = "openssl_pregen",
    integrity = "sha256-LuWqholw9Ozj02JdNMwJRShMMbMW8IjwzoNtGEVZE+s=",
    strip_prefix = "pregen",
    urls = [
        "https://github.com/raccoons-build/bazel-openssl-cc/releases/download/4.0.3.bcr.1/bazel-openssl-cc-4.0.3.bcr.1.tar.gz",
    ],
)
