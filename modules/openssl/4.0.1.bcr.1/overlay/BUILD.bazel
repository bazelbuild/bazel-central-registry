# --- Platform-independent generated files via Perl (fallback path) ---
# Tagged "manual" so `bazel build //...` does not build these standalone;
# they are still built when referenced through the routing aliases.
# Without this, Windows (which lacks action sandboxing) sees these genrule
# outputs in the output tree and flags them as undeclared inclusions in
# the pregen path.
openssl_perl_genrule(
    name = "perl_generated_hdrs",
    mode = "hdrs",
    tags = ["manual"],
)

openssl_perl_genrule(
    name = "perl_generated_srcs",
    mode = "srcs",
    tags = ["manual"],
)

filegroup(
    name = "perl_generated_app_hdrs",
    srcs = [":perl_generated_hdrs"],
    output_group = "app",
    tags = ["manual"],
)

filegroup(
    name = "perl_generated_app_srcs",
    srcs = [":perl_generated_srcs"],
    output_group = "app",
    tags = ["manual"],
)

# --- Assembly generation ---

# Every perlasm output any supported platform uses, each with a perl_binary
# built for the execution platform. The scripts locate their helpers relative
# to their own path, so those helpers ride along as data.
_PERLASM = {
    out: entry
    for perlasm in [
        _ANDROID_ARM64_PERLASM_ENTRIES,
        _ANDROID_X86_64_PERLASM_ENTRIES,
        _DARWIN_ARM64_PERLASM_ENTRIES,
        _DARWIN_X86_64_PERLASM_ENTRIES,
        _FREEBSD_AARCH64_PERLASM_ENTRIES,
        _FREEBSD_X86_64_PERLASM_ENTRIES,
        _IOS_ARM64_PERLASM_ENTRIES,
        _LINUX_AARCH64_PERLASM_ENTRIES,
        _LINUX_ARM_PERLASM_ENTRIES,
        _LINUX_PPC64LE_PERLASM_ENTRIES,
        _LINUX_RISCV64_PERLASM_ENTRIES,
        _LINUX_S390X_PERLASM_ENTRIES,
        _LINUX_X86_64_PERLASM_ENTRIES,
        _WINDOWS_ARM64_PERLASM_ENTRIES,
        _WINDOWS_X64_PERLASM_ENTRIES,
    ]
    for out, entry in perlasm.items()
}

openssl_perlasm_scripts(
    name = "perlasm_scripts",
    data = glob(["crypto/perlasm/*.pl"]) + [
        "crypto/ec/ecp_nistz256_table.c",
        "ms/applink.c",
        "ms/uplink-common.pl",
    ],
    perlasm = _PERLASM,
    tags = ["manual"],
)

openssl_perlasm(
    name = "perlasm_genfiles",
    # The perlasm scheme upstream's Configure passes for the matching target.
    # On Windows, cl.exe and clang-cl assemble through ml64 (MASM syntax,
    # MSVC-flavoured arm64), mingw and clang through gas.
    assembly_flavor = select({
        "//configs:android_arm64": "linux64",
        "//configs:android_x86_64": "elf",
        "//configs:darwin_arm64": "ios64",
        "//configs:darwin_x86_64": "macosx",
        "//configs:freebsd_aarch64": "linux64",
        "//configs:freebsd_x86_64": "elf",
        "//configs:ios_arm64": "ios64",
        "//configs:linux_aarch64": "linux64",
        "//configs:linux_arm": "linux32",
        "//configs:linux_ppc64le": "linux64le",
        "//configs:linux_riscv64": "linux64",
        "//configs:linux_s390x": "64",
        "//configs:linux_x86_64": "elf",
        "//configs:windows_arm64_clang": "linux64",
        "//configs:windows_arm64_clang_cl": "win64",
        "//configs:windows_arm64_mingw": "linux64",
        "//configs:windows_arm64_msvc": "win64",
        "//configs:windows_x64_clang": "mingw64",
        "//configs:windows_x64_clang_cl": "masm",
        "//configs:windows_x64_mingw": "mingw64",
        "//configs:windows_x64_msvc": "masm",
        "//conditions:default": "",
    }),
    script_args = openssl_perlasm_args(_PERLASM),
    scripts = select({
        "//configs:android_arm64": openssl_perlasm_tools(_ANDROID_ARM64_PERLASM_ENTRIES),
        "//configs:android_x86_64": openssl_perlasm_tools(_ANDROID_X86_64_PERLASM_ENTRIES),
        "//configs:darwin_arm64": openssl_perlasm_tools(_DARWIN_ARM64_PERLASM_ENTRIES),
        "//configs:darwin_x86_64": openssl_perlasm_tools(_DARWIN_X86_64_PERLASM_ENTRIES),
        "//configs:freebsd_aarch64": openssl_perlasm_tools(_FREEBSD_AARCH64_PERLASM_ENTRIES),
        "//configs:freebsd_x86_64": openssl_perlasm_tools(_FREEBSD_X86_64_PERLASM_ENTRIES),
        "//configs:ios_arm64": openssl_perlasm_tools(_IOS_ARM64_PERLASM_ENTRIES),
        "//configs:linux_aarch64": openssl_perlasm_tools(_LINUX_AARCH64_PERLASM_ENTRIES),
        "//configs:linux_arm": openssl_perlasm_tools(_LINUX_ARM_PERLASM_ENTRIES),
        "//configs:linux_ppc64le": openssl_perlasm_tools(_LINUX_PPC64LE_PERLASM_ENTRIES),
        "//configs:linux_riscv64": openssl_perlasm_tools(_LINUX_RISCV64_PERLASM_ENTRIES),
        "//configs:linux_s390x": openssl_perlasm_tools(_LINUX_S390X_PERLASM_ENTRIES),
        "//configs:linux_x86_64": openssl_perlasm_tools(_LINUX_X86_64_PERLASM_ENTRIES),
        "//configs:windows_arm64": openssl_perlasm_tools(_WINDOWS_ARM64_PERLASM_ENTRIES),
        "//configs:windows_x64": openssl_perlasm_tools(_WINDOWS_X64_PERLASM_ENTRIES),
        "//conditions:default": {},
    }),
    tags = ["manual"],
)

# --- Textual headers (files #included as C source) ---

# OpenSSL 3.x ships the CAPI engine, whose error table is #included as source
# on Windows. OpenSSL 4.x removed engines/ entirely, hence allow_empty.
_ENGINE_TEXTUAL_HDRS = glob(
    include = ["engines/e_capi_err.*"],
    allow_empty = True,
)

CRYPTO_TEXTUAL_HDRS = [
    "crypto/des/ncbc_enc.c",
] + glob(
    include = ["providers/implementations/**/*.c"],
) + select({
    # LPdir_win.c, LPdir_win32.c and, before 4.1, LPdir_wince.c.
    "@platforms//os:windows": glob(["crypto/LPdir_win*.c"]) + [
        "ms/applink.c",
        "ms/uplink.h",
    ] + _ENGINE_TEXTUAL_HDRS,
    "//conditions:default": ["crypto/LPdir_unix.c"],
})

# --- Compiler options ---

# Per-target defines such as L_ENDIAN / B_ENDIAN come from the generated
# constants (upstream's lib_cppflags); never hardcode them here.
# Consumers cannot silence warnings from this package's compile actions, so
# the ones OpenSSL's own MSVC build prints are disabled here. Upstream's VC
# configs pass /W3 /wd4090; the rest are known upstream false positives.
_MSVC_WARNING_COPTS = [
    # Different const qualifiers: upstream disables this too (Configurations/10-main.conf).
    "/wd4090",
    # Incompatible pointer types: the dead branch of the sizeof() ternaries in
    # include/internal/tsan_assist.h is still type-checked.
    "/wd4133",
    # Pointer truncation in ms/uplink.c.
    "/wd4311",
    # Zero-extending ~ in crypto/bn/bn_gcd.c.
    "/wd4319",
]

COMMON_OPENSSL_COPTS = [
    "-DOPENSSLDIR=\\\"/etc/ssl\\\"",
    '-DENGINESDIR=\\"/usr/lib/engines-3.0\\"',
    "-DMODULESDIR=\\\"/dev/null\\\"",
    "-DOPENSSL_USE_NODELETE",
] + select({
    "//configs:android_arm64": ["-mno-outline-atomics"],
    "//configs:freebsd_aarch64": ["-mno-outline-atomics"],
    "//configs:linux_aarch64": ["-mno-outline-atomics"],
    "//conditions:default": [],
}) + select({
    "//configs:windows_clang_cl": _MSVC_WARNING_COPTS,
    "//configs:windows_msvc": _MSVC_WARNING_COPTS,
    "@platforms//os:windows": [],
    "//conditions:default": [
        "-Wa,--noexecstack",
        "-Wno-unused-command-line-argument",
        "-fPIC",
    ],
})

# All Windows constants come from upstream's VC-WIN64A / VC-WIN64-CLANGASM-ARM
# targets, i.e. MSVC is assumed on Windows (mingw's own Configure target is
# not modelled); glibc is assumed on Linux. libc constraints could come from
# https://github.com/bazel-contrib/platforms_contrib/ in the future.
COMMON_DEFINES = select({
    "//configs:windows_non_msvc": [
        "SIO_UDP_NETRESET=0x9800001C",
    ],
    "//conditions:default": [],
})

# WIN32_LEAN_AND_MEAN is in upstream's Windows configs; it is openssl-internal
# and must not propagate to consumers via CcInfo. (It already keeps winsock.h
# out of windows.h, so _WINSOCKAPI_ is not defined as well: winsock2.h defines
# it itself, and a second definition is a C4005 warning in every file.)
COMMON_LOCAL_DEFINES = select({
    "@platforms//os:windows": ["WIN32_LEAN_AND_MEAN"],
    "//conditions:default": [],
})

# --- Include paths ---

# Directories where generated files and the sources using them meet by bare
# name, which only works when the directory is on the include path, because
# generated files live in the output tree rather than next to the source
# (OpenSSL's own out-of-tree builds add the same -I flags):
#   * dofile-generated sources include sibling headers (e.g. "ciphercommon_local.h");
#   * sources include sibling generated headers (e.g. "charmap.h").
# Generated sources that only include through include/ (the mkerr.pl error
# tables) do not need their directory; directories under include/ are covered
# by "include" itself.
_GENERATED_SRC_DIRS = sorted({
    path.rsplit("/", 1)[0]: None
    for path in list(DOFILE_SRC_TEMPLATES.values()) + [out for out in STDOUT_SCRIPTS if not out.endswith(".c")]
    if not path.startswith("include/")
})

# Headers at the source root: OpenSSL 3.0 keeps e_os.h there (3.1 moved it
# under include/internal), and apps/include/apps.h includes it by bare name.
_ROOT_HDRS = glob(
    ["*.h"],
    allow_empty = True,
)

# With root headers (OpenSSL 3.0's e_os.h), the root must be an include
# directory too: crypto/rand/rand_deprecated.c does #include <e_os.h>, which
# upstream serves with -I.
_BASE_INCLUDES = [
    "include",
    "providers/implementations/macs",
    "providers/implementations/include",
    "providers/common/include",
    "providers/fips/include",
    "crypto",
]

LIBCRYPTO_INCLUDES = (["."] if _ROOT_HDRS else []) + _BASE_INCLUDES + [
    d
    for d in _GENERATED_SRC_DIRS
    if d not in _BASE_INCLUDES
]

LIBCRYPTO_WINDOWS_INCLUDES = [
    "ms",
    "crypto/bn",
] + (["engines"] if _ENGINE_TEXTUAL_HDRS else [])

# crypt32 is pulled in by the CAPI engine (engines/e_capi.c); ws2_32/advapi32/
# user32 back sockets and registry/user APIs.
_WINDOWS_SYSTEM_LIBS_MSVC = [
    "-defaultlib:ws2_32.lib",
    "-defaultlib:advapi32.lib",
    "-defaultlib:user32.lib",
    "-defaultlib:crypt32.lib",
]

_WINDOWS_SYSTEM_LIBS_GNU = [
    "-lws2_32",
    "-ladvapi32",
    "-luser32",
    "-lcrypt32",
]

# --- libcrypto ---

# Everything under include/ and crypto/, as upstream's -I. -Iinclude -Icrypto
# serve them: the layout below those roots changes between versions (4.1 moved
# crypto/arm_arch.h to include/arch/arm_arch.h, for one).
COMMON_LIBCRYPTO_HDRS = _ROOT_HDRS + glob(
    include = [
        "crypto/**/*.h",
        "include/**/*.h",
        "providers/**/*.h",
        "providers/*.inc",
        "providers/implementations/**/*.inc",
    ],
) + glob(
    # Textually included fragments that are not .h, e.g.
    # include/internal/qlog_events.inc, crypto/ec/curve448/arch_64/*.inc (4.1+)
    # or riscv_arch.def.
    [
        "crypto/**/*.def",
        "crypto/**/*.inc",
        "include/**/*.def",
        "include/**/*.inc",
    ],
    allow_empty = True,
)

cc_library(
    name = "crypto",
    srcs = COMMON_CRYPTO_SRCS + select({
        # Perl perlasm fallback (all known platforms, noasm=False)
        "//configs:_asm_android_arm64": _ANDROID_ARM64_ASM_CRYPTO_EXTRA + [":perlasm_genfiles"],
        "//configs:_asm_android_x86_64": _ANDROID_X86_64_ASM_CRYPTO_EXTRA + [":perlasm_genfiles"],
        "//configs:_asm_darwin_arm64": _DARWIN_ARM64_ASM_CRYPTO_EXTRA + [":perlasm_genfiles"],
        "//configs:_asm_darwin_x86_64": _DARWIN_X86_64_ASM_CRYPTO_EXTRA + [":perlasm_genfiles"],
        "//configs:_asm_freebsd_aarch64": _FREEBSD_AARCH64_ASM_CRYPTO_EXTRA + [":perlasm_genfiles"],
        "//configs:_asm_freebsd_x86_64": _FREEBSD_X86_64_ASM_CRYPTO_EXTRA + [":perlasm_genfiles"],
        "//configs:_asm_ios_arm64": _IOS_ARM64_ASM_CRYPTO_EXTRA + [":perlasm_genfiles"],
        "//configs:_asm_linux_aarch64": _LINUX_AARCH64_ASM_CRYPTO_EXTRA + [":perlasm_genfiles"],
        "//configs:_asm_linux_arm": _LINUX_ARM_ASM_CRYPTO_EXTRA + [":perlasm_genfiles"],
        "//configs:_asm_linux_ppc64le": _LINUX_PPC64LE_ASM_CRYPTO_EXTRA + [":perlasm_genfiles"],
        "//configs:_asm_linux_riscv64": _LINUX_RISCV64_ASM_CRYPTO_EXTRA + [":perlasm_genfiles"],
        "//configs:_asm_linux_s390x": _LINUX_S390X_ASM_CRYPTO_EXTRA + [":perlasm_genfiles"],
        "//configs:_asm_linux_x86_64": _LINUX_X86_64_ASM_CRYPTO_EXTRA + [":perlasm_genfiles"],
        "//configs:_asm_windows_arm64": _WINDOWS_ARM64_ASM_CRYPTO_EXTRA + [":perlasm_genfiles"],
        "//configs:_asm_windows_x64": _WINDOWS_X64_ASM_CRYPTO_EXTRA + [":perlasm_genfiles"],
        # No-asm escape hatch (mutually exclusive with _asm_*/_pregen_asm_*)
        "//configs:_no_asm_fallback": NO_ASM_CRYPTO_EXTRA_SRCS,
        # Pre-generated assembly (most specialized). Linux groups assume glibc
        # and the Windows groups are MSVC flavoured; libc constraints could
        # come from https://github.com/bazel-contrib/platforms_contrib/ in
        # the future. mingw builds use --@openssl//:use-pregenerated=False.
        "//configs:_pregen_asm_android_arm64": _ANDROID_ARM64_ASM_CRYPTO_EXTRA + ["@openssl_pregen//:asm_linux64"],
        "//configs:_pregen_asm_android_x86_64": _ANDROID_X86_64_ASM_CRYPTO_EXTRA + ["@openssl_pregen//:asm_elf"],
