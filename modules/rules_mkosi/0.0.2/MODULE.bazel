"""Bazel rules for building OS images with mkosi."""

module(
    name = "rules_mkosi",
    # The checked-in lockfile is generated by the Bazel version in
    # .bazelversion, and the floor is the lowest version in
    # ci/bazel_versions.json. Bazel 9 compatibility is exercised with
    # lockfile mode off in CI without rewriting the lockfile.
    bazel_compatibility = [
        ">=8.8.2",
    ],
    version = "0.0.2",
)

# Runtime dependencies. These are minimum versions for module resolution.
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.27")
bazel_dep(name = "rules_python", version = "2.4.6")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "rules_qemu", version = "0.3.0")

# The static bootstrap executables build with its Linux x86-64 C/C++ toolchain for musl. 0.8.5 is the oldest version
# whose toolchain works with rules_cc 0.2.27.
bazel_dep(name = "llvm", version = "0.8.5")

# API reference generation and its drift check.
bazel_dep(name = "bazel_lib", version = "3.2.2", dev_dependency = True)
bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)

# bootstrap_binary adds //mkosi/toolchain/bootstrap_cc:all to --extra_toolchains for the bootstrap executables, so it
# needs no registration. This repository's own C and C++ targets build with the same LLVM C/C++ toolchain, for the
# static musl host platform that .bazelrc selects.
register_toolchains(
    "//mkosi/private:development_cc_toolchain",
    dev_dependency = True,
)

qemu = use_extension("@rules_qemu//qemu/extension:qemu.bzl", "qemu")
use_repo(
    qemu,
    "qemu_img_prebuilt_linux_amd64",
    "qemu_system_bin_prebuilt_linux_amd64_x86_64_softmmu",
    "qemu_system_data_prebuilt_linux_amd64",
    "qemu_system_toolchains",
    "qemu_user_toolchains",
)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.14")
python.toolchain(python_version = "3.14")
use_repo(python, "python_3_14", "pythons_hub", python = "python_versions")

# Package directories must declare their own __init__.py files.
rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

register_toolchains("@pythons_hub//:all")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "mkosi_pypi",
    python_version = "3.14",
    requirements_lock = "//:requirements_lock.txt",
)
use_repo(pip, "mkosi_pypi")

mkosi = use_extension("//mkosi:extensions.bzl", "mkosi")
mkosi.toolchain()
use_repo(mkosi, "mkosi_toolchains")

register_toolchains(
    "@mkosi_toolchains//:qemu_linux_x86_64",
    "@mkosi_toolchains//:all",
)

# Fetched only for qemu_ovmf_boot_test(secure_boot = True).
ovmf_secure_boot_repo = use_repo_rule("//mkosi/private:ovmf_secure_boot_repo.bzl", "ovmf_secure_boot_repo")

ovmf_secure_boot_repo(name = "mkosi_ovmf_secure_boot")

debian_tools = use_extension("//mkosi/debian:extensions.bzl", "debian_tools")
debian_tools.toolchain()
use_repo(
    debian_tools,
    "mkosi_debian_package_inputs",
    "mkosi_debian_python",
    "mkosi_debian_snapshot",
    "mkosi_debian_tools",
)

register_toolchains("@mkosi_debian_tools//:linux_x86_64")
