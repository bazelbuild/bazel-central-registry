load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

cc_library(
    name = "support",
    hdrs = [
        "KDTreeVectorOfVectorsAdaptor.h",
        "utils.h",
    ],
    deps = ["@nanoflann"],
)

# Non-GUI examples from upstream examples/CMakeLists.txt. examples_gui is omitted.
_EXAMPLES = [
    "dynamic_pointcloud_example",
    "pointcloud_example",
    "pointcloud_kdd_radius",
    "pointcloud_adaptor_example",
    "pointcloud_custom_metric",
    "pointcloud_custom_resultset",
    "pointcloud_incremental_example",
    "manifold_so2_example",
    "manifold_so3_example",
    "manifold_se3_example",
    "manifold_s2_example",
    "manifold_se3_incremental_example",
    "saveload_example",
    "vector_of_vectors_example",
]

[cc_binary(
    name = name,
    srcs = [name + ".cpp"],
    deps = [":support"],
) for name in _EXAMPLES]

cc_binary(
    name = "matrix_example",
    srcs = ["matrix_example.cpp"],
    deps = [
        ":support",
        "@eigen//:eigen",
    ],
)
