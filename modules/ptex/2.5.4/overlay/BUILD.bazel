load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

expand_template(
    name = "ptex_version",
    out = "src/ptex/PtexVersion.h",
    substitutions = {
        "@PTEX_MAJOR_VERSION@": "2",
        "@PTEX_MINOR_VERSION@": "5",
    },
    template = "src/ptex/PtexVersion.h.in",
)

cc_library(
    name = "ptex",
    srcs = glob(
        ["src/ptex/*.cpp"],
        exclude = ["src/ptex/PtexHalfTableGen.cpp"],
    ),
    hdrs = glob(["src/ptex/*.h"]) + ["src/ptex/PtexVersion.h"],
    defines = ["PTEX_STATIC"],
    includes = ["src/ptex"],
    linkopts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-pthread"],
    }),
    local_defines = select({
        "@platforms//os:windows": ["_CRT_SECURE_NO_WARNINGS"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        "@libdeflate",
        "@zlib",
    ],
)
