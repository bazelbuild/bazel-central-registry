]

# lib/getloadavg.c is a portable fallback — Windows doesn't have getloadavg.
W32_LIB_SRCS = [
    "lib/getloadavg.c",
]

# The glob/fnmatch copies under lib/, built wherever libc isn't glibc — see
# the `:lib_glob_h` comment above for the probe this mirrors.
#
# This isn't just about missing symbols: `src/dir.c` types the gl_opendir /
# gl_readdir hooks it hands to glob(3) as `__ptr_t`, a spelling this release
# never defines itself. On glibc it leaks in from <sys/cdefs.h>; everywhere
# else `lib/glob.in.h` is what supplies it, so a host that takes the system
# <glob.h> without being glibc doesn't compile at all.
BUNDLED_GLOB_SRCS = [
    "lib/fnmatch.c",
    "lib/glob.c",
    ":lib_fnmatch_h",
    ":lib_glob_h",
]

# ---------------------------------------------------------------------------
# Gnulib helpers (POSIX hosts)
# ---------------------------------------------------------------------------
#
# `src/job.c` calls `find_in_given_path` inside `#ifdef USE_POSIX_SPAWN`.
# Windows has no posix_spawn, and the gnulib headers lean on `<unistd.h>`
# that MSVC doesn't provide, so the whole library is pruned there.
#
# In this release `findprog-in.c` still allocates through gnulib's
# abort-on-failure `xalloc` wrappers (4.4 switched to the relicensed revision
# that returns NULL with errno set), so the modules behind them come along
# too:
#
#     findprog-in.c -> xmalloc.c -> xalloc-die.c -> error.c -> getprogname.c
#                                                     |            |
#                                                 exitfail.c  basename-lgpl.c
#
# These sit in their own `cc_library` purely so `local_defines` below stay
# off make's own translation units, which `configure` probes without them.
cc_library(
    name = "gnulib_posix",
    srcs = [
        "lib/basename-lgpl.c",
        "lib/concat-filename.c",
        "lib/error.c",
        "lib/exitfail.c",
        "lib/findprog-in.c",
        "lib/getprogname.c",
        "lib/xalloc-die.c",
        "lib/xconcat-filename.c",
        "lib/xmalloc.c",
        ":config_h",
    ],
    hdrs = [
        "lib/concat-filename.h",
        "lib/dirname.h",
        "lib/dosname.h",
        "lib/error.h",
        "lib/exitfail.h",
        "lib/filename.h",
        "lib/findprog.h",
        "lib/getprogname.h",
        "lib/gettext.h",
        "lib/xalloc.h",
        "lib/xalloc-oversized.h",
    ],
    # POSIX-only target, so the GCC dialect is the only one reachable here.
    copts = _GCC_STYLE_COPTS,
    # Order matters, and matches upstream's `AM_CPPFLAGS = -Isrc -I$(top_srcdir)/src
    # -Ilib -I$(top_srcdir)/lib`. This release ships a `gettext.h` in both
    # directories, and `src/makeint.h` reaches for it as `#include <gettext.h>`
    # — a bracket include, so only the search path decides. src-first is what
    # upstream resolves, and it keeps the lib/ copy an implementation detail of
    # the `lib/*.c` sources, which include it as `"gettext.h"` and so get their
    # own directory first regardless.
    includes = [
        # do not sort: alphabetical order puts lib/ first and flips the above.
        "src",
        "lib",
    ],
    local_defines = [
        "HAVE_CONFIG_H",
        # glibc only declares `program_invocation_short_name` — the source
        # `getprogname.c` prefers — under _GNU_SOURCE. `configure` turns this
        # on globally via AC_USE_SYSTEM_EXTENSIONS.
        "_GNU_SOURCE=1",
        # `error.c` decorates one static function with two attribute macros
        # that gnulib emits into the replacement `<stdio.h>` it generates from
        # `lib/stdio.in.h`, rather than into config.h (which does carry the
        # other `_GL_*` macros these sources use). They're pure decoration.
        "_GL_ARG_NONNULL(a)=",
        "_GL_ATTRIBUTE_FORMAT_PRINTF(a,b)=",
    ],
    target_compatible_with = _INCOMPATIBLE_WITH_WINDOWS,
)

# ---------------------------------------------------------------------------
# `make` binary
# ---------------------------------------------------------------------------

cc_binary(
    name = "make",
    srcs = MAKE_SRCS + MAKE_HDRS + LIB_HDRS + [
        ":config_h",
        ":gmk_default_h",
    ] + select({
        "@platforms//os:windows": W32_SRCS + W32_HDRS + W32_LIB_SRCS,
        "//conditions:default": ["src/posixos.c"],
    }) + select({
        # `@platforms//os:linux` stands in for "libc is glibc", which is the
        # answer upstream's probe reaches on every Linux this module is
        # tested against. A musl-based one wants the bundled copies too and
        # would just need another branch here.
        "@platforms//os:linux": [],
        "//conditions:default": BUNDLED_GLOB_SRCS,
    }),
    copts = _COPTS,
    features = _FEATURES,
    # src before lib, and w32/include appended last — see the `:gnulib_posix`
    # comment above and upstream's `AM_CPPFLAGS`, which grows the w32 entry
    # under `if WINDOWSENV` after the base four.
    includes = [
        # do not sort: alphabetical order puts lib/ first and flips the above.
        "src",
        "lib",
    ] + select({
        "@platforms//os:windows": ["src/w32/include"],
        "//conditions:default": [],
    }),
    # `src/load.c` (MAKE_LOAD) needs dlopen. On Linux/BSD that lives in libdl
    # and needs `-ldl`; macOS provides it via libSystem, and Windows uses
    # LoadLibrary (kernel32.lib is default-linked). The second select adds
    # advapi32/user32 for the w32 backend — see `_WIN32_*_LINKOPTS` above.
    linkopts = select({
        "@platforms//os:linux": ["-ldl"],
        "//conditions:default": [],
    }) + select({
        "@rules_cc//cc/compiler:clang-cl": _WIN32_MSVC_LINKOPTS,
        "@rules_cc//cc/compiler:mingw-gcc": _WIN32_MINGW_LINKOPTS,
        "@rules_cc//cc/compiler:msvc-cl": _WIN32_MSVC_LINKOPTS,
        "//conditions:default": [],
    }),
    local_defines = [
        "HAVE_CONFIG_H",
    ] + select({
        # `WINDOWS32` selects the w32 backend throughout the sources. Unlike
        # later releases, this one's `src/config.h.W32` doesn't define it —
        # upstream's `build_w32.bat` passes `/D WINDOWS32` on the command
        # line instead, so do the same here.
        #
        # LIBDIR/INCLUDEDIR are then supplied by the sources that read them
        # (`src/remake.c`, `src/read.c` both fall back to "." under
        # WINDOWS32), and config.h.W32 hardcodes LOCALEDIR.
        "@platforms//os:windows": [
            "WINDOWS32",
        ],
        "//conditions:default": [
            "LIBDIR=\\\"/usr/local/lib\\\"",
            "INCLUDEDIR=\\\"/usr/local/include\\\"",
            "LOCALEDIR=\\\"/usr/local/share/locale\\\"",
        ],
    }),
    visibility = ["//visibility:public"],
    deps = select({
        "@platforms//os:windows": [],
        "//conditions:default": [":gnulib_posix"],
    }),
)
