            checks.AC_SUBST("PKG_CONFIG", "pkg-config"),
        ] + macros.AC_CHECK_DECLS(
            [
                "sys_siglist",
                "_sys_siglist",
                "__sys_siglist",
            ],
            compile_defines = SYSTEM_EXTENSIONS + ["HAVE_UNISTD_H"],
            includes = [
                # do not sort
                "AC_INCLUDES_DEFAULT",
                "#include <signal.h>",
                "/* NetBSD declares sys_siglist in unistd.h.  */",
                "#if HAVE_UNISTD_H",
                "# include <unistd.h>",
                "#endif",
            ],
        ) + macros.AC_CHECK_HEADERS(
            ["sys/wait.h"],
            includes = ["#include <sys/types.h>"],
        ),
        visibility = ["//:__subpackages__"],
        deps = [
            "@rules_cc_autoconf//autoconf/macros/AC_CANONICAL_BUILD",
            "@rules_cc_autoconf//autoconf/macros/AC_CANONICAL_HOST",
            "@rules_cc_autoconf//autoconf/macros/AC_CHECK_INCLUDES_DEFAULT",
