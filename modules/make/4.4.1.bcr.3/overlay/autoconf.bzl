            "@rules_cc_autoconf//autoconf/macros/AC_USE_SYSTEM_EXTENSIONS",
            "@rules_cc_autoconf//gnulib/macros/HAVE_SYS_PARAM_H",
        ] + GNULIB_M4_DEPS,
    )

    autoconf(
        name = "autoconf",
        checks = [
            checks.AC_TRY_LINK(
                name = "make_cv_union_wait",
                code = utils.AC_LANG_PROGRAM(
                    [
                        "#include <sys/types.h>",
                        "#include <sys/wait.h>",
                    ],
                    [
                        "union wait status; int pid; pid = wait (&status);",
                        "#ifdef WEXITSTATUS",
                        "/* Some POSIXoid systems have both the new-style macros and the old",
                        "   union wait type, and they do not work together.  If union wait",
                        "   conflicts with WEXITSTATUS et al, we don't want to use it at all.  */",
                        "        if (WEXITSTATUS (status) != 0) pid = -1;",
                        "#ifdef WTERMSIG",
                        "        /* If we have WEXITSTATUS and WTERMSIG, just use them on ints.  */",
                        "        -- blow chunks here --",
                        "#endif",
                        "#endif",
                        "#ifdef HAVE_WAITPID",
                        "        /* Make sure union wait works with waitpid.  */",
                        "        pid = waitpid (-1, &status, 0);",
                        "#endif",
                    ],
                ),
                compile_defines = SYSTEM_EXTENSIONS + ["HAVE_WAITPID"],
            ),
            checks.AC_DEFINE(
                "HAVE_UNION_WAIT",
                1,
                requires = ["make_cv_union_wait"],
            ),
            checks.AC_TRY_COMPILE(
                name = "make_cv_sa_restart",
                code = utils.AC_LANG_PROGRAM(
                    ["#include <signal.h>"],
                    ["return SA_RESTART;"],
                ),
                compile_defines = SYSTEM_EXTENSIONS,
            ),
            checks.AC_DEFINE(
                "HAVE_SA_RESTART",
                1,
                requires = ["make_cv_sa_restart"],
            ),
        ] + macros.AC_CHECK_DECLS(
