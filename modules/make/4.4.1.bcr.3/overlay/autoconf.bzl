            "@rules_cc_autoconf//autoconf/macros/AC_HEADER_STAT",
            "@rules_cc_autoconf//autoconf/macros/AC_SYS_LARGEFILE",
            "@rules_cc_autoconf//autoconf/macros/AC_TYPE_OFF_T",
