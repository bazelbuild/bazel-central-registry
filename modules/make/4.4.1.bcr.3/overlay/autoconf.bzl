# buildifier: disable=unnamed-macro
def autoconf_targets():
    """The targets configure.ac and the Makefile.am files describe, in the package that calls this.

    Left out, since BUILD.bazel declares them: config, lib/gnu, make.
    """

    native.exports_files(["COPYING"])

    license(
        name = "license_COPYING",
        kind = "@package_metadata//licenses/spdx:GPL-3.0-or-later",
        text = "COPYING",
        visibility = ["//:__subpackages__"],
    )

    package_metadata(
        name = "package_metadata",
        attributes = [":license_COPYING"],
        purl = purl.bazel(
            native.module_name(),
            native.module_version(),
        ),
        visibility = ["//:__subpackages__"],
    )

    autoconf_package_info(
        name = "package",
        package_name = "GNU Make",
        aliases = {
            "PACKAGE": "PACKAGE_TARNAME",
            "VERSION": "PACKAGE_VERSION",
        },
        module_bazel = "//:MODULE.bazel",
        package_bugreport = "bug-make@gnu.org",
        package_tarname = "make",
        package_url = "https://www.gnu.org/software/make/",
        strip_bcr_version = True,
        visibility = ["//:__subpackages__"],
    )

    for name, default in BOOL_OPTIONS.items():
        bool_flag(
            name = name,
            build_setting_default = default,
            visibility = ["//visibility:public"],
        )

    for name in BOOL_OPTIONS:
        native.config_setting(
            name = name + "_enabled",
            flag_values = {":" + name: "True"},
            visibility = ["//:__subpackages__"],
        )

    string_flag(
        name = "customs",
        build_setting_default = "no",
        values = [
            "n",
            "no",
            "yes",
        ],
        visibility = ["//visibility:public"],
    )

    native.config_setting(
        name = "customs_n",
        flag_values = {
            ":customs": "n",
        },
        visibility = ["//:__subpackages__"],
    )

    native.config_setting(
        name = "customs_enabled",
        flag_values = {
            ":customs": "yes",
        },
        visibility = ["//:__subpackages__"],
    )

    autoconf(
        name = "autoconf_1",
        checks = [
            checks.AC_DEFINE("MAKE_CXX", "\"\""),
            checks.M4_VARIABLE("make_cv_sys_gnu_glob", "no"),
            checks.AC_TRY_COMPILE(
                name = "ac_cv_dos_paths",
                code = utils.AC_LANG_PROGRAM(
                    [
                        "#if !defined _WIN32 && !defined __WIN32__ && !defined __MSDOS__ && !defined __EMX__ && !defined __MSYS__ && !defined __CYGWIN__",
                        "neither MSDOS nor Windows nor OS2",
                        "#endif",
                    ],
                    [],
                ),
                compile_defines = SYSTEM_EXTENSIONS,
            ),
            checks.AC_DEFINE_UNQUOTED(
                "HAVE_DOS_PATHS",
