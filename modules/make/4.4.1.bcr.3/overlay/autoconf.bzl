                "dlopen",
                "dlsym",
                "dlerror",
            ],
            compile_defines = SYSTEM_EXTENSIONS,
            includes = ["#include <dlfcn.h>"],
        ) + [
            checks.AC_DEFINE(
                "MAKE_SYMLINKS",
                1,
                requires = [
                    "ac_cv_func_lstat",
                    "ac_cv_func_readlink",
                ],
            ),
            checks.AC_DEFINE("SCCS_GET", "\"get\""),
            checks.AC_DEFINE("MAKE_HOST", "\"bazel-build\""),
        ] + macros.AC_CHECK_DECLS(
            ["getloadavg"],
            compile_defines = SYSTEM_EXTENSIONS,
            includes = ["#include <stdlib.h>"],
        ) + [
            checks.AC_DEFINE("MK_CONFIGURE", 1),
            checks.AC_SUBST("REMOTE", "stub"),
        ] + [
            checks.AC_SUBST(name, 1)
            for name in GNULIB_MODULE_INDICATOR_SUBSTS
        ] + [
            checks.AC_DEFINE(name, value)
            for name, value in GNULIB_MODULE_INDICATOR_TEST_DEFINES.items()
        ] + select({
            "@platforms//os:macos": [
                checks.M4_VARIABLE("ac_cv_struct_st_mtim_nsec", "st_mtimespec.tv_nsec"),
                checks.AC_DEFINE_UNQUOTED("ST_MTIM_NSEC", "st_mtimespec.tv_nsec"),
                checks.M4_VARIABLE("make_cv_file_timestamp_hi_res", "yes"),
                checks.M4_VARIABLE("ac_cv_func_gettimeofday", "yes"),
                checks.AC_DEFINE("PATH_SEPARATOR_CHAR", "':'"),
                checks.AC_DEFINE_UNQUOTED(
                    "FILE_TIMESTAMP_HI_RES",
                    condition = "make_cv_file_timestamp_hi_res==yes",
                    if_false = 0,
                    if_true = 1,
                ),
                checks.AC_SEARCH_LIBS(
                    "clock_gettime",
                    [
                        "rt",
                        "posix4",
                    ],
                    requires = ["make_cv_file_timestamp_hi_res==yes"],
                    subst = "ac_cv_search_clock_gettime_LIBS",
                ),
                checks.AC_DEFINE(
                    "HAVE_GETTIMEOFDAY",
                    1,
                    requires = ["ac_cv_func_gettimeofday==yes"],
                ),
            ],
            "@platforms//os:windows": [
                checks.M4_VARIABLE("ac_cv_struct_st_mtim_nsec", "no"),
                checks.AC_DEFINE_UNQUOTED("ST_MTIM_NSEC", "no"),
                checks.M4_VARIABLE("make_cv_file_timestamp_hi_res", "no"),
                checks.M4_VARIABLE("ac_cv_func_gettimeofday", "no"),
                checks.AC_DEFINE("WINDOWS32", 1),
                checks.AC_DEFINE("PATH_SEPARATOR_CHAR", "';'"),
                checks.AC_DEFINE_UNQUOTED(
                    "FILE_TIMESTAMP_HI_RES",
                    condition = "make_cv_file_timestamp_hi_res==yes",
                    if_false = 0,
                    if_true = 1,
                ),
                checks.AC_SEARCH_LIBS(
                    "clock_gettime",
                    [
                        "rt",
                        "posix4",
                    ],
                    requires = ["make_cv_file_timestamp_hi_res==yes"],
                    subst = "ac_cv_search_clock_gettime_LIBS",
                ),
                checks.AC_DEFINE(
                    "HAVE_GETTIMEOFDAY",
                    1,
                    requires = ["ac_cv_func_gettimeofday==yes"],
                ),
            ],
            "//conditions:default": [
                checks.M4_VARIABLE("ac_cv_struct_st_mtim_nsec", "st_mtim.tv_nsec"),
                checks.AC_DEFINE_UNQUOTED("ST_MTIM_NSEC", "st_mtim.tv_nsec"),
                checks.M4_VARIABLE("make_cv_file_timestamp_hi_res", "yes"),
                checks.M4_VARIABLE("ac_cv_func_gettimeofday", "yes"),
                checks.AC_DEFINE("PATH_SEPARATOR_CHAR", "':'"),
                checks.AC_DEFINE_UNQUOTED(
                    "FILE_TIMESTAMP_HI_RES",
                    condition = "make_cv_file_timestamp_hi_res==yes",
                    if_false = 0,
                    if_true = 1,
                ),
                checks.AC_SEARCH_LIBS(
                    "clock_gettime",
                    [
                        "rt",
                        "posix4",
                    ],
