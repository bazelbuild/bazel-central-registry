                subst = "ac_cv_search_strerror_LIBS",
            ),
            checks.AC_SEARCH_LIBS(
                "getpwnam",
                ["sun"],
                subst = "ac_cv_search_getpwnam_LIBS",
            ),
        ] + macros.AC_CHECK_HEADERS(
            [
                "dirent.h",
                "locale.h",
                "limits.h",
                "memory.h",
                "sys/resource.h",
                "sys/timeb.h",
                "sys/select.h",
                "sys/file.h",
                "fcntl.h",
                "spawn.h",
            ],
        ) + macros.AC_CHECK_FUNCS(
            [
                "strtoll",
                "strdup",
                "strndup",
                "stpcpy",
                "memrchr",
                "umask",
                "mkstemp",
                "mktemp",
                "fdopen",
                "dup",
                "dup2",
                "getcwd",
                "realpath",
                "sigsetmask",
                "sigaction",
                "getgroups",
                "seteuid",
                "setegid",
                "setlinebuf",
                "setreuid",
                "setregid",
