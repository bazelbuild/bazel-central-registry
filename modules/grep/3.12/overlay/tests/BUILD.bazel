# Bazel has no expected-failure status, and asserting on a known-bad result
# would just break when upstream fixes it.
OMITTED_TESTS = {
    "equiv-classes": "upstream XFAIL_TESTS under `if USE_INCLUDED_REGEX`, which is how this port builds: lib/regex.c is compiled in and config.h renames regcomp/regexec to the gnulib entry points",
    "filename-lineno.pl": "automake drives .pl tests through `$(PERL) -MCoreutils -MCuSkip -MCuTmpdir`, and this module has no Perl toolchain",
    "glibc-infloop": "unconditional upstream XFAIL_TESTS",
    "triple-backref": "unconditional upstream XFAIL_TESTS",
}

_DECLARED_TESTS = declared_tests(
    mirror = UPSTREAM_TESTS,
    omitted = OMITTED_TESTS,
    present = glob(["*"]),
)

# Every test is `small`: the handful that scan multi-gigabyte inputs
# (`big-hole`, `long-line-vs-2GiB-read`, `100k-entries`, the `*-perf*` ones)
# are gated behind RUN_EXPENSIVE_TESTS upstream and exit 77 unless it is set.
# Passing `--test_env=RUN_EXPENSIVE_TESTS=yes` will need a matching
# `--test_timeout` bump.
UPSTREAM_TEST_TARGETS = [grep_test(name = t) for t in _DECLARED_TESTS]

test_suite(
    name = "upstream",
    tags = ["manual"],
    tests = UPSTREAM_TEST_TARGETS,
)
