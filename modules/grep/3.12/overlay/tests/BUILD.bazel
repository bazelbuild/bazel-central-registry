load("@bazel_skylib//lib:selects.bzl", "selects")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")
load(":grep_test.bzl", "declared_tests", "grep_test")

# Both test programs are C++17.
TEST_COPTS = selects.with_or({
    ("@rules_cc//cc/compiler:clang-cl", "@rules_cc//cc/compiler:msvc-cl"): ["/std:c++17"],
    "//conditions:default": ["-std=c++17"],
})

# What the two test programs have in common: running a command through the
# platform's command interpreter, and a couple of `bazel test` conventions.
cc_library(
    name = "test_support",
    testonly = True,
    hdrs = ["test_support.h"],
)

cc_test(
    name = "grep_smoke_test",
    size = "small",
    srcs = ["grep_smoke_test.cc"],
    copts = TEST_COPTS,
    data = ["//:grep"],
    env = {
        "GREP_RLOCATIONPATH": "$(rlocationpath //:grep)",
    },
    deps = [
        ":test_support",
        "@rules_cc//cc/runfiles",
    ],
)

# ---------------------------------------------------------------------------
# Upstream shell test suite (tests/Makefile.am `TESTS`).
#
# `check_PROGRAMS = get-mb-cur-max` -- a helper the suite calls to decide
# whether a locale is multibyte. Without it on PATH, every multibyte test
# skips.
# ---------------------------------------------------------------------------

# Deliberately not sharing `//:BUILD.bazel`'s COPTS/LOCAL_DEFINES: this is a
# four-line `setlocale()` probe, not part of the shipped library, so it only
# needs the C11 dialect the gnulib replacement headers assume and the same
# blanket warning silencing. Keeping its own short list here means the flags
# that matter -- the ones grep itself is built with -- stay in one place next
# to the targets they configure.
cc_binary(
    name = "get-mb-cur-max",
    testonly = True,
    srcs = ["get-mb-cur-max.c"],
    copts = selects.with_or({
        ("@rules_cc//cc/compiler:clang-cl", "@rules_cc//cc/compiler:msvc-cl"): [
            "/w",
            "/std:c11",
        ],
        "//conditions:default": [
            "-w",
            "-std=gnu11",
        ],
    }),
    deps = [
        "//:lib/grep",
        "//:lib/grep_private_headers",
        "//:linkopts",
    ],
)

# The harness behind every upstream test: rebuilds the `make check` layout
# under $TEST_TMPDIR and runs one script through the shell.  A binary rather
# than a shell script so that staging and process control are one piece of
# code on every platform, and so nothing depends on an execute bit surviving
# the overlay download.
cc_binary(
    name = "run_grep_test",
    testonly = True,
    srcs = ["run_grep_test.cc"],
    copts = TEST_COPTS,
    # GCC < 9 (debian10) keeps std::filesystem in a separate archive; later
    # GCC still ships it as an empty compatibility stub, so the flag is
    # harmless there.  clang/libc++ and MSVC have no such library.
    linkopts = select({
        "@rules_cc//cc/compiler:gcc": ["-lstdc++fs"],
        "//conditions:default": [],
    }),
    deps = [
        ":test_support",
        "@rules_cc//cc/runfiles",
    ],
)

# Every script sources `init.sh`/`init.cfg`, and a handful reach for other
# siblings (`bre.awk`, `khadafy.lines`, ...), so the whole directory is staged
# for each test rather than tracking per-test inputs. The excluded patterns are
# this package's own sources plus automake bookkeeping and the Perl harness
# for `filename-lineno.pl`, which is not among the tests declared below --
# together about half the bytes.
filegroup(
    name = "upstream_test_data",
    testonly = True,
    srcs = glob(
        ["*"],
        exclude = [
            "*.bzl",
            "*.c",
            "*.cc",
            "*.h",
            "*.pl",
            "*.pm",
            "BUILD.bazel",
            "Makefile.am",
            "Makefile.in",
        ],
    ),
)

