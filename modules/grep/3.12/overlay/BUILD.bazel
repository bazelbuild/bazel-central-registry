# Build targets (from src/Makefile.am)

cc_binary(
    name = "src/grep",
    srcs = [
        "src/dfasearch.c",
        "src/grep.c",
        "src/kwsearch.c",
        "src/kwset.c",
        "src/searchutils.c",
    ] + glob([
        "src/*.h",
    ]) + select({
        ":perl_regexp_enabled": ["src/pcresearch.c"],
        "//conditions:default": [],
    }),
    copts = COPTS,
    # `src` must precede `lib` so `#include <search.h>` finds `src/search.h`
    # instead of the host's `<search.h>`.
    # do not sort
    includes = [
        "src",
        "lib",
    ],
    local_defines = LOCAL_DEFINES,
    target_compatible_with = select({
        "@platforms//os:none": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    deps = [
        ":lib/grep",
        ":lib/grep_private_headers",
        ":linkopts",
    ] + select({
        ":perl_regexp_enabled": ["@pcre2"],
        "//conditions:default": [],
    }),
)

