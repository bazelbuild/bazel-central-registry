]

# stdint.h is offered to MSVC and clang-cl as well.  gl_STDINT_H keeps
# generating the wrapper unless the system header already has the C23 width
# macros (m4/stdint.m4 lines 333-350), and MSVC's <stdint.h> does not; the
# wrapper only layers those on top of it, and lib/rawmemchr.c's
# `static_assert (UINTPTR_WIDTH == ...)` needs them.
cc_gnulib_conditional_hdrs(
    name = "lib/grep_gnulib_conditional_hdrs",
    hdrs = {
        "_gnulib_cond/{}.h".format(stem): "GL_GENERATE_{}_H".format(stem.upper().replace("-", "_"))
        for stem in GNULIB_COND_HDR_STEMS
    },
    deps = [":autoconf"],
)

