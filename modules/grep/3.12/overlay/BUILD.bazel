# MSVC has no #include_next, so there rules_cc_autoconf turns every
# `@NEXT_<hdr>_H@` into the *text* of the system header.  That replacement is
# blind to context, and stdint.in.h line 102 mentions the placeholder inside
# a comment: the first `*/` in MSVC's <stdint.h> ends the comment early, the
# rest of the header is parsed as code (C2059), and its #if/#endif nesting is
# torn in half (C1070).  It is the only such mention in grep's templates;
# reword it before the placeholders are filled in.
#
# TODO: drop once rules_cc_autoconf leaves placeholders inside comments alone.
GNULIB_COND_HDR_SUBSTITUTIONS = {
    "stdint": {
        "<sys/types.h> after @NEXT_STDINT_H@.": "<sys/types.h> after the system <stdint.h>.",
    },
}

# assert.h is the one wrapper gnulib assembles from two files: assert.in.h,
# then verify.h with its `verify`/`assume` half cut out and its identifiers
# renamed (lib/gnulib.mk lines 196-209).  The appended half is what supplies
# a `_Static_assert` that takes one argument on compilers predating C23 --
# GCC < 9 -- so without it GL_GENERATE_ASSERT_H=true would buy nothing and
# `static_assert (sizeof (char32_t) == sizeof (wchar_t));` in uchar.h fails.
autoconf_hdr(
    name = "lib_assert_h_static_assert_half",
    out = "_gnulib_cond/verify-static_assert.h",
    mode = "subst",
    substitutions = {
        # sed -e '/@assert.h omit start@/,/@assert.h omit end@/d', done by
        # fencing the region off instead of deleting it.
        "/* @assert.h omit end@  */": "#endif /* @assert.h omit end@ */",
        "/* @assert.h omit start@  */": "#if 0 /* @assert.h omit start@ */",
        # sed -e 's|_gl_verify|_gl_static_assert|g'
        #     -e 's|_GL_VERIFY|_GL_STATIC_ASSERT|g'
        "_GL_VERIFY": "_GL_STATIC_ASSERT",
        "_gl_verify": "_gl_static_assert",
    },
    template = "lib/verify.h",
    deps = [":autoconf"],
)

# Snippets spliced into one particular wrapper, on top of GL_INLINES.
GNULIB_COND_HDR_INLINES = {
    "assert": {
        "/* The definition of static_assert is copied here.  */": ":lib_assert_h_static_assert_half",
    },
}

[
    autoconf_hdr(
        name = "lib_{}_h_processed".format(stem.replace("-", "_")),
        out = "_gnulib_cond/{}.h".format(stem),
        defaults = True,
        inlines = dict(GL_INLINES.items() + GNULIB_COND_HDR_INLINES.get(stem, {}).items()),
        mode = "subst",
        substitutions = GNULIB_COND_HDR_SUBSTITUTIONS.get(stem, {}),
        template = "lib/{}.in.h".format(stem),
        deps = [":autoconf"],
