        # configure.ac line 54
        checks.AC_DEFINE("GREP", 1),
        # configure.ac lines 61-64: argmatch.c calls back into
        # src/grep.c's usage() on a bad --directories= etc. value.
        checks.AC_DEFINE(
            "ARGMATCH_DIE",
            value = "usage (EXIT_FAILURE)",
        ),
        checks.AC_DEFINE(
            "ARGMATCH_DIE_DECL",
            value = "void usage (int _e)",
        ),
        # gnulib's unlocked-io module (lib/gnulib.mk).
        checks.AC_DEFINE(
            "USE_UNLOCKED_IO",
            value = "GNULIB_STDIO_SINGLE_THREAD",
