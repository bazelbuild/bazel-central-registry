    "GL_COND_OBJ_DUP": "REPLACE_DUP",
    "GL_COND_OBJ_DUP2": "REPLACE_DUP2",
    "GL_COND_OBJ_ERROR": "COMPILE_ERROR_C==1",
    # Spelled as the probe, which is also what gnulib-comp.m4 tests
    # (`test $ac_cv_func_fchdir = no`).  The fchdir/openat probes publish
    # HAVE_* only as an alias of their own cache name, so `ac_cv_subst_HAVE_*`
