"""GNU grep - https://www.gnu.org/software/grep/"""

load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc_autoconf//autoconf:autoconf.bzl", "autoconf")
load("@rules_cc_autoconf//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
load("@rules_cc_autoconf//autoconf:autoconf_linkopts.bzl", "autoconf_linkopts")
load("@rules_cc_autoconf//autoconf:autoconf_srcs.bzl", "autoconf_srcs")
load("@rules_cc_autoconf//autoconf:checks.bzl", "checks", "macros")
load("@rules_cc_autoconf//autoconf:package_info.bzl", "package_info")
load("@rules_cc_autoconf//gnulib:conditional_hdrs.bzl", "cc_gnulib_conditional_hdrs")
load("@rules_cc_autoconf//gnulib:macros.bzl", gl_macros = "macros")

package_info(
    name = "package",
    package_name = "GNU grep",
    # configure.ac's AC_INIT gives `PACKAGE`/`VERSION` the same values as
    # `PACKAGE_TARNAME`/`PACKAGE_VERSION`.
    aliases = {
        "PACKAGE": "PACKAGE_TARNAME",
        "VERSION": "PACKAGE_VERSION",
    },
    # The version comes from MODULE.bazel rather than a literal so a
    # `.bcr.N` bump has one place to edit; `strip_bcr_version` is what keeps
    # that suffix out of `grep --version`.
    module_bazel = "MODULE.bazel",
    package_bugreport = "bug-grep@gnu.org",
    package_tarname = "grep",
    package_url = "https://www.gnu.org/software/grep/",
    strip_bcr_version = True,
)

# --disable-perl-regexp (m4/pcre.m4 line 10).  Enables the -P/--perl-regexp
# matcher, which links grep against PCRE2.
bool_flag(
    name = "perl_regexp",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "perl_regexp_enabled",
    flag_values = {":perl_regexp": "True"},
)

# --enable-threads (gnulib m4/threadlib.m4).  Compiles the glthread locking
# shims; with it off grep's gnulib copy falls back to the single-threaded
# code paths.
bool_flag(
    name = "threads",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "threads_enabled",
    flag_values = {":threads": "True"},
)

# --enable-largefile (AC_SYS_LARGEFILE).  Off makes 32-bit hosts use a 32-bit
# off_t, which caps grep at 2GiB files; on is upstream's default.
bool_flag(
    name = "largefile",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "largefile_enabled",
    flag_values = {":largefile": "True"},
)

# year2038: guarantees a 64-bit time_t.  Mingw needs an opt-in macro;
# everywhere else a wide time_t is already the default.
autoconf(
    name = "m4_year2038",
    checks = select({
        "@platforms//os:windows": [
            checks.AC_DEFINE("__MINGW_USE_VC2005_COMPAT", 1),
        ],
        "//conditions:default": [],
    }),
)

# Upstream's gl_CHECK_FUNC_C32RTOMB probes c32rtomb with the autoconf
# toolchain's own flags rather than the consumer's; on macOS libSystem's
# <uchar.h> hides the prototype unless a feature-test macro that -std=gnu11
# doesn't set is active, so the probe says "available" but grep's TU can't
# see the declaration.  Pin the answer from platform knowledge instead.
#
# The pin must agree with HAVE_WORKING_C32RTOMB, which the c32rtomb module
# still probes: gnulib never produces HAVE_C32RTOMB=0 together with
# HAVE_WORKING_C32RTOMB=1, and in that combination lib/c32rtomb.c is
# compiled without the rpl_ rename and its "call the system function"
# branch (lib/c32rtomb.c line 47) calls itself -- `grep -i` overflowed the
# stack on Windows that way.  UCRT declares c32rtomb in <uchar.h> exactly as
# the probe reports, so Windows gets the probe's answer, like Linux.
autoconf(
    name = "m4_c32rtomb",
    checks = selects.with_or({
        ("@platforms//os:linux", "@platforms//os:windows"): [
            checks.AC_SUBST("HAVE_C32RTOMB", 1),
        ],
        "//conditions:default": [
            checks.AC_SUBST("HAVE_C32RTOMB", 0),
        ],
    }),
)

# gl_FUNC_PCRE (m4/pcre.m4).  The pkg-config probe is replaced by a hard
# bazel_dep on @pcre2, so the only thing left to model is the define.
autoconf(
    name = "m4_pcre",
    checks = select({
        ":perl_regexp_enabled": [
            checks.AC_DEFINE("HAVE_LIBPCRE", 1),
        ],
        "//conditions:default": [],
    }),
)

# AC_SYS_LARGEFILE (configure.ac line 47).
autoconf(
    name = "m4_largefile",
    checks = select({
        ":largefile_enabled": [
            checks.AC_DEFINE("_FILE_OFFSET_BITS", 64),
        ],
        "//conditions:default": [],
    }),
)

# gl_LANGINFO_H additions that postdate the gnulib snapshot
# `@rules_cc_autoconf//gnulib/m4/langinfo_h` was cut from.  Grep's
# `lib/langinfo.in.h` still expands them, so probe them here.
#
# TODO: delete once `@rules_cc_autoconf//gnulib/m4/langinfo_h` probes
# T_FMT_AMPM and YESEXPR itself -- these two belong next to the CODESET,
# ALTMON, ABALTMON and ERA checks it already has, not in a per-package
# overlay.
autoconf(
    name = "m4_langinfo",
    checks = [
        check
        for item in [
            "T_FMT_AMPM",
            "YESEXPR",
        ]
        for check in [
            checks.AC_TRY_COMPILE(
                name = "gl_cv_header_langinfo_{}".format(item.lower()),
                code = "#include <langinfo.h>\nint a = {};\n".format(item),
            ),
            checks.AC_SUBST(
                "HAVE_LANGINFO_{}".format(item),
                condition = "gl_cv_header_langinfo_{}".format(item.lower()),
            ),
        ]
    ],
)

# gl_FUNC_NL_LANGINFO (m4/nl_langinfo.m4).  Ported here instead of taking
# `@rules_cc_autoconf//gnulib/m4/nl_langinfo`: that target sets
# NL_LANGINFO_MTSAFE=0 on every non-Linux host, but upstream reserves 0 for
# solaris* (line 46), and the 0 branch of lib/nl_langinfo.c reaches for
# Solaris' MAXSTRMSG, so macOS fails to compile.  Defining the same macro
# from two deps is a hard error, so the whole macro moves rather than the
# one define.
#
# TODO: drop this once `@rules_cc_autoconf//gnulib/m4/nl_langinfo` only
# zeroes NL_LANGINFO_MTSAFE for Solaris.
#
# Lines 51-57: nl_langinfo is only left alone when every langinfo item probe
# succeeded.  The YESEXPR_WORKS and MTSAFE terms are constants here (below),
# so they fold out.  Line 66's `future*` Android case is not modeled.
NL_LANGINFO_OVERRIDDEN = " && ".join([
    "ac_cv_func_nl_langinfo",
    "!(" + " && ".join([
        "ac_cv_subst_HAVE_LANGINFO_CODESET==1",
        "ac_cv_subst_HAVE_LANGINFO_T_FMT_AMPM==1",
        "ac_cv_subst_HAVE_LANGINFO_ALTMON==1",
        "ac_cv_subst_HAVE_LANGINFO_ABALTMON==1",
        "ac_cv_subst_HAVE_LANGINFO_ERA==1",
    ]) + ")",
])

autoconf(
    name = "m4_nl_langinfo",
    checks = [
        # Line 13's gl_CHECK_FUNCS_ANDROID is the AC_FUNC_NL_LANGINFO dep;
        # line 65 zeroes the Makefile variable when the function is missing.
        checks.AC_SUBST(
            "HAVE_NL_LANGINFO",
            condition = "ac_cv_func_nl_langinfo",
        ),
        # Lines 20-43 are an AC_RUN_IFELSE, which cannot run under Bazel;
        # upstream's own cross-compiling guess is "yes" everywhere but IRIX.
        checks.AC_DEFINE_UNQUOTED(
            "FUNC_NL_LANGINFO_YESEXPR_WORKS",
            "1",
            requires = ["ac_cv_func_nl_langinfo"],
        ),
        # Lines 44-50.  There is no Solaris platform to select on.
        checks.AC_DEFINE_UNQUOTED(
            "NL_LANGINFO_MTSAFE",
            "1",
            requires = ["ac_cv_func_nl_langinfo"],
        ),
        # Lines 60-62: upstream leaves the macro undefined, not 0, when
        # nl_langinfo is kept.
        checks.AC_DEFINE(
            "REPLACE_NL_LANGINFO",
            condition = NL_LANGINFO_OVERRIDDEN,
            if_false = None,
            if_true = 1,
        ),
        checks.AC_SUBST(
            "REPLACE_NL_LANGINFO",
            condition = NL_LANGINFO_OVERRIDDEN,
        ),
        # Lines 70-76.  SETLOCALE_NULL_LIB is empty on every supported
        # toolchain, and upstream itself notes this "is expected to be empty
        # everywhere".
        checks.AC_SUBST("LIB_NL_LANGINFO", ""),
    ],
    deps = [
        ":m4_langinfo",
        "@rules_cc_autoconf//gnulib/m4/langinfo_h",
        "@rules_cc_autoconf//gnulib/m4/setlocale_null",
        "@rules_cc_autoconf//gnulib/m4/threadlib",
        "@rules_cc_autoconf//gnulib/m4/visibility",
        "@rules_cc_autoconf//gnulib/macros/AC_FUNC_NL_LANGINFO",
    ],
)

# gl_REPLACE_ERRNO_VALUE (m4/errno_h.m4 lines 96-140) for the three codes
# lib/errno.in.h lines 153-162 substitute.  Upstream only runs this when
# errno.h has to be generated (native Windows), which is also the only place
# the placeholders matter; `@rules_cc_autoconf//gnulib/m4/errno_h` does not
# model it, so MSVC saw literal `@EMULTIHOP_HIDDEN@` in `#if` lines.
#
# TODO: delete once `@rules_cc_autoconf//gnulib/m4/errno_h` substitutes
# these itself.
ERRNO_H_REPLACED_VALUES = [
    "EMULTIHOP",
    "ENOLINK",
    "EOVERFLOW",
]

autoconf(
    name = "m4_errno_h_values",
    checks = [
        check
        for code in ERRNO_H_REPLACED_VALUES
        for check in [
            # Lines 102-107: is the macro visible by default?
            checks.AC_TRY_COMPILE(
                name = "gl_cv_header_errno_h_{}".format(code),
                code = """#include <errno.h>
#ifndef {code}
# error {code} is not defined
#endif
""".format(code = code),
            ),
            # Lines 109-116: or only behind _XOPEN_SOURCE_EXTENDED (HP-UX)?
            checks.AC_TRY_COMPILE(
                name = "gl_cv_header_errno_h_{}_hidden".format(code),
                code = """#define _XOPEN_SOURCE_EXTENDED 1
#include <errno.h>
#ifndef {code}
# error {code} is not defined
#endif
""".format(code = code),
                requires = ["!gl_cv_header_errno_h_{}".format(code)],
            ),
            # Lines 130-139.  The `_VALUE` is only computed, and only read by
            # the template, in the hidden case; a check that did not run
            # substitutes as the empty string upstream also produces.
            checks.AC_SUBST(
                "{}_HIDDEN".format(code),
                condition = "gl_cv_header_errno_h_{}_hidden".format(code),
            ),
            checks.AC_COMPUTE_INT(
                "{}_VALUE".format(code),
                code,
                copts = ["-D_XOPEN_SOURCE_EXTENDED=1"],
                includes = ["errno.h"],
                requires = ["gl_cv_header_errno_h_{}_hidden".format(code)],
                subst = True,
            ),
        ]
    ],
)

# gl_ASSERT_H (m4/assert_h.m4).  Ported here instead of taking
# `@rules_cc_autoconf//gnulib/m4/assert_h`: upstream probes twice -- is
# `static_assert` a keyword with no header included, and failing that, does
# <assert.h> supply it as a macro -- and defines HAVE_C_STATIC_ASSERT only for
# the keyword.  The rules_cc_autoconf target runs one probe that includes
# <assert.h> and defines it either way, which on MSVC switches off the
# config.h block (config.hin lines 3582-3609) that hands every translation
# unit a working `static_assert` where it is not a keyword.
#
# The probes carry grep's own C standard (C_STD_COPTS, which COPTS below is
# built from): upstream runs them under $CFLAGS, and "is it a keyword" is
# only meaningful for the mode the sources are compiled in.
#
# TODO: drop this once `@rules_cc_autoconf//gnulib/m4/assert_h` keeps the
# keyword probe apart from the <assert.h> probe.
C_STD_COPTS = {
    "@rules_cc//cc/compiler:clang-cl": ["/std:c11"],
    "@rules_cc//cc/compiler:msvc-cl": ["/std:c11"],
    "//conditions:default": ["-std=gnu11"],
}

STATIC_ASSERT_PROBE = """\
#if defined __clang__ && __STDC_VERSION__ < 202311
#pragma clang diagnostic error "-Wc2x-extensions"
#pragma clang diagnostic error "-Wc++1z-extensions"
#endif
{include}
static_assert (2 + 2 == 4, "arithmetic does not work");
static_assert (2 + 2 == 4);

int main (void)
{{
  static_assert (sizeof (char) == 1, "sizeof does not work");
  static_assert (sizeof (char) == 1);
  return 0;
}}
"""

autoconf(
    name = "m4_assert_h",
    # Upstream keeps one cache variable, gl_cv_static_assert, holding "yes, a
    # keyword", "yes, an <assert.h> macro" or "no"; here that is two probes.
    checks = select({
        compiler: [
            checks.AC_TRY_COMPILE(
                name = "gl_cv_static_assert_keyword",
                code = STATIC_ASSERT_PROBE.format(include = ""),
                copts = copts,
            ),
            checks.AC_TRY_COMPILE(
                name = "gl_cv_static_assert_macro",
                code = STATIC_ASSERT_PROBE.format(include = "#include <assert.h>"),
                copts = copts,
                requires = ["!gl_cv_static_assert_keyword"],
            ),
        ]
        for compiler, copts in C_STD_COPTS.items()
    }) + [
        checks.AC_DEFINE(
            "HAVE_C_STATIC_ASSERT",
            requires = ["gl_cv_static_assert_keyword"],
        ),
        checks.AC_SUBST(
            "GL_GENERATE_ASSERT_H",
            condition = "gl_cv_static_assert_keyword || gl_cv_static_assert_macro",
            if_false = "true",
            if_true = "false",
        ),
    ] + gl_macros.GL_NEXT_HEADERS(
        ["assert.h"],
        condition = "!(gl_cv_static_assert_keyword || gl_cv_static_assert_macro)",
    ),
    deps = ["@rules_cc_autoconf//gnulib/m4/include_next"],
)

# gl_FCNTL_O_FLAGS (m4/fcntl-o.m4 lines 129-141) always defines
# HAVE_WORKING_O_NOATIME and HAVE_WORKING_O_NOFOLLOW, to 0 when the run test
# fails or cannot run.  `@rules_cc_autoconf//gnulib/m4/fcntl-o` stands in
# for the run test with a platform select that covers Linux and macOS and
# emits nothing elsewhere, and lib/fts.c line 2096 reads
# HAVE_WORKING_O_NOFOLLOW in a C expression, so MSVC stops with C2065.  That
# target also arrives through `fcntl_h` and `open`, so it cannot be swapped
# out; this fills exactly the branch it leaves empty.  Native Windows has
# neither flag, which is also upstream's cross-compiling answer.
#
# TODO: delete once `@rules_cc_autoconf//gnulib/m4/fcntl-o` defines these on
# every platform.  A duplicate define would then fail the build loudly.
autoconf(
    name = "m4_fcntl_o",
    checks = selects.with_or({
        ("@platforms//os:linux", "@platforms//os:macos"): [],
        "//conditions:default": [
            checks.AC_DEFINE_UNQUOTED("HAVE_WORKING_O_NOATIME", "0"),
            checks.AC_DEFINE_UNQUOTED("HAVE_WORKING_O_NOFOLLOW", "0"),
        ],
    }),
)

# gl_FUNC_MBSINIT (m4/mbsinit.m4 lines 17-40).  Ported here instead of taking
# `@rules_cc_autoconf//gnulib/m4/mbsinit`, which pins REPLACE_MBSINIT=0
# everywhere; upstream turns it on when mbstate_t had to be replaced and,
# unconditionally, on native Windows (lines 36-38), where mbsinit() reports
# every state as initial.  With the variable right, wchar.h renames mbsinit
# to rpl_mbsinit *and* lib/mbsinit.c is compiled -- the port used to force
# only the rename, so MSVC linked against a missing rpl_mbsinit.  The probe
# for the function itself comes from the mbrtowc module.
#
# Line 30's `REPLACE_MBSTATE_T = 1` term is left out: rules_cc_autoconf does
# not model gl_MBSTATE_T_BROKEN, its REPLACE_MBSTATE_T is a constant 0 in
# the wchar.h defaults, and toolchain defaults are not visible to a
# condition here anyway.  lib/mbsinit.c's native-Windows branch does not
# depend on it.
#
# TODO: drop once `@rules_cc_autoconf//gnulib/m4/mbsinit` models lines 29-39
# (and restore the REPLACE_MBSTATE_T term if gl_MBSTATE_T_BROKEN ever is).
autoconf(
    name = "m4_mbsinit",
    checks = [
        # Lines 20-22: only consulted when the function is missing (Minix).
        checks.AC_CHECK_DECL(
            "mbsinit",
            name = "ac_cv_have_decl_mbsinit",
            includes = ["#include <wchar.h>"],
            requires = ["!ac_cv_func_mbsinit"],
        ),
    ] + select({
        # `mingw* | windows*`.
        "@platforms//os:windows": [
            checks.AC_SUBST(
                "REPLACE_MBSINIT",
                condition = "ac_cv_func_mbsinit || ac_cv_have_decl_mbsinit",
            ),
        ],
        "//conditions:default": [
            checks.AC_SUBST(
                "REPLACE_MBSINIT",
                condition = "!ac_cv_func_mbsinit && ac_cv_have_decl_mbsinit",
            ),
        ],
    }),
    deps = [
        "@rules_cc_autoconf//gnulib/m4/mbrtowc",
        "@rules_cc_autoconf//gnulib/m4/mbstate_t",
    ],
)

# gl_FUNC_CHDIR_LONG (m4/chdir-long.m4 lines 19-28) with gl_PATHMAX_SNIPPET
# (m4/pathmax.m4 lines 18-38) spliced in, as upstream does.  Ported here
# instead of taking `@rules_cc_autoconf//gnulib/m4/chdir-long`, whose probe
# only looks in <limits.h>: MSVC's has no PATH_MAX, so it concludes file names
# are unlimited and drops lib/chdir-long.c, while lib/pathmax.h (like the
# snippet) defines PATH_MAX as 260 there and lib/save-cwd.c calls chdir_long.
# HAVE_UNISTD_H and HAVE_SYS_PARAM_H are not defined inside a probe, so those
# two includes drop out; every libc here that has PATH_MAX puts it in
# <limits.h>.
#
# TODO: drop once `@rules_cc_autoconf//gnulib/m4/chdir-long` probes through
# the pathmax snippet.
autoconf(
    name = "m4_chdir_long",
    checks = [
        checks.AC_TRY_COMPILE(
            name = "gl_cv_have_arbitrary_file_name_length_limit",
            code = """\
/* Arrange to define PATH_MAX, like "pathmax.h" does. */
#if HAVE_UNISTD_H
# include <unistd.h>
#endif
#include <limits.h>
#if defined HAVE_SYS_PARAM_H && !defined PATH_MAX && !defined MAXPATHLEN
# include <sys/param.h>
#endif
#if !defined PATH_MAX && defined MAXPATHLEN
# define PATH_MAX MAXPATHLEN
#endif
#ifdef __hpux
# undef PATH_MAX
# define PATH_MAX 1024
#endif
#if defined _WIN32 && ! defined __CYGWIN__
# undef PATH_MAX
# define PATH_MAX 260
#endif
#ifndef PATH_MAX
# error no arbitrary file name length limit
#endif
int main (void) { return 0; }
""",
        ),
        checks.M4_VARIABLE(
            "gl_cv_have_unlimited_file_name_length",
            condition = "gl_cv_have_arbitrary_file_name_length_limit",
            if_false = "yes",
            if_true = "no",
        ),
    ],
)

# gl_FUNC_READDIR (m4/readdir.m4 lines 13-16), gl_FUNC_FDOPENDIR
# (m4/fdopendir.m4 lines 24-27) and gl_FUNC_OPENDIR (m4/opendir.m4) all zero
# the Makefile variable when the function is missing.  The rules_cc_autoconf
# targets run the probes but never write the answer back, so
# gl_DIRENT_H_DEFAULTS' 1 stands: on MSVC, which has none of the three,
# dirent.h then omits the declarations (all return pointers, so an implicit
# int declaration would truncate them) and lib/readdir.c, lib/fdopendir.c
# and lib/opendir.c are left out.  The defaults come from the toolchain
# rather than a dep, so these override them without a conflict.  The opendir
# module names its probe `_gl_cv_func_opendir`.
#
# TODO: drop once `@rules_cc_autoconf//gnulib/m4/readdir`, `.../fdopendir`
# and `.../opendir` AC_SUBST their HAVE_* variables themselves.
autoconf(
    name = "m4_dirent_have_funcs",
    checks = [
        checks.AC_SUBST(
            "HAVE_{}".format(func),
            condition = probe,
        )
        for func, probe in {
            "FDOPENDIR": "ac_cv_func_fdopendir",
            "OPENDIR": "_gl_cv_func_opendir",
            "READDIR": "ac_cv_func_readdir",
        }.items()
    ],
    deps = [
        "@rules_cc_autoconf//gnulib/m4/fdopendir",
        "@rules_cc_autoconf//gnulib/m4/opendir",
        "@rules_cc_autoconf//gnulib/m4/readdir",
    ],
)

# gl_FUNC_FCHDIR (m4/fchdir.m4 lines 29-64).  `@rules_cc_autoconf//gnulib/m4/
# fchdir` probes the function and lets the dup/dup2/close/fcntl/opendir/
# closedir modules flip their REPLACE_* variables when it is missing, but it
# never emits the config.h *define* REPLACE_FCHDIR that the same block
# produces (line 30) -- distinct from the Makefile variable of that name,
# which stays 0.  lib/fdopendir.c, lib/opendir.c, lib/close.c, lib/dup2.c
# and friends key their directory-fd bookkeeping on the define, and on
# Windows fdopendir.c refuses to build without it ("GNULIB_defined_DIR but
# fchdir not replaced").  The fchdir module is reached through ten others, so
# the define is added beside it rather than by replacing it.
#
# TODO: drop once `@rules_cc_autoconf//gnulib/m4/fchdir` defines
# REPLACE_FCHDIR (and REPLACE_OPEN_DIRECTORY) itself.
autoconf(
    name = "m4_fchdir",
    checks = [
        # Lines 29-31.  Lines 21-27 (fchdir present but DIR has no fd
        # member) do not arise on any supported libc.
        checks.AC_DEFINE(
            "REPLACE_FCHDIR",
            requires = ["!ac_cv_func_fchdir"],
        ),
    ] + select({
        # Lines 35-63: an AC_RUN_IFELSE that cannot run here; upstream's own
        # guess for native Windows is "no" (line 52).  Elsewhere the block is
        # skipped because fchdir exists.
        "@platforms//os:windows": [
            checks.AC_DEFINE(
                "REPLACE_OPEN_DIRECTORY",
                requires = ["!ac_cv_func_fchdir"],
            ),
        ],
        "//conditions:default": [],
    }),
    deps = ["@rules_cc_autoconf//gnulib/m4/fchdir"],
)

# gl_FUNC_OPEN (m4/open.m4 lines 9-50) and gl_FUNC_CLOSE (m4/close.m4 lines
# 10-35).  `@rules_cc_autoconf//gnulib/m4/open` and `.../close` carry no
# checks at all, so REPLACE_OPEN and REPLACE_CLOSE stay at the fcntl.h /
# unistd.h defaults of 0 -- and those defaults are toolchain-only, so these
# override them without a conflict.  Upstream replaces both on native
# Windows (open.m4 line 15; close.m4 lines 14-16 via the MSVC invalid-
# parameter handler and lines 19-21 via winsock2), and anywhere fchdir is
# missing, which is what keeps lib/fchdir.c's directory-fd table honest.
# Without lib/open.c the REPLACE_OPEN_DIRECTORY workaround is never reached
# and `grep -r DIR` fails with EACCES on Windows.
#
# TODO: drop once `@rules_cc_autoconf//gnulib/m4/open` and `.../close` model
# their m4 files.
autoconf(
    name = "m4_open",
    checks = select({
