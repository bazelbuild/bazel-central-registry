autoconf_hdr(
    name = "config",
    out = "config.h",
    # AC_C_RESTRICT.  `@rules_cc_autoconf//autoconf/macros/AC_C_RESTRICT`
    # models the pre-2.70 chain -- bare `restrict` first, probed on a pointer
    # parameter only -- whereas the Autoconf 2.72 that generated grep's
    # configure tries `__restrict__ __restrict _Restrict restrict` and also
    # requires the `int ip[kw]` array form.  MSVC takes `restrict` after `*`
    # but not inside `[]`, so the old chain leaves the macro undefined and
    # lib/regex.h line 685 (`__pmatch[_Restrict_arr_ ...]`) does not parse;
    # the 2.72 chain finds no spelling that passes and defines it empty.  On
    # GCC and Clang it settles on `__restrict__`, as a real configure run
    # does.  Ten gnulib modules pull the macro in, so a competing `restrict`
    # define would be rejected as a duplicate; patch the rendered line
    # instead.  The newlines pin the match to the whole template line.
    #
    # TODO: drop once `@rules_cc_autoconf//autoconf/macros/AC_C_RESTRICT`
    # follows the 2.72 order and probes the array form.
    #
    # HAVE_WORKING_MBRTOC32.  gl_MBRTOC32_SANITYCHECK is an AC_RUN_IFELSE
    # whose cross-compiling guess is "no" for `mingw* | windows*`
    # (m4/mbrtoc32.m4 lines 246-247); `@rules_cc_autoconf//gnulib/m4/
    # mbrtoc32` reduces it to "the function exists", which UCRT satisfies.
    # Leaving it undefined on Windows sends lib/mbrtoc32.c and the c32*
    # helpers down their native-Windows branches, as upstream does, rather
    # than the glibc ones.  REPLACE_MBRTOC32 is already 1 there.
    #
    # TODO: drop once `@rules_cc_autoconf//gnulib/m4/mbrtoc32` carries the
    # host_os guess.
    substitutions = select({
        "@rules_cc//cc/compiler:clang-cl": {
            "\n#undef HAVE_WORKING_MBRTOC32\n": "\n/* HAVE_WORKING_MBRTOC32 is left undefined on native Windows.  */\n",
            "\n#undef restrict\n": "\n#define restrict __restrict__\n",
        },
        "@rules_cc//cc/compiler:msvc-cl": {
            "\n#undef HAVE_WORKING_MBRTOC32\n": "\n/* HAVE_WORKING_MBRTOC32 is left undefined on native Windows.  */\n",
            "\n#undef restrict\n": "\n#define restrict /**/\n",
        },
        "//conditions:default": {
            "\n#undef restrict\n": "\n#define restrict __restrict__\n",
        },
    }),
    template = "config.hin",
    # `tests/version-pcre` and `tests/glibc-infloop` grep the generated
    # header through `$CONFIG_HEADER`.
    visibility = ["//tests:__pkg__"],
    deps = [":autoconf"],
)

