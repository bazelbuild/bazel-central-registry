# grep's gnulib copy needs C11 for `static_assert`, `_Noreturn` and
# `char32_t` (C_STD_COPTS, above); `/w` and `-w` silence every warning the
# port would otherwise inherit from upstream's -Wall-heavy default CFLAGS.
COPTS = select({
    compiler: ["/w" if std[0].startswith("/") else "-w"] + std
    for compiler, std in C_STD_COPTS.items()
})

LOCAL_DEFINES = [
    "HAVE_CONFIG_H",
] + selects.with_or({
    # lib/setlocale_null.c hardcodes a __declspec(dllimport) extern for
    # gl_get_setlocale_null_lock that the static-link build of
    # setlocale-lock.c has no matching dllexport for.  AVOID_ANY_THREADS
    # collapses the locking branch before that extern is seen.
    ("@rules_cc//cc/compiler:clang-cl", "@rules_cc//cc/compiler:msvc-cl"): [
        "AVOID_ANY_THREADS=1",
    ],
    "//conditions:default": [],
})

cc_library(
    name = "lib/grep",
    srcs = LIBGREP_GNULIB_SRCS +
           LIBGREP_GNULIB_PLATFORM_SRCS +
           LIBGREP_COLORIZE_SRCS +
           select({
               ":threads_enabled": [
                   "lib/glthread/lock.c",
                   "lib/glthread/threadlib.c",
               ],
               "//conditions:default": [],
           }) + [
        ":lib/grep_gnulib_conditional_srcs",
    ],
    copts = COPTS,
    implementation_deps = [":lib/grep_private_headers"],
    linkopts = select({
        # lib/stat-w32.c and lib/windows-*.c pull in Win32 APIs that MSVC
        # does not link by default.
        "@rules_cc//cc/compiler:msvc-cl": ["/DEFAULTLIB:advapi32.lib"],
        "//conditions:default": [],
    }),
    local_defines = LOCAL_DEFINES,
    textual_hdrs = LIBGREP_GNULIB_TEXTUAL_HDRS,
    # `tests/get-mb-cur-max` is upstream's `check_PROGRAMS` helper and links
    # against libgreputils.a exactly like `src/grep` does.
    visibility = ["//tests:__pkg__"],
)

