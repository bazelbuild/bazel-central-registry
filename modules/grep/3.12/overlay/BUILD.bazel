    "GL_COND_OBJ_FCHDIR": "!ac_cv_func_fchdir || ac_cv_subst_REPLACE_FCHDIR",
    "GL_COND_OBJ_FCNTL": "ac_cv_subst_HAVE_FCNTL==0 || REPLACE_FCNTL",
