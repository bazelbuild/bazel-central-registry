                "semaphore.h",
                "sys/single_threaded.h",
            ],
        ) + [
            checks.AC_DEFINE("GNULIB_STDIO_SINGLE_THREAD", 1),
            checks.AC_DEFINE("USE_UNLOCKED_IO", "GNULIB_STDIO_SINGLE_THREAD"),
            checks.AC_TRY_COMPILE(
                name = "ac_cv_c_vararrays",
                code = utils.AC_LANG_PROGRAM(
                    [
                        "#ifdef __STDC_NO_VLA__",
