module(
    name = "swift-bylaws",
    version = "0.6.0",
    compatibility_level = 1,
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_lib", version = "3.7.2")

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

_BASE = "https://github.com/theblixguy/swift-bylaws/releases/download/v0.6.0"

http_archive(
    name = "bylaws_macos",
    sha256 = "f4543411b23f97d58d3230c74b70d831d59903b2536d59e7f914bba56fc62df6",
    urls = [_BASE + "/bylaws-macos.tar.gz"],
)

http_archive(
    name = "bylaws_linux",
    sha256 = "aafd710b3f14946e1b78562e095761cac174bbdfd62e36c3c0b65ae1d001c266",
    urls = [_BASE + "/bylaws-linux.tar.gz"],
)
