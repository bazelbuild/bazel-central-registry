module(
    name = "swift-bylaws",
    version = "0.4.0",
    compatibility_level = 1,
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_lib", version = "3.7.2")

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

_BASE = "https://github.com/theblixguy/swift-bylaws/releases/download/v0.4.0"

http_archive(
    name = "bylaws_macos",
    sha256 = "5bbcf67d3132fcd9d5cb38306b9e583ec2b305c0321dfe0ced09028ef20a34fa",
    urls = [_BASE + "/bylaws-macos.tar.gz"],
)

http_archive(
    name = "bylaws_linux",
    sha256 = "8c364506efe128a8f88925c5c51a4e96ad3b0ffb002b590c50153e6cfcddb4fc",
    urls = [_BASE + "/bylaws-linux.tar.gz"],
)
