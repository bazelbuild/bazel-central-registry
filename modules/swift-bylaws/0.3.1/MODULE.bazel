module(
    name = "swift-bylaws",
    version = "0.3.1",
    compatibility_level = 1,
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_lib", version = "3.7.2")

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

_BASE = "https://github.com/theblixguy/swift-bylaws/releases/download/v0.3.1"

http_archive(
    name = "bylaws_macos",
    sha256 = "deac9ecf192fed7741dfc5dbc8dba165932b621923b30e1977216e56e89e7148",
    urls = [_BASE + "/bylaws-macos.tar.gz"],
)

http_archive(
    name = "bylaws_linux",
    sha256 = "862dcbfa2cb09793778a6f1ed9e8d7d5db61495f1b75e9131409e615d13cd6bf",
    urls = [_BASE + "/bylaws-linux.tar.gz"],
)
