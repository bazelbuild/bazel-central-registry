module(
    name = "swift-bylaws",
    version = "0.5.0",
    compatibility_level = 1,
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_lib", version = "3.7.2")

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

_BASE = "https://github.com/theblixguy/swift-bylaws/releases/download/v0.5.0"

http_archive(
    name = "bylaws_macos",
    sha256 = "b6d730dfbdd84a155ca27647385a58e932d443edced13557bf3dac42d3e045fb",
    urls = [_BASE + "/bylaws-macos.tar.gz"],
)

http_archive(
    name = "bylaws_linux",
    sha256 = "9f6a6f59646ff190a2ec66625e9d93f857adbb52f3fb09a56e6ddfe971232e18",
    urls = [_BASE + "/bylaws-linux.tar.gz"],
)
