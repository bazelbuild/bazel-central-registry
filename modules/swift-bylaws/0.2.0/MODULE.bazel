module(
    name = "swift-bylaws",
    version = "0.2.0",
    compatibility_level = 1,
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_lib", version = "3.7.2")

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

_BASE = "https://github.com/theblixguy/swift-bylaws/releases/download/v0.2.0"

http_archive(
    name = "bylaws_macos",
    sha256 = "28204acf871285e21ea5478a14b001f5d723fb5062c6d79c0234e4c0d55bc1fd",
    urls = [_BASE + "/bylaws-macos.tar.gz"],
)

http_archive(
    name = "bylaws_linux",
    sha256 = "d7841bc99dd78853d1207ddc069128c62e9edf474ac11823188bf3ac1292f5b6",
    urls = [_BASE + "/bylaws-linux.tar.gz"],
)
