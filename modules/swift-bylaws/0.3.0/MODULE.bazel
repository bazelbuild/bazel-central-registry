module(
    name = "swift-bylaws",
    version = "0.3.0",
    compatibility_level = 1,
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_lib", version = "3.7.2")

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

_BASE = "https://github.com/theblixguy/swift-bylaws/releases/download/v0.3.0"

http_archive(
    name = "bylaws_macos",
    sha256 = "c9397457956f6d3efedd2f8ff182f42287092e138741e0a15299d510b8b98a30",
    urls = [_BASE + "/bylaws-macos.tar.gz"],
)

http_archive(
    name = "bylaws_linux",
    sha256 = "4c71d2c8ff91f3c14b0d3bcba023473818e476169811f4177b2abda23b83e392",
    urls = [_BASE + "/bylaws-linux.tar.gz"],
)
