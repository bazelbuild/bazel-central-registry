module(
    name = "swift-bylaws",
    version = "0.6.1",
    compatibility_level = 1,
)

bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "bazel_lib", version = "3.7.2")

http_archive = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:http.bzl",
    "http_archive",
)

_BASE = "https://github.com/theblixguy/swift-bylaws/releases/download/v0.6.1"

http_archive(
    name = "bylaws_macos",
    sha256 = "d32e8deaa578fc219317c2679896be5921797d5e71a3cf38cbfa9b4ea3b20f73",
    urls = [_BASE + "/bylaws-macos.tar.gz"],
)

http_archive(
    name = "bylaws_linux",
    sha256 = "e6a7b6e7830d8184acb4d11b164523627012e8d32ea732ea2b195f8a290ea036",
    urls = [_BASE + "/bylaws-linux.tar.gz"],
)
