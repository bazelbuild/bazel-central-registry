module(name = "platforms_contrib",
    version = "1.0.0-alpha.0",
)

bazel_dep(name = "bazel_features", version = "1.52.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "package_metadata", version = "0.0.7")
bazel_dep(name = "platforms", version = "1.1.0")

bazel_dep(name = "rules_testing", version = "0.9.0", dev_dependency = True)

host_detection = use_extension("//private:host_detection.bzl", "host_detection")
use_repo(host_detection, "cpu_feature_constraints", "detect_cpu_linux_x86_64", "detect_cpu_osx_x86_64", "detect_cpu_windows_x86_64", "libc_constraints")

# Dependencies for cross-compiling CPU feature detectors in //prebuilt.

bazel_dep(name = "llvm", version = "0.8.24", dev_dependency = True)
bazel_dep(name = "rules_cc", version = "0.2.25", dev_dependency = True)
bazel_dep(name = "with_cfg.bzl", version = "1.0.1", dev_dependency = True)

# Dev-only extension metadata fix, pending the next release.
git_override(
    module_name = "llvm",
    commit = "213de229b806db60e14276d094f99894b9fa57c3",
    remote = "https://github.com/hermeticbuild/hermetic-llvm.git",
)

llvm = use_extension("@llvm//extensions:llvm.bzl", "llvm", dev_dependency = True)
llvm.version(llvm_version = "23.1.2")
use_repo(llvm, "llvm-project")

register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)
