module(
    name = "rules_fusesoc",
    version = "2.0.0",
)

bazel_dep(name = "rules_python", version = "2.3.3")
bazel_dep(name = "rules_shell", version = "0.8.0")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "rules_shar", version = "1.2.0")
bazel_dep(name = "rules_pkg", version = "1.3.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "rules_go", version = "0.63.0")

# The C toolchain, for the Go binaries' link step and for anything else
# that compiles. A dev dependency: a consumer of these rules builds no C or
# Go here, it downloads the released binaries.
bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0", dev_dependency = True)

zig = use_extension(
    "@hermetic_cc_toolchain//toolchain:ext.bzl",
    "toolchains",
    dev_dependency = True,
)
use_repo(zig, "zig_sdk")

register_toolchains(
    "@zig_sdk//toolchain/...",
    "@zig_sdk//libc_aware/toolchain/...",
    dev_dependency = True,
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.from_file(go_mod = "//:go.mod")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "in_gopkg_yaml_v3")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "pypi",
    python_version = "3.11",
    requirements_lock = "//third_party/fusesoc:requirements_lock.txt",
)
use_repo(pip, "pypi")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.defaults(python_version = "3.11")
python.toolchain(python_version = "3.11")
