load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

_COPTS = [
    "-DSASR",
    "-DWAV49",
    "-DNeedFunctionPrototypes=1",
]

cc_library(
    name = "gsm",
    srcs = [
        "src/add.c",
        "src/code.c",
        "src/debug.c",
        "src/decode.c",
        "src/gsm_create.c",
        "src/gsm_decode.c",
        "src/gsm_destroy.c",
        "src/gsm_encode.c",
        "src/gsm_explode.c",
        "src/gsm_implode.c",
        "src/gsm_option.c",
        "src/gsm_print.c",
        "src/long_term.c",
        "src/lpc.c",
        "src/preprocess.c",
        "src/rpe.c",
        "src/short_term.c",
        "src/table.c",
    ] + glob(["inc/*.h"]),
    hdrs = ["inc/gsm.h"],
    copts = _COPTS,
    include_prefix = "gsm",
    includes = ["inc"],
    strip_include_prefix = "inc",
)

cc_library(
    name = "add_test_sources",
    testonly = True,
    textual_hdrs = ["src/add.c"] + glob(["inc/*.h"]),
    visibility = ["//visibility:private"],
)

cc_test(
    name = "add_test",
    srcs = ["add-test/add_test.c"],
    args = ["$(location add-test/add_test.dta)"],
    copts = _COPTS,
    data = ["add-test/add_test.dta"],
    includes = ["inc"],
    deps = [":add_test_sources"],
)
