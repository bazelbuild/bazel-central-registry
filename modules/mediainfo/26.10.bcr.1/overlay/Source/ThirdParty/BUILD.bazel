load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//licenses/rules:license_kind.bzl", "license_kind")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:defs.bzl", "cc_library")

_MEDIAINFO_VERSION = module_version().split(".bcr.")[0]

license(
    name = "aes_gladman_license",
    kind = "@package_metadata//licenses/spdx:Brian-Gladman-2-Clause",
    text = "LICENSE.aes-gladman",
)

package_metadata(
    name = "aes_gladman_metadata",
    attributes = [":aes_gladman_license"],
    purl = "pkg:generic/mediainfo/aes-gladman@" + _MEDIAINFO_VERSION,
)

filegroup(
    name = "aes_gladman_srcs",
    srcs = [
        "aes-gladman/aes_modes.c",
        "aes-gladman/aes_ni.c",
        "aes-gladman/aescrypt.c",
        "aes-gladman/aeskey.c",
        "aes-gladman/aestab.c",
    ],
    applicable_licenses = [":aes_gladman_metadata"],
    visibility = ["//Source:__pkg__"],
)

cc_library(
    name = "brg",
    hdrs = [
        "aes-gladman/brg_endian.h",
        "aes-gladman/brg_types.h",
    ],
    applicable_licenses = [":aes_gladman_metadata"],
    includes = ["aes-gladman"],
    visibility = ["//Source:__pkg__"],
)

cc_library(
    name = "aes",
    hdrs = [
        "aes-gladman/aes.h",
        "aes-gladman/aes_ni.h",
        "aes-gladman/aes_via_ace.h",
        "aes-gladman/aescpp.h",
        "aes-gladman/aesopt.h",
        "aes-gladman/aestab.h",
    ],
    applicable_licenses = [":aes_gladman_metadata"],
    includes = ["aes-gladman"],
    visibility = ["//Source:__pkg__"],
    deps = [":brg"],
)

# No license attribute: base64.h names its author but grants no license.
package_metadata(
    name = "base64_metadata",
    purl = "pkg:generic/mediainfo/base64@" + _MEDIAINFO_VERSION,
)

cc_library(
    name = "base64",
    hdrs = ["base64/base64.h"],
    applicable_licenses = [":base64_metadata"],
    includes = ["base64"],
    visibility = ["//Source:__pkg__"],
)

license(
    name = "fmt_license",
    # The notice's optional exception has no SPDX identifier.
    kind = "@package_metadata//licenses/spdx:MIT",
    text = "LICENSE.fmt",
)

package_metadata(
    name = "fmt_metadata",
    attributes = [":fmt_license"],
    purl = "pkg:github/fmtlib/fmt@11.2.1",  # FMT_VERSION in fmt/base.h
)

filegroup(
    name = "fmt_srcs",
    srcs = ["fmt/format.cc"],
    applicable_licenses = [":fmt_metadata"],
    visibility = ["//Source:__pkg__"],
)

cc_library(
    name = "fmt",
    hdrs = [
        "fmt/base.h",
        "fmt/format.h",
        "fmt/format-inl.h",
    ],
    applicable_licenses = [":fmt_metadata"],
    # Not local_defines: format.cc compiles in //Source:mediainfo and needs it too. Without it base.h static_asserts
    # that MSVC builds use /utf-8; upstream's CMake sets it PRIVATE.
    defines = ["FMT_UNICODE=0"],
    includes = ["."],
    visibility = ["//Source:__pkg__"],
)

