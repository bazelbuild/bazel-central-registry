load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:defs.bzl", "cc_test")

alias(
    name = "mediainfo",
    actual = "//Source:mediainfo",
    visibility = ["//visibility:public"],
)

# Fails only if the library can't open the file or writes an empty report; it doesn't check the parse.
cc_test(
    name = "analyze_test",
    srcs = ["Project/GNU/Library/test/Source/analyze.cpp"],
    args = [
        "$(rootpath Release/Example.ogg)",
        "analyze_out.xml",
    ],
    copts = select({
        "@rules_cc//cc/compiler:msvc-cl": [],
        "@rules_cc//cc/compiler:clang-cl": [],
        "//conditions:default": ["-std=c++11"],  # test/Makefile.am AM_CXXFLAGS
    }),
    data = ["Release/Example.ogg"],
    deps = [
        ":mediainfo",
        "@zenlib//:zen",  # analyze.cpp includes ZenLib/ directly
    ],
)

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:BSD-2-Clause",
    text = "LICENSE",
    visibility = ["//visibility:public"],
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)
