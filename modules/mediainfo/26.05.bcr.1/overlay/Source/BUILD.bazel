        "MediaInfo/Video/File_Vc3.cpp",
        "MediaInfo/Video/File_Vc3.h",
        "MediaInfo/Video/File_Vp8.cpp",
        "MediaInfo/Video/File_Vp8.h",
        "MediaInfo/Video/File_Vp9.cpp",
        "MediaInfo/Video/File_Vp9.h",
        "MediaInfo/Video/File_Vvc.cpp",
        "MediaInfo/Video/File_Vvc.h",
        "MediaInfo/Video/File_Y4m.cpp",
        "MediaInfo/Video/File_Y4m.h",
        "MediaInfo/XmlUtils.cpp",
        "MediaInfo/XmlUtils.h",
        "MediaInfoDLL/MediaInfoDLL.cpp",
        "MediaInfoDLL/MediaInfoJNI.cpp",
        "//Source/ThirdParty:srcs",
    ],
    # The headers Makefile.am installs: MediaInfo/ always (:260-265), MediaInfoDLL/ under COMPILE_DLL (:272-275),
    # which configure enables by default (configure.ac:67,403). Less MediaInfoDLL.h, a header-only loader that
    # dlopens the shared libmediainfo at run time, which this target does not build. The library's other headers
    # are build-internal: private in srcs above, or in //Source/ThirdParty.
    hdrs = [
        "MediaInfo/MediaInfo.h",
        "MediaInfo/MediaInfoList.h",
        "MediaInfo/MediaInfo_Const.h",
        "MediaInfo/MediaInfo_Events.h",
        "MediaInfoDLL/MediaInfoDLL_Static.h",
    ],
    # cxxopts not copts: AM_CXXFLAGS is C++-only, the bundled ThirdParty C units carry no -std upstream, and a
    # C compile rejects a C++ -std flag.
    cxxopts = select({
        "@rules_cc//cc/compiler:msvc-cl": [],
        "@rules_cc//cc/compiler:clang-cl": [],
        "//conditions:default": ["-std=c++11"],  # AM_CXXFLAGS
    }),
    # zlib is link-only for consumers: libmediainfo.pc.in carries -lz (:14) but no Requires: zlib (:12), and no
    # installed header includes zlib.h. An edge rather than a -lz linkopt.
    implementation_deps = [
        "//Source/ThirdParty:aes",
        "//Source/ThirdParty:base64",
        "//Source/ThirdParty:brg",
        "//Source/ThirdParty:fmt",
        "//Source/ThirdParty:hmac",
        "//Source/ThirdParty:jni",
        "//Source/ThirdParty:md5",
        "//Source/ThirdParty:sha1",
        "//Source/ThirdParty:sha2",
        "//Source/ThirdParty:tfsxml",
        "//Source/ThirdParty:tinyxml2",
        "@zlib",
    ],
    includes = ["."],
    # configure disables these by default (--with-graphviz/libcurl/libmms = no); without them Setup.h derives
    # the _YES form and the TUs pull in gvc.h / curl/curl.h / libmms headers (Reader_libcurl/libmms self-guard
    # to empty). All build-internal. Not set: MEDIAINFO_MD5/SHA1/SHA2/AES (Setup.h derives them to 1) and any
    # zlib macro (header + link edge suffice) -- asserting either would re-encode a fact the library headers
    # already carry.
    local_defines = [
        "MEDIAINFO_GRAPHVIZ_NO",
        "MEDIAINFO_LIBCURL_NO",
        "MEDIAINFO_LIBMMS_NO",
    ] + select({
        # MediaInfoDLL_Static.h marks the C API dllexport for MediaInfoDLL.cpp under MSVC-style toolchains; in a
        # static archive that re-exports it from any binary linking those objects. Upstream's own MSVC DLL project
        # sets this to suppress it (Project/MSVC2022/Dll/MediaInfoDll.vcxproj:182). MinGW never takes that path.
        "@rules_cc//cc/compiler:msvc-cl": ["MEDIAINFODLL_EXPORTS_NODLLEXPORT"],
        "@rules_cc//cc/compiler:clang-cl": ["MEDIAINFODLL_EXPORTS_NODLLEXPORT"],
        "//conditions:default": [],
    }),
    visibility = ["//:__pkg__"],
    # Public: MediaInfo_Const.h:20 includes <ZenLib/Conf.h> (the .pc's Requires: libzen), and @zenlib//:zen
    # propagates the UNICODE/_UNICODE defines whose wide-Ztring ABI consumers must match, so they are not repeated
    # here.
    deps = ["@zenlib//:zen"],
)
