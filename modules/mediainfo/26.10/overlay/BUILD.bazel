load("@rules_cc//cc:defs.bzl", "cc_test")

alias(
    name = "mediainfo",
    actual = "//Source:mediainfo",
    visibility = ["//visibility:public"],
)

# MediaInfoLib's own check harness (mil_analyze) on the in-archive Release/Example.ogg -- a hermetic stand-in
# for `make check`, whose shell tests need xmllint and network-fetched .xsd schemas. analyze.cpp exits
# non-zero only if the library cannot open the file or writes an empty report, so a pass shows the archive links
# and runs, not that it recognized Ogg/Vorbis.
cc_test(
    name = "analyze_test",
    srcs = ["Project/GNU/Library/test/Source/analyze.cpp"],
    args = [
        "$(rootpath Release/Example.ogg)",
        "analyze_out.xml",
    ],
    copts = select({
        "@rules_cc//cc/compiler:msvc-cl": [],
        "@rules_cc//cc/compiler:clang-cl": [],
        "//conditions:default": ["-std=c++11"],  # test/Makefile.am AM_CXXFLAGS
    }),
    data = ["Release/Example.ogg"],
    deps = [
        ":mediainfo",
        "@zenlib//:zen",  # analyze.cpp includes ZenLib/ directly
    ],
)
