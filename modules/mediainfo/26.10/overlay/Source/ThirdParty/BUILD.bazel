load("@rules_cc//cc:defs.bzl", "cc_library")

# The libraries MediaInfoLib bundles. configure defaults each --with-lib* to the internal copy (md5's branch in
# configure.ac is typical); fmt, tfsxml, base64 and jni have no --with-lib* switch. Header-only targets carrying the
# configure.ac -I dir where one exists (added to CFLAGS/CXXFLAGS, never to the .pc's Cflags) and their include edges.
# Their includes and defines propagate to every dependent, so they stay off consumers' compiles only through
# implementation_deps.

# Makefile.am builds these into libmediainfo itself, so the library target compiles them rather than a cc_library here
# producing an archive of its own.
filegroup(
    name = "srcs",
    srcs = [
        "aes-gladman/aes_modes.c",
        "aes-gladman/aes_ni.c",
        "aes-gladman/aescrypt.c",
        "aes-gladman/aeskey.c",
        "aes-gladman/aestab.c",
        "fmt/format.cc",
        "hmac-gladman/hmac.c",
        "md5/md5.c",
        "sha1-gladman/sha1.c",
        "sha2-gladman/sha2.c",
        "tfsxml/tfsxml.c",
        "tinyxml2/tinyxml2.cpp",
    ],
    visibility = ["//Source:__pkg__"],
)

# aes-gladman's byte-order and integer-type headers, shared with sha1/sha2. Visible to //Source as well: sha1.c and
# sha2.c in :srcs include brg_endian.h directly.
cc_library(
    name = "brg",
    hdrs = [
        "aes-gladman/brg_endian.h",
        "aes-gladman/brg_types.h",
    ],
    includes = ["aes-gladman"],
    visibility = ["//Source:__pkg__"],
)

cc_library(
    name = "aes",
    hdrs = [
        "aes-gladman/aes.h",
        "aes-gladman/aes_ni.h",
        "aes-gladman/aes_via_ace.h",
        "aes-gladman/aescpp.h",
        "aes-gladman/aesopt.h",
        "aes-gladman/aestab.h",
    ],
    includes = ["aes-gladman"],
    visibility = ["//Source:__pkg__"],
    deps = [":brg"],
)

cc_library(
    name = "base64",
    hdrs = ["base64/base64.h"],
    includes = ["base64"],
    visibility = ["//Source:__pkg__"],
)

# FMT_UNICODE=0 sits on the headers, not the library's local_defines, so it reaches every dependent compile, format.cc
# in :srcs included. MediaInfoLib's CMake sets it PRIVATE (Project/CMake/CMakeLists.txt); without it base.h
# static_asserts that Windows builds use /utf-8.
cc_library(
    name = "fmt",
    hdrs = [
        "fmt/base.h",
        "fmt/format.h",
        "fmt/format-inl.h",
    ],
    defines = ["FMT_UNICODE=0"],
    includes = ["."],
    visibility = ["//Source:__pkg__"],
)

cc_library(
    name = "hmac",
    hdrs = [
        "hmac-gladman/hmac.h",
        "hmac-gladman/pwd2key.h",
    ],
    includes = ["hmac-gladman"],
    visibility = ["//Source:__pkg__"],
    deps = [
        ":sha1",
        ":sha2",
    ],
)

cc_library(
    name = "jni",
    hdrs = ["jni/jni.h"],
    visibility = ["//Source:__pkg__"],
)

cc_library(
    name = "md5",
    hdrs = ["md5/md5.h"],
    includes = ["md5"],
    visibility = ["//Source:__pkg__"],
)

cc_library(
    name = "sha1",
    hdrs = ["sha1-gladman/sha1.h"],
    includes = ["sha1-gladman"],
    visibility = ["//Source:__pkg__"],
    deps = [":brg"],
)

cc_library(
    name = "sha2",
    hdrs = ["sha2-gladman/sha2.h"],
    includes = ["sha2-gladman"],
    visibility = ["//Source:__pkg__"],
    deps = [":brg"],
)

cc_library(
    name = "tfsxml",
    hdrs = ["tfsxml/tfsxml.h"],
    visibility = ["//Source:__pkg__"],
)

cc_library(
    name = "tinyxml2",
    hdrs = ["tinyxml2/tinyxml2.h"],
    includes = ["tinyxml2"],
    visibility = ["//Source:__pkg__"],
)
