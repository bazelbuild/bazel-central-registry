single_version_override(
    module_name = "zlib",
    patch_strip = 1,
    patches = ["//third_party/patches:zlib-detect-unistd.patch"],
    version = "1.3.2",
)

# brotli is required by @woff2 (see non_bcr_deps.bzl); text-full only.
bazel_dep(name = "brotli", version = "1.2.0.bcr.3")

