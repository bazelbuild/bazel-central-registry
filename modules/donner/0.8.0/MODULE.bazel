# spirv-val, built from source through Bazel so the SPIR-V validation suite is
# hermetic. A host-installed validator made the check depend on which lane it
# landed on, and a lane without it validated nothing.
bazel_dep(name = "spirv_tools", version = "2026.1", dev_dependency = True)

# `spirv-val` uses std::filesystem, which pulls libc++'s operations.cpp into the
# link, and that object's unversioned `copy_file_range` does not resolve against
# the hermetic toolchain's sysroot. The patch links the same shim
# `donner_cc_binary` already injects into our own binaries for this reason.
single_version_override(
    module_name = "spirv_tools",
    patch_strip = 1,
    patches = ["//third_party/patches:spirv-tools-spirv-val-libc-compat.patch"],
    version = "2026.1",
)

