# The wgpu-native prebuilts are fetched via the non_bcr_deps module extension
# declared above — they are not available when donner is consumed from BCR. The
# resvg-test-suite goldens are now vendored in-tree under
# third_party/resvg-test-suite/ so they ship in the source archive.

bazel_dep(name = "rules_python", version = "2.4.2", dev_dependency = True)

# Hermetic Python toolchain. Without this, rules_python's py_binary targets
# fall back to `/usr/bin/env python3` on the host — which is fine for local
# development, but a remote-execution sandbox may have no such host
# interpreter available. Registering `python.toolchain()` makes
# rules_python ship a prebuilt CPython through the action cache so RE
# workers execute the same interpreter as local builds.
python = use_extension(
    "@rules_python//python/extensions:python.bzl",
    "python",
    dev_dependency = True,
)
python.defaults(python_version = "3.12")
python.toolchain(python_version = "3.12")
use_repo(python, "python_3_12")

#
# Toolchain
#

bazel_dep(name = "toolchains_llvm", version = "1.11.2", dev_dependency = True)

# Declare only the libc++ headers, not all of the LLVM distribution's include/, as compile inputs.
# Only Bazel releases before 9 read the patched filegroup. No version is set here, so the patch
# applies to whichever release the bazel_dep above resolves to.
single_version_override(
    module_name = "toolchains_llvm",
    patch_strip = 1,
    patches = ["//third_party/patches:toolchains_llvm-libcxx-compile-headers.patch"],
)

# To use a local copy of the toolchains_llvm repository, comment out the single_version_override
# above (a module takes only one override, and the local copy does not get the patch), then
# uncomment the following.
# local_path_override(
#     module_name = "toolchains_llvm",
#     path = "../toolchains_llvm",
# )

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm", dev_dependency = True)

# Default host-detected toolchain for local builds. Keep the repo names stable
# for existing labels such as `@llvm_toolchain_llvm`.
llvm.toolchain(
    name = "llvm_toolchain",
    llvm_version = "21.1.6",
)

# Remote execution needs exec-platform-specific LLVM downloads. Otherwise a
# macOS client can upload a Mach-O clang to a Linux worker.
llvm.toolchain(
    name = "llvm_toolchain_linux_aarch64",
    exec_arch = "aarch64",
    exec_os = "linux",
    llvm_version = "21.1.6",
)

# Keep the Linux x86_64 variant ready for future workers and local parity.
llvm.toolchain(
    name = "llvm_toolchain_linux_x86_64",
    exec_arch = "x86_64",
    exec_os = "linux",
    llvm_version = "21.1.6",
)

# Hermetic Linux sysroots for each toolchain above, which keep the toolchain
# self-contained on remote-execution workers without system glibc headers.
# Compiles and links take only the sysroot files they read; see
# third_party/bazel/non_bcr_deps.bzl. The tags are spelled out with literal
# names because tools/bcr_dependency_closure.py reads them statically.
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot_linux_aarch64//:sysroot",
    targets = ["linux-aarch64"],
)
llvm.sysroot(
    name = "llvm_toolchain",
    label = "@sysroot_linux_x86_64//:sysroot",
    targets = ["linux-x86_64"],
)
llvm.extra_compiler_files(
    name = "llvm_toolchain",
    label = "@sysroot_linux_aarch64//:compiler_files",
    targets = ["linux-aarch64"],
)
llvm.extra_compiler_files(
    name = "llvm_toolchain",
    label = "@sysroot_linux_x86_64//:compiler_files",
    targets = ["linux-x86_64"],
)
llvm.extra_linker_files(
    name = "llvm_toolchain",
    label = "@sysroot_linux_aarch64//:linker_files",
    targets = ["linux-aarch64"],
)
llvm.extra_linker_files(
    name = "llvm_toolchain",
