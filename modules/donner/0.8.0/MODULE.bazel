bazel_dep(name = "rules_license", version = "1.0.0")

# Vulkan-Headers for the donner/gpu Vulkan backend. Headers only: the backend
# compiles everywhere and opens the Vulkan loader at run time instead of linking
# it, so a build needs no Vulkan library; Linux products and tests execute it.
bazel_dep(name = "vulkan_headers", version = "1.4.349")
bazel_dep(name = "freetype", version = "2.13.3.bcr.1")
bazel_dep(name = "libpng", version = "1.6.58.bcr.1")

# Enable FreeType's PNG support for CBDT color emoji bitmaps, and drop the font drivers and
# renderers Donner cannot reach: FontManager admits only sfnt, WOFF and WOFF2 data, so the PFR,
# Type 42, Windows FNT, PCF and BDF drivers never match, and nothing requests SDF rendering.
single_version_override(
    module_name = "freetype",
    patch_strip = 1,
    patches = [
        "//third_party/patches:freetype-enable-png-module.patch",
        "//third_party/patches:freetype-enable-png-build.patch",
        "//third_party/patches:freetype-trim-unreachable-modules.patch",
    ],
    version = "2.13.3.bcr.1",
)

# entt is vendored as a git subtree under third_party/entt (pinned at upstream
# tag v3.16.0). Using local_repository keeps entt's own BUILD.bazel, which
# already exposes an `//:entt` alias to `//src:entt`. When we need to bump
# entt, use `git subtree pull --prefix=third_party/entt https://github.com/skypjack/entt <tag> --squash`.
local_repository(
    name = "entt",
    path = "third_party/entt",
)

local_repository(
    name = "frozen",
    path = "third_party/frozen",
)

new_local_repository(
    name = "stb",
    build_file = "//third_party:BUILD.stb",
    path = "third_party/stb",
)

