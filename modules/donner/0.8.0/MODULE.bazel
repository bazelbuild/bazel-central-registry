# Do not register a macOS LLVM exec variant. //donner/editor needs ObjC for
# glfw's Cocoa backend, so macOS exec uses apple_support's Xcode toolchain.

use_repo(
    llvm,
    "llvm_toolchain",
    "llvm_toolchain_linux_aarch64",
    "llvm_toolchain_linux_x86_64",
    "llvm_toolchain_llvm",
)

# NOTE: To use any of these toolchains specify --config=latest_llvm (which
# registers them via --extra_toolchains in .bazelrc). No platform enables it by
# default: builds use the host Clang unless that config is passed, and macOS
# always keeps the Xcode toolchain.
# register_toolchains("@llvm_toolchain//:all", dev_dependency = True)

bazel_dep(name = "zstd", version = "1.5.7.bcr.3", dev_dependency = True)

#
# Devtools
#

# Hedron's Compile Commands Extractor for Bazel
# https://github.com/hedronvision/bazel-compile-commands-extractor
bazel_dep(name = "hedron_compile_commands", dev_dependency = True)
git_override(
    module_name = "hedron_compile_commands",
    commit = "abb61a688167623088f8768cc9264798df6a9d10",
    remote = "https://github.com/hedronvision/bazel-compile-commands-extractor",
)

bazel_dep(name = "rules_proto", version = "7.1.0", dev_dependency = True)
bazel_dep(name = "protobuf", version = "30.2", dev_dependency = True)
single_version_override(
    module_name = "protobuf",
    version = "30.2",
)

bazel_dep(name = "bloaty", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "bloaty",
    commit = "a655c418811ef5097e37a562ce62f925bda72d88",
    remote = "https://github.com/jwmcglynn/bloaty",
)

#
# WebAssembly (Emscripten SDK)
#

bazel_dep(name = "emsdk", version = "5.0.5", dev_dependency = True)

# Keep Python runnable remotely and declare Closure's execution-platform Java runtime.
single_version_override(
    module_name = "emsdk",
    patch_strip = 1,
    patches = [
        "//third_party/patches:emsdk_env_sh_dyld_library_path.patch",
        "//third_party/patches:emsdk_declared_java_runtime.patch",
    ],
    version = "5.0.5",
)

#
# SVG Viewer
#

bazel_dep(name = "imgui", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "imgui",
    commit = "ee1deccc08c14ab1e6abcfa6aae11d915763cdb7",
    patch_strip = 1,
    patches = [
        "//third_party/patches:imgui_bazel_build_files.patch",
        "//third_party/patches:imgui-explicit-raw-memory.patch",
        # Match DragScalar's resting label to its left-aligned temporary text editor.
        "//third_party/patches:imgui-left-align-drag-values.patch",
    ],
    remote = "https://github.com/ocornut/imgui",
)

bazel_dep(name = "glfw", version = "0.0.0", dev_dependency = True)
git_override(
    module_name = "glfw",
    commit = "92dcf4ce74f2e2554a98fea09be7c705c17daa5a",
    patch_strip = 1,
    patches = [
        "//third_party/patches:glfw_bazel_build_files.patch",
    ],
    remote = "https://github.com/glfw/glfw",
)
