load("@rules_cc//cc:cc_library.bzl", "cc_library")

# The sequential solver library (core + simp), without the stand-alone
# Main.cc drivers or the parallel solver.
cc_library(
    name = "glucose",
    srcs = [
        "core/Solver.cc",
        "core/lcm.cc",
        "simp/SimpSolver.cc",
        "utils/Options.cc",
        "utils/System.cc",
        # Included only from the .cc files.
        "mtl/Sort.h",
    ],
    # Everything reachable from simp/SimpSolver.h, plus the DIMACS reader
    # and the timing helpers the drivers use. mtl/VecThreads.h belongs to
    # the parallel solver, which is not built.
    hdrs = [
        "core/BoundedQueue.h",
        "core/Constants.h",
        "core/Dimacs.h",
        "core/Solver.h",
        "core/SolverStats.h",
        "core/SolverTypes.h",
        "mtl/Alg.h",
        "mtl/Alloc.h",
        "mtl/Clone.h",
        "mtl/Heap.h",
        "mtl/IntTypes.h",
        "mtl/Map.h",
        "mtl/Queue.h",
        "mtl/Vec.h",
        "mtl/XAlloc.h",
        "simp/SimpSolver.h",
        "utils/Options.h",
        "utils/ParseUtils.h",
        "utils/System.h",
    ],
    copts = ["-Wno-parentheses"],
    includes = ["."],
    linkopts = ["-lpthread"],
    visibility = ["//visibility:public"],
    deps = ["@zlib"],
)
