load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# The sequential solver library (core + simp), without the stand-alone
# Main.cc drivers or the parallel solver.
cc_library(
    name = "glucose",
    srcs = [
        "core/Solver.cc",
        "core/lcm.cc",
        "simp/SimpSolver.cc",
        "utils/Options.cc",
        "utils/System.cc",
        # Included only from the .cc files. core/Dimacs.h, used only by
        # the drivers, is left out.
        "mtl/Sort.h",
        "utils/System.h",
    ],
    # The public API: the solvers, the literal and value types, and vec<Lit>
    # for clauses and assumptions.
    hdrs = [
        "core/Solver.h",
        "core/SolverTypes.h",
        "mtl/Vec.h",
        "simp/SimpSolver.h",
    ],
    copts = ["-Wno-parentheses"],
    includes = ["."],
    linkopts = ["-lpthread"],
    # Included by the public headers, but not part of the API.
    # mtl/VecThreads.h belongs to the parallel solver, which is not built.
    textual_hdrs = [
        "core/BoundedQueue.h",
        "core/Constants.h",
        "core/SolverStats.h",
        "mtl/Alg.h",
        "mtl/Alloc.h",
        "mtl/Clone.h",
        "mtl/Heap.h",
        "mtl/IntTypes.h",
        "mtl/Map.h",
        "mtl/Queue.h",
        "mtl/XAlloc.h",
        "utils/Options.h",
        "utils/ParseUtils.h",
    ],
    visibility = ["//visibility:public"],
    deps = ["@zlib"],
)

# Solves a satisfiable and an unsatisfiable instance through the public API.
cc_test(
    name = "solver_test",
    size = "small",
    srcs = ["solver_test.cc"],
    deps = [":glucose"],
)
