    name = "gvc_inc",
    includes = ["lib/gvc"],
)

cc_library(
    name = "pack_inc",
    includes = ["lib/pack"],
)

cc_library(
    name = "gvpr_inc",
    includes = ["lib/gvpr"],
)

# Pre-baked version headers at the tarball root.
