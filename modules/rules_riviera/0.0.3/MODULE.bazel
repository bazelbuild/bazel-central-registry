"""rules_riviera"""

module(
    name = "rules_riviera",
    version = "0.0.3",
    bazel_compatibility = [">=8.0.0"],
)

bazel_dep(name = "bazel_features", version = "1.50.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_rust", version = "0.75.0")
bazel_dep(name = "rules_shell", version = "0.7.1")
bazel_dep(name = "rules_verilog", version = "1.4.3")
bazel_dep(name = "rules_vhdl", version = "0.4.1")

bazel_dep(name = "rules_rust_mdbook", version = "0.75.0", dev_dependency = True)
bazel_dep(name = "stardoc", version = "0.8.0", dev_dependency = True, repo_name = "io_bazel_stardoc")

single_version_override(
    module_name = "protobuf",
    patch_strip = 1,
    patches = ["//tools/patches:protobuf-auto-exec-groups.patch"],
    version = "33.4",
)

rust = use_extension("@rules_rust//rust:extensions.bzl", "rust", dev_dependency = True)
rust.toolchain(edition = "2021")
use_repo(rust, "rust_toolchains")

register_toolchains(
    "@rust_toolchains//:all",
    dev_dependency = True,
)

crate = use_extension("@rules_rust//crate_universe:extensions.bzl", "crate")
crate.from_cargo(
    name = "crates",
    cargo_lockfile = "//:Cargo.lock",
    lockfile = "//:cargo-bazel-lock.json",
    manifests = ["//:Cargo.toml"],
)
use_repo(crate, "crates")

register_toolchains(
    "//tests/toolchains:riviera_toolchain",
    dev_dependency = True,
)
