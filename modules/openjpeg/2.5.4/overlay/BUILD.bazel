load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")

package(default_visibility = ["//visibility:public"])

cc_library(
    name = "openjp2",
    srcs = [
        "src/lib/openjp2/bio.c",
        "src/lib/openjp2/cio.c",
        "src/lib/openjp2/dwt.c",
        "src/lib/openjp2/event.c",
        "src/lib/openjp2/function_list.c",
        "src/lib/openjp2/ht_dec.c",
        "src/lib/openjp2/image.c",
        "src/lib/openjp2/invert.c",
        "src/lib/openjp2/j2k.c",
        "src/lib/openjp2/jp2.c",
        "src/lib/openjp2/mct.c",
        "src/lib/openjp2/mqc.c",
        "src/lib/openjp2/openjpeg.c",
        "src/lib/openjp2/opj_clock.c",
        "src/lib/openjp2/opj_malloc.c",
        "src/lib/openjp2/pi.c",
        "src/lib/openjp2/sparse_array.c",
        "src/lib/openjp2/t1.c",
        "src/lib/openjp2/t2.c",
        "src/lib/openjp2/tcd.c",
        "src/lib/openjp2/tgt.c",
        "src/lib/openjp2/thread.c",
    ] + glob(["src/lib/openjp2/*.h"]),
    hdrs = [
        "src/lib/openjp2/openjpeg.h",
        "src/lib/openjp2/opj_config.h",
    ],
    defines = select({
        "@platforms//os:windows": [
            "MUTEX_win32",
            "OPJ_STATIC",
        ],
        "//conditions:default": ["MUTEX_pthread"],
    }),
    includes = ["src/lib/openjp2"],
    linkopts = select({
        "@platforms//os:windows": [],
        "//conditions:default": [
            "-lm",
            "-pthread",
        ],
    }),
)

alias(
    name = "openjpeg",
    actual = ":openjp2",
)

cc_test(
    name = "sparse_array_test",
    srcs = ["src/lib/openjp2/test_sparse_array.c"],
    deps = [":openjp2"],
)

cc_library(
    name = "empty_image_test_sources",
    testonly = True,
    textual_hdrs = ["tests/unit/testempty1.c"],
    visibility = ["//visibility:private"],
    deps = [":openjp2"],
)

cc_test(
    name = "empty_image_test",
    srcs = ["tests/upstream_unit_test.c"],
    deps = [
        ":empty_image_test_sources",
        ":openjp2",
    ],
)
