module(
    name = "rules_openscad",
    version = "0.3",
)

# Bazel 9 removed the Python and shell rules from Bazel itself
bazel_dep(name = "rules_python", version = "2.4.6")
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)

# Only needed to generate the docs (//docs); no package a consumer loads depends on it.
bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)

# The sources of the test_models consumer workspace, so //tests/bazel_versions:bazel_*_test can copy them. They have to
# come in as a repo because test_models is a repo of its own, whose files can't be named as labels
# from this one. Explicit patterns, because the directory also holds bazel-* output symlinks.
new_local_repository = use_repo_rule(
    "@bazel_tools//tools/build_defs/repo:local.bzl",
    "new_local_repository",
)

new_local_repository(
    name = "test_models_src",
    build_file_content = """
filegroup(
    name = "files",
    srcs = glob([
        ".bazelrc",
        "*.scad",
        "BUILD",
        "MODULE.bazel",
        "testdata/**",
    ]),
    visibility = ["//visibility:public"],
)
""",
    dev_dependency = True,
    path = "test_models",
)
