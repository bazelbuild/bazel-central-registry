io/random_access_device.hpp and io/stream.hpp both use the include guard
BOOST_COBALT_IO_STREAM_HPP, so whichever is reached second expands to nothing.
io.hpp pulls in io/acceptor.hpp (and through it io/stream.hpp) before
io/random_access_device.hpp, leaving random_access_device undeclared by the
time io/random_access_file.hpp derives from it:

  random_access_file.hpp:26:1: error: expected class-name before '{' token

Backport of upstream commit 694d9c46114b (fixes boostorg/cobalt#247), which
gives the header its own guard. Applied verbatim.

diff --git a/include/boost/cobalt/io/random_access_device.hpp b/include/boost/cobalt/io/random_access_device.hpp
--- a/include/boost/cobalt/io/random_access_device.hpp
+++ b/include/boost/cobalt/io/random_access_device.hpp
@@ -5,8 +5,8 @@
 // file LICENSE_1_0.txt or copy at http://www.boost.org/LICENSE_1_0.txt)
 //
 
-#ifndef BOOST_COBALT_IO_STREAM_HPP
-#define BOOST_COBALT_IO_STREAM_HPP
+#ifndef BOOST_COBALT_IO_RANDOM_ACCESS_DEVICE_HPP
+#define BOOST_COBALT_IO_RANDOM_ACCESS_DEVICE_HPP
 
 #include <boost/cobalt/io/buffer.hpp>
 #include <boost/cobalt/io/ops.hpp>
@@ -34,4 +34,4 @@ struct random_access_device : random_access_read_device, random_access_write_dev
 
 }
 
-#endif //BOOST_COBALT_IO_STREAM_HPP
+#endif //BOOST_COBALT_IO_RANDOM_ACCESS_DEVICE_HPP
