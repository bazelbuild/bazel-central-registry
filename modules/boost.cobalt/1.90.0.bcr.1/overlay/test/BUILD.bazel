load(
    ":boost_test_suite.bzl",
    "CLANG_CORO_RAMP_UNWIND_WORKAROUND",
    "boost_test_impl",
    "boost_test_suite",
)

boost_test_impl()

# Upstream builds these without the shared Boost.Test main.
_STANDALONE = [
    "main.cpp",
    "main_compile.cpp",
]

# Compiled into main_compile rather than being tests of their own.
_COMPILE_PARTS = [
    "concepts.cpp",
    "util.cpp",
]

boost_test_suite(
    name = "upstream_tests",
    srcs = glob(
        ["*.cpp"],
        exclude = _STANDALONE + _COMPILE_PARTS + ["test_main.cpp"],
    ),
    # bad_executor_ makes a promise constructor throw.
    extra_copts = {"promise": CLANG_CORO_RAMP_UNWIND_WORKAROUND},
    deps = [
        ":test_impl",
        "@boost.test//:unit_test_main",
    ],
)

boost_test_suite(
    name = "upstream_experimental_tests",
    srcs = glob(["experimental/*.cpp"]),
    deps = [
        ":test_impl",
        "@boost.context",
        "@boost.test//:unit_test_main",
    ],
)

boost_test_suite(
    name = "upstream_io_tests",
    srcs = glob(["io/*.cpp"]),
    deps = [
        ":test_impl",
        "@boost.cobalt//:boost.cobalt.io",
        "@boost.test//:unit_test_main",
    ],
)

boost_test_suite(
    name = "upstream_standalone_tests",
    srcs = ["main.cpp"],
)

boost_test_suite(
    name = "upstream_compile_tests",
    srcs = ["main_compile.cpp"],
    extra_srcs = _COMPILE_PARTS,
)
