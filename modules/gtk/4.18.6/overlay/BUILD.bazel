        "@GTK_MICRO_VERSION@": "6",
        "@GTK_BINARY_AGE@": "1806",
        "@GTK_INTERFACE_AGE@": "6",
        "@GTK_VERSION@": "4.18.6",
        "@GTK_API_VERSION@": "4.0",
    },
    template = "gtk/gtkversion.h.in",
)

