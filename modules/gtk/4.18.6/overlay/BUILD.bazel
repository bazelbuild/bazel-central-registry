# All generators run on the execution platform; generated C uses the target
# platform toolchain. Linux x86-64 and AArch64 are both little endian.
[
    py_binary(
        name = name,
        srcs = [source],
        main = source,
    )
    for name, source in [
        ("gen_visibility", "build-aux/meson/gen-visibility-macros.py"),
        ("gen_gtk_resources", "gtk/gen-gtk-gresources-xml.py"),
        ("gen_gdk_resources", "gdk/gen-gdk-gresources-xml.py"),
        ("gen_gsk_resources", "gsk/gen-gsk-gresources-xml.py"),
        ("gen_typefuncs", "gtk/gentypefuncs.py"),
        ("gen_shader_header", "gsk/gpu/shaders/generate-header.py"),
        ("process_shader_includes", "gsk/gpu/shaders/process-glsl-includes.py"),
    ]
]

expand_template(
    name = "gdk_config",
    out = "gdk/gdkconfig.h",
    substitutions = {
        "#mesondefine GDK_WINDOWING_X11": "#define GDK_WINDOWING_X11 1",
        "#mesondefine GDK_RENDERING_CAIRO": "#define GDK_RENDERING_CAIRO 1",
        "#mesondefine GDK_RENDERING_GL": "#define GDK_RENDERING_GL 1",
        "#mesondefine": "// disabled:",
    },
    template = "gdk/gdkconfig.h.meson",
)

expand_template(
    name = "gtk_config",
    out = "gtk/gtkconfig.h",
    substitutions = {"#mesondefine GTK_ACCESSIBILITY_ATSPI": "#define GTK_ACCESSIBILITY_ATSPI 1"},
    template = "gtk/gtkconfig.h.meson",
)

