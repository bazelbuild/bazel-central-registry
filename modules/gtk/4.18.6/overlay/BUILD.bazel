genrule(
    name = "gdk_version_macros",
    srcs = ["gdk/version/gdkversionmacros.h.in"],
    outs = ["gdk/version/gdkversionmacros.h"],
    cmd = "$(location :gen_visibility) 4.18.6 versions-macros $(SRCS) $@",
    tools = [":gen_visibility"],
)

genrule(
    name = "gdk_visibility",
    outs = ["gdk/version/gdk-visibility.h"],
    cmd = "$(location :gen_visibility) 4.18.6 visibility-macros GDK $@",
    tools = [":gen_visibility"],
)

[
    expand_template(
        name = "gdk_enum_template_" + ext,
        out = "gdk/gdkenumtypes." + ext + ".template",
        substitutions = {
            "GSK": "GDK",
            "gsk": "gdk",
            "#include <gdk/gdk.h>": "#include <glib-object.h>\n#include <gdk/version/gdkversionmacros.h>",
        },
        template = "gsk/gskenumtypes." + ext + ".template",
    )
    for ext in [
        "c",
        "h",
    ]
]

[
    mkenums(
        name = name + "_" + ext,
        srcs = headers,
        out = name + "." + ext,
        template = name + "." + ext + ".template",
    )
    for name, headers in [
        ("gdk/gdkenumtypes", GDK_HEADERS),
        ("gsk/gskenumtypes", GSK_HEADERS),
        ("gtk/gtktypebuiltins", GTK_HEADERS),
        ("gtk/gtkprivatetypebuiltins", GTK_PRIVATE_HEADERS),
        ("gtk/css/gtkcssenumtypes", CSS_HEADERS),
    ]
    for ext in [
        "c",
        "h",
    ]
]

[
    genmarshal(
        name = name + "_marshal",
        src = name + "/" + name + "marshalers.list",
        options = ["--valist-marshallers"],
        out_body = name + "/" + name + "marshalers.c",
        out_header = name + "/" + name + "marshalers.h",
        prefix = "_" + name + "_marshal",
    )
    for name in [
        "gdk",
        "gtk",
    ]
]

[
    genrule(
        name = name,
        srcs = [source],
        outs = [
            "gtk/" + name + ".c",
            "gtk/" + name + ".h",
        ],
        cmd = "$(location @glib//gio/gdbus-2.0/codegen:gdbus_codegen) " +
              "--interface-prefix=" + prefix + " --c-namespace=" + namespace +
              " --output-directory=$(RULEDIR)/gtk --generate-c-code=" + name + " $(SRCS)",
        tools = ["@glib//gio/gdbus-2.0/codegen:gdbus_codegen"],
    )
    for name, source, prefix, namespace in [
        ("gtkdbusgenerated", "gtk/gtkdbusinterfaces.xml", "org.Gtk.", "_Gtk"),
        ("xdp-dbus", "gtk/org.freedesktop.portal.OpenURI.xml", "org.freedesktop.portal.", "GtkXdp"),
    ]
]

ATSPI_XML = glob(["gtk/a11y/atspi/*.xml"])

[
    genrule(
        name = "atspi_" + source.rsplit("/", 1)[1].removesuffix(".xml").lower() + "_" + ext,
        srcs = [source],
        outs = ["gtk/a11y/atspi/atspi-" + source.rsplit("/", 1)[1].removesuffix(".xml").lower() + "." + ext],
        cmd = "$(location @glib//gio/gdbus-2.0/codegen:gdbus_codegen) --interface-prefix=org.a11y.atspi " +
              "--c-namespace=Atspi --interface-info-" + mode + " --output=$@ $(SRCS)",
        tools = ["@glib//gio/gdbus-2.0/codegen:gdbus_codegen"],
    )
    for source in ATSPI_XML
    for ext, mode in [
        ("h", "header"),
        ("c", "body"),
    ]
]

SHADERS = glob(["gsk/gpu/shaders/gsk*.glsl"])

[
    genrule(
        name = shader + "_header",
        srcs = [shader],
        outs = [shader.removesuffix(".glsl") + "instance.h"],
        cmd = "$(location :gen_shader_header) $(SRCS) > $@",
        tools = [":gen_shader_header"],
    )
    for shader in SHADERS
]

[
    genrule(
        name = shader + "_preprocess",
        srcs = glob(["gsk/gpu/shaders/*.glsl"]),
        outs = ["processed/" + shader],
        cmd = "$(location :process_shader_includes) $(location " + shader + ") > $@",
        tools = [":process_shader_includes"],
    )
    for shader in SHADERS
]

GTK_RESOURCES = glob([
    "gtk/theme/**/*.css",
    "gtk/theme/**/*.png",
    "gtk/theme/**/*.svg",
    "gtk/ui/*.ui",
    "gtk/print/ui/*.ui",
    "gtk/icons/**",
    "gtk/inspector/*.ui",
    "gtk/inspector/*.css",
]) + [
    "gtk/emoji/en.data",
    "gtk/compose/sequences-little-endian",
    "gtk/compose/chars",
]

genrule(
    name = "gtk_resource_xml",
    srcs = GTK_RESOURCES + ["gtk/gtk.h"],
    outs = ["gtk/gtk.gresources.xml"],
    cmd = "$(location :gen_gtk_resources) $$(dirname $(location gtk/gtk.h)) little $@",
    tools = [":gen_gtk_resources"],
)

genrule(
    name = "gdk_resource_xml",
    srcs = [
        "gdk/default_cursor.png",
        "gdk/gdk.h",
    ],
    outs = ["gdk/gdk.gresources.xml"],
    cmd = "$(location :gen_gdk_resources) $$(dirname $(location gdk/gdk.h)) $@",
    tools = [":gen_gdk_resources"],
)

genrule(
    name = "gsk_resource_xml",
    srcs = ["processed/" + shader for shader in SHADERS],
    outs = ["gsk/gsk.gresources.xml"],
    cmd = "$(location :gen_gsk_resources) $@ $(SRCS)",
    tools = [":gen_gsk_resources"],
)

[
    genrule(
        name = name + "_resource_" + ext,
        srcs = resources + [
            name + "/" + name + ".gresources.xml",
            name + "/" + name + ".h",
        ],
        outs = [name + "/" + name + "resources." + ext],
        cmd = "XMLLINT=$(execpath @libxml2//:xmllint) $(location @glib//gio:glib_compile_resources) --generate-" + mode +
              " --manual-register --c-name=_" + name + " --target=$@ " +
              " --sourcedir=$(RULEDIR)/processed/" + name +
              " --sourcedir=$$(dirname $(location " + name + "/" + name + ".h)) " +
              "$(location " + name + "/" + name + ".gresources.xml)",
        tools = [
            "@glib//gio:glib_compile_resources",
            "@libxml2//:xmllint",
        ],
    )
    for name, resources in [
        ("gtk", GTK_RESOURCES),
        (
            "gdk",
            ["gdk/default_cursor.png"],
        ),
        (
            "gsk",
            ["processed/" + shader for shader in SHADERS],
        ),
    ]
    for ext, mode in [
        ("h", "header"),
        ("c", "source"),
    ]
]

genrule(
    name = "typefuncs",
    srcs = GTK_HEADERS + GDK_HEADERS + GSK_HEADERS + [
        "gtk/gtktypebuiltins.h",
        "gdk/gdkenumtypes.h",
        "gsk/gskenumtypes.h",
        "gtk/css/gtkcssenumtypes.h",
    ],
    outs = ["gtk/gtktypefuncs.inc"],
    cmd = "$(location :gen_typefuncs) $@ $(SRCS)",
    tools = [":gen_typefuncs"],
)

GENERATED_SOURCES = [
    "gdk/gdkenumtypes.c",
    "gsk/gskenumtypes.c",
    "gtk/gtktypebuiltins.c",
    "gtk/gtkprivatetypebuiltins.c",
    "gtk/css/gtkcssenumtypes.c",
    "gdk/gdkmarshalers.c",
    "gtk/gtkmarshalers.c",
    "gdk/gdkresources.c",
    "gsk/gskresources.c",
    "gtk/gtkresources.c",
    "gtk/gtkdbusgenerated.c",
    "gtk/xdp-dbus.c",
] + ["gtk/a11y/atspi/atspi-" + source.rsplit("/", 1)[1].removesuffix(".xml").lower() + ".c" for source in ATSPI_XML]

cc_library(
    name = "gtk",
    srcs = GTK_SOURCES + GENERATED_SOURCES + [
        ":config",
        ":profile",
    ],
    hdrs = glob([
        "gdk/**/*.h",
        "gsk/**/*.h",
        "gtk/**/*.h",
    ]) + [
        source.removesuffix(".c") + ".h"
        for source in GENERATED_SOURCES
    ] + [
        ":gdk_config",
        ":gdk_version_macros",
        ":gdk_visibility",
        ":gtk_config",
        ":gtk_version",
        ":typefuncs",
    ] + [shader.removesuffix(".glsl") + "instance.h" for shader in SHADERS],
    # Match upstream meson.build: GTK uses type-punning throughout its C API.
    copts = [
        "-std=gnu11",
        "-fno-strict-aliasing",
    ],
    includes = [
        "gdk",
        "gdk/x11",
        "gsk",
        "gtk",
        "gtk/css",
    ],
    linkopts = [
        "-lm",
        "-ldl",
        "-pthread",
    ],
    linkstatic = True,
    local_defines = [
        "GTK_COMPILATION",
        "GTK_PRINT_BACKEND_ENABLE_UNSUPPORTED",
        "G_LOG_USE_STRUCTURED=1",
        "_GNU_SOURCE",
    ],
    # Expose public header paths without turning the repository root (and its
    # private config.h) into a transitive system include directory.
    strip_include_prefix = ".",
    target_compatible_with = ["@platforms//os:linux"] + select({
        "@platforms//cpu:x86_64": [],
        "@platforms//cpu:aarch64": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    textual_hdrs = [
        "gdk/gdkarrayimpl.c",
        "gdk/x11/gdksettings.c",
        "gsk/gskcurve-ct-values.c",
        "gtk/roaring/roaring.c",
        "gtk/timsort/gtktimsort-impl.c",
        "gtk/print/paper_names_offsets.c",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@cairo",
        "@cairo//:cairo-gobject",
        "@fontconfig",
        "@fribidi",
        "@gdk-pixbuf",
        "@glib//gio",
        "@glib//gio:gio_unix",
        "@glib//gmodule",
        "@glib//gobject",
        "@graphene",
        "@harfbuzz",
        "@libepoxy",
        "@libjpeg_turbo//:jpeg",
        "@libpng",
        "@libtiff//:tiff",
        "@libx11",
        "@libxcursor",
        "@libxdamage",
        "@libxext",
        "@libxfixes",
        "@libxi",
        "@libxinerama",
        "@libxrandr",
        "@libxrender",
        "@pango",
        "@pango//:pangocairo",
        "@pango//:pangoft2",
    ],
)
