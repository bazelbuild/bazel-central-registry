module(
    name = "freetype_test",
    version = "",
    bazel_compatibility = [">=7.2.1"],
)

bazel_dep(name = "freetype", version = "2.14.1.bcr.1")
bazel_dep(name = "rules_cc", version = "0.2.22")

local_path_override(
    module_name = "freetype",
    path = "..",
)

http_file = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_file")

# Pango's small Noto Color Emoji subset exercises CBDT/CBLC PNG glyphs.
http_file(
    name = "emoji_font",
    downloaded_file_path = "emoji-subset.ttf",
    sha256 = "054c1c2e2ca956b920262840dcad39dcf27bb88d6f70b892b2b1180de2c2ab47",
    urls = ["https://raw.githubusercontent.com/GNOME/pango/1.52.1/tests/fonts/emoji-subset.ttf"],
)
