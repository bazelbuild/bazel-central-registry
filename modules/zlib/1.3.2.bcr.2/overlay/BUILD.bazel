# Bazel adds the root of a repository to the include path of all
# targets that depend on it. The sources of zlib are thus kept in
# a subdirectory so that dependents can only find the public
# headers exposed by the library and not the ones next to its
# sources.

alias(
    name = "z",
    actual = "//zlib-1.3.2:z",
    visibility = ["//visibility:public"],
)

alias(
    name = "zlib",
    actual = "//zlib-1.3.2:z",
    visibility = ["//visibility:public"],
)

alias(
    name = "LICENSE",
    actual = "//zlib-1.3.2:LICENSE",
    visibility = ["//visibility:public"],
)

alias(
    name = "license",
    actual = "//zlib-1.3.2:license",
    visibility = ["//visibility:public"],
)
