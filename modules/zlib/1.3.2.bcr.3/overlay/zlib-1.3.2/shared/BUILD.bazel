load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_cc//cc:defs.bzl", "cc_shared_library")

_VERSION = module_version().split(".bcr.")[0].split("-")[0]

_MAJOR_VERSION = _VERSION.split(".")[0]

_MINOR_VERSION = ".".join(_VERSION.split(".")[:2])

cc_shared_library(
    name = "z",
    additional_linker_inputs = select({
        "@platforms//os:linux": ["//zlib-1.3.2:zlib.map"],
        "//conditions:default": [],
    }),
    user_link_flags = select({
        "@platforms//os:linux": [
            "-Wl,--version-script=$(execpath //zlib-1.3.2:zlib.map)",
            "-Wl,-soname,libz.so",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
    win_def_file = "//zlib-1.3.2:win32/zlib.def",
    deps = ["//zlib-1.3.2:z"],
)

# Create libz.so.x -> libz.so
copy_file(
    name = "z_major",
    src = ":z",
    out = "libz.so." + _MAJOR_VERSION,
    allow_symlink = True,
    visibility = ["//visibility:public"],
)

# Create libz.so.x.y -> libz.so
copy_file(
    name = "z_minor",
    src = ":z",
    out = "libz.so." + _MINOR_VERSION,
    allow_symlink = True,
    visibility = ["//visibility:public"],
)

# Create libz.so.x.y.z -> libz.so
copy_file(
    name = "z_full",
    src = ":z",
    out = "libz.so." + _VERSION,
    allow_symlink = True,
    visibility = ["//visibility:public"],
)

# Bundle the real shared library and its version symlinks together
filegroup(
    name = "z_bundle",
    srcs = [":z"] + select({
        "@platforms//os:linux": [
            ":z_full",
            ":z_major",
            ":z_minor",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)
