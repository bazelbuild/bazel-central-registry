#!/bin/sh
printf '%s\n' 'BCR_VRP_READONLY_PRIVILEGE_PROBE_20261012'
printf 'BCR_VRP_UID=%s\n' "$(id -u)"
if [ -d /var/lib/buildkite-agent ]; then
  printf '%s\n' 'BCR_VRP_AGENT_DIR_PRESENT=yes'
else
  printf '%s\n' 'BCR_VRP_AGENT_DIR_PRESENT=no'
fi
if [ -r /var/lib/buildkite-agent ]; then
  printf '%s\n' 'BCR_VRP_AGENT_DIR_READABLE=yes'
else
  printf '%s\n' 'BCR_VRP_AGENT_DIR_READABLE=no'
fi
if [ -w /var/lib/buildkite-agent ]; then
  printf '%s\n' 'BCR_VRP_AGENT_DIR_WRITABLE=yes'
else
  printf '%s\n' 'BCR_VRP_AGENT_DIR_WRITABLE=no'
fi
if [ -r /proc/self/status ]; then
  grep '^CapEff:' /proc/self/status | sed 's/^CapEff:/BCR_VRP_CAP_EFF=/'
fi
exit 42
