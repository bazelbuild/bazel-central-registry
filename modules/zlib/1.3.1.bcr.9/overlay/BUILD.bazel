load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_cc//cc:defs.bzl", "cc_library", "cc_shared_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:Zlib"],
    license_text = "LICENSE",
)

exports_files([
    "LICENSE",
])

_ZLIB_HEADERS = [
    "crc32.h",
    "deflate.h",
    "gzguts.h",
    "inffast.h",
    "inffixed.h",
    "inflate.h",
    "inftrees.h",
    "trees.h",
    "zconf.h",
    "zlib.h",
    "zutil.h",
]

# In order to limit the damage from the `includes` propagation
# via `:zlib`, copy the public headers to a subdirectory and
# expose those.
[
    copy_file(
        name = "copy_public_header_" + hdr.replace(".", "_"),
        src = hdr,
        out = "zlib/include/" + hdr,
        allow_symlink = True,
    )
    for hdr in _ZLIB_HEADERS
]

cc_library(
    name = "z",
    srcs = [
        "adler32.c",
        "compress.c",
        "crc32.c",
        "deflate.c",
        "gzclose.c",
        "gzlib.c",
        "gzread.c",
        "gzwrite.c",
        "infback.c",
        "inffast.c",
        "inflate.c",
        "inftrees.c",
        "trees.c",
        "uncompr.c",
        "zutil.c",
        # Include the un-prefixed headers in srcs to work
        # around the fact that zlib isn't consistent in its
        # choice of <> or "" delimiter when including itself.
    ] + _ZLIB_HEADERS,
    hdrs = ["zlib/include/" + hdr for hdr in _ZLIB_HEADERS],
    copts = select({
        "@rules_cc//cc/compiler:mingw-gcc": [
            "-fpermissive",
        ],
        "@rules_cc//cc/compiler:msvc-cl": [
            "/wd4127", # conditional expression is constant
            "/wd4242", # possible loss of data
            "/wd4244", # possible loss of data
        ],
        "@platforms//os:macos": [
            "-Wno-unused-variable",
            "-Wno-implicit-function-declaration",
        ],
        "//conditions:default": [
            "-Wno-deprecated-non-prototype",
            "-Wno-unused-variable",
            "-Wno-implicit-function-declaration",
        ],
    }),
    includes = ["zlib/include/"],
    local_defines = select({
        "@platforms//os:windows": ["_CRT_NONSTDC_NO_WARNINGS"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

alias(
    name = "zlib",
    actual = ":z",
    visibility = ["//visibility:public"],
)

# A shared zlib carrying zlib's own symbol VERSIONS, for consumers that must link against a
# prebuilt binary referencing versioned zlib symbols -- e.g. an upstream `libLLVM.so`, which
# references `compressBound@ZLIB_1.2.0`. `:z` cannot satisfy those: it is linked as a static
# archive, and a static archive carries no symbol versions at all, so the link fails with
# `undefined reference to compressBound@ZLIB_1.2.0` even though the symbol is present.
#
# `zlib.map` ships in the release tarball and defines the ZLIB_* version nodes; applying it as a
# version script is what makes the definitions versioned. Without it this library would export a
# plain `compressBound`, which still does not match.
#
# Additive: `:z` and `:zlib` are unchanged, so existing consumers keep the static library.
cc_shared_library(
    name = "z_shared",
    additional_linker_inputs = ["zlib.map"],
    # Linux only: `--version-script` and `-soname` are GNU-ld/ELF concepts. Guarded rather than
    # left to fail, so `bazel build //...` on macOS or Windows skips this instead of breaking.
    target_compatible_with = ["@platforms//os:linux"],
    shared_lib_name = "libz.so.1",
    user_link_flags = [
        "-Wl,--version-script=$(location zlib.map)",
        # An explicit SONAME. `shared_lib_name` sets the OUTPUT FILENAME only, so without this
        # the library carries no SONAME and a consumer's DT_NEEDED would not resolve to it.
        "-Wl,-soname,libz.so.1",
    ],
    deps = [":z"],
)

# The LINK name. A linker resolves `-lz` against `libz.so`, never `libz.so.1`, so depending on
# `:z_shared` directly fails with "cannot find -lz". This copy provides that name in a
# subdirectory -- it cannot sit at the package root, where `:z` already writes a `libz.so` --
# mirroring the split a distro makes between its `-dev` symlink and its runtime library. The
# SONAME inside the file remains `libz.so.1`.
copy_file(
    name = "z_versioned_link_name",
    src = ":z_shared",
    out = "versioned/libz.so",
    target_compatible_with = ["@platforms//os:linux"],
)

# What a consumer depends on. A `cc_library` rather than the `cc_shared_library` directly,
# because some rulesets accept only `cc_library` in `deps` (rules_rust, for one, rejects a
# `cc_shared_library` outright). A prebuilt `.so` in `srcs` is linked dynamically.
cc_library(
    name = "z_versioned",
    srcs = [":z_versioned_link_name"],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)
