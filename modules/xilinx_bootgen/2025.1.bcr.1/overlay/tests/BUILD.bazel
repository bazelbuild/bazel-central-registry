load("@rules_cc//cc:cc_test.bzl", "cc_test")

# The program is in `data`, not `tools`, so it is built once in the target
# configuration.  `$(rlocationpath)` rather than `$(rootpath)` because
# Windows runfiles are a manifest, not a symlink tree.
cc_test(
    name = "bootgen_test",
    size = "small",
    srcs = ["bootgen_test.cc"],
    data = ["//:bootgen"],
    env = {
        "BOOTGEN": "$(rlocationpath //:bootgen)",
        # The upstream release, without the registry's .bcr.N suffix.
        "BOOTGEN_VERSION": module_version().split(".bcr.")[0],
    },
    deps = ["@rules_cc//cc/runfiles"],
)
