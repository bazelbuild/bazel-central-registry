The xilinx_v2025.1 tag was cut before common/include/version.h was updated:
the program reports itself as "2025.1-Merged".  This sets RDI_VERSION to the
tag's version, which the smoke test in tests/ checks.

diff -ruN a/common/include/version.h b/common/include/version.h
--- a/common/include/version.h	2026-11-04 15:10:04.721495609 -0800
+++ b/common/include/version.h	2026-11-04 15:10:04.721528870 -0800
@@ -16,7 +16,7 @@
 ******************************************************************************/
 
 #ifndef RDI_VERSION
-#define RDI_VERSION "2025.1-Merged"
+#define RDI_VERSION "2025.1"
 #endif
 
 #define PROGRAMNAME     "Bootgen"
