lms-hash-sigs/hss_param.c calls printf without including <stdio.h>.  Older
compilers only warn about the implicit declaration; GCC 14 and Clang 16 make
it an error, so the file does not compile on debian13.  The 2026 releases
carry the include already; this is that fix for 2025.2.

diff -ruN a/lms-hash-sigs/hss_param.c b/lms-hash-sigs/hss_param.c
--- a/lms-hash-sigs/hss_param.c	2026-10-28 17:19:06.869494643 -0700
+++ b/lms-hash-sigs/hss_param.c	2026-10-28 17:19:06.869526361 -0700
@@ -1,4 +1,5 @@
 #include <string.h>
+#include <stdio.h>
 #include "hss.h"
 #include "hss_internal.h"
 #include "endian.h"
