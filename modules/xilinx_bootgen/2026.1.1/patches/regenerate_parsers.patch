 %token <core_t>         CORE
 %token <bhrsa_t>        BH_RSA
 %token <authhash_t>     AUTH_HASH
-%token <inthash_t>      INT_HASH
+%token      INT_HASH
 %token <pufhdloc_t>     PUFHD_LOC
