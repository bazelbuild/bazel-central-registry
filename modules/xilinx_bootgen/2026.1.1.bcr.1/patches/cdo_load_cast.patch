utils/src/cdo-load.c assigns the uint32_t * data of a decoded raw CDO to a
char *.  Older compilers only warn about the incompatible pointer types; GCC
14 and Clang 16 make it an error, so the file does not compile on debian13.
This is the cast the 2026.2 release carries.

diff -ruN a/utils/src/cdo-load.c b/utils/src/cdo-load.c
--- a/utils/src/cdo-load.c	2026-10-28 17:22:08.756176416 -0700
+++ b/utils/src/cdo-load.c	2026-10-28 17:22:08.756799597 -0700
@@ -137,7 +137,7 @@
     if (data == NULL) goto done;
     raw = cdoraw_decode(data, size);
     if (raw != NULL) {
-        data = raw->data;
+        data = (char *)raw->data;
         size = raw->size;
     }
     if (is_cdo_data(data, size)) {
