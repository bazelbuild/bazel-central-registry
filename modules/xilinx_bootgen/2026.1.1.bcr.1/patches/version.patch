The xilinx_v2026.1.1 tag was cut before common/include/version.h was updated:
the program reports itself as "2026.1".  This sets RDI_VERSION to the
tag's version, which the smoke test in tests/ checks.

diff -ruN a/common/include/version.h b/common/include/version.h
--- a/common/include/version.h	2026-11-04 15:10:04.726076997 -0800
+++ b/common/include/version.h	2026-11-04 15:10:04.726105782 -0800
@@ -16,7 +16,7 @@
 ******************************************************************************/
 
 #ifndef RDI_VERSION
-#define RDI_VERSION "2026.1"
+#define RDI_VERSION "2026.1.1"
 #endif
 
 #define PROGRAMNAME     "Bootgen"
