load("@bison//:bison.bzl", "bison")
load("@flex//:flex.bzl", "flex")
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

exports_files(["LICENSE"])

# Apache 2.0; LICENSE also carries the notices of the bundled bison skeleton,
# flex scanner class, keccak and stdint.h the sources were built with.
license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:Apache-2.0",
    text = "LICENSE",
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

# Upstream's -Wall is dropped: third-party warnings are noise to consumers.
COPTS = select({
    "@rules_cc//cc/compiler:clang-cl": ["/w"],
    "@rules_cc//cc/compiler:msvc-cl": ["/w"],
    "//conditions:default": ["-w"],
})

# CXXFLAGS = -std=c++14; the C files take the toolchain default, as CFLAGS does.
CXXOPTS = select({
    "@rules_cc//cc/compiler:clang-cl": ["/std:c++14"],
    "@rules_cc//cc/compiler:msvc-cl": ["/std:c++14"],
    "//conditions:default": ["-std=c++14"],
})

# The device-family directories the Makefile compiles (CXXFILES, CFILES) and
# puts on the include path (INCLUDE_SYS); each is an include/ + src/ pair.
FAMILIES = [
    "common",
    "spartanup",
    "versal",
    "versal_2ve_2vm",
    "versal_2vp",
    "zynq",
    "zynqmp",
    "utils",
]

# The three parsers, each a bison grammar and a flex scanner in parser/.
# Upstream compiles its checked-in bison 2.7 / flex 2.5 output in bisonflex/
# unless BISON_HOME and FLEX_HOME are set; here they are always regenerated
# (Makefile, the BF_GENDIR rules), so bisonflex/ and win_include/ (the flex
# 2.5 FlexLexer.h) are unused.  patches/regenerate_parsers.patch holds the
# two edits that needs: an untyped INT_HASH in bif.y, and the scanner
# headers taking FlexLexer.h from flex itself.
PARSERS = [
    "bif",
    "cmdoptions",
    "reginit",
]

# `-Wnone` is `-w` for bison: the grammars use %define names bison 3 has
# renamed, which it reports as deprecations.  Only bif.y generates
# location.hh; the others reuse BIF::location (%define api.location.type).
[
    bison(
        name = "parser/" + p + "_tab",
        srcs = ["parser/" + p + ".y"],
        outs = [
            "parser/" + p + ".tab.cpp",
            "parser/" + p + ".tab.hpp",
        ] + (["parser/location.hh"] if p == "bif" else []),
        args = [
            "-Wnone",
            "-d",
            "-o",
            "$(execpath parser/%s.tab.cpp)" % p,
            "$(execpath parser/%s.y)" % p,
        ],
    )
    for p in PARSERS
]

[
    flex(
        name = "parser/" + p + "_yy",
        srcs = ["parser/" + p + ".l"],
        outs = ["parser/" + p + ".yy.cpp"],
        args = [
            "--nowarn",
            "--prefix=" + p,
            "-o",
            "$(execpath parser/%s.yy.cpp)" % p,
            "$(execpath parser/%s.l)" % p,
        ],
    )
    for p in PARSERS
]

# The bison and flex targets: their .cpp, .hpp and .hh outputs.
GRAMMAR = ["parser/%s_%s" % (p, k) for p in PARSERS for k in [
    "tab",
    "yy",
]]

# C++14 has no <span>; upstream's polyfill is a header without an extension,
# which only textual_hdrs accepts.
cc_library(
    name = "ml_dsa_compat",
    copts = COPTS,
    includes = ["wrapper/ml-dsa-lib/compat"],
    textual_hdrs = ["wrapper/ml-dsa-lib/compat/span"],
)

# Upstream's one program: the parsers, every .cpp and .c under the family
# src/ directories, the post-quantum wrappers and the hash-sigs archive,
# linked against OpenSSL.  cdo-driver/ is a standalone library the Makefile
# does not build; it has no target.
cc_binary(
    name = "bootgen",
    srcs = GRAMMAR + glob(
        [d + "/src/*.cpp" for d in FAMILIES] +
        [d + "/src/*.c" for d in FAMILIES] +
        [d + "/include/*.h" for d in FAMILIES] + [
            "slh/*.c",
            "slh/*.h",
            # ML-DSA over the OpenSSL EVP implementation.
            "wrapper/ml-dsa-lib/*.h",
            "wrapper/ml-dsa-lib/ml_dsa/*.hpp",
            "wrapper/pqc-openssl/*.cpp",
            "wrapper/pqc-openssl/*.h",
        ],
        # Only utils/src has C files; the Makefile's `find` tolerates the rest.
        allow_empty = True,
    ),
    copts = COPTS,
    cxxopts = CXXOPTS,
    includes = [
        "parser",
        "wrapper/ml-dsa-lib",
    ] + [d + "/include" for d in FAMILIES] + [
        "slh",
        "wrapper/pqc-openssl",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":ml_dsa_compat",
        "//lms-hash-sigs:hss_lib_thread",
        "@flex//:headers",
        "@openssl//:crypto",
        "@openssl//:ssl",
    ],
)
