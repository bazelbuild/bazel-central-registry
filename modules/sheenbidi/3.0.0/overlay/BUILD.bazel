# Hand-written equivalent of the "SheenBidi" library target in upstream CMakeLists.txt,
# built in its default unity mode (SB_CONFIG_UNITY): Source/SheenBidi.c #includes every
# other .c file, so those are listed as textual headers rather than compiled separately.
# The optional experimental text API (SB_CONFIG_EXPERIMENTAL_TEXT_API) is not enabled.

load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "internal_headers",
    textual_hdrs = glob(
        [
            "Source/**/*.c",
            "Source/**/*.h",
        ],
        exclude = ["Source/SheenBidi.c"],
    ),
    includes = ["Source"],
    visibility = ["//visibility:private"],
)

cc_library(
    name = "sheenbidi",
    srcs = ["Source/SheenBidi.c"],
    hdrs = glob(["Headers/SheenBidi/*.h"]),
    copts = select({
        "@rules_cc//cc/compiler:msvc-cl": ["/utf-8"],
        "//conditions:default": [],
    }),
    implementation_deps = [":internal_headers"],
    local_defines = ["SB_CONFIG_UNITY"],
    strip_include_prefix = "Headers",
    visibility = ["//visibility:public"],
)
