Include <basetsd.h> in lower case so the header is found when cross-compiling
for Windows (MinGW) from a case-sensitive host. Windows file systems are
case-insensitive, so native MSVC and MinGW builds are unaffected.

--- a/src/utils.h
+++ b/src/utils.h
@@ -25,7 +25,7 @@
 #ifdef _WIN32
 # include <direct.h>
 # include <io.h>
-# include <BaseTsd.h>
+# include <basetsd.h>
 # ifndef S_ISDIR
 #  define S_ISDIR(m) (((m) & S_IFMT) == S_IFDIR)
 # endif
