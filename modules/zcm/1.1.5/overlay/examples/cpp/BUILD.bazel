load("@rules_cc//cc:defs.bzl", "cc_binary")

[
    cc_binary(
        name = name,
        srcs = [src],
        deps = [
            "//examples/types:types_cc",
            "@zcm",
        ],
    )
    for name, src in [
        ("pub", "Pub.cpp"),
        ("sub", "Sub.cpp"),
        ("bitfield_pub", "BitfieldPub.cpp"),
        ("bitfield_sub", "BitfieldSub.cpp"),
        ("sub_functional", "SubFunctional.cpp"),
        ("pubsub", "PubSub.cpp"),
        ("unsub", "Unsub.cpp"),
        ("pauseflushresume", "PauseFlushResume.cpp"),
        ("flushdrivenloop", "FlushDrivenLoop.cpp"),
        ("inproc", "Inproc.cpp"),
        ("serial", "Serial.cpp"),
        ("tracker", "MessageTrackerTest.cpp"),
        ("packaged", "Packaged.cpp"),
    ]
]

cc_binary(
    name = "bandwidth_test",
    srcs = ["BandwidthTest.cpp"],
    deps = ["@zcm"],
)
