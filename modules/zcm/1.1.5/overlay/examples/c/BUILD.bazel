load("@rules_cc//cc:defs.bzl", "cc_binary")

[
    cc_binary(
        name = name,
        srcs = [name + ".c"],
        deps = [
            "//examples/types:types_c",
            "@zcm",
        ],
    )
    for name in [
        "pub",
        "sub",
        "bitfield_pub",
        "bitfield_sub",
        "pubsub",
        "nblock_inproc",
    ]
]
