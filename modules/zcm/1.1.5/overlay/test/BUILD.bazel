load(":cxxtest.bzl", "cxxtest_test")

package(default_visibility = ["//visibility:public"])

cxxtest_test(
    name = "core_test",
    src = "zcm/CoreTest.hpp",
)

cxxtest_test(
    name = "api_retcodes_test",
    src = "zcm/ApiRetcodesTest.hpp",
)

cxxtest_test(
    name = "dispatch_loop_test",
    src = "zcm/DispatchLoopTest.hpp",
)

cxxtest_test(
    name = "flushing_test",
    src = "zcm/FlushingTest.hpp",
)

cxxtest_test(
    name = "log_test",
    src = "zcm/LogTest.hpp",
)

cxxtest_test(
    name = "trans_test",
    src = "zcm/TransTest.hpp",
    env = {"ZCM_DEFAULT_URL": "ipc"},
    tags = ["exclusive"],
)

cxxtest_test(
    name = "bitfield_test",
    src = "BitfieldTest.hpp",
    deps = [
        "//types:types_c",
        "//types:types_cc",
    ],
)

cxxtest_test(
    name = "tracker_test",
    src = "zcm/TrackerTest.hpp",
    deps = ["//types:types_cc"],
)

cxxtest_test(
    name = "message_tracker_test",
    src = "MessageTrackerTest.hpp",
    env = {"ZCM_DEFAULT_URL": "ipc"},
    deps = ["//types:types_cc"],
)

cxxtest_test(
    name = "forking_test",
    src = "zcm/ForkingTest.hpp",
    tags = ["exclusive"],
)

cxxtest_test(
    name = "forking2_test",
    src = "zcm/Forking2Test.hpp",
    tags = ["exclusive"],
)

cxxtest_test(
    name = "sub_unsub_c_test",
    src = "zcm/SubUnsubCTest.hpp",
    copts = ["-std=c++14"],
    tags = ["exclusive"],
    deps = ["//types:types_c"],
)

cxxtest_test(
    name = "sub_unsub_cpp_test",
    src = "zcm/SubUnsubCPPTest.hpp",
    copts = ["-std=c++14"],
    extra_srcs = [
        "zcm/multi_file.cpp",
        "zcm/multi_file.hpp",
    ],
    tags = ["exclusive"],
    deps = ["//types:types_cc"],
)
