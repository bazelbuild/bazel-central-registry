load(":cxxtest.bzl", "cxxtest_test")

# Basic unit tests
[
    cxxtest_test(
        name = name,
        src = src,
    )
    for name, src in [
        ("core_test", "zcm/CoreTest.hpp"),
        ("api_retcodes_test", "zcm/ApiRetcodesTest.hpp"),
        ("dispatch_loop_test", "zcm/DispatchLoopTest.hpp"),
        ("flushing_test", "zcm/FlushingTest.hpp"),
        ("log_test", "zcm/LogTest.hpp"),
    ]
]

# Process-forking tests
[
    cxxtest_test(
        name = name,
        src = src,
        tags = ["exclusive"],
    )
    for name, src in [
        ("forking_test", "zcm/ForkingTest.hpp"),
        ("forking2_test", "zcm/Forking2Test.hpp"),
    ]
]

# Specialized tests (custom transports, schema dependencies, compiler options)
cxxtest_test(
    name = "trans_test",
    src = "zcm/TransTest.hpp",
    env = {"ZCM_DEFAULT_URL": "ipc"},
    tags = ["exclusive"],
)

cxxtest_test(
    name = "message_tracker_test",
    src = "MessageTrackerTest.hpp",
    env = {"ZCM_DEFAULT_URL": "ipc"},
    deps = ["//types:types_cc"],
)

cxxtest_test(
    name = "bitfield_test",
    src = "BitfieldTest.hpp",
    deps = [
        "//types:types_c",
        "//types:types_cc",
    ],
)

cxxtest_test(
    name = "tracker_test",
    src = "zcm/TrackerTest.hpp",
    deps = ["//types:types_cc"],
)

cxxtest_test(
    name = "sub_unsub_c_test",
    src = "zcm/SubUnsubCTest.hpp",
    copts = ["-std=c++14"],
    tags = ["exclusive"],
    deps = ["//types:types_c"],
)

cxxtest_test(
    name = "sub_unsub_cpp_test",
    src = "zcm/SubUnsubCPPTest.hpp",
    copts = ["-std=c++14"],
    extra_srcs = [
        "zcm/multi_file.cpp",
        "zcm/multi_file.hpp",
    ],
    tags = ["exclusive"],
    deps = ["//types:types_cc"],
)
