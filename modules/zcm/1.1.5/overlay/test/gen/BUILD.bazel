load("@zcm//bazel:defs.bzl", "zcm_c_library", "zcm_cc_library")

package(default_visibility = ["//visibility:public"])

# Single-type schemas
[
    (
        zcm_c_library(
            name = "%s_c" % name,
            srcs = ["%s.zcm" % name],
            unpackaged = True,
        ),
        zcm_cc_library(
            name = "%s_cc" % name,
            srcs = ["%s.zcm" % name],
            unpackaged = True,
        ),
    )
    for name in [
        "array_const_size1",
        "array_multidim1",
        "array_var_size1",
        "consts1",
        "prim1",
    ]
]

# Multi-type schema: nested1 (struct a, struct nested1)
zcm_c_library(
    name = "nested1_c",
    srcs = ["nested1.zcm"],
    types = [
        "a",
        "nested1",
    ],
    unpackaged = True,
)

zcm_cc_library(
    name = "nested1_cc",
    srcs = ["nested1.zcm"],
    types = [
        "a",
        "nested1",
    ],
    unpackaged = True,
)

# Multi-type schema: nested2 (struct c, struct d, struct nested2)
zcm_c_library(
    name = "nested2_c",
    srcs = ["nested2.zcm"],
    types = [
        "c",
        "d",
        "nested2",
    ],
    unpackaged = True,
)

zcm_cc_library(
    name = "nested2_cc",
    srcs = ["nested2.zcm"],
    types = [
        "c",
        "d",
        "nested2",
    ],
    unpackaged = True,
)
