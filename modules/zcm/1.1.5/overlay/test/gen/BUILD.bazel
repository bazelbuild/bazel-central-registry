load("@zcm//bazel:defs.bzl", "zcm_c_library", "zcm_cc_library")

[
    (
        zcm_c_library(
            name = "%s_c" % name,
            srcs = ["%s.zcm" % name],
            types = types,
            unpackaged = True,
        ),
        zcm_cc_library(
            name = "%s_cc" % name,
            srcs = ["%s.zcm" % name],
            types = types,
            unpackaged = True,
        ),
    )
    for name, types in [
        ("array_const_size1", []),
        ("array_multidim1", []),
        ("array_var_size1", []),
        ("consts1", []),
        ("prim1", []),
        (
            "nested1",
            [
                "a",
                "nested1",
            ],
        ),
        (
            "nested2",
            [
                "c",
                "d",
                "nested2",
            ],
        ),
    ]
]
