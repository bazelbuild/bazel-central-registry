load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

# Core Types & Runtime Library
cc_library(
    name = "zcm-coretypes",
    hdrs = ["zcm/zcm_coretypes.h"],
    includes = ["."],
)

# Core runtime without transport backends
cc_library(
    name = "zcm-core",
    srcs = [
        "zcm/blocking.cpp",
        "zcm/eventlog.c",
        "zcm/json/jsoncpp.cpp",
        "zcm/nonblocking.c",
        "zcm/transport_registrar.c",
        "zcm/url.cpp",
        "zcm/util/debug.cpp",
        "zcm/util/lockfile.cpp",
        "zcm/util/topology.cpp",
        "zcm/zcm.c",
    ],
    hdrs = glob(
        [
            "util/*.hpp",
            "zcm/*.h",
            "zcm/*.hpp",
            "zcm/json/*.h",
            "zcm/transport/*.h",
            "zcm/transport/udpm/*.hpp",
            "zcm/util/*.h",
            "zcm/util/*.hpp",
        ],
        exclude = ["zcm/util/test/**"],
    ),
    defines = [
        "USING_TRANS_FILE",
        "USING_TRANS_INPROC",
        "USING_TRANS_SERIAL",
        "USING_TRANS_UDPM",
    ],
    includes = [
        ".",
        "zcm",
    ],
    linkopts = select({
        "@platforms//os:linux": [
            "-lpthread",
            "-lrt",
        ],
        "//conditions:default": ["-lpthread"],
    }),
    deps = [":zcm-coretypes"],
)

# Modular Transports
[
    cc_library(
        name = "zcm-transport-%s" % name,
        srcs = srcs,
        defines = defines,
        deps = [":zcm-core"] + deps,
        alwayslink = True,
    )
    for name, srcs, defines, deps in [
        (
            "file",
            ["zcm/transport/transport_file.cpp"],
            ["USING_TRANS_FILE"],
            [],
        ),
        (
            "inproc",
            ["zcm/transport/transport_inproc.cpp"],
            ["USING_TRANS_INPROC"],
            [],
        ),
        (
            "ipc",
            ["zcm/transport/transport_zmq_local.cpp"],
            [
                "USING_TRANS_IPC",
                "USING_ZMQ",
            ],
            ["@libzmq"],
        ),
        (
            "serial",
            [
                "zcm/transport/generic_serial_circ_buff.c",
                "zcm/transport/generic_serial_transport.c",
                "zcm/transport/transport_serial.cpp",
            ],
            ["USING_TRANS_SERIAL"],
            [],
        ),
        (
            "udpm",
            [
                "zcm/transport/udpm/buffers.cpp",
                "zcm/transport/udpm/mempool.cpp",
                "zcm/transport/udpm/udpm.cpp",
                "zcm/transport/udpm/udpmsocket.cpp",
            ],
            ["USING_TRANS_UDPM"],
            [],
        ),
        (
            "can",
            ["zcm/transport/transport_can.cpp"],
            ["USING_TRANS_CAN"],
            [],
        ),
    ]
]

# Composite default library aggregating core + default lightweight transports.
# NOTE: The ZeroMQ-based IPC transport (:zcm-transport-ipc) is intentionally
# not included by default to prevent compiling libzmq when IPC is not needed.
# To use the ipc:// transport, depend explicitly on @zcm//:zcm-transport-ipc.
cc_library(
    name = "zcm",
    deps = [
        ":zcm-core",
        ":zcm-transport-file",
        ":zcm-transport-inproc",
        ":zcm-transport-serial",
        ":zcm-transport-udpm",
    ],
)

# Code Generator Binary
cc_binary(
    name = "zcm-gen",
    srcs = glob([
        "gen/*.c",
        "gen/*.cpp",
        "gen/*.h",
        "gen/*.hpp",
        "gen/emit/*.cpp",
        "gen/emit/*.hpp",
        "util/*.hpp",
    ]),
    includes = [
        ".",
        "gen",
    ],
    deps = [":zcm-coretypes"],
)

# Tools Shared Utility Library & Binaries
cc_library(
    name = "zcm-tools-util",
    srcs = glob(
        [
            "tools/cpp/util/**/*.cpp",
            "zcm/tools/**/*.cpp",
        ],
        allow_empty = True,
    ),
    hdrs = glob(
        [
            "tools/cpp/util/**/*.hpp",
            "zcm/tools/**/*.hpp",
            "util/**/*.hpp",
        ],
        allow_empty = True,
    ),
    includes = [
        ".",
        "tools/cpp",
        "zcm",
    ],
    deps = [
        ":zcm",
    ],
)

[
    cc_binary(
        name = "zcm-%s" % tool,
        srcs = glob(
            [
                "tools/cpp/%s/**" % tool,
            ],
            exclude = [
                "**/wscript*",
                "**/*.py",
            ],
        ),
        deps = [":zcm-tools-util"] + (["@ncurses//:ncurses"] if tool == "spy-lite" else []),
    )
    for tool in [
        "bridge",
        "indexer",
        "logger",
        "logplayer",
        "repeater",
        "spy-lite",
        "spy-peek",
        "topology-visualizer",
        "transcoder",
    ]
]
