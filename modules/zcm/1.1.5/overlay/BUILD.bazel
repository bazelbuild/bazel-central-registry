load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

# ==============================================================================
# Core Types & Runtime Library
# ==============================================================================

cc_library(
    name = "zcm-coretypes",
    hdrs = ["zcm/zcm_coretypes.h"],
    includes = ["."],
)

# Core runtime without transport backends
cc_library(
    name = "zcm-core",
    srcs = [
        "zcm/blocking.cpp",
        "zcm/eventlog.c",
        "zcm/json/jsoncpp.cpp",
        "zcm/nonblocking.c",
        "zcm/transport_registrar.c",
        "zcm/url.cpp",
        "zcm/util/debug.cpp",
        "zcm/util/lockfile.cpp",
        "zcm/util/topology.cpp",
        "zcm/zcm.c",
    ],
    hdrs = [
        "util/FileUtil.hpp",
        "util/StringUtil.hpp",
        "util/TimeUtil.hpp",
        "util/Types.hpp",
        "zcm/blocking.h",
        "zcm/eventlog.h",
        "zcm/message_tracker.hpp",
        "zcm/nonblocking.h",
        "zcm/transport.h",
        "zcm/transport_register.hpp",
        "zcm/transport_registrar.h",
        "zcm/url.h",
        "zcm/zcm-cpp-impl.hpp",
        "zcm/zcm-cpp.hpp",
        "zcm/zcm.h",
        "zcm/zcm_coretypes.h",
        "zcm/zcm_private.h",
    ] + glob([
        "zcm/json/*.h",
        "zcm/transport/*.h",
        "zcm/transport/udpm/*.hpp",
        "zcm/util/*.h",
        "zcm/util/*.hpp",
    ], exclude = [
        "zcm/util/test/**",
    ]),
    defines = [
        "USING_TRANS_FILE",
        "USING_TRANS_INPROC",
        "USING_TRANS_IPC",
        "USING_TRANS_SERIAL",
        "USING_TRANS_UDPM",
        "USING_ZMQ",
    ],
    includes = [
        ".",
        "zcm",
    ],
    linkopts = [
        "-lpthread",
        "-lrt",
    ],
    deps = [":zcm-coretypes"],
)

# ==============================================================================
# Modular Transports
# ==============================================================================

cc_library(
    name = "zcm-transport-file",
    srcs = ["zcm/transport/transport_file.cpp"],
    defines = ["USING_TRANS_FILE"],
    includes = [
        ".",
        "zcm",
    ],
    deps = [":zcm-core"],
)

cc_library(
    name = "zcm-transport-inproc",
    srcs = ["zcm/transport/transport_inproc.cpp"],
    defines = ["USING_TRANS_INPROC"],
    includes = [
        ".",
        "zcm",
    ],
    deps = [":zcm-core"],
)

cc_library(
    name = "zcm-transport-ipc",
    srcs = ["zcm/transport/transport_zmq_local.cpp"],
    defines = [
        "USING_TRANS_IPC",
        "USING_ZMQ",
    ],
    includes = [
        ".",
        "zcm",
    ],
    deps = [
        ":zcm-core",
        "@libzmq",
    ],
)

cc_library(
    name = "zcm-transport-serial",
    srcs = [
        "zcm/transport/generic_serial_circ_buff.c",
        "zcm/transport/generic_serial_transport.c",
        "zcm/transport/transport_serial.cpp",
    ],
    defines = ["USING_TRANS_SERIAL"],
    includes = [
        ".",
        "zcm",
    ],
    deps = [":zcm-core"],
)

cc_library(
    name = "zcm-transport-udpm",
    srcs = [
        "zcm/transport/udpm/buffers.cpp",
        "zcm/transport/udpm/mempool.cpp",
        "zcm/transport/udpm/udpm.cpp",
        "zcm/transport/udpm/udpmsocket.cpp",
    ],
    defines = ["USING_TRANS_UDPM"],
    includes = [
        ".",
        "zcm",
    ],
    deps = [":zcm-core"],
)

cc_library(
    name = "zcm-transport-can",
    srcs = ["zcm/transport/transport_can.cpp"],
    defines = ["USING_TRANS_CAN"],
    includes = [
        ".",
        "zcm",
    ],
    deps = [":zcm-core"],
)

# Composite default library aggregating core + default transports
cc_library(
    name = "zcm",
    deps = [
        ":zcm-core",
        ":zcm-transport-file",
        ":zcm-transport-inproc",
        ":zcm-transport-ipc",
        ":zcm-transport-serial",
        ":zcm-transport-udpm",
    ],
)

# ==============================================================================
# Code Generator Binary
# ==============================================================================

cc_binary(
    name = "zcm-gen",
    srcs = [
        "gen/Common.hpp",
        "gen/GetOpt.cpp",
        "gen/GetOpt.hpp",
        "gen/Main.cpp",
        "gen/ZCMGen.cpp",
        "gen/ZCMGen.hpp",
        "gen/tokenize.c",
        "gen/tokenize.h",
        "gen/version.h",
    ] + glob([
        "gen/emit/*.cpp",
        "gen/emit/*.hpp",
        "util/*.hpp",
    ]),
    includes = [
        ".",
        "gen",
    ],
    deps = [":zcm-coretypes"],
)

# ==============================================================================
# Tools Shared Utility Library
# ==============================================================================

cc_library(
    name = "zcm-tools-util",
    srcs = glob([
        "tools/cpp/util/**/*.cpp",
        "zcm/tools/**/*.cpp",
    ]),
    hdrs = glob([
        "tools/cpp/util/**/*.hpp",
        "zcm/tools/**/*.hpp",
        "util/**/*.hpp",
    ]),
    includes = [
        ".",
        "tools/cpp",
        "zcm",
    ],
    deps = [
        ":zcm",
        ":zcm-coretypes",
        "@elfutils//:elf",
    ],
)

