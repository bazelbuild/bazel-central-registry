load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_library")

package(default_visibility = ["//visibility:public"])

# ==============================================================================
# Core Types & Runtime Library
# ==============================================================================

cc_library(
    name = "zcm-coretypes",
    hdrs = ["zcm/zcm_coretypes.h"],
    includes = ["."],
)

cc_library(
    name = "zcm",
    srcs = glob(
        [
            "zcm/**/*.c",
            "zcm/**/*.cpp",
        ],
        exclude = [
            "zcm/java/**",
            "zcm/js/**",
            "zcm/julia/**",
            "zcm/python/**",
            "zcm/tools/**",
            "zcm/transport/third-party/**",
            "zcm/transport/transport_can.cpp",
            "zcm/transport/transport_zmq_local.cpp",
            "zcm/util/test/**",
        ],
    ),
    hdrs = glob(
        [
            "zcm/**/*.h",
            "zcm/**/*.hpp",
            "util/**/*.hpp",
        ],
        exclude = [
            "zcm/java/**",
            "zcm/js/**",
            "zcm/julia/**",
            "zcm/python/**",
            "zcm/tools/**",
            "zcm/transport/third-party/**",
            "zcm/util/test/**",
        ],
    ),
    defines = [
        "USING_TRANS_FILE",
        "USING_TRANS_INPROC",
        "USING_TRANS_SERIAL",
        "USING_TRANS_UDPM",
    ],
    includes = [
        ".",
        "zcm",
    ],
    linkopts = [
        "-lpthread",
        "-lrt",
    ],
    deps = [":zcm-coretypes"],
)

# ==============================================================================
# Code Generator Binary
# ==============================================================================

cc_binary(
    name = "zcm-gen",
    srcs = glob(
        [
            "gen/**/*.c",
            "gen/**/*.cpp",
            "gen/**/*.h",
            "gen/**/*.hpp",
            "util/**/*.hpp",
        ],
        exclude = ["gen/disabled/**"],
    ),
    includes = [
        ".",
        "gen",
    ],
    deps = [":zcm-coretypes"],
)

# ==============================================================================
# Tools Shared Utility Library
# ==============================================================================

cc_library(
    name = "zcm-tools-util",
    srcs = glob([
        "tools/cpp/util/**/*.cpp",
        "zcm/tools/**/*.cpp",
    ]),
    hdrs = glob([
        "tools/cpp/util/**/*.hpp",
        "zcm/tools/**/*.hpp",
        "util/**/*.hpp",
    ]),
    includes = [
        ".",
        "tools/cpp",
        "zcm",
    ],
    deps = [
        ":zcm",
        ":zcm-coretypes",
        "@elfutils//:elf",
    ],
)

