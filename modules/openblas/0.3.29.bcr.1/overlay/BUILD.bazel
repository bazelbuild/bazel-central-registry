genrule(
    name = "generate_sources",
    srcs = ["generate_sources.py"],
    outs = OPENBLAS_GENERATED_SRCS,
    cmd = "python3 $(location generate_sources.py) --out_dir $(RULEDIR)",
)

cc_library(
    name = "openblas",
    srcs = OPENBLAS_GENERATED_SRCS + NON_WRAPPER_SRCS + LAPACK_INSTALL_SRCS + glob(
        [
            "lapack-netlib/SRC/*.c",
            "lapack-netlib/SRC/DEPRECATED/*.c",
            "lapack-netlib/TESTING/MATGEN/*.c",
            "lapack-netlib/LAPACKE/src/*.c",
            "lapack-netlib/LAPACKE/utils/*.c",
        ],
        exclude = [
            "lapack-netlib/SRC/xerbla.c",
            "lapack-netlib/LAPACKE/src/*rfsx*.c",
            "lapack-netlib/LAPACKE/src/*svxx*.c",
        ] + XBLAS_SRCS,
    ),
    hdrs = [
        "cblas.h",
        "openblas_config.h",
        "openblas/cblas.h",
        "openblas/openblas_config.h",
        "lapack.h",
        "lapacke.h",
        "lapacke_config.h",
        "lapacke_mangling.h",
        "lapacke_utils.h",
        "openblas/lapack.h",
        "openblas/lapacke.h",
        "openblas/lapacke_config.h",
        "openblas/lapacke_mangling.h",
        "openblas/lapacke_utils.h",
    ] + glob([
        "lapack-netlib/LAPACKE/include/*.h",
    ]),
    includes = [
        ".",
        "openblas",
        "lapack-netlib/LAPACKE/include",
    ],
    textual_hdrs = glob(
        [
            "*.h",
            "interface/**/*.h",
            "interface/**/*.c",
            "driver/**/*.h",
            "driver/**/*.c",
            "kernel/**/*.h",
            "kernel/**/*.c",
        ],
        allow_empty = True,
    ),
    local_defines = [
        "HAVE_C11",
        "SMALL_MATRIX_OPT",
        "SMP_SERVER",
        "NO_WARMUP",
        "MAX_CPU_NUMBER=64",
        "MAX_PARALLEL_NUMBER=1",
        "MAX_STACK_ALLOC=2048",
        "NO_AFFINITY",
        'VERSION=\\"0.3.29\\"',
        "BUILD_SINGLE",
        "BUILD_DOUBLE",
        "BUILD_COMPLEX",
        "BUILD_COMPLEX16",
    ],
    copts = select({
        "@platforms//os:windows": [],
        "//conditions:default": [
            "-std=gnu11",
            "-Wno-error",
            "-Wno-implicit-function-declaration",
            "-Wno-parentheses",
            "-Wno-unused-variable",
            "-Wno-unused-function",
            "-Wno-incompatible-pointer-types",
            "-Wno-return-type",
        ],
    }),
    linkopts = select({
        "@platforms//os:macos": [
            "-lpthread",
            "-ldl",
            "-lm",
        ],
        "@platforms//os:linux": [
            "-lpthread",
            "-ldl",
            "-lm",
        ],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)

cc_test(
