load(":boost_test_suite.bzl", "boost_test_helpers", "boost_test_suite")

boost_test_helpers()

_FILE_HELPERS = [":file_test_helpers"]

# Upstream only builds the filebuf replacement variants off Windows.
_NOT_ON_WINDOWS = select({
    "@platforms//os:windows": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

_REPLACEMENT = ["BOOST_NOWIDE_USE_FILEBUF_REPLACEMENT=1"]

boost_test_suite(
    name = "upstream_tests",
    # The targets upstream declares in test/Jamfile.v2.
    tests = {
        "test_codecvt": {"src": "test_codecvt.cpp"},
        "test_convert": {"src": "test_convert.cpp"},
        "test_env": {"src": "test_env.cpp"},
        "test_filebuf": {
            "src": "test_filebuf.cpp",
            "deps": _FILE_HELPERS,
        },
        "test_filebuf_internal": {
            "src": "test_filebuf.cpp",
            "defines": _REPLACEMENT,
            "deps": _FILE_HELPERS,
            "target_compatible_with": _NOT_ON_WINDOWS,
        },
        "test_fs": {
            "src": "test_fs.cpp",
            "deps": ["@boost.filesystem"],
        },
        "test_fstream": {
            "src": "test_fstream.cpp",
            "deps": _FILE_HELPERS,
        },
        "test_fstream_internal": {
            "src": "test_fstream.cpp",
            "defines": _REPLACEMENT,
            "deps": _FILE_HELPERS,
            "target_compatible_with": _NOT_ON_WINDOWS,
        },
        "test_fstream_special": {
            "src": "test_fstream_special.cpp",
            "deps": _FILE_HELPERS,
        },
        "test_fstream_special_internal": {
            "src": "test_fstream_special.cpp",
            "defines": _REPLACEMENT,
            "deps": _FILE_HELPERS,
            "target_compatible_with": _NOT_ON_WINDOWS,
        },
        "test_ifstream": {
            "src": "test_ifstream.cpp",
            "deps": _FILE_HELPERS,
        },
        "test_ifstream_internal": {
            "src": "test_ifstream.cpp",
            "defines": _REPLACEMENT,
            "deps": _FILE_HELPERS,
            "target_compatible_with": _NOT_ON_WINDOWS,
        },
        "test_iostream": {
            "src": "test_iostream.cpp",
            "deps": _FILE_HELPERS,
        },
        "test_ofstream": {
            "src": "test_ofstream.cpp",
            "deps": _FILE_HELPERS,
        },
        "test_ofstream_internal": {
            "src": "test_ofstream.cpp",
            "defines": _REPLACEMENT,
            "deps": _FILE_HELPERS,
            "target_compatible_with": _NOT_ON_WINDOWS,
        },
        "test_stackstring": {"src": "test_stackstring.cpp"},
        "test_stat": {"src": "test_stat.cpp"},
        "test_stdio": {"src": "test_stdio.cpp"},
        "test_system_n": {
            "src": "test_system.cpp",
            "defines": ["BOOST_NOWIDE_TEST_USE_NARROW=1"],
        },
        "test_traits": {"src": "test_traits.cpp"},
    },
)
