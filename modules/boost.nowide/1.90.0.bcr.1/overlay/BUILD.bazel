load("@rules_cc//cc:cc_library.bzl", "cc_library")

_TEXTUAL_HDRS = [
    "include/boost/nowide/filesystem.hpp",
    "include/boost/nowide/windows.hpp",
]

cc_library(
    name = "boost.nowide",
    srcs = glob([
        "src/*.cpp",
        "src/*.hpp",
    ]),
    hdrs = glob(
        ["include/**/*.hpp"],
        exclude = _TEXTUAL_HDRS,
    ),
    features = ["parse_headers"],
    includes = ["include"],
    textual_hdrs = _TEXTUAL_HDRS,
    visibility = ["//visibility:public"],
    deps = [
        "@boost.config",
    ],
)
