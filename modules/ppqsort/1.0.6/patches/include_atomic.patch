parallel/cpp: include <atomic> where std::atomic and std::atomic_ref are used.

mainloop_par.h chooses between the std::atomic_ref and no_atomic_ref
implementations with #ifdef __cpp_lib_atomic_ref, but nothing it includes
first is guaranteed to define that macro or to declare std::atomic_ref. With
newer libc++ (e.g. the hermetic LLVM toolchain), <version> defines
__cpp_lib_atomic_ref through other headers while <atomic> is no longer pulled
in transitively, so the atomic_ref variant is selected and fails to compile
("no template named 'atomic_ref' in namespace 'std'").

diff --git a/include/ppqsort/parallel/cpp/mainloop_par.h b/include/ppqsort/parallel/cpp/mainloop_par.h
--- a/include/ppqsort/parallel/cpp/mainloop_par.h
+++ b/include/ppqsort/parallel/cpp/mainloop_par.h
@@ -1,5 +1,7 @@
 #pragma once

+#include <atomic>  // std::atomic_ref, and defines __cpp_lib_atomic_ref tested below
+
 // Libc++ does not support atomic_ref yet
 // https://en.cppreference.com/w/cpp/compiler_support#C.2B.2B20_library_features
 #ifdef __cpp_lib_atomic_ref
diff --git a/include/ppqsort/parallel/cpp/thread_pool.h b/include/ppqsort/parallel/cpp/thread_pool.h
--- a/include/ppqsort/parallel/cpp/thread_pool.h
+++ b/include/ppqsort/parallel/cpp/thread_pool.h
@@ -1,5 +1,6 @@
 #pragma once

+#include <atomic>
 #include <functional>
 #include <mutex>
 #include <queue>
