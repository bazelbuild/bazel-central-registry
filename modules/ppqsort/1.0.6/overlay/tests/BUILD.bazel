load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_test(
    name = "ppqsort_test",
    size = "small",
    srcs = ["ppqsort_test.cc"],
    copts = select({
        "@rules_cc//cc/compiler:msvc-cl": ["/std:c++20"],
        "//conditions:default": ["-std=c++20"],
    }),
    # TSan reports races in PPQSort's parallel block swapping, which
    # synchronises through its own atomic flags (upstream behaviour).
    tags = ["notsan"],
    deps = ["@ppqsort"],
)
