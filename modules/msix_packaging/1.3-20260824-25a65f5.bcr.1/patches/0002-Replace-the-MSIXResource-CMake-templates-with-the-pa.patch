diff --git a/src/inc/internal/MSIXResource.hpp b/src/inc/internal/MSIXResource.hpp
new file mode 100644
index 00000000..697039ae
--- /dev/null
+++ b/src/inc/internal/MSIXResource.hpp
@@ -0,0 +1,72 @@
+//
+//  Copyright (C) 2019 Microsoft.  All rights reserved.
+//  See LICENSE file in the project root for full license information.
+//
+//  This file replaces the CMake-generated MSIXResource.hpp. CMake fills
+//  MSIXResource.hpp.cmakein with the trusted-root certificates and the XSD schemas, as a ZIP byte
+//  array. A pack-only build never reads that blob: AppxFactory copies it without a parse, and only the
+//  non-skip branch of SignatureValidator looks at the certificates. This file therefore holds the
+//  "no resource files" fallback of cmake/msix_resources.cmake, which is one 0x00 byte, and empty
+//  GetResources bodies.
+//
+#include "AppxPackaging.hpp"
+#include "ComHelper.hpp"
+#include "AppxFactory.hpp"
+#include <vector>
+#include <cstring>
+#include <cwchar>
+
+namespace MSIX {
+
+    namespace Resource {
+
+        enum Type
+        {
+            Certificates,
+            ContentType,
+            BlockMap,
+            AppxManifest,
+            AppxBundleManifest
+        };
+
+        const size_t resourceLength = 1;
+        extern const std::uint8_t resourceByte[resourceLength];
+    }
+
+    inline std::vector<std::pair<std::string, ComPtr<IStream>>> GetResources(IMsixFactory* factory, Resource::Type type)
+    {
+        // Validation is always off in a pack-only build, so no resource is ever requested.
+        (void)factory;
+        (void)type;
+        return {};
+    }
+
+    // The msxml6 parser keys the schema namespaces on wchar_t, the xerces parser on char. The applexml
+    // parser does not use the namespace manager at all, and neither does a pack-only build, so the
+    // s_xmlNamespaces array below is empty. This mirrors the CreateNamespaceManager section of
+    // cmake/msix_resources.cmake.
+#if defined(USING_MSXML)
+    typedef wchar_t SchemaEntryChar;
+#define MSIX_SCHEMA_ENTRY_STRCMP wcscmp
+#else
+    typedef char SchemaEntryChar;
+#define MSIX_SCHEMA_ENTRY_STRCMP strcmp
+#endif
+
+    struct SchemaEntry
+    {
+        const SchemaEntryChar*  uri;
+        const SchemaEntryChar*  alias;
+        const char*             schema;
+
+        SchemaEntry(const SchemaEntryChar* u, const SchemaEntryChar* a, const char* s) : uri(u), alias(a), schema(s) {}
+
+        inline bool operator==(const SchemaEntryChar* otherUri) const {
+            return 0 == MSIX_SCHEMA_ENTRY_STRCMP(uri, otherUri);
+        }
+    };
+
+    typedef std::vector<SchemaEntry> NamespaceManager;
+
+    extern const NamespaceManager s_xmlNamespaces[];
+}
