diff --git a/src/msix/common/MSIXResource.cpp b/src/msix/common/MSIXResource.cpp
new file mode 100644
index 00000000..fd22d1cf
--- /dev/null
+++ b/src/msix/common/MSIXResource.cpp
@@ -0,0 +1,27 @@
+//
+//  Copyright (C) 2019 Microsoft.  All rights reserved.
+//  See LICENSE file in the project root for full license information.
+//
+//  This file replaces the CMake-generated MSIXResource.cpp. See MSIXResource.hpp for why the resource
+//  blob is one 0x00 byte and the namespace manager is empty.
+//
+#include "MSIXResource.hpp"
+#include <vector>
+
+namespace MSIX {
+
+    namespace Resource {
+
+        // A pack-only build never reads this blob, so it holds the single byte that
+        // cmake/msix_resources.cmake emits when there is no resource file.
+        const std::uint8_t resourceByte[resourceLength] = {0x00};
+    }
+
+    // Four content types: ContentType, BlockMap, AppxManifest and AppxBundleManifest. No schema entry,
+    // because validation is off.
+    const NamespaceManager s_xmlNamespaces[] = {
+    {},
+    {},
+    {},
+    {}};
+}
