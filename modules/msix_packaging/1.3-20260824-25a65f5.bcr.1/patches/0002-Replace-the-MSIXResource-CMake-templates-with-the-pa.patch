 src/inc/internal/MSIXResource.hpp.cmakein | 56 ------------------
 src/msix/common/MSIXResource.cpp          | 27 +++++++++
 src/msix/common/MSIXResource.cpp.cmakein  | 20 -------
 5 files changed, 99 insertions(+), 78 deletions(-)
