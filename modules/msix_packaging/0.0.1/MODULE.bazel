"""https://github.com/microsoft/msix-packaging"""

module(
    name = "msix_packaging",
    version = "0.0.1",
    bazel_compatibility = [">=7.2.1"],
    compatibility_level = 1,
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.19")

# libmsix's POSIX PAL only; Windows uses the system crypt32/msxml6 and needs zlib alone.
bazel_dep(name = "openssl", version = "3.5.5.bcr.4")
bazel_dep(name = "zlib", version = "1.3.1.bcr.8")
