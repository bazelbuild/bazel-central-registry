module(
    name = "rules_nasm",
    version = "0.6.0",
    compatibility_level = 1,
)

bazel_dep(name = "bazel_features", version = "1.35.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "nasm", version = "2.16.03.bcr.4")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.4")

# Not used directly. The version of `rules_cc_autoconf` required by `nasm`
# does not support `--incompatible_auto_exec_groups`, so a newer version is
# required here to ensure consumers resolve a working version.
# https://github.com/periareon/rules_cc_autoconf/pull/206
bazel_dep(name = "rules_cc_autoconf", version = "0.33.1")

bazel_dep(name = "rules_rust_mdbook", version = "0.74.0", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)
bazel_dep(name = "stardoc", version = "0.8.0", dev_dependency = True)

# Protobuf does not declare the toolchain of actions which run `protoc`,
# which is required by `--incompatible_auto_exec_groups` when proto toolchain
# resolution is enabled (the default as of Bazel 9). The patch backports
# https://github.com/protocolbuffers/protobuf/pull/28328 (shipped in protobuf
# 37.0, which requires Bazel 8) and applies the same fix to `protobuf.bzl`.
# TODO: Remove once a protobuf release containing both fixes can be used.
single_version_override(
    module_name = "protobuf",
    patch_strip = 1,
    patches = ["//third_party/protobuf:auto_exec_groups.patch"],
    version = "33.4",
)

register_toolchains(
    "//nasm/toolchain",
)
