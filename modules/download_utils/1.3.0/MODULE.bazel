module(
    name = "download_utils",
    version = "1.3.0",
    bazel_compatibility = [
        ">=7.4.0",
    ],
    compatibility_level = 1,
)

bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "rules_python", version = "2.0.0")
bazel_dep(name = "bazel_skylib", version = "1.8.1")

bazel_dep(name = "rules_testing", version = "0.9.0", dev_dependency = True)
bazel_dep(name = "toolchain_utils", version = "1.0.2", dev_dependency = True)
bazel_dep(name = "pre-commit", version = "1.0.11", dev_dependency = True)
bazel_dep(name = "pre-commit-hooks", version = "1.3.1", dev_dependency = True)
bazel_dep(name = "ci-component-bazelisk", version = "3.0.0-alpha.37", dev_dependency = True, repo_name = "ci")
bazel_dep(name = "llvm", version = "0.8.21", dev_dependency = True)

# Registry override for the `@ci` module
single_version_override(
    module_name = "ci-component-bazelisk",
    registry = "https://gitlab.arm.com/ci/component/bazelisk/-/releases/v3.0.0-alpha.37/downloads",
)

# Hermetic C/C++ toolchain
register_toolchains(
    "@llvm//toolchain:all",
    dev_dependency = True,
)

# Determine Bazel separator in repository rules
separator = use_repo_rule("//lib:separator.bzl", "separator")

separator(name = "separator")

# Add implicit substitutions
download = use_extension("//download/template:defs.bzl", "download_template")
download.substitutions(
    srcs = [
        "//download/template:constraint.json",
        "//download/template:rust.json",
        "//download/template:triplet.json",
    ],
)
download.substitution(
    key = "executable.extension",
    match = "{os}",
    select = {
        "windows": ".exe",
        "//conditions:default": "",
    },
)
download.substitution(
    key = "url.basename",
    match = "//conditions:default",
    select = {
        "//conditions:default": "{urls[0].basename()}",
    },
)
