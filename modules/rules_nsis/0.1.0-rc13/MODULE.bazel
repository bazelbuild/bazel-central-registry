module(
    name = "rules_nsis",
    version = "0.1.0-rc13",
)

bazel_dep(name = "hermetic_cc_toolchain", version = "4.3.0")
bazel_dep(name = "rules_cc", version = "0.2.26", dev_dependency = True)
toolchains = use_extension("@hermetic_cc_toolchain//toolchain:ext.bzl", "toolchains", dev_dependency = True)
use_repo(toolchains, "zig_sdk")
register_toolchains(
    "@zig_sdk//toolchain/...",
    "@zig_sdk//libc_aware/toolchain/...",
    dev_dependency = True,
)

bazel_dep(name = "aspect_bazel_lib", version = "2.22.5", dev_dependency = True)
bazel_dep(name = "bazel_lib", version = "3.7.2")
bazel_dep(name = "package_metadata", version = "0.0.13")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")

############################
# SETUP SIGNING
############################
bazel_dep(name = "rules_signing", version = "0.3.1")
signing_tools = use_extension("@rules_signing//signing:extensions.bzl", "signing_tools", dev_dependency=True)
signing_tools.openssl(path = "openssl")
use_repo(
    signing_tools,
    "signing_osslsigncode",
    "signing_openssl",
    "signing_cosign",
)

register_toolchains(
    "@signing_osslsigncode//:osslsigncode_toolchain",
    "@signing_openssl//:openssl_toolchain",
    "@signing_cosign//:cosign_toolchain",
    dev_dependency=True,
)

############################
# SETUP PYTHON
############################
bazel_dep(name = "rules_python", version = "2.4.3")

rules_python_config = use_extension("@rules_python//python/extensions:config.bzl", "config")
rules_python_config.explicit_init_py(default = True)

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    python_version = "3.12",
)
use_repo(python, "python_versions")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "rules_nsis_pypi",
    python_version = "3.12",
    requirements_lock = "//nsis/toolchain:requirements_lock_txt",
)
use_repo(pip, "rules_nsis_pypi")

pip_dev = use_extension("@rules_python//python/extensions:pip.bzl", "pip", dev_dependency = True)
pip_dev.parse(
    hub_name = "rules_nsis_pypi_dev",
    python_version = "3.12",
    requirements_lock = "//tests:requirements_lock_txt",
)
use_repo(pip_dev, "rules_nsis_pypi_dev")

############################
# GET ZLIB
############################
zlib_repository = use_repo_rule("//nsis/private:zlib.bzl", "zlib_repository")
zlib_repository(name = "zlib_nsis", download = True)

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")
http_archive(
    name = "zlib_source",
    urls = ["https://github.com/madler/zlib/releases/download/v1.3.1/zlib-1.3.1.tar.gz"],
    sha256 = "9a93b2b7dfdac77ceba5a558a580e74667dd6fede4585b91eefb60f03b72df23",
    strip_prefix = "zlib-1.3.1",
    build_file_content = """
filegroup(
    name = "srcs",
    srcs = glob(["*.c", "*.h"]) + ["LICENSE"],
    visibility = ["//visibility:public"],
)
""",
)

zlib_toolchain = use_extension("//nsis/private:zlib.bzl", "zlib_toolchain")
use_repo(zlib_toolchain, zlib_zig = "zig_config")

gomplate_repository = use_repo_rule("//nsis/private:gomplate.bzl", "gomplate_repository")
gomplate_repository(name = "gomplate")

nsis = use_extension("//nsis:extensions.bzl", "nsis", dev_dependency = True)
use_repo(nsis, "nsis_tool", "nsis_toolchains")
register_toolchains(
    "@nsis_toolchains//:all",
    dev_dependency = True,
)
