module(
    name = "rules_zstd",
    version = "1.0.1",
    bazel_compatibility = [
        ">=7.1.0",
    ],
    compatibility_level = 1,
)

bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "bazel_skylib", version = "1.5.0")
bazel_dep(name = "bazel_lib", version = "3.7.1")
bazel_dep(name = "toolchain_utils", version = "1.0.2")
bazel_dep(name = "ape", version = "1.0.1")
bazel_dep(name = "zstd", version = "1.5.6", repo_name = "zstandard")
bazel_dep(name = "download_utils", version = "1.0.1")

cosmos = use_extension("@ape//ape/cosmos:defs.bzl", "ape_cosmos")
use_repo(cosmos, cosmos = "zstd")

export = use_extension("@toolchain_utils//toolchain/export:defs.bzl", "toolchain_export")
export.symlink(
    name = "zstd",
    target = "@cosmos",
)
use_repo(export, "zstd")

resolved = use_repo_rule("@toolchain_utils//toolchain/resolved:defs.bzl", "toolchain_resolved")

resolved(
    name = "resolved-zstd",
    toolchain_type = "//zstd/toolchain/zstd:type",
)

register_toolchains("//zstd/toolchain/...")

bazel_dep(name = "rules_python", version = "2.0.0", dev_dependency = True)
bazel_dep(name = "ci-component-bazelisk", version = "3.0.0-alpha.29", dev_dependency = True, repo_name = "ci")
single_version_override(
    module_name = "ci-component-bazelisk",
    registry = "https://gitlab.arm.com/ci/component/bazelisk/-/releases/v3.0.0-alpha.29/downloads",
)

bazel_dep(name = "pre-commit", version = "1.0.11", dev_dependency = True)
bazel_dep(name = "pre-commit-hooks", version = "1.3.1", dev_dependency = True)
