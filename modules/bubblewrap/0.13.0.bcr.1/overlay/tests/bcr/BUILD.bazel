load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# Overlay files aren't guaranteed to keep their executable bit.
copy_file(
    name = "version_test_sh",
    src = "version_test.sh",
    out = "version_test_exec.sh",
    is_executable = True,
)

sh_test(
    name = "version_test",
    srcs = [":version_test_sh"],
    args = [
        "$(rootpath @bubblewrap//:bwrap)",
        "'bubblewrap 0.13.0'",
    ],
    data = ["@bubblewrap//:bwrap"],
)
