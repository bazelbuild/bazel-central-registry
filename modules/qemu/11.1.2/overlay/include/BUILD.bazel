load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_enabled")

# QEMU's headers.  They form one tree whose parts include each other
# freely (qemu/, hw/, block/, system/ ...), which is why this is one
# library rather than one per directory.  It also carries what Meson
# puts on every compile line: the generated headers (genh), the host
# and TCG backend headers, linux-headers and glib.
# Generators read some of these (block/block-gen.c).
exports_files(glob(["**/*.h"]), visibility = ["//:__subpackages__"])

cc_library(
    name = "qemu",
    hdrs = glob(["**/*.h"]),
    includes = ["."],
    textual_hdrs = glob(["**/*.inc"]),
    visibility = ["//:__subpackages__"],
    deps = [
        "//:genh",
        "//accel/tcg:headers",
        "//ebpf:headers",
        "//host/include:x86_64",
        "//hw/usb:headers",
        "//linux-headers",
        "//monitor:headers",
        "//qapi:headers",
        "//tcg/x86_64:headers",
        "//trace:headers",
        "//ui:genh",
        "//ui/shader:genh",
        "@glib//glib",
        "@glib//gmodule:headers",
    ] + (["@pixman"] if qemu_enabled("pixman") else []),
)
