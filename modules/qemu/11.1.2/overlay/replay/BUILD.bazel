load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from replay/meson.build.

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_TCG",
            [
                "replay.c",
                "replay-internal.c",
                "replay-events.c",
                "replay-time.c",
                "replay-input.c",
                "replay-char.c",
                "replay-snapshot.c",
                "replay-net.c",
                "replay-audio.c",
                "replay-random.c",
                "replay-debugging.c",
            ],
            if_false = ["stubs-system.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
