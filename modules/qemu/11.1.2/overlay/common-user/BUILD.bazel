load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_user_source_set")

cc_library(
    name = "headers",
    includes = ["host/x86_64"],
    textual_hdrs = ["host/x86_64/safe-syscall.inc.S"],
    visibility = ["//linux-user:__pkg__"],
)

qemu_user_source_set(
    name = "user_ss",
    srcs = [
        "mmap-min-addr.c",
        "probe-guest-base.c",
        "safe-syscall.S",
        "safe-syscall-error.c",
        "selfmap.c",
    ],
    visibility = ["//visibility:public"],
)
