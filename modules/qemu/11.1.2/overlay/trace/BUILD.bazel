    "target/s390x",
    "target/s390x/kvm",
    "target/sparc",
] if qemu_enabled("have_system|have_user") else [])

# group name -> trace-events file
TRACE_GROUPS = dict(
    [("root", "//:trace-events")] +
    [(
        underscorify(d),
        "//{}:trace-events".format(d),
    ) for d in TRACE_EVENTS_SUBDIRS] +
    [(
        underscorify(f),
        "//qapi:" + f,
    ) for f in QAPI_TRACE_EVENTS],
)

[trace_events(group, src) for group, src in TRACE_GROUPS.items()]

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]) + ["trace-{}.h".format(g) for g in TRACE_GROUPS],
    includes = ["."],
    visibility = ["//include:__pkg__"],
)

qemu_archive_part(
    # of libqemuutil.a
    name = "util_ss",
    srcs = ["control.c"] + (["simple.c"] if "simple" in TRACE_BACKENDS else []) +
           ["trace-{}.c".format(g) for g in TRACE_GROUPS],
    when = [
        when(
            "have_system|have_tools|have_ga",
            ["qmp.c"],
        ),
    ],
)

qemu_source_set(
    name = "system_ss",
    srcs = ["control-target.c"],
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "have_hmp",
            ["trace-hmp-cmds.c"],
        ),
    ],
)

qemu_package()
