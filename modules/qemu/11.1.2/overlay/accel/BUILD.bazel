load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "qemu_user_source_set")

# Translated from accel/meson.build.

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

qemu_source_set(
    name = "common_ss",
    srcs = ["accel-common.c"],
    visibility = ["//visibility:public"],
    deps = [":headers"],
)

qemu_source_set(
    name = "system_ss",
    srcs = [
        "accel-blocker.c",
        "accel-irq.c",
        "accel-qmp.c",
        "accel-system.c",
        "dummy-cpus.c",
    ],
    kind = "system",
    visibility = ["//visibility:public"],
    deps = [":headers"],
)

qemu_user_source_set(
    name = "user_ss",
    srcs = ["accel-user.c"],
    visibility = ["//visibility:public"],
    deps = [":headers"],
)

# accel/tcg is only added by Meson for CONFIG_TCG builds.
qemu_package(subdirs = [
    "hvf",
    "whpx",
    "qtest",
    "kvm",
    "xen",
    "stubs",
    "mshv",
    "nitro",
])
