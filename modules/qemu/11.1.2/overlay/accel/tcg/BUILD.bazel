load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "qemu_user_source_set", "when")

# Translated from accel/tcg/meson.build.

exports_files(["trace-events"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    textual_hdrs = glob(["*.inc"]),
    visibility = ["//visibility:public"],
)

_TCG_SRCS = [
    "cpu-exec.c",
    "cpu-exec-common.c",
    "tb-maint.c",
    "tcg-all.c",
    "tcg-runtime.c",
    "tcg-runtime-gvec.c",
    "tcg-stats.c",
    "translate-all.c",
    "translator.c",
]

_TCG_WHEN = [when(
    "plugins",
    ["plugin-gen.c"],
)]

qemu_source_set(
    name = "system_ss",
    srcs = _TCG_SRCS + [
        "cputlb.c",
        "icount-common.c",
        "monitor.c",
        "tcg-accel-ops.c",
        "tcg-accel-ops-icount.c",
        "tcg-accel-ops-mttcg.c",
        "tcg-accel-ops-rr.c",
        "watchpoint.c",
    ],
    kind = "system",
    visibility = ["//visibility:public"],
    when = _TCG_WHEN,
    deps = [":headers"],
)

qemu_user_source_set(
    name = "user_ss",
    srcs = _TCG_SRCS + [
        "user-exec.c",
        "user-exec-stub.c",
    ],
    visibility = ["//visibility:public"],
    when = _TCG_WHEN,
    deps = [":headers"],
)

qemu_package()
