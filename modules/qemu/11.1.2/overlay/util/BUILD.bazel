load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_archive_part", "qemu_package", "when")
load("//bazel/config:options.bzl", "OPTIONS")

# Translated from util/meson.build.

exports_files(["trace-events"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

qemu_archive_part(
    # of libqemuutil.a
    name = "util_ss",
    srcs = [
        "bitmap.c",
        "bitops.c",
        "cacheflush.c",
        "crc32.c",
        "crc32c.c",
        "cutils.c",
        "datadir.c",
        "defer-call.c",
        "envlist.c",
        "error.c",
        "error-report.c",
        "event.c",
        "fifo8.c",
        "getauxval.c",
        "guest-random.c",
        "hexdump.c",
        "host-utils.c",
        "id.c",
        "int128.c",
        "interval-tree.c",
        "keyval.c",
        "lockcnt.c",
        "log.c",
        "memalign.c",
        "module.c",
        "notify.c",
        "osdep.c",
        "path.c",
        "qdist.c",
        "qemu-config.c",
        "qemu-option.c",
        "qemu-print.c",
        "qemu-progress.c",
        "qemu-timer-common.c",
        "qht.c",
        "qsp.c",
        "range.c",
        "rcu.c",
        "reserved-region.c",
        "systemd.c",
        "thread-context.c",
        "transactions.c",
        "unicode.c",
        "uuid.c",
    ],
    when = [
        when(
            "!CONFIG_WIN32",
            [
                "aio-posix.c",
                "fdmon-poll.c",
            ],
        ),
        when(
            [
                "!CONFIG_WIN32",
                "CONFIG_EPOLL",
            ],
            ["fdmon-epoll.c"],
        ),
        when(
            "!CONFIG_WIN32",
            [
                "compatfd.c",
                "event_notifier-posix.c",
            ],
        ),
        when(
            [
                "!CONFIG_WIN32",
                "!host_emscripten",
            ],
            ["mmap-alloc.c"],
        ),
        when(
            "!CONFIG_WIN32",
            [
                "oslib-posix.c",
                "qemu-thread-posix.c",
                "memfd.c",
                "drm.c",
            ],
        ),
        when(
            "CONFIG_WIN32",
            [
                "aio-win32.c",
                "event_notifier-win32.c",
                "oslib-win32.c",
                "qemu-thread-win32.c",
            ],
        ),
        when(
            "linux_io_uring",
            ["fdmon-io_uring.c"],
        ),
        when(
            "glib_has_gslice",
            ["qtree.c"],
        ),
        when(
            "have_membarrier",
            ["sys_membarrier.c"],
        ),
        when(
            "have_system",
            ["crc-ccitt.c"],
        ),
        when(
            [
                "have_system",
                "gio",
            ],
            ["dbus.c"],
        ),
        when(
            [
                "have_system",
                "CONFIG_LINUX",
            ],
            ["userfaultfd.c"],
        ),
        when(
            "have_block|have_ga",
            [
                "aiocb.c",
                "async.c",
                "aio-wait.c",
                "base64.c",
                "main-loop.c",
                "qemu-coroutine.c",
                "qemu-coroutine-lock.c",
                "qemu-coroutine-io.c",
                "coroutine-" + OPTIONS["coroutine_backend"] + ".c",
                "thread-pool.c",
                "qemu-timer.c",
                "qemu-sockets.c",
            ],
        ),
        when(
            "have_block",
            [
                "buffer.c",
                "bufferiszero.c",
                "hbitmap.c",
                "iova-tree.c",
                "iov.c",
                "nvdimm-utils.c",
                "block-helpers.c",
                "qemu-coroutine-sleep.c",
                "qemu-co-shared-resource.c",
                "qemu-co-timeout.c",
                "readline.c",
                "throttle.c",
                "timed-average.c",
            ],
        ),
        when(
            [
                "have_block",
                "CONFIG_INOTIFY1",
            ],
            ["filemonitor-inotify.c"],
        ),
        when(
            [
                "have_block",
                "!CONFIG_INOTIFY1",
            ],
            ["filemonitor-stub.c"],
        ),
        when(
            [
                "have_block",
                "CONFIG_LINUX",
            ],
            [
                "vhost-user-server.c",
                "vfio-helpers.c",
                "chardev_open.c",
            ],
        ),
        when(
            "have_block",
            ["yank.c"],
        ),
        when(
            "host_cpu=aarch64",
            ["cpuinfo-aarch64.c"],
        ),
        when(
            [
                "!host_cpu=aarch64",
                "host_cpu=x86_64",
            ],
            ["cpuinfo-i386.c"],
        ),
        when(
            [
                "!host_cpu=aarch64",
                "!host_cpu=x86_64",
                "host_cpu=loongarch64",
            ],
            ["cpuinfo-loongarch.c"],
        ),
        when(
            [
                "!host_cpu=aarch64",
                "!host_cpu=x86_64",
                "!host_cpu=loongarch64",
                "host_cpu=ppc64",
            ],
            ["cpuinfo-ppc.c"],
        ),
        when(
            [
                "!host_cpu=aarch64",
                "!host_cpu=x86_64",
                "!host_cpu=loongarch64",
                "!host_cpu=ppc64",
                "host_cpu=riscv64",
            ],
            ["cpuinfo-riscv.c"],
        ),
        when(
            [
                "!host_cpu=aarch64",
                "!host_cpu=x86_64",
                "!host_cpu=loongarch64",
                "!host_cpu=ppc64",
                "!host_cpu=riscv64",
                "host_cpu=s390x",
            ],
            ["s390x_pci_mmio.c"],
        ),
    ],
    deps = [
        ":headers",
        "//subprojects/libvhost-user:headers",
    ],
)

qemu_package()
