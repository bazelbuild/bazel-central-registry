load("@rules_cc//cc:cc_library.bzl", "cc_library")

# configure links linux-headers/asm to the host's asm-<arch> directory.
cc_library(
    name = "asm",
    hdrs = glob(["asm-x86/**/*.h"]),
    include_prefix = "asm",
    strip_include_prefix = "asm-x86",
)

cc_library(
    name = "linux-headers",
    hdrs = glob([
        "linux/**/*.h",
        "asm-generic/**/*.h",
    ]),
    # Use a virtual -I path, like :asm, so Zig's bundled Linux UAPI
    # headers never take precedence over QEMU's pinned copies.
    strip_include_prefix = "/linux-headers",
    visibility = ["//:__subpackages__"],
    deps = [":asm"],
)
