load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set")

# Translated from nbd/meson.build.

exports_files(["trace-events"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

qemu_source_set(
    name = "block_ss",
    srcs = [
        "client.c",
        "client-connection.c",
        "common.c",
    ],
    visibility = ["//visibility:public"],
    deps = [
        ":headers",
        "//block:module_block",
    ],
)

qemu_source_set(
    name = "blockdev_ss",
    srcs = ["server.c"],
    visibility = ["//visibility:public"],
    deps = [":headers"],
)

qemu_package()
