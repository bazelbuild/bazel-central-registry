qemu_source_set(
    name = "system_ss",
    srcs = [
        "block-ram-registrar.c",
        "qapi-system.c",
    ],
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_TCG",
            ["blkreplay.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package(subdirs = [
    "export",
    "monitor",
])
