load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from block/export/meson.build.

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

qemu_source_set(
    name = "blockdev_ss",
    srcs = ["export.c"],
    visibility = ["//visibility:public"],
    when = [
        when(
            "have_vhost_user_blk_server",
            [
                "vhost-user-blk-server.c",
                "virtio-blk-handler.c",
            ],
        ),
        when(
            "fuse",
            ["fuse.c"],
        ),
        when(
            "have_vduse_blk_export",
            [
                "vduse-blk.c",
                "virtio-blk-handler.c",
            ],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
