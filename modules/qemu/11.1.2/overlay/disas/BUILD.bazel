load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "qemu_target_source_set", "when")

# Translated from disas/meson.build.

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_source_set(
    name = "common_ss",
    srcs = ["disas-common.c"],
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_ALPHA_DIS",
            ["alpha.c"],
        ),
        when(
            "CONFIG_HEXAGON_DIS",
            ["hexagon.c"],
        ),
        when(
            "CONFIG_HPPA_DIS",
            ["hppa.c"],
        ),
        when(
            "CONFIG_M68K_DIS",
            ["m68k.c"],
        ),
        when(
            "CONFIG_MICROBLAZE_DIS",
            ["microblaze.c"],
        ),
        when(
            "CONFIG_MIPS_DIS",
            [
                "mips.c",
                "nanomips.c",
            ],
        ),
        when(
            "CONFIG_RISCV_DIS",
            [
                "riscv.c",
                "riscv-xthead.c",
                "riscv-xventana.c",
                "riscv-xlrbr.c",
            ],
        ),
        when(
            "CONFIG_SH4_DIS",
            ["sh4.c"],
        ),
        when(
            "CONFIG_SPARC_DIS",
            ["sparc.c"],
        ),
        when(
            "CONFIG_XTENSA_DIS",
            ["xtensa.c"],
        ),
        when(
            "capstone",
            ["capstone.c"],
        ),
        when(
            "CONFIG_TCG",
            [
                "disas-host.c",
                "disas-target.c",
                "objdump.c",
            ],
        ),
    ],
    deps = [":headers"],
)

qemu_source_set(
    name = "system_ss",
    srcs = ["disas-mon.c"],
    kind = "system",
    visibility = ["//:__subpackages__"],
    deps = [":headers"],
)

qemu_target_source_set(
    name = "specific_ss",
    visibility = ["//:__subpackages__"],
    deps = [":headers"],
)

qemu_package()
