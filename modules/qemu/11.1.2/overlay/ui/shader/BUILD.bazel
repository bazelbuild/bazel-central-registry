load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:python_gen.bzl", "python_gen")
load("//bazel:qemu.bzl", "qemu_package")

# ui/shader/meson.build: the GLSL shaders as C strings.
SHADERS = [
    ("texture-blit", "frag"),
    ("texture-blit", "vert"),
    ("texture-blit-flip", "vert"),
]

[python_gen(
    name = "{}-{}_h".format(name, kind),
    srcs = ["{}.{}".format(name, kind)],
    outs = ["{}-{}.h".format(name, kind)],
    arguments = ["{inputs}"],
    capture_stdout = True,
    script = "//scripts:shaderinclude.py",
) for name, kind in SHADERS]

# Part of Meson's genh (see //ui:genh).
cc_library(
    name = "genh",
    hdrs = ["{}-{}.h".format(n, k) for n, k in SHADERS],
    includes = ["."],
    visibility = ["//include:__pkg__"],
)

qemu_package()
