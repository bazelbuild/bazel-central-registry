load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:python_gen.bzl", "python_gen")
load("//qapi:qapi.bzl", "QAPI_NONMODULE_OUTPUTS")

package(default_visibility = ["//storage-daemon:__pkg__"])

# Most modules are shared with the main schema; generate only the daemon's
# own entry points, types and command registry (see qapi-schema.json).
python_gen(
    name = "qapi_files",
    src = "qapi-schema.json",
    srcs = ["//qapi:schema_inputs"],
    outs = QAPI_NONMODULE_OUTPUTS + [
        "qapi-commands.trace-events",
        "qapi-features.c",
        "qapi-features.h",
        "qapi-init-commands.trace-events",
    ],
    arguments = [
        "-o",
        "{out_dir}",
        "{src}",
    ],
    script = "//scripts:qapi-gen.py",
    deps = ["//scripts:qapi_sources"],
)

filegroup(
    name = "srcs",
    srcs = [output for output in QAPI_NONMODULE_OUTPUTS if output.endswith(".c")],
)

cc_library(
    name = "headers",
    hdrs = [output for output in QAPI_NONMODULE_OUTPUTS if output.endswith(".h")] + ["qapi-features.h"],
    includes = ["."],
)
