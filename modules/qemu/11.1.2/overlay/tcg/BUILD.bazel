load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "qemu_user_source_set", "when")

# Translated from tcg/meson.build.

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)
# TCI (--enable-tcg-interpreter, which needs libffi) is not supported here.

_TCG_SRCS = [
    "optimize.c",
    "region.c",
    "tcg.c",
    "tcg-common.c",
    "tcg-op.c",
    "tcg-op-gvec.c",
    "tcg-op-ldst.c",
    "tcg-op-vec.c",
]

_TCG_WHEN = [
    when(
        "tcg_interpreter",
        ["tci.c"],
    ),
    when(
        "libdw",
        ["debuginfo.c"],
    ),
    when(
        "CONFIG_LINUX",
        ["perf.c"],
    ),
]

qemu_source_set(
    name = "system_ss",
    srcs = _TCG_SRCS,
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = _TCG_WHEN,
    deps = [":headers"],
)

qemu_user_source_set(
    name = "user_ss",
    srcs = _TCG_SRCS,
    visibility = ["//:__subpackages__"],
    when = _TCG_WHEN,
    deps = [":headers"],
)

qemu_package()
