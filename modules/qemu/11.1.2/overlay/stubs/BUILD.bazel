load("//bazel:qemu.bzl", "qemu_archive_part", "qemu_package", "when")

# Translated from stubs/meson.build.

qemu_archive_part(
    # of libqemuutil.a
    name = "stub_ss",
    srcs = [
        "cpu-get-clock.c",
        "fdset.c",
        "iothread-lock.c",
        "is-daemonized.c",
        "monitor-core.c",
        "replay-mode.c",
        "trace-control.c",
    ],
    when = [
        when(
            "have_block",
            [
                "bdrv-next-monitor-owned.c",
                "blk-commit-all.c",
                "blk-exp-close-all.c",
                "blockdev-close-all-bdrv-states.c",
                "change-state-handler.c",
                "get-vm-name.c",
                "iothread-lock-block.c",
                "migr-blocker.c",
                "physmem.c",
                "ram-block.c",
                "runstate-check.c",
                "uuid.c",
            ],
        ),
        when(
            "have_block|have_ga",
            [
                "replay-tools.c",
                "cpus-virtual-clock.c",
                "icount.c",
                "graph-lock.c",
            ],
        ),
        when(
            [
                "have_block|have_ga",
                "libaio",
            ],
            ["linux-aio.c"],
        ),
        when(
            "have_block|have_ga",
            [
                "qemu-timer-notify-cb.c",
                "monitor-internal.c",
                "qmp-command-available.c",
                "qmp-quit.c",
                "async-run-on-cpu.c",
                "cpus-queue.c",
            ],
        ),
        when(
            "have_block|have_user",
            [
                "qtest.c",
                "vm-stop.c",
                "vmstate.c",
            ],
        ),
        when(
            "have_user",
            [
                "cpu-synchronize-state.c",
                "cpu-destroy-address-spaces.c",
                "qom-compat-properties.c",
            ],
        ),
        when(
            [
                "have_user",
                "!have_system",
            ],
            ["qdev.c"],
        ),
        when(
            "have_system",
            [
                "cmos.c",
                "dump.c",
                "fw_cfg.c",
            ],
        ),
        when(
            [
                "have_system",
                "igvm",
            ],
            ["igvm.c"],
        ),
        when(
            "have_system",
            [
                "kvm.c",
                "win32-kbd-hook.c",
                "xen-hw-stub.c",
                "qmp-arm-gic.c",
                "qmp-i386-rtc.c",
                "qmp-i386-sev.c",
                "qmp-i386-sgx.c",
                "qmp-i386-xen.c",
                "qmp-cpu.c",
                "qmp-cpu-s390x.c",
                "qmp-cpu-s390x-kvm.c",
            ],
        ),
        when(
            [
                "have_system",
                "have_hmp",
            ],
            [
                "hmp-cmd-info_mem.c",
                "hmp-cmd-info_sev.c",
                "hmp-cmd-info_tlb.c",
                "hmp-cmds-hw-s390x.c",
                "hmp-cmds-target-i386.c",
            ],
        ),
        when(
            "have_system|have_user",
            [
                "replay.c",
                "hotplug-stubs.c",
                "sysbus.c",
            ],
        ),
    ],
    deps = ["//monitor:headers"],
)

qemu_package()
