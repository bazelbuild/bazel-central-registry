"""Configuration headers rendered from Starlark dictionaries.

The Bazel counterparts of meson.build's configure_file(configuration:)
for config-host.h, <target>-config-target.h and <target>-config-devices.h.
"""

load("@bazel_skylib//rules:write_file.bzl", "write_file")

_BANNER = [
    "/*",
    " * Autogenerated by the Bazel build from //bazel/config.",
    " * Do not edit, your changes will be lost.",
    " */",
    "",
    "#pragma once",
    "",
]

def _render(key, value):
    if value == True:
        return "#define " + key
    if value == False:
        return "#undef " + key
    return "#define {} {}".format(key, value)

def config_header(name, out, values, **kwargs):
    """Writes `out` with one #define/#undef per entry of `values`."""
    lines = list(_BANNER)
    for key in sorted(values.keys()):
        lines += [_render(key, values[key]), ""]
    write_file(name = name, out = out, content = lines, **kwargs)

# meson.build: keys of config_target that are not written to config-target.h
_TARGET_IGNORED = ["TARGET_XML_FILES", "TARGET_ABI_DIR"]

def config_target_values(config):
    """meson.build's config_target_data for one target configuration."""
    devices = config.get("DEVICES", [])
    values = {}
    for k, v in config.items():
        if k in devices or k in _TARGET_IGNORED:
            continue
        if not (k.startswith("TARGET_") or k.startswith("CONFIG_")):
            continue
        if k in ("TARGET_ARCH", "TARGET_ARCH_VARIANT"):
            values[k] = v.upper()
        elif k == "TARGET_BASE_ARCH":
            values["TARGET_" + v.upper()] = 1
        elif k in ("TARGET_NAME", "CONFIG_QEMU_INTERP_PREFIX"):
            values[k] = '"{}"'.format(v)
        elif v == "y":
            values[k] = 1
        elif v == "n":
            values[k] = 0
        else:
            values[k] = v
    return values

def config_devices_values(config):
    return {k: 1 for k in config.get("DEVICES", [])}

# scripts/make-config-poison.sh filters these manually handled symbols.
_POISON_EXCEPTIONS = [
    "CONFIG_TCG",
    "CONFIG_USER_ONLY",
    "CONFIG_SOFTMMU",
    "TARGET_NOT_USING_LEGACY_LDST_PHYS_API",
    "TARGET_NOT_USING_LEGACY_NATIVE_ENDIAN_API",
]

def config_poison(name, out, configs):
    keys = {}
    for config in configs:
        for key, value in (config_target_values(config) | config_devices_values(config)).items():
            if value != False and not any([exception in key for exception in _POISON_EXCEPTIONS]):
                keys[key] = None
    write_file(name = name, out = out, content = ["#pragma GCC poison " + key for key in sorted(keys)] + [""])
