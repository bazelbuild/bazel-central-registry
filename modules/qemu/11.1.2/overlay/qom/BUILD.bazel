load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from qom/meson.build.

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_source_set(
    name = "qom_ss",
    srcs = [
        "container.c",
        "object.c",
        "object_interfaces.c",
        "qom-qobject.c",
    ],
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "have_system",
            ["compat-properties.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_source_set(
    name = "qmp_ss",
    srcs = ["qom-qmp-cmds.c"],
    visibility = ["//:__subpackages__"],
    deps = [":headers"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "have_hmp",
            ["qom-hmp-cmds.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
