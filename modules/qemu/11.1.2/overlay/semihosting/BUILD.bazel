load("//bazel:qemu.bzl", "qemu_archive_part", "qemu_package", "qemu_source_set", "qemu_target_source_set", "when")

# Translated from semihosting/meson.build.

qemu_archive_part(
    # of libqemuutil.a
    name = "stub_ss",
    srcs = [
        "arm-compat-semi-stub.c",
        "stubs-all.c",
        "stubs-system.c",
    ],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//visibility:public"],
    when = [
        when(
            "CONFIG_SEMIHOSTING",
            [
                "config.c",
                "console.c",
                "guestfd.c",
                "uaccess.c",
                "syscalls.c",
            ],
        ),
        when(
            "CONFIG_ARM_COMPATIBLE_SEMIHOSTING",
            ["arm-compat-semi.c"],
        ),
    ],
)

qemu_target_source_set(
    name = "specific_ss",
    visibility = ["//visibility:public"],
    when = [
        when(
            [
                "CONFIG_SEMIHOSTING",
                "CONFIG_USER_ONLY",
            ],
            ["syscalls.c"],
        ),
        when(
            [
                "CONFIG_ARM_COMPATIBLE_SEMIHOSTING",
                "CONFIG_USER_ONLY",
            ],
            ["arm-compat-semi.c"],
        ),
    ],
)

qemu_package()
