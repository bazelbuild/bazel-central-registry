load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from chardev/meson.build.

exports_files(["trace-events"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

qemu_source_set(
    name = "chardev_ss",
    srcs = [
        "char.c",
        "char-fe.c",
        "char-file.c",
        "char-hub.c",
        "char-io.c",
        "char-mux.c",
        "char-null.c",
        "char-pipe.c",
        "char-ringbuf.c",
        "char-serial.c",
        "char-socket.c",
        "char-stdio.c",
        "char-udp.c",
    ],
    linkopts = ["-lutil"],
    visibility = ["//visibility:public"],
    when = [
        when(
            "CONFIG_WIN32",
            [
                "char-console.c",
                "char-win-stdio.c",
                "char-win.c",
            ],
        ),
        when(
            "!CONFIG_WIN32",
            [
                "char-fd.c",
                "char-parallel.c",
                "char-pty.c",
            ],
        ),
    ],
    deps = [":headers"],
)

qemu_source_set(
    name = "system_ss",
    srcs = [
        "msmouse.c",
        "testdev.c",
        "wctablet.c",
    ],
    kind = "system",
    visibility = ["//visibility:public"],
    when = [
        when(
            "have_hmp",
            ["char-hmp-cmds.c"],
        ),
        when(
            [
                "spice",
                "brlapi",
                "brlapi",
            ],
            ["baum.c"],
        ),
        when(
            [
                "spice",
                "spice",
                "spice",
            ],
            ["spice.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
