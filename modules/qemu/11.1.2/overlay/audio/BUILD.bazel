load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from audio/meson.build.

exports_files(["trace-events"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)
# The audio drivers (alsa, pa, ...) are modules; none is enabled here.

# The audio drivers (alsa, pa, ...) are modules; none is enabled here.
qemu_source_set(
    name = "audio_ss",
    srcs = [
        "audio.c",
        "audio-be.c",
        "audio-mixeng-be.c",
        "mixeng.c",
        "noaudio.c",
        "wavaudio.c",
    ],
    visibility = ["//visibility:public"],
    when = [
        when(
            [
                "dbus_display",
                "dbus_display",
                "gio",
                "pixman",
            ],
            ["dbusaudio.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//visibility:public"],
    when = [
        when(
            "have_hmp",
            [
                "audio-hmp-cmds.c",
                "wavcapture.c",
            ],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
