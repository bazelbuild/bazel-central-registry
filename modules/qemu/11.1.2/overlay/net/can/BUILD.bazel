load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from net/can/meson.build.

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_CAN_BUS",
            [
                "can_core.c",
                "can_host.c",
            ],
        ),
        when(
            [
                "CONFIG_CAN_BUS",
                "CONFIG_LINUX",
            ],
            ["can_socketcan.c"],
        ),
    ],
)

qemu_package()
