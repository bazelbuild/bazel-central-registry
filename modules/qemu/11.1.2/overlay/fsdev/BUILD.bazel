load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_archive_part", "qemu_package", "qemu_source_set", "when")

# Translated from fsdev/meson.build.

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

qemu_archive_part(
    # of libqemuutil.a
    name = "stub_ss",
    when = [
        when(
            "CONFIG_LINUX|CONFIG_DARWIN|CONFIG_FREEBSD",
            ["qemu-fsdev-dummy.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//visibility:public"],
    when = [
        when(
            "CONFIG_LINUX|CONFIG_DARWIN|CONFIG_FREEBSD",
            [
                "qemu-fsdev-opts.c",
                "qemu-fsdev-throttle.c",
            ],
        ),
        when(
            [
                "CONFIG_LINUX|CONFIG_DARWIN|CONFIG_FREEBSD",
                "CONFIG_FSDEV_9P",
            ],
            [
                "9p-iov-marshal.c",
                "9p-marshal.c",
                "qemu-fsdev.c",
            ],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
