load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from system/meson.build.

exports_files([
    "main.c",  # qemu-system-<target>
    "trace-events",
], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    textual_hdrs = glob(["*.inc"]),
    visibility = ["//:__subpackages__"],
    deps = ["//migration:headers"],
)

qemu_source_set(
    name = "system_ss",
    srcs = [
        "arch_init.c",
        "balloon.c",
        "bootdevice.c",
        "cpu-timers.c",
        "cpus.c",
        "dirtylimit.c",
        "dma-helpers.c",
        "exit-with-parent.c",
        "globals.c",
        "ioport.c",
        "memory.c",
        "memory_mapping.c",
        "physmem.c",
        "qdev-monitor.c",
        "qtest.c",
        "ram-block-attributes.c",
        "ram-discard-manager.c",
        "rtc.c",
        "runstate.c",
        "runstate-action.c",
        "vl.c",
        "watchpoint.c",
    ],
    kind = "system",
    textual_hdrs = ["//:qemu-options.def"],
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "have_hmp",
            [
                "runstate-hmp-cmds.c",
                "tpm-hmp-cmds.c",
            ],
        ),
        when(
            "have_tpm",
            ["tpm.c"],
        ),
        when(
            "seccomp",
            ["qemu-seccomp.c"],
        ),
        when(
            "CONFIG_DEVICE_TREE",
            ["device_tree.c"],
            if_false = ["device_tree-stub.c"],
        ),
        when(
            "CONFIG_LINUX",
            ["async-teardown.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
