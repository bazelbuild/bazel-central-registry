# Build-time generators (meson.build: tracetool, qapi_gen, hxtool, ...).

load("@rules_python//python:py_binary.bzl", "py_binary")
load("@rules_python//python:py_library.bzl", "py_library")
load("@rules_shell//shell:sh_binary.bzl", "sh_binary")

package(default_visibility = ["//visibility:public"])

exports_files([
    "block-coroutine-wrapper.py",
    "decodetree.py",
    "feature_to_c.py",
    "minikconf.py",
    "modules/module_block.py",
    "qapi-gen.py",
    "shaderinclude.py",
    "tracetool.py",
])

filegroup(
    name = "qapi_sources",
    srcs = glob(["qapi/*.py"]),
)

filegroup(
    name = "tracetool_sources",
    srcs = glob(["tracetool/**/*.py"]),
)

py_library(
    name = "qapi",
    srcs = glob(["qapi/*.py"]),
    imports = ["."],
)

py_binary(
    name = "qapi-gen",
    srcs = ["qapi-gen.py"],
    deps = [":qapi"],
)

py_library(
    name = "tracetool_lib",
    srcs = glob(["tracetool/**/*.py"]),
    imports = ["."],
)

# Named apart from the tracetool/ package directory, whose files are
# also outputs of the binary's runfiles tree.
py_binary(
    name = "tracetool-gen",
    srcs = ["tracetool.py"],
    main = "tracetool.py",
    deps = [":tracetool_lib"],
)

py_binary(
    name = "decodetree",
    srcs = ["decodetree.py"],
)

py_binary(
    name = "feature_to_c",
    srcs = ["feature_to_c.py"],
)

py_binary(
    name = "block-coroutine-wrapper",
    srcs = ["block-coroutine-wrapper.py"],
)

py_binary(
    name = "module_block",
    srcs = ["modules/module_block.py"],
    main = "modules/module_block.py",
)

sh_binary(
    name = "hxtool-gen",
    srcs = ["hxtool"],
)

sh_binary(
    name = "make-config-poison",
    srcs = ["make-config-poison.sh"],
)

sh_binary(
    name = "qemu-version",
    srcs = ["qemu-version.sh"],
)

py_binary(
    name = "shaderinclude",
    srcs = ["shaderinclude.py"],
)
