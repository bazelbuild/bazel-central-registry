load("//bazel:qemu.bzl", "qemu_package", "qemu_target_source_set", "when")

# target/i386/tcg/user/meson.build's i386_user_ss.
qemu_target_source_set(
    name = "i386_user_ss",
    arch = "i386",
    mode = "user",
    visibility = ["//:__subpackages__"],
    when = [when(
        "CONFIG_TCG",
        [
            "excp_helper.c",
            "seg_helper.c",
        ],
    )],
)

qemu_package()
