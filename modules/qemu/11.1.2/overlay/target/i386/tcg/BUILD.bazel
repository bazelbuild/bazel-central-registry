load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_target_source_set", "when")

# Translated from target/i386/tcg/meson.build.

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    textual_hdrs = glob(["*.inc"]),
    visibility = ["//:__subpackages__"],
)

qemu_target_source_set(
    name = "i386_ss",
    arch = "i386",
    mode = "both",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_TCG",
            [
                "access.c",
                "bpt_helper.c",
                "cc_helper.c",
                "excp_helper.c",
                "fpu_helper.c",
                "int_helper.c",
                "mem_helper.c",
                "misc_helper.c",
                "mpx_helper.c",
                "seg_helper.c",
                "tcg-cpu.c",
                "translate.c",
            ],
            if_false = ["tcg-stub.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package(subdirs = [
    "system",
    "user",
])
