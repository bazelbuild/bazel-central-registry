load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Host-specific overrides of host/include/generic, searched first.
cc_library(
    name = "x86_64",
    hdrs = glob([
        "x86_64/**/*.h",
        "generic/**/*.h",
    ]),
    includes = [
        # do not sort: architecture headers override the generic fallback.
        "x86_64",
        "generic",
    ],
    textual_hdrs = glob([
        "generic/**/*.inc",
        "x86_64/**/*.inc",
    ]),
    visibility = ["//include:__pkg__"],
)
