load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "qemu_target_source_set", "when")

# Translated from dump/meson.build.

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_source_set(
    name = "system_ss",
    srcs = ["dump.c"],
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "have_hmp",
            ["dump-hmp-cmds.c"],
        ),
        when(
            "CONFIG_WINDUMP",
            [],
            if_false = ["win_dump-stubs.c"],
        ),
    ],
    deps = [
        ":headers",
        "@zlib",
    ],
)

qemu_target_source_set(
    name = "specific_ss",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_WINDUMP",
            ["win_dump-x86.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
