load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from scsi/meson.build.

exports_files(["trace-events"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

qemu_source_set(
    name = "block_ss",
    srcs = ["utils.c"],
    visibility = ["//visibility:public"],
    when = [
        when(
            "CONFIG_LINUX",
            [
                "pr-manager.c",
                "pr-manager-helper.c",
            ],
        ),
        when(
            "!CONFIG_LINUX",
            ["pr-manager-stub.c"],
        ),
    ],
    deps = [
        ":headers",
        "//block:module_block",
    ],
)

qemu_package()
