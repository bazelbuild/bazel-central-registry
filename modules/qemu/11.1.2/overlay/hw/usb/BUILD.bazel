load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_archive_part", "qemu_package", "qemu_source_set", "when")

# Translated from hw/usb/meson.build.

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_USB",
            [
                "bus.c",
                "combined-packet.c",
                "core.c",
                "desc.c",
                "desc-msos.c",
                "libhw.c",
                "pcap.c",
            ],
        ),
        when(
            "CONFIG_USB_UHCI",
            ["hcd-uhci.c"],
        ),
        when(
            "CONFIG_USB_OHCI",
            ["hcd-ohci.c"],
        ),
        when(
            "CONFIG_USB_OHCI_PCI",
            ["hcd-ohci-pci.c"],
        ),
        when(
            "CONFIG_USB_OHCI_SYSBUS",
            ["hcd-ohci-sysbus.c"],
        ),
        when(
            "CONFIG_USB_EHCI",
            ["hcd-ehci.c"],
        ),
        when(
            "CONFIG_USB_EHCI_PCI",
            ["hcd-ehci-pci.c"],
        ),
        when(
            "CONFIG_USB_EHCI_SYSBUS",
            ["hcd-ehci-sysbus.c"],
        ),
        when(
            "CONFIG_USB_XHCI",
            ["hcd-xhci.c"],
        ),
        when(
            "CONFIG_USB_XHCI_PCI",
            ["hcd-xhci-pci.c"],
        ),
        when(
            "CONFIG_USB_XHCI_SYSBUS",
            ["hcd-xhci-sysbus.c"],
        ),
        when(
            "CONFIG_USB_XHCI_NEC",
            ["hcd-xhci-nec.c"],
        ),
        when(
            "CONFIG_USB_DWC2",
            ["hcd-dwc2.c"],
        ),
        when(
            "CONFIG_USB_DWC3",
            ["hcd-dwc3.c"],
        ),
        when(
            "CONFIG_USB_CHIPIDEA",
            ["chipidea.c"],
        ),
        when(
            "CONFIG_ASPEED_UDC",
            ["aspeed-udc.c"],
        ),
        when(
            "CONFIG_IMX_USBPHY",
            ["imx-usb-phy.c"],
        ),
        when(
            "CONFIG_VT82C686",
            ["vt82c686-uhci-pci.c"],
        ),
        when(
            "CONFIG_XLNX_VERSAL",
            ["xlnx-versal-usb2-ctrl-regs.c"],
        ),
        when(
            "CONFIG_XLNX_USB_SUBSYS",
            ["xlnx-usb-subsystem.c"],
        ),
        when(
            "CONFIG_USB_HUB",
            ["dev-hub.c"],
        ),
        when(
            "CONFIG_USB_HID",
            ["dev-hid.c"],
        ),
        when(
            "CONFIG_USB_TABLET_WACOM",
            ["dev-wacom.c"],
        ),
        when(
            "CONFIG_USB_STORAGE_CORE",
            ["dev-storage.c"],
        ),
        when(
            "CONFIG_USB_STORAGE_BOT",
            ["dev-storage-bot.c"],
        ),
        when(
            "CONFIG_USB_STORAGE_CLASSIC",
            ["dev-storage-classic.c"],
        ),
        when(
            "CONFIG_USB_STORAGE_UAS",
            ["dev-uas.c"],
        ),
        when(
            "CONFIG_USB_AUDIO",
            ["dev-audio.c"],
        ),
        when(
            "CONFIG_USB_SERIAL",
            ["dev-serial.c"],
        ),
        when(
            "CONFIG_USB_NETWORK",
            ["dev-network.c"],
        ),
        when(
            "CONFIG_PC87560",
            ["pc87560-ohci.c"],
        ),
        when(
            [
                "!CONFIG_WIN32",
                "CONFIG_USB_STORAGE_MTP",
            ],
            ["dev-mtp.c"],
        ),
        when(
            "CONFIG_USB_SMARTCARD",
            ["dev-smartcard-reader.c"],
        ),
        when(
            "CONFIG_USB_U2F",
            ["u2f.c"],
        ),
        when(
            [
                "CONFIG_LINUX",
                "CONFIG_USB_U2F",
            ],
            ["u2f-passthru.c"],
        ),
        when(
            [
                "u2f",
                "CONFIG_USB_U2F",
            ],
            ["u2f-emulated.c"],
        ),
        when(
            [
                "canokey",
                "CONFIG_USB_CANOKEY",
            ],
            ["canokey.c"],
        ),
        when(
            [
                "CONFIG_USB",
                "CONFIG_XEN_BUS",
                "libusb",
            ],
            ["xen-usb.c"],
        ),
        when(
            [
                "libusb",
                "libusb",
                "CONFIG_USB",
                "libusb",
            ],
            ["host-libusb.c"],
        ),
        when(
            [
                "usbredir",
                "usbredir",
                "CONFIG_USB",
            ],
            [
                "redirect.c",
                "quirks.c",
            ],
        ),
        when(
            [
                "cacard",
                "cacard",
                "CONFIG_USB_SMARTCARD",
            ],
            [
                "ccid-card-emulated.c",
                "ccid-card-passthru.c",
            ],
        ),
    ],
    deps = [":headers"],
)

qemu_archive_part(
    # of libqemuutil.a
    name = "stub_ss",
    srcs = ["bus-stub.c"],
    deps = [":headers"],
)

qemu_package()
