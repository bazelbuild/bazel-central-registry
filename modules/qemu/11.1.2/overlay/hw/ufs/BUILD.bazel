load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from hw/ufs/meson.build.

exports_files(["trace-events"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//visibility:public"],
    when = [
        when(
            "CONFIG_UFS_PCI",
            [
                "ufs.c",
                "lu.c",
            ],
        ),
    ],
    deps = [
        ":headers",
        "//hw/core:headers",
    ],
)

qemu_package()
