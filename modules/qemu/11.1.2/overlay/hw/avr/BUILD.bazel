load("//bazel:qemu.bzl", "qemu_package", "qemu_target_source_set", "when")

# hw/avr/meson.build's hw_arch['avr'].
qemu_target_source_set(
    name = "avr_ss",
    srcs = ["boot.c"],
    hdrs = [
        "atmega.h",
        "boot.h",
    ],
    arch = "avr",
    when = [
        when(
            "CONFIG_AVR_ATMEGA_MCU",
            ["atmega.c"],
        ),
        when(
            "CONFIG_ARDUINO",
            ["arduino.c"],
        ),
    ],
)

qemu_package()
