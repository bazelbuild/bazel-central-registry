load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "qemu_target_source_set", "when")

# Translated from hw/watchdog/meson.build.

exports_files(["trace-events"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

qemu_source_set(
    name = "system_ss",
    srcs = ["watchdog.c"],
    kind = "system",
    visibility = ["//visibility:public"],
    when = [
        when(
            "CONFIG_ALLWINNER_WDT",
            ["allwinner-wdt.c"],
        ),
        when(
            "CONFIG_CMSDK_APB_WATCHDOG",
            ["cmsdk-apb-watchdog.c"],
        ),
        when(
            "CONFIG_WDT_IB6300ESB",
            ["wdt_i6300esb.c"],
        ),
        when(
            "CONFIG_WDT_IB700",
            ["wdt_ib700.c"],
        ),
        when(
            "CONFIG_WDT_DIAG288",
            ["wdt_diag288.c"],
        ),
        when(
            "CONFIG_ASPEED_SOC",
            ["wdt_aspeed.c"],
        ),
        when(
            "CONFIG_WDT_IMX2",
            ["wdt_imx2.c"],
        ),
        when(
            "CONFIG_K230_WDT",
            ["k230_wdt.c"],
        ),
        when(
            "CONFIG_WDT_SBSA",
            ["sbsa_gwdt.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_target_source_set(
    name = "specific_ss",
    visibility = ["//visibility:public"],
    when = [
        when(
            "CONFIG_PSERIES",
            ["spapr_watchdog.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
