load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from hw/hyperv/meson.build.

exports_files(["trace-events"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//visibility:public"],
    when = [
        when(
            "CONFIG_HYPERV",
            ["hyperv.c"],
        ),
        when(
            "CONFIG_HYPERV_TESTDEV",
            ["hyperv_testdev.c"],
        ),
        when(
            "CONFIG_VMBUS",
            ["vmbus.c"],
        ),
        when(
            "CONFIG_SYNDBG",
            ["syndbg.c"],
        ),
        when(
            "CONFIG_HV_BALLOON",
            [
                "hv-balloon.c",
                "hv-balloon-page_range_tree.c",
                "hv-balloon-our_range_memslots.c",
            ],
        ),
        when(
            "CONFIG_HV_BALLOON",
            [],
            if_false = ["hv-balloon-stub.c"],
        ),
    ],
    deps = [
        ":headers",
        "//target/i386/kvm:headers",
    ],
)

qemu_package()
