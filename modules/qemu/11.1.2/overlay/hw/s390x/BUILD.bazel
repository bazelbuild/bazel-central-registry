load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_archive_part", "qemu_package", "qemu_source_set", "qemu_target_source_set", "when")

# Translated from hw/s390x/meson.build.

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_target_source_set(
    name = "s390x_ss",
    srcs = [
        "ap-bridge.c",
        "ap-device.c",
        "ccw-device.c",
        "cert-store.c",
        "css.c",
        "css-bridge.c",
        "event-facility.c",
        "ipl.c",
        "s390-ccw.c",
        "s390-pci-bus.c",
        "s390-pci-inst.c",
        "s390-skeys.c",
        "s390-stattrib.c",
        "sclp.c",
        "sclpcpi.c",
        "sclpcpu.c",
        "sclpquiesce.c",
        "tod.c",
    ],
    arch = "s390x",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_KVM",
            [
                "tod-kvm.c",
                "s390-skeys-kvm.c",
                "s390-stattrib-kvm.c",
                "s390-pci-kvm.c",
                "cpu-topology.c",
            ],
        ),
        when(
            "CONFIG_TCG",
            ["tod-tcg.c"],
        ),
        when(
            "CONFIG_S390_CCW_VIRTIO",
            [
                "s390-virtio-ccw.c",
                "s390-hypercall.c",
            ],
        ),
        when(
            "CONFIG_TERMINAL3270",
            ["3270-ccw.c"],
        ),
        when(
            "CONFIG_VFIO",
            ["s390-pci-vfio.c"],
        ),
        when(
            "CONFIG_VFIO_AP",
            [],
            if_false = ["ap-stub.c"],
        ),
        when(
            "CONFIG_VIRTIO_MD",
            [],
            if_false = ["virtio-ccw-md-stubs.c"],
        ),
        when(
            "CONFIG_VIRTIO_CCW",
            ["virtio-ccw.c"],
        ),
        when(
            [
                "CONFIG_VIRTIO_CCW",
                "CONFIG_VIRTIO_BALLOON",
            ],
            ["virtio-ccw-balloon.c"],
        ),
        when(
            [
                "CONFIG_VIRTIO_CCW",
                "CONFIG_VIRTIO_BLK",
            ],
            ["virtio-ccw-blk.c"],
        ),
        when(
            [
                "CONFIG_VIRTIO_CCW",
                "CONFIG_VIRTIO_CRYPTO",
            ],
            ["virtio-ccw-crypto.c"],
        ),
        when(
            [
                "CONFIG_VIRTIO_CCW",
                "CONFIG_VIRTIO_INPUT",
            ],
            ["virtio-ccw-input.c"],
        ),
        when(
            [
                "CONFIG_VIRTIO_CCW",
                "CONFIG_VIRTIO_NET",
            ],
            ["virtio-ccw-net.c"],
        ),
        when(
            [
                "CONFIG_VIRTIO_CCW",
                "CONFIG_VIRTIO_RNG",
            ],
            ["virtio-ccw-rng.c"],
        ),
        when(
            [
                "CONFIG_VIRTIO_CCW",
                "CONFIG_VIRTIO_SCSI",
            ],
            ["virtio-ccw-scsi.c"],
        ),
        when(
            [
                "CONFIG_VIRTIO_CCW",
                "CONFIG_VIRTIO_SERIAL",
            ],
            ["virtio-ccw-serial.c"],
        ),
        when(
            [
                "CONFIG_VIRTIO_CCW",
                "have_virtfs",
                "CONFIG_VIRTIO_9P",
            ],
            ["virtio-ccw-9p.c"],
        ),
        when(
            [
                "CONFIG_VIRTIO_CCW",
                "CONFIG_VHOST_SCSI",
            ],
            ["vhost-scsi-ccw.c"],
        ),
        when(
            [
                "CONFIG_VIRTIO_CCW",
                "CONFIG_VHOST_VSOCK",
            ],
            ["vhost-vsock-ccw.c"],
        ),
        when(
            [
                "CONFIG_VIRTIO_CCW",
                "CONFIG_VHOST_USER_FS",
            ],
            ["vhost-user-fs-ccw.c"],
        ),
        when(
            [
                "CONFIG_VIRTIO_CCW",
                "CONFIG_VIRTIO_MD",
            ],
            ["virtio-ccw-md.c"],
        ),
        when(
            [
                "CONFIG_VIRTIO_CCW",
                "CONFIG_VIRTIO_MEM",
            ],
            ["virtio-ccw-mem.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_archive_part(
    # of libqemuutil.a
    name = "stub_ss",
    srcs = ["s390-pci-vfio-stubs.c"],
    deps = [
        ":headers",
        "//target/s390x:headers",
    ],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            [
                "CONFIG_VIRTIO_GPU",
                "CONFIG_VIRTIO_CCW",
            ],
            ["virtio-ccw-gpu.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
