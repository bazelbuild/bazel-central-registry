load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from hw/dma/meson.build.

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_RC4030",
            ["rc4030.c"],
        ),
        when(
            "CONFIG_PL080",
            ["pl080.c"],
        ),
        when(
            "CONFIG_PL330",
            ["pl330.c"],
        ),
        when(
            "CONFIG_I82374",
            ["i82374.c"],
        ),
        when(
            "CONFIG_I8257",
            ["i8257.c"],
        ),
        when(
            "CONFIG_XILINX_AXI",
            ["xilinx_axidma.c"],
        ),
        when(
            "CONFIG_ZYNQ_DEVCFG",
            ["xlnx-zynq-devcfg.c"],
        ),
        when(
            "CONFIG_STP2000",
            ["sparc32_dma.c"],
        ),
        when(
            "CONFIG_XLNX_ZYNQMP_ARM",
            ["xlnx_dpdma.c"],
        ),
        when(
            "CONFIG_XLNX_ZDMA",
            ["xlnx-zdma.c"],
        ),
        when(
            "CONFIG_OMAP",
            [
                "omap_dma.c",
                "soc_dma.c",
            ],
        ),
        when(
            "CONFIG_RASPI",
            ["bcm2835_dma.c"],
        ),
        when(
            "CONFIG_SIFIVE_PDMA",
            ["sifive_pdma.c"],
        ),
        when(
            "CONFIG_XLNX_CSU_DMA",
            ["xlnx_csu_dma.c"],
        ),
        when(
            "CONFIG_K230_GSDMA",
            ["k230_gsdma.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
