load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from hw/xen/meson.build.

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_XEN_BUS",
            [
                "xen-backend.c",
                "xen-bus-helper.c",
                "xen-bus.c",
                "xen-legacy-backend.c",
                "xen_devconfig.c",
                "xen_pvdev.c",
            ],
        ),
        when(
            [
                "CONFIG_XEN",
                "xen",
            ],
            [
                "xen-hvm-common.c",
                "xen-mapcache.c",
                "xen-operations.c",
                "xen-pvh-common.c",
            ],
            if_false = ["xen_stubs.c"],
        ),
        when(
            [
                "CONFIG_XEN",
                "xen",
                "have_xen_pci_passthrough",
            ],
            [
                "xen-host-pci-device.c",
                "xen_pt.c",
                "xen_pt_config_init.c",
                "xen_pt_graphics.c",
                "xen_pt_load_rom.c",
                "xen_pt_msi.c",
            ],
        ),
        when(
            [
                "CONFIG_XEN",
                "xen",
                "!have_xen_pci_passthrough",
            ],
            ["xen_pt_stub.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
