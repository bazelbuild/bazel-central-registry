load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_archive_part", "qemu_package", "qemu_source_set", "when")

# Translated from hw/pci/meson.build.

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
    deps = ["//hw/i386/kvm:headers"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_PCI_EXPRESS",
            [
                "pcie_port.c",
                "pcie_host.c",
            ],
        ),
        when(
            "CONFIG_PCI",
            [
                "msi.c",
                "msix.c",
                "pci.c",
                "pci_bridge.c",
                "pci_host.c",
                "pci-qmp-cmds.c",
                "pcie_sriov.c",
                "shpc.c",
                "slotid_cap.c",
                "pcie.c",
                "pcie_aer.c",
                "pcie_doe.c",
            ],
        ),
        when(
            [
                "CONFIG_PCI",
                "have_hmp",
            ],
            ["pci-hmp-cmds.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_archive_part(
    # of libqemuutil.a
    name = "stub_ss",
    srcs = ["pci-stub.c"],
    deps = [":headers"],
)

qemu_package()
