load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "qemu_target_source_set", "when")

# Translated from hw/scsi/meson.build.

_VIRTIO_SCSI = [
    "CONFIG_SCSI",
    "CONFIG_VIRTIO_SCSI",
]

exports_files(["trace-events"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

qemu_target_source_set(
    name = "specific_ss",
    visibility = ["//visibility:public"],
    when = [
        when(
            [
                "CONFIG_SCSI",
                "CONFIG_SPAPR_VSCSI",
            ],
            ["spapr_vscsi.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//visibility:public"],
    when = [
        when(
            "CONFIG_SCSI",
            [
                "emulation.c",
                "scsi-bus.c",
                "scsi-disk.c",
                "scsi-generic.c",
            ],
        ),
        when(
            [
                "CONFIG_SCSI",
                "CONFIG_ESP",
            ],
            ["esp.c"],
        ),
        when(
            [
                "CONFIG_SCSI",
                "CONFIG_ESP_PCI",
            ],
            ["esp-pci.c"],
        ),
        when(
            [
                "CONFIG_SCSI",
                "CONFIG_LSI_SCSI_PCI",
            ],
            ["lsi53c895a.c"],
        ),
        when(
            [
                "CONFIG_SCSI",
                "CONFIG_NCR710_SCSI",
            ],
            [
                "ncr53c710.c",
                "lasi_ncr710.c",
            ],
        ),
        when(
            [
                "CONFIG_SCSI",
                "CONFIG_MEGASAS_SCSI_PCI",
            ],
            ["megasas.c"],
        ),
        when(
            [
                "CONFIG_SCSI",
                "CONFIG_MPTSAS_SCSI_PCI",
            ],
            [
                "mptsas.c",
                "mptconfig.c",
                "mptendian.c",
            ],
        ),
        when(
            [
                "CONFIG_SCSI",
                "CONFIG_VMW_PVSCSI_SCSI_PCI",
            ],
            ["vmw_pvscsi.c"],
        ),
        when(
            _VIRTIO_SCSI,
            [
                "virtio-scsi-dataplane.c",
                "virtio-scsi.c",
            ],
        ),
        when(
            _VIRTIO_SCSI + ["CONFIG_VHOST_SCSI"],
            ["vhost-scsi.c"],
        ),
        when(
            _VIRTIO_SCSI + ["CONFIG_VHOST_USER_SCSI"],
            ["vhost-user-scsi.c"],
        ),
        when(
            _VIRTIO_SCSI + ["CONFIG_VHOST_SCSI_COMMON"],
            ["vhost-scsi-common.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
