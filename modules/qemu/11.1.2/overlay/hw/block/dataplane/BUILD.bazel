load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_target_source_set", "when")

cc_library(
    name = "headers",
    hdrs = ["xen-block.h"],
    visibility = ["//hw/block:__pkg__"],
)

qemu_target_source_set(
    name = "specific_ss",
    hdrs = ["xen-block.h"],
    when = [when(
        "CONFIG_XEN_BUS",
        ["xen-block.c"],
    )],
    deps = ["//hw/block:headers"],
)

qemu_package()
