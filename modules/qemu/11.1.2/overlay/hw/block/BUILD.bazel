load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from hw/block/meson.build.

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_source_set(
    name = "system_ss",
    srcs = [
        "block.c",
        "cdrom.c",
        "hd-geometry.c",
    ],
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_FDC",
            ["fdc.c"],
        ),
        when(
            "CONFIG_FDC_ISA",
            ["fdc-isa.c"],
        ),
        when(
            "CONFIG_FDC_SYSBUS",
            ["fdc-sysbus.c"],
        ),
        when(
            "CONFIG_PFLASH_CFI01",
            ["pflash_cfi01.c"],
        ),
        when(
            "CONFIG_PFLASH_CFI02",
            ["pflash_cfi02.c"],
        ),
        when(
            "CONFIG_SSI_M25P80",
            [
                "m25p80.c",
                "m25p80_sfdp.c",
            ],
        ),
        when(
            "CONFIG_SWIM",
            ["swim.c"],
        ),
        when(
            "CONFIG_XEN_BUS",
            ["xen-block.c"],
        ),
        when(
            "CONFIG_VIRTIO_BLK",
            [
                "virtio-blk.c",
                "virtio-blk-common.c",
            ],
        ),
        when(
            "CONFIG_VHOST_USER_BLK",
            [
                "vhost-user-blk.c",
                "virtio-blk-common.c",
            ],
        ),
    ],
    deps = [
        ":headers",
        "//hw/block/dataplane:headers",
    ],
)

qemu_package(subdirs = ["dataplane"])
