load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "qemu_target_source_set", "when")

# Translated from hw/isa/meson.build.

exports_files(["trace-events"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//visibility:public"],
    when = [
        when(
            "CONFIG_APM",
            ["apm.c"],
        ),
        when(
            "CONFIG_FDC37M81X",
            ["fdc37m81x-superio.c"],
        ),
        when(
            "CONFIG_I82378",
            ["i82378.c"],
        ),
        when(
            "CONFIG_ISA_BUS",
            ["isa-bus.c"],
        ),
        when(
            "CONFIG_ISA_SUPERIO",
            ["isa-superio.c"],
        ),
        when(
            "CONFIG_PC87312",
            ["pc87312.c"],
        ),
        when(
            "CONFIG_PIIX",
            ["piix.c"],
        ),
        when(
            "CONFIG_SMC37C669",
            ["smc37c669-superio.c"],
        ),
        when(
            "CONFIG_VT82C686",
            ["vt82c686.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_target_source_set(
    name = "specific_ss",
    visibility = ["//visibility:public"],
    when = [
        when(
            "CONFIG_PC87560",
            ["pc87560.c"],
        ),
        when(
            "CONFIG_LPC_ICH9",
            ["lpc_ich9.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
