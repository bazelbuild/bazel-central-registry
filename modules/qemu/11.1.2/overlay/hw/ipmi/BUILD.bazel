load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from hw/ipmi/meson.build.

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//visibility:public"],
    when = [
        when(
            [
                "CONFIG_IPMI",
                "CONFIG_IPMI",
            ],
            [
                "ipmi.c",
                "ipmi_kcs.c",
                "ipmi_bt.c",
            ],
        ),
        when(
            [
                "CONFIG_IPMI",
                "CONFIG_IPMI_LOCAL",
            ],
            ["ipmi_bmc_sim.c"],
        ),
        when(
            [
                "CONFIG_IPMI",
                "CONFIG_IPMI_EXTERN",
            ],
            ["ipmi_bmc_extern.c"],
        ),
        when(
            [
                "CONFIG_IPMI",
                "CONFIG_ISA_IPMI_KCS",
            ],
            ["isa_ipmi_kcs.c"],
        ),
        when(
            [
                "CONFIG_IPMI",
                "CONFIG_PCI_IPMI_KCS",
            ],
            ["pci_ipmi_kcs.c"],
        ),
        when(
            [
                "CONFIG_IPMI",
                "CONFIG_ISA_IPMI_BT",
            ],
            ["isa_ipmi_bt.c"],
        ),
        when(
            [
                "CONFIG_IPMI",
                "CONFIG_PCI_IPMI_BT",
            ],
            ["pci_ipmi_bt.c"],
        ),
        when(
            [
                "CONFIG_IPMI",
                "CONFIG_IPMI_SSIF",
            ],
            ["smbus_ipmi.c"],
        ),
    ],
)

qemu_package()
