load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from hw/pci-bridge/meson.build.

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            [
                "CONFIG_PCI",
                "CONFIG_PCI_BRIDGE",
            ],
            ["pci_bridge_dev.c"],
        ),
        when(
            [
                "CONFIG_PCI",
                "CONFIG_I82801B11",
            ],
            ["i82801b11.c"],
        ),
        when(
            [
                "CONFIG_PCI",
                "CONFIG_IOH3420",
            ],
            ["ioh3420.c"],
        ),
        when(
            [
                "CONFIG_PCI",
                "CONFIG_PCIE_PORT",
            ],
            [
                "pcie_root_port.c",
                "gen_pcie_root_port.c",
            ],
        ),
        when(
            [
                "CONFIG_PCI",
                "CONFIG_PCIE_PCI_BRIDGE",
            ],
            ["pcie_pci_bridge.c"],
        ),
        when(
            [
                "CONFIG_PCI",
                "CONFIG_PXB",
            ],
            ["pci_expander_bridge.c"],
        ),
        when(
            [
                "CONFIG_PCI",
                "CONFIG_XIO3130",
            ],
            [
                "xio3130_upstream.c",
                "xio3130_downstream.c",
            ],
        ),
        when(
            [
                "CONFIG_PCI",
                "CONFIG_CXL",
            ],
            [
                "cxl_root_port.c",
                "cxl_upstream.c",
                "cxl_downstream.c",
            ],
        ),
        when(
            [
                "CONFIG_PCI",
                "CONFIG_SIMBA",
            ],
            ["simba.c"],
        ),
    ],
)

qemu_package()
