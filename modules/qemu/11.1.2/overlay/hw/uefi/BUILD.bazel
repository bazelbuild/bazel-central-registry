load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from hw/uefi/meson.build.

exports_files(["trace-events"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

qemu_source_set(
    name = "system_ss",
    srcs = [
        "hardware-info.c",
        "ovmf-log.c",
    ],
    kind = "system",
    visibility = ["//visibility:public"],
    when = [
        when(
            "CONFIG_UEFI_VARS",
            [
                "var-service-core.c",
                "var-service-pcap.c",
                "var-service-json.c",
                "var-service-vars.c",
                "var-service-auth.c",
                "var-service-guid.c",
                "var-service-utils.c",
                "var-service-policy.c",
                "var-service-sysbus.c",
            ],
        ),
        when(
            [
                "CONFIG_UEFI_VARS",
                "gnutls",
            ],
            ["var-service-pkcs7.c"],
        ),
        when(
            [
                "CONFIG_UEFI_VARS",
                "!gnutls",
            ],
            ["var-service-pkcs7-stub.c"],
        ),
        when(
            "CONFIG_UEFI_VARS",
            ["var-service-siglist.c"],
        ),
    ],
    deps = [
        ":headers",
        "//target/arm:headers",
    ],
)

qemu_package()
