load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from hw/audio/meson.build.

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_source_set(
    name = "system_ss",
    srcs = ["model.c"],
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_AC97",
            ["ac97.c"],
        ),
        when(
            "CONFIG_ADLIB",
            [
                "fmopl.c",
                "adlib.c",
            ],
        ),
        when(
            "CONFIG_ASC",
            ["asc.c"],
        ),
        when(
            "CONFIG_CS4231",
            ["cs4231.c"],
        ),
        when(
            "CONFIG_CS4231A",
            ["cs4231a.c"],
        ),
        when(
            "CONFIG_ES1370",
            ["es1370.c"],
        ),
        when(
            "CONFIG_GUS",
            [
                "gus.c",
                "gusemu_hal.c",
                "gusemu_mixer.c",
            ],
        ),
        when(
            "CONFIG_HDA",
            [
                "intel-hda.c",
                "hda-codec.c",
            ],
        ),
        when(
            "CONFIG_PCSPK",
            ["pcspk.c"],
        ),
        when(
            "CONFIG_PL041",
            [
                "pl041.c",
                "lm4549.c",
            ],
        ),
        when(
            "CONFIG_SB16",
            ["sb16.c"],
        ),
        when(
            "CONFIG_VT82C686",
            ["via-ac97.c"],
        ),
        when(
            [
                "CONFIG_VIRTIO_SND",
                "CONFIG_VIRTIO",
            ],
            ["virtio-snd.c"],
        ),
        when(
            [
                "CONFIG_VIRTIO_SND",
                "CONFIG_VIRTIO",
                "CONFIG_VIRTIO_PCI",
            ],
            ["virtio-snd-pci.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
