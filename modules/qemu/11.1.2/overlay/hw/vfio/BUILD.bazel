load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_archive_part", "qemu_package", "qemu_source_set", "when")

# Translated from hw/vfio/meson.build.

exports_files(["trace-events"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

qemu_archive_part(
    # of libqemuutil.a
    name = "stub_ss",
    srcs = [
        "igd-stubs.c",
        "iommufd-stubs.c",
        "kvm-stubs.c",
    ],
    deps = [":headers"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//visibility:public"],
    when = [
        when(
            "CONFIG_VFIO",
            [
                "cpr.c",
                "cpr-legacy.c",
                "device.c",
                "migration.c",
                "migration-multifd.c",
                "region.c",
            ],
        ),
        when(
            [
                "CONFIG_VFIO",
                "CONFIG_IOMMUFD",
            ],
            [
                "iommufd.c",
                "cpr-iommufd.c",
            ],
        ),
        when(
            "CONFIG_VFIO_PCI",
            ["display.c"],
        ),
        when(
            "CONFIG_VFIO",
            [
                "listener.c",
                "container.c",
                "container-legacy.c",
                "helpers.c",
            ],
        ),
        when(
            [
                "CONFIG_VFIO",
                "CONFIG_KVM",
            ],
            ["kvm-helpers.c"],
        ),
        when(
            [
                "CONFIG_VFIO",
                "CONFIG_PSERIES",
            ],
            ["spapr.c"],
        ),
        when(
            [
                "CONFIG_VFIO",
                "CONFIG_KVM",
                "CONFIG_PSERIES",
            ],
            ["kvm-spapr.c"],
        ),
        when(
            [
                "CONFIG_VFIO",
                "CONFIG_VFIO_PCI",
            ],
            [
                "pci-quirks.c",
                "pci.c",
            ],
        ),
        when(
            [
                "CONFIG_VFIO",
                "CONFIG_VFIO_CCW",
            ],
            ["ccw.c"],
        ),
        when(
            [
                "CONFIG_VFIO",
                "CONFIG_VFIO_AP",
            ],
            ["ap.c"],
        ),
        when(
            [
                "CONFIG_VFIO",
                "CONFIG_VFIO_IGD",
            ],
            ["igd.c"],
        ),
    ],
    deps = [
        ":headers",
        "//migration:headers",
    ],
)

qemu_package()
