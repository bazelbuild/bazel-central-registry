load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_archive_part", "qemu_package", "qemu_source_set", "when")

# Translated from hw/acpi/meson.build.

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_archive_part(
    # of libqemuutil.a
    name = "stub_ss",
    srcs = [
        "acpi-cpu-hotplug-stub.c",
        "acpi-mem-hotplug-stub.c",
        "acpi-nvdimm-stub.c",
        "acpi-pci-hotplug-stub.c",
        "acpi-stub.c",
        "acpi-x86-stub.c",
        "aml-build-stub.c",
        "cxl-stub.c",
        "ghes-stub.c",
        "ghes_cper_stub.c",
        "ipmi-stub.c",
        "pci-bridge-stub.c",
        "wdat-gwdt-stub.c",
        "wdat-ich9-stub.c",
    ],
    deps = [
        ":headers",
        "//hw/i386:headers",
    ],
)

qemu_source_set(
    name = "system_ss",
    srcs = [
        "acpi-qmp-cmds.c",
        "acpi_interface.c",
    ],
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_GHES_CPER",
            ["ghes_cper.c"],
        ),
        when(
            "CONFIG_ACPI",
            [
                "aml-build.c",
                "bios-linker-loader.c",
                "core.c",
                "utils.c",
            ],
        ),
        when(
            [
                "CONFIG_ACPI",
                "CONFIG_ACPI_CPU_HOTPLUG",
            ],
            ["cpu.c"],
        ),
        when(
            [
                "CONFIG_ACPI",
                "CONFIG_ACPI_MEMORY_HOTPLUG",
            ],
            ["memory_hotplug.c"],
        ),
        when(
            [
                "CONFIG_ACPI",
                "CONFIG_ACPI_NVDIMM",
            ],
            ["nvdimm.c"],
        ),
        when(
            [
                "CONFIG_ACPI",
                "CONFIG_ACPI_PCI",
            ],
            ["pci.c"],
        ),
        when(
            [
                "CONFIG_ACPI",
                "CONFIG_ACPI_CXL",
            ],
            ["cxl.c"],
        ),
        when(
            [
                "CONFIG_ACPI",
                "CONFIG_ACPI_VMGENID",
            ],
            ["vmgenid.c"],
        ),
        when(
            [
                "CONFIG_ACPI",
                "CONFIG_ACPI_VMCLOCK",
            ],
            ["vmclock.c"],
        ),
        when(
            [
                "CONFIG_ACPI",
                "CONFIG_ACPI_HW_REDUCED",
            ],
            ["generic_event_device.c"],
        ),
        when(
            [
                "CONFIG_ACPI",
                "CONFIG_ACPI_HMAT",
            ],
            ["hmat.c"],
        ),
        when(
            [
                "CONFIG_ACPI",
                "CONFIG_ACPI_APEI",
            ],
            ["ghes.c"],
        ),
        when(
            [
                "CONFIG_ACPI",
                "CONFIG_ACPI_PIIX4",
            ],
            ["piix4.c"],
        ),
        when(
            [
                "CONFIG_ACPI",
                "CONFIG_ACPI_PCI_BRIDGE",
            ],
            ["pci-bridge.c"],
        ),
        when(
            [
                "CONFIG_ACPI",
                "CONFIG_ACPI_PCIHP",
            ],
            ["pcihp.c"],
        ),
        when(
            [
                "CONFIG_ACPI",
                "CONFIG_ACPI_VIOT",
            ],
            ["viot.c"],
        ),
        when(
            [
                "CONFIG_ACPI",
                "CONFIG_ACPI_ICH9",
            ],
            [
                "ich9.c",
                "ich9_tco.c",
                "ich9_timer.c",
                "wdat-ich9.c",
            ],
        ),
        when(
            [
                "CONFIG_ACPI",
                "CONFIG_ACPI_ERST",
            ],
            ["erst.c"],
        ),
        when(
            [
                "CONFIG_ACPI",
                "CONFIG_IPMI",
            ],
            ["ipmi.c"],
        ),
        when(
            [
                "CONFIG_ACPI",
                "CONFIG_WDT_SBSA",
            ],
            ["wdat-gwdt.c"],
        ),
        when(
            [
                "CONFIG_ACPI",
                "have_tpm",
            ],
            ["tpm.c"],
        ),
    ],
    deps = [
        ":headers",
        "//hw/i386:headers",
    ],
)

qemu_package()
