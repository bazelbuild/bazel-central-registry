load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "qemu_user_source_set", "when")

# Translated from hw/core/meson.build.

exports_files(["trace-events"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

qemu_source_set(
    name = "hwcore_ss",
    srcs = [
        "bus.c",
        "clock.c",
        "gpio.c",
        "irq.c",
        "qdev.c",
        "qdev-clock.c",
        "qdev-properties.c",
        "resetcontainer.c",
        "resettable.c",
        "vmstate-if.c",
    ],
    visibility = ["//visibility:public"],
    deps = [":headers"],
)

qemu_source_set(
    name = "common_ss",
    srcs = [
        "cpu-common.c",
        "machine-smp.c",
    ],
    visibility = ["//visibility:public"],
    deps = [":headers"],
)

qemu_source_set(
    name = "system_ss",
    srcs = [
        "clock-vmstate.c",
        "cpu-system.c",
        "fw-path-provider.c",
        "hotplug.c",
        "loader.c",
        "machine.c",
        "machine-qmp-cmds.c",
        "nmi.c",
        "null-machine.c",
        "numa.c",
        "qdev-fw.c",
        "qdev-hotplug.c",
        "qdev-properties-system.c",
        "reset.c",
        "sysbus.c",
        "vm-change-state-handler.c",
    ],
    kind = "system",
    visibility = ["//visibility:public"],
    when = [
        when(
            "CONFIG_FITLOADER",
            ["loader-fit.c"],
        ),
        when(
            "CONFIG_GENERIC_LOADER",
            ["generic-loader.c"],
        ),
        when(
            "CONFIG_GUEST_LOADER",
            ["guest-loader.c"],
        ),
        when(
            "CONFIG_OR_IRQ",
            ["or-irq.c"],
        ),
        when(
            "CONFIG_PLATFORM_BUS",
            ["platform-bus.c"],
        ),
        when(
            "CONFIG_PTIMER",
            ["ptimer.c"],
        ),
        when(
            "CONFIG_REGISTER",
            ["register.c"],
        ),
        when(
            "CONFIG_SPLIT_IRQ",
            ["split-irq.c"],
        ),
        when(
            "CONFIG_XILINX_AXI",
            ["stream.c"],
        ),
        when(
            "CONFIG_PLATFORM_BUS",
            ["sysbus-fdt.c"],
        ),
        when(
            "CONFIG_EIF",
            ["eif.c"],
        ),
        when(
            "have_hmp",
            ["machine-hmp-cmds.c"],
        ),
    ],
    deps = [
        ":headers",
        "//util:headers",
        "@zlib",
    ],
)

qemu_user_source_set(
    name = "user_ss",
    srcs = [
        "cpu-user.c",
        "qdev-user.c",
    ],
    visibility = ["//visibility:public"],
    deps = [":headers"],
)

qemu_package()
