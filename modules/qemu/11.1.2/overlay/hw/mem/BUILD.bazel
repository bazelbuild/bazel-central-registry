load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_archive_part", "qemu_package", "qemu_source_set", "when")

# Translated from hw/mem/meson.build.

exports_files(["trace-events"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

qemu_archive_part(
    # of libqemuutil.a
    name = "stub_ss",
    srcs = [
        "cxl_type3_stubs.c",
        "memory-device-stubs.c",
    ],
    deps = [":headers"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//visibility:public"],
    when = [
        when(
            "CONFIG_SPARSE_MEM",
            ["sparse-mem.c"],
        ),
        when(
            "CONFIG_MEM_DEVICE",
            ["memory-device.c"],
        ),
        when(
            [
                "CONFIG_MEM_DEVICE",
                "CONFIG_DIMM",
            ],
            ["pc-dimm.c"],
        ),
        when(
            [
                "CONFIG_MEM_DEVICE",
                "CONFIG_NPCM7XX",
            ],
            ["npcm7xx_mc.c"],
        ),
        when(
            [
                "CONFIG_MEM_DEVICE",
                "CONFIG_NVDIMM",
            ],
            ["nvdimm.c"],
        ),
        when(
            [
                "CONFIG_MEM_DEVICE",
                "CONFIG_CXL_MEM_DEVICE",
            ],
            ["cxl_type3.c"],
        ),
        when(
            [
                "CONFIG_MEM_DEVICE",
                "CONFIG_SP_MEM",
            ],
            ["sp-mem.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
