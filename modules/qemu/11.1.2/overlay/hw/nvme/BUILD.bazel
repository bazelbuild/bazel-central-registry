load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from hw/nvme/meson.build.

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_NVME_PCI",
            [
                "ctrl.c",
                "dif.c",
                "ns.c",
                "subsys.c",
                "nguid.c",
            ],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
