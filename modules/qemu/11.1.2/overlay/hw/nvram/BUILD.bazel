load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "qemu_target_source_set", "when")

# Translated from hw/nvram/meson.build.

exports_files(["trace-events"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

qemu_source_set(
    name = "system_ss",
    srcs = [
        "fw_cfg.c",
        "fw_cfg-interface.c",
    ],
    kind = "system",
    visibility = ["//visibility:public"],
    when = [
        when(
            "CONFIG_RASPI",
            ["bcm2835_otp.c"],
        ),
        when(
            "CONFIG_CHRP_NVRAM",
            ["chrp_nvram.c"],
        ),
        when(
            "CONFIG_DS1225Y",
            ["ds1225y.c"],
        ),
        when(
            "CONFIG_NMC93XX_EEPROM",
            ["eeprom93xx.c"],
        ),
        when(
            "CONFIG_AT24C",
            ["eeprom_at24c.c"],
        ),
        when(
            "CONFIG_MAC_NVRAM",
            ["mac_nvram.c"],
        ),
        when(
            "CONFIG_NPCM7XX",
            ["npcm7xx_otp.c"],
        ),
        when(
            "CONFIG_NRF51_SOC",
            ["nrf51_nvm.c"],
        ),
        when(
            "CONFIG_XLNX_EFUSE_CRC",
            ["xlnx-efuse-crc.c"],
        ),
        when(
            "CONFIG_XLNX_EFUSE",
            ["xlnx-efuse.c"],
        ),
        when(
            "CONFIG_XLNX_EFUSE_VERSAL",
            [
                "xlnx-versal-efuse-cache.c",
                "xlnx-versal-efuse-ctrl.c",
            ],
        ),
        when(
            "CONFIG_XLNX_EFUSE_ZYNQMP",
            ["xlnx-zynqmp-efuse.c"],
        ),
        when(
            "CONFIG_XLNX_BBRAM",
            ["xlnx-bbram.c"],
        ),
        when(
            "CONFIG_ACPI",
            ["fw_cfg-acpi.c"],
        ),
        when(
            "CONFIG_ASPEED_SOC",
            ["aspeed_otp.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_target_source_set(
    name = "specific_ss",
    visibility = ["//visibility:public"],
    when = [
        when(
            "CONFIG_PSERIES",
            ["spapr_nvram.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
