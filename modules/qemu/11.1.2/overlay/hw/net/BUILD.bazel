load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_archive_part", "qemu_package", "qemu_source_set", "qemu_target_source_set", "when")

# Translated from hw/net/meson.build.

# Shared packet helpers must be compiled once even when several NICs use them.
_PACKET_NICS = "CONFIG_E1000E_PCI_EXPRESS|CONFIG_IGB_PCI_EXPRESS|CONFIG_VMXNET3_PCI"

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob([
        "*.h",
        "rocker/*.h",
    ]),
    visibility = ["//:__subpackages__"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_DP8393X",
            ["dp8393x.c"],
        ),
        when(
            "CONFIG_XEN_BUS",
            ["xen_nic.c"],
        ),
        when(
            "CONFIG_NE2000_COMMON",
            ["ne2000.c"],
        ),
        when(
            "CONFIG_NE2000_PCI",
            ["ne2000-pci.c"],
        ),
        when(
            "CONFIG_EEPRO100_PCI",
            ["eepro100.c"],
        ),
        when(
            "CONFIG_PCNET_PCI",
            ["pcnet-pci.c"],
        ),
        when(
            "CONFIG_PCNET_COMMON",
            ["pcnet.c"],
        ),
        when(
            "CONFIG_E1000_PCI",
            ["e1000.c"],
        ),
        when(
            "CONFIG_E1000E_PCI_EXPRESS",
            [
                "e1000e.c",
                "e1000e_core.c",
            ],
        ),
        when(
            "CONFIG_E1000_PCI|CONFIG_E1000E_PCI_EXPRESS",
            ["e1000x_common.c"],
        ),
        when(
            _PACKET_NICS,
            ["net_tx_pkt.c"],
        ),
        when(
            _PACKET_NICS + "|CONFIG_VIRTIO_NET",
            ["net_rx_pkt.c"],
        ),
        when(
            "CONFIG_IGB_PCI_EXPRESS",
            [
                "igb.c",
                "igbvf.c",
                "igb_core.c",
            ],
        ),
        when(
            "CONFIG_RTL8139_PCI",
            ["rtl8139.c"],
        ),
        when(
            "CONFIG_TULIP",
            ["tulip.c"],
        ),
        when(
            "CONFIG_VMXNET3_PCI",
            ["vmxnet3.c"],
        ),
        when(
            "CONFIG_SMC91C111",
            ["smc91c111.c"],
        ),
        when(
            "CONFIG_LAN9118",
            ["lan9118.c"],
        ),
        when(
            "CONFIG_LAN9118_PHY",
            ["lan9118_phy.c"],
        ),
        when(
            "CONFIG_NE2000_ISA",
            ["ne2000-isa.c"],
        ),
        when(
            "CONFIG_OPENCORES_ETH",
            ["opencores_eth.c"],
        ),
        when(
            "CONFIG_XILINX_AXI",
            ["xilinx_axienet.c"],
        ),
        when(
            "CONFIG_ALLWINNER_EMAC",
            ["allwinner_emac.c"],
        ),
        when(
            "CONFIG_ALLWINNER_SUN8I_EMAC",
            ["allwinner-sun8i-emac.c"],
        ),
        when(
            "CONFIG_IMX_FEC",
            ["imx_fec.c"],
        ),
        when(
            "CONFIG_MSF2",
            ["msf2-emac.c"],
        ),
        when(
            "CONFIG_CADENCE",
            ["cadence_gem.c"],
        ),
        when(
            "CONFIG_STELLARIS_ENET",
            ["stellaris_enet.c"],
        ),
        when(
            "CONFIG_LANCE",
            ["lance.c"],
        ),
        when(
            "CONFIG_LASI_82596",
            ["lasi_i82596.c"],
        ),
        when(
            "CONFIG_I82596_COMMON",
            ["i82596.c"],
        ),
        when(
            "CONFIG_SUNHME",
            ["sunhme.c"],
        ),
        when(
            "CONFIG_FTGMAC100",
            ["ftgmac100.c"],
        ),
        when(
            "CONFIG_SUNGEM",
            ["sungem.c"],
        ),
        when(
            "CONFIG_NPCM7XX",
            [
                "npcm7xx_emc.c",
                "npcm_gmac.c",
            ],
        ),
        when(
            "CONFIG_NPCM8XX",
            ["npcm_pcs.c"],
        ),
        when(
            "CONFIG_COLDFIRE",
            ["mcf_fec.c"],
        ),
        when(
            "CONFIG_XILINX_ETHLITE",
            ["xilinx_ethlite.c"],
        ),
        when(
            "CONFIG_VIRTIO_NET",
            [
                "virtio-net.c",
            ],
        ),
        when(
            [
                "have_vhost_net",
                "CONFIG_VIRTIO_NET",
            ],
            ["vhost_net.c"],
        ),
        when(
            "CONFIG_ETSEC",
            [
                "fsl_etsec/etsec.c",
                "fsl_etsec/miim.c",
                "fsl_etsec/registers.c",
                "fsl_etsec/rings.c",
            ],
        ),
        when(
            "CONFIG_ROCKER",
            [
                "rocker/rocker.c",
                "rocker/rocker_desc.c",
                "rocker/rocker_fp.c",
                "rocker/rocker_of_dpa.c",
                "rocker/rocker_world.c",
            ],
        ),
        when(
            "have_hmp",
            ["rocker/rocker-hmp-cmds.c"],
        ),
        when(
            "CONFIG_RASPI",
            ["bcm2838_genet.c"],
        ),
    ],
    deps = [
        ":headers",
        "//net:headers",
        "@zlib",
    ],
)

qemu_target_source_set(
    name = "specific_ss",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_PSERIES",
            ["spapr_llan.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_archive_part(
    # of libqemuutil.a
    name = "stub_ss",
    srcs = [
        "rocker/rocker-stubs.c",
        "vhost_net-stub.c",
    ],
    deps = [":headers"],
)

qemu_package(subdirs = ["can"])
