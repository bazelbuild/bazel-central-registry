load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from hw/net/can/meson.build.

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_CAN_SJA1000",
            ["can_sja1000.c"],
        ),
        when(
            "CONFIG_CAN_PCI",
            [
                "can_kvaser_pci.c",
                "can_pcm3680_pci.c",
                "can_mioe3680_pci.c",
            ],
        ),
        when(
            "CONFIG_CAN_CTUCANFD",
            ["ctucan_core.c"],
        ),
        when(
            "CONFIG_CAN_CTUCANFD_PCI",
            ["ctucan_pci.c"],
        ),
        when(
            "CONFIG_XLNX_ZYNQMP",
            ["xlnx-zynqmp-can.c"],
        ),
        when(
            "CONFIG_XLNX_VERSAL",
            ["xlnx-versal-canfd.c"],
        ),
        when(
            "CONFIG_CAN_FLEXCAN",
            ["flexcan.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
