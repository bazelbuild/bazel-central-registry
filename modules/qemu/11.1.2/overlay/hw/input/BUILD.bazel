load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from hw/input/meson.build.

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_source_set(
    name = "system_ss",
    srcs = ["hid.c"],
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_ADB",
            [
                "adb.c",
                "adb-mouse.c",
                "adb-kbd.c",
            ],
        ),
        when(
            "CONFIG_PCKBD",
            ["pckbd.c"],
        ),
        when(
            "CONFIG_PL050",
            ["pl050.c"],
        ),
        when(
            "CONFIG_PS2",
            ["ps2.c"],
        ),
        when(
            "CONFIG_STELLARIS_GAMEPAD",
            ["stellaris_gamepad.c"],
        ),
        when(
            "CONFIG_VIRTIO_INPUT",
            [
                "virtio-input.c",
                "virtio-input-hid.c",
            ],
        ),
        when(
            "CONFIG_VIRTIO_INPUT_HOST",
            ["virtio-input-host.c"],
        ),
        when(
            "CONFIG_LASIPS2",
            ["lasips2.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
