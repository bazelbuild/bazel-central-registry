load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "qemu_target_source_set", "when")

# Translated from hw/timer/meson.build.

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_A9_GTIMER",
            ["a9gtimer.c"],
        ),
        when(
            "CONFIG_ALLWINNER_A10_PIT",
            ["allwinner-a10-pit.c"],
        ),
        when(
            "CONFIG_ARM_MPTIMER",
            ["arm_mptimer.c"],
        ),
        when(
            "CONFIG_ARM_TIMER",
            ["arm_timer.c"],
        ),
        when(
            "CONFIG_ARM_V7M",
            ["armv7m_systick.c"],
        ),
        when(
            "CONFIG_ASPEED_SOC",
            ["aspeed_timer.c"],
        ),
        when(
            "CONFIG_CADENCE",
            ["cadence_ttc.c"],
        ),
        when(
            "CONFIG_CMSDK_APB_DUALTIMER",
            ["cmsdk-apb-dualtimer.c"],
        ),
        when(
            "CONFIG_CMSDK_APB_TIMER",
            ["cmsdk-apb-timer.c"],
        ),
        when(
            "CONFIG_RENESAS_TMR",
            ["renesas_tmr.c"],
        ),
        when(
            "CONFIG_RENESAS_CMT",
            ["renesas_cmt.c"],
        ),
        when(
            "CONFIG_DIGIC",
            ["digic-timer.c"],
        ),
        when(
            "CONFIG_EXYNOS4",
            [
                "exynos4210_mct.c",
                "exynos4210_pwm.c",
            ],
        ),
        when(
            "CONFIG_GRLIB",
            ["grlib_gptimer.c"],
        ),
        when(
            "CONFIG_HPET_C",
            ["hpet.c"],
        ),
        when(
            "CONFIG_I8254",
            [
                "i8254_common.c",
                "i8254.c",
            ],
        ),
        when(
            "CONFIG_IMX_EPIT",
            ["imx_epit.c"],
        ),
        when(
            "CONFIG_IMX_GPT",
            ["imx_gpt.c"],
        ),
        when(
            "CONFIG_MIPS_CPS",
            ["mips_gictimer.c"],
        ),
        when(
            "CONFIG_MSF2",
            ["mss-timer.c"],
        ),
        when(
            "CONFIG_NPCM7XX",
            ["npcm7xx_timer.c"],
        ),
        when(
            "CONFIG_NRF51_SOC",
            ["nrf51_timer.c"],
        ),
        when(
            "CONFIG_PXA2XX_TIMER",
            ["pxa2xx_timer.c"],
        ),
        when(
            "CONFIG_RASPI",
            ["bcm2835_systmr.c"],
        ),
        when(
            "CONFIG_SH_TIMER",
            ["sh_timer.c"],
        ),
        when(
            "CONFIG_SLAVIO",
            ["slavio_timer.c"],
        ),
        when(
            "CONFIG_SSE_COUNTER",
            ["sse-counter.c"],
        ),
        when(
            "CONFIG_SSE_TIMER",
            ["sse-timer.c"],
        ),
        when(
            "CONFIG_STELLARIS_GPTM",
            ["stellaris-gptm.c"],
        ),
        when(
            "CONFIG_STM32F2XX_TIMER",
            ["stm32f2xx_timer.c"],
        ),
        when(
            "CONFIG_XILINX",
            ["xilinx_timer.c"],
        ),
        when(
            "CONFIG_SIFIVE_PWM",
            ["sifive_pwm.c"],
        ),
        when(
            "CONFIG_AVR_TIMER16",
            ["avr_timer16.c"],
        ),
        when(
            "CONFIG_HEX_QTIMER",
            ["qct-qtimer.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_target_source_set(
    name = "specific_ss",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_IBEX",
            ["ibex_timer.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
