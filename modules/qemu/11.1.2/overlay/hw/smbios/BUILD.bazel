load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_archive_part", "qemu_package", "qemu_source_set", "when")

# Translated from hw/smbios/meson.build.

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_archive_part(
    # of libqemuutil.a
    name = "stub_ss",
    srcs = [
        "smbios-stub.c",
        "smbios_legacy_stub.c",
        "smbios_type_38-stub.c",
    ],
    deps = [":headers"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_SMBIOS",
            ["smbios.c"],
        ),
        when(
            [
                "CONFIG_SMBIOS",
                "CONFIG_IPMI",
            ],
            ["smbios_type_38.c"],
        ),
        when(
            [
                "CONFIG_SMBIOS",
                "CONFIG_SMBIOS_LEGACY",
            ],
            ["smbios_legacy.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
