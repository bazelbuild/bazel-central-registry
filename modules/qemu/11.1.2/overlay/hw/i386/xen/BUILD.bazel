load("//bazel:qemu.bzl", "qemu_package", "qemu_target_source_set", "when")

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

qemu_target_source_set(
    name = "i386_ss",
    hdrs = ["trace.h"],
    arch = "i386",
    when = [
        when(
            "CONFIG_XEN",
            [
                "xen_apic.c",
                "xen_pvdevice.c",
            ],
        ),
        when(
            [
                "CONFIG_XEN",
                "xen",
            ],
            [
                "xen-hvm.c",
                "xen-pvh.c",
            ],
        ),
        when(
            "CONFIG_XEN_BUS",
            ["xen_platform.c"],
        ),
    ],
)

qemu_package()
