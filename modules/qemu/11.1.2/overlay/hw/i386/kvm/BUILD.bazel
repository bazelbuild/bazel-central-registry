load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_archive_part", "qemu_package", "qemu_target_source_set", "when")

# Translated from hw/i386/kvm/meson.build.

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_archive_part(
    # of libqemuutil.a
    name = "stub_ss",
    srcs = ["xen-stubs.c"],
    deps = [":headers"],
)

qemu_target_source_set(
    name = "i386_ss",
    arch = "i386",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_KVM",
            ["clock.c"],
        ),
        when(
            [
                "CONFIG_KVM",
                "CONFIG_APIC",
            ],
            ["apic.c"],
        ),
        when(
            [
                "CONFIG_KVM",
                "CONFIG_I8254",
            ],
            ["i8254.c"],
        ),
        when(
            [
                "CONFIG_KVM",
                "CONFIG_I8259",
            ],
            ["i8259.c"],
        ),
        when(
            [
                "CONFIG_KVM",
                "CONFIG_IOAPIC",
            ],
            ["ioapic.c"],
        ),
        when(
            [
                "CONFIG_KVM",
                "CONFIG_XEN_EMU",
            ],
            [
                "xen_overlay.c",
                "xen_evtchn.c",
                "xen_gnttab.c",
                "xen_xenstore.c",
                "xen_primary_console.c",
                "xenstore_impl.c",
            ],
        ),
    ],
    deps = [
        ":headers",
        "//hw/intc:headers",
    ],
)

qemu_package()
