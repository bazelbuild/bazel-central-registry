load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from hw/i2c/meson.build.

exports_files(["trace-events"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//visibility:public"],
    when = [
        when(
            [
                "CONFIG_I2C",
                "CONFIG_I2C",
            ],
            ["core.c"],
        ),
        when(
            [
                "CONFIG_I2C",
                "CONFIG_SMBUS",
            ],
            [
                "smbus_slave.c",
                "smbus_master.c",
            ],
        ),
        when(
            [
                "CONFIG_I2C",
                "CONFIG_ACPI_SMBUS",
            ],
            ["pm_smbus.c"],
        ),
        when(
            [
                "CONFIG_I2C",
                "CONFIG_ACPI_ICH9",
            ],
            ["smbus_ich9.c"],
        ),
        when(
            [
                "CONFIG_I2C",
                "CONFIG_ASPEED_SOC",
            ],
            ["aspeed_i2c.c"],
        ),
        when(
            [
                "CONFIG_I2C",
                "CONFIG_BITBANG_I2C",
            ],
            ["bitbang_i2c.c"],
        ),
        when(
            [
                "CONFIG_I2C",
                "CONFIG_EXYNOS4",
            ],
            ["exynos4210_i2c.c"],
        ),
        when(
            [
                "CONFIG_I2C",
                "CONFIG_IMX_I2C",
            ],
            ["imx_i2c.c"],
        ),
        when(
            [
                "CONFIG_I2C",
                "CONFIG_MPC_I2C",
            ],
            ["mpc_i2c.c"],
        ),
        when(
            [
                "CONFIG_I2C",
                "CONFIG_ALLWINNER_I2C",
            ],
            ["allwinner-i2c.c"],
        ),
        when(
            [
                "CONFIG_I2C",
                "CONFIG_NRF51_SOC",
            ],
            ["microbit_i2c.c"],
        ),
        when(
            [
                "CONFIG_I2C",
                "CONFIG_NPCM7XX",
            ],
            ["npcm7xx_smbus.c"],
        ),
        when(
            [
                "CONFIG_I2C",
                "CONFIG_DESIGNWARE_I2C",
            ],
            ["designware_i2c.c"],
        ),
        when(
            [
                "CONFIG_I2C",
                "CONFIG_SMBUS_EEPROM",
            ],
            ["smbus_eeprom.c"],
        ),
        when(
            [
                "CONFIG_I2C",
                "CONFIG_ARM_SBCON_I2C",
            ],
            ["arm_sbcon_i2c.c"],
        ),
        when(
            [
                "CONFIG_I2C",
                "CONFIG_OMAP",
            ],
            ["omap_i2c.c"],
        ),
        when(
            [
                "CONFIG_I2C",
                "CONFIG_PPC4XX",
            ],
            ["ppc4xx_i2c.c"],
        ),
        when(
            [
                "CONFIG_I2C",
                "CONFIG_PCA954X",
            ],
            ["i2c_mux_pca954x.c"],
        ),
        when(
            [
                "CONFIG_I2C",
                "CONFIG_PMBUS",
            ],
            ["pmbus_device.c"],
        ),
        when(
            [
                "CONFIG_I2C",
                "CONFIG_BCM2835_I2C",
            ],
            ["bcm2835_i2c.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
