load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from hw/ide/meson.build.

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_AHCI",
            ["ahci.c"],
        ),
        when(
            "CONFIG_AHCI_ICH9",
            ["ich.c"],
        ),
        when(
            "CONFIG_AHCI_SYSBUS",
            ["ahci-sysbus.c"],
        ),
        when(
            "CONFIG_ALLWINNER_A10",
            ["ahci-allwinner.c"],
        ),
        when(
            "CONFIG_IDE_BUS",
            ["ide-bus.c"],
        ),
        when(
            "CONFIG_IDE_CF",
            ["cf.c"],
        ),
        when(
            "CONFIG_IDE_CMD646",
            ["cmd646.c"],
        ),
        when(
            "CONFIG_IDE_CORE",
            [
                "core.c",
                "atapi.c",
            ],
        ),
        when(
            "CONFIG_IDE_DEV",
            ["ide-dev.c"],
        ),
        when(
            "CONFIG_IDE_ISA",
            ["isa.c"],
        ),
        when(
            "CONFIG_IDE_MACIO",
            ["macio.c"],
        ),
        when(
            "CONFIG_IDE_MMIO",
            ["mmio.c"],
        ),
        when(
            "CONFIG_IDE_PCI",
            ["pci.c"],
        ),
        when(
            "CONFIG_IDE_PIIX",
            ["piix.c"],
        ),
        when(
            "CONFIG_IDE_ISA|CONFIG_IDE_PIIX",
            ["ioport.c"],
        ),
        when(
            "CONFIG_IDE_SII3112",
            ["sii3112.c"],
        ),
        when(
            "CONFIG_IDE_VIA",
            ["via.c"],
        ),
        when(
            "CONFIG_PC87560",
            ["pc87560-ide.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
