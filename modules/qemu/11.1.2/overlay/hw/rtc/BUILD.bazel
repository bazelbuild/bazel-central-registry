load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from hw/rtc/meson.build.

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_DS1338",
            ["ds1338.c"],
        ),
        when(
            "CONFIG_M41T80",
            ["m41t80.c"],
        ),
        when(
            "CONFIG_M48T59",
            ["m48t59.c"],
        ),
        when(
            "CONFIG_PL031",
            ["pl031.c"],
        ),
        when(
            [
                "CONFIG_ISA_BUS",
                "CONFIG_M48T59",
            ],
            ["m48t59-isa.c"],
        ),
        when(
            "CONFIG_XLNX_ZYNQMP",
            ["xlnx-zynqmp-rtc.c"],
        ),
        when(
            "CONFIG_EXYNOS4",
            ["exynos4210_rtc.c"],
        ),
        when(
            "CONFIG_SUN4V_RTC",
            ["sun4v-rtc.c"],
        ),
        when(
            "CONFIG_ASPEED_SOC",
            ["aspeed_rtc.c"],
        ),
        when(
            "CONFIG_GOLDFISH_RTC",
            ["goldfish_rtc.c"],
        ),
        when(
            "CONFIG_LS7A_RTC",
            ["ls7a_rtc.c"],
        ),
        when(
            "CONFIG_ALLWINNER_H3",
            ["allwinner-rtc.c"],
        ),
        when(
            "CONFIG_MC146818RTC",
            ["mc146818rtc.c"],
        ),
        when(
            "CONFIG_RS5C372_RTC",
            ["rs5c372.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
