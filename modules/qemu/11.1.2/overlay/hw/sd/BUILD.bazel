load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from hw/sd/meson.build.

exports_files(["trace-events"], visibility = ["//:__subpackages__"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//:__subpackages__"],
)

qemu_source_set(
    name = "system_ss",
    kind = "system",
    visibility = ["//:__subpackages__"],
    when = [
        when(
            "CONFIG_PL181",
            ["pl181.c"],
        ),
        when(
            "CONFIG_SD",
            [
                "sd.c",
                "core.c",
            ],
        ),
        when(
            "CONFIG_SDHCI",
            ["sdhci.c"],
        ),
        when(
            "CONFIG_SDHCI_PCI",
            ["sdhci-pci.c"],
        ),
        when(
            "CONFIG_SSI_SD",
            ["ssi-sd.c"],
        ),
        when(
            "CONFIG_OMAP",
            ["omap_mmc.c"],
        ),
        when(
            "CONFIG_RASPI",
            ["bcm2835_sdhost.c"],
        ),
        when(
            "CONFIG_ASPEED_SOC",
            ["aspeed_sdhci.c"],
        ),
        when(
            "CONFIG_ALLWINNER_H3",
            ["allwinner-sdhost.c"],
        ),
        when(
            "CONFIG_NPCM7XX",
            ["npcm7xx_sdhci.c"],
        ),
        when(
            "CONFIG_CADENCE_SDHCI",
            ["cadence_sdhci.c"],
        ),
        when(
            "CONFIG_AXIADO_SDHCI",
            ["axiado_sdhci.c"],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
