load("@rules_cc//cc:cc_library.bzl", "cc_library")

# util/vhost-user-server.c includes subprojects/libvhost-user/libvhost-user.h
# by its path from the top, even when the library itself is not built.
cc_library(
    name = "headers",
    hdrs = [
        "libvhost-user.h",
        "libvhost-user-glib.h",
    ] + glob([
        "include/**/*.h",
        "standard-headers/**/*.h",
    ]),
    visibility = ["//visibility:public"],
)
