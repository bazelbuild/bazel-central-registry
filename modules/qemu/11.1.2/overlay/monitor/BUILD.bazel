load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//bazel:qemu.bzl", "qemu_package", "qemu_source_set", "when")

# Translated from monitor/meson.build.

exports_files(["trace-events"])

cc_library(
    name = "headers",
    hdrs = glob(["*.h"]),
    visibility = ["//visibility:public"],
)

qemu_source_set(
    name = "qmp_ss",
    srcs = [
        "monitor.c",
        "qmp.c",
        "qmp-cmds-control.c",
    ],
    visibility = ["//visibility:public"],
    deps = [":headers"],
)

qemu_source_set(
    name = "system_ss",
    srcs = [
        "fds.c",
        "qemu-config-qmp.c",
        "qmp-cmds.c",
    ],
    kind = "system",
    visibility = ["//visibility:public"],
    when = [
        when(
            "have_hmp",
            [
                "hmp-cmds.c",
                "hmp.c",
            ],
        ),
    ],
    deps = [":headers"],
)

qemu_package()
