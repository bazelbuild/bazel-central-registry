"""Downstream Bazel build of QEMU 11.1.2."""

module(
    name = "qemu",
    version = "11.1.2",
    compatibility_level = 0,
    bazel_compatibility = [">=9.3.2"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "package_metadata", version = "0.0.15")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "2.5.1")
bazel_dep(name = "rules_shell", version = "0.10.0")

# Release versions of the libraries QEMU links. Stock BCR GLib's Linux
# config.h assumes glibc; adapt its pinned build overlay for static musl.
static_deps = use_extension("//bazel/deps:glib.bzl", "static_deps")
use_repo(static_deps, "qemu_glib", "qemu_pcre2")

bazel_dep(name = "pixman", version = "0.46.4")
bazel_dep(name = "zlib", version = "1.3.2.bcr.3")

# The build-time generators (tracetool, qapi-gen, ...) are Python scripts.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)
use_repo(python, "python_3_12", qemu_host_python = "python_3_12_x86_64-unknown-linux-gnu")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# libslirp is not currently in BCR. Use the upstream release mirrored by Debian.
http_archive(
    name = "qemu_libslirp",
    build_file = "//bazel:libslirp.BUILD.bazel",
    sha256 = "4f59df896cb345ea76d7f68b1e820872feaa9d8255a6761f6bf8a0f2d5144bcd",
    strip_prefix = "libslirp-v4.9.5",
    urls = ["https://deb.debian.org/debian/pool/main/libs/libslirp/libslirp_4.9.5.orig.tar.bz2"],
)

# Per-target configuration (config-target.h, Kconfig device selection).
qemu_targets = use_extension("//bazel/config:targets.bzl", "qemu_targets")
use_repo(qemu_targets, "qemu_targets")
