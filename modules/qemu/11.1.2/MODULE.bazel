"""Downstream Bazel build of QEMU 11.1.2."""

module(
    name = "qemu",
    version = "11.1.2",
    compatibility_level = 0,
    bazel_compatibility = [">=8.4.0"],
)

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "package_metadata", version = "0.0.15")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
# 2.3 and later use MODULE.bazel flag_alias, which Bazel 8.4 lacks.
bazel_dep(name = "rules_python", version = "2.2.0")
bazel_dep(name = "rules_shell", version = "0.10.0")

# The .bcr revisions supply the musl config and shell-free generators.
bazel_dep(name = "glib", version = "2.84.4.bcr.2")
bazel_dep(name = "libslirp", version = "4.9.5")
bazel_dep(name = "pcre2", version = "10.49.bcr.1")
bazel_dep(name = "pixman", version = "0.46.4")
bazel_dep(name = "zlib", version = "1.3.2.bcr.3")

# The build-time generators (tracetool, qapi-gen, ...) are Python scripts.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)
use_repo(python, "python_3_12", "python_3_12_host")

# Per-target configuration (config-target.h, Kconfig device selection).
qemu_targets = use_extension("//bazel/config:targets.bzl", "qemu_targets")
use_repo(qemu_targets, "qemu_targets")
