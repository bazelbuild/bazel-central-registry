"""sv-elab: SystemVerilog elaborator"""

module(
    name = "sv-elab",
    version = "2026-11-09",
    bazel_compatibility = [">=7.2.1"],
)

bazel_dep(name = "yosys", version = "0.68.bcr.3")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_cc", version = "0.2.17")
bazel_dep(name = "rules_python", version = "2.0.0")
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "rules_shell", version = "0.6.1")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "sv-lang", version = "12.1.0")

single_version_override(
    module_name = "sv-lang",
    version = "12.1.0",
)

vendored_hashlib_ext = use_extension("//:dependency_support/hashlib_ext.bzl", "vendored_hashlib")
use_repo(vendored_hashlib_ext, "vendored-hashlib")

slang_version = use_repo_rule("//:dependency_support/slang_version.bzl", "slang_version")
slang_version(
    name = "slang_version",
    path = "third_party/slang",
)
