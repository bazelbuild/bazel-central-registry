load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@package_metadata//purl:purl.bzl", "purl")

# SDL3_mixer main package

DEFAULT_CODEC_DEFINES = [
    "DECODER_FLAC_DRFLAC",
    "DECODER_MP3_DRMP3",
    "DECODER_WAV",
    "DECODER_MIDI_TIMIDITY",
    "DECODER_OGGVORBIS_STB",
]

PLATFORM_LINKOPTS = select({
    "@platforms//os:macos": [
        "-Wl,-framework,AudioToolbox",
        "-Wl,-framework,AudioUnit",
        "-Wl,-framework,CoreServices",
    ],
    "@platforms//os:windows": [
        "winmm.lib",
    ],
    "//conditions:default": [],
})

cc_library(
    name = "sdl3_mixer",
    srcs = glob([
        "src/*.c",
        "src/*.h",
    ]),
    implementation_deps = [
        ":dr_flac",
        ":dr_mp3",
        ":stb_vorbis",
        ":timidity",
    ],
    package_metadata = [":metadata.sdl3_mixer"],
    includes = ["include"],
    linkopts = PLATFORM_LINKOPTS,
    local_defines = DEFAULT_CODEC_DEFINES,
    visibility = ["//visibility:public"],
    hdrs = ["include/SDL3_mixer/SDL_mixer.h"],
    deps = ["@sdl3"],
)

package_metadata(
    name = "metadata.sdl3_mixer",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//:__subpackages__"],
)

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:Zlib",
    text = "LICENSE.txt",
)

# dr-libs targets

cc_library(
    name = "dr_flac",
    hdrs = [
        "src/dr_libs/dr_flac.h",
    ],
    package_metadata = [":metadata.dr_flac"],
    visibility = ["//:__subpackages__"],
)

cc_library(
    name = "dr_mp3",
    hdrs = [
        "src/dr_libs/dr_mp3.h"
    ],
    package_metadata = [":metadata.dr_mp3"],
    visibility = ["//:__subpackages__"],
)

package_metadata(
    name = "metadata.dr_mp3",
    attributes = [":license.dr_libs"],
    purl = "pkg:generic/dr_mp3@0.7.4",
    visibility = ["//:__subpackages__"],
)

package_metadata(
    name = "metadata.dr_flac",
    attributes = [":license.dr_libs"],
    purl = "pkg:generic/dr_flac@0.13.4",
    visibility = ["//:__subpackages__"],
)

license(
    name = "license.dr_libs",
    kind = "@package_metadata//licenses/spdx:MIT-0",
    text = "src/dr_libs/LICENSE",
)

# stb-vorbis target

cc_library(
    name = "stb_vorbis",
    hdrs = [
        "src/stb_vorbis/stb_vorbis.h"
    ],
    package_metadata = [":metadata.stb_vorbis"],
    visibility = ["//:__subpackages__"],
)

package_metadata(
    name = "metadata.stb_vorbis",
    attributes = [":license.stb_vorbis"],
    purl = "pkg:generic/stb_vorbis@1.22",
    visibility = ["//:__subpackages__"],
)

license(
    name = "license.stb_vorbis",
    kind = "@package_metadata//licenses/spdx:MIT",
    text = "src/stb_vorbis/stb_vorbis.h",
)

# timidity target

cc_library(
    name = "timidity",
    srcs = glob(["src/timidity/*.c"]),
    hdrs = glob(["src/timidity/*.h"]),
    package_metadata = [":metadata.timidity"],
    deps = ["@sdl3"],
    visibility = ["//:__subpackages__"],
)

package_metadata(
    name = "metadata.timidity",
    attributes = [":license.timidity"],
    purl = "pkg:generic/timidity@0.2i",
    visibility = ["//:__subpackages__"],
)

license(
    name = "license.timidity",
    kind = "@package_metadata//licenses/spdx:Artistic-1.0",
    text = "src/timidity/COPYING",
)

exports_files([
    "LICENSE.txt",
    "src/dr_libs/LICENSE",
    "src/timidity/COPYING",
])

# tests

cc_test(
    name = "testaudiodecoder",
    srcs = ["test/testaudiodecoder.c"],
    deps = [":sdl3_mixer"],
)

cc_test(
    name = "testmixer",
    srcs = ["test/testmixer.c"],
    deps = [":sdl3_mixer"],
)

cc_test(
    name = "testspatialization",
    srcs = ["test/testspatialization.c"],
    deps = [":sdl3_mixer"],
)

cc_test(
    name = "sdl3_mixer_headers_consumer_compile_test",
    srcs = ["bcr_tests/sdl3_mixer_headers_consumer_compile_test.cc"],
    deps = [":sdl3_mixer"],
)

cc_test(
    name = "sdl3_mixer_consumer_link_test",
    srcs = ["bcr_tests/sdl3_mixer_consumer_link_test.cc"],
    deps = [":sdl3_mixer"],
)
