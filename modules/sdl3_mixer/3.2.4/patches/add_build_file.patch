--- /dev/null
+++ BUILD.bazel
@@ -0,0 +1,147 @@
+load("@rules_cc//cc:defs.bzl", "cc_library", "cc_test")
+load("@rules_license//rules:license.bzl", "license")
+
+package(
+    default_applicable_licenses = [":license"],
+)
+
+license(
+    name = "license",
+    license_kinds = ["@rules_license//licenses/spdx:Zlib"],
+    license_text = "LICENSE.txt",
+)
+
+license(
+    name = "license.dr_libs",
+    license_kinds = ["@rules_license//licenses/spdx:MIT-0"],
+    license_text = "src/dr_libs/LICENSE",
+)
+
+license(
+    name = "license.stb_vorbis",
+    license_kinds = ["@rules_license//licenses/spdx:MIT"],
+    license_text = "src/stb_vorbis/stb_vorbis.h",
+)
+
+license(
+    name = "license.timidity",
+    license_kinds = ["@rules_license//licenses/spdx:Artistic-1.0"],
+    license_text = "src/timidity/COPYING",
+)
+
+exports_files([
+    "LICENSE.txt",
+    "src/dr_libs/LICENSE",
+    "src/timidity/COPYING",
+])
+
+DEFAULT_CODEC_DEFINES = [
+    "DECODER_FLAC_DRFLAC",
+    "DECODER_MP3_DRMP3",
+    "DECODER_WAV",
+    "DECODER_MIDI_TIMIDITY",
+    "DECODER_OGGVORBIS_STB",
+]
+
+PLATFORM_LINKOPTS = select({
+    "@platforms//os:macos": [
+        "-Wl,-framework,AudioToolbox",
+        "-Wl,-framework,AudioUnit",
+        "-Wl,-framework,CoreServices",
+        "-Wl,-exported_symbols_list,$(location :src/SDL_mixer.exports)"
+    ],
+    "@platforms//os:windows": [
+        "winmm.lib",
+    ],
+    "//conditions:default": [],
+})
+
+cc_library(
+    name = "sdl3_mixer_headers",
+    hdrs = ["include/SDL3_mixer/SDL_mixer.h"],
+    strip_include_prefix = "include",
+    visibility = ["//visibility:public"],
+    deps = ["@sdl3"],
+)
+
+cc_library(
+    name = "sdl3_mixer_private_dr_libs",
+    hdrs = [
+        "src/dr_libs/dr_flac.h",
+        "src/dr_libs/dr_mp3.h"
+    ],
+    visibility = ["//:__subpackages__"],
+)
+
+cc_library(
+    name = "sdl3_mixer_private_stb_vorbis",
+    hdrs = [
+        "src/stb_vorbis/stb_vorbis.h"
+    ],
+    visibility = ["//:__subpackages__"],
+)
+
+cc_library(
+    name = "sdl3_mixer_private_timidity",
+    srcs = glob(["src/timidity/*.c"]),
+    hdrs = glob(["src/timidity/*.h"]),
+    visibility = ["//:__subpackages__"],
+    deps = ["@sdl3"],
+)
+
+cc_library(
+    name = "sdl3_mixer",
+    srcs = glob([
+        "src/*.c",
+        "src/*.h",
+    ]),
+    applicable_licenses = [
+        ":license",
+        ":license.dr_libs",
+        ":license.stb_vorbis",
+        ":license.timidity",
+    ],
+    implementation_deps = [
+        ":sdl3_mixer_private_dr_libs",
+        ":sdl3_mixer_private_stb_vorbis",
+        ":sdl3_mixer_private_timidity",
+    ],
+    includes = ["include"],
+    linkopts = PLATFORM_LINKOPTS,
+    local_defines = DEFAULT_CODEC_DEFINES,
+    visibility = ["//visibility:public"],
+    deps = [
+        ":sdl3_mixer_headers",
+        "@sdl3",
+    ],
+)
+
+cc_test(
+    name = "testaudiodecoder",
+    srcs = ["test/testaudiodecoder.c"],
+    deps = [":sdl3_mixer"],
+)
+
+cc_test(
+    name = "testmixer",
+    srcs = ["test/testmixer.c"],
+    deps = [":sdl3_mixer"],
+)
+
+cc_test(
+    name = "testspatialization",
+    srcs = ["test/testspatialization.c"],
+    deps = [":sdl3_mixer"],
+)
+
+cc_test(
+    name = "sdl3_mixer_headers_consumer_compile_test",
+    srcs = ["sdl3_mixer_headers_consumer_compile_test.cc"],
+    deps = [":sdl3_mixer"],
+)
+
+cc_test(
+    name = "sdl3_mixer_consumer_link_test",
+    srcs = ["sdl3_mixer_consumer_link_test.cc"],
+    deps = [":sdl3_mixer"],
+)
