load("@rules_cc//cc:cc_test.bzl", "cc_test")

# The upstream tests that run as a single MPI process. @mpich comes without a
# process manager, so the multi-process tests cannot be launched here.
[cc_test(
    name = test,
    srcs = [test + ".cpp"],
    deps = [
        "@boost.core",
        "@boost.graph",
        "@boost.graph_parallel",
        "@boost.property_map",
        "@boost.random",
    ],
) for test in [
    "distributed_csr_algorithm_test",
    "named_vertices_seq",
]]
