load("@rules_cc//cc:cc_library.bzl", "cc_library")

# The parallel BGL headers #error unless <boost/graph/use_mpi.hpp> was included
# first, so they cannot be compiled on their own and parse_headers is not used.
cc_library(
    name = "boost.graph_parallel",
    srcs = [
        "src/mpi_process_group.cpp",
        "src/tag_allocator.cpp",
    ],
    hdrs = glob(["include/**/*.hpp"]),
    defines = ["BOOST_GRAPH_PARALLEL_NO_LIB"],
    includes = ["include"],
    local_defines = ["BOOST_GRAPH_PARALLEL_SOURCE"],
    target_compatible_with = ["@platforms//os:linux"],
    # Implementation files that the corresponding headers paste in.
    textual_hdrs = glob(["include/**/*.ipp"]),
    visibility = ["//visibility:public"],
    deps = [
        "@boost.assert",
        "@boost.concept_check",
        "@boost.config",
        "@boost.container_hash",
        "@boost.core",
        "@boost.detail",
        "@boost.dynamic_bitset",
        "@boost.filesystem",
        "@boost.foreach",
        "@boost.function",
        "@boost.graph",
        "@boost.iterator",
        "@boost.lexical_cast",
        "@boost.mpi",
        "@boost.mpl",
        "@boost.optional",
        "@boost.property_map",
        "@boost.property_map_parallel",
        "@boost.random",
        "@boost.serialization",
        "@boost.smart_ptr",
        "@boost.tuple",
        "@boost.type_traits",
        "@boost.variant",
    ],
)
