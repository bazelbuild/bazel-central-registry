"""periareon/rules_helm/extensions/img"""

module(
    name = "rules_helm_img",
    version = "0.38.0",
)

bazel_dep(name = "rules_helm", version = "0.38.0")
bazel_dep(name = "rules_img", version = "0.3.24")
bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "platforms", version = "1.1.0")

# For the Go test in `tests/helm_oci_manifest`. The Go SDK itself comes from
# `rules_helm`, which already needs one for its tools.
bazel_dep(name = "rules_go", version = "0.63.0", dev_dependency = True)

# An image pulled with `img_pull`, for the `image_import` cases in
# `tests/with_image_deps`.
pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

pull(
    name = "rules_helm_test_img_container_base",
    dev_dependency = True,
    digest = "sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659",
    registry = "index.docker.io",
    repository = "library/alpine",
    tag = "3.23.3",
)
