load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])  # BSD-3-Clause

exports_files(["LICENSE.rst"])

# The optional `_speedups` C extension is not built; MarkupSafe falls back to
# the pure-Python `_native` implementation at import time.
py_library(
    name = "markupsafe",
    srcs = glob(["src/markupsafe/*.py"]),
    data = ["src/markupsafe/py.typed"],
    imports = ["src"],
)
