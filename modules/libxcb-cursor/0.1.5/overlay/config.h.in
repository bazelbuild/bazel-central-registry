/* Results of the configure.ac probes that cursor/parse_cursor_file.c tests
   with #ifdef. Upstream has no config header and passes them as -D flags
   (DEFS); this template is filled in by :xcb_cursor_config_h in BUILD.bazel. */

/* Define to 1 if you have the <endian.h> header file. */
#undef HAVE_ENDIAN_H

/* Define to 1 if you have the <libkern/OSByteOrder.h> header file. */
#undef HAVE_LIBKERN_OSBYTEORDER_H

/* Define to 1 if you have the `le32toh' function. */
#undef HAVE_LE32TOH

/* Define to 1 if you have the <sys/byteorder.h> header file. */
#undef HAVE_SYS_BYTEORDER_H

/* Define to 1 if you have the <sys/endian.h> header file. */
#undef HAVE_SYS_ENDIAN_H
