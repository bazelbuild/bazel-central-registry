# Built without the METIS-based partitioning and supernodal (BLAS/LAPACK)
# modules, matching the subset of CHOLMOD that is vendored here.
cc_library(
    name = "cholmod",
    srcs = glob([
        "CHOLMOD/Check/cholmod_*.c",
        "CHOLMOD/Cholesky/cholmod_*.c",
        "CHOLMOD/MatrixOps/cholmod_*.c",
        "CHOLMOD/Modify/cholmod_*.c",
        "CHOLMOD/Utility/cholmod_*.c",
    ]),
    hdrs = [
        "CHOLMOD/Include/cholmod.h",
        "CHOLMOD/Include/cholmod_types.h",
    ],
    defines = [
        "NPARTITION",
        "NSUPERNODAL",
    ],
    implementation_deps = [
        ":amd",
        ":camd",
        ":ccolamd",
        ":cholmod_private",
        ":colamd",
    ],
    package_metadata = CHOLMOD_LICENSES,
    strip_include_prefix = "CHOLMOD/Include",
    visibility = ["//visibility:public"],
    deps = [":config"],
)

# Upstream installs every public header flat as `<suitesparse/foo.h>`. The
# headers are copied into a single directory so that one target declares all
# of them (keeping consumers `layering_check` clean) and so that their own
# `#include "SuiteSparse_config.h"` etc. resolve to the sibling copies.
PREFIXED_HEADERS = {
    "SuiteSparse_config.h": "SuiteSparse_config/SuiteSparse_config.h",
    "amd.h": "AMD/Include/amd.h",
    "btf.h": "BTF/Include/btf.h",
    "camd.h": "CAMD/Include/camd.h",
    "ccolamd.h": "CCOLAMD/Include/ccolamd.h",
    "cholmod.h": "CHOLMOD/Include/cholmod.h",
    "cholmod_types.h": "CHOLMOD/Include/cholmod_types.h",
    "colamd.h": "COLAMD/Include/colamd.h",
    "cs.h": "CXSparse/Include/cs.h",
    "klu.h": "KLU/Include/klu.h",
    "klu_version.h": "KLU/Include/klu_version.h",
    "ldl.h": "LDL/Include/ldl.h",
}

[
    copy_file(
        name = "prefixed_" + hdr,
        src = src,
        out = "_prefixed/suitesparse/" + hdr,
        package_metadata = ALL_LICENSES,
    )
    for hdr, src in PREFIXED_HEADERS.items()
]

cc_library(
    name = "prefixed_headers",
    hdrs = [
        "_prefixed/suitesparse/" + hdr
        for hdr in PREFIXED_HEADERS
        if hdr != "cs.h"
    ] + select({
        "@rules_cc//cc/compiler:clang-cl": [],
        "@rules_cc//cc/compiler:msvc-cl": [],
        "//conditions:default": ["_prefixed/suitesparse/cs.h"],
    }),
    package_metadata = ALL_LICENSES,
    strip_include_prefix = "_prefixed",
    visibility = ["//visibility:public"],
    deps = [":suitesparse"],
)

cc_library(
    name = "suitesparse",
    package_metadata = ALL_LICENSES,
    visibility = ["//visibility:public"],
    deps = [
        ":amd",
        ":btf",
        ":camd",
        ":ccolamd",
        ":cholmod",
        ":colamd",
        ":config",
        ":klu",
        ":ldl",
    ] + CXSPARSE_DEPS,
)

# Kept for backward compatibility with earlier versions of this module.
