# CXSparse uses C99 complex types, which MSVC does not support. Upstream builds
# it without complex support (NCOMPLEX) there; this module does not provide it
# on MSVC-compatible compilers at all.
CXSPARSE_INCOMPATIBLE = select({
    "@rules_cc//cc/compiler:clang-cl": ["@platforms//:incompatible"],
    "@rules_cc//cc/compiler:msvc-cl": ["@platforms//:incompatible"],
    "//conditions:default": [],
})

CXSPARSE_DEPS = select({
    "@rules_cc//cc/compiler:clang-cl": [],
    "@rules_cc//cc/compiler:msvc-cl": [],
    "//conditions:default": [":cxsparse"],
})

# Per the upstream build system, libamd source code is compiled twice: once as
# 32-bit and once as 64-bit. It provides `amd_l_{foo}.c` files for 64-bit mode
# that `#define DLONG` and then `#include "amd_{foo}.c"`. To allow including
# `*.c` files, we must list them as textual_hdrs, but we don't want those to be
# exposed downstream so we need to wrap them in an implementation_deps library.
# The same applies to the other components.
#
# Public headers are exposed through `hdrs` + `strip_include_prefix` only, and
# `includes` stay on the private libraries, so nothing internal leaks to
# dependents. This keeps every target `layering_check` clean.

cc_library(
    name = "config",
    srcs = ["SuiteSparse_config/SuiteSparse_config.c"],
    hdrs = ["SuiteSparse_config/SuiteSparse_config.h"],
    defines = select({
        "@platforms//os:windows": ["NTIMER"],
        "//conditions:default": [],
    }),
    linkopts = select({
        "@platforms//os:windows": [],
        "//conditions:default": ["-lm"],
    }),
    strip_include_prefix = "SuiteSparse_config",
    visibility = ["//visibility:public"],
)

alias(
    name = "suitesparse_config",
    actual = ":config",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "amd_private",
    hdrs = glob(["AMD/Include/*.h"]),
    includes = ["AMD/Include"],
    textual_hdrs = glob(["AMD/Source/*.c"]),
    deps = [":config"],
)

cc_library(
    name = "amd",
    srcs = glob(["AMD/Source/*.c"]),
    hdrs = ["AMD/Include/amd.h"],
    implementation_deps = [":amd_private"],
    strip_include_prefix = "AMD/Include",
    visibility = ["//visibility:public"],
    deps = [":config"],
)

cc_library(
