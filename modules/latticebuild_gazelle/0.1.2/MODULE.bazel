module(
    name = "latticebuild_gazelle",
    version = "0.1.2",
    bazel_compatibility = [">=9.2.0"],
)

bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_go", version = "0.63.0", repo_name = "io_bazel_rules_go")
bazel_dep(name = "gazelle", version = "0.51.3")

go_sdk = use_extension("@io_bazel_rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.1")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_connectrpc_connect", "com_github_bazelbuild_buildtools", "com_github_bmatcuk_doublestar_v4", "com_github_latticebuild_graceproc", "org_golang_google_protobuf", "org_golang_x_sys")

bazel_dep(name = "bazel_skylib", version = "1.9.2")
bazel_dep(name = "package_metadata", version = "0.0.13")
bazel_dep(name = "rules_nodejs", version = "6.7.5")
bazel_dep(name = "rules_bound", version = "0.2.1")
bazel_dep(name = "yq.bzl", version = "0.4.0")

node = use_extension("@rules_nodejs//nodejs:extensions.bzl", "node")
node.toolchain(node_version = "26.8.2")

bound = use_extension("@rules_bound//bound:extensions.bzl", "bound")
bound.toolchain(version = "0.2.1")

yq = use_extension("@yq.bzl//yq:extensions.bzl", "yq")
use_repo(yq, "yq_darwin_amd64", "yq_darwin_arm64", "yq_linux_amd64", "yq_linux_arm64", "yq_linux_ppc64le", "yq_linux_riscv64", "yq_linux_s390x", "yq_toolchains", "yq_windows_amd64", "yq_windows_arm64")

register_toolchains("@yq_toolchains//:all")

bazel_dep(name = "latticebuild_js", version = "0.1.2")

node_modules = use_repo_rule("@latticebuild_js//js:repositories.bzl", "node_modules")

node_modules(
    name = "pnpm",
    package_json = "//:package.json",
)

git_override(
    module_name = "latticebuild_js",
    commit = "64c15eddaeff736ce0c63461d863156986c35270",
    remote = "https://github.com/latticebuild/rules_js.git",
)

# Documentation tools are root-only development dependencies.
bazel_dep(name = "stardoc", version = "0.8.1", dev_dependency = True)
bazel_dep(name = "protobuf", version = "36.2", dev_dependency = True)
