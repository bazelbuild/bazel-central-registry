load("@rules_cc//cc:cc_library.bzl", "cc_library")

# Re-included by itself through BOOST_PP_ITERATE and relies on macros defined
# by its includer, so it is not self-contained.
_TEXTUAL_HDRS = ["include/boost/local_function/aux_/function.hpp"]

cc_library(
    name = "boost.local_function",
    hdrs = glob(["include/**/*.hpp"], exclude = _TEXTUAL_HDRS),
    features = ["parse_headers"],
    includes = ["include"],
    textual_hdrs = _TEXTUAL_HDRS,
    visibility = ["//visibility:public"],
    deps = [
        "@boost.config",
        "@boost.mpl",
        "@boost.preprocessor",
        "@boost.scope_exit",
        "@boost.type_traits",
        "@boost.typeof",
        "@boost.utility",
    ],
)
