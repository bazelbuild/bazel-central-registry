module(name = "ncurses_test")

bazel_dep(name = "ncurses")
local_path_override(
    module_name = "ncurses",
    path = "..",
)

bazel_dep(name = "llvm", version = "0.8.24")
bazel_dep(name = "rules_cc", version = "0.2.25")

# Build with a hermetic LLVM toolchain, which also builds the tools used during
# the build (e.g. gawk) from source.
register_toolchains("@llvm//toolchain:all")

# Use the macOS SDK of the host, so macOS can only be targeted on macOS.
osx = use_extension("@llvm//extensions:osx.bzl", "osx")
osx.from_host()
