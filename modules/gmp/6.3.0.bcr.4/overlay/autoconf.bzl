        kind = "@package_metadata//licenses/spdx:GPL-3.0-or-later",
        text = "COPYING",
        visibility = ["//:__subpackages__"],
    )

    license(
        name = "license_COPYING_LESSERv3",
        kind = "@package_metadata//licenses/spdx:LGPL-3.0-or-later",
        text = "COPYING.LESSERv3",
        visibility = ["//:__subpackages__"],
    )

    package_metadata(
        name = "package_metadata",
        attributes = [
            ":license_COPYING",
            ":license_COPYING_LESSERv3",
        ],
        purl = purl.bazel(
            native.module_name(),
