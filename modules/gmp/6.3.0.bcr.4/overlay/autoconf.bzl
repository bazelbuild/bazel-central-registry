    for name in BOOL_OPTIONS:
        native.config_setting(
            name = name + "_enabled",
            flag_values = {":" + name: "True"},
            visibility = ["//:__subpackages__"],
        )

    bool_flag(
        name = "cxx_option",
        build_setting_default = False,
        visibility = ["//visibility:public"],
