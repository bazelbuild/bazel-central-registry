load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc_autoconf//autoconf:autoconf_hdr.bzl", "autoconf_hdr")
load(
    "//bazel:gmp.bzl",
    "gmp_config_m4",
    "gmp_copy",
    "gmp_gen",
    "gmp_mpn_m4",
    "gmp_native_checks",
)
load(
    "//bazel:mpn.bzl",
    "GMP_MPN_FUNCTIONS",
    "GMP_MPN_FUNCTIONS_OPTIONAL",
)
load(":autoconf.bzl", "C_STD_OPTS", "autoconf_targets")

# The targets of configure.ac and the Makefile.am files, declared by the generated
# autoconf.bzl beside this file; this file is hand-written and kept as it is.  A target
# added below is the module's own; one named like a generated target replaces it at the
# next conversion.
autoconf_targets()

# configure chooses GMP's mpn implementation per CPU: an assembly file per
# function, found along a search path (the `--host` and the CPU variant),
# preprocessed with m4 against config.m4, with HAVE_NATIVE_mpn_* defines
# derived from the assembly's PROLOGUEs and generic C for the rest. That is
# shell the conversion does not follow, so the machinery lives in bazel/
# (gmp_native_checks, gmp_config_m4, gmp_mpn_m4) and these targets, on top of
# the generated `autoconf` configuration. libgmp stays one archive: the mpn
# objects reference core symbols and vice versa, which separate archives in
# one linker pass cannot resolve.

# CPU micro-architecture variant for selecting optimized assembly. "auto"
# picks the generic baseline for each architecture (k8 for x86_64, arm64 for
# aarch64). Override with --@gmp//:cpu=zen3 (or skylake, cora57, applem1, ...).
string_flag(
    name = "cpu",
    build_setting_default = "auto",
    values = [
        "auto",
        # x86_64 variants (from configure.ac)
        "alderlake",
        "atom",
        "bd1",
        "bd2",
        "bd3",
        "bd4",
        "bt1",
        "bt2",
        "core2",
        "coreibwl",
        "coreihwl",
        "coreinhm",
        "coreisbr",
        "goldmont",
        "k8",
        "k10",
        "nano",
        "pentium4",
        "silvermont",
        "skylake",
        "tremont",
        "zen",
        "zen2",
        "zen3",
        # aarch64 variants
        "applem1",
        "cora53",
        "cora57",
        "xgene1",
    ],
)

# 32-bit limbs (GMP_LIMB_BITS, the generated tables' word size).
selects.config_setting_group(
    name = "cpu_32bit",
    match_any = [
        "@platforms//cpu:aarch32",
        "@platforms//cpu:arm",
        "@platforms//cpu:arm64_32",
        "@platforms//cpu:armv6-m",
        "@platforms//cpu:armv7",
        "@platforms//cpu:armv7-m",
        "@platforms//cpu:armv7e-m",
        "@platforms//cpu:armv7e-mf",
        "@platforms//cpu:armv7k",
        "@platforms//cpu:armv8-m",
        "@platforms//cpu:cortex-r52",
        "@platforms//cpu:i386",
        "@platforms//cpu:ppc",
        "@platforms//cpu:ppc32",
        "@platforms//cpu:riscv32",
        "@platforms//cpu:wasm32",
        "@platforms//cpu:x86_32",
    ],
)

# Windows is LLP64: `unsigned long` is 4 bytes even on 64-bit, so gmp.h must
# make mp_limb_t `unsigned long long` (_LONG_LONG_LIMB).
config_setting(
    name = "windows_x86_64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "windows_aarch64",
    constraint_values = [
        "@platforms//os:windows",
        "@platforms//cpu:aarch64",
    ],
)

selects.config_setting_group(
    name = "windows_64bit",
    match_any = [
        ":windows_x86_64",
        ":windows_aarch64",
    ],
)

# Assembly is left out under MemorySanitizer (uninstrumented code).
config_setting(
    name = "asm_disabled",
    values = {"features": "msan"},
)

_DISABLE_ASM = select({
    ":asm_disabled": True,
    "//conditions:default": False,
})

_ALL_MPN_FUNCTIONS = GMP_MPN_FUNCTIONS + GMP_MPN_FUNCTIONS_OPTIONAL

_MPN_ARCH = select({
    "@platforms//cpu:aarch64": "aarch64",
    "@platforms//cpu:arm": "arm",
    "@platforms//cpu:arm64": "aarch64",
    "@platforms//cpu:arm64_32": "aarch64",
    "@platforms//cpu:arm64e": "aarch64",
    "@platforms//cpu:armv7": "arm",
    "@platforms//cpu:armv7-m": "arm",
    "@platforms//cpu:armv7e-m": "arm",
    "@platforms//cpu:armv7e-mf": "arm",
    "@platforms//cpu:armv7k": "arm",
    "@platforms//cpu:i386": "x86",
    "@platforms//cpu:mips64": "mips64",
    "@platforms//cpu:ppc": "powerpc32",
    "@platforms//cpu:ppc32": "powerpc32",
    "@platforms//cpu:ppc64le": "powerpc64",
    "@platforms//cpu:riscv32": "riscv",
    "@platforms//cpu:riscv64": "riscv",
    "@platforms//cpu:s390x": "s390_64",
    "@platforms//cpu:x86_32": "x86",
    "@platforms//cpu:x86_64": "x86_64",
    "//conditions:default": "generic",
})

_MPN_OS = select({
    "@platforms//os:linux": "linux",
    "@platforms//os:macos": "macos",
    "@platforms//os:windows": "windows",
    "//conditions:default": "linux",
})

_MPN_ASM_SRCS = select({
    "@platforms//cpu:aarch64": glob(["mpn/arm64/**/*.asm"]),
    "@platforms//cpu:arm": glob(["mpn/arm/**/*.asm"]),
    "@platforms//cpu:arm64": glob(["mpn/arm64/**/*.asm"]),
    "@platforms//cpu:arm64e": glob(["mpn/arm64/**/*.asm"]),
    "@platforms//cpu:armv7": glob(["mpn/arm/**/*.asm"]),
    "@platforms//cpu:i386": glob(["mpn/x86/**/*.asm"]),
    "@platforms//cpu:mips64": glob(["mpn/mips64/**/*.asm"]),
    "@platforms//cpu:ppc": glob(["mpn/powerpc32/**/*.asm"]),
    "@platforms//cpu:ppc32": glob(["mpn/powerpc32/**/*.asm"]),
    "@platforms//cpu:ppc64le": glob(["mpn/powerpc64/**/*.asm"]),
    "@platforms//cpu:riscv64": glob(["mpn/riscv/**/*.asm"]),
    "@platforms//cpu:s390x": glob(["mpn/s390_64/**/*.asm"]),
    "@platforms//cpu:x86_32": glob(["mpn/x86/**/*.asm"]),
    "@platforms//cpu:x86_64": glob(["mpn/x86_64/**/*.asm"]),
    "//conditions:default": [],
})

_MPN_GENERIC_SRCS = glob(["mpn/generic/*.c"])

_MPN_M4_DEPS = glob(["mpn/**/*.m4"]) + [":config_m4"]

# HAVE_NATIVE_mpn_* results, derived from the selected assembly's PROLOGUEs.
gmp_native_checks(
    name = "native_checks",
    arch = _MPN_ARCH,
    asm_srcs = _MPN_ASM_SRCS,
    cpu = ":cpu",
    disable_asm = _DISABLE_ASM,
    os = _MPN_OS,
)

# Replaces the generated target: config.h also carries the HAVE_NATIVE_mpn_*
# results.
autoconf_hdr(
    name = "config",
    out = "config.h",
    # The assembler's local label prefix, which configure finds by assembling
    # test input (GMP_ASM_LSYM_PREFIX): `L` for Mach-O, `.L` for ELF and COFF.
    # Written into the template, since no check of the build produces it.
    substitutions = select({
        "@platforms//os:macos": {"#undef LSYM_PREFIX": "#define LSYM_PREFIX \"L\""},
        "//conditions:default": {"#undef LSYM_PREFIX": "#define LSYM_PREFIX \".L\""},
    }),
    template = "config.in",
    visibility = ["//visibility:public"],
    deps = [
        ":autoconf",
        ":native_checks",
    ],
)

# gmp.h from gmp-h.in, with configure's substitutions; _LONG_LONG_LIMB is the
# ABI's (configure derives it from the compiler it picked).
autoconf_hdr(
    name = "gmp_h",
    out = "gmp.h",
    mode = "subst",
    substitutions = select({
        ":windows_64bit": {"@DEFN_LONG_LONG_LIMB@": "#define _LONG_LONG_LIMB 1"},
        "//conditions:default": {"@DEFN_LONG_LONG_LIMB@": "/* #undef _LONG_LONG_LIMB */"},
    }) | {
        # configure records the compiler it used and whether it built a DLL;
        # neither is a property of a Bazel build.
        "@CC@": "cc",
        "@CFLAGS@": "",
        "@LIBGMP_DLL@": "0",
    },
    template = "gmp-h.in",
    visibility = ["//visibility:public"],
    deps = [":autoconf"],
)

# gmp-mparam.h: the tuning thresholds of the selected CPU family.
gmp_copy(
    name = "gmp_mparam_h",
    src = select({
        "@platforms//cpu:aarch64": "mpn/arm64/gmp-mparam.h",
        "@platforms//cpu:arm": "mpn/arm/gmp-mparam.h",
        "@platforms//cpu:arm64": "mpn/arm64/gmp-mparam.h",
        "@platforms//cpu:arm64e": "mpn/arm64/gmp-mparam.h",
        "@platforms//cpu:armv7": "mpn/arm/gmp-mparam.h",
        "@platforms//cpu:i386": "mpn/x86/gmp-mparam.h",
        "@platforms//cpu:mips64": "mpn/mips64/gmp-mparam.h",
        "@platforms//cpu:ppc": "mpn/powerpc32/gmp-mparam.h",
        "@platforms//cpu:ppc32": "mpn/powerpc32/gmp-mparam.h",
        "@platforms//cpu:s390x": "mpn/s390_64/gmp-mparam.h",
        "@platforms//cpu:x86_32": "mpn/x86/gmp-mparam.h",
        "@platforms//cpu:x86_64": "mpn/x86_64/gmp-mparam.h",
        "//conditions:default": "mpn/generic/gmp-mparam.h",
    }),
    out = "gmp-mparam.h",
)

# The generators the build runs (gen-*.c with bootstrap.c and mini-gmp) and
# the tables they write, as the Makefile does.
cc_library(
    name = "_gen_bootstrap",
    textual_hdrs = [
        "bootstrap.c",
        "mini-gmp/mini-gmp.c",
        "mini-gmp/mini-gmp.h",
    ],
)

cc_binary(
    name = "gen-jacobitab",
    srcs = ["gen-jacobitab.c"],
)

cc_binary(
    name = "gen-fac",
    srcs = ["gen-fac.c"],
    deps = [":_gen_bootstrap"],
)

cc_binary(
    name = "gen-fib",
    srcs = ["gen-fib.c"],
    deps = [":_gen_bootstrap"],
)

cc_binary(
    name = "gen-sieve",
    srcs = ["gen-sieve.c"],
    deps = [":_gen_bootstrap"],
)

cc_binary(
    name = "gen-bases",
    srcs = ["gen-bases.c"],
    linkopts = ["-lm"],
    deps = [":_gen_bootstrap"],
)

cc_binary(
    name = "gen-psqr",
    srcs = ["gen-psqr.c"],
    linkopts = ["-lm"],
    deps = [":_gen_bootstrap"],
)

cc_binary(
    name = "gen-trialdivtab",
    srcs = ["gen-trialdivtab.c"],
    linkopts = ["-lm"],
    deps = [":_gen_bootstrap"],
)

gmp_gen(
    name = "gen_fac_table_h",
    out = "fac_table.h",
    args = select({
        ":cpu_32bit": [
            "32",
            "0",
        ],
        "//conditions:default": [
            "64",
            "0",
        ],
    }),
    tool = ":gen-fac",
)

gmp_gen(
    name = "gen_fib_table_h",
    out = "fib_table.h",
    args = select({
        ":cpu_32bit": [
            "header",
            "32",
            "0",
        ],
        "//conditions:default": [
            "header",
            "64",
            "0",
        ],
    }),
    tool = ":gen-fib",
)

gmp_gen(
    name = "gen_fib_table_c",
    out = "fib_table.c",
    args = select({
        ":cpu_32bit": [
            "table",
            "32",
            "0",
        ],
        "//conditions:default": [
            "table",
            "64",
            "0",
        ],
    }),
    tool = ":gen-fib",
)

gmp_gen(
    name = "gen_mp_bases_h",
    out = "mp_bases.h",
    args = select({
        ":cpu_32bit": [
            "header",
            "32",
            "0",
        ],
        "//conditions:default": [
            "header",
            "64",
            "0",
        ],
    }),
    tool = ":gen-bases",
)

gmp_gen(
    name = "gen_mp_bases_c",
    out = "mp_bases.c",
    args = select({
        ":cpu_32bit": [
            "table",
            "32",
            "0",
        ],
        "//conditions:default": [
            "table",
            "64",
            "0",
        ],
    }),
    tool = ":gen-bases",
)

gmp_gen(
    name = "gen_sieve_table_h",
    out = "sieve_table.h",
    args = select({
        ":cpu_32bit": ["32"],
        "//conditions:default": ["64"],
    }),
    tool = ":gen-sieve",
)

gmp_gen(
    name = "gen_perfsqr_h",
    out = "perfsqr.h",
    args = select({
        ":cpu_32bit": [
            "32",
            "0",
        ],
        "//conditions:default": [
            "64",
            "0",
        ],
    }),
    tool = ":gen-psqr",
)

gmp_gen(
    name = "gen_jacobitab_h",
    out = "jacobitab.h",
    tool = ":gen-jacobitab",
)

gmp_gen(
    name = "gen_trialdivtab_h",
    out = "trialdivtab.h",
    args = select({
        ":cpu_32bit": [
            "32",
            "8000",
        ],
        "//conditions:default": [
            "64",
            "8000",
        ],
    }),
    tool = ":gen-trialdivtab",
)

gmp_config_m4(
    name = "config_m4",
    arch = _MPN_ARCH,
    mparam_h = ":gmp_mparam_h",
    os = select({
        "@platforms//os:linux": "linux",
        "@platforms//os:macos": "macos",
        "@platforms//os:windows": "windows",
        "//conditions:default": "linux",
    }),
)

# One target per mpn function: the CPU's assembly through m4, or generic C.
[
    gmp_mpn_m4(
        name = fn,
        arch = _MPN_ARCH,
        asm_srcs = _MPN_ASM_SRCS,
        cpu = ":cpu",
        disable_asm = _DISABLE_ASM,
        generic_srcs = _MPN_GENERIC_SRCS,
        m4_deps = _MPN_M4_DEPS,
        operation = fn,
        os = _MPN_OS,
    )
    for fn in _ALL_MPN_FUNCTIONS
    if fn != "random"
]

# mpn_random, spelled out: its target name replaces the generated alias of the
# rand/ library (whose sources are in :gmp), which a comprehension cannot.
gmp_mpn_m4(
    name = "random",
    arch = _MPN_ARCH,
    asm_srcs = _MPN_ASM_SRCS,
    cpu = ":cpu",
    disable_asm = _DISABLE_ASM,
    generic_srcs = _MPN_GENERIC_SRCS,
    m4_deps = _MPN_M4_DEPS,
    operation = "random",
    os = _MPN_OS,
)

# Internal headers, generated ones included.
cc_library(
    name = "_gmp_hdrs",
    hdrs = [
        "asl.h",
        "gmp-impl.h",
        "longlong.h",
        ":config",
        ":gen_fac_table_h",
        ":gen_fib_table_h",
        ":gen_mp_bases_h",
        ":gen_sieve_table_h",
        ":gmp_h",
        ":gmp_mparam_h",
    ],
    includes = ["."],
    textual_hdrs = [
        ":gen_perfsqr_h",
        ":gen_jacobitab_h",
        ":gen_trialdivtab_h",
    ],
    visibility = ["//tests:__subpackages__"],
)

_GMP_COPTS = [
    "-D__GMP_WITHIN_GMP",
    "-w",
]

# Replaces the generated libraries (see the header comment on the archive).
alias(
    name = "libgmp",
    actual = ":gmp",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "gmp",
    srcs = [
        # Root-level core sources
        "assert.c",
        "compat.c",
        "errno.c",
        "extract-dbl.c",
        "invalid.c",
        "memory.c",
        "mp_bpl.c",
        "mp_clz_tab.c",
        "mp_dv_tab.c",
        "mp_get_fns.c",
        "mp_minv_tab.c",
        "mp_set_fns.c",
        "nextprime.c",
        "primesieve.c",
        "tal-reent.c",
        "version.c",
        # Generated sources
        ":gen_fib_table_c",
        ":gen_mp_bases_c",
    ] + glob(
        [
            "mpz/*.c",
            "mpq/*.c",
            "mpf/*.c",
            "printf/*.c",
            "scanf/*.c",
            "rand/*.c",
        ],
    ) + [
        # MPN function implementations (assembly + generic C). Historically
        # these lived in a separate :_mpn cc_library, but the resulting
        # static-link order produces a circular reference: code in :_mpn
        # references symbols defined in :gmp (e.g. __gmp_init_primesieve,
        # __gmp_nextprime, __gmp_tmp_reentrant_alloc), and a single-pass
        # linker scanning libgmp.a then lib_mpn.a leaves those symbols
        # unresolved. Keep everything in a single cc_library so libgmp.a
        # matches the autotools layout and a single linker pass resolves
        # all internal references.
        ":" + fn
        for fn in _ALL_MPN_FUNCTIONS
    ],
    hdrs = [":gmp_h"],
    conlyopts = C_STD_OPTS,
    copts = _GMP_COPTS,
    includes = ["."],
    linkstatic = True,
    textual_hdrs = glob(["mpn/generic/*.c"]) + [
        "mpn/generic/gmp-mparam.h",
        "mpn/generic/hgcd2-div.h",
        "mpz/aors.h",
        "mpz/aors_ui.h",
        "mpz/fits_s.h",
        "mpz/mul_i.h",
        "mpf/fits_s.h",
        "mpf/fits_u.h",
        "rand/randmt.h",
    ],
    visibility = ["//visibility:public"],
    deps = [":_gmp_hdrs"],
)

alias(
    name = "libgmpxx",
    actual = ":gmpxx",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "gmpxx",
    srcs = glob(
        ["cxx/*.cc"],
        exclude = ["cxx/dummy.cc"],
    ),
    hdrs = ["gmpxx.h"],
    copts = [
        "-D__GMP_WITHIN_GMP",
        "-D__GMP_WITHIN_GMPXX",
        "-w",
    ],
    includes = ["."],
    linkstatic = True,
    visibility = ["//visibility:public"],
    deps = [
        ":_gmp_hdrs",
        ":gmp",
    ],
)

# The conversion's per-directory libraries: their sources are in :gmp.
alias(
    name = "mpn/mpn",
    actual = ":gmp",
    visibility = ["//visibility:public"],
)

alias(
    name = "mpz/mpz",
    actual = ":gmp",
    visibility = ["//visibility:public"],
)

alias(
    name = "mpq/mpq",
    actual = ":gmp",
    visibility = ["//visibility:public"],
)

alias(
    name = "mpf/mpf",
    actual = ":gmp",
    visibility = ["//visibility:public"],
)

alias(
    name = "printf/printf",
    actual = ":gmp",
    visibility = ["//visibility:public"],
)

alias(
    name = "scanf/scanf",
    actual = ":gmp",
    visibility = ["//visibility:public"],
)

alias(
    name = "rand/random",
    actual = ":gmp",
    visibility = ["//visibility:public"],
)

alias(
    name = "cxx/cxx",
    actual = ":gmpxx",
    visibility = ["//visibility:public"],
)
