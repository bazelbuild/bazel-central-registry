load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_package_metadata = [":package_metadata"])

exports_files(
    ["LICENSE.txt"],
    visibility = ["//visibility:private"],
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:Apache-2.0",
    text = "LICENSE.txt",
    visibility = ["//visibility:public"],
)

_APPLE = select({
    "@platforms//os:ios": [],
    "@platforms//os:macos": [],
    "@platforms//os:tvos": [],
    "@platforms//os:visionos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# Header-only C++ wrappers for Foundation, Metal and QuartzCore.
# Exactly one translation unit in the final binary must define
# NS_PRIVATE_IMPLEMENTATION, MTL_PRIVATE_IMPLEMENTATION and
# CA_PRIVATE_IMPLEMENTATION before including the headers.
cc_library(
    name = "metal-cpp",
    hdrs = glob([
        "Foundation/*.hpp",
        "Metal/*.hpp",
        "QuartzCore/*.hpp",
    ]),
    includes = ["."],
    linkopts = [
        "-framework Foundation",
        "-framework Metal",
        "-framework QuartzCore",
    ],
    target_compatible_with = _APPLE,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "metalfx-cpp",
    hdrs = glob(["MetalFX/*.hpp"]),
    includes = ["."],
    linkopts = ["-framework MetalFX"],
    target_compatible_with = _APPLE,
    visibility = ["//visibility:public"],
    deps = [":metal-cpp"],
)
