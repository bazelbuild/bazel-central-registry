load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE.txt"])

_APPLE = select({
    "@platforms//os:ios": [],
    "@platforms//os:macos": [],
    "@platforms//os:tvos": [],
    "@platforms//os:visionos": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# Header-only C++ wrappers for Foundation, Metal and QuartzCore.
# Exactly one translation unit in the final binary must define
# NS_PRIVATE_IMPLEMENTATION, MTL_PRIVATE_IMPLEMENTATION and
# CA_PRIVATE_IMPLEMENTATION before including the headers.
cc_library(
    name = "metal-cpp",
    hdrs = glob([
        "Foundation/*.hpp",
        "Metal/*.hpp",
        "QuartzCore/*.hpp",
    ]),
    includes = ["."],
    linkopts = [
        "-framework Foundation",
        "-framework Metal",
        "-framework QuartzCore",
    ],
    target_compatible_with = _APPLE,
)

cc_library(
    name = "metalfx-cpp",
    hdrs = glob(["MetalFX/*.hpp"]),
    includes = ["."],
    linkopts = ["-framework MetalFX"],
    target_compatible_with = _APPLE,
    deps = [":metal-cpp"],
)
