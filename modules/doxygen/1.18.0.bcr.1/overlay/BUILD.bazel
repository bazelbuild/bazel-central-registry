"""Native Bazel build and execution toolchains for Doxygen."""

load(":native.bzl", "doxygen_native")
load(":toolchain.bzl", "doxygen_toolchain")

exports_files(["toolchain.bzl"])

toolchain_type(
    name = "toolchain_type",
    visibility = ["//visibility:public"],
)

doxygen_native(version = "1.18.0")

doxygen_toolchain(
    name = "source_toolchain_impl",
    executable = ":doxygen",
)

toolchain(
    name = "linux_x86_64_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:x86_64",
        "@platforms//os:linux",
    ],
    toolchain = ":source_toolchain_impl",
    toolchain_type = ":toolchain_type",
)

toolchain(
    name = "linux_arm64_toolchain",
    exec_compatible_with = [
        "@platforms//cpu:aarch64",
        "@platforms//os:linux",
    ],
    toolchain = ":source_toolchain_impl",
    toolchain_type = ":toolchain_type",
)
