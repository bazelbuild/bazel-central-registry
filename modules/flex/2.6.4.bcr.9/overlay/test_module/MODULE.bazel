"""Test module for flex: rules_flex with @flex//:flex as the registered toolchain.
"""

module(name = "flex_test_module")

bazel_dep(name = "flex")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "m4", version = "1.4.21.bcr.7")
bazel_dep(name = "rules_cc", version = "0.2.9")
bazel_dep(name = "rules_flex", version = "0.4.1")
bazel_dep(name = "rules_m4", version = "0.3.bcr.1")

local_path_override(
    module_name = "flex",
    path = "..",
)

register_toolchains(
    "//:flex_toolchain",
    "//:m4_toolchain",
)
