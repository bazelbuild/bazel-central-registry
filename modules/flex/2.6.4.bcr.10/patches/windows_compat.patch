+/** The m4 preamble of the scanner (or, with `header`, of the header file):
+ *  what the tee filter writes ahead of the generated text. */
+static void write_m4_preamble (FILE *out, bool header)
+{
+	fputs (check_4_gnu_m4, out);
+	fputs ("m4_changecom`'m4_dnl\n", out);
+	fputs ("m4_changequote`'m4_dnl\n", out);
+	fputs ("m4_changequote([[,]])[[]]m4_dnl\n", out);
+	fputs ("m4_define([[M4_YY_NOOP]])[[]]m4_dnl\n", out);
+	if (header) {
+		fputs ("m4_define( [[M4_YY_IN_HEADER]],[[]])m4_dnl\n", out);
+		fprintf (out, "#ifndef %sHEADER_H\n", prefix);
+		fprintf (out, "#define %sHEADER_H 1\n", prefix);
+		fprintf (out, "#define %sIN_HEADER 1\n\n", prefix);
+		fprintf (out, "m4_define( [[M4_YY_OUTFILE_NAME]],[[%s]])m4_dnl\n",
+			 headerfilename ? headerfilename : "<stdout>");
+	}
+	else
+		fprintf (out, "m4_define( [[M4_YY_OUTFILE_NAME]],[[%s]])m4_dnl\n",
+			 outfilename ? outfilename : "<stdout>");
+}
+
+/** What the tee filter writes after the generated text of the header file. */
+static void write_header_footer (FILE *out)
+{
+	fprintf (out, "\n");
+
+	/* write a fake line number. It will get fixed by the linedir filter. */
+	if (gen_line_dirs)
+		fprintf (out, "#line 4000 \"M4_YY_OUTFILE_NAME\"\n");
+
+	fprintf (out, "#undef %sIN_HEADER\n", prefix);
+	fprintf (out, "#endif /* %sHEADER_H */\n", prefix);
+	fputs ("m4_undefine( [[M4_YY_IN_HEADER]])m4_dnl\n", out);
+}
