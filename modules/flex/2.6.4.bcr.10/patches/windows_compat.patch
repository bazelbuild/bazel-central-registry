+/* A temporary file that is deleted on close.  tmpfile() wants the drive's
+ * root directory, which an ordinary user cannot write to, and _tempnam()
+ * only picks a name: its counter restarts in every process, so flex
+ * processes running at the same time under one %TEMP% (as Bazel's actions
+ * do) are handed the same name.  Create the file with _O_EXCL so a name
+ * that exists fails, and ask for another one. */
+static FILE *win_tmpfile (void)
+{
+	int tries;
+
+	for (tries = 0; tries < 256; tries++) {
+		char *name = _tempnam (NULL, "flex");
+		int fd;
+
+		if (name == NULL)
+			break;
+		fd = _open (name,
+			    _O_RDWR | _O_CREAT | _O_EXCL | _O_TEMPORARY |
+			    _O_BINARY, _S_IREAD | _S_IWRITE);
+		free (name);
+		if (fd >= 0) {
+			FILE *f = _fdopen (fd, "w+b");
+
+			if (f == NULL)
+				_close (fd);
+			else
+				return f;
+			break;
+		}
+		if (errno != EEXIST && errno != EACCES)
+			break;
+	}
+	flexfatal (_("could not create a temporary file"));
+	return NULL;
+}
+
+static void copy_stream (FILE *in, FILE *out)
+{
+	char buf[4096];
+	size_t n;
+
+	while ((n = fread (buf, 1, sizeof buf, in)) > 0)
+		fwrite (buf, 1, n, out);
+}
+
+/* One m4 pass over the buffered scanner text, into `out`: the preamble
+ * filter_tee_header writes for the scanner or the header, the text, the
+ * header's footer, then m4, then the #line fix-up. */
+static void run_m4_pass (bool header, FILE *out)
+{
+	FILE *m4_in = win_tmpfile ();
+	FILE *m4_out = win_tmpfile ();
+	int saved_in, saved_out, status;
+
+	write_m4_preamble (m4_in, header);
+	rewind (tee_buf);
+	copy_stream (tee_buf, m4_in);
+	if (header)
+		write_header_footer (m4_in);
+	fflush (m4_in);
+	rewind (m4_in);
+
+	fflush (stdout);
+	fflush (stderr);
+	saved_in = dup (0);
+	saved_out = dup (1);
+	if (dup2 (fileno (m4_in), 0) == -1 || dup2 (fileno (m4_out), 1) == -1)
+		flexfatal (_("dup2 failed"));
+	status = (int) _spawnvp (_P_WAIT, tee_m4_argv[0],
+				 (const char *const *) tee_m4_argv);
+	dup2 (saved_in, 0);
+	dup2 (saved_out, 1);
+	close (saved_in);
+	close (saved_out);
+	if (status != 0)
+		lerr_fatal (_("%s exited with status %d"), tee_m4_argv[0], status);
+
+	fflush (m4_out);
+	rewind (m4_out);
+	if (tee_fix_linedirs)
+		fix_linedirs (m4_out, out);
+	else
+		copy_stream (m4_out, out);
+	fclose (m4_in);
+	fclose (m4_out);
+}
+
+/* Finish the output: called once the scanner text is complete, before the
+ * output file is closed.  On a failed run the buffered text is dropped. */
+void filter_finish (int exit_status)
+{
+	if (tee_buf == NULL) {
+		filter_wait_for_children ();
+		return;
+	}
+	if (exit_status != 0) {
+		/* flexend has closed and removed the output file already. */
+		if (tee_saved_stdout != -1)
+			close (tee_saved_stdout);
+		fclose (tee_buf);
+		tee_buf = NULL;
+		return;
+	}
+	if (tee_saved_stdout != -1) {
+		fflush (stdout);
+		dup2 (tee_saved_stdout, fileno (stdout));
+		close (tee_saved_stdout);
+		tee_saved_stdout = -1;
+	}
+	if (tee_m4_argv != NULL) {
+		run_m4_pass (false, stdout);
+		if (tee_header != NULL) {
+			FILE *h = fopen (tee_header, "w");
+
+			if (h == NULL)
+				lerr (_("could not create %s"), tee_header);
+			else {
+				run_m4_pass (true, h);
+				if (ferror (h) || fclose (h))
+					lerr (_("error writing output file %s"),
+					      tee_header);
+			}
+		}
+		fflush (stdout);
+	}
+	fclose (tee_buf);
+	tee_buf = NULL;
+}
