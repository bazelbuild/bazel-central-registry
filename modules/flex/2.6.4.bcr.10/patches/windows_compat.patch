+/* The fork-free output pipeline.  Without fork(), the filter chain cannot
+ * run as child processes, so the generated scanner text is kept in a
+ * temporary file while flex runs; filter_finish() then runs m4 over it, once
+ * for the scanner and once more for the header file (the two copies
+ * filter_tee_header would have fed to two m4 children), and fixes the #line
+ * directives of each result in this process.
+ */
+static FILE        *tee_buf = NULL;          /* the scanner text, before m4 */
+static const char  *tee_header = NULL;       /* --header-file, or NULL */
+static int          tee_saved_stdout = -1;   /* the scanner output stdout pointed at */
+static const char **tee_m4_argv = NULL;      /* the m4 command of the chain */
+static bool         tee_fix_linedirs = false;
+
+static void write_m4_preamble (FILE *out, bool header);
+static void write_header_footer (FILE *out);
+static void fix_linedirs (FILE *in, FILE *out);
