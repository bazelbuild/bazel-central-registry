load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load(":autoconf.bzl", "autoconf_targets")

# The targets of configure.ac and the Makefile.am files, declared by the generated
# autoconf.bzl beside this file; this file is hand-written and kept as it is.  A target
# added below is the module's own; one named like a generated target replaces it at the
# next conversion.
autoconf_targets()

# flex's own scanner. Without the bootstrap (ENABLE_BOOTSTRAP, which would
# need a flex to run) src/Makefile.am takes stage1scan.c from the shipped
# scan.c, rewriting only its #line directives.
copy_file(
    name = "src/stage1scan",
    src = "src/scan.c",
    out = "src/stage1scan.c",
)

# rules_flex's toolchain takes the header by file label.
exports_files(["src/FlexLexer.h"])

# The m4 the flex() rule of flex.bzl runs. Override globally with
# --@flex//:m4=<label>.
label_flag(
    name = "m4",
    build_setting_default = "@m4//:m4",
    visibility = ["//visibility:public"],
)

# FlexLexer.h for C++ scanners, without libfl's objects.
cc_library(
    name = "headers",
    hdrs = ["src/FlexLexer.h"],
    strip_include_prefix = "src",
    visibility = ["//visibility:public"],
)

# Upstream's archive name, as earlier versions of this module spelled it.
alias(
    name = "libfl",
    actual = ":src/fl",
    visibility = ["//visibility:public"],
)
