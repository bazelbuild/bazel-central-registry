load("@bazel_skylib//rules:common_settings.bzl", "string_flag")
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_package_metadata = [":package_metadata"])

_ZCK_VERSION = ".".join(module_version().split(".")[:3])

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:BSD-2-Clause",
    text = "LICENSE",
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

string_flag(
    name = "ssl_lib",
    build_setting_default = "boringssl",
    values = [
        "boringssl",
        "openssl",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "use_boringssl",
    flag_values = {":ssl_lib": "boringssl"},
)

config_setting(
    name = "use_openssl",
    flag_values = {":ssl_lib": "openssl"},
)

expand_template(
    name = "zck_header",
    out = "include/zck.h",
    substitutions = {"@version@": _ZCK_VERSION},
    template = "include/zck.h.in",
)

cc_library(
    name = "zchunk",
    srcs = [
        "src/lib/buzhash/buzhash.c",
        "src/lib/comp/comp.c",
        "src/lib/comp/nocomp/nocomp.c",
        "src/lib/comp/zstd/zstd.c",
        "src/lib/compint.c",
        "src/lib/dl/dl.c",
        "src/lib/dl/multipart.c",
        "src/lib/dl/range.c",
        "src/lib/error.c",
        "src/lib/hash/hash.c",
        "src/lib/hash/openssl/openssl.c",
        "src/lib/header.c",
        "src/lib/index/index_common.c",
        "src/lib/index/index_create.c",
        "src/lib/index/index_read.c",
        "src/lib/io.c",
        "src/lib/log.c",
        "src/lib/zck.c",
    ],
    hdrs = [":zck_header"],
    copts = [
        "-std=gnu11",
        "-fvisibility=hidden",
    ],
    implementation_deps = [
        ":private_headers",
        "@zstd",
    ] + select({
        ":use_boringssl": ["@boringssl//:crypto"],
        ":use_openssl": ["@openssl//:crypto"],
    }),
    local_defines = [
        "ZCHUNK_OPENSSL",
        "ZCHUNK_ZSTD",
    ],
    strip_include_prefix = "include",
    target_compatible_with = select({
        "@platforms//os:linux": [],
        "@platforms//os:macos": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:public"],
)

cc_library(
    name = "private_headers",
    hdrs = [
        "src/lib/buzhash/buzhash.h",
        "src/lib/comp/nocomp/nocomp.h",
        "src/lib/comp/zstd/zstd.h",
        "src/lib/hash/openssl/openssl.h",
        "src/lib/uthash.h",
        "src/lib/zck_private.h",
    ],
    strip_include_prefix = "src/lib",
)

alias(
    name = "zck",
    actual = ":zchunk",
    visibility = ["//visibility:public"],
)
