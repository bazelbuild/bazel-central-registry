/*
 * Hand-written counterpart to the meson-generated config.h-linux and
 * config.h-macos, for the MSVC/UCRT Windows build.
 *
 * The HAVE_* set below is what MSVC with the Universal CRT provides; every
 * POSIX-only entry from the other two (pwd.h, grp.h, unistd.h, poll.h,
 * mmap, fork/spawn, pthreads, xattr, statfs/statvfs, syslog, termios,
 * res_n*, RTLD_*, ...) is deliberately absent rather than stubbed, so glib
 * takes its win32 code paths.
 */

#pragma once

/* NLS is on, backed by glib/stub_libintl -- the BUILD hands every non-Linux
 * target that stub, and it supplies the whole gettext family as identity
 * functions, so the HAVE_*GETTEXT trio below is honest here.
 */
#define ENABLE_NLS 1

#define EXEEXT ".exe"

#define GETTEXT_PACKAGE "glib20"

#define GLIB_BINARY_AGE {GLIB_BINARY_AGE}

#define GLIB_INTERFACE_AGE 2

/* These are compiled-in fallbacks only; on Windows glib resolves its
 * locale and data directories relative to the running module instead (see
 * gwin32.c's g_win32_get_package_installation_directory_of_module).
 */
#define GLIB_LOCALE_DIR "/usr/share/locale"

#define GLIB_LOCALSTATEDIR "/var/local"

#define GLIB_MAJOR_VERSION {GLIB_MAJOR_VERSION}

#define GLIB_MICRO_VERSION {GLIB_MICRO_VERSION}

#define GLIB_MINOR_VERSION {GLIB_MINOR_VERSION}

#define GLIB_RUNSTATEDIR "/run"

/* _aligned_malloc(), not the C11 aligned_alloc(): the latter is absent from
 * the UCRT because its free() cannot release such a block.  gmem.c maps the
 * two (arguments reversed) and routes g_aligned_free() to _aligned_free()
 * when this is set.
 */
#define HAVE__ALIGNED_MALLOC 1

#define HAVE_BIND_TEXTDOMAIN_CODESET 1

/* meson.build hardcodes HAVE_C99_SNPRINTF, HAVE_C99_VSNPRINTF and
 * HAVE_UNIX98_PRINTF to false for MSVC and clang-cl -- "the Visual Studio
 * 2015+ implementations of C99-style snprintf and vsnprintf do not seem to
 * be quite good enough" -- so they are deliberately absent here and glib
 * builds glib/gnulib instead.  Claiming them costs %n$ positional
 * parameters, among other things.
 */

#define HAVE_DCGETTEXT 1

#define HAVE_FLOAT_H 1

#define HAVE_GETTEXT 1

#define HAVE_INTMAX_T 1

#define HAVE_INTTYPES_H 1

#define HAVE_INTTYPES_H_WITH_UINTMAX 1

#define HAVE_IPV6 1

#define HAVE_LIMITS_H 1

#define HAVE_LOCALE_H 1

#define HAVE_LONG_DOUBLE 1

#define HAVE_LONG_LONG 1

/* These three feed glib/gnulib's vasnprintf.c.  Without HAVE_MBRTOWC and
 * HAVE_WCRTOMB it falls back to mblen()/wctomb(), which carry global
 * conversion state instead of a local mbstate_t; HAVE_STRNLEN just
 * selects the CRT strnlen over gnulib's own.  The UCRT has all three.
 */
#define HAVE_MBRTOWC 1

#define HAVE_MEMORY_H 1

#define HAVE_PTRDIFF_T 1

#define HAVE_SIG_ATOMIC_T 1

#define HAVE_SNPRINTF 1

/* Deliberately not HAVE_STDATOMIC_H: MSVC only exposes <stdatomic.h> to C
 * under /std:c11 or later, which is not what this module compiles with, and
 * glib's gatomic.h has a G_PLATFORM_WIN32 branch built on the Interlocked
 * intrinsics that works regardless.
 */

#define HAVE_STDINT_H 1

#define HAVE_STDINT_H_WITH_UINTMAX 1

#define HAVE_STDLIB_H 1

#define HAVE_STRING_H 1

#define HAVE_STRNLEN 1

#define HAVE_SYS_STAT_H 1

#define HAVE_SYS_TYPES_H 1

#define HAVE_VSNPRINTF 1

#define HAVE_WCHAR_H 1

#define HAVE_WCHAR_T 1

#define HAVE_WCRTOMB 1

#define HAVE_WCSLEN 1

#define HAVE_WCSNLEN 1

#define HAVE_WINT_T 1

/* meson.build probes for these three on Windows, and glib-private.h turns
 * them into USE_INVALID_PARAMETER_HANDLER.  Without it
 * g_win32_push_empty_invalid_parameter_handler() compiles to nothing and
 * the UCRT's default handler stays installed, so a bad file descriptor
 * handed to dup2()/_get_osfhandle() calls __fastfail instead of returning
 * -1.  glib checks for -1 everywhere and never expects to die: the spawn
 * helper is killed with 0xC0000409 before it can write its error report,
 * and every g_spawn* call fails with "Failed to read from child pipe".
 * The UCRT provides all three.
 */
#define HAVE__SET_INVALID_PARAMETER_HANDLER 1
#define HAVE__SET_THREAD_LOCAL_INVALID_PARAMETER_HANDLER 1
#define HAVE__CRT_SET_REPORT_MODE 1

/* _stricmp/_strnicmp are the UCRT spellings.  meson.build sets
 * HAVE_STRCASECMP to "1\n#define strcasecmp _stricmp" when the POSIX name
 * is missing, so the alias lands in config.h itself; glib-init.c calls
 * bare strcasecmp and relies on that.
 */
#define HAVE_STRCASECMP 1
#define strcasecmp _stricmp

#define HAVE_STRNCASECMP 1
#define strncasecmp _strnicmp

#define PACKAGE_BUGREPORT "https://gitlab.gnome.org/GNOME/glib/issues/new"

#define PACKAGE_NAME "glib"

#define PACKAGE_STRING "glib {GLIB_VERSION}"

#define PACKAGE_TARNAME "glib"

#define PACKAGE_URL ""

#define PACKAGE_VERSION "{GLIB_VERSION}"

/* MSVC defines none of the __SIZEOF_*__ builtins.  Windows is LLP64: long
 * is 32 bits even on 64-bit targets, and wchar_t is 16 bits.
 */
#define SIZEOF_CHAR 1

#define SIZEOF_INT 4

#define SIZEOF_LONG 4

#define SIZEOF_LONG_LONG 8

#define SIZEOF_SHORT 2

#ifdef _WIN64
#define SIZEOF_SIZE_T 8

#define SIZEOF_SSIZE_T 8

#define SIZEOF_VOID_P 8
#else
#define SIZEOF_SIZE_T 4

#define SIZEOF_SSIZE_T 4

#define SIZEOF_VOID_P 4
#endif

#define SIZEOF_WCHAR_T 2

#define THREADS_WIN32 1

/* Not set: see the note by HAVE_C99_SNPRINTF above.  gnulib supplies
 * vasprintf when the system printf is not used.
 */
#define HAVE_VASPRINTF 1

/* gl_cv_cc_double_expbit0 printed "1/20" when run on x86_64.  The same
 * holds for Windows on arm64: meson skips this probe on ARM only because
 * of the old FPA/VFP word-order ambiguity, and Windows is VFP, i.e.
 * consistently little-endian.
 */
#define DBL_EXPBIT0_WORD 1
#define DBL_EXPBIT0_BIT 20

/* From the gnulib gl_cv_func_printf_* probes, run against MSVC 14.44 and
 * the UCRT.  The ones that pass -- precision, flag_leftadjust, flag_zero,
 * directive_f, directive_ls, infinite -- set no NEED_PRINTF_* macro.
 */
#define NEED_PRINTF_ENOMEM 1
#define NEED_PRINTF_FLAG_GROUPING 1
#define NEED_PRINTF_DIRECTIVE_A 1
#define NEED_PRINTF_DOUBLE 1
#define NEED_PRINTF_LONG_DOUBLE 1

/* glib/meson.build leaves gl_extern_inline empty when the system printf
 * is used, and otherwise fills it from gnulib/gl_extern_inline.  gnulib's
 * gnulib_math.h refuses to compile without _GL_INLINE_HEADER_BEGIN, so the
 * block has to be here rather than the empty placeholder the POSIX
 * configs carry.  Verbatim from gnulib/gl_extern_inline/meson.build.
 */
/* Please see the Gnulib manual for how to use these macros.

   Suppress extern inline with HP-UX cc, as it appears to be broken; see
   <https://lists.gnu.org/r/bug-texinfo/2013-02/msg00030.html>.

   Suppress extern inline with Sun C in standards-conformance mode, as it
   mishandles inline functions that call each other.  E.g., for 'inline void f
   (void) { } inline void g (void) { f (); }', c99 incorrectly complains
   'reference to static identifier "f" in extern inline function'.
   This bug was observed with Sun C 5.12 SunOS_i386 2011/11/16.

   Suppress extern inline (with or without __attribute__ ((__gnu_inline__)))
   on configurations that mistakenly use 'static inline' to implement
   functions or macros in standard C headers like <ctype.h>.  For example,
   if isdigit is mistakenly implemented via a static inline function,
   a program containing an extern inline function that calls isdigit
   may not work since the C standard prohibits extern inline functions
   from calling static functions.  This bug is known to occur on:

     OS X 10.8 and earlier; see:
     https://lists.gnu.org/r/bug-gnulib/2012-12/msg00023.html

     DragonFly; see
     http://muscles.dragonflybsd.org/bulk/bleeding-edge-potential/latest-per-pkg/ah-tty-0.3.12.log

     FreeBSD; see:
     https://lists.gnu.org/r/bug-gnulib/2014-07/msg00104.html

   OS X 10.9 has a macro __header_inline indicating the bug is fixed for C and
   for clang but remains for g++; see <https://trac.macports.org/ticket/41033>.
   Assume DragonFly and FreeBSD will be similar.  */
#if (((defined __APPLE__ && defined __MACH__) \
      || defined __DragonFly__ || defined __FreeBSD__) \
     && (defined __header_inline \
         ? (defined __cplusplus && defined __GNUC_STDC_INLINE__ \
            && ! defined __clang__) \
         : ((! defined _DONT_USE_CTYPE_INLINE_ \
             && (defined __GNUC__ || defined __cplusplus)) \
            || (defined _FORTIFY_SOURCE && 0 < _FORTIFY_SOURCE \
                && defined __GNUC__ && ! defined __cplusplus))))
# define _GL_EXTERN_INLINE_STDHEADER_BUG
#endif
#if ((__GNUC__ \
      ? defined __GNUC_STDC_INLINE__ && __GNUC_STDC_INLINE__ \
      : (199901L <= __STDC_VERSION__ \
         && !defined __HP_cc \
         && !defined __PGI \
         && !(defined __SUNPRO_C && __STDC__))) \
     && !defined _GL_EXTERN_INLINE_STDHEADER_BUG)
# define _GL_INLINE inline
# define _GL_EXTERN_INLINE extern inline
# define _GL_EXTERN_INLINE_IN_USE
#elif (2 < __GNUC__ + (7 <= __GNUC_MINOR__) && !defined __STRICT_ANSI__ \
       && !defined _GL_EXTERN_INLINE_STDHEADER_BUG)
# if defined __GNUC_GNU_INLINE__ && __GNUC_GNU_INLINE__
   /* __gnu_inline__ suppresses a GCC 4.2 diagnostic.  */
#  define _GL_INLINE extern inline __attribute__ ((__gnu_inline__)) __attribute__ ((always_inline))
# else
#  define _GL_INLINE extern inline
# endif
# define _GL_EXTERN_INLINE extern
# define _GL_EXTERN_INLINE_IN_USE
#else
# define _GL_INLINE static _GL_UNUSED
# define _GL_EXTERN_INLINE static _GL_UNUSED
#endif

/* In GCC 4.6 (inclusive) to 5.1 (exclusive),
   suppress bogus "no previous prototype for 'FOO'"
   and "no previous declaration for 'FOO'" diagnostics,
   when FOO is an inline function in the header; see
   <https://gcc.gnu.org/bugzilla/show_bug.cgi?id=54113> and
   <https://gcc.gnu.org/bugzilla/show_bug.cgi?id=63877>.  */
#if __GNUC__ == 4 && 6 <= __GNUC_MINOR__
# if defined __GNUC_STDC_INLINE__ && __GNUC_STDC_INLINE__
#  define _GL_INLINE_HEADER_CONST_PRAGMA
# else
#  define _GL_INLINE_HEADER_CONST_PRAGMA \
     _Pragma ("GCC diagnostic ignored \"-Wsuggest-attribute=const\"")
# endif
# define _GL_INLINE_HEADER_BEGIN \
    _Pragma ("GCC diagnostic push") \
    _Pragma ("GCC diagnostic ignored \"-Wmissing-prototypes\"") \
    _Pragma ("GCC diagnostic ignored \"-Wmissing-declarations\"") \
    _GL_INLINE_HEADER_CONST_PRAGMA
# define _GL_INLINE_HEADER_END \
    _Pragma ("GCC diagnostic pop")
#else
# define _GL_INLINE_HEADER_BEGIN
# define _GL_INLINE_HEADER_END
#endif

/* The gl_unused counterpart to the gl_extern_inline block above, from
 * glib/meson.build.  _GL_INLINE expands to "static _GL_UNUSED" on any
 * compiler that is neither C99-inline nor GCC -- MSVC defines no
 * __STDC_VERSION__ -- so leaving this as an empty placeholder makes
 * every XSIZE_INLINE/_GL_MATH_INLINE declaration a syntax error.
 */
#if __GNUC__ >= 3 || (__GNUC__ == 2 && __GNUC_MINOR__ >= 7)
# define _GL_UNUSED __attribute__ ((__unused__))
#else
# define _GL_UNUSED
#endif
