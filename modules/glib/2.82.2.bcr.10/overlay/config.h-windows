/*
 * Hand-written counterpart to the meson-generated config.h-linux and
 * config.h-macos, for the MSVC/UCRT Windows build.
 *
 * The HAVE_* set below is what MSVC with the Universal CRT provides; every
 * POSIX-only entry from the other two (pwd.h, grp.h, unistd.h, poll.h,
 * mmap, fork/spawn, pthreads, xattr, statfs/statvfs, syslog, termios,
 * res_n*, RTLD_*, ...) is deliberately absent rather than stubbed, so glib
 * takes its win32 code paths.
 */

#pragma once

/* NLS is on, backed by glib/stub_libintl -- the BUILD hands every non-Linux
 * target that stub, and it supplies the whole gettext family as identity
 * functions, so the HAVE_*GETTEXT trio below is honest here.
 */
#define ENABLE_NLS 1

#define EXEEXT ".exe"

#define GETTEXT_PACKAGE "glib20"

#define GLIB_BINARY_AGE {GLIB_BINARY_AGE}

#define GLIB_INTERFACE_AGE 2

/* These are compiled-in fallbacks only; on Windows glib resolves its
 * locale and data directories relative to the running module instead (see
 * gwin32.c's g_win32_get_package_installation_directory_of_module).
 */
#define GLIB_LOCALE_DIR "/usr/share/locale"

#define GLIB_LOCALSTATEDIR "/var/local"

#define GLIB_MAJOR_VERSION {GLIB_MAJOR_VERSION}

#define GLIB_MICRO_VERSION {GLIB_MICRO_VERSION}

#define GLIB_MINOR_VERSION {GLIB_MINOR_VERSION}

#define GLIB_RUNSTATEDIR "/run"

/* _aligned_malloc(), not the C11 aligned_alloc(): the latter is absent from
 * the UCRT because its free() cannot release such a block.  gmem.c maps the
 * two (arguments reversed) and routes g_aligned_free() to _aligned_free()
 * when this is set.
 */
#define HAVE__ALIGNED_MALLOC 1

#define HAVE_BIND_TEXTDOMAIN_CODESET 1

#define HAVE_C99_SNPRINTF 1

#define HAVE_C99_VSNPRINTF 1

#define HAVE_DCGETTEXT 1

#define HAVE_FLOAT_H 1

#define HAVE_GETTEXT 1

#define HAVE_INTMAX_T 1

#define HAVE_INTTYPES_H 1

#define HAVE_INTTYPES_H_WITH_UINTMAX 1

#define HAVE_IPV6 1

#define HAVE_LIMITS_H 1

#define HAVE_LOCALE_H 1

#define HAVE_LONG_DOUBLE 1

#define HAVE_LONG_LONG 1

#define HAVE_MEMORY_H 1

#define HAVE_PTRDIFF_T 1

#define HAVE_SIG_ATOMIC_T 1

#define HAVE_SNPRINTF 1

/* Deliberately not HAVE_STDATOMIC_H: MSVC only exposes <stdatomic.h> to C
 * under /std:c11 or later, which is not what this module compiles with, and
 * glib's gatomic.h has a G_PLATFORM_WIN32 branch built on the Interlocked
 * intrinsics that works regardless.
 */

#define HAVE_STDINT_H 1

#define HAVE_STDINT_H_WITH_UINTMAX 1

#define HAVE_STDLIB_H 1

#define HAVE_STRING_H 1

#define HAVE_SYS_STAT_H 1

#define HAVE_SYS_TYPES_H 1

#define HAVE_VSNPRINTF 1

#define HAVE_WCHAR_H 1

#define HAVE_WCHAR_T 1

#define HAVE_WCSLEN 1

#define HAVE_WCSNLEN 1

#define HAVE_WINT_T 1

/* meson.build probes for these three on Windows, and glib-private.h turns
 * them into USE_INVALID_PARAMETER_HANDLER.  Without it
 * g_win32_push_empty_invalid_parameter_handler() compiles to nothing and
 * the UCRT's default handler stays installed, so a bad file descriptor
 * handed to dup2()/_get_osfhandle() calls __fastfail instead of returning
 * -1.  glib checks for -1 everywhere and never expects to die: the spawn
 * helper is killed with 0xC0000409 before it can write its error report,
 * and every g_spawn* call fails with "Failed to read from child pipe".
 * The UCRT provides all three.
 */
#define HAVE__SET_INVALID_PARAMETER_HANDLER 1
#define HAVE__SET_THREAD_LOCAL_INVALID_PARAMETER_HANDLER 1
#define HAVE__CRT_SET_REPORT_MODE 1

/* _stricmp/_strnicmp are the UCRT spellings.  meson.build sets
 * HAVE_STRCASECMP to "1\n#define strcasecmp _stricmp" when the POSIX name
 * is missing, so the alias lands in config.h itself; glib-init.c calls
 * bare strcasecmp and relies on that.
 */
#define HAVE_STRCASECMP 1
#define strcasecmp _stricmp

#define HAVE_STRNCASECMP 1
#define strncasecmp _strnicmp

#define PACKAGE_BUGREPORT "https://gitlab.gnome.org/GNOME/glib/issues/new"

#define PACKAGE_NAME "glib"

#define PACKAGE_STRING "glib {GLIB_VERSION}"

#define PACKAGE_TARNAME "glib"

#define PACKAGE_URL ""

#define PACKAGE_VERSION "{GLIB_VERSION}"

/* MSVC defines none of the __SIZEOF_*__ builtins.  Windows is LLP64: long
 * is 32 bits even on 64-bit targets, and wchar_t is 16 bits.
 */
#define SIZEOF_CHAR 1

#define SIZEOF_INT 4

#define SIZEOF_LONG 4

#define SIZEOF_LONG_LONG 8

#define SIZEOF_SHORT 2

#ifdef _WIN64
#define SIZEOF_SIZE_T 8

#define SIZEOF_SSIZE_T 8

#define SIZEOF_VOID_P 8
#else
#define SIZEOF_SIZE_T 4

#define SIZEOF_SSIZE_T 4

#define SIZEOF_VOID_P 4
#endif

#define SIZEOF_WCHAR_T 2

#define THREADS_WIN32 1

#define USE_SYSTEM_PRINTF 1

#define gl_extern_inline

#define gl_unused
