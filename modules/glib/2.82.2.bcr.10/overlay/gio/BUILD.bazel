# giowin32-private.c is a textual include (gwin32appinfo.c pulls it in), not
# a separately compiled source, which is why it sits with the headers.
#
# Windows takes INTERNAL_HDRS_UNIX alongside this group: several of those
# headers (gfiledescriptorbased.h, gunixfdmessage.h, gunixmounts.h) are
# consulted by portable sources such as glocalfile.c and gsocket*stream.c,
# not only by the Unix-only ones.  They are textual_hdrs, so the entries
# that go unused on Windows cost nothing.
