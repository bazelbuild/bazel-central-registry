        "//conditions:default": [],
    }) + select({
        "@platforms//os:linux": GIO_UNIX_SRCS + GIO_LINUX_SRCS,
        "@platforms//os:macos": GIO_UNIX_SRCS + GIO_OSX_SRCS,
        "@platforms//os:windows": GIO_WIN32_SRCS + ["gwin32appinfo.c"],
        "//conditions:default": [],
    }) + GIO_APPLICATION_SRCS + GIO_SETTINGS_SRCS + GIO_GDBUS_SRCS + select({
        "@platforms//os:windows": [],
        "//conditions:default": GIO_PORTAL_SRCS,
    }) + GIO_LOCAL_SRCS + PUBLIC_HDRS + select({
        "@platforms//os:macos": PUBLIC_HDRS_OSX,
        "@platforms//os:windows": PUBLIC_HDRS_WIN32,
        "//conditions:default": [],
    }) + select({
        "@platforms//os:linux": glob([
            "inotify/*.c",
            "inotify/*.h",
        ]),
        "@platforms//os:macos": glob([
            "kqueue/*.c",
            "kqueue/*.h",
        ]),
        "//conditions:default": [],
    }) + [
        "gdbus-daemon-generated.c",
        "gdbus-daemon-generated.h",
        "gdbusdaemon.c",
        "gdbusdaemon.h",
        "gioenumtypes.c",
        "gioenumtypes.h",
        "gnetworking.h",
        "xdp-dbus.c",
        "xdp-dbus.h",
        "//subprojects/gvdb",
    ],
    hdrs = [":public_hdr_" + hdr for hdr in (PUBLIC_HDRS + [
               "gioenumtypes.h",
               "gnetworking.h",
           ])] +
           select({
               "@platforms//os:macos": [":public_hdr_" + hdr for hdr in PUBLIC_HDRS_OSX],
               "@platforms//os:windows": [":public_hdr_" + hdr for hdr in PUBLIC_HDRS_WIN32],
               "//conditions:default": [],
           }) + [
        ":gio-visibility_h",
    ],
    copts = [
        "-I" + INCLUDE_PREFIX,
        "-I%s/gio" % (INCLUDE_PREFIX,),
        "-I%s/glib" % (INCLUDE_PREFIX,),
        "-I%s/subprojects/gvdb" % (INCLUDE_PREFIX,),
        "-I$(BINDIR)/%s" % (INCLUDE_PREFIX,),
        "-I$(BINDIR)/%s/gio" % (INCLUDE_PREFIX,),
    ] + MSVC_COPTS,
    implementation_deps = [
        ":gio_internal_textual_hdrs",
        "//:config_h",
        "@zlib",
    ] + select({
        "@platforms//os:linux": [],
        "//conditions:default": ["//glib:stub_intl"],
    }) + select({
        # gio/meson.build builds xdgmime under host_system != 'windows'
        # only.  Its users are gcontenttype-fdo.c, which Windows replaces
        # with gcontenttype-win32.c, and glocalfileinfo.c, which guards the
        # call with !G_OS_WIN32.  xdgmimemagic.h includes <unistd.h>.
        "@platforms//os:windows": [],
        "//conditions:default": ["//gio/xdgmime"],
    }),
    includes = ["include_glib-2.0"],
    linkopts = select({
        "@platforms//os:linux": [
            "-lresolv",
        ],
        "@platforms//os:macos": [
            "-lresolv",
        ],
        # gio/meson.build's win32 platform_deps.  The UWP-only pieces
        # (shcore, runtimeobject) are left out along with the UWP sources.
        "@platforms//os:windows": [
            "-DEFAULTLIB:shlwapi.lib",
            "-DEFAULTLIB:dnsapi.lib",
            "-DEFAULTLIB:iphlpapi.lib",
            "-DEFAULTLIB:ws2_32.lib",
            # Implicit in a Visual Studio project, but not in Bazel's MSVC
            # toolchain.  advapi32: the registry and security-descriptor
            # calls in gregistrysettingsbackend.c/gwin32sid.c.  shell32:
            # SHFileOperationW and the shell-item calls in glocalfile.c and
            # gwin32appinfo.c.  winhttp: the gio/win32 vfs.
            "-DEFAULTLIB:advapi32.lib",
            "-DEFAULTLIB:shell32.lib",
            "-DEFAULTLIB:ole32.lib",
            "-DEFAULTLIB:winhttp.lib",
        ],
        "//conditions:default": [],
    }),
    linkstatic = True,
    local_defines = [
