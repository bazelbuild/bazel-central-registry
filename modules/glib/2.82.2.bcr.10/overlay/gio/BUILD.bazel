UPSTREAM_VERSION = module_version().split(".bcr.", 1)[0]

genrule(
    name = "gio-visibility_h",
    outs = ["include_glib-2.0/gio/gio-visibility.h"],
    cmd = "$(PYTHON3) $(location //tools:gen-visibility-macros.py) " +
          UPSTREAM_VERSION + " visibility-macros GIO $@",
    toolchains = ["@rules_python//python:current_py_toolchain"],
    tools = ["//tools:gen-visibility-macros.py"],
)

[
    mkenums(
        name = "glib_mkenums_for_%s" % out.replace(".", "_"),
        srcs = ["gnetworking.h"] + PUBLIC_HDRS + select({
            "@platforms//os:macos": PUBLIC_HDRS_OSX,
            "@platforms//os:windows": PUBLIC_HDRS_WIN32,
            "//conditions:default": [],
        }),
        out = out,
        template = "%s.template" % out,
    )
    for out in [
        "gioenumtypes.c",
        "gioenumtypes.h",
    ]
]

[expand_template(
    name = "public_hdr_" + hdr,
    out = "include_glib-2.0/gio/" + hdr,
    substitutions = {},
    template = hdr,
) for hdr in (PUBLIC_HDRS + [
    "gioenumtypes.h",
    "gnetworking.h",
] + PUBLIC_HDRS_OSX + PUBLIC_HDRS_WIN32)]

cc_library(
    name = "gio_internal_textual_hdrs",
    textual_hdrs = INTERNAL_HDRS + select({
        "@platforms//os:linux": INTERNAL_HDRS_UNIX + INTERNAL_HDRS_LINUX,
        "@platforms//os:macos": INTERNAL_HDRS_UNIX + INTERNAL_HDRS_OSX,
        "@platforms//os:windows": INTERNAL_HDRS_UNIX + INTERNAL_HDRS_WIN32,
        "//conditions:default": [],
    }) + ["strinfo.c"],
)

REPO_ROOT = package_relative_label(":BUILD.bazel").workspace_root

INCLUDE_PREFIX = REPO_ROOT if REPO_ROOT else "."

objc_library(
    name = "gio_osx_objc",
    srcs = GIO_OSX_OBJC_SRCS,
    copts = [
        "-I" + INCLUDE_PREFIX,
        "-I%s/gio" % (INCLUDE_PREFIX,),
        "-I%s/glib" % (INCLUDE_PREFIX,),
        "-I%s/subprojects/gvdb" % (INCLUDE_PREFIX,),
        "-I$(BINDIR)/%s" % (INCLUDE_PREFIX,),
        "-I$(BINDIR)/%s/gio" % (INCLUDE_PREFIX,),
        "-DG_LOG_DOMAIN='\"GLib-GIO\"'",
        "-DGIO_LAUNCH_DESKTOP='\"gio-launch-desktop-unset\"'",
        "-DGIO_MODULE_DIR='\"/usr/lib/glib/gio/modules\"'",
        "-DLOCALSTATEDIR='\"\"'",
        "-DGIO_COMPILATION",
        "-fno-objc-arc",  # Disable Automatic Reference Counting, as GLib uses manual reference counting
    ] + MSVC_COPTS,
    implementation_deps = [
        ":gio_internal_textual_hdrs",
        "//:config_h",
        "//gio/xdgmime",
        "//glib",
        "//glib:stub_intl",
        "//gmodule",
        "//gobject",
        "@zlib",
    ],
    includes = ["include_glib-2.0"],
    sdk_frameworks = [
        "AppKit",
        "CoreFoundation",
        "CoreServices",
        "Foundation",
    ],
    tags = ["manual"],
    target_compatible_with = ["@platforms//os:macos"],
    textual_hdrs = [
        ":gio-visibility_h",
    ] + [
        ":public_hdr_" + hdr
        for hdr in (PUBLIC_HDRS + [
            "gioenumtypes.h",
            "gnetworking.h",
        ] + PUBLIC_HDRS_OSX)
    ] + PUBLIC_HDRS + [
        "gioenumtypes.h",
        "gnetworking.h",
    ] + PUBLIC_HDRS_OSX,
)

cc_library(
    name = "gio",
    srcs = GIO_BASE_SOURCES + select({
