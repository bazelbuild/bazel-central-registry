# meson.build project-wide adds /utf-8 for MSVC.  Without it cl reads
# these sources in the system ANSI codepage and mangles non-ASCII
# string literals -- glib/tests/unicode.c's normalization data, for one.
#
# Bazel 7's MSVC toolchain also passes /DCOMPILER_MSVC by default, which
# collides with the CompilerType enum in gio/glib-compile-resources.c.
# Bazel 8 dropped it; glib reads _MSC_VER, never this, so drop it too.
MSVC_COPTS = select({
    "@platforms//os:windows": [
        "/utf-8",
        "/UCOMPILER_MSVC",
    ],
    "//conditions:default": [],
})

expand_template(
    name = "gnetworking_h_in",
    out = "gnetworking.h",
    substitutions = select({
        "@platforms//os:macos": {"@NAMESER_COMPAT_INCLUDE@": "#include <arpa/nameser_compat.h>"},
        "//conditions:default": {"@NAMESER_COMPAT_INCLUDE@": ""},
    }),
    template = "gnetworking.h.in",
)

[
    genrule(
        name = "gdbus_codegen_for_%s" % target.replace("-", "_"),
        srcs = srcs,
        outs = [
            "%s.c" % target,
            "%s.h" % target,
        ],
        # Run the py_binary directly rather than through $(PYTHON3): on
        # Windows its executable is a native launcher, not a script an
        # interpreter can read.
        cmd = ("$(location //gio/gdbus-2.0/codegen:gdbus_codegen) --interface-prefix {prefix} " +
               "--output-directory $$(dirname $(location {target}.c)) " +
               "--generate-c-code {target} --c-namespace {namespace} {srcs}").format(
            srcs = " ".join(["$(location %s)" % s for s in srcs]),
            namespace = namespace,
            prefix = prefix,
            target = target,
        ),
        tools = ["//gio/gdbus-2.0/codegen:gdbus_codegen"],
    )
    for prefix, target, namespace, srcs in [
        [
            "org.freedesktop.portal.",
            "xdp-dbus",
            "GXdp",
            glob(["org.freedesktop.portal.*.xml"]),
        ],
        [
            "org.",
            "gdbus-daemon-generated",
            "_G",
            ["dbus-daemon.xml"],
        ],
    ]
]

