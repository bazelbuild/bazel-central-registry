        "LOCALSTATEDIR='\"\"'",
        "GIO_COMPILATION",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//glib",
        "//gmodule",
        "//gobject",
    ] + select({
        "@platforms//os:macos": [":gio_osx_objc"],
        "//conditions:default": [],
    }),
)

