load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

cc_library(
    name = "boost.random",
    srcs = ["src/random_device.cpp"],
    hdrs = glob(
        [
            "include/**/*.hpp",
            "include/**/*.ipp",
        ],
        exclude = ["include/boost/random/detail/mixmax_skip_N17.ipp"],
    ),
    # random_device.cpp is compiled into this target, so there is no separate
    # boost_random library for MSVC to auto-link. BOOST_ALL_NO_LIB is not used
    # because it would also disable the auto-link of Advapi32 that
    # random_device.cpp needs on Windows.
    defines = ["BOOST_RANDOM_NO_LIB"],
    features = [
        "parse_headers",
    ],
    includes = ["include"],
    textual_hdrs = [
        "include/boost/random/detail/mixmax_skip_N17.ipp",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "@boost.assert",
        "@boost.config",
        "@boost.core",
        "@boost.dynamic_bitset",
        "@boost.integer",
        "@boost.io",
        "@boost.static_assert",
        "@boost.system",
        "@boost.throw_exception",
        "@boost.type_traits",
        "@boost.utility",
    ],
)

cc_test(
    name = "random_device_test",
    srcs = ["bcr_random_device_test.cc"],
    deps = [":boost.random"],
)
