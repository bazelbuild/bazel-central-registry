# buildifier: disable=unnamed-macro
def autoconf_targets():
    """The targets configure.ac and the Makefile.am files describe, in the package that calls this."""

    native.exports_files(["COPYING"])

    license(
        name = "license_COPYING",
        kind = "@package_metadata//licenses/spdx:GPL-3.0-or-later",
        text = "COPYING",
        visibility = ["//visibility:private"],
    )

    package_metadata(
        name = "package_metadata",
        attributes = [":license_COPYING"],
        purl = purl.bazel(
            native.module_name(),
            native.module_version(),
        ),
        visibility = ["//visibility:private"],
    )

    autoconf_package_info(
        name = "package",
        package_name = "GNU coreutils",
        aliases = {
            "PACKAGE": "PACKAGE_TARNAME",
            "VERSION": "PACKAGE_VERSION",
        },
        module_bazel = "//:MODULE.bazel",
        package_bugreport = "bug-coreutils@gnu.org",
        package_tarname = "coreutils",
        package_url = "https://www.gnu.org/software/coreutils/",
        strip_bcr_version = True,
        visibility = ["//visibility:private"],
    )

    for name, default in BOOL_OPTIONS.items():
        bool_flag(
            name = name,
            build_setting_default = default,
            visibility = ["//visibility:public"],
        )

    for name in BOOL_OPTIONS:
        native.config_setting(
            name = name + "_enabled",
            flag_values = {":" + name: "True"},
            visibility = ["//visibility:private"],
        )

    string_flag(
        name = "libcap",
        build_setting_default = "yes",
        values = [
            "Xno",
            "Xyes",
            "no",
            "yes",
        ],
        visibility = ["//visibility:public"],
    )

    native.config_setting(
        name = "libcap_Xno",
        flag_values = {
            ":libcap": "Xno",
        },
        visibility = ["//visibility:private"],
    )

    native.config_setting(
        name = "libcap_Xyes",
        flag_values = {
            ":libcap": "Xyes",
        },
        visibility = ["//visibility:private"],
    )

    native.config_setting(
        name = "libcap_enabled",
        flag_values = {
            ":libcap": "yes",
        },
        visibility = ["//visibility:private"],
    )

    string_flag(
        name = "libsmack",
        build_setting_default = "yes",
        values = [
            "Xno",
            "Xyes",
            "no",
            "yes",
        ],
        visibility = ["//visibility:public"],
    )

    native.config_setting(
        name = "libsmack_Xno",
        flag_values = {
            ":libsmack": "Xno",
        },
        visibility = ["//visibility:private"],
    )

    native.config_setting(
        name = "libsmack_Xyes",
        flag_values = {
            ":libsmack": "Xyes",
        },
        visibility = ["//visibility:private"],
    )

    native.config_setting(
        name = "libsmack_enabled",
        flag_values = {
            ":libsmack": "yes",
