    "src_condition:GL_COND_OBJ_ASNPRINTF": decision.ALWAYS,

    # ---- src_condition: GL_COND_OBJ_ASPRINTF
    # where: gnulib.mk
    # why:   asprintf.c is an EXTRA source compiled by AC_LIBOBJ inside the ported macro of module vasprintf; neither the port nor gnulib's replacement rule says when
    # module: vasprintf
    # Compiled unconditionally: a *conditional* answer here is dropped by the converter (the
    # conditional-sources rule is rendered before port-internal AC_LIBOBJ sources are decided;
    # rules_cc_autoconf tools/convert/bugs/2026-10-26-extra-libobj-source-dropped.md), and macOS
    # then fails to link rpl_asprintf.  The file defines asprintf (or rpl_asprintf where
    # REPLACE_VASPRINTF=1) on top of vasprintf, so an extra copy is harmless where libc has one.
    "src_condition:GL_COND_OBJ_ASPRINTF": decision.ALWAYS,

