    "src_condition:!GL_HAVE_STDBIT_H": "!ac_cv_header_stdbit_h",

    # ---- src_condition: GL_COND_OBJ_ARGZ (hand-added)
    # gnulib: gl_CONDITIONAL([GL_COND_OBJ_ARGZ], [test -n "$ARGZ_H"]), i.e. GL_GENERATE_ARGZ_H, which
    # argz.m4 sets when argz_replace is missing.  The rules' argz port carries GL_GENERATE_ARGZ_H
    # as a config.h define ("1"), not the "true"/"false" subst the derived `GL_GENERATE_ARGZ_H==true`
    # expects, so that condition never holds and macOS (no argz at all) fails to link argz_*.
    "src_condition:GL_COND_OBJ_ARGZ": "!ac_cv_func_argz_replace",

