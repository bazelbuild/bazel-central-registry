load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "kernel_headers",
    hdrs = glob(["include/linux-private/**/*.h"]),
    includes = ["include/linux-private"],
)

alias(
    name = "libnl",
    actual = ":nl",
    visibility = ["//visibility:public"],
)

cc_library(
    name = "nl",
    srcs = glob(["lib/*.c"]) + ["lib/defs.h"],
    hdrs = glob([
        "include/netlink/**/*.h",
        "include/netlink-private/**/*.h",
    ]),
    implementation_deps = [":kernel_headers"],
    includes = [
        "include",
        "lib",
    ],
    linkopts = ["-pthread"],
    local_defines = [
        "_GNU_SOURCE",
        'SYSCONFDIR=\\"/etc/libnl\\"',
    ],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
)

cc_library(
    name = "genl",
    srcs = glob(["lib/genl/*.c"]) + ["lib/defs.h"],
    implementation_deps = [":kernel_headers"],
    local_defines = [
        "_GNU_SOURCE",
        'SYSCONFDIR=\\"/etc/libnl\\"',
    ],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = [":nl"],
)
