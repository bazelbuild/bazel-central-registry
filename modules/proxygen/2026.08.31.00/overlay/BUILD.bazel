        "proxygen/lib/http/coro/filters/test/StatsFilter*",
        # Shared fixture compiled into :proxygen_test_lib, not a test binary.
        "proxygen/lib/http/coro/test/HTTPCoroSessionTests.cpp",
        # This does not compile. It seems like an internal facebook file that escaped.
        "proxygen/lib/http/sink/test/HTTPConnectSinkTest.cpp",
        # This test is ignored by the CMakeLists.txt.
        "proxygen/lib/utils/test/URLTest.cpp",
        # The following 2 tests have their own separate cc_test below because they have to be linked
        # together in order to work.
        "proxygen/lib/http/codec/test/HTTP2CodecTest.cpp",
        "proxygen/lib/http/codec/test/HTTP2FramerTest.cpp",
        # TODO(kgk): Fix below tests.
        "proxygen/lib/utils/test/ParseURLTest.cpp",
        # Corrupts the heap when built with GCC 11 (as shipped on Ubuntu
        # 22.04). HTTPTransactionAdaptorSourceTests.IngressFlow aborts inside
        # a folly::coro::blocking_wait:
        #
        #   munmap_chunk(): invalid pointer
        #   *** Aborted ... Signal 6 (SIGABRT) ...
        #
        # glibc is rejecting a free() of a pointer that never came from the
        # heap, i.e. GCC 11 mismanages the coroutine frame it allocated. It
        # reproduces identically on x86-64 and aarch64, so it is the compiler
        # rather than target codegen, and the build is already unoptimised, so
        # no copt avoids it. GCC 13 and GCC 15 run the file cleanly.
        "proxygen/lib/http/coro/test/HTTPTransactionAdaptorSourceTest.cpp",
        # Crashes GCC 13 (as shipped on Ubuntu 24.04) with an internal compiler
        # error, so the test binary cannot be built at all:
        #
        #   HTTPConnectTransportTest.cpp:195:3: internal compiler error:
        #     in build_special_member_call, at cp/call.cc:11096
        #
        # The trigger is HTTPConnectTransportTest::connect(), a coroutine whose
        # only parameter has a default argument. GCC has to synthesise the copy
        # of that parameter into the coroutine frame, and it aborts building
        # that constructor call. It is a compiler bug, not invalid code -- the
        # file compiles with GCC 15 and the tests in it pass there. Splitting
        # the default argument into a second, non-coroutine overload does avoid
        # it, but that is a patch against upstream test code to work around a
        # toolchain defect, so the file is simply left out of the build until
        # the presubmit platforms carry a fixed GCC.
        "proxygen/lib/http/coro/transport/test/HTTPConnectTransportTest.cpp",
        # The checked-in test certificates are SHA-1 signed, which OpenSSL 3
        # rejects as "ca md too weak"; the test server then never comes up.
        "proxygen/lib/http/coro/client/test/HTTPClientTests.cpp",
        "proxygen/lib/http/coro/client/test/HTTPConnectIntegrationTest.cpp",
        # Needs proxygen/httpserver/tests/HTTPServerTestUtils.h, which is not
        # part of any published target.
        "proxygen/lib/http/coro/server/test/HTTPServerTest.cpp",
    ],
)]

