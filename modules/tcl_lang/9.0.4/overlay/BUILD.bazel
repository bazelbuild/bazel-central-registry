        ":tclConfig",
        ":tclUuid",
    ] + select({
        "@platforms//os:windows": [],
        "//conditions:default": ["unix/tclUnixNotfy.c"],
    }) + select({
        # tclInt.h includes tclDTrace.h under `#ifdef USE_DTRACE`.
        ":dtrace_on_unix": [":gen_tclDTrace_h"],
        "//conditions:default": [],
    }),
)

cc_library(
    name = "cc_all_headers",
    hdrs = [":all_headers"],
    includes = select({
        "@platforms//os:macos": ["macosx"],
        "@platforms//os:windows": ["windows"],
