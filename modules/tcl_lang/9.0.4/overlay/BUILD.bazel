filegroup(
    name = "all_headers",
    srcs = glob(
        include = ["**/*.h"],
        exclude = [
            "bazel-*/**",
            ".git/**",
        ],
    ) + [
        "generic/regc_color.c",
        "generic/regc_cvec.c",
        "generic/regc_lex.c",
