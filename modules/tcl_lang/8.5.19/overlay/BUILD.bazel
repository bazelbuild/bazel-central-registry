load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load(
    "@rules_cc_autoconf//autoconf:defs.bzl",
    "autoconf",
    "autoconf_hdr",
    "checks",
    "macros",
    "package_info",
)

licenses(["notice"])

exports_files(["license.terms"])

# 8.5 pre-dates most 8.6/9.0 switches; only flags that gate 8.5 are exposed.
bool_flag(
    name = "enable_dll_unloading",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "enable_langinfo",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

bool_flag(
    name = "enable_threads",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "dll_unloading_enabled",
    flag_values = {":enable_dll_unloading": "True"},
)

config_setting(
    name = "langinfo_enabled",
    flag_values = {":enable_langinfo": "True"},
)

config_setting(
    name = "threads_enabled",
    flag_values = {":enable_threads": "True"},
)

selects.config_setting_group(
    name = "unix_target",
    match_any = [
        "@platforms//os:linux",
        "@platforms//os:macos",
    ],
)

selects.config_setting_group(
    name = "threads_on_unix",
    match_all = [
        ":threads_enabled",
        ":unix_target",
    ],
)

autoconf(
    name = "tclConfig_checks",
    checks = macros.AC_CHECK_HEADERS([
        "AvailabilityMacros.h",
        "dirent.h",
        "dlfcn.h",
        "float.h",
        "inttypes.h",
        "langinfo.h",
        "libkern/OSAtomic.h",
        "limits.h",
        "memory.h",
        "net/errno.h",
        "stdint.h",
        "stdlib.h",
        "string.h",
        "strings.h",
        "sys/filio.h",
        "sys/ioctl.h",
        "sys/modem.h",
        "sys/param.h",
        "sys/select.h",
        "sys/stat.h",
        "sys/time.h",
        "sys/types.h",
        "sys/wait.h",
        "termios.h",
        "unistd.h",
        "values.h",
    ]) + macros.AC_CHECK_FUNCS([
        # NOTE: gethostbyaddr_r / gethostbyname_r / getpw*_r / getgr*_r
        # are probed by the AC_TRY_LINK checks further down (per-argc
        # variants). Do NOT list them here or the auto-generated
        # HAVE_* define collides with the AC_DEFINE we emit for the
        # canonical HAVE_GETHOSTBYNAME_R name.
        "chflags",
        "copyfile",
        "getattrlist",
        "getcwd",
        "gmtime_r",
        "localtime_r",
        "mktime",
        "opendir",
        "OSSpinLockLock",
        "pthread_attr_setstacksize",
        "strtol",
        "vfork",
        "waitpid",
    ]) + macros.AC_CHECK_TYPES(
        [
            "blkcnt_t",
            "intptr_t",
            "uintptr_t",
        ],
        includes = [
            "#include <stdint.h>",
            "#include <sys/stat.h>",
            "#include <sys/types.h>",
        ],
    ) + macros.AC_CHECK_MEMBERS(
        [
            "struct stat.st_blksize",
            "struct stat.st_blocks",
            "struct tm.tm_gmtoff",
        ],
        includes = [
            "#include <sys/stat.h>",
            "#include <time.h>",
        ],
    ) + [
        checks.AC_DEFINE(
            "NO_FORK",
            condition = "!ac_cv_func_fork",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_CHECK_FUNC("fork"),
        checks.AC_DEFINE(
            "NO_FSTATFS",
            condition = "!ac_cv_func_fstatfs",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_CHECK_FUNC("fstatfs"),
        checks.AC_DEFINE(
            "NO_GETTOD",
            condition = "!ac_cv_func_gettimeofday",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_CHECK_FUNC("gettimeofday"),
        checks.AC_DEFINE(
            "NO_GETWD",
            condition = "!ac_cv_func_getwd",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_CHECK_FUNC("getwd"),
        checks.AC_DEFINE(
            "NO_REALPATH",
            condition = "!ac_cv_func_realpath",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_CHECK_FUNC("realpath"),
        checks.AC_DEFINE(
            "NO_STRERROR",
            condition = "!ac_cv_func_strerror",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_CHECK_FUNC("strerror"),
        checks.AC_DEFINE(
            "NO_UNAME",
            condition = "!ac_cv_func_uname",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_CHECK_FUNC("uname"),
        checks.AC_DEFINE(
            "USEGETWD",
            condition = "!ac_cv_func_getcwd",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_TRY_COMPILE(
            code = "int main(void){signed char *p; p = 0; return p != 0;}",
            define = "HAVE_SIGNED_CHAR",
        ),
        checks.AC_TRY_COMPILE(
            code = """\
extern int foo(void) __attribute__((visibility("hidden")));
int foo(void){return 0;}
int main(void){return foo();}
""",
            define = "HAVE_HIDDEN",
        ),
        checks.AC_TRY_COMPILE(
            code = """\
union u { int i; long l; };
int main(void){int x = 42; union u v = (union u)x; return v.i;}
""",
            define = "HAVE_CAST_TO_UNION",
        ),
        checks.AC_TRY_LINK(
            code = """\
#include <langinfo.h>
int main(void){char *cs = nl_langinfo(CODESET); return cs ? 0 : 0;}
""",
            define = "HAVE_LANGINFO",
        ),
        # tclUnixPort.h picks WAIT_STATUS_TYPE off union wait; tclPipe.c fails
        # to compile without it, so probe and set NO_UNION_WAIT when missing.
        checks.AC_TRY_LINK(
            code = """\
#include <sys/types.h>
#include <sys/wait.h>
int main(void){
    union wait x;
    WIFEXITED(x);
    return 0;
}
""",
            define = "HAVE_UNION_WAIT",
        ),
        checks.AC_DEFINE(
            "NO_UNION_WAIT",
            condition = "!ac_cv_try_link_HAVE_UNION_WAIT",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_TRY_LINK(
            code = """\
#include <time.h>
extern long timezone;
int main(void){return (int)timezone;}
""",
            define = "HAVE_TIMEZONE_VAR",
        ),
        checks.AC_TRY_LINK(
            code = """\
#include <netdb.h>
int main(void){
    struct hostent he, *result;
    char buf[1024];
    int h_err;
    return gethostbyname_r("x", &he, buf, sizeof buf, &result, &h_err);
}
""",
            define = "HAVE_GETHOSTBYNAME_R_6",
        ),
        checks.AC_DEFINE(
            "HAVE_GETHOSTBYNAME_R",
            condition = "ac_cv_try_link_HAVE_GETHOSTBYNAME_R_6",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_TRY_LINK(
            code = """\
#include <netdb.h>
#include <netinet/in.h>
int main(void){
    struct hostent he, *result;
    char buf[1024];
    int h_err;
    struct in_addr addr;
    return gethostbyaddr_r((char*)&addr, sizeof addr, AF_INET, &he, buf,
                           sizeof buf, &result, &h_err);
}
""",
            define = "HAVE_GETHOSTBYADDR_R_8",
        ),
        checks.AC_DEFINE(
            "HAVE_GETHOSTBYADDR_R",
            condition = "ac_cv_try_link_HAVE_GETHOSTBYADDR_R_8",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_TRY_LINK(
            code = """\
#include <pwd.h>
int main(void){
    struct passwd pw, *result;
    char buf[1024];
    return getpwuid_r(0, &pw, buf, sizeof buf, &result);
}
""",
            define = "HAVE_GETPWUID_R_5",
        ),
        checks.AC_DEFINE(
            "HAVE_GETPWUID_R",
            condition = "ac_cv_try_link_HAVE_GETPWUID_R_5",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_TRY_LINK(
            code = """\
#include <pwd.h>
int main(void){
    struct passwd pw, *result;
    char buf[1024];
    return getpwnam_r("x", &pw, buf, sizeof buf, &result);
}
""",
            define = "HAVE_GETPWNAM_R_5",
        ),
        checks.AC_DEFINE(
            "HAVE_GETPWNAM_R",
            condition = "ac_cv_try_link_HAVE_GETPWNAM_R_5",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_TRY_LINK(
            code = """\
#include <grp.h>
int main(void){
    struct group gr, *result;
    char buf[1024];
    return getgrgid_r(0, &gr, buf, sizeof buf, &result);
}
""",
            define = "HAVE_GETGRGID_R_5",
        ),
        checks.AC_DEFINE(
            "HAVE_GETGRGID_R",
            condition = "ac_cv_try_link_HAVE_GETGRGID_R_5",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_TRY_LINK(
            code = """\
#include <grp.h>
int main(void){
    struct group gr, *result;
    char buf[1024];
    return getgrnam_r("x", &gr, buf, sizeof buf, &result);
}
""",
            define = "HAVE_GETGRNAM_R_5",
        ),
        checks.AC_DEFINE(
            "HAVE_GETGRNAM_R",
            condition = "ac_cv_try_link_HAVE_GETGRNAM_R_5",
            if_false = None,
            if_true = 1,
        ),
        checks.AC_DEFINE("MP_PREC", 4),
        checks.AC_DEFINE("NDEBUG", 1),
        checks.AC_DEFINE("STDC_HEADERS", 1),
        checks.AC_DEFINE("TCL_CFG_OPTIMIZED", 1),
        checks.AC_DEFINE("TCL_CFGVAL_ENCODING", "\"iso8859-1\""),
        checks.AC_DEFINE("TCL_DEFAULT_ENCODING", "\"iso8859-1\""),
        checks.AC_DEFINE("TCL_SHLIB_EXT", "\".so\""),
        checks.AC_DEFINE("TCL_WIDE_INT_IS_LONG", 1),
        checks.AC_DEFINE("_LARGEFILE64_SOURCE", 1),
        checks.AC_DEFINE("_REENTRANT", 1),
        checks.AC_DEFINE("_THREAD_SAFE", 1),
        checks.AC_DEFINE("__CHAR_UNSIGNED__", 1),
        checks.AC_DEFINE_UNQUOTED(
            "MODULE_SCOPE",
            "extern __attribute__((__visibility__(\"hidden\")))",
        ),
    ],
    visibility = ["//visibility:private"],
    deps = [":package_info"],
)

package_info(
    name = "package_info",
    # AC_INIT([tcl],[8.5]) uses the short 8.5 identity.
    package_name = "tcl",
    module_bazel = "MODULE.bazel",
    package_tarname = "tcl",
    package_version = "8.5",
)

autoconf(
    name = "tclConfig_checks_macos",
    checks = [
        checks.AC_DEFINE("MAC_OSX_TCL", 1),
        checks.AC_DEFINE("TCL_LOAD_FROM_MEMORY", 1),
        checks.AC_DEFINE("TCL_WIDE_CLICKS", 1),
        checks.AC_DEFINE("HAVE_COREFOUNDATION", 1),
        checks.AC_DEFINE("_DARWIN_C_SOURCE", 1),
    ],
    visibility = ["//visibility:private"],
)

autoconf_hdr(
    name = "gen_tclConfig_unix_h",
    out = "unix/tclConfig.h",
    template = "unix/tclConfig.h.in",
    deps = [":tclConfig_checks"],
)

autoconf_hdr(
    name = "gen_tclConfig_macos_h",
    out = "macosx/tclConfig.h",
    template = "unix/tclConfig.h.in",
    deps = [
        ":tclConfig_checks",
        ":tclConfig_checks_macos",
    ],
)

write_file(
    name = "gen_tclConfig_windows_h",
    out = "windows/tclConfig.h",
    content = [
        "#ifndef _TCLCONFIG",
        "#define _TCLCONFIG",
        "#endif",
    ],
    newline = "unix",
)

COMMON_COPTS = select({
    "@rules_cc//cc/compiler:clang-cl": ["/w"],
    "@rules_cc//cc/compiler:msvc-cl": ["/w"],
    "//conditions:default": ["-w"],
}) + select({
    # Cancel the autoconf-probed HAVE_LANGINFO when the flag is off.
    ":langinfo_enabled": [],
    "//conditions:default": ["-UHAVE_LANGINFO"],
})

FLAG_DEFINES = select({
    ":dll_unloading_enabled": ["TCL_UNLOAD_DLLS=1"],
    "//conditions:default": [],
}) + select({
    ":threads_enabled": [
        "TCL_THREADS=1",
        "USE_THREAD_ALLOC=1",
    ],
    "//conditions:default": [],
})

COMMON_DEFINES = [
    "CFG_RUNTIME_DLLFILE=\\\"\"Tcl\\\"\"",
    "HAVE_TCL_CONFIG_H=1",
    "TCL_LIBRARY=\\\"\"\\\"\"",
    "TCL_PACKAGE_PATH=\\\"\"\\\"\"",
] + select({
    "@platforms//os:windows": [],
    "//conditions:default": ["_GNU_SOURCE=1"],
}) + select({
    # macOS ships glibc-shape 5-arg reentrant lookups + MT-safe gethostby*
    # unconditionally; hardcode them so tclUnixCompat.c does not fall into
    # its non-reentrant fallback that references CopyPwd / CopyGrp which
    # aren't declared in that configuration.  Real tcl configure sets the
    # MTSAFE_* ones explicitly on Darwin.
    "@platforms//os:macos": [
        "HAVE_GETPWUID_R=1",
        "HAVE_GETPWUID_R_5=1",
        "HAVE_GETPWNAM_R=1",
        "HAVE_GETPWNAM_R_5=1",
        "HAVE_GETGRGID_R=1",
        "HAVE_GETGRGID_R_5=1",
        "HAVE_GETGRNAM_R=1",
        "HAVE_GETGRNAM_R_5=1",
        "HAVE_MTSAFE_GETHOSTBYNAME=1",
        "HAVE_MTSAFE_GETHOSTBYADDR=1",
    ],
    "//conditions:default": [],
}) + FLAG_DEFINES

TCL_DEFINES = COMMON_DEFINES + [
    "CFG_RUNTIME_BINDIR=\\\"\"/usr/local/bin\\\"\"",
    "CFG_RUNTIME_DOCDIR=\\\"\"/usr/local/man\\\"\"",
    "CFG_RUNTIME_INCDIR=\\\"\"\\\"\"",
    "CFG_RUNTIME_LIBDIR=\\\"\"\\\"\"",
    "CFG_RUNTIME_SCRDIR=\\\"\"\\\"\"",
    "CFG_INSTALL_BINDIR=\\\"\"\\\"\"",
    "CFG_INSTALL_DOCDIR=\\\"\"\\\"\"",
    "CFG_INSTALL_INCDIR=\\\"\"\\\"\"",
    "CFG_INSTALL_LIBDIR=\\\"\"\\\"\"",
    "CFG_INSTALL_SCRDIR=\\\"\"\\\"\"",
]

filegroup(
    name = "tclConfig",
    srcs = select({
        "@platforms//os:macos": [":gen_tclConfig_macos_h"],
        "@platforms//os:windows": [":gen_tclConfig_windows_h"],
        "//conditions:default": [":gen_tclConfig_unix_h"],
    }),
)

filegroup(
    name = "tclAppInit",
    srcs = select({
        "@platforms//os:windows": ["windows/tclAppInit.c"],
        "//conditions:default": ["unix/tclAppInit.c"],
    }),
)

filegroup(
    name = "all_headers",
    srcs = glob(
        include = ["**/*.h"],
        exclude = [
            "bazel-*/**",
            ".git/**",
        ],
    ) + [
        "generic/regc_color.c",
        "generic/regc_cvec.c",
        "generic/regc_lex.c",
        "generic/regc_locale.c",
        "generic/regc_nfa.c",
