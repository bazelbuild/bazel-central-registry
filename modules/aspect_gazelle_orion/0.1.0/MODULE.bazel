module(
    name = "aspect_gazelle_orion",
    version = "0.1.0",
    compatibility_level = 0,
)

bazel_dep(name = "aspect_tools_telemetry", version = "0.5.2")
bazel_dep(name = "aspect_go_treesitter_grammars", version = "0.1.0")
bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.54.0")  # must match go.mod

# Go modules
go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")
use_repo(go_deps, "com_github_aspect_build_aspect_gazelle_common", "com_github_bazelbuild_buildtools", "com_github_emirpasic_gods_v2", "com_github_goexlib_jsonc", "com_github_itchyny_gojq", "com_github_mikefarah_yq_v4", "net_starlark_go", "org_golang_x_sync")

tel = use_extension("@aspect_tools_telemetry//:extension.bzl", "telemetry")
use_repo(tel, "aspect_tools_telemetry_report")

####### Dev dependencies ########

# Go module patching. Dev only and must be done manually if this MODULE is consumed elsewhere.
go_deps_dev = use_extension("@gazelle//:extensions.bzl", "go_deps", dev_dependency = True)
go_deps_dev.module_override(
    patch_strip = 1,
    patches = ["@aspect_go_treesitter_grammars//patches:go-tree-sitter-abi15.patch"],
    path = "github.com/smacker/go-tree-sitter",
)

# Provides a real external-repository .bzl file for //starlark:starlark_test.
bazel_dep(name = "bazel_skylib", version = "1.7.1", dev_dependency = True)

# An external repository publishing orion plugins, for //tests/external.
bazel_dep(name = "orion_test_plugins", version = "0.0.0", dev_dependency = True)
local_path_override(
    module_name = "orion_test_plugins",
    path = "tests/external/repo",
)

# The repo root module, used only for the shared @aspect_gazelle//tools/nogo.
bazel_dep(name = "aspect_gazelle", version = "0.0.0", dev_dependency = True)
local_path_override(
    module_name = "aspect_gazelle",
    path = "../..",
)

local_path_override(
    module_name = "aspect_go_treesitter_grammars",
    path = "../../treesitter",
)

# Go SDK version which can only be defined in a root MODULE
go_sdk2 = use_extension("@rules_go//go:extensions.bzl", "go_sdk", dev_dependency = True)
go_sdk2.nogo(nogo = "@aspect_gazelle//tools/nogo")
go_sdk2.from_file(
    name = "go_sdk",
    go_mod = "//:go.mod",
)
