load("@rules_cc//cc:cc_library.bzl", "cc_library")

cc_library(
    name = "pkcs11-helper",
    srcs = glob([
        "lib/pkcs11h-*.c",
        "lib/*.h",
    ]) + [
        "config.h",
        "lib/_pkcs11h-crypto-openssl.c",
    ],
    hdrs = glob(["include/pkcs11-helper-1.0/*.h"]),
    includes = ["include"],
    linkopts = [
        "-ldl",
        "-pthread",
    ],
    target_compatible_with = ["@platforms//os:linux"],
    visibility = ["//visibility:public"],
    deps = ["@openssl//:crypto"],
)
