load("@rules_cc//cc:defs.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

exports_files(["LICENSE"])

# args is a single header. Upstream's CMakeLists.txt installs args.hxx into the
# include prefix, so consumers spell it `#include <args.hxx>`; that only
# resolves through a real -I, which is what `includes` produces.
cc_library(
    name = "args",
    hdrs = ["args.hxx"],
    includes = ["."],
)
