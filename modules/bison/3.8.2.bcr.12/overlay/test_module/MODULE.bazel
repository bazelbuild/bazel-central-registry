"""Test module for GNU Bison: rules_bison with @bison//:bison as the registered toolchain.
"""

module(name = "bison_test_module")

bazel_dep(name = "bison")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "m4", version = "1.4.21.bcr.7")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_bison", version = "0.4.bcr.1")
bazel_dep(name = "rules_cc", version = "0.2.9")
bazel_dep(name = "rules_m4", version = "0.3.bcr.1")

local_path_override(
    module_name = "bison",
    path = "..",
)

register_toolchains(
    "//:bison_toolchain",
    "//:m4_toolchain",
)
