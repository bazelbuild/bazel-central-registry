# Wayland protocol XML definitions, plus wayland_client_protocol() (see
# wayland_protocol.bzl) to turn one into a cc_library.
#
# Every XML file is exported under its upstream path, e.g.
#   @wayland-protocols//:stable/xdg-shell/xdg-shell.xml

load("@rules_license//rules:license.bzl", "license")
load(":wayland_protocol.bzl", "wayland_client_protocol")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

license(
    name = "license",
    license_kinds = ["@rules_license//licenses/spdx:MIT"],
    license_text = "COPYING",
)

exports_files(
    ["COPYING"] + glob([
        "experimental/**/*.xml",
        "stable/**/*.xml",
        "staging/**/*.xml",
        "unstable/**/*.xml",
    ]),
)

exports_files(["wayland_protocol.bzl"])

# Example (and presubmit target): the core xdg-shell client protocol.
wayland_client_protocol(
    name = "xdg_shell_client",
    src = ":stable/xdg-shell/xdg-shell.xml",
    target_compatible_with = ["@platforms//os:linux"],
)
