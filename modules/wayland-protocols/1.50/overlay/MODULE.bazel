module(
    name = "wayland-protocols",
    version = "1.50",
    bazel_compatibility = [">=7.2.1"],
    compatibility_level = 1,
)

# Not used directly: raises wayland's libffi (3.4.7.bcr.3) to a version whose
# aarch64 configuration is only applied to macOS, so @wayland//:wayland_client
# builds for Linux aarch64 (native and cross-compiled).
bazel_dep(name = "libffi", version = "3.4.7.bcr.5")
bazel_dep(name = "platforms", version = "1.1.0")
bazel_dep(name = "rules_cc", version = "0.2.16")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "wayland", version = "1.24.0.bcr.1")
