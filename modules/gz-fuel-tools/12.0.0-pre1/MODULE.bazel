module(
    name = "gz-fuel-tools",
    version = "12.0.0-pre1",
)

bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.3")
bazel_dep(name = "curl", version = "8.21.0")
bazel_dep(name = "googletest", version = "1.17.0.bcr.2")
bazel_dep(name = "jsoncpp", version = "1.9.6.bcr.2")
bazel_dep(name = "libyaml", version = "0.2.5")
bazel_dep(name = "libzip", version = "1.11.4.bcr.3")
bazel_dep(name = "protobuf", version = "30.1", repo_name = "com_google_protobuf")
bazel_dep(name = "rules_cc", version = "0.2.22")
bazel_dep(name = "rules_license", version = "1.0.0")
bazel_dep(name = "tinyxml2", version = "10.0.0")

# Gazebo Dependencies
bazel_dep(name = "rules_gazebo", version = "0.0.6")
bazel_dep(name = "gz-common", version = "7.0.0")
bazel_dep(name = "gz-math", version = "9.0.0")
bazel_dep(name = "gz-msgs", version = "12.0.0")
bazel_dep(name = "gz-utils", version = "4.0.0")

# Override Gz deps to be pulled from the `main` branches so that CI uses deps
# from HEAD on `main`.
archive_override(
    module_name = "gz-common",
    strip_prefix = "gz-common-main",
    urls = ["https://github.com/gazebosim/gz-common/archive/refs/heads/main.tar.gz"],
)

archive_override(
    module_name = "gz-math",
    strip_prefix = "gz-math-main",
    urls = ["https://github.com/gazebosim/gz-math/archive/refs/heads/main.tar.gz"],
)

archive_override(
    module_name = "gz-msgs",
    strip_prefix = "gz-msgs-main",
    urls = ["https://github.com/gazebosim/gz-msgs/archive/refs/heads/main.tar.gz"],
)

archive_override(
    module_name = "gz-utils",
    strip_prefix = "gz-utils-main",
    urls = ["https://github.com/gazebosim/gz-utils/archive/refs/heads/main.tar.gz"],
)
