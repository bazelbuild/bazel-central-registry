load("@rules_cc//cc:cc_library.bzl", "cc_library")

_TEXTUAL_HDRS = glob(["include/boost/bloom/detail/fast_*.hpp"])

cc_library(
    name = "boost.bloom",
    hdrs = glob(["include/**/*.hpp"], exclude = _TEXTUAL_HDRS),
    features = ["parse_headers"],
    includes = ["include"],
    textual_hdrs = _TEXTUAL_HDRS,
    visibility = ["//visibility:public"],
    deps = [
        "@boost.assert",
        "@boost.config",
        "@boost.container_hash",
        "@boost.core",
        "@boost.throw_exception",
        "@boost.type_traits",
    ],
)
