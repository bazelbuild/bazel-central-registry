# Bazel build of the Instrumentation and Tracing Technology API (ittnotify),
# following CMakeLists.txt (without the Intel PT marks and Fortran bindings).
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_package_metadata = [":package_metadata"])

# The sources are "GPL-2.0-only OR BSD-3-Clause"; this declares the BSD option.
license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:BSD-3-Clause",
    text = "LICENSES/BSD-3-Clause.txt",
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

exports_files(glob(["LICENSES/*"]))

# libittnotify: the ITT API, which forwards to a collector (e.g. VTune) that
# INTEL_LIBITTNOTIFY64 points to at runtime, and does nothing without one.
cc_library(
    name = "ittnotify",
    srcs = [
        "src/ittnotify/disable_warnings.h",
        "src/ittnotify/ittnotify_config.h",
        "src/ittnotify/ittnotify_static.c",
        "src/ittnotify/ittnotify_static.h",
        "src/ittnotify/ittnotify_types.h",
    ],
    hdrs = [
        "include/ittnotify.h",
        "include/legacy/ittnotify.h",
        "include/libittnotify.h",
    ],
    includes = ["include"],
    linkopts = select({
        "@platforms//os:linux": [
            "-ldl",
            "-pthread",
        ],
        "@platforms//os:windows": [],
        "//conditions:default": ["-lpthread"],
    }),
    visibility = ["//visibility:public"],
)

# The JIT profiling API.
cc_library(
    name = "jitprofiling",
    srcs = [
        "include/ittnotify.h",
        "src/ittnotify/ittnotify_config.h",
        "src/ittnotify/ittnotify_types.h",
        "src/ittnotify/jitprofiling.c",
    ],
    hdrs = ["include/jitprofiling.h"],
    includes = ["include"],
    linkopts = select({
        "@platforms//os:linux": ["-ldl"],
        "//conditions:default": [],
    }),
    visibility = ["//visibility:public"],
)
