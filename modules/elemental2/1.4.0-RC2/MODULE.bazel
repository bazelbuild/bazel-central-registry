module(name = "elemental2",
    version = "1.4.0-RC2",
)

_J2CL_VERSION = "20261026"
_JSINTEROP_GENERATOR_VERSION = "20261027"
_JSINTEROP_BASE_VERSION = "1.2.0"

bazel_dep(name = "j2cl", version = _J2CL_VERSION)
bazel_dep(name = "jsinterop_generator", version = _JSINTEROP_GENERATOR_VERSION)
bazel_dep(name = "jsinterop_base", version = _JSINTEROP_BASE_VERSION)
bazel_dep(name = "bazel_skylib", version = "1.9.0")
bazel_dep(name = "google_bazel_common", version = "0.0.1")
bazel_dep(name = "rules_java", version = "8.16.1")
bazel_dep(name = "rules_license", version = "1.0.0")

# --- BEGIN DEV OVERRIDES ---
# Use head versions of our project dependencies for testing purposes.
archive_override(
    module_name = "j2cl",
    strip_prefix = "j2cl-master",
    urls = ["https://github.com/google/j2cl/archive/master.zip"],
)

archive_override(
    module_name = "jsinterop_generator",
    strip_prefix = "jsinterop-generator-master",
    urls = ["https://github.com/google/jsinterop-generator/archive/master.zip"],
)

archive_override(
    module_name = "jsinterop_base",
    strip_prefix = "jsinterop-base-master",
    urls = ["https://github.com/google/jsinterop-base/archive/master.zip"],
)
# --- END DEV OVERRIDES ---

# Maven dependencies.

bazel_dep(name = "rules_jvm_external", version = "6.6")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
# TODO(b/532249785): we need to have an empty maven.install() here due to
#   https://github.com/bazel-contrib/rules_jvm_external/issues/1438
maven.install()
maven.artifact(
    artifact = "closure-compiler",
    group = "com.google.javascript",
    version = "v20261021",
)
use_repo(maven, "maven")
