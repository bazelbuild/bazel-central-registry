"""Builds the SELinux policy module utilities."""

load("@rules_cc//cc:defs.bzl", "cc_binary")

package(default_visibility = ["//visibility:public"])

cc_binary(
    name = "semodule_package",
    srcs = ["semodule_package/semodule_package.c"],
    local_defines = ["_GNU_SOURCE"],
    deps = ["@libsepol"],
)

cc_binary(
    name = "semodule_unpackage",
    srcs = ["semodule_package/semodule_unpackage.c"],
    local_defines = ["_GNU_SOURCE"],
    deps = ["@libsepol"],
)

cc_binary(
    name = "semodule_link",
    srcs = ["semodule_link/semodule_link.c"],
    local_defines = ["_GNU_SOURCE"],
    deps = ["@libsepol"],
)

cc_binary(
    name = "semodule_expand",
    srcs = ["semodule_expand/semodule_expand.c"],
    local_defines = ["_GNU_SOURCE"],
    deps = ["@libsepol"],
)

# Lets users depend on `@semodule-utils` directly.
filegroup(
    name = "semodule-utils",
    srcs = [
        ":semodule_expand",
        ":semodule_link",
        ":semodule_package",
        ":semodule_unpackage",
    ],
)
