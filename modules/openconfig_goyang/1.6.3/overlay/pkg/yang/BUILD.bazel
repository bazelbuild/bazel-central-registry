load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "yang",
    srcs = [
        "ast.go",
        "camelcase.go",
        "doc.go",
        "entry.go",
        "file.go",
        "find.go",
        "identity.go",
        "lex.go",
        "modules.go",
        "node.go",
        "options.go",
        "parse.go",
        "types.go",
        "types_builtin.go",
        "yang.go",
        "yangtype.go",
    ],
    importpath = "github.com/openconfig/goyang/pkg/yang",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/indent",
        "@com_github_google_go_cmp//cmp",
    ],
)

alias(
    name = "go_default_library",
    actual = ":yang",
    visibility = ["//visibility:public"],
)

go_test(
    name = "yang_test",
    srcs = [
        "ast_test.go",
        "bgp_test.go",
        "camelcase_test.go",
        "entry_test.go",
        "file_test.go",
        "find_test.go",
        "identity_test.go",
        "lex_test.go",
        "marshal_test.go",
        "modules_test.go",
        "node_test.go",
        "parse_test.go",
        "types_builtin_test.go",
        "types_test.go",
        "yangtype_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":yang"],
    deps = [
        "@com_github_google_go_cmp//cmp",
        "@com_github_google_go_cmp//cmp/cmpopts",
        "@com_github_kylelemons_godebug//pretty",
        "@com_github_openconfig_gnmi//errdiff",
    ],
)
