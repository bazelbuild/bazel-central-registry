load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "yangentry",
    srcs = ["build_yang.go"],
    importpath = "github.com/openconfig/goyang/pkg/yangentry",
    visibility = ["//visibility:public"],
    deps = ["//pkg/yang"],
)

alias(
    name = "go_default_library",
    actual = ":yangentry",
    visibility = ["//visibility:public"],
)

go_test(
    name = "yangentry_test",
    srcs = ["build_yang_test.go"],
    data = glob(["testdata/**"]),
    embed = [":yangentry"],
    deps = ["//pkg/yang"],
)
