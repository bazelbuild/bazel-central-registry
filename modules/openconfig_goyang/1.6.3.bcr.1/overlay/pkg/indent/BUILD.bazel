load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "indent",
    srcs = ["indent.go"],
    importpath = "github.com/openconfig/goyang/pkg/indent",
    visibility = ["//visibility:public"],
)

alias(
    name = "go_default_library",
    actual = ":indent",
    visibility = ["//visibility:public"],
)

go_test(
    name = "indent_test",
    srcs = ["indent_test.go"],
    embed = [":indent"],
)
