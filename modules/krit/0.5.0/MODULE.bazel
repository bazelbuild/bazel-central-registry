"""Prebuilt krit binaries for Bazel.

    bazel_dep(name = "krit", version = "x.y.z")

    bazel run @krit//:krit -- --base-path "$PWD" "$PWD"

The module downloads the release archive for the host platform and verifies
it against the release's checksums.txt (or a pinned sha256 map), so krit's
version is an ordinary bazel_dep that Dependabot or Renovate can bump.
"""

module(
    name = "krit",
    version = "0.5.0",
    compatibility_level = 1,
)

bazel_dep(name = "bazel_skylib", version = "1.7.1")

krit = use_extension("//:extensions.bzl", "krit")
use_repo(krit, "krit_bin")
