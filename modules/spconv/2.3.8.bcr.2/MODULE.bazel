module(
    name = "spconv",
    version = "2.3.8.bcr.2",
    bazel_compatibility = [">=7.2.1"],
)

bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_cuda", version = "0.3.0")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
use_repo(cuda, "cuda")

generated_source = use_repo_rule("//bazel:repositories.bzl", "spconv_source_repository")

generated_source(name = "spconv_generated")
