diff --git a/bazel/repositories.bzl b/bazel/repositories.bzl
new file mode 100644
--- /dev/null
+++ b/bazel/repositories.bzl
@@ -0,0 +1,38 @@
+"""Extract the checksummed registry-supplied inference source supplement."""
+
+def _spconv_source_repository_impl(ctx):
+    ctx.extract(ctx.attr.archive)
+    for path in [
+        "spconv/include/spconvlib/spconv/csrc/sparse/all/SpconvOps.h",
+        "spconv/src",
+        "spconv/LICENSE",
+        "cumm/include/tensorview/tensor.h",
+        "cumm/LICENSE",
+        "spconv-source.json",
+    ]:
+        if not ctx.path(path).exists:
+            fail("Incomplete packaged spconv source tree: {}".format(path))
+    versions = json.decode(ctx.read(ctx.attr.versions))
+    manifest = json.decode(ctx.read("spconv-source.json"))
+    for name in ["spconv_commit", "cumm_commit"]:
+        if manifest.get(name) != versions[name]:
+            fail("Unsupported {} in packaged spconv provenance".format(name))
+    if manifest.get("inference_only") != True:
+        fail("Packaged spconv source must be inference-only")
+    if manifest.get("cuda_arch") != "8.9" or manifest.get("cuda_version") != "12.8":
+        fail("This source supplement supports CUDA 12.8 / SM89 only")
+    for project in ["spconv", "cumm"]:
+        ctx.symlink(project + "/LICENSE", project.upper() + "-LICENSE")
+    ctx.file("BUILD.bazel", ctx.read(ctx.attr.build_file))
+
+spconv_source_repository = repository_rule(
+    implementation = _spconv_source_repository_impl,
+    attrs = {
+        "archive": attr.label(
+            default = "//bazel:generated-inference-sm89.tar.xz",
+            allow_single_file = True,
+        ),
+        "build_file": attr.label(default = "//bazel:source.BUILD"),
+        "versions": attr.label(default = "//bazel:versions.json"),
+    },
+)
diff --git a/bazel/source.BUILD b/bazel/source.BUILD
new file mode 100644
--- /dev/null
+++ b/bazel/source.BUILD
@@ -0,0 +1,71 @@
+load("@rules_cc//cc:defs.bzl", "cc_library")
+load("@rules_cuda//cuda:defs.bzl", "cuda_library")
+
+package(default_visibility = ["//visibility:private"])
+
+licenses(["notice"])
+
+filegroup(
+    name = "licenses",
+    srcs = [
+        "CUMM-LICENSE",
+        "SPCONV-LICENSE",
+    ],
+    visibility = ["//visibility:public"],
+)
+
+filegroup(
+    name = "source_manifest",
+    srcs = ["spconv-source.json"],
+    visibility = ["//visibility:public"],
+)
+
+cc_library(
+    name = "headers",
+    hdrs = glob([
+        "spconv/include/**",
+        "cumm/include/**",
+    ]),
+    defines = [
+        "TV_CUDA",
+        "TV_ENABLE_HARDWARE_ACC",
+    ],
+    includes = [
+        "cumm/include",
+        "spconv/include",
+    ],
+    deps = [
+        "@cuda//:cublas",
+        "@cuda//:cuda_runtime",
+    ],
+)
+
+cuda_library(
+    name = "kernels",
+    srcs = glob(["spconv/src/**/*.cu"]),
+    copts = [
+        "-std=c++17",
+        "-O3",
+        "--extended-lambda",
+    ],
+    deps = [":headers"],
+)
+
+cc_library(
+    name = "spconv",
+    srcs = glob(["spconv/src/**/*.cc"]),
+    copts = [
+        "-O3",
+        "-Wno-unused-variable",
+        "-Wno-unused-but-set-variable",
+        "-Wno-error=reorder",
+    ],
+    linkstatic = True,
+    visibility = ["//visibility:public"],
+    deps = [
+        ":headers",
+        ":kernels",
+    ],
+    # Generated CUDA objects call back into this host object group.
+    alwayslink = True,
+)
