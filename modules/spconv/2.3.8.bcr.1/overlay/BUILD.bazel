load("@rules_python//python:defs.bzl", "py_binary")

package(default_visibility = ["//visibility:public"])

exports_files(["README.bazel.md"])

alias(
    name = "spconv",
    actual = "@spconv_generated//:spconv",
    tags = ["manual"],
)

alias(
    name = "licenses",
    actual = "@spconv_generated//:licenses",
    tags = ["manual"],
)

py_binary(
    name = "prepare_source",
    srcs = ["//bazel:prepare_source.py"],
    data = ["//bazel:versions.json"],
    main = "//bazel:prepare_source.py",
)

filegroup(
    name = "upstream_sources",
    srcs = glob([
        "spconv/**/*.py",
        "include/**",
    ]) + [
        "LICENSE",
        "docs/PURE_CPP_BUILD.md",
    ],
)
