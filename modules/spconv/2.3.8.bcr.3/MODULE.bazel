module(
    name = "spconv",
    version = "2.3.8.bcr.3",
    bazel_compatibility = [">=7.2.1"],
)

bazel_dep(name = "rules_cc", version = "0.2.14")
bazel_dep(name = "rules_cuda", version = "0.3.0")
bazel_dep(name = "rules_python", version = "1.6.3")
bazel_dep(name = "platforms", version = "0.0.11")

cuda = use_extension("@rules_cuda//cuda:extensions.bzl", "toolchain")
use_repo(cuda, "cuda")

python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(python_version = "3.10")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    extra_pip_args = ["--only-binary=:all:"],
    hub_name = "spconv_codegen_pip",
    python_version = "3.10",
    requirements_lock = "//bazel:requirements_lock.txt",
)
use_repo(pip, "spconv_codegen_pip")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# The official CPU wheel supplies the native tensorview helper needed by PCCM.
# This is an execution tool, not a precompiled spconv runtime.
http_archive(
    name = "cumm_codegen",
    build_file = "//bazel:cumm.BUILD",
    patch_args = ["-p1"],
    patches = ["//bazel:cumm-codegen.patch"],
    sha256 = "a2632c003aad2c8ea0ef0d384c7813e786e853389afbf57e8bf53ba2e843a566",
    type = "zip",
    urls = ["https://files.pythonhosted.org/packages/af/02/1312855b4f60b8ebb3fda2367f469b10d928bef664119921e31a49a9166b/cumm-0.7.11-cp310-cp310-manylinux_2_17_x86_64.manylinux2014_x86_64.whl"],
)
