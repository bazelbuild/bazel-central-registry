module(
    name = "rules_csharp_proto",
    version = "0.5.0",
)

bazel_dep(name = "rules_csharp", version = "0.5.0")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "protobuf", version = "33.4")
bazel_dep(name = "stardoc", version = "0.7.2", dev_dependency = True)
bazel_dep(name = "apple_support", version = "2.5.2", dev_dependency = True)

nuget = use_extension("@rules_csharp//csharp:extensions.bzl", "nuget", dev_dependency = True)
nuget.from_lock(
    packages_lock_json = "//tests/integration:packages.lock.json",
    directory_packages_props = "//tests/integration:Directory.Packages.props",
)
use_repo(nuget, "nuget")
