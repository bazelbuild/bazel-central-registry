"aspect-build/rules_cypress"

module(
    name = "aspect_rules_cypress",
    version = "0.8.0",
    bazel_compatibility = [">=8.5.0"],
)

# Lower-bounds (minimum) versions for direct runtime dependencies, supporting Bazel 8.5+.
bazel_dep(name = "bazel_lib", version = "3.0.0")
bazel_dep(name = "aspect_rules_js", version = "3.0.1")
bazel_dep(name = "aspect_tools_telemetry", version = "0.5.2")
bazel_dep(name = "bazel_skylib", version = "1.5.0")
bazel_dep(name = "platforms", version = "1.0.0")
bazel_dep(name = "rules_nodejs", version = "6.7.3")

tel = use_extension("@aspect_tools_telemetry//:extension.bzl", "telemetry")
use_repo(tel, "aspect_tools_telemetry_report")

####### Dev dependencies ########

bazel_dep(name = "aspect_rules_lint", version = "2.9.0", dev_dependency = True)
bazel_dep(name = "bazelrc-preset.bzl", version = "1.9.2", dev_dependency = True)
bazel_dep(name = "buildifier_prebuilt", version = "8.5.1.4", dev_dependency = True)
bazel_dep(name = "rules_shell", version = "0.8.0", dev_dependency = True)

# aspect_rules_lint pulls in (via rules_buf) old rules_go/gazelle that break under
# Bazel 9 (`CcInfo symbol has been removed`). Force Bazel 8/9-compatible versions.
# rules_cypress itself does not use Go, so these only bump the transitive versions
# (repo_name = None) — they introduce no directly-referenced repo.
bazel_dep(name = "gazelle", version = "0.54.0", dev_dependency = True, repo_name = None)
bazel_dep(name = "rules_go", version = "0.63.0", dev_dependency = True, repo_name = None)
