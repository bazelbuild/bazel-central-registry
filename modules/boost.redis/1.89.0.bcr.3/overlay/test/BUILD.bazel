load(":boost_test_suite.bzl", "boost_test_common", "boost_test_suite")

boost_test_common()

# The tests upstream runs; the rest of test/ needs an exclusive Redis server,
# see the comment in test/Jamfile.
boost_test_suite(
    name = "upstream_tests",
    srcs = [
        "test_conn_logging.cpp",
        "test_exec_fsm.cpp",
        "test_log_to_file.cpp",
        "test_reader_fsm.cpp",
    ],
)

# These declare a Boost.Test module rather than bringing their own main.
boost_test_suite(
    name = "upstream_unit_tests",
    srcs = [
        "test_any_adapter.cpp",
        "test_low_level.cpp",
        "test_low_level_sync_sans_io.cpp",
        "test_request.cpp",
    ],
    unit_test_main = True,
)
