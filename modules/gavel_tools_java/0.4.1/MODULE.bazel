"""Java lint aspects (PMD, CPD, SpotBugs, Error Prone, archtest) for consumers that lint Java.

Imposes nothing beyond rules_java (minimum version; the consumer's own wins) and
this module's linter binaries.
"""

module(
    name = "gavel_tools_java",
    version = "0.4.1",
    bazel_compatibility = [">=9.0.0"],
    compatibility_level = 1,
)

# Overrides only take effect when this is the root module (dev / CI here); for
# consumers they are ignored and the registry version of gavel_tools is used.
bazel_dep(name = "gavel_tools", version = "0.4.1")
local_path_override(
    module_name = "gavel_tools",
    path = "../..",
)

bazel_dep(name = "rules_java", version = "9.1.0")

# Linter binary repos, owned here so the aspect labels (@pmd, …) resolve within
# this module.
pmd_binary = use_repo_rule("//lint/lang/java/pmd:repositories.bzl", "pmd_binary")

pmd_binary(
    name = "pmd",
    version = "7.24.0",
)

spotbugs_binary = use_repo_rule("//lint/lang/java/spotbugs:repositories.bzl", "spotbugs_binary")

spotbugs_binary(
    name = "spotbugs",
    version = "4.9.8",
)

error_prone_binary = use_repo_rule("//lint/lang/java/error_prone:repositories.bzl", "error_prone_binary")

error_prone_binary(
    name = "error_prone",
    version = "2.49.0",
)
