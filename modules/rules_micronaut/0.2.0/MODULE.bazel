"""rules_micronaut: Bazel rules for Micronaut applications and tests."""

# Leave `version` unset: publish-to-bcr patches it into the registry copy.
# `compatibility_level` is intentionally omitted (a no-op since Bazel 8.6 / 9.1).
module(
    name = "rules_micronaut",
    bazel_compatibility = [">=8.4.0"],
    version = "0.2.0",
)

bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "contrib_rules_jvm", version = "0.34.0")
bazel_dep(name = "package_metadata", version = "0.0.6")
bazel_dep(name = "rules_java", version = "8.16.1")

# contrib_rules_jvm's older transitive rules_go cannot load on Bazel 9.
bazel_dep(name = "rules_go", version = "0.59.0", repo_name = None)

micronaut = use_extension("//micronaut:extensions.bzl", "micronaut")
use_repo(micronaut, "micronaut")

bazel_dep(name = "bazelrc-preset.bzl", version = "1.6.0", dev_dependency = True)

# Maintainer-only dependencies for //tools/feature_catalogue.
bazel_dep(name = "rules_jvm_external", version = "7.2", dev_dependency = True)

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven", dev_dependency = True)
maven.install(
    name = "feature_catalogue_maven",
    artifacts = [
        "ch.qos.logback:logback-classic:1.5.37",
        "io.micronaut.starter:micronaut-starter-core:5.2.5",
        "org.apache.maven.resolver:maven-resolver-supplier-mvn3:2.0.25",
    ],
    lock_file = "//tools/feature_catalogue:maven_install.json",
    repositories = ["https://repo.maven.apache.org/maven2"],
    resolver = "maven",
)
use_repo(maven, "feature_catalogue_maven")
