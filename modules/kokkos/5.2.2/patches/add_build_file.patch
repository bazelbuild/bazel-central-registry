diff --git BUILD.bazel BUILD.bazel
new file mode 100644
index 0000000..e200062
--- /dev/null
+++ BUILD.bazel
@@ -0,0 +1,268 @@
+load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "string_flag")
+load("@bazel_skylib//rules:write_file.bzl", "write_file")
+load("@rules_cc//cc:cc_library.bzl", "cc_library")
+load(":cuda_toolkit.bzl", "CUDA_ARCH_DEFINES", "CUDA_ARCH_ERROR", "kokkos_cuda_toolkit")
+
+package(default_visibility = ["//visibility:public"])
+
+exports_files(["cuda_toolkit.bzl"])
+
+# ---------------------------------------------------------------------------
+# Build settings (the module's configuration interface)
+#
+#   --@kokkos//:backend=openmp|threads|serial   host parallel backend
+#   --@kokkos//:device=none|cuda                device backend
+#   --@kokkos//:cuda_arch=sm_XX                 required with device=cuda
+#   --@kokkos//:cuda_toolkit=<label>            a kokkos_cuda_toolkit target
+#   --@kokkos//:cuda_constexpr                  Kokkos_ENABLE_CUDA_CONSTEXPR
+# ---------------------------------------------------------------------------
+
+string_flag(
+    name = "backend",
+    build_setting_default = "openmp",
+    values = [
+        "openmp",
+        "serial",
+        "threads",
+    ],
+)
+
+config_setting(
+    name = "openmp",
+    flag_values = {":backend": "openmp"},
+)
+
+config_setting(
+    name = "threads",
+    flag_values = {":backend": "threads"},
+)
+
+string_flag(
+    name = "device",
+    build_setting_default = "none",
+    values = [
+        "cuda",
+        "none",
+    ],
+)
+
+config_setting(
+    name = "cuda",
+    flag_values = {":device": "cuda"},
+)
+
+config_setting(
+    name = "no_device",
+    flag_values = {":device": "none"},
+)
+
+string_flag(
+    name = "cuda_arch",
+    build_setting_default = "",
+    values = [""] + CUDA_ARCH_DEFINES.keys(),
+)
+
+[
+    config_setting(
+        name = "cuda_" + arch,
+        flag_values = {
+            ":device": "cuda",
+            ":cuda_arch": arch,
+        },
+    )
+    for arch in CUDA_ARCH_DEFINES
+]
+
+bool_flag(
+    name = "cuda_constexpr",
+    build_setting_default = False,
+)
+
+config_setting(
+    name = "cuda_constexpr_enabled",
+    flag_values = {
+        ":device": "cuda",
+        ":cuda_constexpr": "True",
+    },
+)
+
+label_flag(
+    name = "cuda_toolkit",
+    build_setting_default = ":no_cuda_toolkit",
+)
+
+kokkos_cuda_toolkit(name = "no_cuda_toolkit")
+
+# ---------------------------------------------------------------------------
+# Headers Kokkos 5.2.2's CMake build would generate
+# ---------------------------------------------------------------------------
+
+_HOST_BACKEND = select({
+    ":openmp": ["OPENMP"],
+    ":threads": ["THREADS"],
+    "//conditions:default": [],
+})
+
+_DEVICE_BACKEND = select({
+    ":cuda": ["CUDA"],
+    "//conditions:default": [],
+})
+
+write_file(
+    name = "config",
+    out = "bazel-generated/KokkosCore_config.h",
+    content = [
+        "#if !defined(KOKKOS_MACROS_HPP) || defined(KOKKOS_CORE_CONFIG_H)",
+        '#error "Include Kokkos_Macros.hpp instead of KokkosCore_config.h"',
+        "#else",
+        "#define KOKKOS_CORE_CONFIG_H",
+        "#endif",
+        "#define KOKKOS_VERSION 50202",
+        "#define KOKKOS_VERSION_MAJOR 5",
+        "#define KOKKOS_VERSION_MINOR 2",
+        "#define KOKKOS_VERSION_PATCH 2",
+        "#define KOKKOS_ENABLE_SERIAL",
+        "#define KOKKOS_ENABLE_CXX20",
+        "#define KOKKOS_ENABLE_DEPRECATED_CODE_5",
+        "#define KOKKOS_ENABLE_DEPRECATION_WARNINGS",
+        "#define KOKKOS_ENABLE_COMPLEX_ALIGN",
+        "#define KOKKOS_ENABLE_IMPL_MDSPAN",
+        "#define KOKKOS_ENABLE_IMPL_REF_COUNT_BRANCH_UNLIKELY",
+        "#define KOKKOS_ENABLE_LIBDL",
+        '#define KOKKOS_IMPL_DESUL_VERSION "83d26f34db50b4fefe30ed4db38b10e04c7a9384"',
+        '#define KOKKOS_IMPL_MDSPAN_VERSION "5d4eb209c77f4744980c0b0c2af44636cc81b08b"',
+        "",
+    ] + select({
+        ":openmp": ["#define KOKKOS_ENABLE_OPENMP"],
+        ":threads": ["#define KOKKOS_ENABLE_THREADS"],
+        "//conditions:default": [],
+    }) + select({
+        ":cuda": ["#define KOKKOS_ENABLE_CUDA"],
+        "//conditions:default": [],
+    }) + select({
+        ":cuda_constexpr_enabled": ["#define KOKKOS_ENABLE_CUDA_CONSTEXPR"],
+        "//conditions:default": [],
+    }) + select(
+        dict(
+            [(":cuda_" + arch, ["#define " + d for d in defines]) for arch, defines in CUDA_ARCH_DEFINES.items()] +
+            [(":no_device", [])],
+        ),
+        no_match_error = CUDA_ARCH_ERROR,
+    ),
+)
+
+write_file(
+    name = "declare_backend",
+    out = "bazel-generated/KokkosCore_Config_DeclareBackend.hpp",
+    content = ["#include <decl/Kokkos_Declare_SERIAL.hpp>"] + select({
+        ":openmp": ["#include <decl/Kokkos_Declare_OPENMP.hpp>"],
+        ":threads": ["#include <decl/Kokkos_Declare_THREADS.hpp>"],
+        "//conditions:default": [],
+    }) + select({
+        ":cuda": ["#include <decl/Kokkos_Declare_CUDA.hpp>"],
+        "//conditions:default": [],
+    }),
+)
+
+write_file(
+    name = "fwd_backend",
+    out = "bazel-generated/KokkosCore_Config_FwdBackend.hpp",
+    content = ["#include <fwd/Kokkos_Fwd_SERIAL.hpp>"] + select({
+        ":openmp": ["#include <fwd/Kokkos_Fwd_OPENMP.hpp>"],
+        ":threads": ["#include <fwd/Kokkos_Fwd_THREADS.hpp>"],
+        "//conditions:default": [],
+    }) + select({
+        ":cuda": ["#include <fwd/Kokkos_Fwd_CUDA.hpp>"],
+        "//conditions:default": [],
+    }),
+)
+
+write_file(
+    name = "setup_backend",
+    out = "bazel-generated/KokkosCore_Config_SetupBackend.hpp",
+    content = [""] + select({
+        ":cuda": ["#include <setup/Kokkos_Setup_Cuda.hpp>"],
+        "//conditions:default": [],
+    }),
+)
+
+write_file(
+    name = "desul_config",
+    out = "bazel-generated/desul/atomics/Config.hpp",
+    content = ["#pragma once"] + select({
+        ":cuda": ["#define DESUL_ATOMICS_ENABLE_CUDA"],
+        "//conditions:default": [],
+    }),
+)
+
+# ---------------------------------------------------------------------------
+# Library
+# ---------------------------------------------------------------------------
+
+cc_library(
+    name = "kokkos",
+    srcs = glob([
+        "core/src/impl/*.cpp",
+        "core/src/Serial/*.cpp",
+        "containers/src/impl/*.cpp",
+    ]) + select({
+        ":openmp": glob(["core/src/OpenMP/*.cpp"]),
+        ":threads": glob(["core/src/Threads/*.cpp"]),
+        "//conditions:default": [],
+    }) + select({
+        ":cuda": glob(["core/src/Cuda/*.cpp"]) + ["tpls/desul/src/Lock_Array_CUDA.cpp"],
+        "//conditions:default": [],
+    }),
+    hdrs = glob([
+        "core/src/**/*.hpp",
+        "core/src/**/*.h",
+        "containers/src/**/*.hpp",
+        "algorithms/src/**/*.hpp",
+        "tpls/desul/include/**",
+        "tpls/mdspan/include/**",
+    ]) + [
+        ":config",
+        ":declare_backend",
+        ":desul_config",
+        ":fwd_backend",
+        ":setup_backend",
+    ],
+    # Toolkit files clang reads in CUDA mode; empty without device=cuda.
+    additional_compiler_inputs = [":cuda_toolkit"],
+    copts = ["-std=c++20"] + select({
+        ":openmp": ["-fopenmp"],
+        "//conditions:default": [],
+    }) + select({
+        # Rule copts follow --cxxopt, so -xcuda overrides a global -xc++.
+        ":cuda": [
+            "-xcuda",
+            "$(KOKKOS_CUDA_COPTS)",
+        ],
+        "//conditions:default": [],
+    }) + select(
+        dict(
+            [(":cuda_" + arch, ["--cuda-gpu-arch=" + arch]) for arch in CUDA_ARCH_DEFINES] +
+            [(":no_device", [])],
+        ),
+        no_match_error = CUDA_ARCH_ERROR,
+    ),
+    includes = [
+        "algorithms/src",
+        "bazel-generated",
+        "containers/src",
+        "core/src",
+        "tpls/desul/include",
+        "tpls/mdspan/include",
+    ],
+    linkopts = [
+        "-ldl",
+        "-pthread",
+    ],
+    # Supplies $(KOKKOS_CUDA_COPTS).
+    toolchains = [":cuda_toolkit"],
+    # :cuda_toolkit forwards the toolkit's runtime (cudart); empty by default.
+    deps = [":cuda_toolkit"] + select({
+        ":openmp": ["@openmp"],
+        "//conditions:default": [],
+    }),
+)
diff --git cuda_toolkit.bzl cuda_toolkit.bzl
new file mode 100644
index 0000000..6d7f788
--- /dev/null
+++ cuda_toolkit.bzl
@@ -0,0 +1,56 @@
+"""CUDA toolkit interface for the Kokkos module.
+
+Kokkos does not locate CUDA itself. A consumer that builds with
+--@kokkos//:device=cuda describes its toolkit with kokkos_cuda_toolkit() and
+points --@kokkos//:cuda_toolkit at it. The target carries everything the
+Kokkos compile and link need from the toolkit:
+
+  - copts:           clang CUDA flags such as --cuda-path=<execroot path>,
+                     exposed to Kokkos's copts as $(KOKKOS_CUDA_COPTS)
+  - compiler_inputs: files clang reads in CUDA mode (headers, ptxas,
+                     libdevice), added to the sandbox
+  - runtime:         cc target that links cudart (and anything else)
+"""
+
+load("@rules_cc//cc/common:cc_info.bzl", "CcInfo")
+
+# --@kokkos//:cuda_arch values and the Kokkos_ARCH_* macros Kokkos's CMake
+# defines for each (cmake/kokkos_arch.cmake).
+CUDA_ARCH_DEFINES = {
+    "sm_60": ["KOKKOS_ARCH_PASCAL", "KOKKOS_ARCH_PASCAL60"],
+    "sm_61": ["KOKKOS_ARCH_PASCAL", "KOKKOS_ARCH_PASCAL61"],
+    "sm_70": ["KOKKOS_ARCH_VOLTA", "KOKKOS_ARCH_VOLTA70"],
+    "sm_72": ["KOKKOS_ARCH_VOLTA", "KOKKOS_ARCH_VOLTA72"],
+    "sm_75": ["KOKKOS_ARCH_TURING75"],
+    "sm_80": ["KOKKOS_ARCH_AMPERE", "KOKKOS_ARCH_AMPERE80"],
+    "sm_86": ["KOKKOS_ARCH_AMPERE", "KOKKOS_ARCH_AMPERE86"],
+    "sm_87": ["KOKKOS_ARCH_AMPERE", "KOKKOS_ARCH_AMPERE87"],
+    "sm_89": ["KOKKOS_ARCH_ADA89"],
+    "sm_90": ["KOKKOS_ARCH_HOPPER", "KOKKOS_ARCH_HOPPER90"],
+    "sm_100": ["KOKKOS_ARCH_BLACKWELL", "KOKKOS_ARCH_BLACKWELL100"],
+    "sm_103": ["KOKKOS_ARCH_BLACKWELL", "KOKKOS_ARCH_BLACKWELL103"],
+    "sm_120": ["KOKKOS_ARCH_BLACKWELL", "KOKKOS_ARCH_BLACKWELL120"],
+    "sm_121": ["KOKKOS_ARCH_BLACKWELL", "KOKKOS_ARCH_BLACKWELL121"],
+}
+
+CUDA_ARCH_ERROR = "--@kokkos//:device=cuda requires --@kokkos//:cuda_arch=sm_XX"
+
+def _kokkos_cuda_toolkit_impl(ctx):
+    files = depset(transitive = [t[DefaultInfo].files for t in ctx.attr.compiler_inputs])
+    return [
+        DefaultInfo(files = files),
+        ctx.attr.runtime[CcInfo] if ctx.attr.runtime else CcInfo(),
+        platform_common.TemplateVariableInfo({
+            "KOKKOS_CUDA_COPTS": " ".join(ctx.attr.copts),
+        }),
+    ]
+
+kokkos_cuda_toolkit = rule(
+    implementation = _kokkos_cuda_toolkit_impl,
+    attrs = {
+        "compiler_inputs": attr.label_list(allow_files = True),
+        "copts": attr.string_list(),
+        "runtime": attr.label(providers = [CcInfo]),
+    },
+    doc = "Describes a CUDA toolkit for --@kokkos//:cuda_toolkit.",
+)
