                [
                    "#include <sys/mman.h>",
                    "\t       #include <mach/vm_statistics.h>",
                ],
                [
                    "void *p;",
                    "\t       p = mmap(0, 16, PROT_READ, MAP_ANON|MAP_PRIVATE, VM_MAKE_TAG(1), 0);",
                    "\t       munmap(p, 16);",
                ],
