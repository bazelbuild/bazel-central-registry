            if_false = "2",
            if_true = "3",
        ),
        checks.AC_CHECK_SIZEOF("intmax_t"),
        # configure.ac also maps 4 to 2, but C99 makes intmax_t at least as wide as long long (64 bits), and a define
        # takes one of two values.
        checks.AC_TRY_COMPILE(
            name = "intmax_t_size_supported",
            code = utils.AC_LANG_PROGRAM("", ""),
            error = "Unsupported intmax_t size: sizeof(intmax_t) is neither 16 nor 8",
            requires = ["ac_cv_sizeof_intmax_t==16 || ac_cv_sizeof_intmax_t==8"],
        ),
        checks.AC_DEFINE_UNQUOTED(
            "LG_SIZEOF_INTMAX_T",
            condition = "ac_cv_sizeof_intmax_t==16",
            if_false = "3",
            if_true = "4",
        ),
        checks.AC_TRY_LINK(
            name = "je_cv_pthread_mutex_adaptive_np",
            code = utils.AC_LANG_PROGRAM(
                "#include <pthread.h>",
