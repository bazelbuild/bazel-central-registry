            error = "Unsupported int size: sizeof(int) is neither 8 nor 4",
            requires = ["ac_cv_sizeof_int==8 || ac_cv_sizeof_int==4"],
        ),
        checks.AC_DEFINE_UNQUOTED(
            "LG_SIZEOF_INT",
            condition = "ac_cv_sizeof_int==8",
            if_false = "2",
            if_true = "3",
        ),
        checks.AC_CHECK_SIZEOF("long"),
        checks.AC_TRY_COMPILE(
            name = "long_size_supported",
            code = utils.AC_LANG_PROGRAM("", ""),
            error = "Unsupported long size: sizeof(long) is neither 8 nor 4",
            requires = ["ac_cv_sizeof_long==8 || ac_cv_sizeof_long==4"],
        ),
        checks.AC_DEFINE_UNQUOTED(
            "LG_SIZEOF_LONG",
            condition = "ac_cv_sizeof_long==8",
            if_false = "2",
            if_true = "3",
        ),
        checks.AC_CHECK_SIZEOF("long long"),
        checks.AC_TRY_COMPILE(
            name = "long_long_size_supported",
            code = utils.AC_LANG_PROGRAM("", ""),
            error = "Unsupported long long size: sizeof(long long) is neither 8 nor 4",
            requires = ["ac_cv_sizeof_long_long==8 || ac_cv_sizeof_long_long==4"],
        ),
        checks.AC_DEFINE_UNQUOTED(
            "LG_SIZEOF_LONG_LONG",
