        checks.AC_DEFINE_UNQUOTED(
            "JEMALLOC_GCC_U8_SYNC_ATOMICS",
            condition = "je_cv_gcc_u8_sync_atomics",
        ),
        checks.AC_TRY_LINK(
            name = "je_cv_builtin_clz",
            code = utils.AC_LANG_PROGRAM(
                "",
                [
                    "{",
                    "        unsigned x = 0;",
                    "        int y = __builtin_clz(x);",
                    "}",
                    "{",
                    "        unsigned long x = 0;",
                    "        int y = __builtin_clzl(x);",
                    "}",
                    "{",
                    "        unsigned long long x = 0;",
