            ),
            requires = ["!ac_cv_c_compiler_gnu"],
        ),
        # configure.ac defines it when a GNU compiler accepts -std=gnu11 (or gnu99). Every check here compiles with
        # CONLYOPTS, the standard jemalloc's sources declare, so a GNU compiler that reaches this point accepted it.
        checks.AC_DEFINE_UNQUOTED(
            "JEMALLOC_HAS_RESTRICT",
            condition = "ac_cv_c_compiler_gnu",
        ),
    ] + select({
        # configure.ac's host table defines it for Android whatever the probe finds.
        "@platforms//os:android": [checks.AC_DEFINE_UNQUOTED("JEMALLOC_C11_ATOMICS", "")],
        "//conditions:default": [
            checks.AC_TRY_LINK(
                name = "je_cv_c11_atomics",
                code = utils.AC_LANG_PROGRAM(
                    [
                        "#include <stdint.h>",
                        "#if (__STDC_VERSION__ >= 201112L) && !defined(__STDC_NO_ATOMICS__)",
                        "#include <stdatomic.h>",
                        "#else",
                        "#error Atomics not available",
                        "#endif",
                    ],
                    [
                        "uint64_t *p = (uint64_t *)0;",
                        "uint64_t x = 1;",
                        "volatile atomic_uint_least64_t *a = (volatile atomic_uint_least64_t *)p;",
                        "uint64_t r = atomic_fetch_add(a, x) + x;",
                        "return r == 0;",
                    ],
                ),
            ),
            checks.AC_DEFINE_UNQUOTED(
                "JEMALLOC_C11_ATOMICS",
                condition = "je_cv_c11_atomics",
            ),
        ],
    }) + [
        checks.AC_TRY_LINK(
            name = "je_cv_gcc_atomic_atomics",
            code = utils.AC_LANG_PROGRAM(
                "",
                [
                    "int x = 0;",
                    "int val = 1;",
                    "int y = __atomic_fetch_add(&x, val, __ATOMIC_RELAXED);",
                    "int after_add = x;",
                    "return after_add == 1;",
                ],
            ),
        ),
        checks.AC_DEFINE_UNQUOTED(
            "JEMALLOC_GCC_ATOMIC_ATOMICS",
            condition = "je_cv_gcc_atomic_atomics",
        ),
        checks.AC_TRY_LINK(
            name = "je_cv_gcc_u8_atomic_atomics",
            code = utils.AC_LANG_PROGRAM(
                "",
                [
                    "unsigned char x = 0;",
                    "int val = 1;",
                    "int y = __atomic_fetch_add(&x, val, __ATOMIC_RELAXED);",
                    "int after_add = (int)x;",
                    "return after_add == 1;",
                ],
            ),
            requires = ["je_cv_gcc_atomic_atomics"],
        ),
        checks.AC_DEFINE_UNQUOTED(
            "JEMALLOC_GCC_U8_ATOMIC_ATOMICS",
            condition = "je_cv_gcc_u8_atomic_atomics",
        ),
        checks.AC_TRY_LINK(
            name = "je_cv_gcc_sync_atomics",
            code = utils.AC_LANG_PROGRAM(
                "",
                [
                    "int x = 0;",
                    "int before_add = __sync_fetch_and_add(&x, 1);",
                    "int after_add = x;",
                    "return (before_add == 0) && (after_add == 1);",
                ],
            ),
        ),
        checks.AC_DEFINE_UNQUOTED(
            "JEMALLOC_GCC_SYNC_ATOMICS",
            condition = "je_cv_gcc_sync_atomics",
        ),
        checks.AC_TRY_LINK(
            name = "je_cv_gcc_u8_sync_atomics",
            code = utils.AC_LANG_PROGRAM(
