        checks.AC_DEFINE_UNQUOTED(
            "JEMALLOC_INTERNAL_FFS",
            condition = "je_cv_gcc_builtin_ffsl",
            if_false = "ffs",
            if_true = "__builtin_ffs",
        ),
        checks.AC_TRY_LINK(
            name = "je_cv_gcc_builtin_popcountl",
            code = utils.AC_LANG_PROGRAM(
                [
                    "#include <stdio.h>",
