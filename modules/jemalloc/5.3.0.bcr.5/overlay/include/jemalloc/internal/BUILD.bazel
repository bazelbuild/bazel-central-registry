                    "#ifndef __GNUC__",
                    "       choke me",
                    "#endif",
                ],
            ),
        ),
        checks.AC_TRY_COMPILE(
            name = "je_cv_msvc",
            code = utils.AC_LANG_PROGRAM(
                "",
                [
                    "#ifndef _MSC_VER",
                    "  int fail[-1];",
                    "#endif",
