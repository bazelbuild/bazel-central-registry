# A define takes one of two values, so CPU_SPINWAIT reads je_cv_pause_msvc or je_cv_pause by compiler, and a check
# fails the build if that choice disagrees with configure.ac's je_cv_msvc probe.
autoconf(
    name = "jemalloc_internal_defs_x86_spinwait_checks",
    cc_deps = HOST_CC_DEPS + HOST_LIBS,
    checks = [
        checks.AC_TRY_LINK(
            name = "je_cv_pause_msvc",
            code = utils.AC_LANG_PROGRAM("", "_mm_pause(); return 0;"),
            requires = ["je_cv_msvc"],
        ),
        checks.AC_TRY_LINK(
            name = "je_cv_pause",
            code = utils.AC_LANG_PROGRAM("", "__asm__ volatile(\"pause\"); return 0;"),
            requires = ["!je_cv_msvc"],
        ),
    ] + select({
        compiler: [
            checks.AC_TRY_COMPILE(
                name = "msvc_compiler_consistent",
                code = utils.AC_LANG_PROGRAM("", ""),
                error = "The compiler does not define _MSC_VER, but rules_cc identifies it as an MSVC-compatible compiler",
                requires = ["je_cv_msvc"],
            ),
            checks.AC_DEFINE_UNQUOTED(
                "CPU_SPINWAIT",
                condition = "je_cv_pause_msvc",
                if_false = "",
                if_true = "_mm_pause()",
            ),
        ]
        for compiler in [
            "@rules_cc//cc/compiler:clang-cl",
            "@rules_cc//cc/compiler:msvc-cl",
        ]
    } | {"//conditions:default": [
        checks.AC_TRY_COMPILE(
            name = "msvc_compiler_consistent",
            code = utils.AC_LANG_PROGRAM("", ""),
            error = "The compiler defines _MSC_VER, but rules_cc does not identify it as msvc-cl or clang-cl",
            requires = ["!je_cv_msvc"],
        ),
        checks.AC_DEFINE_UNQUOTED(
            "CPU_SPINWAIT",
            condition = "je_cv_pause",
            if_false = "",
            if_true = "__asm__ volatile(\"pause\")",
        ),
    ]}),
    conlyopts = CONLYOPTS,
    copts = HOST_CPPFLAGS,
    tags = ["manual"],
    deps = [":jemalloc_internal_defs_checks"],
)

# configure.ac adds -Werror only around these probes (JE_CFLAGS_SAVE/JE_CFLAGS_RESTORE), so a construct the compiler
# merely warns about counts as unsupported. Each check carries the flag in its own copts: rules_cc_autoconf strips
# -Werror from the target's copts. cl ignores -Werror with a warning, as it does under configure.
autoconf(
    name = "jemalloc_internal_defs_warnings_as_errors_checks",
    cc_deps = HOST_CC_DEPS + HOST_LIBS,
    checks = [
        checks.AC_TRY_LINK(
            name = "je_cv_tls_model",
            code = utils.AC_LANG_PROGRAM(
                "",
                [
                    "static __thread int",
                    "               __attribute__((tls_model(\"initial-exec\"), unused)) foo;",
                    "               foo = 0;",
                ],
            ),
            copts = ["-Werror"],
        ),
        checks.AC_DEFINE_UNQUOTED(
            "JEMALLOC_TLS_MODEL",
            condition = "je_cv_tls_model",
            if_false = "",
            if_true = "__attribute__((tls_model(\"initial-exec\")))",
        ),
        checks.AC_TRY_LINK(
            name = "je_cv_syscall",
            code = utils.AC_LANG_PROGRAM(
                [
                    "#include <sys/syscall.h>",
                    "#include <unistd.h>",
                ],
                "\tsyscall(SYS_write, 2, \"hello\", 5);",
            ),
            copts = ["-Werror"],
        ),
        checks.AC_DEFINE_UNQUOTED(
            "JEMALLOC_USE_SYSCALL",
            condition = "je_cv_syscall",
        ),
        checks.AC_TRY_LINK(
            name = "je_cv_strerror_r_returns_char_with_gnu_source",
            code = utils.AC_LANG_PROGRAM(
                [
                    "#include <errno.h>",
                    "#include <stdio.h>",
                    "#include <stdlib.h>",
                    "#include <string.h>",
                ],
                [
                    "  char *buffer = (char *) malloc(100);",
                    "  char *error = strerror_r(EINVAL, buffer, 100);",
                    "  printf(\"%s\\n\", error);",
                ],
            ),
            copts = [
                "-D_GNU_SOURCE",
                "-Werror",
            ],
        ),
        checks.AC_DEFINE_UNQUOTED(
            "JEMALLOC_STRERROR_R_RETURNS_CHAR_WITH_GNU_SOURCE",
            condition = "je_cv_strerror_r_returns_char_with_gnu_source",
        ),
    ],
    conlyopts = CONLYOPTS,
    copts = HOST_CPPFLAGS,
    tags = ["manual"],
)

