load("@rules_cc//cc:cc_library.bzl", "cc_library")

# configure.ac adds include/msvc_compat to CPPFLAGS when the compiler defines _MSC_VER, which clang-cl does too. Its C99
# directory is left out: configure.ac adds that only for toolchains without inttypes.h (VS2012 and older).
cc_library(
    name = "msvc_compat",
    hdrs = [
        "strings.h",
        "windows_extra.h",
    ],
    includes = ["."],
    visibility = ["//:__subpackages__"],
)
