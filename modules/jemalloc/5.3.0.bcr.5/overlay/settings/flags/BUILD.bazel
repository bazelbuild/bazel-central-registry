load("@bazel_skylib//lib:selects.bzl", "selects")
load("@bazel_skylib//rules:common_settings.bzl", "bool_flag", "int_flag", "string_flag")
load("//settings:platform_defaults.bzl", "DARWIN_OSES", "JE_PREFIX_OSES", "resolved_setting")

package(default_visibility = ["//:__subpackages__"])

### Bazel-ification of optional flags accepted by ./configure ###

# JEMALLOC_CACHE_OBLIVIOUS
bool_flag(
    name = "enable_cache_oblivious",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "cache_oblivious",
    flag_values = {":enable_cache_oblivious": "True"},
)

# JEMALLOC_ENABLE_CXX
bool_flag(
    name = "enable_cxx",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "cxx",
    flag_values = {":enable_cxx": "True"},
)

# JEMALLOC_DEBUG
config_setting(
    name = "debug",
    values = {"compilation_mode": "dbg"},
)

# JEMALLOC_EXPERIMENTAL_SMALLOCX_API
bool_flag(
    name = "enable_experimental_smallocx",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "experimental_smallocx_api",
    flag_values = {":enable_experimental_smallocx": "True"},
)

# JEMALLOC_FILL (support for junk/zero filling)
bool_flag(
    name = "enable_fill",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "fill",
    flag_values = {":enable_fill": "True"},
)

# JEMALLOC_LAZY_LOCK
string_flag(
    name = "enable_lazy_lock",
    build_setting_default = "__auto__",
    values = [
        "yes",
        "no",
        "__auto__",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "enable_lazy_lock_is_yes",
    flag_values = {":enable_lazy_lock": "yes"},
)

# configure.ac's default enables lazy locking on FreeBSD only
config_setting(
    name = "enable_lazy_lock_is_auto_freebsd",
    constraint_values = ["@platforms//os:freebsd"],
    flag_values = {":enable_lazy_lock": "__auto__"},
)

selects.config_setting_group(
    name = "lazy_lock",
    match_any = [
        ":enable_lazy_lock_is_auto_freebsd",
        ":enable_lazy_lock_is_yes",
    ],
)

config_setting(
    name = "enable_lazy_lock_is_yes_windows",
    constraint_values = ["@platforms//os:windows"],
    flag_values = {":enable_lazy_lock": "yes"},
)

# JEMALLOC_LOG
bool_flag(
    name = "enable_log",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "log",
    flag_values = {":enable_log": "True"},
)

# JEMALLOC_STATS
bool_flag(
    name = "enable_stats",
    build_setting_default = True,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "stats",
    flag_values = {":enable_stats": "True"},
)

# JEMALLOC_UAF_DETECTION
bool_flag(
    name = "enable_uaf_detection",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "uaf_detection",
    flag_values = {":enable_uaf_detection": "True"},
)

# JEMALLOC_XMALLOC
bool_flag(
    name = "enable_xmalloc",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "xmalloc",
    flag_values = {":enable_xmalloc": "True"},
)

# --with-jemalloc-prefix. __auto__ takes configure's default for the target platform, as :jemalloc_prefix_resolved and
# :no_jemalloc_prefix resolve it. C reserves identifiers that begin with two underscores (C11 7.1.3), so no real
# prefix is __auto__.
string_flag(
    name = "jemalloc_prefix",
    build_setting_default = "__auto__",
    visibility = ["//visibility:public"],
)

# JEMALLOC_PREFIX: :jemalloc_prefix with __auto__ resolved to configure's default, "je_" for the macho and pecoff ABIs
resolved_setting(
    name = "jemalloc_prefix_resolved",
    defaults = select({
        ":jemalloc_prefix_is_auto_je": {"default": "je_"},
        "//conditions:default": {"default": ""},
    }),
    make_variable = "JEMALLOC_PREFIX",
    setting = ":jemalloc_prefix",
)

# JEMALLOC_CPREFIX: JEMALLOC_PREFIX uppercased
resolved_setting(
    name = "jemalloc_cprefix",
    make_variable = "JEMALLOC_CPREFIX",
    setting = ":jemalloc_prefix_resolved",
    upper = True,
)

config_setting(
    name = "jemalloc_prefix_is_empty",
    flag_values = {":jemalloc_prefix": ""},
)

config_setting(
    name = "jemalloc_prefix_is_auto",
    flag_values = {":jemalloc_prefix": "__auto__"},
)

[
    config_setting(
        name = "jemalloc_prefix_is_auto_" + os,
        constraint_values = ["@platforms//os:" + os],
        flag_values = {":jemalloc_prefix": "__auto__"},
    )
    for os in JE_PREFIX_OSES
]

# __auto__ where configure's default prefix is je_: the macho and pecoff ABIs. It matches as the per-OS setting it
# resolves to, which specializes :jemalloc_prefix_is_auto.
selects.config_setting_group(
    name = "jemalloc_prefix_is_auto_je",
    match_any = [":jemalloc_prefix_is_auto_" + os for os in JE_PREFIX_OSES],
)

# JEMALLOC_PREFIX is empty: "", or __auto__ outside :jemalloc_prefix_is_auto_je. The negation has no config_setting, so
# this resolves, as selects.config_setting_group does, to a setting that matches where it holds and to
# :jemalloc_prefix_is_empty, which cannot match there, where it does not. :jemalloc_prefix_is_auto_je specializes
# :jemalloc_prefix_is_auto.
alias(
    name = "no_jemalloc_prefix",
    actual = select({
        ":jemalloc_prefix_is_auto": ":jemalloc_prefix_is_auto",
        ":jemalloc_prefix_is_auto_je": ":jemalloc_prefix_is_empty",
        "//conditions:default": ":jemalloc_prefix_is_empty",
    }),
)

# LG_QUANTUM Base 2 log of minimum allocation alignment (--with-lg-quantum), -1 is undefined for resolution internal
# to the headers
int_flag(
    name = "lg_quantum",
    build_setting_default = -1,
    make_variable = "LG_QUANTUM",
    visibility = ["//visibility:public"],
)

config_setting(
    name = "no_lg_quantum",
    flag_values = {":lg_quantum": "-1"},
)

# MALLOC_CONF Specify default malloc_conf (--with-malloc-conf)
string_flag(
    name = "malloc_conf",
    build_setting_default = "",
    make_variable = "MALLOC_CONF",
    visibility = ["//visibility:public"],
)

# PRIVATE_NAMESPACE Prefix to prepend to all library-private APIs (--with-private-namespace)
string_flag(
    name = "private_namespace",
    build_setting_default = "",
    make_variable = "PRIVATE_NAMESPACE",
    visibility = ["//visibility:public"],
)

# JEMALLOC_EXPORT via --without-export which disables the export of the jemalloc API
bool_flag(
    name = "without_export",
    build_setting_default = False,
    visibility = ["//visibility:public"],
)

config_setting(
    name = "export",
    flag_values = {":without_export": "True"},
)

# JEMALLOC_ZONE Enable/Disable zone allocator for Darwin
string_flag(
    name = "enable_zone_allocator",
    build_setting_default = "__auto__",
    values = [
        "yes",
        "no",
        "__auto__",
    ],
    visibility = ["//visibility:public"],
)

config_setting(
    name = "enable_zone_allocator_is_no",
    flag_values = {":enable_zone_allocator": "no"},
)

config_setting(
    name = "enable_zone_allocator_is_auto",
    flag_values = {":enable_zone_allocator": "__auto__"},
)

[
    config_setting(
        name = "enable_zone_allocator_is_{}_{}".format(value, os),
        constraint_values = ["@platforms//os:" + os],
        flag_values = {":enable_zone_allocator": flag_value},
    )
    for value, flag_value in [
        ("auto", "__auto__"),
        ("yes", "yes"),
    ]
    for os in DARWIN_OSES
]

# The zone allocator is on: "yes" or configure's default on Darwin. It matches as the per-OS setting it resolves to,
# which specializes :enable_zone_allocator_is_auto.
selects.config_setting_group(
    name = "zone_allocator",
    match_any = [
        ":enable_zone_allocator_is_{}_{}".format(value, os)
        for value in [
            "auto",
            "yes",
        ]
        for os in DARWIN_OSES
    ],
)

# JEMALLOC_PROF Enable allocation profiling with specified backtracing implementation
string_flag(
    name = "enable_prof",
    build_setting_default = "no",
    values = [
        "gcc",
        "libgcc",
        "libunwind",
        "no",
    ],
    visibility = ["//visibility:public"],
)

selects.config_setting_group(
    name = "prof",
    match_any = [
        ":prof_gcc",
        ":prof_libgcc",
        ":prof_libunwind",
    ],
)

config_setting(
    name = "no_prof",
    flag_values = {":enable_prof": "no"},
)

# JEMALLOC_PROF_GCC
config_setting(
    name = "prof_gcc",
    flag_values = {":enable_prof": "gcc"},
)

# JEMALLOC_PROF_LIBUNWIND
config_setting(
    name = "prof_libunwind",
    flag_values = {":enable_prof": "libunwind"},
)

# JEMALLOC_PROF_LIBGCC
config_setting(
    name = "prof_libgcc",
    flag_values = {":enable_prof": "libgcc"},
)

# NM, the nm configure runs as DUMP_SYMS to list the library's symbols for private_namespace.h. Unset, it is the C++
# toolchain's nm (CcToolchainInfo.nm_executable). rules_cc's rule-based toolchains supply that only through a
# cc_legacy_tool, so for one that declares none, set this to an nm target, such as @llvm//tools:llvm-nm. A plain file
# brings no runfiles, so an nm that needs any (shared libraries, an interpreter) must be an executable target.
label_flag(
    name = "nm",
    build_setting_default = ":toolchain_nm",
    visibility = ["//visibility:public"],
)

# The unset value of :nm.
filegroup(name = "toolchain_nm")
