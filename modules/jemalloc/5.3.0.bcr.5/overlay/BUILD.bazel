load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//tools:cc.bzl", "CONLYOPTS", "COPTS", "CXXOPTS")
load("//tools:transition.bzl", "CPU", "PLATFORM", "transition_default_constraints")

####
# Due to the complexity of the build, the overlay is maintained independently.
# See https://github.com/sallustfire/jemalloc/tree/bcr-5.3.0?tab=readme-ov-file#bazel-build-of-jemalloc
####

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:BSD-2-Clause",
    text = "COPYING",
    visibility = ["//visibility:public"],
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

exports_files(["VERSION"])

exports_files(
    ["configure.ac"],
    visibility = ["//tools/fidelity:__pkg__"],
)

alias(
    name = "jemalloc",
    actual = ":jemalloc_with_defaults",
    visibility = ["//visibility:public"],
)

# Shared by the core library and the zone, which upstream compiles as one set of objects
_LIB_COPTS = ["-Iinclude/jemalloc/internal"] + COPTS

_LIB_LOCAL_DEFINES = select({
    "//settings:jet": ["JEMALLOC_JET"],
    "//conditions:default": [],
}) + select({
    "//settings:no_private_namespace": ["JEMALLOC_NO_PRIVATE_NAMESPACE"],
    "//conditions:default": [],
})

# Everything but the zone. An implementation detail of lib/jemalloc, which every consumer and test links instead.
cc_library(
    name = "lib/jemalloc_core",
    srcs = [
        "src/arena.c",
        "src/background_thread.c",
        "src/base.c",
        "src/bin.c",
        "src/bin_info.c",
        "src/bitmap.c",
        "src/buf_writer.c",
        "src/cache_bin.c",
        "src/ckh.c",
        "src/counter.c",
        "src/ctl.c",
        "src/decay.c",
        "src/div.c",
        "src/ecache.c",
        "src/edata.c",
        "src/edata_cache.c",
        "src/ehooks.c",
        "src/emap.c",
        "src/eset.c",
        "src/exp_grow.c",
        "src/extent.c",
        "src/extent_dss.c",
        "src/extent_mmap.c",
        "src/fxp.c",
        "src/hook.c",
        "src/hpa.c",
        "src/hpa_hooks.c",
        "src/hpdata.c",
        "src/inspect.c",
        "src/jemalloc.c",
        "src/large.c",
        "src/log.c",
        "src/malloc_io.c",
        "src/mutex.c",
        "src/nstime.c",
        "src/pa.c",
        "src/pa_extra.c",
        "src/pac.c",
        "src/pages.c",
        "src/pai.c",
        "src/peak_event.c",
        "src/prof.c",
        "src/prof_data.c",
        "src/prof_log.c",
        "src/prof_recent.c",
        "src/prof_stats.c",
        "src/prof_sys.c",
        "src/psset.c",
        "src/rtree.c",
        "src/safety_check.c",
        "src/san.c",
        "src/san_bump.c",
        "src/sc.c",
        "src/sec.c",
        "src/stats.c",
        "src/sz.c",
        "src/tcache.c",
        "src/test_hooks.c",
        "src/thread_event.c",
        "src/ticker.c",
        "src/tsd.c",
        "src/witness.c",
    ] + select({
        "//settings/flags:cxx": ["src/jemalloc_cpp.cpp"],
        "//conditions:default": [],
    }),
    hdrs = ["//include/jemalloc"],
    conlyopts = CONLYOPTS,
    copts = _LIB_COPTS,
    cxxopts = CXXOPTS,
    includes = ["include"],
    linkopts = select({
        "@platforms//os:android": ["-ldl"],
        "@platforms//os:linux": [
            "-ldl",
            "-lpthread",
            "-lrt",
        ],
        "//conditions:default": [],
    }) + select({
        "//settings/flags:prof": ["-lm"],
        "//conditions:default": [],
    }),
    local_defines = _LIB_LOCAL_DEFINES,
    tags = ["manual"],
    visibility = ["//visibility:private"],
    deps = ["//include/jemalloc/internal"] + select({
        "@rules_cc//cc/compiler:clang-cl": ["//include/msvc_compat"],
        "@rules_cc//cc/compiler:msvc-cl": ["//include/msvc_compat"],
        "//conditions:default": [],
    }) + select({
        "//settings/flags:prof_libunwind": ["@libunwind"],
        "//conditions:default": [],
    }),
)

# src/zone.c registers jemalloc's malloc zone from a constructor that nothing references, so a static link would drop it
# and leave malloc on the system allocator, as it does with upstream's libjemalloc.a. Only the zone is linked whole:
# linking the core whole would force jemalloc_cpp.o's operator new and delete into every binary, which then fails to
# link when the application defines its own.
cc_library(
    name = "lib/jemalloc_zone",
    srcs = ["src/zone.c"],
    conlyopts = CONLYOPTS,
    copts = _LIB_COPTS,
    cxxopts = CXXOPTS,
    includes = ["include"],
    local_defines = _LIB_LOCAL_DEFINES,
    tags = ["manual"],
    # zone.c is darwin-only and stops with #error without the zone allocator, which only the platform transition
    # resolves; build it through lib/jemalloc.
    target_compatible_with = select({
        "//settings/flags:zone_allocator": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    visibility = ["//visibility:private"],
    deps = [
        ":lib/jemalloc_core",
        "//include/jemalloc/internal",
    ],
    alwayslink = True,
)

# The library every consumer and test links. Whether it includes the zone is an implementation detail: it does where
# the zone allocator is on, as upstream compiles src/zone.c into the library only then.
cc_library(
    name = "lib/jemalloc",
    tags = ["manual"],
    visibility = ["//:__subpackages__"],
    # lib/jemalloc_zone depends on the core, so either branch links the core
    deps = select({
        "//settings/flags:zone_allocator": [":lib/jemalloc_zone"],
        "//conditions:default": [":lib/jemalloc_core"],
    }),
)

transition_default_constraints(
    name = "jemalloc_with_defaults",
    src = ":lib/jemalloc",
    cpu = CPU,
    platform = PLATFORM,
    settings = {},
)

# C_UTIL_INTEGRATION_SRCS from the Makefile which are shared with the integration testlib
cc_library(
    name = "utils",
    srcs = [
        "src/malloc_io.c",
        "src/nstime.c",
        "src/ticker.c",
    ],
    hdrs = ["//include/jemalloc"],
    conlyopts = CONLYOPTS,
    copts = ["-Iinclude/jemalloc/internal"] + COPTS,
    cxxopts = CXXOPTS,
    includes = ["include"],
    linkopts = select({
        "@platforms//os:linux": [
            "-lpthread",
            "-lrt",
        ],
        "//conditions:default": [],
    }),
    linkstatic = True,
    tags = ["manual"],
    visibility = ["//:__subpackages__"],
    deps = ["//include/jemalloc/internal"],
)

cc_library(
    name = "pthread",
    linkopts = ["-pthread"],
    visibility = ["//include/jemalloc:__subpackages__"],
)
