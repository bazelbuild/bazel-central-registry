load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//purl:purl.bzl", "purl")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//tools:cc.bzl", "CONLYOPTS", "COPTS", "CXXOPTS")

####
# Due to the complexity of the build, the overlay is maintained independently.
# See https://github.com/sallustfire/jemalloc/tree/bcr-5.3.0?tab=readme-ov-file#bazel-build-of-jemalloc
####

license(
    name = "license",
    kind = "@package_metadata//licenses/spdx:BSD-2-Clause",
    text = "COPYING",
    visibility = ["//visibility:public"],
)

package_metadata(
    name = "package_metadata",
    attributes = [":license"],
    purl = purl.bazel(
        module_name(),
        module_version(),
    ),
    visibility = ["//visibility:public"],
)

exports_files(["VERSION"])

exports_files(
    ["configure.ac"],
    visibility = ["//tools/fidelity:__pkg__"],
)

cc_library(
    name = "jemalloc",
    srcs = [
        "src/arena.c",
        "src/background_thread.c",
        "src/base.c",
        "src/bin.c",
        "src/bin_info.c",
        "src/bitmap.c",
        "src/buf_writer.c",
        "src/cache_bin.c",
        "src/ckh.c",
        "src/counter.c",
        "src/ctl.c",
        "src/decay.c",
        "src/div.c",
        "src/ecache.c",
        "src/edata.c",
        "src/edata_cache.c",
        "src/ehooks.c",
        "src/emap.c",
        "src/eset.c",
        "src/exp_grow.c",
        "src/extent.c",
        "src/extent_dss.c",
        "src/extent_mmap.c",
        "src/fxp.c",
        "src/hook.c",
        "src/hpa.c",
        "src/hpa_hooks.c",
        "src/hpdata.c",
        "src/inspect.c",
        "src/jemalloc.c",
        "src/large.c",
        "src/log.c",
        "src/malloc_io.c",
        "src/mutex.c",
        "src/nstime.c",
        "src/pa.c",
        "src/pa_extra.c",
        "src/pac.c",
        "src/pages.c",
        "src/pai.c",
        "src/peak_event.c",
        "src/prof.c",
        "src/prof_data.c",
        "src/prof_log.c",
        "src/prof_recent.c",
        "src/prof_stats.c",
        "src/prof_sys.c",
        "src/psset.c",
        "src/rtree.c",
        "src/safety_check.c",
        "src/san.c",
        "src/san_bump.c",
        "src/sc.c",
        "src/sec.c",
        "src/stats.c",
        "src/sz.c",
        "src/tcache.c",
        "src/test_hooks.c",
        "src/thread_event.c",
        "src/ticker.c",
        "src/tsd.c",
        "src/witness.c",
    ] + select({
        "//settings/flags:cxx": ["src/jemalloc_cpp.cpp"],
        "//conditions:default": [],
    }) + select(
        {
            # Last, as zone.o is in upstream's C_SYM_OBJS, so that private_namespace.h lists the symbols in upstream's
            # order
            "//settings/flags:zone_allocator": ["src/zone.c"],
            "//settings/flags:enable_zone_allocator_is_auto": [],
            "//settings/flags:enable_zone_allocator_is_no": [],
        },
        # Only "yes" off Darwin matches none, as configure.ac's
        # AC_MSG_ERROR([--enable-zone-allocator is only supported on Darwin])
        no_match_error = "//settings/flags:enable_zone_allocator=yes is only supported on Darwin",
    ),
    hdrs = ["//include/jemalloc"],
    conlyopts = CONLYOPTS,
    copts = ["-Iinclude/jemalloc/internal"] + COPTS,
    cxxopts = CXXOPTS,
    includes = ["include"],
    linkopts = select({
        "@platforms//os:android": ["-ldl"],
        "@platforms//os:linux": [
            "-ldl",
            "-lpthread",
            "-lrt",
        ],
        "//conditions:default": [],
    }) + select({
        "//settings/flags:prof": ["-lm"],
        "//conditions:default": [],
    }) + select({
        # src/zone.c registers jemalloc's malloc zone from a constructor that nothing references, so a static link
        # would drop it and leave malloc on the system allocator, as it does with upstream's libjemalloc.a. -u makes the
        # link take zone.o from the archive, and zone.o the rest of jemalloc, without forcing in other objects such as
        # jemalloc_cpp.o's operator new and delete.
        "//settings/flags:zone_allocator": ["-Wl,-u,_$(JEMALLOC_INTERNAL_PREFIX)zone_register"],
        "//conditions:default": [],
    }),
    # One archive in every link, as upstream builds one library. On Darwin, -u names a hidden symbol, which only a
    # static link of the archive resolves.
    linkstatic = True,
    local_defines = select({
        "//settings:jet": ["JEMALLOC_JET"],
        "//conditions:default": [],
    }) + select({
        "//settings:no_private_namespace": ["JEMALLOC_NO_PRIVATE_NAMESPACE"],
        "//conditions:default": [],
    }),
    toolchains = ["//include/jemalloc/internal:jemalloc_private_namespace"],
    visibility = ["//visibility:public"],
    deps = ["//include/jemalloc/internal"] + select({
        "@rules_cc//cc/compiler:clang-cl": ["//include/msvc_compat"],
        "@rules_cc//cc/compiler:msvc-cl": ["//include/msvc_compat"],
        "//conditions:default": [],
    }) + select({
        "//settings/flags:prof_libunwind": ["@libunwind"],
        "//conditions:default": [],
    }),
)

# C_UTIL_INTEGRATION_SRCS from the Makefile which are shared with the integration testlib
cc_library(
    name = "utils",
    srcs = [
        "src/malloc_io.c",
        "src/nstime.c",
        "src/ticker.c",
    ],
    hdrs = ["//include/jemalloc"],
    conlyopts = CONLYOPTS,
    copts = ["-Iinclude/jemalloc/internal"] + COPTS,
    cxxopts = CXXOPTS,
    includes = ["include"],
    linkopts = select({
        "@platforms//os:linux": [
            "-lpthread",
            "-lrt",
        ],
        "//conditions:default": [],
    }),
    linkstatic = True,
    tags = ["manual"],
    visibility = ["//:__subpackages__"],
    deps = ["//include/jemalloc/internal"],
)

cc_library(
    name = "pthread",
    linkopts = ["-pthread"],
    visibility = ["//include/jemalloc:__subpackages__"],
)
