# private_namespace_gen header on listings it must refuse.
expect_failure_test(
    name = "private_namespace_gen_unreadable_member_test",
    arguments = [
        "header",
        temporary("private_namespace.h"),
        runfile(":private_namespace_leak_fixture.nm"),
        runfile(":private_namespace_gen_unreadable_member.stderr"),
        "",
        "fixture",
        "fixture",
        "--public=malloc",
    ],
    command = ":private_namespace_gen",
    expected = "could not read every archive member",
)

expect_failure_test(
    name = "private_namespace_gen_slim_lto_test",
