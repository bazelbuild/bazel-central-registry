# What the lister wrote on stderr: nothing, as for a listing that read cleanly.
write_file(
    name = "private_namespace_leak_fixture_stderr",
    testonly = True,
    out = "private_namespace_leak_fixture.listing.stderr",
    content = [],
)

leak_check_test(
    name = "private_namespace_leak_check_clean_test",
    listing = ":private_namespace_leak_fixture.nm",
)

leak_check_test(
    name = "private_namespace_leak_check_leak_test",
    expected_leak = "leaked_function",
    listing = ":private_namespace_leak_fixture_leaky.nm",
)

# The same archive as link /DUMP /SYMBOLS lists it. The fixtures are lines of a real listing of jemalloc.lib (MSVC 14.51)
# with their CRLF line endings, renamed to this test's symbols. The leaky fixture's leaked_function is in section 0xA6,
# which dumpbin prints as SECTA6, and its leaked_variable is a communal symbol: an uninitialized global, which cl puts in
# no section, so dumpbin prints it as UNDEF with its size as the value, as it does je_malloc_conf. Not from a real
# listing: leaked_variable, the MSVC constant pool entry and the mangled C++ symbol the check must pass over.
leak_check_test(
    name = "private_namespace_leak_check_clean_dumpbin_test",
    listing = ":private_namespace_leak_fixture.dumpbin",
)

leak_check_test(
    name = "private_namespace_leak_check_leak_dumpbin_test",
    expected_leak = "leaked_function",
    listing = ":private_namespace_leak_fixture_leaky.dumpbin",
)

leak_check_test(
    name = "private_namespace_leak_check_leak_communal_dumpbin_test",
    expected_leak = "leaked_variable",
    listing = ":private_namespace_leak_fixture_leaky.dumpbin",
)

# private_namespace.h from a link /DUMP /SYMBOLS listing: lines of a real listing of jemalloc.lib (MSVC 14.51) with their
# CRLF line endings, je_test_ renamed to je_. Three differences from private_symbols.awk: an external symbol in a section
# whose hex number begins with a letter (SECTA4) is namespaced, so is a communal symbol (ncpus, UNDEF with its size as
# the value), and only identifiers are, so an MSVC constant pool entry or a mangled C++ symbol makes no #define. The
# lines for ncpus and the last three symbols are not from a real listing.
write_file(
    name = "private_namespace_dumpbin_fixture_public_syms",
    testonly = True,
    out = "private_namespace_dumpbin_fixture_public_syms.txt",
    content = [
        "malloc",
        "malloc_conf",
    ],
)

write_file(
    name = "private_namespace_dumpbin_fixture_wrap_syms",
    testonly = True,
    out = "private_namespace_dumpbin_fixture_wrap_syms.txt",
    content = [],
)

private_namespace(
    name = "private_namespace_dumpbin_fixture",
    testonly = True,
    out = "private_namespace_dumpbin_fixture.h",
    listing = ":private_namespace_dumpbin_fixture.dumpbin",
    prefix = "je_",
    public_symbols = ":private_namespace_dumpbin_fixture_public_syms",
    sym_prefix = "",
    wrap_symbols = ":private_namespace_dumpbin_fixture_wrap_syms",
)

diff_test(
    name = "private_namespace_dumpbin_test",
