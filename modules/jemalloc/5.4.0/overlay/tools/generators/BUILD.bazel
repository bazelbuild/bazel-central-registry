)

# public_symbols_gen list on a macro the fixture header does not decide, or decides both ways.
expect_failure_test(
    name = "public_symbols_gen_absent_macro_test",
    arguments = [
        "list",
        temporary("list.txt"),
        runfile(
            ":public_symbols_gen_fixture",
            prefix = "--symbol=symbol:ABSENT:",
        ),
    ],
    command = ":public_symbols_gen",
    expected = "neither defines nor undefines ABSENT",
)

