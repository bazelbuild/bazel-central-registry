# Makefile.in:358-367 also lists tcache_fiber_migration.c, the regression test for upstream issue #2890, but only for an
# ELF build with a static library, ucontext, --enable-experimental-fiber-safe-tls and -flto in CFLAGS, and links it on
# its own against the static archive between -Wl,--whole-archive and -Wl,--no-whole-archive. It has no target here. The
# bug it guards against appears only when whole-program LTO inlines the allocator into the fiber code, which neither a
# test-owned transition nor the build's own flags can turn on portably (Bazel's thin_lto feature is distributed ThinLTO
# for clang only), and without LTO the test cannot observe it.

# Makefile.in:373 empties TESTS_INTEGRATION_CPP unless @enable_cxx@ (on by default; --disable-cxx turns it off).
INTEGRATION_CPP_TESTS = [
    {"src": "cpp/basic.cpp"},
]

[cc_test(
    name = test_name(test),
    src = test["src"],
    local_defines = ["JEMALLOC_INTEGRATION_CPP_TEST"],
    target_compatible_with = select({
        "//settings/flags:cxx": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":testlib_cpp"],
) for test in INTEGRATION_CPP_TESTS]

# Makefile.in:376-381 adds infallible_new.cpp with --enable-cxx-infallible-new and failing_new.cpp without it, both only
# where the C++ toolchain has exceptions. Whether it does is configure's probe (je_cv_cxx_exceptions, which defines
# JEMALLOC_HAVE_CXX_EXCEPTIONS), known only once the probe has compiled, so each test's source comes from autoconf_srcs:
# upstream's file where the probe succeeds and cpp/no_cxx_exceptions.cpp, which reports a skip, where it fails. Every
# target below that runs either file, the decay and prof ones included, takes its source from here. The sources are
# generated in the test library's configuration, so the probe is the one the test library's headers carry.
#
# Their .sh files set xmalloc:false only where enable_xmalloc is 1, so that jemalloc returns null to operator new rather
# than aborting. test.sh.in never passes enable_xmalloc to them, so that guard is inactive upstream, and it puts the
# per-test conf before the global MALLOC_CONF, so a global xmalloc:true would win anyway. This build honours the
# scripts' intent and sets xmalloc:false under //settings/flags:enable_xmalloc.
autoconf_srcs(
    name = "cpp_failing_new_sources",
    srcs = {
        "cpp/failing_new.cpp": "je_cv_cxx_exceptions",
        "cpp/no_cxx_exceptions.cpp": "!je_cv_cxx_exceptions",
    },
    naming = "per_target",
    tags = ["manual"],
    wrap = "include",
    deps = ["//include/jemalloc/internal:jemalloc_internal_defs_checks"],
)

with_settings(
    name = "cpp_failing_new_sources_test_config",
    testonly = True,
    src = ":cpp_failing_new_sources",
    settings = TESTLIB_SETTINGS | {"//settings:with_test": "integration_cpp"},
)

cc_test(
    name = "cpp_failing_new",
    src = ":cpp_failing_new_sources_test_config",
    env = select({
        "//settings/flags:xmalloc": {"JE_TEST_MALLOC_CONF": "xmalloc:false"},
        "//conditions:default": {"JE_TEST_MALLOC_CONF": ""},
    }),
    local_defines = ["JEMALLOC_INTEGRATION_CPP_TEST"],
    target_compatible_with = select({
        "//settings/flags:cxx": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//settings/flags:cxx_infallible_new": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }) + select({
        "//settings/flags:xmalloc_disabled": [],
        "//settings/flags:user_config": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":cpp_failing_new_sources_test_config",
        ":testlib_cpp",
    ],
)

autoconf_srcs(
    name = "cpp_infallible_new_sources",
    srcs = {
        "cpp/infallible_new.cpp": "je_cv_cxx_exceptions",
        "cpp/no_cxx_exceptions.cpp": "!je_cv_cxx_exceptions",
    },
    naming = "per_target",
    tags = ["manual"],
    wrap = "include",
    deps = ["//include/jemalloc/internal:jemalloc_internal_defs_checks"],
)

with_settings(
    name = "cpp_infallible_new_sources_test_config",
    testonly = True,
    src = ":cpp_infallible_new_sources",
    settings = TESTLIB_SETTINGS | {"//settings:with_test": "integration_cpp"},
)

cc_test(
    name = "cpp_infallible_new",
    src = ":cpp_infallible_new_sources_test_config",
    env = select({
        "//settings/flags:xmalloc": {"JE_TEST_MALLOC_CONF": "xmalloc:false"},
        "//conditions:default": {"JE_TEST_MALLOC_CONF": ""},
    }),
    local_defines = ["JEMALLOC_INTEGRATION_CPP_TEST"],
    target_compatible_with = select({
        "//settings/flags:cxx": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//settings/flags:cxx_infallible_new": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "//settings/flags:xmalloc_disabled": [],
        "//settings/flags:user_config": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [
        ":cpp_infallible_new_sources_test_config",
        ":testlib_cpp",
    ],
)

# Not upstream's: this build compiles jemalloc's C++ support with every compiler, cl and clang-cl included, where
# configure leaves it off, so a program linking jemalloc must get its operator new rather than the C++ runtime's.
# infallible_new.cpp checks that only off Windows, and only with //settings/flags:enable_cxx_infallible_new. Upstream
# expects the replacement to fail with MinGW (infallible_new.cpp:41-44).
cc_test(
    name = "cpp_operator_new_owned",
    src = "cpp/operator_new_owned.cpp",
    local_defines = ["JEMALLOC_INTEGRATION_CPP_TEST"],
    target_compatible_with = select({
        "//settings/flags:cxx": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }) + select({
        "@rules_cc//cc/compiler:mingw-gcc": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [":testlib_cpp"],
)

