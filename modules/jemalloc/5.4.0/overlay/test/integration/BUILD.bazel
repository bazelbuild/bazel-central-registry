# Makefile.in runs each integration test (TESTS_INTEGRATION and TESTS_INTEGRATION_CPP) once per test.sh line of
# check_integration, check_integration_decay and check_integration_prof, with that line's MALLOC_CONF joined after the
# one the test's .sh exports (test/test.sh.in's export_malloc_conf). Each such line has a block of targets below.
#
# jemalloc reads MALLOC_CONF only with //settings/flags:enable_user_config (JEMALLOC_CONFIG_ENV, src/conf.c), so a test
# with a MALLOC_CONF is incompatible without it rather than run without its conf. Upstream's test scripts export it
# regardless.

TESTLIB_SETTINGS = {
    "//settings:with_test": "integration",
    # This needs to be pinned for testing. The MALLOC_CONF ENV depends on it. The make build allows for it to be
    # set dynamically via templating and generates a test harness around it. By requiring a value that cannot be
    # set internally by accident, this exercises the same functionality.
    "//settings/flags:jemalloc_prefix": "je_test_",
}

with_settings(
    name = "testlib",
    testonly = True,
    src = "//test:testlib",
    settings = TESTLIB_SETTINGS,
    visibility = ["//:__subpackages__"],
)

with_settings(
    name = "testlib_cpp",
    testonly = True,
    src = "//test:testlib",
    settings = TESTLIB_SETTINGS | {"//settings:with_test": "integration_cpp"},
    visibility = ["//:__subpackages__"],
)

