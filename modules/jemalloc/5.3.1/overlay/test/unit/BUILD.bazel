# jemalloc reads MALLOC_CONF only with //settings/flags:enable_user_config (JEMALLOC_CONFIG_ENV, src/conf.c), so a test
# with a MALLOC_CONF is incompatible without it rather than run without its conf. Upstream's test scripts export it
# regardless.
[cc_test(
    name = test_name(test),
    src = test["src"],
    env = {"JE_TEST_MALLOC_CONF": test["conf"]},
    linkstatic = True,
    local_defines = ["JEMALLOC_UNIT_TEST"],
    target_compatible_with = select({
        "//settings/flags:user_config": [],
        "//conditions:default": ["@platforms//:incompatible"],
    }),
    deps = [":testlib"],
) for test in UNIT_CONF_TESTS]

