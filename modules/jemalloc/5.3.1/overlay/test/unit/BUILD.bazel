# Debug catches the double free only on the slow free path, which a debug build takes because fill turns junk on.
# Without fill, free_fastpath caches the second free unchecked. Upstream's CI never builds debug without fill.
selects.config_setting_group(
    name = "debug_without_fill",
    match_all = [
        "//settings/flags:debug",
        "//settings/flags:fill_disabled",
    ],
)

cc_test(
    name = "double_free",
    src = "double_free.c",
    linkstatic = True,
    local_defines = ["JEMALLOC_UNIT_TEST"],
    target_compatible_with = select({
        ":debug_without_fill": ["@platforms//:incompatible"],
        "//conditions:default": [],
    }),
    deps = [":testlib"],
)

