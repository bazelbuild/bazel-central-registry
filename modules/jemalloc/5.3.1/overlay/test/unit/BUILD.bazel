load("@bazel_skylib//lib:selects.bzl", "selects")
load("@package_metadata//licenses/rules:license.bzl", "license")
load("@package_metadata//rules:package_metadata.bzl", "package_metadata")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("//tools:test.bzl", "cc_test", "test_name")
load("//tools:transition.bzl", "with_settings")

license(
    name = "smhasher_license",
    kind = "@package_metadata//licenses/spdx:MIT",
    text = "LICENSE.smhasher",
)

# hash.c adapts SMHasher's VerificationTest and states no upstream version.
package_metadata(
    name = "smhasher_metadata",
    attributes = [":smhasher_license"],
    purl = "pkg:github/aappleby/smhasher#src/KeysetTest.cpp",
)

filegroup(
    name = "smhasher_test_sources",
    srcs = ["hash.c"],
    applicable_licenses = [":smhasher_metadata"],
)

filegroup(
    name = "sfmt_test_sources",
    srcs = ["SFMT.c"],
    applicable_licenses = [
        "//:package_metadata",
        "//test:sfmt_metadata",
    ],
)

with_settings(
    name = "testlib",
    testonly = True,
    src = "//test:testlib",
    settings = {
        "//settings:enable_jet": "True",
        "//settings:with_test": "unit",
        # This needs to be pinned for testing. The MALLOC_CONF ENV depends on it. The make build allows for it to be
        # set dynamically via templating and generates a test harness around it. By requiring a value that cannot be
        # set internally by accident, this exercises the same functionality.
        "//settings/flags:jemalloc_prefix": "je_test_",
    },
    visibility = ["//:__subpackages__"],
)

# Handle C source inclusions
[
    cc_library(
        name = src.replace(".", "_"),
        testonly = True,
        hdrs = [src],
        tags = ["manual"],
        visibility = ["//visibility:private"],
    )
    for src in [
        "arena_reset.c",
        "batch_alloc.c",
        "junk.c",
    ]
]

