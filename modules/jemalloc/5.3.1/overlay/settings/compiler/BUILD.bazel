load("@bazel_skylib//lib:selects.bzl", "selects")

package(default_visibility = ["//:__subpackages__"])

# The compilers that define _MSC_VER and take MSVC's command line, configure.ac's je_cv_msvc (configure.ac:217-226).
selects.config_setting_group(
    name = "msvc_compatible",
    match_any = [
        "@rules_cc//cc/compiler:clang-cl",
        "@rules_cc//cc/compiler:msvc-cl",
    ],
)

# The compilers that take GCC's command line, targeting Windows: clang or gcc with a MinGW target, or mingw-gcc. These
# are configure.ac's GCC=yes on its *-*-mingw* host. The group expands into each select that uses it, so its members
# are visible wherever it is.
selects.config_setting_group(
    name = "windows_gcc_compatible",
    match_any = [
        ":windows_clang",
        ":windows_gcc",
        "@rules_cc//cc/compiler:mingw-gcc",
    ],
)

config_setting(
    name = "windows_clang",
    constraint_values = ["@platforms//os:windows"],
    flag_values = {"@rules_cc//cc/compiler:compiler": "clang"},
)

config_setting(
    name = "windows_gcc",
    constraint_values = ["@platforms//os:windows"],
    flag_values = {"@rules_cc//cc/compiler:compiler": "gcc"},
)
