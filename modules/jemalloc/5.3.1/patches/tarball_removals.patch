-#undef not_reached
-#undef not_implemented
-#undef expect_not_implemented
-
-#define assert(e) do {							\
-	if (!(e)) {							\
-		malloc_printf(						\
-		    "<jemalloc>: %s:%d: Failed assertion: \"%s\"\n",	\
