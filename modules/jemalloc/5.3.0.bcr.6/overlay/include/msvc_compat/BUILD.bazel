load("@rules_cc//cc:cc_library.bzl", "cc_library")

# The headers of every Windows build, whatever the compiler. Upstream reaches them in two ways:
# - As "msvc_compat/strings.h" and "msvc_compat/windows_extra.h", which jemalloc_internal_decls.h and
#   test/include/test/jemalloc_test.h.in include under _WIN32, through the -Iinclude every compile gets
#   (Makefile.in:27). strip_include_prefix gives them that path.
# - As <strings.h>, which jemalloc_macros.h includes everywhere and which cl's C library lacks: configure.ac adds
#   include/msvc_compat itself to CPPFLAGS when the compiler defines _MSC_VER (configure.ac:273), as clang-cl does
#   too. MinGW has its own strings.h. The include path reaches everything that depends on jemalloc, as its public
#   headers need it.
# Its C99 directory is left out: configure.ac adds that only for toolchains without inttypes.h (VS2012 and older).
cc_library(
    name = "msvc_compat",
    hdrs = [
        "strings.h",
        "windows_extra.h",
    ],
    includes = select({
        "//settings/compiler:msvc_compatible": ["."],
        "//conditions:default": [],
    }),
    strip_include_prefix = "/include",
    visibility = ["//:__subpackages__"],
)
