load("@bazel_lib//lib:transitions.bzl", "platform_transition_filegroup")

# The library and the consumer tests that apply to Windows, cross-compiled for MinGW-w64, which the llvm toolchain
# targets from any host. Built, not run: the test programs are Windows executables. The tests are listed rather than
# taken from the suite, as a filegroup with an incompatible source is skipped as a whole: tests 5, 6 and 10 are macOS
# only, and 8, 9, 11 and 12 need malloc replaced, which the je_ prefix on Windows does not do.
platform_transition_filegroup(
    name = "aarch64",
    testonly = True,
    srcs = [
        "@jemalloc",
        "@jemalloc_examples_host_toolchain//:test_1_basic",
        "@jemalloc_examples_host_toolchain//:test_2_api",
        "@jemalloc_examples_host_toolchain//:test_3_config",
        "@jemalloc_examples_host_toolchain//:test_4_requires_stats",
        "@jemalloc_examples_host_toolchain//:test_7_prefix",
        "@jemalloc_examples_host_toolchain//:test_13_malloc_conf",
    ],
    target_platform = "@llvm//platforms:windows_aarch64",
)

platform_transition_filegroup(
    name = "x86_64",
    testonly = True,
    srcs = [
        "@jemalloc",
        "@jemalloc_examples_host_toolchain//:test_1_basic",
        "@jemalloc_examples_host_toolchain//:test_2_api",
        "@jemalloc_examples_host_toolchain//:test_3_config",
        "@jemalloc_examples_host_toolchain//:test_4_requires_stats",
        "@jemalloc_examples_host_toolchain//:test_7_prefix",
        "@jemalloc_examples_host_toolchain//:test_13_malloc_conf",
    ],
    target_platform = "@llvm//platforms:windows_x86_64",
)
