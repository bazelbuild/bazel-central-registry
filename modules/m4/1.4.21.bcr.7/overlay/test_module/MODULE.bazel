"""Test module for GNU M4: rules_m4 with @m4//:m4 as the registered toolchain.
"""

module(name = "m4_test_module")

bazel_dep(name = "m4")
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_m4", version = "0.3.bcr.1")

local_path_override(
    module_name = "m4",
    path = "..",
)

register_toolchains(
    "//:m4_toolchain",
)
