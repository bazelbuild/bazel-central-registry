load("@bazel_skylib//rules:diff_test.bzl", "diff_test")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_m4//m4:m4.bzl", "m4")

# buildifier: disable=bzl-visibility
load("@rules_m4//m4/internal:toolchain_info.bzl", "m4_toolchain_info")

m4_toolchain_info(
    name = "m4_toolchain_info",
    m4_tool = "@m4//:m4",
)

toolchain(
    name = "m4_toolchain",
    toolchain = ":m4_toolchain_info",
    toolchain_type = "@rules_m4//m4:toolchain_type",
)

write_file(
    name = "hello_m4",
    out = "hello.m4",
    content = [
        "define(`HELLO', `Hello, world!')dnl",
        "HELLO",
    ],
    newline = "unix",
)

write_file(
    name = "hello_expected",
    out = "hello.expected",
    content = ["Hello, world!"],
    newline = "unix",
)

m4(
    name = "hello",
    srcs = [":hello_m4"],
    output = "hello.txt",
)

diff_test(
    name = "hello_test",
    file1 = ":hello",
    file2 = ":hello_expected",
)

genrule(
    name = "hello_genrule",
    srcs = [":hello_m4"],
    outs = ["hello_genrule.txt"],
    cmd = "$(M4) $(SRCS) > $@",
    cmd_bat = "$(M4) $(SRCS) > $@",
    toolchains = ["@rules_m4//m4:current_m4_toolchain"],
)

diff_test(
    name = "hello_genrule_test",
    file1 = ":hello_genrule",
    file2 = ":hello_expected",
)
