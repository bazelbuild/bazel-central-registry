    """The targets configure.ac and the Makefile.am files describe, in the package that calls this."""

    native.exports_files(["COPYING"])

    license(
        name = "license_COPYING",
        kind = "@package_metadata//licenses/spdx:GPL-3.0-or-later",
        text = "COPYING",
        visibility = ["//:__subpackages__"],
    )

    package_metadata(
        name = "package_metadata",
        attributes = [":license_COPYING"],
        purl = purl.bazel(
            native.module_name(),
            native.module_version(),
        ),
        visibility = ["//:__subpackages__"],
    )

    autoconf_package_info(
        name = "package",
        package_name = "GNU M4",
        aliases = {
            "PACKAGE": "PACKAGE_TARNAME",
            "VERSION": "PACKAGE_VERSION",
        },
        module_bazel = "//:MODULE.bazel",
        package_bugreport = "bug-m4@gnu.org",
        package_tarname = "m4",
        package_url = "https://www.gnu.org/software/m4/",
        strip_bcr_version = True,
        visibility = ["//:__subpackages__"],
    )

    for name, default in BOOL_OPTIONS.items():
        bool_flag(
            name = name,
            build_setting_default = default,
            visibility = ["//visibility:public"],
        )

    for name in BOOL_OPTIONS:
        native.config_setting(
            name = name + "_enabled",
            flag_values = {":" + name: "True"},
            visibility = ["//:__subpackages__"],
        )

    autoconf(
        name = "gl_CHECK_FUNCS_ANDROID_close_range",
        checks = gl_macros.GL_CHECK_FUNCS_ANDROID(
            ["close_range"],
            includes = ["#include <unistd.h>"],
        ),
        visibility = ["//:__subpackages__"],
    )

    autoconf(
        name = "gl_CHECK_FUNCS_ANDROID_duplocale",
        checks = gl_macros.GL_CHECK_FUNCS_ANDROID(
            ["duplocale"],
            includes = ["#include <locale.h>"],
        ),
        visibility = ["//:__subpackages__"],
    )

    autoconf(
        name = "autoconf",
        checks = [
            checks.AC_DEFINE("GNULIB_REGEX_SINGLE_THREAD", 1),
