load(":boost_test_suite.bzl", "boost_test_headers", "boost_test_suite")

boost_test_headers()

# Upstream requires C++20 for the PlantUML front-end tests.
_CXXSTD20_TESTS = glob([
    "*Puml*.cpp",
    "puml*.cpp",
])

# Not referenced by test/Jamfile.v2.
_NOT_BUILT_UPSTREAM = [
    "SimpleKleene.cpp",
    "main.cpp",
]

boost_test_suite(
    name = "upstream_tests",
    srcs = glob(
        ["*.cpp"],
        exclude = _CXXSTD20_TESTS + _NOT_BUILT_UPSTREAM,
    ),
)

boost_test_suite(
    name = "upstream_tests_cxxstd20",
    srcs = _CXXSTD20_TESTS,
    cxxstd = "20",
)
