load("@rules_cc//cc:cc_library.bzl", "cc_library")

# These I/O back ends wrap libjpeg, libpng, libtiff and LibRaw, which are not
# in the registry.
_EXTERNAL_IO = glob([
    "include/boost/gil/extension/io/jpeg.hpp",
    "include/boost/gil/extension/io/jpeg/**",
    "include/boost/gil/extension/io/png.hpp",
    "include/boost/gil/extension/io/png/**",
    "include/boost/gil/extension/io/raw.hpp",
    "include/boost/gil/extension/io/raw/**",
    "include/boost/gil/extension/io/tiff.hpp",
    "include/boost/gil/extension/io/tiff/**",
])

# boost/gil/io/typedefs.hpp specializes boost::is_floating_point without
# including the header that declares it, so neither it nor the headers that
# include it directly are self-contained.
_TEXTUAL_HDRS = [
    "include/boost/gil/io/bit_operations.hpp",
    "include/boost/gil/io/row_buffer_helper.hpp",
    "include/boost/gil/io/scanline_read_iterator.hpp",
    "include/boost/gil/io/typedefs.hpp",
]

cc_library(
    name = "boost.gil",
    hdrs = glob(
        ["include/**/*.hpp"],
        exclude = _EXTERNAL_IO + _TEXTUAL_HDRS,
    ),
    features = ["parse_headers"],
    includes = ["include"],
    textual_hdrs = _TEXTUAL_HDRS,
    visibility = ["//visibility:public"],
    deps = [
        "@boost.assert",
        "@boost.concept_check",
        "@boost.config",
        "@boost.container_hash",
        "@boost.core",
        "@boost.filesystem",
        "@boost.integer",
        "@boost.iterator",
        "@boost.mp11",
        "@boost.preprocessor",
        "@boost.type_traits",
        "@boost.variant2",
    ],
)
