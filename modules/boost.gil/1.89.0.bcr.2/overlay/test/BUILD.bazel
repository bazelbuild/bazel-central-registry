load(":boost_test_suite.bzl", "boost_test_suite")

# The I/O back ends wrap libjpeg, libpng, libtiff and LibRaw, which are not in
# the registry, and their tests read image files from the Boost source tree.
_EXTERNAL_IO = glob(["extension/io/**/*.cpp"])

# Not referenced by the Jamfile in their directory.
_NOT_BUILT_UPSTREAM = [
    "core/image_processing/adaptive_he.cpp",
    "core/image_processing/histogram_equalization.cpp",
    "core/image_processing/histogram_matching.cpp",
]

# Upstream `compile-fail` targets.
_COMPILE_FAIL = glob(["**/*_fail.cpp"])

# Part of the machinery that generates one translation unit per public header;
# the parse_headers feature already covers that.
_HEADER_TESTS = glob(["header/**/*.cpp"])

boost_test_suite(
    name = "upstream_core_tests",
    srcs = glob(
        ["core/**/*.cpp"],
        exclude = _COMPILE_FAIL + _NOT_BUILT_UPSTREAM,
    ),
    local_defines = ["BOOST_GIL_USE_CONCEPT_CHECK=1"],
)

boost_test_suite(
    name = "upstream_extension_tests",
    srcs = glob(
        ["extension/**/*.cpp"],
        exclude = _EXTERNAL_IO + _COMPILE_FAIL,
    ),
)

boost_test_suite(
    name = "upstream_tests",
    srcs = glob(
        ["*.cpp"],
        exclude = _HEADER_TESTS + _COMPILE_FAIL,
    ),
)
