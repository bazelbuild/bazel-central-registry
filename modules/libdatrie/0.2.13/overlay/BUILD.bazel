load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(default_applicable_licenses = [":license"])

license(
    name = "license",
    package_name = "libdatrie",
    license_kinds = ["@rules_license//licenses/spdx:LGPL-2.1-or-later"],
    license_text = "COPYING",
    package_url = "https://linux.thai.net/projects/libdatrie/",
    package_version = "0.2.13",
)

LINUX_ONLY = select({
    "@platforms//os:linux": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# Public headers and sources from datrie/Makefile.am.
cc_library(
    name = "datrie",
    srcs = glob([
        "datrie/*.c",
        "datrie/*.h",
    ]),
    hdrs = [
        "datrie/alpha-map.h",
        "datrie/trie.h",
        "datrie/triedefs.h",
        "datrie/typedefs.h",
    ],
    include_prefix = "datrie",
    strip_include_prefix = "datrie",
    target_compatible_with = LINUX_ONLY,
    visibility = ["//visibility:public"],
)

# Uses iconv/nl_langinfo from the Linux C runtime; no host packages or probes.
cc_binary(
    name = "trietool",
    srcs = [
        "tools/config.h",
        "tools/trietool.c",
    ],
    copts = ["-I" + (package_relative_label(":BUILD.bazel").workspace_root or ".") + "/tools"],
    linkstatic = True,
    target_compatible_with = LINUX_ONLY,
    visibility = ["//visibility:public"],
    deps = [":libdatrie"],
)

alias(
    name = "libdatrie",
    actual = ":datrie",
    visibility = ["//visibility:public"],
)
