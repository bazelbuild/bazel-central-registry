load("@rules_cc//cc:cc_binary.bzl", "cc_binary")
load("@rules_cc//cc:cc_library.bzl", "cc_library")

LINUX_ONLY = select({
    "@platforms//os:linux": [],
    "//conditions:default": ["@platforms//:incompatible"],
})

# Public headers and sources from datrie/Makefile.am.
cc_library(
    name = "datrie",
    srcs = glob([
        "datrie/*.c",
        "datrie/*.h",
    ]),
    hdrs = [
        "datrie/alpha-map.h",
        "datrie/trie.h",
        "datrie/triedefs.h",
        "datrie/typedefs.h",
    ],
    include_prefix = "datrie",
    strip_include_prefix = "datrie",
    visibility = ["//visibility:public"],
)

# Only the dictionary compiler currently uses a Linux-specific configuration.
# The public data-structure library above has no OS-specific dependencies.
# Uses iconv/nl_langinfo from the Linux C runtime; no host packages or probes.
cc_binary(
    name = "trietool",
    srcs = [
        "tools/config.h",
        "tools/trietool.c",
    ],
    includes = ["tools"],
    linkstatic = True,
    target_compatible_with = LINUX_ONLY,
    visibility = ["//visibility:public"],
    deps = [":libdatrie"],
)

alias(
    name = "libdatrie",
    actual = ":datrie",
    visibility = ["//visibility:public"],
)
