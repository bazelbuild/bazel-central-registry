load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:expand_template.bzl", "expand_template")

expand_template(
    name = "header",
    out = "crypt.h",
    substitutions = {
        "@BEGIN_DECLS@": "__BEGIN_DECLS",
        "@DEFAULT_PREFIX_ENABLED@": "1",
        "@XCRYPT_VERSION_MAJOR@": "4",
        "@XCRYPT_VERSION_MINOR@": "4",
        "@XCRYPT_VERSION_STR@": "4.4",
        "@END_DECLS@": "__END_DECLS",
    },
    template = "//lib:crypt.h.in",
    visibility = ["//lib:__pkg__"],
)

copy_file(
    name = "cfg",
    src = "//config",
    out = "config.h",
    allow_symlink = True,
    visibility = ["//lib:__pkg__"],
)

copy_file(
    name = "hashes",
    src = "//crypt-hashes",
    out = "crypt-hashes.h",
    allow_symlink = True,
    visibility = ["//lib:__pkg__"],
)

copy_file(
    name = "symbol-vers",
    src = "//crypt-symbol-vers",
    out = "crypt-symbol-vers.h",
    allow_symlink = True,
    visibility = ["//lib:__pkg__"],
)

alias(
    name = "libxcrypt",
    actual = "//lib",
    visibility = ["//visibility:public"],
)
